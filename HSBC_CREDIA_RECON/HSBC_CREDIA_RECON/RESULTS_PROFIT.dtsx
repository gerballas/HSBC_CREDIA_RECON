          DTS:TaskContact="Performs high-performance data extraction, transformation and loading;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1">
          <DTS:Variables />
          <DTS:ObjectData>
            <pipeline
              version="1">
              <components>
                <component
                  refId="Package\Sequence Container\Data Flow Task\Customers"
                  componentClassID="Microsoft.SSISOracleSrc"
                  contactInfo="Oracle Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;1"
                  description="Oracle Source"
                  name="Customers"
                  usesDispositions="true"
                  version="1">
                  <properties>
                    <property
                      dataType="System.String"
                      description="The name of the table to be fetched."
                      expressionType="Notify"
                      name="TableName"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      expressionType="Notify"
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">SELECT
       'Customers' AS CHECK_TYPE,
       C.CHECK_ID, C.CHECK_NAME, C.CATEGORY,
       C.RESULT_NUM, C.RESULT_TOTAL, C.RESULT_TXT,
       CASE WHEN C.CATEGORY = 'NOT_FOUND' THEN 'INFO'
            WHEN C.RESULT_NUM = 0            THEN 'PASS'
            ELSE 'REVIEW' END AS STATUS
  FROM (


SELECT 'CM-001' AS CHECK_ID, 'Branch_Code mismatch vs SSCUSTP.ZGDCB' AS CHECK_NAME,
       'CONFIRMED' AS CATEGORY, COUNT(CASE WHEN  TRIM(TO_CHAR(n.Branch_Code)) &lt;&gt; TRIM(TO_CHAR(s.ZGDCB))
    OR (n.Branch_Code IS NULL AND s.ZGDCB IS NOT NULL)
    OR (n.Branch_Code IS NOT NULL AND s.ZGDCB IS NULL) THEN 1 END) AS RESULT_NUM,
       COUNT(*) AS RESULT_TOTAL,
       CAST(NULL AS VARCHAR2(200)) AS RESULT_TXT
  FROM NCIS_Customers n
  JOIN MG_CUSTOMER_INTER mci ON mci.PRFT_CUST_ID = n.Customer_Code
  JOIN HUB_MT_SSCUSTP s ON TRIM(s.CUSTOMER_CODE) = TRIM(mci.CUSTOMER_CODE)

UNION ALL
SELECT 'CM-002' AS CHECK_ID,
       'Date_of_Birth mismatch vs SSINCIP.ZKDTBR' AS CHECK_NAME,
       'CONFIRMED' AS CATEGORY,
       COUNT(CASE WHEN  NVL(TO_CHAR(n.Date_of_Birth,'YYYYMMDD'),'X') &lt;&gt; 
       CASE 
         WHEN TRIM(i.ZKDTBR) = '99999999' THEN '19010101'
         ELSE NVL(TRIM(i.ZKDTBR),'X')
       END THEN 1 END) AS RESULT_NUM,
       COUNT(*) AS RESULT_TOTAL,
       CAST(NULL AS VARCHAR2(200)) AS RESULT_TXT
  FROM NCIS_Customers n
  JOIN MG_CUSTOMER_INTER mci ON mci.PRFT_CUST_ID = n.Customer_Code
  JOIN HUB_MT_SSINCIP i ON TRIM(i.CUSTOMER_CODE) = TRIM(mci.CUSTOMER_CODE)

UNION ALL
SELECT 'CM-003' AS CHECK_ID, 'Sex mismatch vs SSINCIP.ZKSEX' AS CHECK_NAME,
       'CONFIRMED' AS CATEGORY, COUNT(CASE WHEN  CASE 
         WHEN n.Customer_Type = 1 AND (i.ZKSEX IS NULL OR TRIM(i.ZKSEX) = '') AND TRIM(n.Sex) = 'M' 
           THEN 'MATCH_FOUND'
         WHEN TRIM(i.ZKSEX) = 'X' AND TRIM(n.Sex) = 'M' 
           THEN 'MATCH_FOUND'
         ELSE NVL(TRIM(n.Sex), 'X')
       END
       &lt;&gt;
       CASE 
         WHEN n.Customer_Type = 1 AND (i.ZKSEX IS NULL OR TRIM(i.ZKSEX) = '') AND TRIM(n.Sex) = 'M' 
           THEN 'MATCH_FOUND'
         WHEN TRIM(i.ZKSEX) = 'X' AND TRIM(n.Sex) = 'M' 
           THEN 'MATCH_FOUND'
         ELSE NVL(TRIM(i.ZKSEX), 'X')
       END THEN 1 END) AS RESULT_NUM,
       COUNT(*) AS RESULT_TOTAL,
       CAST(NULL AS VARCHAR2(200)) AS RESULT_TXT
  FROM NCIS_Customers n
  JOIN MG_CUSTOMER_INTER mci ON mci.PRFT_CUST_ID = n.Customer_Code
  JOIN HUB_MT_SSINCIP i ON TRIM(i.CUSTOMER_CODE) = TRIM(mci.CUSTOMER_CODE)

UNION ALL
SELECT 'CM-004', 'Nationality mismatch vs SSCUSTP.ZGNATY',
       'CONFIRMED', COUNT(CASE WHEN  NVL(TRIM(n.Nationality),'X') &lt;&gt; NVL(TRIM(s.ZGNATY),'X') THEN 1 END),
       COUNT(*) AS RESULT_TOTAL,
       CAST(NULL AS VARCHAR2(200))
  FROM NCIS_Customers n
  JOIN MG_CUSTOMER_INTER mci ON mci.PRFT_CUST_ID = n.Customer_Code
  JOIN HUB_MT_SSCUSTP s ON TRIM(s.CUSTOMER_CODE) = TRIM(mci.CUSTOMER_CODE)

UNION ALL
SELECT 'CM-005', 'Communication_Language mismatch vs SSCUSTP.ZGLANG',
       'CONFIRMED', COUNT(CASE WHEN  NVL(TRIM(n.Communication_Language),'X') &lt;&gt; NVL(TRIM(s.ZGLANG),'X') THEN 1 END),
       COUNT(*) AS RESULT_TOTAL,
       CAST(NULL AS VARCHAR2(200))
  FROM NCIS_Customers n
  JOIN MG_CUSTOMER_INTER mci ON mci.PRFT_CUST_ID = n.Customer_Code
  JOIN HUB_MT_SSCUSTP s ON TRIM(s.CUSTOMER_CODE) = TRIM(mci.CUSTOMER_CODE)

UNION ALL
SELECT 'CM-006', 'Number_of_Children mismatch vs SSINCIP.ZKKID',
       'CONFIRMED', COUNT(CASE WHEN  NVL(TO_NUMBER(n.Number_of_Children),-1) &lt;&gt; NVL(TO_NUMBER(i.ZKKID),-1) THEN 1 END),
       COUNT(*) AS RESULT_TOTAL,
       CAST(NULL AS VARCHAR2(200))
  FROM NCIS_Customers n
  JOIN MG_CUSTOMER_INTER mci ON mci.PRFT_CUST_ID = n.Customer_Code
  JOIN HUB_MT_SSINCIP i ON TRIM(i.CUSTOMER_CODE) = TRIM(mci.CUSTOMER_CODE)

UNION ALL
SELECT 'CM-007', 'Education_Level mismatch vs SSINCIP.ZKEDUC',
       'CONFIRMED', COUNT(CASE WHEN  NVL(TRIM(n.Education_Level),'X') &lt;&gt; NVL(TRIM(i.ZKEDUC),'X') THEN 1 END),
       COUNT(*) AS RESULT_TOTAL,
       CAST(NULL AS VARCHAR2(200))
  FROM NCIS_Customers n
  JOIN MG_CUSTOMER_INTER mci ON mci.PRFT_CUST_ID = n.Customer_Code
  JOIN HUB_MT_SSINCIP i ON TRIM(i.CUSTOMER_CODE) = TRIM(mci.CUSTOMER_CODE)

UNION ALL
SELECT 'CM-008', 'Identification_ID_Type mismatch vs SSCUSTP.ZGIDTY (PROBABLE — confirm mapping)',
       'PROBABLE', COUNT(CASE WHEN  NVL(TRIM(TO_CHAR(n.Identification_ID_Type)),'X') &lt;&gt; NVL(TRIM(s.ZGIDTY),'X') THEN 1 END),
       COUNT(*) AS RESULT_TOTAL,
       CAST(NULL AS VARCHAR2(200))
  FROM NCIS_Customers n
  JOIN MG_CUSTOMER_INTER mci ON mci.PRFT_CUST_ID = n.Customer_Code
  JOIN HUB_MT_SSCUSTP s ON TRIM(s.CUSTOMER_CODE) = TRIM(mci.CUSTOMER_CODE)

UNION ALL
SELECT 'CM-009', 'Identification_ID mismatch vs SSCUSTP.ZGIDNO (PROBABLE — confirm mapping)',
       'PROBABLE', COUNT(CASE WHEN  NVL(TRIM(n.Identification_ID),'X') &lt;&gt; NVL(TRIM(s.ZGIDNO),'X') THEN 1 END),
       COUNT(*) AS RESULT_TOTAL,
       CAST(NULL AS VARCHAR2(200))
  FROM NCIS_Customers n
  JOIN MG_CUSTOMER_INTER mci ON mci.PRFT_CUST_ID = n.Customer_Code
  JOIN HUB_MT_SSCUSTP s ON TRIM(s.CUSTOMER_CODE) = TRIM(mci.CUSTOMER_CODE)

UNION ALL
SELECT 'CM-010', 'Tax_ID mismatch vs SSCUSTP.ZGTXNO (PROBABLE — confirm mapping)',
       'PROBABLE', COUNT(CASE WHEN  NVL(TRIM(n.Tax_ID),'X') &lt;&gt; NVL(TRIM(s.ZGTXNO),'X') THEN 1 END),
       COUNT(*) AS RESULT_TOTAL,
       CAST(NULL AS VARCHAR2(200))
  FROM NCIS_Customers n
  JOIN MG_CUSTOMER_INTER mci ON mci.PRFT_CUST_ID = n.Customer_Code
  JOIN HUB_MT_SSCUSTP s ON TRIM(s.CUSTOMER_CODE) = TRIM(mci.CUSTOMER_CODE)

UNION ALL
SELECT 'CM-011', 'Family_Status mismatch vs SSINCIP.ZKMST (PROBABLE — confirm mapping)',
       'PROBABLE', COUNT(CASE WHEN  NVL(TRIM(n.Family_Status),'X') &lt;&gt; NVL(TRIM(i.ZKMST),'X') THEN 1 END),
       COUNT(*) AS RESULT_TOTAL,
       CAST(NULL AS VARCHAR2(200))
  FROM NCIS_Customers n
  JOIN MG_CUSTOMER_INTER mci ON mci.PRFT_CUST_ID = n.Customer_Code
  JOIN HUB_MT_SSINCIP i ON TRIM(i.CUSTOMER_CODE) = TRIM(mci.CUSTOMER_CODE)

UNION ALL
SELECT 'CM-012', 'Activity_Code mismatch vs SSCUSTP.ZGINDY (PROBABLE — confirm mapping, see A5)',
       'PROBABLE', COUNT(CASE WHEN  NVL(TRIM(TO_CHAR(n.Activity_Code)),'X') &lt;&gt; NVL(TRIM(TO_CHAR(s.ZGINDY)),'X') THEN 1 END),
       COUNT(*) AS RESULT_TOTAL,
       CAST(NULL AS VARCHAR2(200))
  FROM NCIS_Customers n
  JOIN MG_CUSTOMER_INTER mci ON mci.PRFT_CUST_ID = n.Customer_Code
  JOIN HUB_MT_SSCUSTP s ON TRIM(s.CUSTOMER_CODE) = TRIM(mci.CUSTOMER_CODE)

UNION ALL
SELECT 'CM-013', 'Profession mismatch vs SSINCIP.ZKOCPT (PROBABLE — confirm mapping)',
       'PROBABLE', COUNT(CASE WHEN  NVL(TRIM(n.Profession),'X') &lt;&gt; NVL(TRIM(i.ZKOCPT),'X') THEN 1 END),
       COUNT(*) AS RESULT_TOTAL,
       CAST(NULL AS VARCHAR2(200))
  FROM NCIS_Customers n
  JOIN MG_CUSTOMER_INTER mci ON mci.PRFT_CUST_ID = n.Customer_Code
  JOIN HUB_MT_SSINCIP i ON TRIM(i.CUSTOMER_CODE) = TRIM(mci.CUSTOMER_CODE)

UNION ALL
SELECT 'CM-014', 'Corporation_Registry_Number mismatch vs SSNICIP.XUINCN (PROBABLE — non-individual only)',
       'PROBABLE', COUNT(CASE WHEN  n.Corporation_Registry_Number IS NOT NULL
   AND NVL(TRIM(n.Corporation_Registry_Number),'X') &lt;&gt; NVL(TRIM(ni.XUINCN),'X') THEN 1 END),
       COUNT(CASE WHEN n.Corporation_Registry_Number IS NOT NULL THEN 1 END) AS RESULT_TOTAL,
       CAST(NULL AS VARCHAR2(200))
  FROM NCIS_Customers n
  JOIN MG_CUSTOMER_INTER mci ON mci.PRFT_CUST_ID = n.Customer_Code
  JOIN HUB_MT_SSNICIP ni ON TRIM(ni.CUSTOMER_CODE) = TRIM(mci.CUSTOMER_CODE)

UNION ALL
SELECT 'CM-015', 'Legal_Form mismatch vs SSCUSTP.ZGLGTP (PROBABLE — confirm mapping)',
       'PROBABLE', COUNT(CASE WHEN  NVL(TRIM(TO_CHAR(n.Legal_Form)),'X') &lt;&gt; NVL(TRIM(s.ZGLGTP),'X') THEN 1 END),
       COUNT(*) AS RESULT_TOTAL,
       CAST(NULL AS VARCHAR2(200))
  FROM NCIS_Customers n
  JOIN MG_CUSTOMER_INTER mci ON mci.PRFT_CUST_ID = n.Customer_Code
  JOIN HUB_MT_SSCUSTP s ON TRIM(s.CUSTOMER_CODE) = TRIM(mci.CUSTOMER_CODE)

UNION ALL
SELECT 'CM-016', 'Customer_Type distribution vs SSGHCLP.VQCSTY (LOW CONFIDENCE — for review only)',
       'PROBABLE', COUNT(CASE WHEN  NVL(TRIM(TO_CHAR(n.Customer_Type)),'X') &lt;&gt; NVL(TRIM(g.VQCSTY),'X') THEN 1 END),
       COUNT(*) AS RESULT_TOTAL,
       CAST(NULL AS VARCHAR2(200))
  FROM NCIS_Customers n
  JOIN MG_CUSTOMER_INTER mci ON mci.PRFT_CUST_ID = n.Customer_Code
  JOIN HUB_MT_SSCUSTP s ON TRIM(s.CUSTOMER_CODE) = TRIM(mci.CUSTOMER_CODE)
  JOIN HUB_MT_SSGHCLP g ON TRIM(s.ZGGHCL) = TRIM(g.VQGHCL)

UNION ALL
SELECT 'CM-017', 'Customer_Check_Digit — TODO: no confirmed HUB field (see A3)',
       'NOT_FOUND', COUNT(CASE WHEN  Customer_Check_Digit IS NOT NULL THEN 1 END), COUNT(*), CAST(NULL AS VARCHAR2(200))
  FROM NCIS_Customers

UNION ALL
SELECT 'CM-018', 'First_Name — TODO: derived field only (ZGFNSP/ZGFNLN substring), not directly comparable',
       'NOT_FOUND', COUNT(CASE WHEN  First_Name IS NOT NULL THEN 1 END), COUNT(*), CAST(NULL AS VARCHAR2(200))
