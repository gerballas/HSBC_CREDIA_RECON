                <component
                  refId="Package\Sequence Container\Data Flow Task 1\Oracle Source 1"
                  componentClassID="Microsoft.SSISOracleSrc"
                  contactInfo="Oracle Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;1"
                  description="Oracle Source"
                  name="Oracle Source 1"
                  usesDispositions="true"
                  version="1">
                  <properties>
                    <property
                      dataType="System.String"
                      description="The name of the table to be fetched."
                      expressionType="Notify"
                      name="TableName"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      expressionType="Notify"
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">SELECT
       'Customer_Addresses' AS CHECK_TYPE,
       C.CHECK_ID, C.CHECK_NAME, C.CATEGORY,
       C.RESULT_NUM, C.RESULT_TOTAL, C.RESULT_TXT,
       CASE WHEN C.CATEGORY = 'NOT_FOUND' THEN 'INFO'
            WHEN C.RESULT_NUM = 0            THEN 'PASS'
            ELSE 'REVIEW' END AS STATUS
  FROM (

SELECT 'CM-101' AS CHECK_ID,
       'Customers with address row-count mismatch: NCIS_Customer_addresses vs SSADDRP' AS CHECK_NAME,
       'CONFIRMED' AS CATEGORY,
       COUNT(CASE WHEN NVL(pc.PROFITS_CNT,0) &lt;&gt; NVL(hc.HUB_CNT,0) THEN 1 END) AS RESULT_NUM,
       COUNT(*) AS RESULT_TOTAL,
       CAST(NULL AS VARCHAR2(200)) AS RESULT_TXT
  FROM MG_CUSTOMER_INTER mci
  LEFT JOIN (SELECT Customer_Code, COUNT(*) AS PROFITS_CNT
               FROM NCIS_Customer_addresses
              GROUP BY Customer_Code) pc
    ON pc.Customer_Code = mci.PRFT_CUST_ID
  LEFT JOIN (SELECT TRIM(sc.CUSTOMER_CODE) AS CUSTOMER_CODE, COUNT(*) AS HUB_CNT
               FROM HUB_MT_SSCUSTP sc
               JOIN HUB_MT_SSADDRP s ON s.ZBDCB = sc.ZGDCB AND s.ZBDCS = sc.ZGDCS
              GROUP BY TRIM(sc.CUSTOMER_CODE)) hc
    ON hc.CUSTOMER_CODE = TRIM(mci.CUSTOMER_CODE)
 WHERE pc.Customer_Code IS NOT NULL OR hc.CUSTOMER_CODE IS NOT NULL

UNION ALL
SELECT 'CM-102', 'Customers with PROFITS address but no HUB SSADDRP row',
       'CONFIRMED',
       COUNT(DISTINCT CASE WHEN hcust.CUSTOMER_CODE IS NULL THEN p.Customer_Code END) AS RESULT_NUM,
       COUNT(DISTINCT p.Customer_Code) AS RESULT_TOTAL,
       CAST(NULL AS VARCHAR2(200))
  FROM NCIS_Customer_addresses p
  JOIN MG_CUSTOMER_INTER mci ON mci.PRFT_CUST_ID = p.Customer_Code
  LEFT JOIN (SELECT DISTINCT TRIM(sc.CUSTOMER_CODE) AS CUSTOMER_CODE
               FROM HUB_MT_SSCUSTP sc
               JOIN HUB_MT_SSADDRP s ON s.ZBDCB = sc.ZGDCB AND s.ZBDCS = sc.ZGDCS) hcust
    ON hcust.CUSTOMER_CODE = TRIM(mci.CUSTOMER_CODE)

UNION ALL
SELECT 'CM-103', 'Customers with HUB SSADDRP row but no PROFITS address',
       'CONFIRMED',
       COUNT(DISTINCT CASE WHEN pcust.Customer_Code IS NULL THEN mci.PRFT_CUST_ID END) AS RESULT_NUM,
       COUNT(DISTINCT mci.PRFT_CUST_ID) AS RESULT_TOTAL,
       CAST(NULL AS VARCHAR2(200))
  FROM MG_CUSTOMER_INTER mci
  JOIN HUB_MT_SSCUSTP sc ON TRIM(sc.CUSTOMER_CODE) = TRIM(mci.CUSTOMER_CODE)
  JOIN HUB_MT_SSADDRP s ON s.ZBDCB = sc.ZGDCB AND s.ZBDCS = sc.ZGDCS
  LEFT JOIN (SELECT DISTINCT Customer_Code FROM NCIS_Customer_addresses) pcust
    ON pcust.Customer_Code = mci.PRFT_CUST_ID

UNION ALL
SELECT 'CM-104', 'Country: no matching SSADDRP.ZBADCE found among customer''s HUB addresses (PROBABLE — see A3)',
       'PROBABLE',
       COUNT(CASE WHEN p.Country IS NOT NULL AND h.CUSTOMER_CODE IS NULL THEN 1 END) AS RESULT_NUM,
       COUNT(CASE WHEN p.Country IS NOT NULL THEN 1 END) AS RESULT_TOTAL,
       CAST(NULL AS VARCHAR2(200))
  FROM NCIS_Customer_addresses p
  JOIN MG_CUSTOMER_INTER mci ON mci.PRFT_CUST_ID = p.Customer_Code
  LEFT JOIN (SELECT DISTINCT TRIM(sc.CUSTOMER_CODE) AS CUSTOMER_CODE, TRIM(s.ZBADCE) AS ZBADCE
               FROM HUB_MT_SSCUSTP sc
               JOIN HUB_MT_SSADDRP s ON s.ZBDCB = sc.ZGDCB AND s.ZBDCS = sc.ZGDCS
              WHERE s.ZBADCE IS NOT NULL) h
    ON h.CUSTOMER_CODE = TRIM(mci.CUSTOMER_CODE) AND h.ZBADCE = TRIM(p.Country)

UNION ALL
SELECT 'CM-105', 'Telephone: no matching SSADDRP.ZBTENO/ZBTEN2 found among customer''s HUB addresses (PROBABLE — see A3)',
       'PROBABLE',
       COUNT(CASE WHEN p.Telephone IS NOT NULL AND h.CUSTOMER_CODE IS NULL THEN 1 END) AS RESULT_NUM,
       COUNT(CASE WHEN p.Telephone IS NOT NULL THEN 1 END) AS RESULT_TOTAL,
       CAST(NULL AS VARCHAR2(200))
  FROM NCIS_Customer_addresses p
  JOIN MG_CUSTOMER_INTER mci ON mci.PRFT_CUST_ID = p.Customer_Code
  LEFT JOIN (SELECT DISTINCT TRIM(sc.CUSTOMER_CODE) AS CUSTOMER_CODE, TRIM(s.ZBTENO) AS PHONE
               FROM HUB_MT_SSCUSTP sc
               JOIN HUB_MT_SSADDRP s ON s.ZBDCB = sc.ZGDCB AND s.ZBDCS = sc.ZGDCS
              WHERE s.ZBTENO IS NOT NULL
             UNION
             SELECT DISTINCT TRIM(sc.CUSTOMER_CODE) AS CUSTOMER_CODE, TRIM(s.ZBTEN2) AS PHONE
               FROM HUB_MT_SSCUSTP sc
               JOIN HUB_MT_SSADDRP s ON s.ZBDCB = sc.ZGDCB AND s.ZBDCS = sc.ZGDCS
              WHERE s.ZBTEN2 IS NOT NULL) h
    ON h.CUSTOMER_CODE = TRIM(mci.CUSTOMER_CODE) AND h.PHONE = TRIM(p.Telephone)

UNION ALL
SELECT 'CM-106', 'Fax_Number: no matching SSADDRP.ZBFAXN/ZBFAN2 found among customer''s HUB addresses (PROBABLE — see A3)',
       'PROBABLE',
       COUNT(CASE WHEN p.Fax_Number IS NOT NULL AND h.CUSTOMER_CODE IS NULL THEN 1 END) AS RESULT_NUM,
       COUNT(CASE WHEN p.Fax_Number IS NOT NULL THEN 1 END) AS RESULT_TOTAL,
       CAST(NULL AS VARCHAR2(200))
  FROM NCIS_Customer_addresses p
  JOIN MG_CUSTOMER_INTER mci ON mci.PRFT_CUST_ID = p.Customer_Code
  LEFT JOIN (SELECT DISTINCT TRIM(sc.CUSTOMER_CODE) AS CUSTOMER_CODE, TRIM(s.ZBFAXN) AS FAXNO
               FROM HUB_MT_SSCUSTP sc
               JOIN HUB_MT_SSADDRP s ON s.ZBDCB = sc.ZGDCB AND s.ZBDCS = sc.ZGDCS
              WHERE s.ZBFAXN IS NOT NULL
             UNION
             SELECT DISTINCT TRIM(sc.CUSTOMER_CODE) AS CUSTOMER_CODE, TRIM(s.ZBFAN2) AS FAXNO
               FROM HUB_MT_SSCUSTP sc
               JOIN HUB_MT_SSADDRP s ON s.ZBDCB = sc.ZGDCB AND s.ZBDCS = sc.ZGDCS
              WHERE s.ZBFAN2 IS NOT NULL) h
    ON h.CUSTOMER_CODE = TRIM(mci.CUSTOMER_CODE) AND h.FAXNO = TRIM(p.Fax_Number)

UNION ALL
SELECT 'CM-107', 'Address_2 — TODO: no confirmed line mapping to SSADDRP.ZBNAD1..5 (Address_1 does not exist on NCIS_Customer_addresses)',
       'NOT_FOUND',
       COUNT(CASE WHEN Address_2 IS NOT NULL THEN 1 END),
       COUNT(*) AS RESULT_TOTAL,
       CAST(NULL AS VARCHAR2(200))
  FROM NCIS_Customer_addresses

UNION ALL
SELECT 'CM-108', 'RECON_KEY (ENTRY_COMMENTS) — TODO: no confirmed HUB field, clarify field semantics with NC (see A4)',
       'NOT_FOUND',
       COUNT(CASE WHEN RECON_KEY IS NOT NULL THEN 1 END),
       COUNT(*) AS RESULT_TOTAL,
       CAST(NULL AS VARCHAR2(200))
  FROM NCIS_Customer_addresses
) C
ORDER BY C.CATEGORY, C.CHECK_ID</property>
