        <SQLTask:SqlTaskData
          SQLTask:Connection="{6821A5EC-D23A-4EAE-A8D7-C1BFCD7DE798}"
          SQLTask:SqlStatementSource="IF EXISTS (SELECT 1 FROM sys.tables WHERE name = 'RESULTS_PROFIT' AND schema_id = SCHEMA_ID('RECON'))&#xA;BEGIN&#xA;    EXEC('TRUNCATE TABLE RECON.RESULTS_PROFIT');&#xA;END&#xA;CREATE TABLE RECON.RESULTS_PROFIT (&#xA;    CHECK_TYPE      VARCHAR(50)    NULL,&#xA;    CHECK_ID        VARCHAR(20)    NULL,&#xA;    CHECK_NAME      VARCHAR(500)   NULL,&#xA;    CATEGORY        VARCHAR(20)    NULL,&#xA;    RESULT_NUM      DECIMAL(18,0)  NULL,&#xA;    RESULT_TOTAL    DECIMAL(18,0)  NULL,&#xA;    RESULT_TXT      VARCHAR(200)   NULL,&#xA;    STATUS          VARCHAR(10)    NULL&#xA;);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Sequence Container"
