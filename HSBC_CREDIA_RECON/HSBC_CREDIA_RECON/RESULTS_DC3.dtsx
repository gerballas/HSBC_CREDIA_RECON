  FROM DATACUT3.HIE_EPACMSP
 WHERE BAMDFL NOT IN ('P','S') AND BAMDFL IS NOT NULL
UNION ALL
-- HIE-MF-012 | Mode Flag Distribution — EPDCMSP (BCMDFL)
SELECT 'HIE-MF-012', 'Mode Flag Distribution: EPDCMSP (BCMDFL)',
