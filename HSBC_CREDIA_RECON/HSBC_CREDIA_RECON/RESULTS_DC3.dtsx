  FROM DATACUT3.ATM_MT_ATAACTP
 WHERE DGAPTY IS NULL OR TRIM(DGAPTY) = ''
UNION ALL
-- ATM-MF-008 | Missing Card Number — Transaction Log (EACDNO)
SELECT 'ATM-MF-008', 'Missing Card Number: ATTNFFP (EACDNO)',
       COUNT(*), CAST(NULL AS VARCHAR2(200)), CAST(NULL AS NUMBER)
  FROM DATACUT3.ATM_MT_ATTNFFP
 WHERE EACDNO IS NULL
UNION ALL
-- ATM-MF-009 | Missing Card Number — Transaction Journal (EACDNO)
SELECT 'ATM-MF-009', 'Missing Card Number: ATTNFJP (EACDNO)',
       COUNT(*), CAST(NULL AS VARCHAR2(200)), CAST(NULL AS NUMBER)
  FROM DATACUT3.ATM_MT_ATTNFJP
 WHERE EACDNO IS NULL
UNION ALL
-- ATM-MF-010 | Missing Card Number — Authorisation Log Journal (FACDNO)
SELECT 'ATM-MF-010', 'Missing Card Number: ATAULJP (FACDNO)',
       COUNT(*), CAST(NULL AS VARCHAR2(200)), CAST(NULL AS NUMBER)
  FROM DATACUT3.ATM_MT_ATAULJP
 WHERE FACDNO IS NULL
UNION ALL
-- ATM-MF-011 | Missing Card Number — Daily OD Limit File (TQCDNO)
SELECT 'ATM-MF-011', 'Missing Card Number: MVCLMPP (TQCDNO)',
       COUNT(*), CAST(NULL AS VARCHAR2(200)), CAST(NULL AS NUMBER)
  FROM DATACUT3.ATM_MT_MVCLMPP
 WHERE TQCDNO IS NULL
UNION ALL
-- ATM-MF-012 | Missing Country/Group Member — Account Suffix File (ASCTCD/ASGMAB)
SELECT 'ATM-MF-012', 'Missing Country/Group Member: ATSUFXP (ASCTCD/ASGMAB)',
       COUNT(*), CAST(NULL AS VARCHAR2(200)), CAST(NULL AS NUMBER)
  FROM DATACUT3.ATM_MT_ATSUFXP
 WHERE ASCTCD IS NULL OR TRIM(ASCTCD) = '' OR ASGMAB IS NULL OR TRIM(ASGMAB) = ''
      ) x
    UNION ALL
    SELECT 'CAT-ATM-03 DATE FIELD VALIDITY' AS dq_category, x.check_id, x.check_name, x.result_num, x.result_txt, x.expected
      FROM (
-- ATM-DT-001 | Invalid Date Last Transaction — Cardholder Master (ACDLTN)
SELECT 'ATM-DT-001' AS check_id, 'Invalid Date Last Transaction: ATCAHFP (ACDLTN)' AS check_name,
       COUNT(*) AS RESULT_NUM, CAST(NULL AS VARCHAR2(200)) AS RESULT_TXT, CAST(NULL AS NUMBER) AS EXPECTED
  FROM DATACUT3.ATM_MT_ATCAHFP
 WHERE ACDLTN IS NOT NULL
   AND TO_NUMBER(TO_CHAR(ACDLTN,'YYYYMMDD')) NOT BETWEEN 20000101 AND TO_NUMBER(TO_CHAR(DATE '2026-06-15','YYYYMMDD'))
UNION ALL
-- ATM-DT-002 | Invalid First Issue Date — Cardholder Master (ACFISS)
SELECT 'ATM-DT-002', 'Invalid First Issue Date: ATCAHFP (ACFISS)',
       COUNT(*), CAST(NULL AS VARCHAR2(200)), CAST(NULL AS NUMBER)
  FROM DATACUT3.ATM_MT_ATCAHFP
 WHERE ACFISS IS NOT NULL
   AND TO_NUMBER(TO_CHAR(ACFISS,'YYYYMMDD')) NOT BETWEEN 19900101 AND TO_NUMBER(TO_CHAR(DATE '2026-06-15','YYYYMMDD'))
UNION ALL
-- ATM-DT-003 | Current Issue Date Before First Issue Date — Cardholder Master (ACLISS &lt; ACFISS)
SELECT 'ATM-DT-003', 'Current Issue Date Before First Issue Date: ATCAHFP (ACLISS &lt; ACFISS)',
       COUNT(*), CAST(NULL AS VARCHAR2(200)), CAST(NULL AS NUMBER)
  FROM DATACUT3.ATM_MT_ATCAHFP
 WHERE ACLISS IS NOT NULL AND ACFISS IS NOT NULL AND ACLISS &lt; ACFISS
UNION ALL
-- ATM-DT-004 | Invalid Date Last Maintenance — Cardholder Master (ACDLMT)
SELECT 'ATM-DT-004', 'Invalid Date Last Maintenance: ATCAHFP (ACDLMT)',
       COUNT(*), CAST(NULL AS VARCHAR2(200)), CAST(NULL AS NUMBER)
  FROM DATACUT3.ATM_MT_ATCAHFP
 WHERE ACDLMT IS NOT NULL
   AND TO_NUMBER(TO_CHAR(ACDLMT,'YYYYMMDD')) NOT BETWEEN 20000101 AND TO_NUMBER(TO_CHAR(DATE '2026-06-15','YYYYMMDD'))
UNION ALL
-- ATM-DT-005 | Invalid Transaction Date — Transaction Log (EAXDAT)
SELECT 'ATM-DT-005', 'Invalid Transaction Date: ATTNFFP (EAXDAT)',
       COUNT(*), CAST(NULL AS VARCHAR2(200)), CAST(NULL AS NUMBER)
  FROM DATACUT3.ATM_MT_ATTNFFP
 WHERE EAXDAT IS NULL
    OR TO_NUMBER(TO_CHAR(EAXDAT,'YYYYMMDD')) NOT BETWEEN 20000101 AND TO_NUMBER(TO_CHAR(DATE '2026-06-15','YYYYMMDD'))
UNION ALL
-- ATM-DT-006 | Business Date Before Transaction Date — Transaction Log (EAXBDT &lt; EAXDAT)
SELECT 'ATM-DT-006', 'Business Date Before Transaction Date: ATTNFFP (EAXBDT &lt; EAXDAT)',
       COUNT(*), CAST(NULL AS VARCHAR2(200)), CAST(NULL AS NUMBER)
  FROM DATACUT3.ATM_MT_ATTNFFP
 WHERE EAXBDT IS NOT NULL AND EAXDAT IS NOT NULL AND EAXBDT &lt; EAXDAT
UNION ALL
-- ATM-DT-007 | Invalid Transaction Date — Transaction Journal (EAXDAT)
SELECT 'ATM-DT-007', 'Invalid Transaction Date: ATTNFJP (EAXDAT)',
       COUNT(*), CAST(NULL AS VARCHAR2(200)), CAST(NULL AS NUMBER)
  FROM DATACUT3.ATM_MT_ATTNFJP
 WHERE EAXDAT IS NULL
    OR TO_NUMBER(TO_CHAR(EAXDAT,'YYYYMMDD')) NOT BETWEEN 20000101 AND TO_NUMBER(TO_CHAR(DATE '2026-06-15','YYYYMMDD'))
UNION ALL
-- ATM-DT-008 | Invalid Capture Date — Authorisation Log Journal (FACPDT)
SELECT 'ATM-DT-008', 'Invalid Capture Date: ATAULJP (FACPDT)',
       COUNT(*), CAST(NULL AS VARCHAR2(200)), CAST(NULL AS NUMBER)
  FROM DATACUT3.ATM_MT_ATAULJP
 WHERE FACPDT IS NOT NULL
   AND TO_NUMBER(TO_CHAR(FACPDT,'YYYYMMDD')) NOT BETWEEN 20000101 AND TO_NUMBER(TO_CHAR(DATE '2026-06-15','YYYYMMDD'))
UNION ALL
-- ATM-DT-009 | Invalid Transaction Date — Authorisation Log Journal (FAXDAT)
SELECT 'ATM-DT-009', 'Invalid Transaction Date: ATAULJP (FAXDAT)',
       COUNT(*), CAST(NULL AS VARCHAR2(200)), CAST(NULL AS NUMBER)
  FROM DATACUT3.ATM_MT_ATAULJP
 WHERE FAXDAT IS NOT NULL
   AND TO_NUMBER(TO_CHAR(FAXDAT,'YYYYMMDD')) NOT BETWEEN 20000101 AND TO_NUMBER(TO_CHAR(DATE '2026-06-15','YYYYMMDD'))
UNION ALL
-- ATM-DT-010 | Invalid Transaction Date — Daily OD Limit File (TQXDAT)
SELECT 'ATM-DT-010', 'Invalid Transaction Date: MVCLMPP (TQXDAT)',
       COUNT(*), CAST(NULL AS VARCHAR2(200)), CAST(NULL AS NUMBER)
  FROM DATACUT3.ATM_MT_MVCLMPP
 WHERE TQXDAT IS NULL
    OR TO_NUMBER(TO_CHAR(TQXDAT,'YYYYMMDD')) NOT BETWEEN 20000101 AND TO_NUMBER(TO_CHAR(DATE '2026-06-15','YYYYMMDD'))
UNION ALL
-- ATM-DT-011 | Card Expiry (YYMM, Integer) Implausible — Cardholder Master (ACCDEX)
-- TODO: field is Integer(4) storing YYMM, not Date/Time — plausibility range only
SELECT 'ATM-DT-011', 'Implausible Card Expiry YYMM: ATCAHFP (ACCDEX) [TODO-format]',
       COUNT(*), CAST(NULL AS VARCHAR2(200)), CAST(NULL AS NUMBER)
  FROM DATACUT3.ATM_MT_ATCAHFP
 WHERE ACCDEX IS NOT NULL AND (MOD(ACCDEX,100) NOT BETWEEN 1 AND 12 OR ACCDEX &lt; 2000)
UNION ALL
-- ATM-DT-012 | Card Expiry (YYMM, Integer) Implausible — Transaction Log (EACDEX)
-- TODO: field is Integer(4) storing YYMM, not Date/Time — plausibility range only
SELECT 'ATM-DT-012', 'Implausible Card Expiry YYMM: ATTNFFP (EACDEX) [TODO-format]',
       COUNT(*), CAST(NULL AS VARCHAR2(200)), CAST(NULL AS NUMBER)
  FROM DATACUT3.ATM_MT_ATTNFFP
 WHERE EACDEX IS NOT NULL AND (MOD(EACDEX,100) NOT BETWEEN 1 AND 12 OR EACDEX &lt; 2000)
      ) x
    UNION ALL
    SELECT 'CAT-ATM-04 NUMERIC INTEGRITY &amp; DOMAIN DISTRIBUTIONS' AS dq_category, x.check_id, x.check_name, x.result_num, x.result_txt, x.expected
      FROM (
-- ATM-NI-001 | Missing/NULL Transaction LCY Amount — Transaction Log (EALCY)
SELECT 'ATM-NI-001' AS check_id, 'Missing/NULL Transaction LCY Amount: ATTNFFP (EALCY)' AS check_name,
       COUNT(*) AS RESULT_NUM, CAST(NULL AS VARCHAR2(200)) AS RESULT_TXT, CAST(NULL AS NUMBER) AS EXPECTED
  FROM DATACUT3.ATM_MT_ATTNFFP
 WHERE EALCY IS NULL
UNION ALL
-- ATM-NI-002 | Missing/NULL Transaction Amount — Authorisation Log Journal (FAXAMT)
SELECT 'ATM-NI-002', 'Missing/NULL Transaction Amount: ATAULJP (FAXAMT)',
       COUNT(*), CAST(NULL AS VARCHAR2(200)), CAST(NULL AS NUMBER)
  FROM DATACUT3.ATM_MT_ATAULJP
 WHERE FAXAMT IS NULL
UNION ALL
-- ATM-NI-003 | Negative Annual Card Fee (Normal) — Card Fee File (DPAFEN)
SELECT 'ATM-NI-003', 'Negative Annual Card Fee (Normal): ATCFEEP (DPAFEN)',
       COUNT(*), CAST(NULL AS VARCHAR2(200)), CAST(NULL AS NUMBER)
  FROM DATACUT3.ATM_MT_ATCFEEP
 WHERE DPAFEN &lt; 0
UNION ALL
-- ATM-NI-004 | Negative Global Transaction Charge for CWD — Charge Control (AHCHG1)
SELECT 'ATM-NI-004', 'Negative Global Transaction Charge (CWD): ATCHRGP (AHCHG1)',
       COUNT(*), CAST(NULL AS VARCHAR2(200)), CAST(NULL AS NUMBER)
  FROM DATACUT3.ATM_MT_ATCHRGP
 WHERE AHCHG1 &lt; 0
UNION ALL
-- ATM-NI-005 | Negative Cash Withdrawal Cycle Limit — Cycle Fund Control (BTLCWD)
SELECT 'ATM-NI-005', 'Negative Cash Withdrawal Cycle Limit: ATCYCLP (BTLCWD)',
       COUNT(*), CAST(NULL AS VARCHAR2(200)), CAST(NULL AS NUMBER)
  FROM DATACUT3.ATM_MT_ATCYCLP
 WHERE BTLCWD &lt; 0
UNION ALL
-- ATM-NI-006 | Zero/Negative Daily OD Limit Amount — Daily OD Limit File (TQLMAM)
SELECT 'ATM-NI-006', 'Zero/Negative Daily OD Limit Amount: MVCLMPP (TQLMAM)',
       COUNT(*), CAST(NULL AS VARCHAR2(200)), CAST(NULL AS NUMBER)
  FROM DATACUT3.ATM_MT_MVCLMPP
 WHERE TQLMAM IS NULL OR TQLMAM &lt;= 0
UNION ALL
-- ATM-NI-007 | Card Status Distribution — Cardholder Master (ACCDST) [INFO]
SELECT 'ATM-NI-007', 'Card Status Distribution: ATCAHFP (ACCDST)',
       COUNT(*), NVL(ACCDST,'[NULL]'), CAST(NULL AS NUMBER)
  FROM DATACUT3.ATM_MT_ATCAHFP GROUP BY ACCDST
UNION ALL
-- ATM-NI-008 | Chip Status Distribution — Cardholder Master (ACCHST) [INFO]
SELECT 'ATM-NI-008', 'Chip Status Distribution: ATCAHFP (ACCHST)',
       COUNT(*), NVL(ACCHST,'[NULL]'), CAST(NULL AS NUMBER)
  FROM DATACUT3.ATM_MT_ATCAHFP GROUP BY ACCHST
UNION ALL
-- ATM-NI-009 | Pin Status Distribution — Cardholder Extension (A@PHST) [INFO]
SELECT 'ATM-NI-009', 'Pin Status Distribution: AT@CAHEP (A@PHST)',
       COUNT(*), NVL("A@PHST",'[NULL]'), CAST(NULL AS NUMBER)
  FROM DATACUT3."ATM_MT_AT@CAHEP" GROUP BY "A@PHST"
UNION ALL
-- ATM-NI-010 | ATM Product Type Distribution — Cardholder Master (ACPDTY) [INFO]
SELECT 'ATM-NI-010', 'ATM Product Type Distribution: ATCAHFP (ACPDTY)',
       COUNT(*), NVL(ACPDTY,'[NULL]'), CAST(NULL AS NUMBER)
  FROM DATACUT3.ATM_MT_ATCAHFP GROUP BY ACPDTY
UNION ALL
-- ATM-NI-011 | Transaction Type Distribution — Transaction Log (EATTYP) [INFO]
SELECT 'ATM-NI-011', 'Transaction Type Distribution: ATTNFFP (EATTYP)',
       COUNT(*), NVL(EATTYP,'[NULL]'), CAST(NULL AS NUMBER)
  FROM DATACUT3.ATM_MT_ATTNFFP GROUP BY EATTYP
UNION ALL
-- ATM-NI-012 | Activation Status Distribution — Cardholder Master (ACPATV) [INFO]
SELECT 'ATM-NI-012', 'Activation Status Distribution: ATCAHFP (ACPATV)',
       COUNT(*), NVL(ACPATV,'[NULL]'), CAST(NULL AS NUMBER)
  FROM DATACUT3.ATM_MT_ATCAHFP GROUP BY ACPATV
      ) x
    UNION ALL
    SELECT 'CAT-ATM-05 DUPLICATE DETECTION' AS dq_category, x.check_id, x.check_name, x.result_num, x.result_txt, x.expected
      FROM (
-- ATM-DU-001 | Duplicate Cardholder Master Records (ACCTCD+ACGMAB+ACPAN+ACCINO)
SELECT 'ATM-DU-001' AS check_id, 'Duplicate Cardholder Master: ATCAHFP (ACCTCD+ACGMAB+ACPAN+ACCINO)' AS check_name,
       COUNT(*) AS RESULT_NUM, CAST(NULL AS VARCHAR2(200)) AS RESULT_TXT, CAST(NULL AS NUMBER) AS EXPECTED
  FROM (
    SELECT ACCTCD, ACGMAB, ACPAN, ACCINO, COUNT(*) AS cnt
      FROM DATACUT3.ATM_MT_ATCAHFP
     GROUP BY ACCTCD, ACGMAB, ACPAN, ACCINO HAVING COUNT(*) &gt; 1
  )
UNION ALL
-- ATM-DU-002 | Duplicate Cardholder Extension Records (A@CTCD+A@GMAB+A@PAN+A@CINO)
SELECT 'ATM-DU-002', 'Duplicate Cardholder Extension: AT@CAHEP (A@CTCD+A@GMAB+A@PAN+A@CINO)',
       COUNT(*), CAST(NULL AS VARCHAR2(200)), CAST(NULL AS NUMBER)
  FROM (
    SELECT "A@CTCD", "A@GMAB", "A@PAN", "A@CINO", COUNT(*) AS cnt
      FROM DATACUT3."ATM_MT_AT@CAHEP"
     GROUP BY "A@CTCD", "A@GMAB", "A@PAN", "A@CINO" HAVING COUNT(*) &gt; 1
  )
UNION ALL
-- ATM-DU-003 | Duplicate Product Type Control Records (BUCTCD+BUGMAB+BUAPTY)
SELECT 'ATM-DU-003', 'Duplicate Product Type Control: ATAPTYP (BUCTCD+BUGMAB+BUAPTY)',
       COUNT(*), CAST(NULL AS VARCHAR2(200)), CAST(NULL AS NUMBER)
  FROM (
    SELECT BUCTCD, BUGMAB, BUAPTY, COUNT(*) AS cnt
      FROM DATACUT3.ATM_MT_ATAPTYP
     GROUP BY BUCTCD, BUGMAB, BUAPTY HAVING COUNT(*) &gt; 1
  )
UNION ALL
-- ATM-DU-004 | Duplicate ATM Product Type Records (DFCTCD+DFGMAB+DFPDTY)
SELECT 'ATM-DU-004', 'Duplicate ATM Product Type: ATPDCPP (DFCTCD+DFGMAB+DFPDTY)',
       COUNT(*), CAST(NULL AS VARCHAR2(200)), CAST(NULL AS NUMBER)
  FROM (
    SELECT DFCTCD, DFGMAB, DFPDTY, COUNT(*) AS cnt
      FROM DATACUT3.ATM_MT_ATPDCPP
     GROUP BY DFCTCD, DFGMAB, DFPDTY HAVING COUNT(*) &gt; 1
  )
UNION ALL
-- ATM-DU-005 | Duplicate Account Suffix Records (ASCTCD+ASGMAB+ASSFXS+ASSFXE)
SELECT 'ATM-DU-005', 'Duplicate Account Suffix: ATSUFXP (ASCTCD+ASGMAB+ASSFXS+ASSFXE)',
       COUNT(*), CAST(NULL AS VARCHAR2(200)), CAST(NULL AS NUMBER)
  FROM (
    SELECT ASCTCD, ASGMAB, ASSFXS, ASSFXE, COUNT(*) AS cnt
      FROM DATACUT3.ATM_MT_ATSUFXP
     GROUP BY ASCTCD, ASGMAB, ASSFXS, ASSFXE HAVING COUNT(*) &gt; 1
  )
UNION ALL
-- ATM-DU-006 | Duplicate Card Fee Records (DPCTCD+DPGMAB+DPPDTY+DPAPTY)
SELECT 'ATM-DU-006', 'Duplicate Card Fee: ATCFEEP (DPCTCD+DPGMAB+DPPDTY+DPAPTY)',
       COUNT(*), CAST(NULL AS VARCHAR2(200)), CAST(NULL AS NUMBER)
  FROM (
    SELECT DPCTCD, DPGMAB, DPPDTY, DPAPTY, COUNT(*) AS cnt
      FROM DATACUT3.ATM_MT_ATCFEEP
     GROUP BY DPCTCD, DPGMAB, DPPDTY, DPAPTY HAVING COUNT(*) &gt; 1
  )
UNION ALL
-- ATM-DU-007 | Duplicate Transaction Charge Control Records (AHCTCD+AHGMAB+AHGTID+AHPDTY+AHAPTY)
SELECT 'ATM-DU-007', 'Duplicate Transaction Charge Control: ATCHRGP (AHCTCD+AHGMAB+AHGTID+AHPDTY+AHAPTY)',
       COUNT(*), CAST(NULL AS VARCHAR2(200)), CAST(NULL AS NUMBER)
  FROM (
    SELECT AHCTCD, AHGMAB, AHGTID, AHPDTY, AHAPTY, COUNT(*) AS cnt
      FROM DATACUT3.ATM_MT_ATCHRGP
     GROUP BY AHCTCD, AHGMAB, AHGTID, AHPDTY, AHAPTY HAVING COUNT(*) &gt; 1
  )
UNION ALL
-- ATM-DU-008 | Duplicate Account Type Mapping Records (DGCTCD+DGGMAB+DGAPTY+DGACTY)
SELECT 'ATM-DU-008', 'Duplicate Account Type Mapping: ATAACTP (DGCTCD+DGGMAB+DGAPTY+DGACTY)',
       COUNT(*), CAST(NULL AS VARCHAR2(200)), CAST(NULL AS NUMBER)
  FROM (
    SELECT DGCTCD, DGGMAB, DGAPTY, DGACTY, COUNT(*) AS cnt
      FROM DATACUT3.ATM_MT_ATAACTP
     GROUP BY DGCTCD, DGGMAB, DGAPTY, DGACTY HAVING COUNT(*) &gt; 1
  )
      ) x
    UNION ALL
    SELECT 'CAT-ATM-06 CROSS-TABLE CONSISTENCY WITHIN ME04_ATM' AS dq_category, x.check_id, x.check_name, x.result_num, x.result_txt, x.expected
      FROM (
-- ATM-CR-001 | Cardholder Master Without Matching Extension Record
SELECT 'ATM-CR-001' AS check_id, 'Cardholder Master Without Extension Record: ATCAHFP vs AT@CAHEP' AS check_name,
       COUNT(*) AS RESULT_NUM, CAST(NULL AS VARCHAR2(200)) AS RESULT_TXT, CAST(NULL AS NUMBER) AS EXPECTED
  FROM DATACUT3.ATM_MT_ATCAHFP m
 WHERE NOT EXISTS (
   SELECT 1 FROM DATACUT3."ATM_MT_AT@CAHEP" e
    WHERE e."A@CTCD" = m.ACCTCD AND e."A@GMAB" = m.ACGMAB
      AND e."A@PAN" = m.ACPAN AND e."A@CINO" = m.ACCINO
 )
UNION ALL
-- ATM-CR-002 | Cardholder Product Type Not in Product Control Table
SELECT 'ATM-CR-002', 'Cardholder Product Type Not in ATPDCPP: ATCAHFP (ACPDTY)',
       COUNT(*), CAST(NULL AS VARCHAR2(200)), CAST(NULL AS NUMBER)
  FROM DATACUT3.ATM_MT_ATCAHFP m
 WHERE ACPDTY IS NOT NULL
   AND NOT EXISTS (SELECT 1 FROM DATACUT3.ATM_MT_ATPDCPP p WHERE p.DFPDTY = m.ACPDTY)
UNION ALL
-- ATM-CR-003 | Card Fee Product Type Not in Product Control Table
SELECT 'ATM-CR-003', 'Card Fee Product Type Not in ATPDCPP: ATCFEEP (DPPDTY)',
       COUNT(*), CAST(NULL AS VARCHAR2(200)), CAST(NULL AS NUMBER)
  FROM DATACUT3.ATM_MT_ATCFEEP f
 WHERE DPPDTY IS NOT NULL
   AND NOT EXISTS (SELECT 1 FROM DATACUT3.ATM_MT_ATPDCPP p WHERE p.DFPDTY = f.DPPDTY)
UNION ALL
-- ATM-CR-004 | Transaction Log Product Type Not in Product Control Table
SELECT 'ATM-CR-004', 'Transaction Log Product Type Not in ATPDCPP: ATTNFFP (EAPDTY)',
       COUNT(*), CAST(NULL AS VARCHAR2(200)), CAST(NULL AS NUMBER)
  FROM DATACUT3.ATM_MT_ATTNFFP t
 WHERE EAPDTY IS NOT NULL
   AND NOT EXISTS (SELECT 1 FROM DATACUT3.ATM_MT_ATPDCPP p WHERE p.DFPDTY = t.EAPDTY)
UNION ALL
-- ATM-CR-005 | Supplementary Card Without Matching Cardholder Master Record
SELECT 'ATM-CR-005', 'Supplementary Card Without Cardholder Master: MVATSUP vs ATCAHFP',
       COUNT(*), CAST(NULL AS VARCHAR2(200)), CAST(NULL AS NUMBER)
  FROM DATACUT3.ATM_MT_MVATSUP s
 WHERE NOT EXISTS (SELECT 1 FROM DATACUT3.ATM_MT_ATCAHFP m WHERE m.ACPAN = s.SPCRNO)
      ) x
    UNION ALL
    SELECT 'CAT-ATM-07 CROSS-MODULE REFERENTIAL INTEGRITY - ATM -&gt; HUB' AS dq_category, x.check_id, x.check_name, x.result_num, x.result_txt, x.expected
      FROM (
-- ATM-RI-001 | Cardholder Domestic Customer Link — Row Count Only [TODO-verify HUB key]
SELECT 'ATM-RI-001' AS check_id,
       'Cardholder Domestic Customer Present (ACDCG/ACDCB/ACDCS): ATCAHFP [TODO-verify HUB SSCUSTP key]' AS check_name,
       COUNT(*) AS RESULT_NUM, CAST(NULL AS VARCHAR2(200)) AS RESULT_TXT, CAST(NULL AS NUMBER) AS EXPECTED
  FROM DATACUT3.ATM_MT_ATCAHFP
 WHERE ACDCG IS NOT NULL AND ACDCB IS NOT NULL AND ACDCS IS NOT NULL
UNION ALL
-- ATM-RI-002 | Cardholder Secondary Account 1 Link — Row Count Only [TODO-verify HUB key]
SELECT 'ATM-RI-002',
       'Cardholder Secondary Account 1 Present (ACSCC1/ACSGM1/ACSAN1): ATCAHFP [TODO-verify HUB DDACMSP key]',
       COUNT(*), CAST(NULL AS VARCHAR2(200)), CAST(NULL AS NUMBER)
  FROM DATACUT3.ATM_MT_ATCAHFP
 WHERE ACSCC1 IS NOT NULL AND ACSGM1 IS NOT NULL AND ACSAN1 IS NOT NULL
UNION ALL
-- ATM-RI-003 | Transaction Log From-Account Link — Row Count Only [TODO-verify HUB key]
SELECT 'ATM-RI-003',
       'Transaction Log From-Account Present (EAFCD/EAFGP/EAFAC): ATTNFFP [TODO-verify HUB DDACMSP key]',
       COUNT(*), CAST(NULL AS VARCHAR2(200)), CAST(NULL AS NUMBER)
  FROM DATACUT3.ATM_MT_ATTNFFP
 WHERE EAFCD IS NOT NULL AND EAFGP IS NOT NULL AND EAFAC IS NOT NULL
      ) x
) y
ORDER BY y.dq_category, y.check_id;</property>
