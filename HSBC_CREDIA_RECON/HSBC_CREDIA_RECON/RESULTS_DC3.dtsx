          SQLTask:SqlStatementSource="IF EXISTS (SELECT 1 FROM sys.tables WHERE name = 'RESULTS_DC3' AND schema_id = SCHEMA_ID('RECON'))&#xA;&#xA;BEGIN&#xA;    TRUNCATE TABLE RECON.RESULTS_DC3;&#xA;END&#xA;&#xA;IF NOT EXISTS (SELECT 1 FROM sys.tables WHERE name = 'RESULTS_DC3' AND schema_id = SCHEMA_ID('RECON'))&#xA;&#xA;BEGIN&#xA;    CREATE TABLE RECON.RESULTS_DC3 &#xA;(&#xA;        DQ_TYPE                 NVARCHAR(50)     NOT NULL,&#xA;&#xA;        DQ_CATEGORY     NVARCHAR(100)   NOT NULL,&#xA;&#xA;        CHECK_NAME    NVARCHAR(500)   NULL,&#xA;&#xA;        TABLE_NAME     NVARCHAR(100)   NULL,&#xA;&#xA;        FAILED_RECORDS      BIGINT          NULL,&#xA;&#xA;        TOTAL_RECORDS        BIGINT          NULL,&#xA;&#xA;        FAILURE_PCT        DECIMAL(10,2)   NULL,&#xA;&#xA;        CHECK_ID             NVARCHAR(20)    NULL,&#xA;&#xA;        RESULT_NUM         DECIMAL(20,2)   NULL,&#xA;&#xA;        RESULT_TXT       NVARCHAR(2000)   NULL,&#xA;&#xA;        EXPECTED               DECIMAL(20,2)   NULL,&#xA;&#xA;        DQ_STATUS          NVARCHAR(20)    NULL&#xA;    );&#xA;END" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
