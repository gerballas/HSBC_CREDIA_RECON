  FROM DATACUT3.HUB_MT_SSCDDMP
 WHERE CMRSKC IN ('H', 'HIGH', '3')
   AND (CMCLDR IS NULL OR CMCLDR &lt; ADD_MONTHS(TRUNC(DATE '2026-06-15'), -12))
UNION ALL
-- AML-003 | KYC Standard Distribution
SELECT 'AML-003', 'KYC Standard Distribution: SSCDDMP (CMKYCS)',
	   CAST(COUNT(*) AS NUMBER), CAST(NVL(CMKYCS, '[NULL]') AS VARCHAR2(200)), CAST(NULL AS NUMBER)
  FROM DATACUT3.HUB_MT_SSCDDMP
 GROUP BY CMKYCS
UNION ALL
-- AML-003 | [sentinel]
SELECT 'AML-003', 'KYC Standard Distribution: SSCDDMP (CMKYCS)', 0, CAST(NULL AS VARCHAR2(200)), CAST(NULL AS NUMBER)
  FROM DUAL
 WHERE NOT EXISTS (SELECT 1 FROM DATACUT3.HUB_MT_SSCDDMP)
UNION ALL
-- AML-004 | Blacklist without Identity Document
SELECT 'AML-004', 'Blacklist without Identity Doc V7IDNO: SSBKLSP',
