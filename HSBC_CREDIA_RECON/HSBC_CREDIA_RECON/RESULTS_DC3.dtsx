-- DC13-RI-023 | SETPARSAFE Record Without Matching DECEASED Main Document (orphan SNo)
SELECT 'DC13-RI-023', 'Orphan SETPARSAFE Record (SNo not in DECEASED): ME13_SETPARSAFE',
       COUNT(*), CAST(NULL AS VARCHAR2(200)), CAST(NULL AS NUMBER)
  FROM DATACUT3.ME13_SETPARSAFE C
 WHERE C.SNo IS NOT NULL
   AND NOT EXISTS (SELECT 1 FROM DATACUT3.ME13_DECEASED D WHERE D.SNo = C.SNo)
      ) x
    UNION ALL
    SELECT 'CAT-DC13-04 DUPLICATE CHECKS - DECEASED Main Document' AS dq_category, x.check_id, x.check_name, x.result_num, x.result_txt, x.expected
      FROM (
-- DC13-DP-001 | Duplicate SNo (file ref number should be unique) in DECEASED
SELECT 'DC13-DP-001', 'Duplicate SNo (File Ref Number): ME13_DECEASED',
       COUNT(*), CAST(NULL AS VARCHAR2(200)), CAST(NULL AS NUMBER)
  FROM (SELECT SNo FROM DATACUT3.ME13_DECEASED
        WHERE TRIM(SNo) IS NOT NULL GROUP BY SNo HAVING COUNT(*) &gt; 1)
UNION ALL
-- DC13-DP-002 | Duplicate CustNo (same HUB customer deceased-flagged more than once)
SELECT 'DC13-DP-002', 'Duplicate CustNo Across Deceased Files: ME13_DECEASED',
       COUNT(*), CAST(NULL AS VARCHAR2(200)), CAST(NULL AS NUMBER)
  FROM (SELECT CustNo FROM DATACUT3.ME13_DECEASED
        WHERE TRIM(CustNo) IS NOT NULL GROUP BY CustNo HAVING COUNT(*) &gt; 1)
UNION ALL
-- DC13-DP-003 | Duplicate IdNo (same ID Card/Passport across deceased files)
SELECT 'DC13-DP-003', 'Duplicate IdNo Across Deceased Files: ME13_DECEASED',
       COUNT(*), CAST(NULL AS VARCHAR2(200)), CAST(NULL AS NUMBER)
  FROM (SELECT IdNo FROM DATACUT3.ME13_DECEASED
        WHERE TRIM(IdNo) IS NOT NULL GROUP BY IdNo HAVING COUNT(*) &gt; 1)
UNION ALL
-- DC13-DP-004 | Possible duplicate person entry: same Firstname+Surname+DOB year, different SNo (INFO)
SELECT 'DC13-DP-004', 'Possible Duplicate Person (Firstname+Surname+DODyy, different SNo): ME13_DECEASED',
       COUNT(*), CAST(NULL AS VARCHAR2(200)), CAST(NULL AS NUMBER)
  FROM (SELECT Firstname, Surname, DODyy FROM DATACUT3.ME13_DECEASED
        WHERE TRIM(Firstname) IS NOT NULL AND TRIM(Surname) IS NOT NULL
        GROUP BY Firstname, Surname, DODyy HAVING COUNT(*) &gt; 1)
      ) x
    UNION ALL
    SELECT 'CAT-DC13-05 STATUS / WORKFLOW DISTRIBUTION' AS dq_category, x.check_id, x.check_name, x.result_num, x.result_txt, x.expected
      FROM (
-- DC13-DM-001 | Document STATUS Distribution: DECEASED
SELECT 'DC13-DM-001', 'Document STATUS Distribution: ME13_DECEASED',
       COUNT(*), NVL(STATUS,'[NULL]'), CAST(NULL AS NUMBER)
  FROM DATACUT3.ME13_DECEASED GROUP BY STATUS
UNION ALL
-- DC13-DM-002 | Purge Status Distribution: DECEASED
SELECT 'DC13-DM-002', 'PURGE_STATUS Distribution: ME13_DECEASED',
       COUNT(*), NVL(PURGE_STATUS,'[NULL]'), CAST(NULL AS NUMBER)
  FROM DATACUT3.ME13_DECEASED GROUP BY PURGE_STATUS
UNION ALL
-- DC13-DM-003 | Civil Status (State) Distribution: DECEASED
SELECT 'DC13-DM-003', 'Civil Status (State) Distribution: ME13_DECEASED',
       COUNT(*), NVL(State,'[NULL]'), CAST(NULL AS NUMBER)
  FROM DATACUT3.ME13_DECEASED GROUP BY State
UNION ALL
-- DC13-DM-004 | Testate (Has a Will) Distribution: DECEASED
SELECT 'DC13-DM-004', 'Testate Distribution: ME13_DECEASED',
       COUNT(*), NVL(Testate,'[NULL]'), CAST(NULL AS NUMBER)
  FROM DATACUT3.ME13_DECEASED GROUP BY Testate
UNION ALL
-- DC13-DM-005 | Death Certificate Availability Distribution: DECEASED
SELECT 'DC13-DM-005', 'Death Certificate Availability Distribution (deathcert): ME13_DECEASED',
       COUNT(*), NVL(deathcert,'[NULL]'), CAST(NULL AS NUMBER)
  FROM DATACUT3.ME13_DECEASED GROUP BY deathcert
UNION ALL
-- DC13-DM-006 | HasChaser Distribution: DECEASED
SELECT 'DC13-DM-006', 'HasChaser Distribution: ME13_DECEASED',
       COUNT(*), NVL(HasChaser,'[NULL]'), CAST(NULL AS NUMBER)
  FROM DATACUT3.ME13_DECEASED GROUP BY HasChaser
UNION ALL
-- DC13-DM-007 | Settlement Type Distribution: G355SETT
SELECT 'DC13-DM-007', 'Settlement Type Distribution (TYPEOFSETTLEMENT): ME13_G355SETT',
       COUNT(*), NVL(TYPEOFSETTLEMENT,'[NULL]'), CAST(NULL AS NUMBER)
  FROM DATACUT3.ME13_G355SETT GROUP BY TYPEOFSETTLEMENT
UNION ALL
-- DC13-DM-008 | Document STATUS Distribution: G355SETT
SELECT 'DC13-DM-008', 'Document STATUS Distribution: ME13_G355SETT',
       COUNT(*), NVL(STATUS,'[NULL]'), CAST(NULL AS NUMBER)
  FROM DATACUT3.ME13_G355SETT GROUP BY STATUS
UNION ALL
-- DC13-DM-009 | Settlement Type Distribution: SETCLSDACC (Closed Accounts)
SELECT 'DC13-DM-009', 'SettlementType Distribution: ME13_SETCLSDACC',
       COUNT(*), NVL(SettlementType,'[NULL]'), CAST(NULL AS NUMBER)
  FROM DATACUT3.ME13_SETCLSDACC GROUP BY SettlementType
UNION ALL
-- DC13-DM-010 | Card Products "Choice" (Selection of Information in Hand) Distribution
SELECT 'DC13-DM-010', 'Choice Distribution: ME13_CARDPRODS',
       COUNT(*), NVL(Choice,'[NULL]'), CAST(NULL AS NUMBER)
  FROM DATACUT3.ME13_CARDPRODS GROUP BY Choice
      ) x
    UNION ALL
    SELECT 'CAT-DC13-06 SETTLEMENT WORKFLOW CONSISTENCY' AS dq_category, x.check_id, x.check_name, x.result_num, x.result_txt, x.expected
      FROM (
-- DC13-WF-001 | STATUS text suggests closed/settled but Datesettled is NULL
-- TODO: confirm exact closed/settled STATUS code values with NC/HSBC (assumed contains
-- 'CLOS' or 'SETT' — this pattern-match is a placeholder until the code list is confirmed)
SELECT 'DC13-WF-001', 'STATUS Suggests Closed/Settled but Datesettled NULL: ME13_DECEASED',
       COUNT(*), CAST(NULL AS VARCHAR2(200)), CAST(NULL AS NUMBER)
  FROM DATACUT3.ME13_DECEASED
 WHERE (UPPER(STATUS) LIKE '%CLOS%' OR UPPER(STATUS) LIKE '%SETT%')
   AND Datesettled IS NULL
UNION ALL
-- DC13-WF-002 | Datesettled populated but STATUS does not indicate closed/settled (inconsistent)
SELECT 'DC13-WF-002', 'Datesettled Populated but STATUS Not Closed/Settled: ME13_DECEASED',
       COUNT(*), CAST(NULL AS VARCHAR2(200)), CAST(NULL AS NUMBER)
  FROM DATACUT3.ME13_DECEASED
 WHERE Datesettled IS NOT NULL
   AND NOT (UPPER(STATUS) LIKE '%CLOS%' OR UPPER(STATUS) LIKE '%SETT%')
UNION ALL
-- DC13-WF-003 | G355SETT settlement record exists but parent DECEASED.Datesettled is NULL
SELECT 'DC13-WF-003', 'G355SETT Exists but Parent Datesettled NULL: ME13_G355SETT vs ME13_DECEASED',
       COUNT(*), CAST(NULL AS VARCHAR2(200)), CAST(NULL AS NUMBER)
  FROM DATACUT3.ME13_G355SETT G
  JOIN DATACUT3.ME13_DECEASED D ON D.SNo = G.SNo
 WHERE D.Datesettled IS NULL
UNION ALL
-- DC13-WF-004 | Closed-account settlement record (SETCLSDACC) with no matching G355SETT
SELECT 'DC13-WF-004', 'SETCLSDACC Without Matching G355SETT: ME13_SETCLSDACC vs ME13_G355SETT',
       COUNT(*), CAST(NULL AS VARCHAR2(200)), CAST(NULL AS NUMBER)
  FROM DATACUT3.ME13_SETCLSDACC S
 WHERE S.SNo IS NOT NULL
   AND NOT EXISTS (SELECT 1 FROM DATACUT3.ME13_G355SETT G WHERE G.SNo = S.SNo)
UNION ALL
-- DC13-WF-005 | Withdrawal-from-account record (SETWDRWACC) with no matching G355SETT
SELECT 'DC13-WF-005', 'SETWDRWACC Without Matching G355SETT: ME13_SETWDRWACC vs ME13_G355SETT',
       COUNT(*), CAST(NULL AS VARCHAR2(200)), CAST(NULL AS NUMBER)
  FROM DATACUT3.ME13_SETWDRWACC S
 WHERE S.SNo IS NOT NULL
   AND NOT EXISTS (SELECT 1 FROM DATACUT3.ME13_G355SETT G WHERE G.SNo = S.SNo)
UNION ALL
-- DC13-WF-006 | HasChaser = Y on DECEASED but no CHASER record exists for that file
SELECT 'DC13-WF-006', 'HasChaser=Y but No CHASER Record: ME13_DECEASED vs ME13_CHASER',
       COUNT(*), CAST(NULL AS VARCHAR2(200)), CAST(NULL AS NUMBER)
  FROM DATACUT3.ME13_DECEASED D
 WHERE UPPER(TRIM(D.HasChaser)) = 'Y'
   AND NOT EXISTS (SELECT 1 FROM DATACUT3.ME13_CHASER C WHERE C.SNo = D.SNo)
UNION ALL
-- DC13-WF-007 | CHASER record exists but parent DECEASED.HasChaser is not Y (inconsistent flag)
SELECT 'DC13-WF-007', 'CHASER Record Exists but HasChaser&lt;&gt;Y on Parent: ME13_CHASER vs ME13_DECEASED',
       COUNT(*), CAST(NULL AS VARCHAR2(200)), CAST(NULL AS NUMBER)
  FROM DATACUT3.ME13_CHASER C
  JOIN DATACUT3.ME13_DECEASED D ON D.SNo = C.SNo
 WHERE NVL(UPPER(TRIM(D.HasChaser)),'N') &lt;&gt; 'Y'
UNION ALL
-- DC13-WF-008 | Purged file (PURGE_STATUS) still carrying child sub-form records (INFO)
-- TODO: confirm exact purge status code / expected post-purge child-record behaviour with NC
SELECT 'DC13-WF-008', 'Purged DECEASED File Still Has Child Records (scope TBC): ME13_DECEASED',
       COUNT(*), CAST(NULL AS VARCHAR2(200)), CAST(NULL AS NUMBER)
  FROM DATACUT3.ME13_DECEASED D
 WHERE UPPER(NVL(D.PURGE_STATUS,'')) LIKE '%PURG%'
   AND EXISTS (SELECT 1 FROM DATACUT3.ME13_HELDFUNDS H WHERE H.SNo = D.SNo)
      ) x
    UNION ALL
    SELECT 'CAT-DC13-07 CURRENCY / AMOUNT SANITY' AS dq_category, x.check_id, x.check_name, x.result_num, x.result_txt, x.expected
      FROM (
-- DC13-FN-001 | Negative card outstanding balance (Bal1-4): CARDPRODS
SELECT 'DC13-FN-001', 'Negative Card Outstanding Balance (Bal1-4): ME13_CARDPRODS',
       COUNT(*), CAST(NULL AS VARCHAR2(200)), CAST(NULL AS NUMBER)
  FROM DATACUT3.ME13_CARDPRODS
 WHERE NVL(Bal1,0) &lt; 0 OR NVL(Bal2,0) &lt; 0 OR NVL(Bal3,0) &lt; 0 OR NVL(Bal4,0) &lt; 0
UNION ALL
-- DC13-FN-002 | Negative security amount (CCAmnt1): COMPSEC (representative field of 10)
-- TODO: extend to CCAmnt2..10 once column list is scripted/generated for production run
SELECT 'DC13-FN-002', 'Negative Security Amount (CCAmnt1): ME13_COMPSEC',
       COUNT(*), CAST(NULL AS VARCHAR2(200)), CAST(NULL AS NUMBER)
