      ) x
    UNION ALL
    SELECT 'CAT-ATM-02 MANDATORY FIELDS - NULL/BLANK' AS dq_category, x.check_id, x.check_name, x.result_num, x.result_txt, x.expected
      FROM (
-- ATM-MF-001 | Missing Primary Account Number — Cardholder Master (ACPAN)
SELECT 'ATM-MF-001' AS check_id, 'Missing PAN: ATCAHFP (ACPAN)' AS check_name,
       COUNT(*) AS RESULT_NUM, CAST(NULL AS VARCHAR2(200)) AS RESULT_TXT, CAST(NULL AS NUMBER) AS EXPECTED
  FROM DATACUT3.ATM_MT_ATCAHFP
 WHERE ACPAN IS NULL
UNION ALL
-- ATM-MF-002 | Missing Country/Group Member — Cardholder Master (ACCTCD/ACGMAB)
SELECT 'ATM-MF-002', 'Missing Country/Group Member: ATCAHFP (ACCTCD/ACGMAB)',
       COUNT(*), CAST(NULL AS VARCHAR2(200)), CAST(NULL AS NUMBER)
  FROM DATACUT3.ATM_MT_ATCAHFP
 WHERE ACCTCD IS NULL OR TRIM(ACCTCD) = '' OR ACGMAB IS NULL OR TRIM(ACGMAB) = ''
UNION ALL
-- ATM-MF-003 | Missing Card Status — Cardholder Master (ACCDST)
SELECT 'ATM-MF-003', 'Missing Card Status: ATCAHFP (ACCDST)',
       COUNT(*), CAST(NULL AS VARCHAR2(200)), CAST(NULL AS NUMBER)
  FROM DATACUT3.ATM_MT_ATCAHFP
 WHERE ACCDST IS NULL OR TRIM(ACCDST) = ''
UNION ALL
-- ATM-MF-004 | Missing PAN — Cardholder Extension (A@PAN)
SELECT 'ATM-MF-004', 'Missing PAN: AT@CAHEP (A@PAN)',
       COUNT(*), CAST(NULL AS VARCHAR2(200)), CAST(NULL AS NUMBER)
  FROM DATACUT3."ATM_MT_AT@CAHEP"
 WHERE "A@PAN" IS NULL
UNION ALL
-- ATM-MF-005 | Missing ATMP Product Type — Product Control (BUPDTY)
SELECT 'ATM-MF-005', 'Missing ATMP Product Type Link: ATAPTYP (BUPDTY)',
       COUNT(*), CAST(NULL AS VARCHAR2(200)), CAST(NULL AS NUMBER)
  FROM DATACUT3.ATM_MT_ATAPTYP
 WHERE BUPDTY IS NULL OR TRIM(BUPDTY) = ''
