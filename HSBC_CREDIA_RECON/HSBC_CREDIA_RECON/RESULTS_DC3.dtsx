  FROM DATACUT3.ME13_CUSTODY
 WHERE NVL(Amnt1,0) &lt; 0
UNION ALL
-- DC13-FN-004 | Negative fund management amount (Amnt1): FUNDMAN
SELECT 'DC13-FN-004', 'Negative Fund Management Amount (Amnt1): ME13_FUNDMAN',
