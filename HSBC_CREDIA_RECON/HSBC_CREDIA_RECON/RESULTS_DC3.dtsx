                  version="1">
                  <properties>
                    <property
                      dataType="System.String"
                      description="The name of the table to be fetched."
                      expressionType="Notify"
                      name="TableName"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      expressionType="Notify"
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">SELECT
    CAST('ME20_HIE' AS NVARCHAR2(50))          AS DQ_TYPE,
    CAST(y.dq_category AS NVARCHAR2(100))       AS DQ_CATEGORY,
    CAST(y.check_name  AS NVARCHAR2(500))      AS CHECK_NAME,
    CAST(NULL AS NVARCHAR2(100))               AS TABLE_NAME,
    CAST(NULL AS NUMBER)                       AS FAILED_RECORDS,
    CAST(y.result_num AS NUMBER)               AS TOTAL_RECORDS,
    CAST(NULL AS NUMBER)                       AS FAILURE_PCT,
    CAST(y.check_id AS NVARCHAR2(20))          AS CHECK_ID,
    CAST(y.result_num AS NUMBER(20,2))         AS RESULT_NUM,
    CAST(y.result_txt AS NVARCHAR2(2000))       AS RESULT_TXT,
    CAST(y.expected AS NUMBER(20,2))           AS EXPECTED,
    CAST(
        CASE
            WHEN y.expected IS NOT NULL
              THEN CASE WHEN ABS(y.result_num - y.expected) * 100.0 / NULLIF(y.expected, 0) &lt;= 0.1
                        THEN 'PASS' ELSE 'REVIEW' END
            WHEN y.result_txt IS NULL
              THEN CASE WHEN y.result_num = 0 THEN 'PASS' ELSE 'FAIL' END
            ELSE 'INFO'
        END AS NVARCHAR2(20)
    ) AS DQ_STATUS
FROM (
    SELECT 'CAT-HIE-01 VOLUME RECONCILIATION' AS dq_category, x.check_id, x.check_name, x.result_num, x.result_txt, x.expected
      FROM (
-- HIE-RC-001 | Row Count: IMP DC Master (HIE_IPDCMSP)
-- ANALYSIS: Primary Imports DC master. EXPECTED TBD — OI-011.
SELECT 'HIE-RC-001' AS check_id, 'Row Count: IMP DC Master (IPDCMSP)' AS check_name,
       COUNT(*) AS RESULT_NUM, CAST(NULL AS VARCHAR2(200)) AS RESULT_TXT,
       CAST(NULL AS NUMBER) AS EXPECTED
  FROM DATACUT3.HIE_IPDCMSP
UNION ALL
-- HIE-RC-002 | Row Count: EXP Collection File Master (HIE_EPCFMSP)
SELECT 'HIE-RC-002', 'Row Count: EXP Collection File Master (EPCFMSP)',
       COUNT(*), CAST(NULL AS VARCHAR2(200)), CAST(NULL AS NUMBER)
  FROM DATACUT3.HIE_EPCFMSP
UNION ALL
-- HIE-RC-003 | Row Count: IMP DC Clause Record (HIE_IPMSCLP)
SELECT 'HIE-RC-003', 'Row Count: IMP DC Clause Record (IPMSCLP)',
       COUNT(*), CAST(NULL AS VARCHAR2(200)), CAST(NULL AS NUMBER)
  FROM DATACUT3.HIE_IPMSCLP
UNION ALL
-- HIE-RC-004 | Row Count: IMP DC History (HIE_IPDCHSP)
SELECT 'HIE-RC-004', 'Row Count: IMP DC History (IPDCHSP)',
       COUNT(*), CAST(NULL AS VARCHAR2(200)), CAST(NULL AS NUMBER)
  FROM DATACUT3.HIE_IPDCHSP
UNION ALL
-- HIE-RC-005 | Row Count: IMP A/C Master (HIE_IPACMSP)
SELECT 'HIE-RC-005', 'Row Count: IMP A/C Master (IPACMSP)',
       COUNT(*), CAST(NULL AS VARCHAR2(200)), CAST(NULL AS NUMBER)
  FROM DATACUT3.HIE_IPACMSP
UNION ALL
-- HIE-RC-006 | Row Count: IMP Loan Master (HIE_IPLNMSP)
SELECT 'HIE-RC-006', 'Row Count: IMP Loan Master (IPLNMSP)',
       COUNT(*), CAST(NULL AS VARCHAR2(200)), CAST(NULL AS NUMBER)
  FROM DATACUT3.HIE_IPLNMSP
UNION ALL
-- HIE-RC-007 | Row Count: IMP Loan Interest History (HIE_IPLNIHP)
SELECT 'HIE-RC-007', 'Row Count: IMP Loan Interest History (IPLNIHP)',
