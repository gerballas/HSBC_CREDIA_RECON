	UNION ALL
	-- RC-011 | Row Count: IBAN Master (DDIBANP)  – no mode_flag on this table
	SELECT 'RC-011' AS check_id, 'Row Count: IBAN Master' AS check_name,
		   COUNT(*) AS RESULT_NUM, CAST(NULL AS VARCHAR2(200)) AS RESULT_TXT, 289105 AS EXPECTED
