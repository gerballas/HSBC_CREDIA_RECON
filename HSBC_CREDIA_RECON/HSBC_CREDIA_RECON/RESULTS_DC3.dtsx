                </component>
                <component
                  refId="Package\RESULTS_DC3\ME13_DECEASED_DQC\Oracle Source"
                  componentClassID="Microsoft.SSISOracleSrc"
                  contactInfo="Oracle Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;1"
                  description="Oracle Source"
                  name="Oracle Source"
                  usesDispositions="true"
                  version="1">
                  <properties>
                    <property
                      dataType="System.String"
                      description="The name of the table to be fetched."
                      expressionType="Notify"
                      name="TableName"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      expressionType="Notify"
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">SELECT
    CAST('ME13_DECEASED' AS NVARCHAR2(50))     AS DQ_TYPE,
    CAST(y.dq_category AS NVARCHAR2(100))       AS DQ_CATEGORY,
    CAST(y.check_name  AS NVARCHAR2(500))      AS CHECK_NAME,
    CAST(NULL AS NVARCHAR2(100))               AS TABLE_NAME,
    CAST(NULL AS NUMBER)                       AS FAILED_RECORDS,
    CAST(y.result_num AS NUMBER)               AS TOTAL_RECORDS,
    CAST(NULL AS NUMBER)                       AS FAILURE_PCT,
    CAST(y.check_id AS NVARCHAR2(20))          AS CHECK_ID,
    CAST(y.result_num AS NUMBER(20,2))         AS RESULT_NUM,
    CAST(y.result_txt AS NVARCHAR2(2000))       AS RESULT_TXT,
    CAST(y.expected AS NUMBER(20,2))           AS EXPECTED,
    CAST(
        CASE
            WHEN y.expected IS NOT NULL
              THEN CASE WHEN ABS(y.result_num - y.expected) * 100.0 / NULLIF(y.expected, 0) &lt;= 0.1
                        THEN 'PASS' ELSE 'REVIEW' END
            WHEN y.result_txt IS NULL
              THEN CASE WHEN y.result_num = 0 THEN 'PASS' ELSE 'FAIL' END
            ELSE 'INFO'
        END AS NVARCHAR2(20)
    ) AS DQ_STATUS
FROM (
    SELECT 'CAT-DC13-01 COMPLETENESS - DECEASED Main Document' AS dq_category, x.check_id, x.check_name, x.result_num, x.result_txt, x.expected
      FROM (
-- DC13-CM-001 | Blank SNo (file reference / PK) in DECEASED
SELECT 'DC13-CM-001', 'Blank SNo (File Ref Number): ME13_DECEASED',
       COUNT(*), CAST(NULL AS VARCHAR2(200)), CAST(NULL AS NUMBER)
  FROM DATACUT3.ME13_DECEASED
 WHERE TRIM(SNo) IS NULL
UNION ALL
-- DC13-CM-002 | Blank Firstname in DECEASED
SELECT 'DC13-CM-002', 'Blank Firstname: ME13_DECEASED',
       COUNT(*), CAST(NULL AS VARCHAR2(200)), CAST(NULL AS NUMBER)
  FROM DATACUT3.ME13_DECEASED
 WHERE TRIM(Firstname) IS NULL
UNION ALL
-- DC13-CM-003 | Blank Surname in DECEASED
SELECT 'DC13-CM-003', 'Blank Surname: ME13_DECEASED',
       COUNT(*), CAST(NULL AS VARCHAR2(200)), CAST(NULL AS NUMBER)
  FROM DATACUT3.ME13_DECEASED
 WHERE TRIM(Surname) IS NULL
UNION ALL
-- DC13-CM-004 | Blank CustNo (HUB customer link) in DECEASED
SELECT 'DC13-CM-004', 'Blank CustNo (HUB Customer Link Missing): ME13_DECEASED',
       COUNT(*), CAST(NULL AS VARCHAR2(200)), CAST(NULL AS NUMBER)
  FROM DATACUT3.ME13_DECEASED
 WHERE TRIM(CustNo) IS NULL
UNION ALL
-- DC13-CM-005 | Blank IdNo (ID Card/Passport) in DECEASED
SELECT 'DC13-CM-005', 'Blank IdNo (ID/Passport): ME13_DECEASED',
       COUNT(*), CAST(NULL AS VARCHAR2(200)), CAST(NULL AS NUMBER)
  FROM DATACUT3.ME13_DECEASED
 WHERE TRIM(IdNo) IS NULL
UNION ALL
-- DC13-CM-006 | Blank STATUS in DECEASED
SELECT 'DC13-CM-006', 'Blank Document STATUS: ME13_DECEASED',
       COUNT(*), CAST(NULL AS VARCHAR2(200)), CAST(NULL AS NUMBER)
  FROM DATACUT3.ME13_DECEASED
 WHERE TRIM(STATUS) IS NULL
UNION ALL
-- DC13-CM-007 | All three Date-of-Death components blank
SELECT 'DC13-CM-007', 'All DOD Components Blank (DODdd/DODmm/DODyy): ME13_DECEASED',
       COUNT(*), CAST(NULL AS VARCHAR2(200)), CAST(NULL AS NUMBER)
  FROM DATACUT3.ME13_DECEASED
 WHERE TRIM(DODdd) IS NULL AND TRIM(DODmm) IS NULL AND TRIM(DODyy) IS NULL
UNION ALL
-- DC13-CM-008 | All three Date-of-Birth components blank
SELECT 'DC13-CM-008', 'All DOB Components Blank (Dobdd/dobmm/dobyy): ME13_DECEASED',
       COUNT(*), CAST(NULL AS VARCHAR2(200)), CAST(NULL AS NUMBER)
  FROM DATACUT3.ME13_DECEASED
 WHERE TRIM(Dobdd) IS NULL AND TRIM(dobmm) IS NULL AND TRIM(dobyy) IS NULL
UNION ALL
-- DC13-CM-009 | Testate = Y (has a Will) but Legal Advisor name blank
SELECT 'DC13-CM-009', 'Testate=Y but Legal Advisor (LAdvisor) Blank: ME13_DECEASED',
       COUNT(*), CAST(NULL AS VARCHAR2(200)), CAST(NULL AS NUMBER)
  FROM DATACUT3.ME13_DECEASED
 WHERE UPPER(TRIM(Testate)) = 'Y' AND TRIM(LAdvisor) IS NULL
UNION ALL
-- DC13-CM-010 | HasChaser = Y but ChaserDate blank
SELECT 'DC13-CM-010', 'HasChaser=Y but ChaserDate Blank: ME13_DECEASED',
       COUNT(*), CAST(NULL AS VARCHAR2(200)), CAST(NULL AS NUMBER)
  FROM DATACUT3.ME13_DECEASED
 WHERE UPPER(TRIM(HasChaser)) = 'Y' AND ChaserDate IS NULL
      ) x
    UNION ALL
    SELECT 'CAT-DC13-02 VALIDITY - Date Components &amp; Date Ordering' AS dq_category, x.check_id, x.check_name, x.result_num, x.result_txt, x.expected
      FROM (
-- DC13-DT-001 | DODdd not numeric or out of 01-31 range
SELECT 'DC13-DT-001', 'Invalid DODdd Component (not 01-31): ME13_DECEASED',
       COUNT(*), CAST(NULL AS VARCHAR2(200)), CAST(NULL AS NUMBER)
  FROM DATACUT3.ME13_DECEASED
 WHERE TRIM(DODdd) IS NOT NULL
   AND (NOT REGEXP_LIKE(TRIM(DODdd), '^[0-9]+$') OR TO_NUMBER(DODdd) NOT BETWEEN 1 AND 31)
UNION ALL
-- DC13-DT-002 | DODmm not numeric or out of 01-12 range
SELECT 'DC13-DT-002', 'Invalid DODmm Component (not 01-12): ME13_DECEASED',
       COUNT(*), CAST(NULL AS VARCHAR2(200)), CAST(NULL AS NUMBER)
  FROM DATACUT3.ME13_DECEASED
 WHERE TRIM(DODmm) IS NOT NULL
   AND (NOT REGEXP_LIKE(TRIM(DODmm), '^[0-9]+$') OR TO_NUMBER(DODmm) NOT BETWEEN 1 AND 12)
UNION ALL
-- DC13-DT-003 | DODyy not numeric or implausible (before 1990 or after current year)
SELECT 'DC13-DT-003', 'Invalid/Implausible DODyy Component: ME13_DECEASED',
       COUNT(*), CAST(NULL AS VARCHAR2(200)), CAST(NULL AS NUMBER)
  FROM DATACUT3.ME13_DECEASED
 WHERE TRIM(DODyy) IS NOT NULL
   AND (NOT REGEXP_LIKE(TRIM(DODyy), '^[0-9]+$')
        OR TO_NUMBER(DODyy) NOT BETWEEN 1990 AND TO_NUMBER(TO_CHAR(SYSDATE,'YYYY')))
UNION ALL
-- DC13-DT-004 | Dobdd not numeric or out of 01-31 range
SELECT 'DC13-DT-004', 'Invalid Dobdd Component (not 01-31): ME13_DECEASED',
       COUNT(*), CAST(NULL AS VARCHAR2(200)), CAST(NULL AS NUMBER)
  FROM DATACUT3.ME13_DECEASED
 WHERE TRIM(Dobdd) IS NOT NULL
   AND (NOT REGEXP_LIKE(TRIM(Dobdd), '^[0-9]+$') OR TO_NUMBER(Dobdd) NOT BETWEEN 1 AND 31)
UNION ALL
-- DC13-DT-005 | dobmm not numeric or out of 01-12 range
SELECT 'DC13-DT-005', 'Invalid dobmm Component (not 01-12): ME13_DECEASED',
       COUNT(*), CAST(NULL AS VARCHAR2(200)), CAST(NULL AS NUMBER)
  FROM DATACUT3.ME13_DECEASED
 WHERE TRIM(dobmm) IS NOT NULL
   AND (NOT REGEXP_LIKE(TRIM(dobmm), '^[0-9]+$') OR TO_NUMBER(dobmm) NOT BETWEEN 1 AND 12)
UNION ALL
-- DC13-DT-006 | dobyy not numeric or implausible (before 1900 or after current year)
SELECT 'DC13-DT-006', 'Invalid/Implausible dobyy Component: ME13_DECEASED',
       COUNT(*), CAST(NULL AS VARCHAR2(200)), CAST(NULL AS NUMBER)
  FROM DATACUT3.ME13_DECEASED
 WHERE TRIM(dobyy) IS NOT NULL
   AND (NOT REGEXP_LIKE(TRIM(dobyy), '^[0-9]+$')
        OR TO_NUMBER(dobyy) NOT BETWEEN 1900 AND TO_NUMBER(TO_CHAR(SYSDATE,'YYYY')))
UNION ALL
-- DC13-DT-007 | Date of Death year earlier than Date of Birth year (logical impossibility)
-- Only evaluated where all 4 components are numeric, to avoid false positives from DT-003/006
SELECT 'DC13-DT-007', 'DOD Year Before DOB Year: ME13_DECEASED',
       COUNT(*), CAST(NULL AS VARCHAR2(200)), CAST(NULL AS NUMBER)
  FROM DATACUT3.ME13_DECEASED
 WHERE REGEXP_LIKE(TRIM(DODyy), '^[0-9]+$') AND REGEXP_LIKE(TRIM(dobyy), '^[0-9]+$')
   AND TO_NUMBER(DODyy) &lt; TO_NUMBER(dobyy)
UNION ALL
-- DC13-DT-008 | File creation date (SDate) in the future
SELECT 'DC13-DT-008', 'SDate (File Created) in the Future: ME13_DECEASED',
       COUNT(*), CAST(NULL AS VARCHAR2(200)), CAST(NULL AS NUMBER)
  FROM DATACUT3.ME13_DECEASED
 WHERE SDate IS NOT NULL AND TRUNC(SDate) &gt; TRUNC(SYSDATE)
UNION ALL
-- DC13-DT-009 | Datesettled earlier than SDate (settled before the file was even opened)
SELECT 'DC13-DT-009', 'Datesettled Before SDate (Settlement Predates File): ME13_DECEASED',
       COUNT(*), CAST(NULL AS VARCHAR2(200)), CAST(NULL AS NUMBER)
  FROM DATACUT3.ME13_DECEASED
 WHERE Datesettled IS NOT NULL AND SDate IS NOT NULL AND TRUNC(Datesettled) &lt; TRUNC(SDate)
UNION ALL
-- DC13-DT-010 | ChaserReviewDate earlier than ChaserDate
SELECT 'DC13-DT-010', 'ChaserReviewDate Before ChaserDate: ME13_DECEASED',
       COUNT(*), CAST(NULL AS VARCHAR2(200)), CAST(NULL AS NUMBER)
  FROM DATACUT3.ME13_DECEASED
 WHERE ChaserReviewDate IS NOT NULL AND ChaserDate IS NOT NULL
   AND TRUNC(ChaserReviewDate) &lt; TRUNC(ChaserDate)
      ) x
    UNION ALL
    SELECT 'CAT-DC13-03 REFERENTIAL INTEGRITY - Child Sub-Forms vs DECEASED Main Doc' AS dq_category, x.check_id, x.check_name, x.result_num, x.result_txt, x.expected
      FROM (
-- DC13-RI-001 | CARDPRODS Record Without Matching DECEASED Main Document (orphan SNo)
SELECT 'DC13-RI-001', 'Orphan CARDPRODS Record (SNo not in DECEASED): ME13_CARDPRODS',
       COUNT(*), CAST(NULL AS VARCHAR2(200)), CAST(NULL AS NUMBER)
  FROM DATACUT3.ME13_CARDPRODS C
 WHERE C.SNo IS NOT NULL
   AND NOT EXISTS (SELECT 1 FROM DATACUT3.ME13_DECEASED D WHERE D.SNo = C.SNo)
UNION ALL
-- DC13-RI-002 | COMPSEC Record Without Matching DECEASED Main Document (orphan SNo)
SELECT 'DC13-RI-002', 'Orphan COMPSEC Record (SNo not in DECEASED): ME13_COMPSEC',
       COUNT(*), CAST(NULL AS VARCHAR2(200)), CAST(NULL AS NUMBER)
  FROM DATACUT3.ME13_COMPSEC C
 WHERE C.SNo IS NOT NULL
   AND NOT EXISTS (SELECT 1 FROM DATACUT3.ME13_DECEASED D WHERE D.SNo = C.SNo)
UNION ALL
-- DC13-RI-003 | CUSTODY Record Without Matching DECEASED Main Document (orphan SNo)
SELECT 'DC13-RI-003', 'Orphan CUSTODY Record (SNo not in DECEASED): ME13_CUSTODY',
       COUNT(*), CAST(NULL AS VARCHAR2(200)), CAST(NULL AS NUMBER)
  FROM DATACUT3.ME13_CUSTODY C
 WHERE C.SNo IS NOT NULL
   AND NOT EXISTS (SELECT 1 FROM DATACUT3.ME13_DECEASED D WHERE D.SNo = C.SNo)
UNION ALL
-- DC13-RI-004 | CHASER Record Without Matching DECEASED Main Document (orphan SNo)
SELECT 'DC13-RI-004', 'Orphan CHASER Record (SNo not in DECEASED): ME13_CHASER',
       COUNT(*), CAST(NULL AS VARCHAR2(200)), CAST(NULL AS NUMBER)
  FROM DATACUT3.ME13_CHASER C
 WHERE C.SNo IS NOT NULL
   AND NOT EXISTS (SELECT 1 FROM DATACUT3.ME13_DECEASED D WHERE D.SNo = C.SNo)
UNION ALL
-- DC13-RI-005 | FUNDMAN Record Without Matching DECEASED Main Document (orphan SNo)
SELECT 'DC13-RI-005', 'Orphan FUNDMAN Record (SNo not in DECEASED): ME13_FUNDMAN',
       COUNT(*), CAST(NULL AS VARCHAR2(200)), CAST(NULL AS NUMBER)
  FROM DATACUT3.ME13_FUNDMAN C
 WHERE C.SNo IS NOT NULL
   AND NOT EXISTS (SELECT 1 FROM DATACUT3.ME13_DECEASED D WHERE D.SNo = C.SNo)
UNION ALL
-- DC13-RI-006 | HELDFUNDS Record Without Matching DECEASED Main Document (orphan SNo)
SELECT 'DC13-RI-006', 'Orphan HELDFUNDS Record (SNo not in DECEASED): ME13_HELDFUNDS',
       COUNT(*), CAST(NULL AS VARCHAR2(200)), CAST(NULL AS NUMBER)
  FROM DATACUT3.ME13_HELDFUNDS C
 WHERE C.SNo IS NOT NULL
   AND NOT EXISTS (SELECT 1 FROM DATACUT3.ME13_DECEASED D WHERE D.SNo = C.SNo)
UNION ALL
-- DC13-RI-007 | LIFEASSURE Record Without Matching DECEASED Main Document (orphan SNo)
SELECT 'DC13-RI-007', 'Orphan LIFEASSURE Record (SNo not in DECEASED): ME13_LIFEASSURE',
       COUNT(*), CAST(NULL AS VARCHAR2(200)), CAST(NULL AS NUMBER)
  FROM DATACUT3.ME13_LIFEASSURE C
 WHERE C.SNo IS NOT NULL
   AND NOT EXISTS (SELECT 1 FROM DATACUT3.ME13_DECEASED D WHERE D.SNo = C.SNo)
UNION ALL
-- DC13-RI-008 | PRIVBILL Record Without Matching DECEASED Main Document (orphan SNo)
SELECT 'DC13-RI-008', 'Orphan PRIVBILL Record (SNo not in DECEASED): ME13_PRIVBILL',
       COUNT(*), CAST(NULL AS VARCHAR2(200)), CAST(NULL AS NUMBER)
  FROM DATACUT3.ME13_PRIVBILL C
 WHERE C.SNo IS NOT NULL
   AND NOT EXISTS (SELECT 1 FROM DATACUT3.ME13_DECEASED D WHERE D.SNo = C.SNo)
UNION ALL
-- DC13-RI-009 | G355SETT Record Without Matching DECEASED Main Document (orphan SNo)
SELECT 'DC13-RI-009', 'Orphan G355SETT Record (SNo not in DECEASED): ME13_G355SETT',
       COUNT(*), CAST(NULL AS VARCHAR2(200)), CAST(NULL AS NUMBER)
  FROM DATACUT3.ME13_G355SETT C
 WHERE C.SNo IS NOT NULL
   AND NOT EXISTS (SELECT 1 FROM DATACUT3.ME13_DECEASED D WHERE D.SNo = C.SNo)
UNION ALL
-- DC13-RI-010 | SETHEIRLEG Record Without Matching DECEASED Main Document (orphan SNo)
SELECT 'DC13-RI-010', 'Orphan SETHEIRLEG Record (SNo not in DECEASED): ME13_SETHEIRLEG',
       COUNT(*), CAST(NULL AS VARCHAR2(200)), CAST(NULL AS NUMBER)
  FROM DATACUT3.ME13_SETHEIRLEG C
 WHERE C.SNo IS NOT NULL
   AND NOT EXISTS (SELECT 1 FROM DATACUT3.ME13_DECEASED D WHERE D.SNo = C.SNo)
UNION ALL
-- DC13-RI-011 | SETCLSDACC Record Without Matching DECEASED Main Document (orphan SNo)
SELECT 'DC13-RI-011', 'Orphan SETCLSDACC Record (SNo not in DECEASED): ME13_SETCLSDACC',
       COUNT(*), CAST(NULL AS VARCHAR2(200)), CAST(NULL AS NUMBER)
  FROM DATACUT3.ME13_SETCLSDACC C
 WHERE C.SNo IS NOT NULL
   AND NOT EXISTS (SELECT 1 FROM DATACUT3.ME13_DECEASED D WHERE D.SNo = C.SNo)
UNION ALL
-- DC13-RI-012 | SETWDRWACC Record Without Matching DECEASED Main Document (orphan SNo)
SELECT 'DC13-RI-012', 'Orphan SETWDRWACC Record (SNo not in DECEASED): ME13_SETWDRWACC',
       COUNT(*), CAST(NULL AS VARCHAR2(200)), CAST(NULL AS NUMBER)
