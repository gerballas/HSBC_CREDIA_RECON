	-- RC-024 | Row Count: Cashier Orders Master (ORCOMSP)
	SELECT 'RC-024' AS check_id, 'Row Count: Cashier Orders Master' AS check_name,
		   COUNT(*) AS RESULT_NUM, CAST(NULL AS VARCHAR2(200)) AS RESULT_TXT, 3370 AS EXPECTED
