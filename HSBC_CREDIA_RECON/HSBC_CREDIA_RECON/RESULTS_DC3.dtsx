  FROM DATACUT3.HUB_MT_SSCDDMP d
 WHERE NOT EXISTS (SELECT 1 FROM DATACUT3.HUB_MT_SSCUSTP c WHERE c.ZGDCB = d.CMDCB AND c.ZGDCS = d.CMDCS)
UNION ALL
-- AML-007 | CDD Coverage %
SELECT 'AML-007', 'CDD Coverage %: SSCDDMP/SSCUSTP',
	   CAST(ROUND((SELECT COUNT(*) FROM DATACUT3.HUB_MT_SSCDDMP) * 100.0 /
	   NULLIF((SELECT COUNT(*) FROM DATACUT3.HUB_MT_SSCUSTP), 0), 2) AS NUMBER), 
	   CAST(NULL AS VARCHAR2(200)), CAST(NULL AS NUMBER)
  FROM DUAL
UNION ALL
-- AML-008 | CDD Risk Distribution by Branch
SELECT 'AML-008', 'CDD Risk Distribution by Branch: SSCDDMP',
	   CAST(COUNT(*) AS NUMBER), CAST(TO_CHAR(CMDCB)||':'||NVL(CMRSKC,'?') AS VARCHAR2(200)), CAST(NULL AS NUMBER)
  FROM DATACUT3.HUB_MT_SSCDDMP
 GROUP BY CMDCB, CMRSKC
UNION ALL
-- AML-008 | [sentinel]
SELECT 'AML-008', 'CDD Risk Distribution by Branch: SSCDDMP', 0, CAST(NULL AS VARCHAR2(200)), CAST(NULL AS NUMBER)
  FROM DUAL
 WHERE NOT EXISTS (SELECT 1 FROM DATACUT3.HUB_MT_SSCDDMP)
UNION ALL
-- AML-009 | Transaction Monitoring Threshold Rules
SELECT 'AML-009', 'TM Threshold Rules vs Descriptions diff',
	   CAST(ABS((SELECT COUNT(*) FROM DATACUT3."HUB_MT_SS@THCP") - (SELECT COUNT(*) FROM DATACUT3."HUB_MT_SS@THDP")) AS NUMBER),
	   CAST(NULL AS VARCHAR2(200)), CAST(NULL AS NUMBER)
  FROM DUAL
UNION ALL
-- AML-010 | Blacklist-to-Customer Ratio
SELECT 'AML-010', 'Blacklist-to-Customer Ratio',
	   CAST(ROUND((SELECT COUNT(*) FROM DATACUT3.HUB_MT_SSBKLSP) * 100.0 /
	   NULLIF((SELECT COUNT(*) FROM DATACUT3.HUB_MT_SSCUSTP), 0), 2) AS NUMBER),
	   CAST(NULL AS VARCHAR2(200)), CAST(NULL AS NUMBER)
  FROM DUAL
UNION ALL
