	  FROM DATACUT3.HUB_MT_AFSIMSP --WHERE FNMDFL &lt;&gt; 'S'
	 GROUP BY FNSINO 
	 HAVING COUNT(*) &gt; 1)
	GROUP BY check_id, check_name, EXPECTED 
