	-- NL-028 | NULL Occupation Code – SSINCIP  (ZKOCPT)
	SELECT 'NL-028' AS check_id, 'NULL Occupation Code ZKOCPT: SSINCIP' AS check_name,
		   COUNT(*) AS RESULT_NUM, CAST(NULL AS VARCHAR2(200)) AS RESULT_TXT, CAST(NULL AS NUMBER) AS EXPECTED
	  FROM DATACUT3.HUB_MT_SSINCIP
	 WHERE  (ZKOCPT IS NULL OR TRIM(ZKOCPT) = '')
	UNION ALL
	-- NL-029 | NULL Account Type – SS@ACPP  (ACTYPE – VARCHAR)
	SELECT 'NL-029' AS check_id, 'NULL Account Type ACTYPE: SS@ACPP' AS check_name,
		   COUNT(*) AS RESULT_NUM, CAST(NULL AS VARCHAR2(200)) AS RESULT_TXT, CAST(NULL AS NUMBER) AS EXPECTED
	  FROM DATACUT3."HUB_MT_SS@ACPP"
	 WHERE ACTYPE IS NULL OR TRIM(ACTYPE) = ''
	UNION ALL
	-- NL-030 | NULL Status – LSACMSP  (POSTUS)
	SELECT 'NL-030' AS check_id, 'NULL Status POSTUS: LSACMSP' AS check_name,
		   COUNT(*) AS RESULT_NUM, CAST(NULL AS VARCHAR2(200)) AS RESULT_TXT, CAST(NULL AS NUMBER) AS EXPECTED
	  FROM DATACUT3.HUB_MT_LSACMSP
	 WHERE  (POSTUS IS NULL OR TRIM(POSTUS) = '')
      ) x
    UNION ALL
    SELECT 'CAT-04 DATE FIELD VALIDITY' AS dq_category, x.check_id, x.check_name, x.result_num, x.result_txt, x.expected
      FROM (
-- DT-001 | DOB out of range (1900-01-01 - today) — ZKDTBR is DATE
SELECT 'DT-001' AS check_id, 'DOB out of range: SSINCIP (ZKDTBR)' AS check_name,
       COUNT(*) AS RESULT_NUM, CAST(NULL AS VARCHAR2(200)) AS RESULT_TXT, CAST(NULL AS NUMBER) AS EXPECTED
  FROM DATACUT3.HUB_MT_SSINCIP
 WHERE ZKDTBR IS NOT NULL
   AND (ZKDTBR &lt; DATE '1900-01-01' OR ZKDTBR &gt; DATE '2026-06-15')
UNION ALL
-- DT-002 | Future Date of Birth
SELECT 'DT-002', 'Future DOB: SSINCIP (ZKDTBR)', COUNT(*), NULL, NULL
  FROM DATACUT3.HUB_MT_SSINCIP
 WHERE ZKDTBR &gt; DATE '2026-06-15'
UNION ALL
-- DT-003 | Age &lt; 18 years
SELECT 'DT-003', 'Underage customers (&lt;18yrs): SSINCIP', COUNT(*), NULL, NULL
  FROM DATACUT3.HUB_MT_SSINCIP
 WHERE ZKDTBR &gt; ADD_MONTHS(DATE '2026-06-15', -216)
UNION ALL
-- DT-004 | Age &gt; 120 years
SELECT 'DT-004', 'Impossible age &gt;120yrs: SSINCIP (ZKDTBR)', COUNT(*), NULL, NULL
  FROM DATACUT3.HUB_MT_SSINCIP
 WHERE ZKDTBR &lt; ADD_MONTHS(DATE '2026-06-15', -1440)
UNION ALL
-- DT-005 | Invalid month in DOB — MOOT: ZKDTBR is a real DATE, Oracle cannot
-- store an invalid month in a DATE column. Disabled rather than fake a result.
SELECT 'DT-005', 'Invalid month in DOB: SSINCIP (ZKDTBR) [MOOT - DATE type, cannot occur]', 0, NULL, NULL
  FROM DUAL
UNION ALL
-- DT-006 | Invalid day in DOB — MOOT, same reasoning as DT-005
SELECT 'DT-006', 'Invalid day in DOB: SSINCIP (ZKDTBR) [MOOT - DATE type, cannot occur]', 0, NULL, NULL
  FROM DUAL
UNION ALL
-- DT-007 | Invalid Account Opening Date — DFDTAO is DATE
SELECT 'DT-007', 'Invalid Acct Open Date: DDACMSP (DFDTAO)', COUNT(*), NULL, NULL
  FROM DATACUT3.HUB_MT_DDACMSP
 WHERE DFDTAO IS NOT NULL AND (DFDTAO &lt; DATE '1969-01-01' OR DFDTAO &gt; DATE '2026-06-15')
UNION ALL
-- DT-008 | Future Account Opening Date
SELECT 'DT-008', 'Future Acct Open Date: DDACMSP (DFDTAO)', COUNT(*), NULL, NULL
  FROM DATACUT3.HUB_MT_DDACMSP
 WHERE DFDTAO &gt; DATE '2026-06-15'
UNION ALL
-- DT-009 | Invalid Loan Opening Date — PODTAO is DATE
SELECT 'DT-009', 'Invalid Loan Open Date: LSACMSP (PODTAO)', COUNT(*), NULL, NULL
  FROM DATACUT3.HUB_MT_LSACMSP
 WHERE PODTAO IS NOT NULL AND (PODTAO &lt; DATE '1969-01-01' OR PODTAO &gt; DATE '2026-06-15')
UNION ALL
-- DT-010 | Loan Commitment Date before Opening Date — POCTDT is DATE too,
-- both sides already DATE so the original direct comparison was already fine
SELECT 'DT-010', 'Commitment Date &lt; Opening Date: LSACMSP', COUNT(*), NULL, NULL
  FROM DATACUT3.HUB_MT_LSACMSP
 WHERE PODTAO IS NOT NULL AND POCTDT IS NOT NULL AND POCTDT &lt; PODTAO
UNION ALL
-- DT-011 | Invalid TD Account Opening Date — TDDTAO is DATE
SELECT 'DT-011', 'Invalid TD Open Date: TDACMSP (TDDTAO)', COUNT(*), NULL, NULL
  FROM DATACUT3.HUB_MT_TDACMSP
 WHERE TDDTAO IS NOT NULL AND (TDDTAO &lt; DATE '1969-01-01' OR TDDTAO &gt; DATE '2026-06-15')
UNION ALL
-- DT-012 | Placeholder date sentinel — TODO: confirm the actual sentinel DATE
-- value used post-migration for "missing" dates (old NUMBER sentinel was 0).
-- Disabled pending confirmation rather than guessing a sentinel DATE literal.
SELECT 'DT-012', 'Placeholder date: DDACMSP (DFDTAO) [DISABLED - confirm sentinel DATE value]', 0, 'DDACMSP', NULL
  FROM DUAL
UNION ALL
SELECT 'DT-012', 'Placeholder date: LSACMSP (PODTAO) [DISABLED - confirm sentinel DATE value]', 0, 'LSACMSP', NULL
  FROM DUAL
UNION ALL
-- DT-013 | Placeholder date = 99999999 — same reasoning as DT-012
SELECT 'DT-013', 'Placeholder date max: DDACMSP (DFDTAO) [DISABLED - confirm sentinel DATE value]', 0, 'DDACMSP', NULL
  FROM DUAL
UNION ALL
SELECT 'DT-013', 'Placeholder date max: LSACMSP (PODTAO) [DISABLED - confirm sentinel DATE value]', 0, 'LSACMSP', NULL
  FROM DUAL
UNION ALL
-- DT-014 | Invalid CDD Last Review Date — CMCLDR is DATE
SELECT 'DT-014', 'Invalid CDD Last Review Date: SSCDDMP (CMCLDR)', COUNT(*), NULL, NULL
  FROM DATACUT3.HUB_MT_SSCDDMP
 WHERE CMCLDR IS NOT NULL AND (CMCLDR &lt; DATE '1990-01-01' OR CMCLDR &gt; DATE '2026-06-15')
UNION ALL
-- DT-015 | CDD Expiry before Last Review — both DATE, original was already fine
SELECT 'DT-015', 'CDD Expiry &lt; Last Review: SSCDDMP (CMCEYD/CMCLDR)', COUNT(*), NULL, NULL
  FROM DATACUT3.HUB_MT_SSCDDMP
 WHERE CMCLDR IS NOT NULL AND CMCEYD IS NOT NULL AND CMCEYD &lt; CMCLDR
UNION ALL
-- DT-016 | Invalid Blacklist Date Added — V7DTAD is DATE
SELECT 'DT-016', 'Invalid Blacklist Date Added: SSBKLSP (V7DTAD)', COUNT(*), NULL, NULL
  FROM DATACUT3.HUB_MT_SSBKLSP
 WHERE V7DTAD IS NOT NULL AND (V7DTAD &lt; DATE '1990-01-01' OR V7DTAD &gt; DATE '2026-06-15')
UNION ALL
-- DT-017 | Blacklist Expiry already past — V7BLEX is DATE
SELECT 'DT-017', 'Blacklist Expiry in Past: SSBKLSP (V7BLEX)', COUNT(*), NULL, NULL
  FROM DATACUT3.HUB_MT_SSBKLSP
 WHERE V7BLEX IS NOT NULL AND V7BLEX &lt; DATE '2026-06-15'
UNION ALL
-- DT-018 | Invalid FATCA Self-Certification Date — CTSFDT confirmed NUMBER, UNCHANGED
SELECT 'DT-018', 'Invalid Self-Cert Date: SSCTXPP (CTSFDT)', COUNT(*), NULL, NULL
  FROM DATACUT3.HUB_MT_SSCTXPP
 WHERE CTSFDT IS NOT NULL AND (CTSFDT &lt; 20100101 OR CTSFDT &gt; TO_NUMBER(TO_CHAR(DATE '2026-06-15', 'YYYYMMDD')))
UNION ALL
-- DT-019 | Last CDD Update after Today — CMDLUP is DATE
SELECT 'DT-019', 'CDD Last Update &gt; Today: SSCDDMP (CMDLUP)', COUNT(*), NULL, NULL
  FROM DATACUT3.HUB_MT_SSCDDMP
 WHERE CMDLUP &gt; DATE '2026-06-15'
UNION ALL
-- DT-020 | Loan Commitment Date &gt; Today + 30 years — POCTDT is DATE
SELECT 'DT-020', 'Loan Commitment &gt; Today+30yrs: LSACMSP (POCTDT)', COUNT(*), NULL, NULL
  FROM DATACUT3.HUB_MT_LSACMSP
 WHERE POCTDT IS NOT NULL AND POCTDT &gt; ADD_MONTHS(DATE '2026-06-15', 360)
UNION ALL
-- DT-021 | Invalid Cashier Order Capture Date — ORCPDT is DATE
SELECT 'DT-021', 'Invalid Capture Date: ORCOMSP (ORCPDT)', COUNT(*), NULL, NULL
  FROM DATACUT3.HUB_MT_ORCOMSP
 WHERE ORCPDT IS NOT NULL AND (ORCPDT &lt; DATE '1969-01-01' OR ORCPDT &gt; DATE '2026-06-15')
UNION ALL
-- DT-022 | Invalid ID Filed Date — LCIDDT is DATE
SELECT 'DT-022', 'Invalid Date ID Filed: SS@ICIP (LCIDDT)', COUNT(*), NULL, NULL
  FROM DATACUT3."HUB_MT_SS@ICIP"
 WHERE LCIDDT IS NOT NULL AND (LCIDDT &lt; DATE '1950-01-01' OR LCIDDT &gt; DATE '2026-06-15')
UNION ALL
-- DT-023 | Tax Classification Valid-From &gt; Today + 1yr — CTTVFD confirmed NUMBER, UNCHANGED
SELECT 'DT-023', 'Tax Valid-From &gt; Today+1yr: SSCTXPP (CTTVFD)', COUNT(*), NULL, NULL
  FROM DATACUT3.HUB_MT_SSCTXPP
 WHERE CTTVFD IS NOT NULL AND CTTVFD &gt; TO_NUMBER(TO_CHAR(ADD_MONTHS(DATE '2026-06-15', 12), 'YYYYMMDD'))
UNION ALL
-- DT-024 | Invalid DD Interest Rate History Start Date — DRSTDT is DATE
SELECT 'DT-024', 'Invalid IR History Date: DDIRHFP (DRSTDT)', COUNT(*), NULL, NULL
  FROM DATACUT3.HUB_MT_DDIRHFP
 WHERE DRSTDT IS NOT NULL AND (DRSTDT &lt; DATE '1969-01-01' OR DRSTDT &gt; ADD_MONTHS(DATE '2026-06-15', 12))
UNION ALL
-- DT-025 | Invalid LS Interest Rate History End Date — LIEEDT is DATE
SELECT 'DT-025', 'Invalid IR History Date: LSIRHFP (LIEEDT)', COUNT(*), NULL, NULL
  FROM DATACUT3.HUB_MT_LSIRHFP
 WHERE LIEEDT IS NOT NULL AND (LIEEDT &lt; DATE '1969-01-01' OR LIEEDT &gt; ADD_MONTHS(DATE '2026-06-15', 12))
UNION ALL
-- DT-026 | Blacklist Last Update after Today — V7DLUP is DATE
SELECT 'DT-026', 'Blacklist Last Update &gt; Today: SSBKLSP (V7DLUP)', COUNT(*), NULL, NULL
  FROM DATACUT3.HUB_MT_SSBKLSP
 WHERE V7DLUP IS NOT NULL AND V7DLUP &gt; DATE '2026-06-15'
UNION ALL
-- DT-027 | DD Account Opened Before 1969 — DFDTAO is DATE
SELECT 'DT-027', 'Acct Opened Before 1969: DDACMSP (DFDTAO)', COUNT(*), NULL, NULL
  FROM DATACUT3.HUB_MT_DDACMSP
 WHERE DFDTAO IS NOT NULL AND DFDTAO &lt; DATE '1969-01-01'
UNION ALL
-- DT-028 | Invalid Business Register Start Date — FNSTDT is DATE
SELECT 'DT-028', 'Invalid Biz Register Start Date: FN@BRGP (FNSTDT)', COUNT(*), NULL, NULL
  FROM DATACUT3."HUB_MT_FN@BRGP"
 WHERE FNSTDT IS NOT NULL AND (FNSTDT &lt; DATE '1900-01-01' OR FNSTDT &gt; DATE '2026-06-15')
      ) x
    UNION ALL
    SELECT 'CAT-05 NUMERIC INTEGRITY' AS dq_category, x.check_id, x.check_name, x.result_num, x.result_txt, x.expected
      FROM (
	-- NI-001 | Negative Outstanding Principal
	SELECT 'NI-001' AS check_id, 'Negative Outstanding Principal POROPR: LSACMSP' AS check_name,
		   COUNT(*) AS RESULT_NUM, CAST(NULL AS VARCHAR2(200)) AS RESULT_TXT, CAST(NULL AS NUMBER) AS EXPECTED
	  FROM DATACUT3.HUB_MT_LSACMSP
	 WHERE POROPR &lt; 0
	UNION ALL
	-- NI-002 | Extreme Loan Outstanding Principal &gt; 100M
	SELECT 'NI-002', 'Loan Outstanding &gt; 100M: LSACMSP (POROPR)',
		   POROPR, TO_CHAR(POACS), NULL
	  FROM DATACUT3.HUB_MT_LSACMSP
	 WHERE POROPR &gt; 100000000
	UNION ALL
	-- NI-003 | Negative DR Interest Contract Rate
	SELECT 'NI-003', 'Negative DR Interest Rate: LSIRHFP (LIDIRT)',
		   COUNT(*), NULL, NULL
	  FROM DATACUT3.HUB_MT_LSIRHFP
	 WHERE LIDIRT IS NOT NULL AND LIDIRT &lt; 0
	UNION ALL
	-- NI-004 | Zero Treasury Interest Rate on Active Loans
	SELECT 'NI-004', 'Zero Treasury Rate Active Loans: LSACMSP (POTINR)',
		   COUNT(*), NULL, NULL
	  FROM DATACUT3.HUB_MT_LSACMSP
	 WHERE POTINR = 0
	UNION ALL
	-- NI-005 | DR Interest Rate &gt; 30%
	SELECT 'NI-005', 'DR Interest Rate &gt; 30%: LSIRHFP (LIDIRT)',
		   COUNT(*), NULL, NULL
	  FROM DATACUT3.HUB_MT_LSIRHFP WHERE LIDIRT &gt; 30
	UNION ALL
	-- NI-006 | Negative DD Ledger Balance (non-OD)
	SELECT 'NI-006', 'Negative DD Ledger Balance (non-OD): DDACMSP (DFRLBL)',
		   COUNT(*), NULL, NULL
	  FROM DATACUT3.HUB_MT_DDACMSP
	 WHERE DFRLBL &lt; 0 AND (DFRSTR IS NULL OR DFRSTR &lt;&gt; 'O')
	UNION ALL
	-- NI-007 | Customer Branch Number out of range
	SELECT 'NI-007', 'Branch Number out of range: SSCUSTP (ZGDCB)',
		   COUNT(*), NULL, NULL
	  FROM DATACUT3.HUB_MT_SSCUSTP
	 WHERE ZGDCB &lt;= 0 OR ZGDCB &gt; 9999
	UNION ALL
	-- NI-008 | Customer Serial Number non-positive
	SELECT 'NI-008', 'Non-positive Customer Serial: SSCUSTP (ZGDCS)',
		   COUNT(*), NULL, NULL
	  FROM DATACUT3.HUB_MT_SSCUSTP WHERE ZGDCS &lt;= 0
	UNION ALL
	-- NI-009 | Account Suffix out of range (1-999)
	SELECT 'NI-009', 'Account Suffix out of range: DDACMSP (DFACX)',
		   COUNT(*), NULL, NULL
	  FROM DATACUT3.HUB_MT_DDACMSP WHERE DFACX &lt;= 0 OR DFACX &gt; 999
	UNION ALL
	-- NI-010 | Negative Number of Children
	SELECT 'NI-010', 'Negative No. Children: SSINCIP (ZKKID)',
		   COUNT(*), NULL, NULL
	  FROM DATACUT3.HUB_MT_SSINCIP WHERE ZKKID IS NOT NULL AND ZKKID &lt; 0
	UNION ALL
	-- NI-011 | Number of Children &gt; 20
	SELECT 'NI-011', 'Children &gt; 20: SSINCIP (ZKKID)',
		   COUNT(*), NULL, NULL
	  FROM DATACUT3.HUB_MT_SSINCIP WHERE ZKKID &gt; 20
	UNION ALL
	-- NI-012 | Negative TD Ledger Balance
	SELECT 'NI-012', 'Negative TD Ledger Balance: TDACMSP (TDRLBL)',
		   COUNT(*), NULL, NULL
	  FROM DATACUT3.HUB_MT_TDACMSP WHERE TDMDFL &lt;&gt; 'S' AND TDRLBL &lt; 0
	UNION ALL
	-- NI-013 | CBAR Account Number invalid chars
	SELECT 'NI-013', 'CBAR Acct# invalid chars: SS@ACPP (ACNMBR)',
		   COUNT(*), NULL, NULL
	  FROM DATACUT3."HUB_MT_SS@ACPP"
	 WHERE ACNMBR IS NOT NULL AND NOT REGEXP_LIKE(TRIM(ACNMBR), '^[0-9A-Z\-]+$')
	UNION ALL
	-- NI-014 | CBAR Account Type invalid chars
	SELECT 'NI-014', 'CBAR Account Type invalid chars: SS@ACPP (ACTYPE)',
		   COUNT(*), NULL, NULL
	  FROM DATACUT3."HUB_MT_SS@ACPP"
	 WHERE ACTYPE IS NOT NULL AND NOT REGEXP_LIKE(TRIM(ACTYPE), '^[A-Za-z0-9]+$')
	UNION ALL
	-- NI-015 | Negative S/I Amount
	SELECT 'NI-015', 'Negative S/I Amount FNSIAM: AFSIMSP',
		   COUNT(*), NULL, NULL
	  FROM DATACUT3.HUB_MT_AFSIMSP
	 WHERE FNSIAM IS NOT NULL AND FNSIAM &lt; 0
	UNION ALL
	-- NI-016 | S/I Amount &gt; 1M EUR
	SELECT 'NI-016', 'S/I Amount &gt; 1M EUR: AFSIMSP (FNSIAM)',
		   FNSIAM, TO_CHAR(FNSINO), NULL
	  FROM DATACUT3.HUB_MT_AFSIMSP
	 WHERE FNSIAM &gt; 1000000
	UNION ALL
	-- NI-017 | NULL Ledger Balance
	SELECT 'NI-017', 'NULL GL Ledger Balance: GLACMSP (GERLBL)',
		   COUNT(*), NULL, NULL
	  FROM DATACUT3.HUB_MT_GLACMSP
	 WHERE GERLBL IS NULL
	UNION ALL
	-- NI-018 | OD Max Limit non-positive
	SELECT 'NI-018', 'Non-positive OD Max Limit D1HOLM: DCACMSP',
		   COUNT(*), NULL, NULL
	  FROM DATACUT3.HUB_MT_DCACMSP
	 WHERE D1HOLM IS NOT NULL AND D1HOLM &lt;= 0
	UNION ALL
	-- NI-019 | Negative Irregular Repayment Instalment
	SELECT 'NI-019', 'Negative Irregular Repayment: LSILRSP (IOINAT)',
		   COUNT(*), NULL, NULL
	  FROM DATACUT3.HUB_MT_LSILRSP WHERE IOINAT IS NOT NULL AND IOINAT &lt;= 0
	UNION ALL
	-- NI-020 | Total Outstanding Loan Principal by Currency
	SELECT 'NI-020', 'Total Outstanding Loan Principal by Currency',
		   ROUND(SUM(NVL(POROPR, 0)) / 1000000, 2), POCYCD, NULL
	  FROM DATACUT3.HUB_MT_LSACMSP
	 GROUP BY POCYCD
	UNION ALL
	-- NI-020 | [sentinel – no data guard]
	SELECT 'NI-020', 'Total Outstanding Loan Principal by Currency',
		   0, CAST(NULL AS VARCHAR2(200)), NULL
	  FROM DUAL
	 WHERE NOT EXISTS (SELECT 1 FROM DATACUT3.HUB_MT_LSACMSP)
      ) x
    UNION ALL
    SELECT 'CAT-06 CUSTOMER DOMAIN CHECKS' AS dq_category, x.check_id, x.check_name, x.result_num, x.result_txt, x.expected
      FROM (
	-- CU-001 | Duplicate Customer PK
	SELECT 'CU-001' AS check_id, 'Duplicate Customer PK: SSCUSTP' AS check_name,
		   COUNT(*) AS RESULT_NUM, CAST(TO_CHAR(ZGDCB)||':'||TO_CHAR(ZGDCS) AS VARCHAR2(200)) AS RESULT_TXT, CAST(NULL AS NUMBER) AS EXPECTED
	  FROM DATACUT3.HUB_MT_SSCUSTP
	  GROUP BY ZGCTCD, ZGDCB, ZGDCS HAVING COUNT(*) &gt; 1
	UNION ALL
	SELECT 'CU-001', 'Duplicate Customer PK: SSCUSTP', 0, CAST(NULL AS VARCHAR2(200)), CAST(NULL AS NUMBER)
	  FROM DUAL
	 WHERE NOT EXISTS (SELECT 1 FROM DATACUT3.HUB_MT_SSCUSTP GROUP BY ZGCTCD, ZGDCB, ZGDCS HAVING COUNT(*) &gt; 1)
	UNION ALL
	-- CU-002 | Invalid Sex Code
	SELECT 'CU-002', 'Invalid Sex Code ZKSEX: SSINCIP',
		   COUNT(*), CAST(NVL(ZKSEX,'[NULL]') AS VARCHAR2(200)), CAST(NULL AS NUMBER)
	  FROM DATACUT3.HUB_MT_SSINCIP
	 WHERE ZKSEX NOT IN ('M', 'F', 'U') AND ZKSEX IS NOT NULL
	 GROUP BY ZKSEX
	UNION ALL
	SELECT 'CU-002', 'Invalid Sex Code ZKSEX: SSINCIP', 0, CAST(NULL AS VARCHAR2(200)), CAST(NULL AS NUMBER)
	  FROM DUAL
	 WHERE NOT EXISTS (SELECT 1 FROM DATACUT3.HUB_MT_SSINCIP WHERE ZKSEX NOT IN ('M', 'F', 'U') AND ZKSEX IS NOT NULL)
	UNION ALL
	-- CU-003 | Customer without SSINCIP/SSNICIP record
	SELECT 'CU-003', 'Customer without SSINCIP/SSNICIP record',
		   COUNT(*), CAST(NULL AS VARCHAR2(200)), CAST(NULL AS NUMBER)
	  FROM DATACUT3.HUB_MT_SSCUSTP c
	 WHERE NOT EXISTS (SELECT 1 FROM DATACUT3.HUB_MT_SSINCIP i WHERE i.ZKDCB = c.ZGDCB AND i.ZKDCS = c.ZGDCS)
	   AND NOT EXISTS (SELECT 1 FROM DATACUT3.HUB_MT_SSNICIP n WHERE n.XUDCB = c.ZGDCB AND n.XUDCS = c.ZGDCS)
	UNION ALL
	-- CU-004 | Active Customer without Address
	SELECT 'CU-004', 'Customer without Address: SSADDRP', 
		   COUNT(*), CAST(NULL AS VARCHAR2(200)), CAST(NULL AS NUMBER)
	  FROM DATACUT3.HUB_MT_SSCUSTP c
	 WHERE NOT EXISTS (SELECT 1 FROM DATACUT3.HUB_MT_SSADDRP a WHERE a.ZBDCB = c.ZGDCB AND a.ZBDCS = c.ZGDCS)
	UNION ALL
	-- CU-005 | Invalid Country Code format
	SELECT 'CU-005', 'Invalid Country Code format ZGCTCD: SSCUSTP',
		   COUNT(*), CAST(NVL(ZGCTCD,'[NULL]') AS VARCHAR2(200)), CAST(NULL AS NUMBER)
	  FROM DATACUT3.HUB_MT_SSCUSTP
	 WHERE LENGTH(TRIM(ZGCTCD)) &lt;&gt; 2 OR NOT REGEXP_LIKE(TRIM(ZGCTCD), '^[A-Z]{2}$')
	 GROUP BY ZGCTCD
	UNION ALL
	SELECT 'CU-005', 'Invalid Country Code format ZGCTCD: SSCUSTP', 0, CAST(NULL AS VARCHAR2(200)), CAST(NULL AS NUMBER)
	  FROM DUAL
	 WHERE NOT EXISTS (SELECT 1 FROM DATACUT3.HUB_MT_SSCUSTP WHERE LENGTH(TRIM(ZGCTCD)) &lt;&gt; 2 OR NOT REGEXP_LIKE(TRIM(ZGCTCD), '^[A-Z]{2}$'))
	UNION ALL
	-- CU-006 | Customer Full Name is blank
	SELECT 'CU-006', 'Blank Customer Full Name ZGCSFN: SSCUSTP', 
		   COUNT(*), CAST(NULL AS VARCHAR2(200)), CAST(NULL AS NUMBER)
	  FROM DATACUT3.HUB_MT_SSCUSTP
	 WHERE TRIM(ZGCSFN) IS NULL
	UNION ALL
	-- CU-007 | Customer Full Name contains only digits
	SELECT 'CU-007', 'Customer Name is all digits ZGCSFN: SSCUSTP', 
		   COUNT(*), CAST(NULL AS VARCHAR2(200)), CAST(NULL AS NUMBER)
	  FROM DATACUT3.HUB_MT_SSCUSTP
	 WHERE REGEXP_LIKE(TRIM(ZGCSFN), '^[0-9]+$')
	UNION ALL
	-- CU-008 | Customer appearing in both
	SELECT 'CU-008', 'Customer in both SSINCIP and SSNICIP', 
		   COUNT(*), CAST(NULL AS VARCHAR2(200)), CAST(NULL AS NUMBER)
	  FROM DATACUT3.HUB_MT_SSINCIP i
	  JOIN DATACUT3.HUB_MT_SSNICIP n ON i.ZKDCB = n.XUDCB AND i.ZKDCS = n.XUDCS
	UNION ALL
	-- CU-009 | Blacklist Ratio (Αφαιρέθηκε το V7MDFL &lt;&gt; 'S' και ZGMDFL &lt;&gt; 'S')
	SELECT 'CU-009', 'Blacklist Ratio vs Active Customers',
		   ROUND((SELECT COUNT(*) FROM DATACUT3.HUB_MT_SSBKLSP) * 100.0 /
		   NULLIF((SELECT COUNT(*) FROM DATACUT3.HUB_MT_SSCUSTP), 0), 2), 
		   CAST(NULL AS VARCHAR2(200)), CAST(NULL AS NUMBER)
	  FROM DUAL
	UNION ALL
	-- CU-010 | CDD Records without Customer
	SELECT 'CU-010', 'CDD record without Customer: SSCDDMP', 
		   COUNT(*), CAST(NULL AS VARCHAR2(200)), CAST(NULL AS NUMBER)
	  FROM DATACUT3.HUB_MT_SSCDDMP d
	 WHERE NOT EXISTS (SELECT 1 FROM DATACUT3.HUB_MT_SSCUSTP c WHERE c.ZGDCB = d.CMDCB AND c.ZGDCS = d.CMDCS)
	UNION ALL
	-- CU-011 | CDD Risk Rating Distribution
	SELECT 'CU-011', 'CDD Risk Distribution: SSCDDMP (CMRSKC)',
		   COUNT(*), CAST(NVL(CMRSKC,'[NULL]') AS VARCHAR2(200)), CAST(NULL AS NUMBER)
	  FROM DATACUT3.HUB_MT_SSCDDMP
	 GROUP BY CMRSKC
	UNION ALL
	SELECT 'CU-011', 'CDD Risk Distribution: SSCDDMP (CMRSKC)', 0, CAST(NULL AS VARCHAR2(200)), CAST(NULL AS NUMBER)
	  FROM DUAL
	 WHERE NOT EXISTS (SELECT 1 FROM DATACUT3.HUB_MT_SSCDDMP)
	UNION ALL
	-- CU-012 | High-Risk CDD without Expiry Date
	SELECT 'CU-012', 'High-Risk CDD without Expiry: SSCDDMP', 
		   COUNT(*), CAST(NULL AS VARCHAR2(200)), CAST(NULL AS NUMBER)
	  FROM DATACUT3.HUB_MT_SSCDDMP
	 WHERE CMRSKC IN ('H', 'HIGH', '3') AND CMCEYD IS NULL
	UNION ALL
	-- CU-013 | Deceased Customer with Active Account
	SELECT 'CU-013', 'Deceased Customer with Active Account', 
		   COUNT(*), CAST(NULL AS VARCHAR2(200)), CAST(NULL AS NUMBER)
	  FROM DATACUT3.HUB_MT_SSHCDMP d
	  JOIN DATACUT3.HUB_MT_DDACMSP a ON d.ZEDCB = a.DFDCB AND d.ZEDCS = a.DFDCS
	 WHERE a.DFSTUS = 'A'
	UNION ALL
	-- CU-014 | CDD Coverage (Αφαιρέθηκε το ZGMDFL &lt;&gt; 'S')
	SELECT 'CU-014', 'CDD Coverage % vs Customer Master',
		   ROUND((SELECT COUNT(*) FROM DATACUT3.HUB_MT_SSCDDMP) * 100.0 /
		   NULLIF((SELECT COUNT(*) FROM DATACUT3.HUB_MT_SSCUSTP), 0), 2), 
		   CAST(NULL AS VARCHAR2(200)), CAST(NULL AS NUMBER)
	  FROM DUAL
	UNION ALL
	-- CU-015 | FATCA Tax Classification Coverage (Αφαιρέθηκε το ZGMDFL &lt;&gt; 'S')
	SELECT 'CU-015', 'FATCA Tax Classification Coverage %',
		   ROUND((SELECT COUNT(DISTINCT CTDCS) FROM DATACUT3.HUB_MT_SSCTXPP) * 100.0 /
		   NULLIF((SELECT COUNT(*) FROM DATACUT3.HUB_MT_SSCUSTP), 0), 2), 
		   CAST(NULL AS VARCHAR2(200)), CAST(NULL AS NUMBER)
	  FROM DUAL
	UNION ALL
	SELECT 'CU-016', 
		   'Special Category Distribution: SSSCCIP (SCSCCF)', 
		   CAST(0 AS NUMBER), -- Ρητή μετατροπή σε NUMBER
		   CAST(NULL AS VARCHAR2(200)), 
		   CAST(NULL AS NUMBER)
	  FROM DUAL
	 WHERE NOT EXISTS (SELECT 1 FROM DATACUT3.HUB_MT_SSSCCIP)
	UNION ALL
	-- CU-017 | Limit Record without Customer
	SELECT 'CU-017', 'Limit Record without Customer: SSCLMTP', 
		   COUNT(*), CAST(NULL AS VARCHAR2(200)), CAST(NULL AS NUMBER)
	  FROM DATACUT3.HUB_MT_SSCLMTP l
	 WHERE NOT EXISTS (SELECT 1 FROM DATACUT3.HUB_MT_SSCUSTP c WHERE c.ZGDCB = l.ZFDCB AND c.ZGDCS = l.ZFDCS)
	UNION ALL
	-- CU-018 | FATCA Status Distribution
	SELECT 'CU-018', 'FATCA Status Distribution: SSCTXPP (CTTXCS)',
		   COUNT(*), CAST(NVL(CTTXCS,'[NULL]') AS VARCHAR2(200)), CAST(NULL AS NUMBER)
	  FROM DATACUT3.HUB_MT_SSCTXPP
	 GROUP BY CTTXCS
	UNION ALL
	SELECT 'CU-018', 'FATCA Status Distribution: SSCTXPP (CTTXCS)', 0, CAST(NULL AS VARCHAR2(200)), CAST(NULL AS NUMBER)
	  FROM DUAL
	 WHERE NOT EXISTS (SELECT 1 FROM DATACUT3.HUB_MT_SSCTXPP)
	UNION ALL
	-- CU-019 | Invalid Nationality code
	SELECT 'CU-019', 'Invalid Nationality Code ZGNATY: SSCUSTP',
		   COUNT(*), CAST(NVL(ZGNATY,'[NULL]') AS VARCHAR2(200)), CAST(NULL AS NUMBER)
	  FROM DATACUT3.HUB_MT_SSCUSTP
	 WHERE ZGNATY IS NOT NULL AND NOT REGEXP_LIKE(TRIM(ZGNATY), '^[A-Z]{2}$')
	 GROUP BY ZGNATY
	UNION ALL
	SELECT 'CU-019', 'Invalid Nationality Code ZGNATY: SSCUSTP', 0, CAST(NULL AS VARCHAR2(200)), CAST(NULL AS NUMBER)
	  FROM DUAL
	 WHERE NOT EXISTS (SELECT 1 FROM DATACUT3.HUB_MT_SSCUSTP WHERE ZGNATY IS NOT NULL AND NOT REGEXP_LIKE(TRIM(ZGNATY), '^[A-Z]{2}$'))
	UNION ALL
	-- CU-020 | Individual Customers per Branch
	SELECT 'CU-020', 'Individual Customers per Branch: SSINCIP (ZKDCB)',
		   COUNT(*), CAST(TO_CHAR(ZKDCB) AS VARCHAR2(200)), CAST(NULL AS NUMBER)
	  FROM DATACUT3.HUB_MT_SSINCIP
	 GROUP BY ZKDCB
	UNION ALL
	SELECT 'CU-020', 'Individual Customers per Branch: SSINCIP (ZKDCB)', 0, CAST(NULL AS VARCHAR2(200)), CAST(NULL AS NUMBER)
	  FROM DUAL
	 WHERE NOT EXISTS (SELECT 1 FROM DATACUT3.HUB_MT_SSINCIP)
	UNION ALL
	-- CU-021 | Non-Individual without incorporation date
	SELECT 'CU-021', 'NULL Incorporation Date XUDTIC: SSNICIP', 
		   COUNT(*), CAST(NULL AS VARCHAR2(200)), CAST(NULL AS NUMBER)
	  FROM DATACUT3.HUB_MT_SSNICIP
	 WHERE XUDTIC IS NULL
	UNION ALL
	-- CU-022 | Joint Acct record without Customer
	SELECT 'CU-022', 'Joint Acct record without Customer: SSPRJIP', 
		   COUNT(*), CAST(NULL AS VARCHAR2(200)), CAST(NULL AS NUMBER)
	  FROM DATACUT3.HUB_MT_SSPRJIP j
	 WHERE NOT EXISTS (SELECT 1 FROM DATACUT3.HUB_MT_SSCUSTP c WHERE c.ZGDCB = j.X0DCB AND c.ZGDCS = j.X0DCS)
	UNION ALL
	-- CU-023 | Write-Off without Loan
	SELECT 'CU-023', 'Write-Off without Loan: SSWAINP', 
		   COUNT(*), CAST(NULL AS VARCHAR2(200)), CAST(NULL AS NUMBER)
	  FROM DATACUT3.HUB_MT_SSWAINP w
	 WHERE NOT EXISTS (SELECT 1 FROM DATACUT3.HUB_MT_LSACMSP l WHERE l.POACB = w.VIACB AND l.POACS = w.VIACS)
	UNION ALL
	-- CU-024 | Closed Acct without Customer
	SELECT 'CU-024', 'Closed Acct without Customer: SSCLACP', 
		   COUNT(*), CAST(NULL AS VARCHAR2(200)), CAST(NULL AS NUMBER)
	  FROM DATACUT3.HUB_MT_SSCLACP cl
	 WHERE NOT EXISTS (SELECT 1 FROM DATACUT3.HUB_MT_SSCUSTP c WHERE c.ZGDCB = cl.ZIDCB AND c.ZGDCS = cl.ZIDCS)
	UNION ALL
	-- CU-025 | Marital Status Distribution
	SELECT 'CU-025', 'Marital Status Distribution: SSINCIP (ZKMST)',
		   COUNT(*), CAST(NVL(ZKMST, '[NULL]') AS VARCHAR2(200)), CAST(NULL AS NUMBER)
	  FROM DATACUT3.HUB_MT_SSINCIP
	 GROUP BY ZKMST
	UNION ALL
	SELECT 'CU-025', 'Marital Status Distribution: SSINCIP (ZKMST)', 0, CAST(NULL AS VARCHAR2(200)), CAST(NULL AS NUMBER)
	  FROM DUAL
	 WHERE NOT EXISTS (SELECT 1 FROM DATACUT3.HUB_MT_SSINCIP)
      ) x
    UNION ALL
    SELECT 'CAT-07 ACCOUNT DOMAIN - DEMAND DEPOSITS (DD)' AS dq_category, x.check_id, x.check_name, x.result_num, x.result_txt, x.expected
      FROM (
	-- DD-001 | DD Account Status Distribution
	SELECT 'DD-001' AS check_id, 'DD Status Distribution: DDACMSP (DFSTUS)' AS check_name,
		   CAST(COUNT(*) AS NUMBER) AS RESULT_NUM, CAST(NVL(DFSTUS, '[NULL]') AS VARCHAR2(200)) AS RESULT_TXT, CAST(NULL AS NUMBER) AS EXPECTED
	  FROM DATACUT3.HUB_MT_DDACMSP
	 GROUP BY DFSTUS
	UNION ALL
	SELECT 'DD-001', 'DD Status Distribution: DDACMSP (DFSTUS)', 0, CAST(NULL AS VARCHAR2(200)), CAST(NULL AS NUMBER)
	  FROM DUAL WHERE NOT EXISTS (SELECT 1 FROM DATACUT3.HUB_MT_DDACMSP)
	UNION ALL
	-- DD-002 | DD Account Currency Distribution
	SELECT 'DD-002', 'DD Currency Distribution: DDACMSP (DFCYCD)',
		   CAST(COUNT(*) AS NUMBER), CAST(NVL(DFCYCD, '[NULL]') AS VARCHAR2(200)), NULL
	  FROM DATACUT3.HUB_MT_DDACMSP 
	 GROUP BY DFCYCD
	UNION ALL
	SELECT 'DD-002', 'DD Currency Distribution: DDACMSP (DFCYCD)', 0, CAST(NULL AS VARCHAR2(200)), NULL
	  FROM DUAL WHERE NOT EXISTS (SELECT 1 FROM DATACUT3.HUB_MT_DDACMSP)
	UNION ALL
	-- DD-003 | DD Account without matching Customer
	SELECT 'DD-003', 'DD Acct without Customer: DDACMSP',
		   CAST(COUNT(*) AS NUMBER), CAST(NULL AS VARCHAR2(200)), NULL
	  FROM DATACUT3.HUB_MT_DDACMSP d
	 WHERE NOT EXISTS (SELECT 1 FROM DATACUT3.HUB_MT_SSCUSTP c WHERE c.ZGDCB = d.DFDCB AND c.ZGDCS = d.DFDCS)
	UNION ALL
	-- DD-004 | IBAN Count vs DD Account Count
	SELECT 'DD-004', 'IBAN Count vs DD Account Count',
		   CAST(ABS((SELECT COUNT(*) FROM DATACUT3.HUB_MT_DDIBANP) - (SELECT COUNT(*) FROM DATACUT3.HUB_MT_DDACMSP)) AS NUMBER),
		   CAST(NULL AS VARCHAR2(200)), NULL
	  FROM DUAL
	UNION ALL
	-- DD-005 | Duplicate IBAN values
	SELECT 'DD-005', 'Duplicate IBAN: DDIBANP (IBIBAN)',
		   CAST(COUNT(*) AS NUMBER), CAST(TO_CHAR(IBIBAN) AS VARCHAR2(200)), NULL
	  FROM DATACUT3.HUB_MT_DDIBANP
	 GROUP BY IBIBAN HAVING COUNT(*) &gt; 1
	UNION ALL
	SELECT 'DD-005', 'Duplicate IBAN: DDIBANP (IBIBAN)', 0, CAST(NULL AS VARCHAR2(200)), NULL
	  FROM DUAL WHERE NOT EXISTS (SELECT 1 FROM DATACUT3.HUB_MT_DDIBANP)
	UNION ALL
	-- DD-006 | Malta IBAN format validation
	SELECT 'DD-006', 'Invalid Malta IBAN format: DDIBANP (IBIBAN)',
		   CAST(COUNT(*) AS NUMBER), CAST(NULL AS VARCHAR2(200)), NULL
	  FROM DATACUT3.HUB_MT_DDIBANP
	 WHERE NOT REGEXP_LIKE(TRIM(IBIBAN), '^MT[0-9]{2}[A-Z0-9]{27}$')
	UNION ALL
	-- DD-007 | DD Extension File count vs Master count
	SELECT 'DD-007', 'DD Extension vs Master count diff: DDACESP/DDACMSP',
		   CAST(ABS((SELECT COUNT(*) FROM DATACUT3.HUB_MT_DDACESP) - (SELECT COUNT(*) FROM DATACUT3.HUB_MT_DDACMSP)) AS NUMBER),
		   CAST(NULL AS VARCHAR2(200)), NULL
	  FROM DUAL
	UNION ALL
	-- DD-008 | Cheque Book without DD Account
	SELECT 'DD-008', 'Cheque Book without DD Acct: DDCQBKP',
		   CAST(COUNT(*) AS NUMBER), CAST(NULL AS VARCHAR2(200)), NULL
	  FROM DATACUT3.HUB_MT_DDCQBKP c
	 WHERE NOT EXISTS (SELECT 1 FROM DATACUT3.HUB_MT_DDACMSP a WHERE a.DFACB = c.DJACB AND a.DFACS = c.DJACS)
	UNION ALL
	-- DD-009 | Stop/Lost Cheques without Account
	SELECT 'DD-009', 'Stop Cheque without Account: DDSPCQP',
		   CAST(COUNT(*) AS NUMBER), CAST(NULL AS VARCHAR2(200)), NULL
	  FROM DATACUT3.HUB_MT_DDSPCQP s
	 WHERE NOT EXISTS (SELECT 1 FROM DATACUT3.HUB_MT_DDACMSP a WHERE a.DFACB = s.DKACB AND a.DFACS = s.DKACS)
	UNION ALL
	-- DD-010 | Active DD Account without Statement Setup
	SELECT 'DD-010', 'Active DD Acct without Statement Setup',
		   CAST(COUNT(*) AS NUMBER), CAST(NULL AS VARCHAR2(200)), NULL
	  FROM DATACUT3.HUB_MT_DDACMSP d
	 WHERE d.DFSTUS = 'A'
	   AND NOT EXISTS (SELECT 1 FROM DATACUT3.HUB_MT_DDSMCPP s WHERE s.DIACB = d.DFACB AND s.DIACS = d.DFACS)
	UNION ALL
	-- DD-011 | DD Accounts not in IBAN Table
	SELECT 'DD-011', 'DD Acct not in IBAN table',
		   CAST(COUNT(*) AS NUMBER), CAST(NULL AS VARCHAR2(200)), NULL
	  FROM DATACUT3.HUB_MT_DDACMSP d
	 WHERE NOT EXISTS (SELECT 1 FROM DATACUT3.HUB_MT_DDIBANP i WHERE i.IBACB = d.DFACB AND i.IBACS = d.DFACS)
	UNION ALL
	-- DD-012 | DD Account Product Type Distribution
	SELECT 'DD-012', 'DD Product Type Distribution: DDACMSP (DFAPTY)',
		   CAST(COUNT(*) AS NUMBER), CAST(NVL(DFAPTY, '[NULL]') AS VARCHAR2(200)), NULL
	  FROM DATACUT3.HUB_MT_DDACMSP
	 GROUP BY DFAPTY
	UNION ALL
	SELECT 'DD-012', 'DD Product Type Distribution: DDACMSP (DFAPTY)', 0, CAST(NULL AS VARCHAR2(200)), NULL
	  FROM DUAL WHERE NOT EXISTS (SELECT 1 FROM DATACUT3.HUB_MT_DDACMSP)
	UNION ALL
	-- DD-013 | Statutory A/C Status Distribution
	SELECT 'DD-013', 'Statutory Status Distribution: DDACMSP (DFCBST)',
		   CAST(COUNT(*) AS NUMBER), CAST(NVL(DFCBST, '[NULL]') AS VARCHAR2(200)), NULL
	  FROM DATACUT3.HUB_MT_DDACMSP 
	 GROUP BY DFCBST
	UNION ALL
	SELECT 'DD-013', 'Statutory Status Distribution: DDACMSP (DFCBST)', 0, CAST(NULL AS VARCHAR2(200)), NULL
	  FROM DUAL WHERE NOT EXISTS (SELECT 1 FROM DATACUT3.HUB_MT_DDACMSP)
	UNION ALL
	-- DD-014 | Invalid Cheque Tick-Up Indicator
	SELECT 'DD-014', 'Invalid Cheque Tick-Up Indicator DFTUPI: DDACMSP',
		   CAST(COUNT(*) AS NUMBER), CAST(NULL AS VARCHAR2(200)), NULL
	  FROM DATACUT3.HUB_MT_DDACMSP
	 WHERE DFTUPI IS NOT NULL AND DFTUPI NOT IN ('Y', 'N')
	UNION ALL
	-- DD-015 | EBAI Field non-alphanumeric
	SELECT 'DD-015', 'EBAI non-alphanumeric DFEBAI: DDACMSP',
		   CAST(COUNT(*) AS NUMBER), CAST(NULL AS VARCHAR2(200)), NULL
	  FROM DATACUT3.HUB_MT_DDACMSP
	 WHERE DFEBAI IS NOT NULL AND NOT REGEXP_LIKE(TRIM(DFEBAI), '^[A-Za-z0-9]+$')
	UNION ALL
	-- DD-016 | Account Short Name blank
	SELECT 'DD-016', 'Blank Account Short Name DFACSN: DDACMSP',
		   CAST(COUNT(*) AS NUMBER), CAST(NULL AS VARCHAR2(200)), NULL
	  FROM DATACUT3.HUB_MT_DDACMSP
	 WHERE (DFACSN IS NULL OR TRIM(DFACSN) = '')
	UNION ALL
	-- DD-017 | Restriction Code Distribution
	SELECT 'DD-017', 'Restriction Code Distribution: DDACMSP (DFRSTR)',
		   CAST(COUNT(*) AS NUMBER), CAST(NVL(DFRSTR, '[NULL]') AS VARCHAR2(200)), NULL
	  FROM DATACUT3.HUB_MT_DDACMSP 
	 GROUP BY DFRSTR
	UNION ALL
	SELECT 'DD-017', 'Restriction Code Distribution: DDACMSP (DFRSTR)', 0, CAST(NULL AS VARCHAR2(200)), NULL
	  FROM DUAL WHERE NOT EXISTS (SELECT 1 FROM DATACUT3.HUB_MT_DDACMSP)
	UNION ALL
	-- DD-018 | Account Level Statistics Coverage
	SELECT 'DD-018', 'Account Level Statistics Coverage %',
		   CAST(ROUND((SELECT COUNT(DISTINCT ALACS) FROM DATACUT3.HUB_MT_SSALSFP) * 100.0 /
		   NULLIF((SELECT COUNT(*) FROM DATACUT3.HUB_MT_DDACMSP), 0), 2) AS NUMBER), 
		   CAST(NULL AS VARCHAR2(200)), NULL
	  FROM DUAL
      ) x
    UNION ALL
    SELECT 'CAT-08 ACCOUNT DOMAIN - LOANS (LS)' AS dq_category, x.check_id, x.check_name, x.result_num, x.result_txt, x.expected
      FROM (
	-- LS-001 | Loan Status Distribution
	SELECT 'LS-001' AS check_id, 'Loan Status Distribution: LSACMSP (POSTUS)' AS check_name,
		   CAST(COUNT(*) AS NUMBER) AS RESULT_NUM, CAST(NVL(POSTUS, '[NULL]') AS VARCHAR2(200)) AS RESULT_TXT, CAST(NULL AS NUMBER) AS EXPECTED
	  FROM DATACUT3.HUB_MT_LSACMSP 
	 GROUP BY POSTUS
	UNION ALL
	SELECT 'LS-001', 'Loan Status Distribution: LSACMSP (POSTUS)', 0, CAST(NULL AS VARCHAR2(200)), NULL
	  FROM DUAL WHERE NOT EXISTS (SELECT 1 FROM DATACUT3.HUB_MT_LSACMSP)
	UNION ALL
	-- LS-002 | Loan Currency Distribution
	SELECT 'LS-002', 'Loan Currency Distribution: LSACMSP (POCYCD)',
		   CAST(COUNT(*) AS NUMBER), CAST(NVL(POCYCD, '[NULL]') AS VARCHAR2(200)), NULL
	  FROM DATACUT3.HUB_MT_LSACMSP
	 GROUP BY POCYCD
	UNION ALL
	SELECT 'LS-002', 'Loan Currency Distribution: LSACMSP (POCYCD)', 0, CAST(NULL AS VARCHAR2(200)), NULL
	  FROM DUAL WHERE NOT EXISTS (SELECT 1 FROM DATACUT3.HUB_MT_LSACMSP)
	UNION ALL
	-- LS-003 | Loan Account without matching Customer
	SELECT 'LS-003', 'Loan Acct without Customer: LSACMSP',
		   CAST(COUNT(*) AS NUMBER), CAST(NULL AS VARCHAR2(200)), NULL
	  FROM DATACUT3.HUB_MT_LSACMSP l
	 WHERE NOT EXISTS (SELECT 1 FROM DATACUT3.HUB_MT_SSCUSTP c WHERE c.ZGDCB = l.PODCB AND c.ZGDCS = l.PODCS)
	UNION ALL
	-- LS-004 | Active Loan without Repayment Schedule
	SELECT 'LS-004', 'Active Loan without Repayment Schedule',
		   CAST(COUNT(*) AS NUMBER), CAST(NULL AS VARCHAR2(200)), NULL
	  FROM DATACUT3.HUB_MT_LSACMSP l
	 WHERE l.POSTUS = 'A'
	   AND NOT EXISTS (SELECT 1 FROM DATACUT3.HUB_MT_LSRHSLP r WHERE r.CFACB = l.POACB AND r.CFACS = l.POACS)
	UNION ALL
	-- LS-005 | Interest Accrual without matching Loan
	SELECT 'LS-005', 'Interest Accrual without Loan: LSINACP',
		   CAST(COUNT(*) AS NUMBER), CAST(NULL AS VARCHAR2(200)), NULL
	  FROM DATACUT3.HUB_MT_LSINACP i
	 WHERE NOT EXISTS (SELECT 1 FROM DATACUT3.HUB_MT_LSACMSP l WHERE l.POACB = i.EQACB AND l.POACS = i.EQACS)
	UNION ALL
	-- LS-006 | Local vs Core Accrual count diff
	SELECT 'LS-006', 'Local vs Core Accrual count diff',
		   CAST(ABS((SELECT COUNT(*) FROM DATACUT3."HUB_MT_LS@INACP") - (SELECT COUNT(*) FROM DATACUT3.HUB_MT_LSINACP)) AS NUMBER),
		   CAST(NULL AS VARCHAR2(200)), NULL
	  FROM DUAL
	UNION ALL
	-- LS-007 | Payment History Coverage %
	SELECT 'LS-007', 'Payment History Coverage %',
		   CAST(ROUND((SELECT COUNT(DISTINCT CNACS) FROM DATACUT3.HUB_MT_LSPMHSP) * 100.0 /
		   NULLIF((SELECT COUNT(*) FROM DATACUT3.HUB_MT_LSACMSP), 0), 2) AS NUMBER),
		   CAST(NULL AS VARCHAR2(200)), NULL
	  FROM DUAL
	UNION ALL
	-- LS-008 | Irregular Repayment without matching Loan
	SELECT 'LS-008', 'Irregular Repayment without Loan: LSILRSP',
		   CAST(COUNT(*) AS NUMBER), CAST(NULL AS VARCHAR2(200)), NULL
	  FROM DATACUT3.HUB_MT_LSILRSP i
	 WHERE NOT EXISTS (SELECT 1 FROM DATACUT3.HUB_MT_LSACMSP l WHERE l.POACB = i.IOACB AND l.POACS = i.IOACS)
	UNION ALL
	-- LS-009 | Write-Off Accounts with Active Status
	SELECT 'LS-009', 'Write-Off Acct with Active Status',
		   CAST(COUNT(*) AS NUMBER), CAST(NULL AS VARCHAR2(200)), NULL
	  FROM DATACUT3.HUB_MT_SSWAINP w
	  JOIN DATACUT3.HUB_MT_LSACMSP l ON l.POACB = w.VIACB AND l.POACS = w.VIACS
	 WHERE l.POSTUS = 'A'
	UNION ALL
	-- LS-010 | Loan Interest Rate History Coverage %
	SELECT 'LS-010', 'Loan IR History Coverage %',
		   CAST(ROUND((SELECT COUNT(DISTINCT LIACS) FROM DATACUT3.HUB_MT_LSIRHFP) * 100.0 /
		   NULLIF((SELECT COUNT(*) FROM DATACUT3.HUB_MT_LSACMSP), 0), 2) AS NUMBER),
		   CAST(NULL AS VARCHAR2(200)), NULL
	  FROM DUAL
	UNION ALL
	-- LS-011 | Total Outstanding Loan Principal by Currency
	SELECT 'LS-011', 'Total Outstanding Principal by Currency: LSACMSP',
		   CAST(ROUND(SUM(NVL(POROPR, 0)) / 1000000, 2) AS NUMBER), CAST(POCYCD AS VARCHAR2(200)), NULL
	  FROM DATACUT3.HUB_MT_LSACMSP 
	 GROUP BY POCYCD
	UNION ALL
	SELECT 'LS-011', 'Total Outstanding Principal by Currency: LSACMSP', 0, CAST(NULL AS VARCHAR2(200)), NULL
	  FROM DUAL WHERE NOT EXISTS (SELECT 1 FROM DATACUT3.HUB_MT_LSACMSP)
	UNION ALL
	-- LS-012 | Loan Scheduler count diff
	SELECT 'LS-012', 'Loan Scheduler count diff: LSINSLP/LSRPSLP',
		   CAST(ABS((SELECT COUNT(*) FROM DATACUT3.HUB_MT_LSINSLP) - (SELECT COUNT(*) FROM DATACUT3.HUB_MT_LSRPSLP)) AS NUMBER),
		   CAST(NULL AS VARCHAR2(200)), NULL
	  FROM DUAL
	UNION ALL
	-- LS-013 | Local Repayment Account without Loan
	SELECT 'LS-013', 'Local Repayment Acct without Loan: LS@RPACP',
		   CAST(COUNT(*) AS NUMBER), CAST(NULL AS VARCHAR2(200)), NULL
	  FROM DATACUT3."HUB_MT_LS@RPACP" r
	 WHERE NOT EXISTS (SELECT 1 FROM DATACUT3.HUB_MT_LSACMSP l WHERE l.POACB = r.PQACB AND l.POACS = r.PQACS)
	UNION ALL
	-- LS-014 | Loan Limit Type Distribution
	SELECT 'LS-014', 'Loan Limit Type Distribution: LSACMSP (POLMTY)',
		   CAST(COUNT(*) AS NUMBER), CAST(NVL(POLMTY, '[NULL]') AS VARCHAR2(200)), NULL
	  FROM DATACUT3.HUB_MT_LSACMSP 
	 GROUP BY POLMTY
	UNION ALL
	SELECT 'LS-014', 'Loan Limit Type Distribution: LSACMSP (POLMTY)', 0, CAST(NULL AS VARCHAR2(200)), NULL
	  FROM DUAL WHERE NOT EXISTS (SELECT 1 FROM DATACUT3.HUB_MT_LSACMSP)
	UNION ALL
	-- LS-015 | Avg Instalments (ΕΔΩ ΗΤΑΝ ΤΟ ΛΑΘΟΣ - ΔΙΟΡΘΩΘΗΚΕ ΜΕ DUAL)
	SELECT 'LS-015', 'Avg Instalments per Active Loan: LSRHSLP',
		   CAST(ROUND((SELECT COUNT(*) FROM DATACUT3.HUB_MT_LSRHSLP) * 1.0 / 
		   NULLIF((SELECT COUNT(*) FROM DATACUT3.HUB_MT_LSACMSP WHERE POSTUS = 'A'), 0), 1) AS NUMBER),
		   CAST(NULL AS VARCHAR2(200)), NULL
	  FROM DUAL
	UNION ALL
	-- LS-016 | Loan Account Short Name blank
	SELECT 'LS-016', 'Blank Loan Short Name POACSN: LSACMSP',
		   CAST(COUNT(*) AS NUMBER), CAST(NULL AS VARCHAR2(200)), NULL
	  FROM DATACUT3.HUB_MT_LSACMSP
	 WHERE (POACSN IS NULL OR TRIM(POACSN) IS NULL)
	UNION ALL
	-- LS-017 | Repayment Holiday Records count
	SELECT 'LS-017', 'Repayment Holiday count: LS@RHICP',
		   CAST(COUNT(*) AS NUMBER), CAST(NULL AS VARCHAR2(200)), 211
	  FROM DATACUT3."HUB_MT_LS@RHICP" 
      ) x
    UNION ALL
    SELECT 'CAT-09 ACCOUNT DOMAIN - TERM DEPOSITS (TD)' AS dq_category, x.check_id, x.check_name, x.result_num, x.result_txt, x.expected
      FROM (
-- TD-001 | Term Deposit without matching Customer – TDACMSP  (TDDCB + TDDCS)
SELECT 'TD-001' AS check_id, 'TD Acct without Customer: TDACMSP' AS check_name,
	   COUNT(*) AS RESULT_NUM, CAST(NULL AS VARCHAR2(200)) AS RESULT_TXT, CAST(NULL AS NUMBER) AS EXPECTED
  FROM DATACUT3.HUB_MT_TDACMSP t
 WHERE NOT EXISTS (SELECT 1 FROM DATACUT3.HUB_MT_SSCUSTP c
					WHERE c.ZGDCB = t.TDDCB AND c.ZGDCS = t.TDDCS)
UNION ALL
-- TD-002 | TD Status Distribution – TDACMSP  (TDSTUS)
SELECT 'TD-002' AS check_id, 'TD Status Distribution: TDACMSP (TDSTUS)' AS check_name,
	   COUNT(*) AS RESULT_NUM, NVL(TDSTUS, '[NULL]') AS RESULT_TXT, CAST(NULL AS NUMBER) AS EXPECTED
  FROM DATACUT3.HUB_MT_TDACMSP 
 GROUP BY TDSTUS
UNION ALL
-- TD-002 | [sentinel – no data guard]
SELECT 'TD-002' AS check_id, 'TD Status Distribution: TDACMSP (TDSTUS)' AS check_name,
	   0 AS RESULT_NUM, CAST(NULL AS VARCHAR2(200)) AS RESULT_TXT,
	   CAST(NULL AS NUMBER) AS EXPECTED
  FROM DUAL
 WHERE NOT EXISTS (SELECT 1 FROM DATACUT3.HUB_MT_TDACMSP)
UNION ALL
-- TD-003 | TD Currency Distribution – TDACMSP  (TDCYCD)
SELECT 'TD-003' AS check_id, 'TD Currency Distribution: TDACMSP (TDCYCD)' AS check_name,
	   COUNT(*) AS RESULT_NUM, NVL(TDCYCD, '[NULL]') AS RESULT_TXT, CAST(NULL AS NUMBER) AS EXPECTED
  FROM DATACUT3.HUB_MT_TDACMSP 
 GROUP BY TDCYCD
UNION ALL
-- TD-003 | [sentinel – no data guard]
SELECT 'TD-003' AS check_id, 'TD Currency Distribution: TDACMSP (TDCYCD)' AS check_name,
	   0 AS RESULT_NUM, CAST(NULL AS VARCHAR2(200)) AS RESULT_TXT,
	   CAST(NULL AS NUMBER) AS EXPECTED
  FROM DUAL
 WHERE NOT EXISTS (SELECT 1 FROM DATACUT3.HUB_MT_TDACMSP)
UNION ALL
-- TD-004 | TD Additional Info Coverage % – TDACADP / TDACMSP  (TAACB + TAACS)
SELECT 'TD-004' AS check_id, 'TD Additional Info Coverage %: TDACADP' AS check_name,
	   ROUND(
		 (SELECT COUNT(*) FROM DATACUT3.HUB_MT_TDACADP ) * 100.0 /
		 NULLIF((SELECT COUNT(*) FROM DATACUT3.HUB_MT_TDACMSP), 0)
	   , 2) AS RESULT_NUM, CAST(NULL AS VARCHAR2(200)) AS RESULT_TXT, CAST(NULL AS NUMBER) AS EXPECTED
  FROM DUAL
UNION ALL
-- TD-005 | TD Sub-Product without Product Control – TDSPCPP / TDPDCPP  (TBAPTY vs TAAPTY)
SELECT 'TD-005' AS check_id, 'TD Sub-Product without Product: TDSPCPP' AS check_name,
	   COUNT(*) AS RESULT_NUM, CAST(NULL AS VARCHAR2(200)) AS RESULT_TXT, CAST(NULL AS NUMBER) AS EXPECTED
  FROM DATACUT3.HUB_MT_TDSPCPP s
 WHERE NOT EXISTS (SELECT 1 FROM DATACUT3.HUB_MT_TDPDCPP p WHERE p.TAAPTY = s.TBAPTY)
UNION ALL
-- TD-006 | TD Account without valid Product Type – TDACMSP / TDPDCPP  (TDAPTY vs TAAPTY)
SELECT 'TD-006' AS check_id, 'TD Acct without Product Type: TDACMSP' AS check_name,
	   COUNT(*) AS RESULT_NUM, CAST(NULL AS VARCHAR2(200)) AS RESULT_TXT, CAST(NULL AS NUMBER) AS EXPECTED
  FROM DATACUT3.HUB_MT_TDACMSP t
 WHERE t.TDMDFL &lt;&gt; 'S'
   AND NOT EXISTS (SELECT 1 FROM DATACUT3.HUB_MT_TDPDCPP p WHERE p.TAAPTY = t.TDAPTY)
UNION ALL
-- TD-007 | Total TD Ledger Balance by Currency – TDACMSP  (TDRLBL)
SELECT 'TD-007' AS check_id, 'Total TD Ledger Balance by Currency: TDACMSP (TDRLBL)' AS check_name,
	   ROUND(SUM(NVL(TDRLBL, 0)) / 1000000, 2) AS RESULT_NUM, NVL(TDCYCD,'[NULL]') AS RESULT_TXT, CAST(NULL AS NUMBER) AS EXPECTED
  FROM DATACUT3.HUB_MT_TDACMSP WHERE TDMDFL &lt;&gt; 'S'
 GROUP BY TDCYCD
UNION ALL
-- TD-007 | [sentinel – no data guard]
SELECT 'TD-007' AS check_id, 'Total TD Ledger Balance by Currency: TDACMSP (TDRLBL)' AS check_name,
	   0 AS RESULT_NUM, CAST(NULL AS VARCHAR2(200)) AS RESULT_TXT,
	   CAST(NULL AS NUMBER) AS EXPECTED
  FROM DUAL
 WHERE NOT EXISTS (SELECT 1 FROM DATACUT3.HUB_MT_TDACMSP )
UNION ALL
-- TD-008 | Matured TD without Renewal Due Date – TDACMSP  (TDSTUS = 'M', TDRDUD)
SELECT 'TD-008' AS check_id, 'Matured TD without Renewal Due Date: TDACMSP (TDRDUD)' AS check_name,
	   COUNT(*) AS RESULT_NUM, CAST(NULL AS VARCHAR2(200)) AS RESULT_TXT, CAST(NULL AS NUMBER) AS EXPECTED
  FROM DATACUT3.HUB_MT_TDACMSP
 WHERE TDSTUS = 'M' AND TDRDUD IS NULL
UNION ALL
-- TD-009 | TD Opening Year Distribution – TDACMSP  (TDDTAO) [FIXED FOR DATE TYPE]
SELECT 'TD-009' AS check_id, 'TD Opening Year Distribution: TDACMSP (TDDTAO)' AS check_name,
	   COUNT(*) AS RESULT_NUM, TO_CHAR(EXTRACT(YEAR FROM TDDTAO)) AS RESULT_TXT, CAST(NULL AS NUMBER) AS EXPECTED
  FROM DATACUT3.HUB_MT_TDACMSP
 WHERE TDDTAO &gt; TO_DATE('19000101', 'YYYYMMDD')
 GROUP BY EXTRACT(YEAR FROM TDDTAO)
UNION ALL
-- TD-009 | [sentinel – no data guard] [FIXED FOR DATE TYPE]
SELECT 'TD-009' AS check_id, 'TD Opening Year Distribution: TDACMSP (TDDTAO)' AS check_name,
	   0 AS RESULT_NUM, CAST(NULL AS VARCHAR2(200)) AS RESULT_TXT,
	   CAST(NULL AS NUMBER) AS EXPECTED
  FROM DUAL
 WHERE NOT EXISTS (SELECT 1 FROM DATACUT3.HUB_MT_TDACMSP
 WHERE TDDTAO &gt; TO_DATE('19000101', 'YYYYMMDD'))
UNION ALL
-- TD-010 | Negative TD Ledger Balance – TDACMSP  (TDRLBL)
SELECT 'TD-010' AS check_id, 'Negative TD Ledger Balance: TDACMSP (TDRLBL)' AS check_name,
	   COUNT(*) AS RESULT_NUM, CAST(NULL AS VARCHAR2(200)) AS RESULT_TXT, CAST(NULL AS NUMBER) AS EXPECTED
  FROM DATACUT3.HUB_MT_TDACMSP WHERE TDRLBL &lt; 0
UNION ALL
-- TD-011 | TD vs PGL Account Count Comparison
SELECT 'TD-011' AS check_id, 'TD vs PGL Account Count diff' AS check_name,
	   ABS((SELECT COUNT(*) FROM DATACUT3.HUB_MT_TDACMSP WHERE TDMDFL &lt;&gt; 'S') - (SELECT COUNT(*) FROM DATACUT3.HUB_MT_PLACMSP)) AS RESULT_NUM,
	   CAST(NULL AS VARCHAR2(200)) AS RESULT_TXT,
	   CAST(NULL AS NUMBER) AS EXPECTED
  FROM DUAL
      ) x
    UNION ALL
    SELECT 'CAT-10 REFERENTIAL INTEGRITY - CROSS-TABLE' AS dq_category, x.check_id, x.check_name, x.result_num, x.result_txt, x.expected
      FROM (
	-- RI-001 | SEPA Records without creditor DD Account
	SELECT 'RI-001' AS check_id, 'SEPA without DD Account (creditor): EUDTSDDP' AS check_name,
		   CAST(COUNT(*) AS NUMBER) AS RESULT_NUM, CAST(NULL AS VARCHAR2(200)) AS RESULT_TXT, CAST(NULL AS NUMBER) AS EXPECTED
	  FROM DATACUT3.HUB_MT_EUDTSDDP e
	 WHERE NOT EXISTS (SELECT 1 FROM DATACUT3.HUB_MT_DDACMSP d
						WHERE d.DFACB = e.SDCACB AND d.DFACS = e.SDCACS)
	UNION ALL
	-- RI-002 | S/I Records without Source DD Account
	SELECT 'RI-002', 'S/I without Source DD Account: AFSIMSP',
		   CAST(COUNT(*) AS NUMBER), CAST(NULL AS VARCHAR2(200)), NULL
	  FROM DATACUT3.HUB_MT_AFSIMSP s
	 WHERE NOT EXISTS (SELECT 1 FROM DATACUT3.HUB_MT_DDACMSP d
						WHERE d.DFACB = s.FNPPAB AND d.DFACS = s.FNPPAS)
	UNION ALL
	-- RI-003 | S/I Retention without S/I Master (ΑΦΑΙΡΕΘΗΚΕ ΤΟ FNMDFL &lt;&gt; 'S')
	SELECT 'RI-003', 'S/I Retention without Master: AFSIRAP',
		   CAST(COUNT(*) AS NUMBER), CAST(NULL AS VARCHAR2(200)), NULL
	  FROM DATACUT3.HUB_MT_AFSIRAP r
	 WHERE NOT EXISTS (SELECT 1 FROM DATACUT3.HUB_MT_AFSIMSP m
						WHERE m.FNPPAB = r.FTPPAB AND m.FNPPAS = r.FTPPAS)
	UNION ALL
	-- RI-004 | S/I Transaction Journal without S/I Master
	SELECT 'RI-004', 'S/I Journal without Master: AFSITJP (F0SINO)',
		   CAST(COUNT(*) AS NUMBER), CAST(NULL AS VARCHAR2(200)), NULL
	  FROM DATACUT3.HUB_MT_AFSITJP j
	 WHERE NOT EXISTS (SELECT 1 FROM DATACUT3.HUB_MT_AFSIMSP m
						WHERE m.FNSINO = j.F0SINO)
	UNION ALL
	-- RI-005 | Security Held without Security Relationship
	SELECT 'RI-005', 'Security Held without Relationship: SSSECHP (Y2SCSR)',
		   CAST(COUNT(*) AS NUMBER), CAST(NULL AS VARCHAR2(200)), NULL
	  FROM DATACUT3.HUB_MT_SSSECHP s
	 WHERE NOT EXISTS (SELECT 1 FROM DATACUT3.HUB_MT_SSSCRLP r
						WHERE r.VYSCSR = s.Y2SCSR)
	UNION ALL
	-- RI-006 | Security Extension without Security Held
	SELECT 'RI-006', 'Security Extension without Held: SS@SCHP (SCSCSR)',
		   CAST(COUNT(*) AS NUMBER), CAST(NULL AS VARCHAR2(200)), NULL
	  FROM DATACUT3."HUB_MT_SS@SCHP" e
	 WHERE NOT EXISTS (SELECT 1 FROM DATACUT3.HUB_MT_SSSECHP s
						WHERE s.Y2SCSR = e.SCSCSR)
	UNION ALL
	-- RI-007 | IFRS9 Records without DD or LS Account
	SELECT 'RI-007', 'IFRS9 without DD or LS Account: SSIFSEP',
		   CAST(COUNT(*) AS NUMBER), CAST(NULL AS VARCHAR2(200)), NULL
	  FROM DATACUT3.HUB_MT_SSIFSEP i
	 WHERE NOT EXISTS (SELECT 1 FROM DATACUT3.HUB_MT_DDACMSP d
						WHERE d.DFACB = i.SIACB AND d.DFACS = i.SIACS)
	   AND NOT EXISTS (SELECT 1 FROM DATACUT3.HUB_MT_LSACMSP l
						WHERE l.POACB = i.SIACB AND l.POACS = i.SIACS)
	UNION ALL
	-- RI-008 | IFRS9 Coverage % per LS Account
	SELECT 'RI-008', 'IFRS9 Coverage % per LS Acct',
		   CAST(ROUND((SELECT COUNT(DISTINCT SIACS) FROM DATACUT3.HUB_MT_SSIFSEP) * 100.0 /
		   NULLIF((SELECT COUNT(*) FROM DATACUT3.HUB_MT_LSACMSP), 0), 2) AS NUMBER),
		   CAST(NULL AS VARCHAR2(200)), NULL
	  FROM DUAL
	UNION ALL
	-- RI-009 | IB Account ID without DD Account (ΑΦΑΙΡΕΘΗΚΕ ΤΟ IAMDFL &lt;&gt; 'S')
	SELECT 'RI-009', 'IB Acct ID without DD Account: IBACIDP',
		   CAST(COUNT(*) AS NUMBER), CAST(NULL AS VARCHAR2(200)), NULL
	  FROM DATACUT3.HUB_MT_IBACIDP i
	 WHERE NOT EXISTS (SELECT 1 FROM DATACUT3.HUB_MT_DDACMSP d
						WHERE d.DFACB = i.IAACB AND d.DFACS = i.IAACS)
	UNION ALL
	-- RI-010 | IB E-Statement without IB Account ID
	SELECT 'RI-010', 'IB E-Statement without IB Acct ID: IBESMCP',
		   CAST(COUNT(*) AS NUMBER), CAST(NULL AS VARCHAR2(200)), NULL
	  FROM DATACUT3.HUB_MT_IBESMCP s
	 WHERE NOT EXISTS (SELECT 1 FROM DATACUT3.HUB_MT_IBACIDP i
						WHERE i.IAACB = s.YGACB AND i.IAACS = s.YGACS)
	UNION ALL
	-- RI-011 | EB Domestic Customer without EB Customer
	SELECT 'RI-011', 'EB Domestic Cust without EB Cust: EBDCNOP',
		   CAST(COUNT(*) AS NUMBER), CAST(NULL AS VARCHAR2(200)), NULL
	  FROM DATACUT3.HUB_MT_EBDCNOP d
	 WHERE NOT EXISTS (SELECT 1 FROM DATACUT3.HUB_MT_EBCUSTP e
						WHERE e.PCDCB = d.ICDCB AND e.PCDCS = d.ICDCS)
	UNION ALL
	-- RI-012 | Business Register Group without Company
	SELECT 'RI-012', 'Group Struct without Biz Register: FN@GSGP (FRDENT)',
		   CAST(COUNT(*) AS NUMBER), CAST(NULL AS VARCHAR2(200)), NULL
	  FROM DATACUT3."HUB_MT_FN@GSGP" g
	 WHERE NOT EXISTS (SELECT 1 FROM DATACUT3."HUB_MT_FN@BRGP" b WHERE b.FNDENT = g.FRDENT)
	UNION ALL
	-- RI-013 | Cashier Order History without Master
	SELECT 'RI-013', 'Cashier Order History without Master: OR@CORP',
		   CAST(COUNT(*) AS NUMBER), CAST(NULL AS VARCHAR2(200)), NULL
	  FROM DATACUT3."HUB_MT_OR@CORP" h
	 WHERE NOT EXISTS (SELECT 1 FROM DATACUT3.HUB_MT_ORCOMSP m WHERE m.ORDLNO = h.RNDLNO)
	UNION ALL
	-- RI-014 | PGL Account without matching Customer
	SELECT 'RI-014', 'PGL/Guarantee Acct without Customer: PLACMSP',
		   CAST(COUNT(*) AS NUMBER), CAST(NULL AS VARCHAR2(200)), NULL
	  FROM DATACUT3.HUB_MT_PLACMSP p
	 WHERE NOT EXISTS (SELECT 1 FROM DATACUT3.HUB_MT_SSCUSTP c
						WHERE c.ZGDCB = p.PFDCB AND c.ZGDCS = p.PFDCS)
	UNION ALL
	-- RI-015 | DD Sub-Product without DD Product Control
	SELECT 'RI-015', 'DD Sub-Product without Product: DDSPCPP',
		   CAST(COUNT(*) AS NUMBER), CAST(NULL AS VARCHAR2(200)), NULL
	  FROM DATACUT3.HUB_MT_DDSPCPP s
	 WHERE NOT EXISTS (SELECT 1 FROM DATACUT3.HUB_MT_DDPDCPP p WHERE p.DAAPTY = s.DBAPTY)
	UNION ALL
	-- RI-016 | PGL Sub-Product without Product
	SELECT 'RI-016', 'PGL Sub-Product without Product: PLSPCPP',
		   CAST(COUNT(*) AS NUMBER), CAST(NULL AS VARCHAR2(200)), NULL
	  FROM DATACUT3.HUB_MT_PLSPCPP s
	 WHERE NOT EXISTS (SELECT 1 FROM DATACUT3.HUB_MT_PLPDCPP p WHERE p.PAAPTY = s.PBAPTY)
	UNION ALL
	-- RI-017 | Service Charging Detail without Master
	SELECT 'RI-017', 'Charging Detail without Master: SSCHDAP (SDCHRC)',
		   CAST(COUNT(*) AS NUMBER), CAST(NULL AS VARCHAR2(200)), NULL
	  FROM DATACUT3.HUB_MT_SSCHDAP d
	 WHERE NOT EXISTS (SELECT 1 FROM DATACUT3.HUB_MT_SSCHCLP m WHERE m.SCCHRC = d.SDCHRC)
	UNION ALL
	-- RI-018 | Safe Deposit CBAR cross-reference (ΑΦΑΙΡΕΘΗΚΕ ΤΟ SBMDFL &lt;&gt; 'S')
	SELECT 'RI-018', 'Safe Deposit CBAR cross-reference diff',
		   CAST(ABS((SELECT COUNT(*) FROM DATACUT3."HUB_MT_SX@OWNSP") - (SELECT COUNT(*) FROM DATACUT3.HUB_MT_SXOWNSP)) AS NUMBER),
		   CAST(NULL AS VARCHAR2(200)), NULL
	  FROM DUAL
	UNION ALL
	-- RI-019 | Group Member without Group Name
	SELECT 'RI-019', 'Group Member without Group Name: SSGPRLP/SSGPNMP',
		   CAST(COUNT(*) AS NUMBER), CAST(NULL AS VARCHAR2(200)), NULL
	  FROM DATACUT3.HUB_MT_SSGPRLP r
	 WHERE NOT EXISTS (SELECT 1 FROM DATACUT3.HUB_MT_SSGPNMP g
						WHERE g.ZPCGB = r.ZHCGB AND g.ZPCGG = r.ZHCGG)
      ) x
    UNION ALL
    SELECT 'CAT-11 REGULATORY - CBAR' AS dq_category, x.check_id, x.check_name, x.result_num, x.result_txt, x.expected
      FROM (
	-- CB-001 | CBAR Account Type Distribution
	SELECT 'CB-001' AS check_id, 'CBAR Account Type Distribution: SS@ACPP (ACTYPE)' AS check_name,
		   CAST(COUNT(*) AS NUMBER) AS RESULT_NUM, CAST(NVL(ACTYPE, '[NULL]') AS VARCHAR2(200)) AS RESULT_TXT, CAST(NULL AS NUMBER) AS EXPECTED
	  FROM DATACUT3."HUB_MT_SS@ACPP"
	 GROUP BY ACTYPE
	UNION ALL
	SELECT 'CB-001', 'CBAR Account Type Distribution: SS@ACPP (ACTYPE)', 0, CAST(NULL AS VARCHAR2(200)), NULL
	  FROM DUAL WHERE NOT EXISTS (SELECT 1 FROM DATACUT3."HUB_MT_SS@ACPP")
	UNION ALL
	-- CB-002 | Duplicate Unique IDs (ΔΙΟΡΘΩΘΗΚΕ ΤΟ CASTING)
	SELECT check_id, check_name, count(DISTINCT RESULT_TXT) AS RESULT_NUM, NULL AS RESULT_TXT, EXPECTED
	FROM 
	(
	SELECT 'CB-002' AS check_id, 'Duplicate Unique ID ACUQID: SS@ACPP' AS check_name,
		   COUNT(*) AS RESULT_NUM, TO_CHAR(ACUQID) AS RESULT_TXT, CAST(NULL AS NUMBER) AS EXPECTED
	  FROM DATACUT3."HUB_MT_SS@ACPP" WHERE ACUQID IS NOT NULL
	 GROUP BY ACUQID HAVING COUNT(*) &gt; 1
	)
	GROUP BY check_id, check_name, EXPECTED
	UNION ALL
	SELECT 'CB-002', 'Duplicate Unique ID ACUQID: SS@ACPP', 0, CAST(NULL AS VARCHAR2(200)), NULL
	  FROM DUAL WHERE NOT EXISTS (SELECT 1 FROM DATACUT3."HUB_MT_SS@ACPP" WHERE ACUQID IS NOT NULL)
	UNION ALL
	-- CB-003 | CBAR Account Opening Date format
	SELECT 'CB-003', 'CBAR Acct Opening Date format ACDTAD: SS@ACPP',
		   CAST(COUNT(*) AS NUMBER), CAST(NULL AS VARCHAR2(200)), NULL
	  FROM DATACUT3."HUB_MT_SS@ACPP"
	 WHERE ACDTAD IS NOT NULL AND NOT REGEXP_LIKE(TRIM(ACDTAD), '^[0-9]{4}[-/]?[0-9]{2}[-/]?[0-9]{2}$')
	UNION ALL
	-- CB-004 | CBAR Closing Date before Opening Date
	SELECT 'CB-004', 'CBAR Closing Date &lt; Opening Date: SS@ACPP',
		   CAST(COUNT(*) AS NUMBER), CAST(NULL AS VARCHAR2(200)), NULL
	  FROM DATACUT3."HUB_MT_SS@ACPP"
	 WHERE ACDTCL IS NOT NULL AND ACDTAD IS NOT NULL
	   AND REGEXP_LIKE(TRIM(ACDTAD), '^[0-9]{8}$') AND REGEXP_LIKE(TRIM(ACDTCL), '^[0-9]{8}$')
	   AND TRIM(ACDTCL) &lt; TRIM(ACDTAD)
	UNION ALL
	-- CB-005 | CBAR Party Type Distribution
	SELECT 'CB-005', 'CBAR Party Type Distribution: SS@ACPP (ACCSTY)',
		   CAST(COUNT(*) AS NUMBER), CAST(NVL(ACCSTY, '[NULL]') AS VARCHAR2(200)), NULL
	  FROM DATACUT3."HUB_MT_SS@ACPP"
	 GROUP BY ACCSTY
	UNION ALL
	SELECT 'CB-005', 'CBAR Party Type Distribution: SS@ACPP (ACCSTY)', 0, CAST(NULL AS VARCHAR2(200)), NULL
	  FROM DUAL WHERE NOT EXISTS (SELECT 1 FROM DATACUT3."HUB_MT_SS@ACPP")
	UNION ALL
	-- CB-006 | Duplicate Unique IDs IPUQID
	SELECT check_id, check_name, count(DISTINCT RESULT_TXT) AS RESULT_NUM, NULL AS RESULT_TXT, EXPECTED
	FROM 
	(
	SELECT 'CB-006' AS check_id, 'Duplicate Unique ID IPUQID: SS@IPPP' AS check_name,
		   CAST(COUNT(*) AS NUMBER) AS RESULT_NUM, CAST(TO_CHAR(IPUQID) AS VARCHAR2(200)) AS RESULT_TXT, NULL AS EXPECTED
	  FROM DATACUT3."HUB_MT_SS@IPPP" WHERE IPUQID IS NOT NULL
	 GROUP BY IPUQID HAVING COUNT(*) &gt; 1
	)
	GROUP BY check_id, check_name, EXPECTED
	UNION ALL
	SELECT 'CB-006', 'Duplicate Unique ID IPUQID: SS@IPPP', 0, CAST(NULL AS VARCHAR2(200)), NULL
	  FROM DUAL WHERE NOT EXISTS (SELECT 1 FROM DATACUT3."HUB_MT_SS@IPPP" WHERE IPUQID IS NOT NULL)
	UNION ALL
	-- CB-007 | CBAR Party Birth Date format
	SELECT 'CB-007', 'CBAR Party Birth Date format IPDTBR: SS@IPPP',
		   CAST(COUNT(*) AS NUMBER), CAST(NULL AS VARCHAR2(200)), NULL
	  FROM DATACUT3."HUB_MT_SS@IPPP"
	 WHERE IPDTBR IS NOT NULL AND NOT REGEXP_LIKE(TRIM(IPDTBR), '^[0-9]{4}[-/]?[0-9]{2}[-/]?[0-9]{2}$')
	UNION ALL
	-- CB-008 | CBAR Party Nationality valid ISO code
	SELECT 'CB-008', 'CBAR Invalid Nationality ISO IPNATY: SS@IPPP',
		   CAST(COUNT(*) AS NUMBER), CAST(NVL(IPNATY,'[NULL]') AS VARCHAR2(200)), NULL
	  FROM DATACUT3."HUB_MT_SS@IPPP"
	 WHERE IPNATY IS NOT NULL AND NOT REGEXP_LIKE(TRIM(IPNATY), '^[A-Z]{2}$')
	 GROUP BY IPNATY
	UNION ALL
	SELECT 'CB-008', 'CBAR Invalid Nationality ISO IPNATY: SS@IPPP', 0, CAST(NULL AS VARCHAR2(200)), NULL
	  FROM DUAL WHERE NOT EXISTS (SELECT 1 FROM DATACUT3."HUB_MT_SS@IPPP" WHERE IPNATY IS NOT NULL AND NOT REGEXP_LIKE(TRIM(IPNATY), '^[A-Z]{2}$'))
	UNION ALL
	-- CB-009 | CBAR Party Name not empty
	SELECT 'CB-009', 'NULL/Blank Party Name IPCSFN: SS@IPPP',
		   CAST(COUNT(*) AS NUMBER), CAST(NULL AS VARCHAR2(200)), NULL
	  FROM DATACUT3."HUB_MT_SS@IPPP"
	 WHERE IPCSFN IS NULL OR TRIM(IPCSFN) IS NULL
	UNION ALL
	-- CB-010 | CBAR Document Type Distribution
	SELECT 'CB-010', 'CBAR Document Type Distribution IPTDTY: SS@IPPP',
		   CAST(COUNT(*) AS NUMBER), CAST(NVL(IPTDTY, '[NULL]') AS VARCHAR2(200)), NULL
	  FROM DATACUT3."HUB_MT_SS@IPPP"
	 GROUP BY IPTDTY
	UNION ALL
	SELECT 'CB-010', 'CBAR Document Type Distribution IPTDTY: SS@IPPP', 0, CAST(NULL AS VARCHAR2(200)), NULL
	  FROM DUAL WHERE NOT EXISTS (SELECT 1 FROM DATACUT3."HUB_MT_SS@IPPP")
	UNION ALL
	-- CB-011 | CBAR Registration Date format
	SELECT 'CB-011', 'CBAR Registration Date format IPBSDT: SS@IPPP',
		   CAST(COUNT(*) AS NUMBER), CAST(NULL AS VARCHAR2(200)), NULL
	  FROM DATACUT3."HUB_MT_SS@IPPP"
	 WHERE IPBSDT IS NOT NULL AND NOT REGEXP_LIKE(TRIM(IPBSDT), '^[0-9]{4}[-/]?[0-9]{2}[-/]?[0-9]{2}$')
	UNION ALL
	-- CB-012 | CBAR Relationship Type Distribution
	SELECT 'CB-012', 'CBAR Relationship Type Distribution ACCTCG: SS@ACPP',
		   CAST(COUNT(*) AS NUMBER), CAST(NVL(ACCTCG, '[NULL]') AS VARCHAR2(200)), NULL
	  FROM DATACUT3."HUB_MT_SS@ACPP"
	 GROUP BY ACCTCG
	UNION ALL
	SELECT 'CB-012', 'CBAR Relationship Type Distribution ACCTCG: SS@ACPP', 0, CAST(NULL AS VARCHAR2(200)), NULL
	  FROM DUAL WHERE NOT EXISTS (SELECT 1 FROM DATACUT3."HUB_MT_SS@ACPP")
	UNION ALL
	-- CB-013 | CBAR Accounts without Relationship Start Date
	SELECT 'CB-013', 'CBAR Acct without Relationship Start ACSTRT: SS@ACPP',
		   CAST(COUNT(*) AS NUMBER), CAST(NULL AS VARCHAR2(200)), NULL
	  FROM DATACUT3."HUB_MT_SS@ACPP"
	 WHERE ACDTAD IS NOT NULL AND (ACSTRT IS NULL OR TRIM(ACSTRT) IS NULL)
	UNION ALL
	-- CB-014 | CBAR Total Accounts vs DD + LS + TD (ΑΦΑΙΡΕΘΗΚΑΝ ΤΑ &lt;&gt;'S')
	SELECT 'CB-014', 'CBAR Accounts vs DD+LS+TD total',
		   CAST(ABS((SELECT COUNT(*) FROM DATACUT3."HUB_MT_SS@ACPP") - 
			   ((SELECT COUNT(*) FROM DATACUT3.HUB_MT_DDACMSP) + 
				(SELECT COUNT(*) FROM DATACUT3.HUB_MT_LSACMSP) + 
				(SELECT COUNT(*) FROM DATACUT3.HUB_MT_TDACMSP))) AS NUMBER),
		   CAST(NULL AS VARCHAR2(200)), NULL
	  FROM DUAL
      ) x
    UNION ALL
    SELECT 'CAT-12 REGULATORY - FATCA/CRS/TAX CLASSIFICATION' AS dq_category, x.check_id, x.check_name, x.result_num, x.result_txt, x.expected
      FROM (
	-- TX-001 | US Persons (FATCA) Count – SSCTXPP  (CTTXRG = 'US' or CTOINF = 'Y')
	SELECT 'TX-001' AS check_id, 'US Persons (FATCA) Count: SSCTXPP' AS check_name,
		   COUNT(*) AS RESULT_NUM, CAST(NULL AS VARCHAR2(200)) AS RESULT_TXT, CAST(NULL AS NUMBER) AS EXPECTED
	  FROM DATACUT3.HUB_MT_SSCTXPP
	 WHERE CTTXRG = 'US' OR CTOINF = 'Y'
	UNION ALL
	-- TX-002 | CRS Reportable Persons by Country – SSCTXPP  (CTTCCO)
	SELECT 'TX-002' AS check_id, 'CRS Reportable Persons by Country: SSCTXPP (CTTCCO)' AS check_name,
		   COUNT(*) AS RESULT_NUM, NVL(CTTCCO,'[NULL]') AS RESULT_TXT, CAST(NULL AS NUMBER) AS EXPECTED
	  FROM DATACUT3.HUB_MT_SSCTXPP
	 WHERE CTTCCO IS NOT NULL AND CTTCCO &lt;&gt; 'MT'
	 GROUP BY CTTCCO
	UNION ALL
	-- TX-002 | [sentinel – no data guard]
	SELECT 'TX-002' AS check_id, 'CRS Reportable Persons by Country: SSCTXPP (CTTCCO)' AS check_name,
		   0 AS RESULT_NUM, CAST(NULL AS VARCHAR2(200)) AS RESULT_TXT,
		   CAST(NULL AS NUMBER) AS EXPECTED
	  FROM DUAL
	 WHERE NOT EXISTS (SELECT 1 FROM DATACUT3.HUB_MT_SSCTXPP
	 WHERE CTTCCO IS NOT NULL AND CTTCCO &lt;&gt; 'MT')
	UNION ALL
	-- TX-003 | Undocumented Customer Status Count – SSCTXPP  (CTTXCS)
	SELECT 'TX-003' AS check_id, 'Undocumented Status Count: SSCTXPP (CTTXCS)' AS check_name,
		   COUNT(*) AS RESULT_NUM, NVL(CTTXCS,'[NULL]') AS RESULT_TXT, CAST(NULL AS NUMBER) AS EXPECTED
	  FROM DATACUT3.HUB_MT_SSCTXPP
	 WHERE CTTXCS IN ('U', 'UNDOC', 'UNDOCUMENTED')
	 GROUP BY CTTXCS
	UNION ALL
	-- TX-003 | [sentinel – no data guard]
	SELECT 'TX-003' AS check_id, 'Undocumented Status Count: SSCTXPP (CTTXCS)' AS check_name,
		   0 AS RESULT_NUM, CAST(NULL AS VARCHAR2(200)) AS RESULT_TXT,
		   CAST(NULL AS NUMBER) AS EXPECTED
	  FROM DUAL
	 WHERE NOT EXISTS (SELECT 1 FROM DATACUT3.HUB_MT_SSCTXPP
	 WHERE CTTXCS IN ('U', 'UNDOC', 'UNDOCUMENTED'))
	UNION ALL
	-- TX-004 | Self-Certification Coverage % – SSCTXPP  (CTSFDT)
	SELECT 'TX-004' AS check_id, 'Self-Certification Coverage %: SSCTXPP (CTSFDT)' AS check_name,
		   ROUND(
			 (SELECT COUNT(*) FROM DATACUT3.HUB_MT_SSCTXPP WHERE CTSFDT IS NOT NULL) * 100.0 /
			 NULLIF((SELECT COUNT(*) FROM DATACUT3.HUB_MT_SSCTXPP), 0)
		   , 2) AS RESULT_NUM,
		   CAST(NULL AS VARCHAR2(200)) AS RESULT_TXT,
		   CAST(NULL AS NUMBER) AS EXPECTED
	  FROM DUAL
	UNION ALL
	-- TX-005 | Enhanced Review Started but not Completed – SSCTXPP  (CTDPRN / CTDPRI)
	SELECT 'TX-005' AS check_id, 'Enhanced Review incomplete: SSCTXPP (CTDPRN/CTDPRI)' AS check_name,
		   COUNT(*) AS RESULT_NUM, CAST(NULL AS VARCHAR2(200)) AS RESULT_TXT, CAST(NULL AS NUMBER) AS EXPECTED
	  FROM DATACUT3.HUB_MT_SSCTXPP
	 WHERE CTDPRN = 'Y' AND NVL(CTDPRI, 'N') &lt;&gt; 'Y'
	UNION ALL
	-- TX-006 | NULL Taxpayer Reference – SS@ICIP  (LCTXRF)
	SELECT 'TX-006' AS check_id, 'NULL TIN LCTXRF: SS@ICIP' AS check_name,
		   COUNT(*) AS RESULT_NUM, CAST(NULL AS VARCHAR2(200)) AS RESULT_TXT, CAST(NULL AS NUMBER) AS EXPECTED
	  FROM DATACUT3."HUB_MT_SS@ICIP"
	 WHERE LCMDFL &lt;&gt; 'S' AND (LCTXRF IS NULL OR TRIM(LCTXRF) = '')
	UNION ALL
	-- TX-007 | Manual Override without Reason Code – SSCTXPP  (CTMNFL / CTCLRN)
	SELECT 'TX-007' AS check_id, 'Manual Override without Reason CTMNFL: SSCTXPP' AS check_name,
		   COUNT(*) AS RESULT_NUM, CAST(NULL AS VARCHAR2(200)) AS RESULT_TXT, CAST(NULL AS NUMBER) AS EXPECTED
	  FROM DATACUT3.HUB_MT_SSCTXPP
	 WHERE CTMNFL = 'Y'
	   AND (CTCLRN IS NULL OR TRIM(CTCLRN) = '')
	UNION ALL
	-- TX-008 | Tax Document Coverage % – SSTXDPP / SSCUSTP  (TDDCB + TDDCS)
	SELECT 'TX-008' AS check_id, 'Tax Document Coverage %: SSTXDPP' AS check_name,
		   ROUND(
			 (SELECT COUNT(DISTINCT TDDCS) FROM DATACUT3.HUB_MT_SSTXDPP) * 100.0 /
			 NULLIF((SELECT COUNT(*) FROM DATACUT3.HUB_MT_SSCUSTP WHERE ZGMDFL &lt;&gt; 'S'), 0)
		   , 2) AS RESULT_NUM,
		   CAST(NULL AS VARCHAR2(200)) AS RESULT_TXT,
		   CAST(NULL AS NUMBER) AS EXPECTED
	  FROM DUAL
	UNION ALL
	-- TX-009 | Tax Regime Distribution – SSCTXPP  (CTTXRG)
	SELECT 'TX-009' AS check_id, 'Tax Regime Distribution: SSCTXPP (CTTXRG)' AS check_name,
		   COUNT(*) AS RESULT_NUM, NVL(CTTXRG, '[NULL]') AS RESULT_TXT, CAST(NULL AS NUMBER) AS EXPECTED
	  FROM DATACUT3.HUB_MT_SSCTXPP
	 GROUP BY CTTXRG
	UNION ALL
	-- TX-009 | [sentinel – no data guard]
	SELECT 'TX-009' AS check_id, 'Tax Regime Distribution: SSCTXPP (CTTXRG)' AS check_name,
		   0 AS RESULT_NUM, CAST(NULL AS VARCHAR2(200)) AS RESULT_TXT,
		   CAST(NULL AS NUMBER) AS EXPECTED
	  FROM DUAL
	 WHERE NOT EXISTS (SELECT 1 FROM DATACUT3.HUB_MT_SSCTXPP)
	UNION ALL
	-- TX-010 | Tax Classification Valid-From not populated for classified customers
	SELECT 'TX-010' AS check_id, 'NULL Valid-From for classified: SSCTXPP (CTTVFD)' AS check_name,
		   COUNT(*) AS RESULT_NUM, CAST(NULL AS VARCHAR2(200)) AS RESULT_TXT, CAST(NULL AS NUMBER) AS EXPECTED
	  FROM DATACUT3.HUB_MT_SSCTXPP
	 WHERE CTTXCS IS NOT NULL AND CTTXCS NOT IN ('U', '') AND CTTVFD IS NULL
	UNION ALL
	-- TX-011 | SI Indicia Flag Distribution – SSCTXPP  (CTSIDF)
	SELECT 'TX-011' AS check_id, 'SI Indicia Flag Distribution: SSCTXPP (CTSIDF)' AS check_name,
		   COUNT(*) AS RESULT_NUM, NVL(CTSIDF, '[NULL]') AS RESULT_TXT, CAST(NULL AS NUMBER) AS EXPECTED
	  FROM DATACUT3.HUB_MT_SSCTXPP
	 GROUP BY CTSIDF
	UNION ALL
	-- TX-011 | [sentinel – no data guard]
	SELECT 'TX-011' AS check_id, 'SI Indicia Flag Distribution: SSCTXPP (CTSIDF)' AS check_name,
		   0 AS RESULT_NUM, CAST(NULL AS VARCHAR2(200)) AS RESULT_TXT,
		   CAST(NULL AS NUMBER) AS EXPECTED
	  FROM DUAL
	 WHERE NOT EXISTS (SELECT 1 FROM DATACUT3.HUB_MT_SSCTXPP)
	UNION ALL
	-- TX-012 | High Value Customers as Undocumented – SSCTXPP  (CTHLVI / CTTXCS)
	SELECT 'TX-012' AS check_id, 'High Value Customers Undocumented: SSCTXPP (CTHLVI)' AS check_name,
		   COUNT(*) AS RESULT_NUM, CAST(NULL AS VARCHAR2(200)) AS RESULT_TXT, CAST(NULL AS NUMBER) AS EXPECTED
	  FROM DATACUT3.HUB_MT_SSCTXPP
	 WHERE CTHLVI = 'H' AND CTTXCS IN ('U', 'UNDOC')
	UNION ALL
	-- TX-013 | Customers without Tax Classification record – SSCUSTP / SSCTXPP
	SELECT 'TX-013' AS check_id, 'Customers without Tax Record: SSCTXPP' AS check_name,
		   COUNT(*) AS RESULT_NUM, CAST(NULL AS VARCHAR2(200)) AS RESULT_TXT, CAST(NULL AS NUMBER) AS EXPECTED
	  FROM DATACUT3.HUB_MT_SSCUSTP c
	 WHERE c.ZGMDFL &lt;&gt; 'S'
	   AND NOT EXISTS (SELECT 1 FROM DATACUT3.HUB_MT_SSCTXPP t
						WHERE t.CTDCB = c.ZGDCB AND t.CTDCS = c.ZGDCS)
      ) x
    UNION ALL
    SELECT 'CAT-13 AML/CDD/BLACKLIST' AS dq_category, x.check_id, x.check_name, x.result_num, x.result_txt, x.expected
      FROM (
-- AML-001 | Overdue CDD Reviews [FIXED FOR NATIVE DATE COMPARE]
SELECT 'AML-001' AS check_id, 'Overdue CDD Reviews: SSCDDMP (CMCEYD)' AS check_name,
	   CAST(COUNT(*) AS NUMBER) AS RESULT_NUM, CAST(NULL AS VARCHAR2(200)) AS RESULT_TXT, CAST(NULL AS NUMBER) AS EXPECTED
  FROM DATACUT3.HUB_MT_SSCDDMP
 WHERE CMCEYD IS NOT NULL 
   AND CMCEYD &lt; TRUNC(DATE '2026-06-15')
UNION ALL
-- AML-002 | High-Risk without 12-month Review [FIXED FOR NATIVE DATE COMPARE]
SELECT 'AML-002', 'High-Risk without 12-month Review: SSCDDMP (CMCLDR)',
