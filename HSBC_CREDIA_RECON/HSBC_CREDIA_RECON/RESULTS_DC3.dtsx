	UNION ALL
	-- RC-023 | Row Count: LS Payment History (LSPMHSP)  – no mode_flag
	SELECT 'RC-023' AS check_id, 'Row Count: LS Payment History' AS check_name,
		   COUNT(*) AS RESULT_NUM, CAST(NULL AS VARCHAR2(200)) AS RESULT_TXT, 941315 AS EXPECTED
