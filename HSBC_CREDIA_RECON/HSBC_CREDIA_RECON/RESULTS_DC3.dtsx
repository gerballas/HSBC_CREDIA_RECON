    SELECT 'CAT-15 E-BANKING &amp; DIGITAL CHANNELS' AS dq_category, x.check_id, x.check_name, x.result_num, x.result_txt, x.expected
      FROM (
-- EB-001 | E-Banking Customer Coverage % vs Total Customers
SELECT 'EB-001' AS check_id, 'E-Banking Customer Coverage %' AS check_name,
