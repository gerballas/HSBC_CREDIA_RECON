		   CASE
			   WHEN SUM(cnt) IS NULL THEN 'NO DUPLICATES'
			   ELSE LISTAGG(txt, ', ') WITHIN GROUP (ORDER BY txt)
		   END AS RESULT_TXT,
		   CAST(NULL AS NUMBER) AS EXPECTED
	FROM (
