		FROM DATACUT3.HUB_MT_SSNICIP
		GROUP BY XUDCB, XUDCS
		HAVING COUNT(*) &gt; 1
	)
	UNION ALL
	-- DU-012 | Duplicate Business Register Entry – FN@BRGP  (FNIDNO)
	SELECT 'DU-012' AS check_id, 'Duplicate Biz Register Entry FNIDNO: FN@BRGP' AS check_name,
