                <component
                  refId="Package\RESULTS_DC3\DQC300\DQC_300"
                  componentClassID="Microsoft.SSISOracleSrc"
                  contactInfo="Oracle Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;1"
                  description="Oracle Source"
                  name="DQC_300"
                  usesDispositions="true"
                  version="1">
                  <properties>
                    <property
                      dataType="System.String"
                      description="The name of the table to be fetched."
                      expressionType="Notify"
                      name="TableName"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      expressionType="Notify"
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">SELECT
    CAST('ME01_HUB_DQC300' AS NVARCHAR2(50))   AS DQ_TYPE,
    CAST(y.dq_category AS NVARCHAR2(100))       AS DQ_CATEGORY,
    CAST(y.check_name  AS NVARCHAR2(500))      AS CHECK_NAME,
    CAST(NULL AS NVARCHAR2(100))               AS TABLE_NAME,
    CAST(NULL AS NUMBER)                       AS FAILED_RECORDS,
    CAST(y.result_num AS NUMBER)               AS TOTAL_RECORDS,
    CAST(NULL AS NUMBER)                       AS FAILURE_PCT,
    CAST(y.check_id AS NVARCHAR2(20))          AS CHECK_ID,
    CAST(y.result_num AS NUMBER(20,2))         AS RESULT_NUM,
    CAST(y.result_txt AS NVARCHAR2(2000))       AS RESULT_TXT,
    CAST(y.expected AS NUMBER(20,2))           AS EXPECTED,
    CAST(
        CASE
            WHEN y.expected IS NOT NULL
              THEN CASE WHEN ABS(y.result_num - y.expected) * 100.0 / NULLIF(y.expected, 0) &lt;= 0.1
                        THEN 'PASS' ELSE 'REVIEW' END
            WHEN y.result_txt IS NULL
              THEN CASE WHEN y.result_num = 0 THEN 'PASS' ELSE 'FAIL' END
            ELSE 'INFO'
        END AS NVARCHAR2(20)
    ) AS DQ_STATUS
FROM (
    SELECT 'CAT-01 ROW COUNT &amp; VOLUME RECONCILIATION' AS dq_category, x.check_id, x.check_name, x.result_num, x.result_txt, x.expected
      FROM (
	-- RC-001 | Row Count: Customer Master (SSCUSTP)
	SELECT 'RC-001' AS check_id, 'Row Count: Customer Master' AS check_name,
		   COUNT(*) AS RESULT_NUM, CAST(NULL AS VARCHAR2(200)) AS RESULT_TXT, 212152 AS EXPECTED
	  FROM DATACUT3.HUB_MT_SSCUSTP
	UNION ALL
	-- RC-002 | Row Count: Individual Customer Info (SSINCIP)
	SELECT 'RC-002' AS check_id, 'Row Count: Individual Customer Info' AS check_name,
		   COUNT(*) AS RESULT_NUM, CAST(NULL AS VARCHAR2(200)) AS RESULT_TXT, 172519 AS EXPECTED
	  FROM DATACUT3.HUB_MT_SSINCIP
	UNION ALL
	-- RC-003 | Row Count: Non-Individual Customer (SSNICIP)
	SELECT 'RC-003' AS check_id, 'Row Count: Non-Individual Customer' AS check_name,
		   COUNT(*) AS RESULT_NUM, CAST(NULL AS VARCHAR2(200)) AS RESULT_TXT, 8475 AS EXPECTED
	  FROM DATACUT3.HUB_MT_SSNICIP
	UNION ALL
	-- RC-004 | Row Count: Demand Deposit Accounts (DDACMSP)
	SELECT 'RC-004' AS check_id, 'Row Count: Demand Deposit Accounts' AS check_name,
		   COUNT(*) AS RESULT_NUM, CAST(NULL AS VARCHAR2(200)) AS RESULT_TXT, 289106 AS EXPECTED
	  FROM DATACUT3.HUB_MT_DDACMSP
	UNION ALL
	-- RC-005 | Row Count: Loans Account Master (LSACMSP)
	SELECT 'RC-005' AS check_id, 'Row Count: Loans Account Master' AS check_name,
		   COUNT(*) AS RESULT_NUM, CAST(NULL AS VARCHAR2(200)) AS RESULT_TXT, 31506 AS EXPECTED
	  FROM DATACUT3.HUB_MT_LSACMSP
	UNION ALL
	-- RC-006 | Row Count: Term Deposits Master (TDACMSP)
	SELECT 'RC-006' AS check_id, 'Row Count: Term Deposits Master' AS check_name,
		   COUNT(*) AS RESULT_NUM, CAST(NULL AS VARCHAR2(200)) AS RESULT_TXT, 29678 AS EXPECTED
	  FROM DATACUT3.HUB_MT_TDACMSP
	UNION ALL
	-- RC-007 | Row Count: Customer Address File (SSADDRP)
	SELECT 'RC-007' AS check_id, 'Row Count: Customer Address File' AS check_name,
		   COUNT(*) AS RESULT_NUM, CAST(NULL AS VARCHAR2(200)) AS RESULT_TXT, 422062 AS EXPECTED
	  FROM DATACUT3.HUB_MT_SSADDRP
	UNION ALL
	-- RC-008 | Row Count: CBAR Accounts (SS@ACPP)
	SELECT 'RC-008' AS check_id, 'Row Count: CBAR Accounts' AS check_name,
		   COUNT(*) AS RESULT_NUM, CAST(NULL AS VARCHAR2(200)) AS RESULT_TXT, 740702 AS EXPECTED
	  FROM DATACUT3."HUB_MT_SS@ACPP"
	UNION ALL
	-- RC-009 | Row Count: CBAR Involved Parties (SS@IPPP)
	SELECT 'RC-009' AS check_id, 'Row Count: CBAR Involved Parties' AS check_name,
		   COUNT(*) AS RESULT_NUM, CAST(NULL AS VARCHAR2(200)) AS RESULT_TXT, 212155 AS EXPECTED
