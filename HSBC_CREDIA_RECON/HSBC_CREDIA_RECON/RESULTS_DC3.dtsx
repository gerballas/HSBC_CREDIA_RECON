      ) x
    UNION ALL
    SELECT 'CAT-HIE-02 MODE FLAG &amp; SHADOW RECORD VALIDATION' AS dq_category, x.check_id, x.check_name, x.result_num, x.result_txt, x.expected
      FROM (
-- HIE-MF-001 | Mode Flag Distribution — IPDCMSP (IHMDFL)
SELECT 'HIE-MF-001' AS check_id, 'Mode Flag Distribution: IPDCMSP (IHMDFL)' AS check_name,
       COUNT(*) AS RESULT_NUM, NVL(IHMDFL,'[BLANK]') AS RESULT_TXT, CAST(NULL AS NUMBER) AS EXPECTED
  FROM DATACUT3.HIE_IPDCMSP GROUP BY IHMDFL
UNION ALL
-- HIE-MF-002 | Invalid Mode Flag — IPDCMSP
SELECT 'HIE-MF-002', 'Invalid Mode Flag: IPDCMSP',
       COUNT(*), CAST(NULL AS VARCHAR2(200)), CAST(NULL AS NUMBER)
  FROM DATACUT3.HIE_IPDCMSP
 WHERE IHMDFL NOT IN ('P','S') AND IHMDFL IS NOT NULL
UNION ALL
-- HIE-MF-003 | Shadow Record Ratio % — IPDCMSP (INFO)
SELECT 'HIE-MF-003', 'Shadow Record Ratio %: IPDCMSP',
       ROUND(SUM(CASE WHEN IHMDFL='S' THEN 1 ELSE 0 END)*100.0/NULLIF(COUNT(*),0),2),
       CAST(NULL AS VARCHAR2(200)), CAST(NULL AS NUMBER)
  FROM DATACUT3.HIE_IPDCMSP
UNION ALL
-- HIE-MF-004 | Mode Flag Distribution — IPACMSP (IGMDFL)
SELECT 'HIE-MF-004', 'Mode Flag Distribution: IPACMSP (IGMDFL)',
       COUNT(*), NVL(IGMDFL,'[BLANK]'), CAST(NULL AS NUMBER)
  FROM DATACUT3.HIE_IPACMSP GROUP BY IGMDFL
UNION ALL
-- HIE-MF-005 | Invalid Mode Flag — IPACMSP
SELECT 'HIE-MF-005', 'Invalid Mode Flag: IPACMSP',
       COUNT(*), CAST(NULL AS VARCHAR2(200)), CAST(NULL AS NUMBER)
  FROM DATACUT3.HIE_IPACMSP
 WHERE IGMDFL NOT IN ('P','S') AND IGMDFL IS NOT NULL
UNION ALL
-- HIE-MF-006 | Mode Flag Distribution — IPLNMSP (ILMDFL)
SELECT 'HIE-MF-006', 'Mode Flag Distribution: IPLNMSP (ILMDFL)',
       COUNT(*), NVL(ILMDFL,'[BLANK]'), CAST(NULL AS NUMBER)
  FROM DATACUT3.HIE_IPLNMSP GROUP BY ILMDFL
UNION ALL
-- HIE-MF-007 | Invalid Mode Flag — IPLNMSP
SELECT 'HIE-MF-007', 'Invalid Mode Flag: IPLNMSP',
       COUNT(*), CAST(NULL AS VARCHAR2(200)), CAST(NULL AS NUMBER)
  FROM DATACUT3.HIE_IPLNMSP
 WHERE ILMDFL NOT IN ('P','S') AND ILMDFL IS NOT NULL
UNION ALL
-- HIE-MF-008 | Mode Flag Distribution — IPBLMSP (IIMDFL)
SELECT 'HIE-MF-008', 'Mode Flag Distribution: IPBLMSP (IIMDFL)',
       COUNT(*), NVL(IIMDFL,'[BLANK]'), CAST(NULL AS NUMBER)
  FROM DATACUT3.HIE_IPBLMSP GROUP BY IIMDFL
UNION ALL
-- HIE-MF-009 | Invalid Mode Flag — IPBLMSP
SELECT 'HIE-MF-009', 'Invalid Mode Flag: IPBLMSP',
       COUNT(*), CAST(NULL AS VARCHAR2(200)), CAST(NULL AS NUMBER)
  FROM DATACUT3.HIE_IPBLMSP
 WHERE IIMDFL NOT IN ('P','S') AND IIMDFL IS NOT NULL
UNION ALL
-- HIE-MF-010 | Mode Flag Distribution — EPACMSP (BAMDFL)
SELECT 'HIE-MF-010', 'Mode Flag Distribution: EPACMSP (BAMDFL)',
