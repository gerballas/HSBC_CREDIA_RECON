    SELECT 'CAT-19 DUPLICATE DETECTION' AS dq_category, x.check_id, x.check_name, x.result_num, x.result_txt, x.expected
      FROM (
	-- DU-001 | Duplicate Customer PK – SSCUSTP  (ZGCTCD + ZGDCB + ZGDCS)
	SELECT 'DU-001' AS check_id,
		   'Duplicate Customer PK: SSCUSTP' AS check_name,
		   NVL(SUM(cnt), 0) AS RESULT_NUM,
		   CASE 
			   WHEN SUM(cnt) IS NULL THEN 'NO DUPLICATES'
			   ELSE LISTAGG(txt, ', ') WITHIN GROUP (ORDER BY txt)
		   END AS RESULT_TXT,
		   CAST(NULL AS NUMBER) AS EXPECTED
	FROM (
		SELECT COUNT(*) AS cnt,
			   TO_CHAR(ZGDCB)||':'||TO_CHAR(ZGDCS) AS txt
		FROM DATACUT3.HUB_MT_SSCUSTP
		GROUP BY ZGCTCD, ZGDCB, ZGDCS
		HAVING COUNT(*) &gt; 1
	)
	UNION ALL
	-- DU-002 | Duplicate DD Account PK – DDACMSP  (DFACB + DFACS + DFACX)
	SELECT 'DU-002' AS check_id,
		   'Duplicate DD Account PK: DDACMSP' AS check_name,
		   NVL(SUM(cnt), 0) AS RESULT_NUM,
		   CASE
			   WHEN SUM(cnt) IS NULL THEN 'NO DUPLICATES'
			   ELSE LISTAGG(txt, ', ') WITHIN GROUP (ORDER BY txt)
		   END AS RESULT_TXT,
		   CAST(NULL AS NUMBER) AS EXPECTED
	FROM (
		SELECT COUNT(*) AS cnt,
			   TO_CHAR(DFACB)||':'||TO_CHAR(DFACS)||':'||TO_CHAR(DFACX) AS txt
		FROM DATACUT3.HUB_MT_DDACMSP
		GROUP BY DFACB, DFACS, DFACX
		HAVING COUNT(*) &gt; 1
	)
	UNION ALL
	-- DU-003 | Duplicate Loan PK – LSACMSP  (POACB + POACS)
	SELECT check_id, check_name, COUNT(RESULT_NUM) AS RESULT_NUM, NULL  AS RESULT_TXT, EXPECTED FROM (
	SELECT 'DU-003' AS check_id, 'Duplicate Loan PK: LSACMSP (POACB + POACS)' AS check_name,
		   COUNT(*) AS RESULT_NUM, TO_CHAR(POACB)||':'||TO_CHAR(POACS) AS RESULT_TXT, CAST(NULL AS NUMBER) AS EXPECTED
	  FROM DATACUT3.HUB_MT_LSACMSP --WHERE POMDFL &lt;&gt; 'S'
	 GROUP BY POACB, POACS 
	 HAVING COUNT(*) &gt; 1)
	 GROUP BY check_id, check_name, EXPECTED 
	UNION ALL
	-- DU-004 | Duplicate TD Account PK – TDACMSP  (TDACB + TDACS)
	SELECT check_id, check_name, COUNT(RESULT_NUM) AS RESULT_NUM, NULL  AS RESULT_TXT, EXPECTED FROM (
		SELECT 'DU-004' AS check_id, 'Duplicate TD Account PK: TDACMSP (TDACB + TDACS)' AS check_name,
		   COUNT(*) AS RESULT_NUM, TO_CHAR(TDACB)||':'||TO_CHAR(TDACS) AS RESULT_TXT, CAST(NULL AS NUMBER) AS EXPECTED
		FROM DATACUT3.HUB_MT_TDACMSP --WHERE TDMDFL &lt;&gt; 'S'
		GROUP BY TDACB, TDACS 
		HAVING COUNT(*) &gt; 1)
	GROUP BY check_id, check_name, EXPECTED 
	UNION ALL
	-- DU-005 | Duplicate IBAN – DDIBANP  (IBIBAN)
	SELECT 'DU-005' AS check_id,
		   'Duplicate IBAN IBIBAN: DDIBANP' AS check_name,
		   NVL(SUM(cnt), 0) AS RESULT_NUM,
		   CASE
			   WHEN SUM(cnt) IS NULL THEN 'NO DUPLICATES'
			   ELSE LISTAGG(txt, ', ') WITHIN GROUP (ORDER BY txt)
		   END AS RESULT_TXT,
		   CAST(NULL AS NUMBER) AS EXPECTED
	FROM (
		SELECT COUNT(*) AS cnt,
			   TO_CHAR(IBIBAN) AS txt
		FROM DATACUT3.HUB_MT_DDIBANP
		GROUP BY IBIBAN
		HAVING COUNT(*) &gt; 1
	)
	UNION ALL
	-- DU-006 | Duplicate Standing Instruction Number – AFSIMSP  (FNSINO)
	SELECT check_id, check_name, COUNT(RESULT_NUM) AS RESULT_NUM, NULL  AS RESULT_TXT, EXPECTED FROM (
	SELECT 'DU-006' AS check_id, 'Duplicate S/I Number FNSINO: AFSIMSP (FNSINO)' AS check_name,
