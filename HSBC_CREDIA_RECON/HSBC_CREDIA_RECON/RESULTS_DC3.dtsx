	-- NL-002 | NULL Customer Full Name – SSCUSTP  (ZGCSFN + ZGCSCN)
	SELECT 'NL-002' AS check_id, 
			'NULL Customer Name: SSCUSTP (ZGCSFN/ZGCSCN)' AS check_name,
		   COUNT(*) AS RESULT_NUM, CAST(NULL AS VARCHAR2(200)) AS RESULT_TXT, CAST(NULL AS NUMBER) AS EXPECTED
	  FROM DATACUT3.HUB_MT_SSCUSTP
	 WHERE (ZGCSFN IS NULL OR TRIM(ZGCSFN) = '')
