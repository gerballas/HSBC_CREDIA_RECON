	-- ST-006 | Loan Currency Mix % – LSACMSP  (POCYCD)
	SELECT 'ST-006' AS check_id, 'Loan Currency Mix %: LSACMSP (POCYCD)' AS check_name,
		   ROUND(COUNT(*) * 100.0 / SUM(COUNT(*)) OVER (), 2) AS RESULT_NUM,
		   NVL(POCYCD,'[NULL]') AS RESULT_TXT, CAST(NULL AS NUMBER) AS EXPECTED
	  FROM DATACUT3.HUB_MT_LSACMSP
	 GROUP BY POCYCD
	UNION ALL
	-- ST-007 | PAD Statement File Counts – SS@PDFP / SS@PDRP
	SELECT 'ST-007_1' AS check_id, 'PAD Final Statement Count: SS@PDFP' AS check_name,
		   COUNT(*) AS RESULT_NUM, CAST(NULL AS VARCHAR2(200)) AS RESULT_TXT, 1193663 AS EXPECTED
	  FROM DATACUT3."HUB_MT_SS@PDFP"
	UNION ALL
	-- ST-007 | PAD Statement File Counts – SS@PDFP / SS@PDRP
	SELECT 'ST-007_2' AS check_id, 'PAD Static Statement Count: SS@PDRP' AS check_name,
		   COUNT(*) AS RESULT_NUM, CAST(NULL AS VARCHAR2(200)) AS RESULT_TXT, 276578 AS EXPECTED
	  FROM DATACUT3."HUB_MT_SS@PDRP"
	/*UNION ALL
	-- ST-008 | Credit Application Journal count – SS@CAJP  (CAACS / CADCS)
	SELECT 'ST-008' AS check_id, 'Credit Applications vs Active Loans ratio' AS check_name,
		   ROUND(
			 (SELECT COUNT(*) FROM DATACUT3."HUB_MT_SS@CAJP") * 100.0 /
			 NULLIF((SELECT COUNT(*) FROM DATACUT3.HUB_MT_LSACMSP WHERE POMDFL &lt;&gt; 'S'), 0)
		   , 2) AS RESULT_NUM,
		   CAST(NULL AS VARCHAR2(200)) AS RESULT_TXT,
		   CAST(NULL AS NUMBER) AS EXPECTED
	  FROM DUAL*/
	UNION ALL
	-- ST-009 | Connected Party Consistency – SS@CAIFP / SSCAIFP  (Z@DCB+Z@DCS vs ZUDCB+ZUDCS)
	SELECT 'ST-009' AS check_id, 'Connected Party File Consistency diff' AS check_name,
		   ABS((SELECT COUNT(*) FROM DATACUT3."HUB_MT_SS@CAIFP") - (SELECT COUNT(*) FROM DATACUT3.HUB_MT_SSCAIFP WHERE ZUMDFL &lt;&gt; 'S')) AS RESULT_NUM,
		   CAST(NULL AS VARCHAR2(200)) AS RESULT_TXT,
		   CAST(NULL AS NUMBER) AS EXPECTED
	  FROM DUAL
	UNION ALL
	-- ST-010 | Holds Distribution by Type – SSHOLDP  (X4HDTY)
	SELECT 'ST-010' AS check_id, 'Holds Distribution by Type: SSHOLDP (X4HDTY)' AS check_name,
		   COUNT(*) AS RESULT_NUM, NVL(X4HDTY, '[NULL]') AS RESULT_TXT, CAST(NULL AS NUMBER) AS EXPECTED
	  FROM DATACUT3.HUB_MT_SSHOLDP 
	 GROUP BY X4HDTY
	UNION ALL
	-- ST-011 | VAT Loan Drawdown Count – SS@LDDP  (LDACNO / expected: ~113,084)
	SELECT 'ST-011' AS check_id, 'VAT Loan Drawdown Count: SS@LDDP' AS check_name,
		   COUNT(*) AS RESULT_NUM, CAST(NULL AS VARCHAR2(200)) AS RESULT_TXT, 113084 AS EXPECTED
	  FROM DATACUT3."HUB_MT_SS@LDDP"
	UNION ALL
	-- ST-012 | Forbearance Records Count – SS@FRBP  (FRCTCD / expected: ~1,230)
	SELECT 'ST-012' AS check_id, 'Forbearance Records Count: SS@FRBP' AS check_name,
		   COUNT(*) AS RESULT_NUM, CAST(NULL AS VARCHAR2(200)) AS RESULT_TXT, 1230 AS EXPECTED
	  FROM DATACUT3."HUB_MT_SS@FRBP"
	UNION ALL
	-- ST-013 | DC Interest Control File Count – DCDRICP  (D2MDFL / expected: ~344)
	SELECT 'ST-013' AS check_id, 'DC DR Interest Control Count: DCDRICP' AS check_name,
		   COUNT(*) AS RESULT_NUM, CAST(NULL AS VARCHAR2(200)) AS RESULT_TXT, 344 AS EXPECTED
	  FROM DATACUT3.HUB_MT_DCDRICP 
	UNION ALL
	-- ST-014 | S/I Associated Party Count – AFSIADP  (FRMDFL / expected: ~116)
	SELECT 'ST-014' AS check_id, 'S/I Associated Party Count: AFSIADP' AS check_name,
		   COUNT(*) AS RESULT_NUM, CAST(NULL AS VARCHAR2(200)) AS RESULT_TXT, 116 AS EXPECTED
	  FROM DATACUT3.HUB_MT_AFSIADP
	UNION ALL
	-- ST-015 | BW3 Next Payment Details Count – SS@BMNP  (BWACNO / expected: ~72,381)
	SELECT 'ST-015' AS check_id, 'BW3 Next Payment Details: SS@BMNP' AS check_name,
		   COUNT(*) AS RESULT_NUM, CAST(NULL AS VARCHAR2(200)) AS RESULT_TXT, 72381 AS EXPECTED
	  FROM DATACUT3."HUB_MT_SS@BMNP"
      ) x
    UNION ALL
    SELECT 'CAT-01-DC2 VOLUME RECONCILIATION - DC2 NEW TABLES' AS dq_category, x.check_id, x.check_name, x.result_num, x.result_txt, x.expected
      FROM (
	-- RC-031 | Row Count: LS Overdue Interest Accrual (LSOIACP) — DC2 new
	-- TODO: LSOIACP field names not in DD v1.14 — COUNT(*) only
	SELECT 'RC-031' AS check_id, 'Row Count: LS Overdue Interest Accrual (LSOIACP)' AS check_name,
		   COUNT(*) AS RESULT_NUM, CAST(NULL AS VARCHAR2(200)) AS RESULT_TXT, 1224997 AS EXPECTED
	  FROM DATACUT3.HUB_MT_LSOIACP
	UNION ALL

	-- RC-032 | Row Count: Security Interface File Payment (SSIFPWP) — DC2 new
	-- TODO: SSIFPWP field names not in DD v1.14 — COUNT(*) only
	SELECT 'RC-032', 'Row Count: Security Interface File Payment (SSIFPWP)',
		   COUNT(*), CAST(NULL AS VARCHAR2(200)), 134399
	  FROM DATACUT3.HUB_MT_SSIFPWP
	UNION ALL

	-- RC-033 | Row Count: Security Recurrent Charges (SSRCUSP) — DC2 new
	-- TODO: SSRCUSP field names not in DD v1.14 — COUNT(*) only
	SELECT 'RC-033', 'Row Count: Security Recurrent Charges (SSRCUSP)',
		   COUNT(*), CAST(NULL AS VARCHAR2(200)), 1439
	  FROM DATACUT3.HUB_MT_SSRCUSP
	UNION ALL

	-- RC-034 | Row Count: LS Local Repayment Account (LSRPACP) — DC2 new (PQ-prefix confirmed)
	SELECT 'RC-034', 'Row Count: LS Local Repayment Account (LSRPACP)',
		   COUNT(*), CAST(NULL AS VARCHAR2(200)), 31270
	  FROM DATACUT3.HUB_MT_LSRPACP
      ) x
    UNION ALL
    SELECT 'CAT-17-DC2 PRODUCT CONTROL TABLES - DC2 UPDATED BENCHMARKS' AS dq_category, x.check_id, x.check_name, x.result_num, x.result_txt, x.expected
      FROM (
	-- PC-009-DC2 | Row Count: Interest Rate Table (SSINRTP) — DC2 EXPECTED = 5,214 (DC1 was 5,076 REVIEW +2.72%)
	SELECT 'PC-009-DC2' AS check_id, 'Row Count: Interest Rate Table SSINRTP (DC2 REVIEW)' AS check_name,
		   COUNT(*) AS RESULT_NUM, CAST(NULL AS VARCHAR2(200)) AS RESULT_TXT, 5214 AS EXPECTED
	  FROM DATACUT3.HUB_MT_SSINRTP
	UNION ALL

	-- PC-010a-DC2 | Row Count: Standard Document CP (SSSDCPP) — DC2 EXPECTED = 1,020 (REVIEW +0.20%)
	SELECT 'PC-010a-DC2', 'Row Count: Standard Document CP SSSDCPP (DC2 REVIEW)',
		   COUNT(*), CAST(NULL AS VARCHAR2(200)), 1020
	  FROM DATACUT3.HUB_MT_SSSDCPP
	UNION ALL

	-- PC-010b-DC2 | Row Count: Standard TD Document (SSSTDPP) — DC2 EXPECTED = 66,517 (PASS -0.06%)
	SELECT 'PC-010b-DC2', 'Row Count: Standard TD Document SSSTDPP (DC2 PASS)',
		   COUNT(*), CAST(NULL AS VARCHAR2(200)), 66517
	  FROM DATACUT3.HUB_MT_SSSTDPP
      ) x
) y
ORDER BY y.dq_category, y.check_id;</property>
