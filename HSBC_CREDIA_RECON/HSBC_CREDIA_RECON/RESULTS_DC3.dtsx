	  FROM DATACUT3.HUB_MT_SSCUSTP
	UNION ALL
	SELECT 'RC-030', 'Summary: Key Table Counts',
		   COUNT(*), 'DDACMSP', CAST(NULL AS NUMBER)
	  FROM DATACUT3.HUB_MT_DDACMSP
	UNION ALL
	SELECT 'RC-030', 'Summary: Key Table Counts',
		   COUNT(*), 'LSACMSP', CAST(NULL AS NUMBER)
	  FROM DATACUT3.HUB_MT_LSACMSP
	UNION ALL
	SELECT 'RC-030', 'Summary: Key Table Counts',
		   COUNT(*), 'TDACMSP', CAST(NULL AS NUMBER)
	  FROM DATACUT3.HUB_MT_TDACMSP
	UNION ALL
	SELECT 'RC-030', 'Summary: Key Table Counts',
		   COUNT(*), 'SSINCIP', CAST(NULL AS NUMBER)
	  FROM DATACUT3.HUB_MT_SSINCIP
	UNION ALL
	SELECT 'RC-030', 'Summary: Key Table Counts',
		   COUNT(*), 'SSBKLSP', CAST(NULL AS NUMBER)
	  FROM DATACUT3.HUB_MT_SSBKLSP
	UNION ALL
	SELECT 'RC-030', 'Summary: Key Table Counts',
		   COUNT(*), 'SS@ACPP', CAST(NULL AS NUMBER)
	  FROM DATACUT3."HUB_MT_SS@ACPP"
	UNION ALL
	SELECT 'RC-030', 'Summary: Key Table Counts',
		   COUNT(*), 'SS@IPPP', CAST(NULL AS NUMBER)
	  FROM DATACUT3."HUB_MT_SS@IPPP"
	UNION ALL
	SELECT 'RC-030', 'Summary: Key Table Counts',
		   COUNT(*), 'SSSECHP', CAST(NULL AS NUMBER)
	  FROM DATACUT3.HUB_MT_SSSECHP
