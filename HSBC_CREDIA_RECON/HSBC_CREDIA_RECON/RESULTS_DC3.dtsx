	-- DU-007 | Duplicate CBAR Account Unique IDs – SS@ACPP  (ACUQID)
	SELECT check_id, check_name, COUNT(RESULT_NUM) AS RESULT_NUM, NULL  AS RESULT_TXT, EXPECTED FROM (
	SELECT 'DU-007' AS check_id, 'Duplicate CBAR Unique ID ACUQID: SS@ACPP (ACUQID)' AS check_name,
		   COUNT(*) AS RESULT_NUM, TO_CHAR(ACUQID) AS RESULT_TXT, CAST(NULL AS NUMBER) AS EXPECTED
	  FROM DATACUT3."HUB_MT_SS@ACPP"
	 GROUP BY ACUQID HAVING COUNT(*) &gt; 1)
	GROUP BY check_id, check_name, EXPECTED
	UNION ALL
	-- DU-008 | Duplicate Individual Customer Records – SSINCIP  (ZKDCB + ZKDCS)
	SELECT 'DU-008' AS check_id,
		   'Duplicate Individual Customer: SSINCIP (ZKDCB + ZKDCS)' AS check_name,
		   NVL(SUM(cnt), 0) AS RESULT_NUM,
		   CASE
			   WHEN SUM(cnt) IS NULL THEN 'NO DUPLICATES'
			   ELSE LISTAGG(txt, ', ') WITHIN GROUP (ORDER BY txt)
		   END AS RESULT_TXT,
		   CAST(NULL AS NUMBER) AS EXPECTED
	FROM (
		SELECT COUNT(*) AS cnt,
			   TO_CHAR(ZKDCB)||':'||TO_CHAR(ZKDCS) AS txt
		FROM DATACUT3.HUB_MT_SSINCIP
		GROUP BY ZKDCB, ZKDCS
		HAVING COUNT(*) &gt; 1
	)
	UNION ALL
	-- DU-009 | Duplicate Tax Classification – SSCTXPP  (CTDCB + CTDCS)
	SELECT 'DU-009' AS check_id,
		   'Duplicate Tax Classification: SSCTXPP (CTDCB + CTDCS)' AS check_name,
		   NVL(SUM(cnt), 0) AS RESULT_NUM,
		   CASE
			   WHEN SUM(cnt) IS NULL THEN 'NO DUPLICATES'
			   ELSE LISTAGG(txt, ', ') WITHIN GROUP (ORDER BY txt)
		   END AS RESULT_TXT,
		   CAST(NULL AS NUMBER) AS EXPECTED
	FROM (
