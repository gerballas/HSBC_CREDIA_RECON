	UNION ALL
	-- RC-010 | Row Count: Customer Blacklist (SSBKLSP)
	SELECT 'RC-010' AS check_id, 'Row Count: Customer Blacklist' AS check_name,
		   COUNT(*) AS RESULT_NUM, CAST(NULL AS VARCHAR2(200)) AS RESULT_TXT, 139975 AS EXPECTED
