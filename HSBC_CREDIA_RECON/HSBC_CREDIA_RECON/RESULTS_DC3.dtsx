			   TO_CHAR(CTDCB)||':'||TO_CHAR(CTDCS) AS txt
		FROM DATACUT3.HUB_MT_SSCTXPP
		GROUP BY CTDCB, CTDCS
		HAVING COUNT(*) &gt; 1
	)
	UNION ALL
	-- DU-010 | Duplicate CDD Records – SSCDDMP  (CMDCB + CMDCS)
	SELECT 'DU-010' AS check_id,
		   'Duplicate CDD Record: SSCDDMP (CMDCB + CMDCS)' AS check_name,
		   NVL(SUM(cnt), 0) AS RESULT_NUM,
		   CASE
			   WHEN SUM(cnt) IS NULL THEN 'NO DUPLICATES'
			   ELSE LISTAGG(txt, ', ') WITHIN GROUP (ORDER BY txt)
		   END AS RESULT_TXT,
		   CAST(NULL AS NUMBER) AS EXPECTED
	FROM (
		SELECT COUNT(*) AS cnt,
			   TO_CHAR(CMDCB)||':'||TO_CHAR(CMDCS) AS txt
		FROM DATACUT3.HUB_MT_SSCDDMP
		GROUP BY CMDCB, CMDCS
		HAVING COUNT(*) &gt; 1
	)
	UNION ALL
	-- DU-011 | Duplicate Non-Individual Customer – SSNICIP  (XUDCB + XUDCS)
	SELECT 'DU-011' AS check_id,
		   'Duplicate Non-Individual: SSNICIP (XUDCB + XUDCS)' AS check_name,
