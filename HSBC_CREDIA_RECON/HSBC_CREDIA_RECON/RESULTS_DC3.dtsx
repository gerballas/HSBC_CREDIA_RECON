 WHERE BCMDFL NOT IN ('P','S') AND BCMDFL IS NOT NULL
UNION ALL
-- HIE-MF-014 | Mode Flag Distribution — EPBLMSP (BBMDFL)
SELECT 'HIE-MF-014', 'Mode Flag Distribution: EPBLMSP (BBMDFL)',
