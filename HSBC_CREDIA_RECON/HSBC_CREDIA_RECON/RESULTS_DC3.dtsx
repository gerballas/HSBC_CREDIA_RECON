	UNION ALL
	-- MF-008 | Mode Flag Distribution – SSBKLSP
	SELECT 'MF-008' AS check_id, 'Mode Flag Distribution: SSBKLSP' AS check_name,
		   COUNT(*) AS RESULT_NUM, NVL(V7MDFL, '[BLANK]') AS RESULT_TXT, CAST(NULL AS NUMBER) AS EXPECTED
	  FROM DATACUT3.HUB_MT_SSBKLSP
	 GROUP BY V7MDFL
	UNION ALL
	-- MF-008 | [sentinel – no data guard]
	SELECT 'MF-008' AS check_id, 'Mode Flag Distribution: SSBKLSP' AS check_name,
		   0 AS RESULT_NUM, CAST(NULL AS VARCHAR2(200)) AS RESULT_TXT,
		   CAST(NULL AS NUMBER) AS EXPECTED
	  FROM DUAL
	 WHERE NOT EXISTS (SELECT 1 FROM DATACUT3.HUB_MT_SSBKLSP)
	UNION ALL
	-- MF-009 | Shadow Record Ratio – SSCUSTP  (alert if shadow_pct &gt; 5%)
	SELECT 'MF-009' AS check_id, 'Shadow Record Ratio: SSCUSTP' AS check_name,
		   ROUND(SUM(CASE WHEN ZGMDFL = 'S' THEN 1 ELSE 0 END) * 100.0 / COUNT(*), 2) AS RESULT_NUM, CAST(NULL AS VARCHAR2(200)) AS RESULT_TXT, CAST(NULL AS NUMBER) AS EXPECTED
	  FROM DATACUT3.HUB_MT_SSCUSTP
	UNION ALL
	-- MF-010 | Shadow Record Ratio – DDACMSP
	SELECT 'MF-010' AS check_id, 'Shadow Record Ratio: DDACMSP' AS check_name,
		   ROUND(SUM(CASE WHEN DFMDFL = 'S' THEN 1 ELSE 0 END) * 100.0 / COUNT(*), 2) AS RESULT_NUM, CAST(NULL AS VARCHAR2(200)) AS RESULT_TXT, CAST(NULL AS NUMBER) AS EXPECTED
	  FROM DATACUT3.HUB_MT_DDACMSP
	UNION ALL
	-- MF-011 | Mode Flag Distribution – ORCOMSP
	SELECT 'MF-011' AS check_id, 'Mode Flag Distribution: ORCOMSP' AS check_name,
		   COUNT(*) AS RESULT_NUM, NVL(ORMDFL, '[BLANK]') AS RESULT_TXT, CAST(NULL AS NUMBER) AS EXPECTED
	  FROM DATACUT3.HUB_MT_ORCOMSP
	 GROUP BY ORMDFL
	UNION ALL
	-- MF-011 | [sentinel – no data guard]
	SELECT 'MF-011' AS check_id, 'Mode Flag Distribution: ORCOMSP' AS check_name,
		   0 AS RESULT_NUM, CAST(NULL AS VARCHAR2(200)) AS RESULT_TXT,
		   CAST(NULL AS NUMBER) AS EXPECTED
	  FROM DUAL
	 WHERE NOT EXISTS (SELECT 1 FROM DATACUT3.HUB_MT_ORCOMSP)
	UNION ALL
	-- MF-012 | Mode Flag Distribution – DDSMCPP
	SELECT 'MF-012' AS check_id, 'Mode Flag Distribution: DDSMCPP' AS check_name,
		   COUNT(*) AS RESULT_NUM, NVL(DIMDFL, '[BLANK]') AS RESULT_TXT, CAST(NULL AS NUMBER) AS EXPECTED
	  FROM DATACUT3.HUB_MT_DDSMCPP
	 GROUP BY DIMDFL
	UNION ALL
	-- MF-012 | [sentinel – no data guard]
	SELECT 'MF-012' AS check_id, 'Mode Flag Distribution: DDSMCPP' AS check_name,
		   0 AS RESULT_NUM, CAST(NULL AS VARCHAR2(200)) AS RESULT_TXT,
		   CAST(NULL AS NUMBER) AS EXPECTED
	  FROM DUAL
	 WHERE NOT EXISTS (SELECT 1 FROM DATACUT3.HUB_MT_DDSMCPP)
	UNION ALL
	-- MF-013 | Multi-Table Shadow Summary
	SELECT 'MF-013' AS check_id, 'Multi-Table Shadow Summary' AS check_name,
		   SUM(CASE WHEN ZGMDFL &lt;&gt; 'S' THEN 1 ELSE 0 END) AS RESULT_NUM,
		   'SSCUSTP' AS RESULT_TXT,
		   CAST(NULL AS NUMBER) AS EXPECTED
	  FROM DATACUT3.HUB_MT_SSCUSTP
	UNION ALL
	SELECT 'MF-013', 'Multi-Table Shadow Summary',
		   SUM(CASE WHEN DFMDFL &lt;&gt; 'S' THEN 1 ELSE 0 END),
		   'DDACMSP',
		   CAST(NULL AS NUMBER)
	  FROM DATACUT3.HUB_MT_DDACMSP
	UNION ALL
	SELECT 'MF-013', 'Multi-Table Shadow Summary',
		   SUM(CASE WHEN POMDFL &lt;&gt; 'S' THEN 1 ELSE 0 END),
		   'LSACMSP',
		   CAST(NULL AS NUMBER)
	  FROM DATACUT3.HUB_MT_LSACMSP
	UNION ALL
	SELECT 'MF-013', 'Multi-Table Shadow Summary',
		   SUM(CASE WHEN TDMDFL &lt;&gt; 'S' THEN 1 ELSE 0 END),
		   'TDACMSP',
		   CAST(NULL AS NUMBER)
	  FROM DATACUT3.HUB_MT_TDACMSP
      ) x
    UNION ALL
    SELECT 'CAT-03 MANDATORY FIELDS - NULL/BLANK CHECKS' AS dq_category, x.check_id, x.check_name, x.result_num, x.result_txt, x.expected
      FROM (
	-- NL-001 | NULL Primary Key – SSCUSTP  (ZGCTCD + ZGDCB + ZGDCS)
	SELECT 'NL-001' AS check_id, 'NULL PK: SSCUSTP (ZGCTCD/ZGDCB/ZGDCS)' AS check_name,
		   COUNT(*) AS RESULT_NUM, CAST(NULL AS VARCHAR2(200)) AS RESULT_TXT, CAST(NULL AS NUMBER) AS EXPECTED
	  FROM DATACUT3.HUB_MT_SSCUSTP
	 WHERE ZGCTCD IS NULL OR ZGDCB IS NULL OR ZGDCS IS NULL
