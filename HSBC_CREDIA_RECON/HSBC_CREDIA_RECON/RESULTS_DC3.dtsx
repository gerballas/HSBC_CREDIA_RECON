    UNION ALL
    SELECT 'CAT-02 MODE FLAG &amp; SELECTION CRITERIA VALIDATION' AS dq_category, x.check_id, x.check_name, x.result_num, x.result_txt, x.expected
      FROM (
	-- MF-001 | Mode Flag Distribution – SSCUSTP
	SELECT 'MF-001' AS check_id, 'Mode Flag Distribution: SSCUSTP' AS check_name,
		   COUNT(*) AS RESULT_NUM, NVL(ZGMDFL, '[BLANK]') AS RESULT_TXT, CAST(NULL AS NUMBER) AS EXPECTED
	  FROM DATACUT3.HUB_MT_SSCUSTP
	 GROUP BY ZGMDFL
	UNION ALL
	-- MF-001 | [sentinel – no data guard]
	SELECT 'MF-001' AS check_id, 'Mode Flag Distribution: SSCUSTP' AS check_name,
		   0 AS RESULT_NUM, CAST(NULL AS VARCHAR2(200)) AS RESULT_TXT,
		   CAST(NULL AS NUMBER) AS EXPECTED
	  FROM DUAL
	 WHERE NOT EXISTS (SELECT 1 FROM DATACUT3.HUB_MT_SSCUSTP)
	UNION ALL
	-- MF-002 | Invalid Mode Flag Values – SSCUSTP
	SELECT 'MF-002' AS check_id, 'Invalid Mode Flag: SSCUSTP' AS check_name,
		   COUNT(*) AS RESULT_NUM, CAST(NULL AS VARCHAR2(200)) AS RESULT_TXT, CAST(NULL AS NUMBER) AS EXPECTED
	  FROM DATACUT3.HUB_MT_SSCUSTP
	 WHERE ZGMDFL NOT IN ('P', 'S') AND ZGMDFL IS NOT NULL
	UNION ALL
	-- MF-003 | Mode Flag Distribution – DDACMSP
	SELECT 'MF-003' AS check_id, 'Mode Flag Distribution: DDACMSP' AS check_name,
		   COUNT(*) AS RESULT_NUM, NVL(DFMDFL, '[BLANK]') AS RESULT_TXT, CAST(NULL AS NUMBER) AS EXPECTED
	  FROM DATACUT3.HUB_MT_DDACMSP
	 GROUP BY DFMDFL
	UNION ALL
	-- MF-003 | [sentinel – no data guard]
	SELECT 'MF-003' AS check_id, 'Mode Flag Distribution: DDACMSP' AS check_name,
		   0 AS RESULT_NUM, CAST(NULL AS VARCHAR2(200)) AS RESULT_TXT,
		   CAST(NULL AS NUMBER) AS EXPECTED
	  FROM DUAL
	 WHERE NOT EXISTS (SELECT 1 FROM DATACUT3.HUB_MT_DDACMSP)
	UNION ALL
	-- MF-004 | Mode Flag Distribution – LSACMSP  (field: POMDFL)
	SELECT 'MF-004' AS check_id, 'Mode Flag Distribution: LSACMSP' AS check_name,
		   COUNT(*) AS RESULT_NUM, NVL(POMDFL, '[BLANK]') AS RESULT_TXT, CAST(NULL AS NUMBER) AS EXPECTED
	  FROM DATACUT3.HUB_MT_LSACMSP
	 GROUP BY POMDFL
	UNION ALL
	-- MF-004 | [sentinel – no data guard]
	SELECT 'MF-004' AS check_id, 'Mode Flag Distribution: LSACMSP' AS check_name,
		   0 AS RESULT_NUM, CAST(NULL AS VARCHAR2(200)) AS RESULT_TXT,
		   CAST(NULL AS NUMBER) AS EXPECTED
	  FROM DUAL
	 WHERE NOT EXISTS (SELECT 1 FROM DATACUT3.HUB_MT_LSACMSP)
	UNION ALL
	-- MF-005 | Mode Flag Distribution – TDACMSP
	SELECT 'MF-005' AS check_id, 'Mode Flag Distribution: TDACMSP' AS check_name,
		   COUNT(*) AS RESULT_NUM, NVL(TDMDFL, '[BLANK]') AS RESULT_TXT, CAST(NULL AS NUMBER) AS EXPECTED
	  FROM DATACUT3.HUB_MT_TDACMSP
	 GROUP BY TDMDFL
	UNION ALL
	-- MF-005 | [sentinel – no data guard]
	SELECT 'MF-005' AS check_id, 'Mode Flag Distribution: TDACMSP' AS check_name,
		   0 AS RESULT_NUM, CAST(NULL AS VARCHAR2(200)) AS RESULT_TXT,
		   CAST(NULL AS NUMBER) AS EXPECTED
	  FROM DUAL
	 WHERE NOT EXISTS (SELECT 1 FROM DATACUT3.HUB_MT_TDACMSP)
	UNION ALL
	-- MF-006 | Mode Flag Distribution – SSINCIP
	SELECT 'MF-006' AS check_id, 'Mode Flag Distribution: SSINCIP' AS check_name,
		   COUNT(*) AS RESULT_NUM, NVL(ZKMDFL, '[BLANK]') AS RESULT_TXT, CAST(NULL AS NUMBER) AS EXPECTED
	  FROM DATACUT3.HUB_MT_SSINCIP
	 GROUP BY ZKMDFL
	UNION ALL
	-- MF-006 | [sentinel – no data guard]
	SELECT 'MF-006' AS check_id, 'Mode Flag Distribution: SSINCIP' AS check_name,
		   0 AS RESULT_NUM, CAST(NULL AS VARCHAR2(200)) AS RESULT_TXT,
		   CAST(NULL AS NUMBER) AS EXPECTED
	  FROM DUAL
	 WHERE NOT EXISTS (SELECT 1 FROM DATACUT3.HUB_MT_SSINCIP)
	UNION ALL
	-- MF-007 | Mode Flag Distribution – AFSIMSP
	SELECT 'MF-007' AS check_id, 'Mode Flag Distribution: AFSIMSP' AS check_name,
		   COUNT(*) AS RESULT_NUM, NVL(FNMDFL, '[BLANK]') AS RESULT_TXT, CAST(NULL AS NUMBER) AS EXPECTED
	  FROM DATACUT3.HUB_MT_AFSIMSP
	 GROUP BY FNMDFL
	UNION ALL
	-- MF-007 | [sentinel – no data guard]
	SELECT 'MF-007' AS check_id, 'Mode Flag Distribution: AFSIMSP' AS check_name,
		   0 AS RESULT_NUM, CAST(NULL AS VARCHAR2(200)) AS RESULT_TXT,
		   CAST(NULL AS NUMBER) AS EXPECTED
	  FROM DUAL
