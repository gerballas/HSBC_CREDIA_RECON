	UNION ALL
	-- RC-026 | Row Count: DD Cheque Book (DDCQBKP)
	SELECT 'RC-026' AS check_id, 'Row Count: DD Cheque Book' AS check_name,
		   COUNT(*) AS RESULT_NUM, CAST(NULL AS VARCHAR2(200)) AS RESULT_TXT, 3231325 AS EXPECTED
	  FROM DATACUT3.HUB_MT_DDCQBKP
	UNION ALL
	-- RC-027 | Row Count: LS Irregular Repayment Schedule (LSILRSP)
	SELECT 'RC-027' AS check_id, 'Row Count: LS Irregular Repayment Schedule' AS check_name,
		   COUNT(*) AS RESULT_NUM, CAST(NULL AS VARCHAR2(200)) AS RESULT_TXT, 74204 AS EXPECTED
	  FROM DATACUT3.HUB_MT_LSILRSP
	UNION ALL
	-- RC-028 | Row Count: IB Account ID File (IBACIDP)
	SELECT 'RC-028' AS check_id, 'Row Count: IB Account ID File' AS check_name,
		   COUNT(*) AS RESULT_NUM, CAST(NULL AS VARCHAR2(200)) AS RESULT_TXT, 329919 AS EXPECTED
	  FROM DATACUT3.HUB_MT_IBACIDP
	UNION ALL
	-- RC-029 | Row Count: Demand Credit Master – Overdrafts (DCACMSP)
	SELECT 'RC-029' AS check_id, 'Row Count: Demand Credit Master (OD)' AS check_name,
