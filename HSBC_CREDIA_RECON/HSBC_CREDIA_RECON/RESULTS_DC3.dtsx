	-- RC-012 | Row Count: Standing Instructions Master (AFSIMSP)
	SELECT 'RC-012' AS check_id, 'Row Count: S/I Master' AS check_name,
		   COUNT(*) AS RESULT_NUM, CAST(NULL AS VARCHAR2(200)) AS RESULT_TXT, 30966 AS EXPECTED
	  FROM DATACUT3.HUB_MT_AFSIMSP
	UNION ALL
	-- RC-013 | Row Count: SEPA ACH Direct Debit (EUDTSDDP)
	SELECT 'RC-013' AS check_id, 'Row Count: SEPA ACH Direct Debit' AS check_name,
		   COUNT(*) AS RESULT_NUM, CAST(NULL AS VARCHAR2(200)) AS RESULT_TXT, 222429 AS EXPECTED
	  FROM DATACUT3.HUB_MT_EUDTSDDP
	UNION ALL
	-- RC-014 | Row Count: Loan Repayment History Schedule (LSRHSLP)
	SELECT 'RC-014' AS check_id, 'Row Count: LS Repayment History Schedule' AS check_name,
		   COUNT(*) AS RESULT_NUM, CAST(NULL AS VARCHAR2(200)) AS RESULT_TXT, 2931191 AS EXPECTED
