  FROM DATACUT3.ME13_FUNDMAN
 WHERE NVL(Amnt1,0) &lt; 0
UNION ALL
-- DC13-FN-005 | Negative life assurance amount (Amnt1): LIFEASSURE
SELECT 'DC13-FN-005', 'Negative Life Assurance Amount (Amnt1): ME13_LIFEASSURE',
       COUNT(*), CAST(NULL AS VARCHAR2(200)), CAST(NULL AS NUMBER)
  FROM DATACUT3.ME13_LIFEASSURE
 WHERE NVL(Amnt1,0) &lt; 0
UNION ALL
-- DC13-FN-006 | Negative privilege bill amount: PRIVBILL
SELECT 'DC13-FN-006', 'Negative Amount: ME13_PRIVBILL',
       COUNT(*), CAST(NULL AS VARCHAR2(200)), CAST(NULL AS NUMBER)
  FROM DATACUT3.ME13_PRIVBILL
 WHERE NVL(Amount,0) &lt; 0
UNION ALL
-- DC13-FN-007 | Negative withdrawal balance: SETWDRWACC
SELECT 'DC13-FN-007', 'Negative Balance: ME13_SETWDRWACC',
       COUNT(*), CAST(NULL AS VARCHAR2(200)), CAST(NULL AS NUMBER)
  FROM DATACUT3.ME13_SETWDRWACC
 WHERE NVL(Balance,0) &lt; 0
UNION ALL
-- DC13-FN-008 | Negative notary/lawyer fee balance: SETNOTFEED
SELECT 'DC13-FN-008', 'Negative Balance: ME13_SETNOTFEED',
       COUNT(*), CAST(NULL AS VARCHAR2(200)), CAST(NULL AS NUMBER)
  FROM DATACUT3.ME13_SETNOTFEED
 WHERE NVL(Balance,0) &lt; 0
UNION ALL
-- DC13-FN-009 | Negative deducted legacy balance: SETDEDLEG
SELECT 'DC13-FN-009', 'Negative Balance: ME13_SETDEDLEG',
       COUNT(*), CAST(NULL AS VARCHAR2(200)), CAST(NULL AS NUMBER)
  FROM DATACUT3.ME13_SETDEDLEG
 WHERE NVL(Balance,0) &lt; 0
UNION ALL
-- DC13-FN-010 | Invalid ISO currency code length (&lt;&gt;3 chars, value not displayed - masked field)
SELECT 'DC13-FN-010', 'Invalid ISO Currency Code Length (across settlement tables)',
       COUNT(*), CAST(NULL AS VARCHAR2(200)), CAST(NULL AS NUMBER)
  FROM (
    SELECT Currency AS CCY FROM DATACUT3.ME13_SETCLSDACC WHERE Currency IS NOT NULL
    UNION ALL
    SELECT Currency FROM DATACUT3.ME13_SETWDRWACC WHERE Currency IS NOT NULL
    UNION ALL
    SELECT Currency FROM DATACUT3.ME13_SETDEDRETB WHERE Currency IS NOT NULL
    UNION ALL
    SELECT Currency FROM DATACUT3.ME13_SETNOTFEED WHERE Currency IS NOT NULL
    UNION ALL
    SELECT Currency FROM DATACUT3.ME13_SETDEDLEG WHERE Currency IS NOT NULL
    UNION ALL
    SELECT CCY FROM DATACUT3.ME13_PRIVBILL WHERE CCY IS NOT NULL
  ) X
 WHERE LENGTH(TRIM(CCY)) &lt;&gt; 3
      ) x
    UNION ALL
