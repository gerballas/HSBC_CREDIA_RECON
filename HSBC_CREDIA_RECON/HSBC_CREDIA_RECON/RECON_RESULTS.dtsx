                        <externalMetadataColumn
                          refId="Package\Sequence Container\SEPA_Master\OLE DB Destination.Inputs[OLE DB Destination Input].ExternalColumns[RUN_VERSION]"
                          dataType="i4"
                          name="RUN_VERSION" />
                        <externalMetadataColumn
                          refId="Package\Sequence Container\SEPA_Master\OLE DB Destination.Inputs[OLE DB Destination Input].ExternalColumns[RUN_TIMESTAMP]"
                          dataType="wstr"
