        <DTS:Executable
          DTS:refId="Package\Sequence Container\Customer_Groups_Master"
          DTS:CreationName="Microsoft.Pipeline"
          DTS:Description="Data Flow Task"
          DTS:DTSID="{d11e2b35-f126-425a-ad06-6f7b24762980}"
          DTS:ExecutableType="Microsoft.Pipeline"
          DTS:LocaleID="-1"
          DTS:ObjectName="Customer_Groups_Master"
          DTS:TaskContact="Performs high-performance data extraction, transformation and loading;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1">
          <DTS:Variables />
          <DTS:ObjectData>
            <pipeline
              version="1">
              <components>
                <component
                  refId="Package\Sequence Container\Customer_Groups_Master\Customer_Groups_master"
                  componentClassID="Microsoft.SSISOracleSrc"
                  contactInfo="Oracle Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;1"
                  description="Oracle Source"
                  name="Customer_Groups_master"
                  usesDispositions="true"
                  version="1">
                  <properties>
                    <property
                      dataType="System.String"
                      description="The name of the table to be fetched."
                      expressionType="Notify"
                      name="TableName"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      expressionType="Notify"
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">-- ====================================================================
-- GRP_RECON — MASTER DC5
-- Τροφοδοτεί: RECON.GRP_RECON_MASTER (ορισμός πίνακα: CustomerGroups_DC5_prompt.md)
-- Μία γραμμή ΑΝΑ CHECK_ID — 12 γραμμές ανά run: CGR-001 .. CGR-012
--
-- Recon έλεγχοι Customer Groups: HUB (SSGPNMP, SSGPRLP) vs PROFITS
-- CUST_GROUP / CUST_GROUP_MEMBER, κανόνες του 19500_CustomersGroups.sql
-- (ίδιο στο DC5 με το drop 20261005). Μορφή Master/Detail όπως τα Customer
-- Addresses και τα Customer Categories:
--   - ένα αυτοτελές SELECT, χωρίς views και χωρίς βοηθητικούς πίνακες. Το
--     prologue (CTEs) και το FINDINGS CTE είναι ΙΔΙΑ αυτούσια στο
--     DetailCustomerGroups_DC5.sql -&gt; INVALID_COUNT = γραμμές του Detail
--     ανά CHECK_ID.
--   - Λογική από το Customer_Groups_recon_v2.sql (μένει ως έχει), μόνο οι
--     έλεγχοι με RECON_CHECK = Y, με νέα αρίθμηση. Αντιστοιχία με v2:
--     001 = v2 003, 002 = v2 004, 003 = v2 005, 004 = v2 006, 005 = v2 007,
--     006 = v2 008, 007 = v2 009, 008 = v2 010, 009 = v2 011,
--     010 = v2 013 + v2 015 (αιτία στο ISSUE), 011 = v2 028, 012 = v2 031.
--   - HUB από τους τοπικούς HUB_MT_*. Το joint redirect (HGR_MG_JOINT του
--     10200) ξαναϋπολογίζεται από το HUB_MT_SSPRJIP, όπως στα Addresses.
--     Κωδικοί group / πελάτη και SERIAL_NO από τις βοηθητικές στήλες του 10090
--     (όπως το v2). MG πίνακες μόνο όπου δεν γίνεται αλλιώς:
--       MG_CUSTOMER_INTER - HUB πελάτης -&gt; PROFITS id, load status, MONITORING_UNIT
--       MG_CUST_GROUP     - μόνο για την αιτία (γραμμή από το τελευταίο run του 19500)
--     PROFITS = CUST_GROUP, CUST_GROUP_MEMBER, CUSTOMER.
--
-- CGR-012 = INFO, μόνο Master: μετριέται στο FINDINGS_COUNT, χωρίς γραμμές στο
-- Detail. Άρα INVALID_COUNT = γραμμές Detail ανά CHECK_ID, εκτός CGR-012.
-- STATUS: PASS (INVALID_COUNT = 0) / FAIL / INFO (CGR-012). DESCRIPTION: απλή
-- περιγραφή χωρίς κωδικούς. Όπου γράφει 'To be confirmed' = προς επιβεβαίωση με NC.
--
-- TOTAL_RECORDS ανά POPULATION_TYPE:
--   TOTALS           = 1 (μία σύγκριση συνόλων)
--   HUB_GROUPS       = κωδικοί group στο SSGPNMP
--   PRF_GROUPS       = γραμμές CUST_GROUP
--   MATCHED_GROUPS   = groups και στα δύο συστήματα
--   HUB_MEMB_KEYS    = αναμενόμενα μέλη (PROFITS id, group)
--   PRF_MEMBERS      = γραμμές CUST_GROUP_MEMBER
--   MATCHED_MEMBERS  = μέλη και στα δύο συστήματα
--   HUB_MEMB_ROWS    = γραμμές SSGPRLP
--   HUB_MEMB_ROWS_IN = γραμμές SSGPRLP που μεταφέρονται
-- ====================================================================
WITH
-- --------------------------------------------------------------------
-- Κοινό prologue (ίδιο αυτούσιο στο Master και στο Detail, ώστε το
-- καθένα να τρέχει μόνο του). Λογική από το Customer_Groups_recon_v2.sql,
-- μόνο ό,τι χρειάζονται οι recon έλεγχοι.
--   JNT         = joint -&gt; holders από HUB_MT_SSPRJIP, ίδια λογική με το
--                 10200 (που χτίζει το HGR_MG_JOINT) - δεν διαβάζουμε HGR
--   MIG_ALL     = MG_CUSTOMER_INTER ανά κωδικό: PROFITS id (ROW_STATUS 1),
--                 load status, MONITORING_UNIT (για το GROUP_UNIT)
--   G_*         = groups HUB (SSGPNMP), κλειδί = κωδικός group (10090)
--   M_*         = μέλη HUB (SSGPRLP) με joint redirect και κανόνα 19500
--   PRF_*       = CUST_GROUP / CUST_GROUP_MEMBER
--   G_RECON / M_RECON = HUB vs PROFITS
-- --------------------------------------------------------------------
JNT AS (
    -- Ίδιο SELECT με το 10200: ένα ζεύγος ανά γραμμή SSPRJIP (τα διπλά
    -- αντίγραφα τα μαζεύει το SELECT DISTINCT του 19500 / το GROUP BY εδώ)
    SELECT /*+ MATERIALIZE */ DISTINCT
           TRIM(X0DCB)  || LPAD(TO_CHAR(TRIM(X0DCS)), 6, '0')  AS C,
           TRIM(X0DCBH) || LPAD(TO_CHAR(TRIM(X0DCSH)), 6, '0') AS B,
           ROW_NUMBER() OVER (
               PARTITION BY TRIM(X0DCB) || LPAD(TO_CHAR(TRIM(X0DCS)), 6, '0')
               ORDER BY TRIM(X0DCB) || LPAD(TO_CHAR(TRIM(X0DCS)), 6, '0')
           )                                                   AS SERIAL_NO
      FROM HUB_MT_SSPRJIP
),
MIG_ALL AS (
    SELECT /*+ MATERIALIZE */
           TRIM(M.CUSTOMER_CODE)                                                   AS CUST_CODE,
           MIN(CASE WHEN TRIM(TO_CHAR(M.ROW_STATUS)) = '1' THEN M.PRFT_CUST_ID END) AS CUST_ID,
           MAX(CASE WHEN TRIM(TO_CHAR(M.ROW_STATUS)) = '1' THEN 1 ELSE 0 END)      AS IS_LOADED,
           MAX(TRIM(TO_CHAR(M.ROW_STATUS)))                                        AS MAX_RS,
           MIN(M.MONITORING_UNIT)                                                  AS UNIT
      FROM MG_CUSTOMER_INTER M
     GROUP BY TRIM(M.CUSTOMER_CODE)
),
MIG_IDS AS (
    SELECT /*+ MATERIALIZE */ M.CUST_ID, MIN(M.CUST_CODE) AS CUST_CODE
      FROM MIG_ALL M
     WHERE M.CUST_ID IS NOT NULL
     GROUP BY M.CUST_ID
),
-- --------------------------------------------------------------------
-- HUB groups (SSGPNMP). Κλειδί = CUSTOMER_GROUP_CODE του 10090
-- (ZPCGB || LPAD(ZPCGS, 6, '0')) = CUST_GROUP.COMMENTS
-- --------------------------------------------------------------------
G_SRC AS (
    SELECT /*+ MATERIALIZE */
           G.SERIAL_NO                    AS HUB_SERIAL,
           TRIM(G.CUSTOMER_GROUP_CODE)    AS GCODE,
           TRIM(G.ZPCGNM)                 AS NAME
      FROM HUB_MT_SSGPNMP G
),
G_KEY AS (
    SELECT /*+ MATERIALIZE */
           S.GCODE, COUNT(*) AS N_ROWS, MIN(S.NAME) AS NAME
      FROM G_SRC S
     WHERE S.GCODE IS NOT NULL
     GROUP BY S.GCODE
),
-- αναμενόμενο GROUP_UNIT όπως το 19500: MONITORING_UNIT του πελάτη με κωδικό = κωδικός group
G_EXP AS (
    SELECT /*+ MATERIALIZE */ K.*, M.UNIT AS EXP_UNIT
      FROM G_KEY K
      LEFT JOIN MIG_ALL M ON M.CUST_CODE = K.GCODE
),
-- --------------------------------------------------------------------
-- HUB μέλη (SSGPRLP), joint redirect και κανόνας του 19500
-- --------------------------------------------------------------------
M_SRC AS (
    SELECT /*+ MATERIALIZE */
           R.SERIAL_NO                    AS HUB_SERIAL,
           TRIM(R.CUSTOMER_GROUP_CODE)    AS GCODE,
           TRIM(R.CUSTOMER_CODE)          AS CCODE,
           CASE WHEN VALIDATE_CONVERSION(TRIM(TO_CHAR(R.ZHPCHD)) AS NUMBER) = 1
                THEN TO_NUMBER(TRIM(TO_CHAR(R.ZHPCHD))) END AS PCHD,
           CASE WHEN VALIDATE_CONVERSION(TRIM(TO_CHAR(R.ZHGCP)) AS NUMBER) = 1
                THEN TO_NUMBER(TRIM(TO_CHAR(R.ZHGCP))) END  AS GCP
      FROM HUB_MT_SSGPRLP R
),
-- μία γραμμή ανά σχέση HUB και joint holder (το 19500 δεν κρατά μόνο τον πρώτο holder)
M_FAN AS (
    SELECT /*+ MATERIALIZE USE_HASH(J G M) */
           S.*,
           J.C                                                                   AS J_C,
           COALESCE(J.B, S.CCODE)                                                AS FINAL_CODE,
           M.CUST_ID,
           M.MAX_RS,
           CASE WHEN G.GCODE IS NULL       THEN 'EXCL_NO_GROUP'
                WHEN M.CUST_CODE IS NULL   THEN 'EXCL_CUSTOMER_NOT_IN_STAGING'
                WHEN M.IS_LOADED = 0       THEN 'EXCL_CUSTOMER_NOT_LOADED'
                WHEN M.CUST_ID IS NULL     THEN 'EXCL_LOADED_WITHOUT_PROFITS_ID'
                ELSE 'IN' END                                                    AS MSTATUS
      FROM M_SRC S
      LEFT JOIN JNT J     ON J.C = S.CCODE
      LEFT JOIN G_KEY G   ON G.GCODE = S.GCODE
      LEFT JOIN MIG_ALL M ON M.CUST_CODE = COALESCE(J.B, S.CCODE)
),
-- μία γραμμή ανά σχέση HUB, με την αιτία αν δεν μεταφέρεται
M_ROW AS (
    SELECT /*+ MATERIALIZE */
           X.*,
           CASE WHEN X.NO_GROUP = 1                 THEN 'EXCL_NO_GROUP'
                WHEN X.N_IN &gt; 0 AND X.IS_JOINT = 1  THEN 'IN_VIA_JOINT_HOLDERS'
                WHEN X.N_IN &gt; 0                     THEN 'IN'
                WHEN X.IS_JOINT = 1                 THEN 'EXCL_JOINT_HOLDERS_NOT_MIGRATED'
                ELSE X.ST_MIN END AS SCOPE_REASON
      FROM (SELECT F.HUB_SERIAL, F.GCODE, F.CCODE, MAX(F.PCHD) AS PCHD, MAX(F.GCP) AS GCP,
                   SUM(CASE WHEN F.MSTATUS = 'IN' THEN 1 ELSE 0 END)            AS N_IN,
                   MAX(CASE WHEN F.J_C IS NOT NULL THEN 1 ELSE 0 END)           AS IS_JOINT,
                   MAX(CASE WHEN F.MSTATUS = 'EXCL_NO_GROUP' THEN 1 ELSE 0 END) AS NO_GROUP,
                   MIN(F.MSTATUS)                                               AS ST_MIN,
                   MAX(F.MAX_RS)                                                AS MAX_RS,
                   MIN(F.FINAL_CODE)                                            AS FINAL_MIN,
                   MAX(F.FINAL_CODE)                                            AS FINAL_MAX
              FROM M_FAN F
             GROUP BY F.HUB_SERIAL, F.GCODE, F.CCODE) X
),
-- μία γραμμή ανά αναμενόμενο μέλος (PROFITS customer id, κωδικός group)
M_KEY AS (
    SELECT /*+ MATERIALIZE */
           F.CUST_ID, F.GCODE, COUNT(*) AS N_ROWS, MIN(F.FINAL_CODE) AS CUST_CODE
      FROM M_FAN F
     WHERE F.MSTATUS = 'IN'
     GROUP BY F.CUST_ID, F.GCODE
),
-- --------------------------------------------------------------------
-- PROFITS. MG_CUST_GROUP μόνο για να φανεί αν μια γραμμή είναι από το
-- τελευταίο run του 19500 (το 19500 το κάνει TRUNCATE κάθε φορά).
-- --------------------------------------------------------------------
STG_G AS (
    SELECT /*+ MATERIALIZE */ DISTINCT S.GROUP_ID FROM MG_CUST_GROUP S
),
PRF_G AS (
    SELECT /*+ MATERIALIZE */
           G.GROUP_ID,
           TRIM(G.COMMENTS)                                   AS GCODE,
           TRIM(G.DESCRIPTION)                                AS DESCR,
           G.GROUP_UNIT,
           CASE WHEN S.GROUP_ID IS NOT NULL THEN 1 ELSE 0 END AS IS_MIG
      FROM CUST_GROUP G
      LEFT JOIN STG_G S ON S.GROUP_ID = G.GROUP_ID
),
PRF_GK AS (
    SELECT /*+ MATERIALIZE */
           P.GCODE, COUNT(*) AS N,
           MIN(P.DESCR) AS DESCR, MIN(P.GROUP_UNIT) AS UNIT_MIN, MAX(P.GROUP_UNIT) AS UNIT_MAX
      FROM PRF_G P
     WHERE P.GCODE IS NOT NULL
     GROUP BY P.GCODE
),
PRF_M AS (
    SELECT /*+ MATERIALIZE */
           M.FK_CUSTOMERCUST_ID                            AS CUST_ID,
           M.FK_CUST_GROUPGROUP                            AS GROUP_ID,
           G.GCODE,
           NVL(G.IS_MIG, 0)                                AS IS_MIG,
           CASE WHEN G.GROUP_ID IS NULL THEN 0 ELSE 1 END  AS HAS_GROUP,
           TRIM(M.ENTRY_COMMENTS)                          AS ECOM
      FROM CUST_GROUP_MEMBER M
      LEFT JOIN PRF_G G ON G.GROUP_ID = M.FK_CUST_GROUPGROUP
),
PRF_MK AS (
    SELECT /*+ MATERIALIZE */ P.CUST_ID, P.GCODE, COUNT(*) AS N, MIN(P.ECOM) AS ECOM
      FROM PRF_M P
     WHERE P.GCODE IS NOT NULL
     GROUP BY P.CUST_ID, P.GCODE
),
CUST AS (
    SELECT /*+ MATERIALIZE */ C.CUST_ID FROM CUSTOMER C
),
-- --------------------------------------------------------------------
-- HUB vs PROFITS
-- --------------------------------------------------------------------
G_RECON AS (
    SELECT /*+ MATERIALIZE */
           NVL(H.GCODE, P.GCODE)                       AS GCODE,
           CASE WHEN P.GCODE IS NULL THEN 'MISSING_IN_PROFITS'
                WHEN H.GCODE IS NULL THEN 'EXTRA_IN_PROFITS'
                ELSE 'MATCHED' END                     AS KEY_STATUS,
           H.NAME, H.EXP_UNIT, P.DESCR, P.UNIT_MIN, P.UNIT_MAX
      FROM G_EXP H
      FULL OUTER JOIN PRF_GK P ON P.GCODE = H.GCODE
),
M_RECON AS (
    SELECT /*+ MATERIALIZE */
           NVL(H.CUST_ID, P.CUST_ID)                   AS CUST_ID,
           NVL(H.GCODE, P.GCODE)                       AS GCODE,
           CASE WHEN P.CUST_ID IS NULL THEN 'MISSING_IN_PROFITS'
                WHEN H.CUST_ID IS NULL THEN 'EXTRA_IN_PROFITS'
                ELSE 'MATCHED' END                     AS KEY_STATUS,
           H.CUST_CODE, H.N_ROWS AS HUB_N, P.ECOM
      FROM M_KEY H
      FULL OUTER JOIN PRF_MK P
        ON P.CUST_ID = H.CUST_ID
       AND P.GCODE   = H.GCODE
),
FINDINGS AS (
    -- Μία γραμμή ανά εύρημα. CUSTOMER_CODE = κωδικός group HUB (= CUST_GROUP.COMMENTS),
    -- SERIAL_NO = κωδικός μέλους HUB (μετά το joint redirect, εκτός CGR-010 / 011).
    -- CGR-001 / 006: μία γραμμή όταν τα σύνολα διαφέρουν.
    --==============================================================
    --CGR-001. Σύνολο groups, SSGPNMP vs CUST_GROUP (όλος ο πίνακας) (v2 CGR-003)
    SELECT
      CAST('CGR-001_GROUP_COUNT_MISMATCH' AS VARCHAR2(50)) AS CHECK_NAME,
      CAST(NULL AS VARCHAR2(40)) AS CUSTOMER_CODE,
      CAST(NULL AS VARCHAR2(40)) AS SERIAL_NO,
      CAST('SSGPNMP rows ' || TO_CHAR(H.N) AS VARCHAR2(400)) AS HUB_VALUE,
      CAST('CUST_GROUP rows ' || TO_CHAR(P.N) || ' (last 19500 run ' || TO_CHAR(P.NM) || ', other ' || TO_CHAR(P.N - P.NM) || ')' AS VARCHAR2(400)) AS NCIS_VALUE,
      CAST('COUNT_DIFFERS' AS VARCHAR2(50)) AS ISSUE
    FROM (SELECT COUNT(*) AS N FROM G_SRC) H
    CROSS JOIN (SELECT COUNT(*) AS N, NVL(SUM(IS_MIG), 0) AS NM FROM PRF_G) P
    WHERE H.N &lt;&gt; P.N
    UNION ALL
    --==============================================================
    --CGR-002. Group HUB που λείπει από το PROFITS (v2 CGR-004)
    SELECT 'CGR-002_GROUP_MISSING_IN_PROFITS', R.GCODE, NULL, R.NAME, NULL, 'MISSING_IN_PROFITS'
    FROM G_RECON R
    WHERE R.KEY_STATUS = 'MISSING_IN_PROFITS'
    UNION ALL
    --==============================================================
    --CGR-003. Group PROFITS χωρίς αντίστοιχο στο HUB (όλος ο πίνακας) (v2 CGR-005)
    SELECT 'CGR-003_GROUP_MISSING_IN_HUB', P.GCODE, NULL, NULL,
           'GROUP_ID ' || TO_CHAR(P.GROUP_ID) || ', ' || P.DESCR,
           CASE WHEN P.GCODE IS NULL THEN 'EMPTY_GROUP_CODE'
                WHEN P.IS_MIG = 1    THEN 'LOADED_BY_LAST_19500_RUN'
                ELSE 'NOT_FROM_LAST_19500_RUN' END
    FROM PRF_G P
    LEFT JOIN G_KEY K ON K.GCODE = P.GCODE
    WHERE K.GCODE IS NULL
    UNION ALL
    --==============================================================
    --CGR-004. CUST_GROUP.DESCRIPTION vs SSGPNMP.ZPCGNM (v2 CGR-006)
    SELECT 'CGR-004_GROUP_NAME_MISMATCH', R.GCODE, NULL, R.NAME, R.DESCR, 'MISMATCH'
    FROM G_RECON R
    WHERE R.KEY_STATUS = 'MATCHED'
      AND NVL(R.NAME, 'X') &lt;&gt; NVL(R.DESCR, 'X')
    UNION ALL
    --==============================================================
    --CGR-005. CUST_GROUP.GROUP_UNIT vs MONITORING_UNIT του πελάτη με τον κωδικό του group (v2 CGR-007)
    SELECT 'CGR-005_GROUP_UNIT_MISMATCH', R.GCODE, NULL,
           'MONITORING_UNIT ' || NVL(TO_CHAR(R.EXP_UNIT), 'empty'),
           'GROUP_UNIT ' || NVL(TO_CHAR(R.UNIT_MIN), 'empty') || CASE WHEN R.UNIT_MAX &lt;&gt; R.UNIT_MIN THEN ' .. ' || TO_CHAR(R.UNIT_MAX) END,
           'MISMATCH'
    FROM G_RECON R
    WHERE R.KEY_STATUS = 'MATCHED'
      AND (NVL(TO_CHAR(R.UNIT_MIN), '~') &lt;&gt; NVL(TO_CHAR(R.EXP_UNIT), '~')
        OR NVL(TO_CHAR(R.UNIT_MAX), '~') &lt;&gt; NVL(TO_CHAR(R.EXP_UNIT), '~'))
    UNION ALL
    --==============================================================
    --CGR-006. Σύνολο μελών, αναμενόμενα από HUB vs CUST_GROUP_MEMBER (v2 CGR-008)
    SELECT 'CGR-006_MEMBERSHIP_COUNT_MISMATCH', NULL, NULL,
           'expected memberships ' || TO_CHAR(H.N),
           'CUST_GROUP_MEMBER rows ' || TO_CHAR(P.N) || ' (groups of the last 19500 run ' || TO_CHAR(P.NM) || ', other ' || TO_CHAR(P.N - P.NM) || ')',
           'COUNT_DIFFERS'
    FROM (SELECT COUNT(*) AS N FROM M_KEY) H
    CROSS JOIN (SELECT COUNT(*) AS N, NVL(SUM(IS_MIG), 0) AS NM FROM PRF_M) P
    WHERE H.N &lt;&gt; P.N
    UNION ALL
    --==============================================================
    --CGR-007. Αναμενόμενο μέλος (πελάτης μεταφερμένος) που λείπει από το PROFITS (v2 CGR-009)
    SELECT /*+ USE_HASH(G C) */ 'CGR-007_MEMBERSHIP_MISSING_IN_PROFITS', R.GCODE, R.CUST_CODE,
           'PRFT_CUST_ID ' || TO_CHAR(R.CUST_ID) || ', ' || TO_CHAR(R.HUB_N) || ' HUB rows', NULL,
           CASE WHEN G.GCODE IS NULL   THEN 'GROUP_NOT_IN_PROFITS'
                WHEN C.CUST_ID IS NULL THEN 'CUSTOMER_NOT_IN_CUSTOMER'
                ELSE 'MEMBERSHIP_NOT_LOADED' END
    FROM M_RECON R
    LEFT JOIN PRF_GK G ON G.GCODE = R.GCODE
    LEFT JOIN CUST C   ON C.CUST_ID = R.CUST_ID
    WHERE R.KEY_STATUS = 'MISSING_IN_PROFITS'
    UNION ALL
    --==============================================================
    --CGR-008. Μέλος PROFITS χωρίς αντίστοιχο στο HUB (όλος ο πίνακας) (v2 CGR-010)
    SELECT /*+ USE_HASH(K I) */ 'CGR-008_MEMBERSHIP_MISSING_IN_HUB', P.GCODE, I.CUST_CODE,
           NULL, 'PRFT_CUST_ID ' || TO_CHAR(P.CUST_ID) || ', GROUP_ID ' || TO_CHAR(P.GROUP_ID),
           CASE WHEN P.HAS_GROUP = 0     THEN 'GROUP_NOT_IN_CUST_GROUP'
                WHEN P.IS_MIG = 0        THEN 'GROUP_NOT_FROM_LAST_19500_RUN'
                WHEN I.CUST_CODE IS NULL THEN 'CUSTOMER_NOT_MIGRATED'
                ELSE 'NO_HUB_MEMBERSHIP' END
    FROM PRF_M P
    LEFT JOIN M_KEY K   ON K.CUST_ID = P.CUST_ID AND K.GCODE = P.GCODE
    LEFT JOIN MIG_IDS I ON I.CUST_ID = P.CUST_ID
    WHERE K.CUST_ID IS NULL
    UNION ALL
    --==============================================================
    --CGR-009. CUST_GROUP_MEMBER.ENTRY_COMMENTS vs όνομα group κομμένο στους 30 χαρακτήρες (v2 CGR-011)
    SELECT 'CGR-009_ENTRY_COMMENTS_MISMATCH', R.GCODE, R.CUST_CODE,
           TRIM(SUBSTR(G.NAME, 1, 30)), R.ECOM, 'MISMATCH'
    FROM M_RECON R
    JOIN G_KEY G ON G.GCODE = R.GCODE
    WHERE R.KEY_STATUS = 'MATCHED'
      AND NVL(R.ECOM, 'X') &lt;&gt; NVL(TRIM(SUBSTR(G.NAME, 1, 30)), 'X')
    UNION ALL
    --==============================================================
    --CGR-010. Σχέση SSGPRLP που η μετάπτωση αφήνει έξω - ISSUE = αιτία (v2 CGR-013 + CGR-015)
    SELECT 'CGR-010_HUB_MEMBERSHIP_NOT_MIGRATED', R.GCODE, R.CCODE,
           'SSGPRLP serial ' || TO_CHAR(R.HUB_SERIAL)
           || CASE WHEN R.IS_JOINT = 1 THEN ', joint holders ' || R.FINAL_MIN
                   || CASE WHEN R.FINAL_MAX &lt;&gt; R.FINAL_MIN THEN '..' || R.FINAL_MAX END END,
           CASE WHEN R.SCOPE_REASON = 'EXCL_CUSTOMER_NOT_LOADED' THEN 'MG_CUSTOMER_INTER ROW_STATUS ' || NVL(R.MAX_RS, 'empty') END,
           CASE R.SCOPE_REASON
                WHEN 'EXCL_NO_GROUP'                   THEN 'GROUP_NOT_IN_SSGPNMP'
                WHEN 'EXCL_CUSTOMER_NOT_IN_STAGING'    THEN 'CUSTOMER_NOT_IN_STAGING'
                WHEN 'EXCL_CUSTOMER_NOT_LOADED'        THEN 'CUSTOMER_NOT_LOADED'
                WHEN 'EXCL_LOADED_WITHOUT_PROFITS_ID'  THEN 'LOADED_WITHOUT_PROFITS_ID'
                WHEN 'EXCL_JOINT_HOLDERS_NOT_MIGRATED' THEN 'JOINT_HOLDERS_NOT_MIGRATED'
                ELSE SUBSTR(R.SCOPE_REASON, 1, 50) END
    FROM M_ROW R
    WHERE R.SCOPE_REASON NOT LIKE 'IN%'
    UNION ALL
    --==============================================================
    --CGR-011. Μεταφερμένη σχέση με ZHPCHD / ZHGCP &lt;&gt; 0 - το 19500 δεν τα μεταφέρει (v2 CGR-028) - TODO NC / BRD
    SELECT 'CGR-011_PERCENTAGES_NOT_MIGRATED', R.GCODE, R.CCODE,
           'ZHPCHD ' || NVL(TO_CHAR(R.PCHD), 'empty') || ', ZHGCP ' || NVL(TO_CHAR(R.GCP), 'empty'), NULL,
           CASE WHEN NVL(R.PCHD, 0) &lt;&gt; 0 AND NVL(R.GCP, 0) &lt;&gt; 0 THEN 'PERCENTAGE_AND_GIMIS_NOT_MIGRATED'
                WHEN NVL(R.PCHD, 0) &lt;&gt; 0                       THEN 'PERCENTAGE_HOLDING_NOT_MIGRATED'
                ELSE 'GIMIS_PCT_NOT_MIGRATED' END
    FROM M_ROW R
    WHERE R.N_IN &gt; 0
      AND (NVL(R.PCHD, 0) &lt;&gt; 0 OR NVL(R.GCP, 0) &lt;&gt; 0)
    -- CGR-012 (INFO): μόνο Master, μετριέται στο FINDINGS_COUNT του Master - χωρίς γραμμές στο Detail
)
,
POPULATIONS AS (
    SELECT
        1                                                         AS TOTALS_COUNT,
        (SELECT COUNT(*) FROM G_KEY)                              AS HUB_GROUPS_COUNT,
        (SELECT COUNT(*) FROM PRF_G)                              AS PRF_GROUPS_COUNT,
        (SELECT COUNT(*) FROM G_RECON WHERE KEY_STATUS = 'MATCHED') AS MATCHED_GROUPS_COUNT,
        (SELECT COUNT(*) FROM M_KEY)                              AS HUB_MEMB_KEYS_COUNT,
        (SELECT COUNT(*) FROM PRF_M)                              AS PRF_MEMBERS_COUNT,
        (SELECT COUNT(*) FROM M_RECON WHERE KEY_STATUS = 'MATCHED') AS MATCHED_MEMBERS_COUNT,
        (SELECT COUNT(*) FROM M_ROW)                              AS HUB_MEMB_ROWS_COUNT,
        (SELECT COUNT(*) FROM M_ROW WHERE N_IN &gt; 0)               AS HUB_MEMB_ROWS_IN_COUNT
    FROM DUAL
),
CHECK_META AS (
    -- CHECK_ID | CHECK_NAME | CATEGORY | DESCRIPTION | POPULATION_TYPE
    SELECT 'CGR-001' AS CHECK_ID, 'CGR-001_GROUP_COUNT_MISMATCH' AS CHECK_NAME, 'CONTROL_TOTAL' AS CATEGORY, 'Total number of customer groups, HUB vs PROFITS (whole PROFITS table). One row when the totals differ.' AS DESCRIPTION, 'TOTALS' AS POPULATION_TYPE FROM DUAL UNION ALL
    SELECT 'CGR-002', 'CGR-002_GROUP_MISSING_IN_PROFITS',        'EXISTENCE',             'Customer groups in HUB that are not in PROFITS.', 'HUB_GROUPS' FROM DUAL UNION ALL
    SELECT 'CGR-003', 'CGR-003_GROUP_MISSING_IN_HUB',            'EXISTENCE',             'Customer groups in PROFITS that are not in HUB. The detail rows say whether the group was loaded by the last migration run or existed before.', 'PRF_GROUPS' FROM DUAL UNION ALL
    SELECT 'CGR-004', 'CGR-004_GROUP_NAME_MISMATCH',             'CROSS_SYSTEM_MISMATCH', 'Group name in PROFITS is different from the group name in HUB.', 'MATCHED_GROUPS' FROM DUAL UNION ALL
    SELECT 'CGR-005', 'CGR-005_GROUP_UNIT_MISMATCH',             'CROSS_SYSTEM_MISMATCH', 'Group unit in PROFITS is different from the unit of the customer whose code is the group code, as the migration sets it.', 'MATCHED_GROUPS' FROM DUAL UNION ALL
    SELECT 'CGR-006', 'CGR-006_MEMBERSHIP_COUNT_MISMATCH',       'CONTROL_TOTAL',         'Total number of group memberships, HUB vs PROFITS (whole PROFITS table). One row when the totals differ.', 'TOTALS' FROM DUAL UNION ALL
    SELECT 'CGR-007', 'CGR-007_MEMBERSHIP_MISSING_IN_PROFITS',   'EXISTENCE',             'Group memberships expected from HUB (member customer migrated) that are not in PROFITS. The detail rows give the likely reason.', 'HUB_MEMB_KEYS' FROM DUAL UNION ALL
    SELECT 'CGR-008', 'CGR-008_MEMBERSHIP_MISSING_IN_HUB',       'EXISTENCE',             'Group memberships in PROFITS that are not expected from HUB. The detail rows give the likely reason, e.g. group not from the last migration run.', 'PRF_MEMBERS' FROM DUAL UNION ALL
    SELECT 'CGR-009', 'CGR-009_ENTRY_COMMENTS_MISMATCH',         'CROSS_SYSTEM_MISMATCH', 'Membership comment in PROFITS is not the group name cut to 30 characters, as the migration sets it.', 'MATCHED_MEMBERS' FROM DUAL UNION ALL
    SELECT 'CGR-010', 'CGR-010_HUB_MEMBERSHIP_NOT_MIGRATED',     'EXISTENCE',             'Group memberships in HUB that the migration leaves out, e.g. group not in the group file or member customer not migrated. The detail rows give the reason.', 'HUB_MEMB_ROWS' FROM DUAL UNION ALL
    SELECT 'CGR-011', 'CGR-011_PERCENTAGES_NOT_MIGRATED',        'CROSS_SYSTEM_MISMATCH', 'Migrated memberships with a percentage holding or GIMIS contribution in HUB, which the migration does not carry. To be confirmed.', 'HUB_MEMB_ROWS_IN' FROM DUAL UNION ALL
    SELECT 'CGR-012', 'CGR-012_GROUP_NAME_CUT_TO_30',            'INFO',                  'Information only: group names longer than 30 characters, which are cut in the membership comment.', 'HUB_GROUPS' FROM DUAL
),
FINDINGS_COUNT AS (
    SELECT CHECK_ID, COUNT(*) AS INVALID_COUNT
    FROM (SELECT SUBSTR(CHECK_NAME, 1, INSTR(CHECK_NAME, '_') - 1) AS CHECK_ID FROM FINDINGS)
    GROUP BY CHECK_ID
    UNION ALL
    -- CGR-012 (INFO, μόνο Master): όνομα group &gt; 30 χαρακτήρες, κομμένο στο ENTRY_COMMENTS (v2 CGR-031)
    SELECT 'CGR-012', COUNT(*) FROM G_KEY WHERE LENGTH(NAME) &gt; 30
)
SELECT
    CAST(CM.CHECK_ID AS VARCHAR2(10)) AS CHECK_ID,
    CAST(CM.CHECK_NAME AS VARCHAR2(50)) AS CHECK_NAME,
    CAST(CM.CATEGORY AS VARCHAR2(30)) AS CATEGORY,
    CAST(CM.DESCRIPTION AS VARCHAR2(200)) AS DESCRIPTION,
    (CASE CM.POPULATION_TYPE
        WHEN 'TOTALS'           THEN P.TOTALS_COUNT
        WHEN 'HUB_GROUPS'       THEN P.HUB_GROUPS_COUNT
        WHEN 'PRF_GROUPS'       THEN P.PRF_GROUPS_COUNT
        WHEN 'MATCHED_GROUPS'   THEN P.MATCHED_GROUPS_COUNT
        WHEN 'HUB_MEMB_KEYS'    THEN P.HUB_MEMB_KEYS_COUNT
        WHEN 'PRF_MEMBERS'      THEN P.PRF_MEMBERS_COUNT
        WHEN 'MATCHED_MEMBERS'  THEN P.MATCHED_MEMBERS_COUNT
        WHEN 'HUB_MEMB_ROWS'    THEN P.HUB_MEMB_ROWS_COUNT
        WHEN 'HUB_MEMB_ROWS_IN' THEN P.HUB_MEMB_ROWS_IN_COUNT
     END) AS TOTAL_RECORDS,
    (CASE CM.POPULATION_TYPE
        WHEN 'TOTALS'           THEN P.TOTALS_COUNT
        WHEN 'HUB_GROUPS'       THEN P.HUB_GROUPS_COUNT
        WHEN 'PRF_GROUPS'       THEN P.PRF_GROUPS_COUNT
        WHEN 'MATCHED_GROUPS'   THEN P.MATCHED_GROUPS_COUNT
        WHEN 'HUB_MEMB_KEYS'    THEN P.HUB_MEMB_KEYS_COUNT
        WHEN 'PRF_MEMBERS'      THEN P.PRF_MEMBERS_COUNT
        WHEN 'MATCHED_MEMBERS'  THEN P.MATCHED_MEMBERS_COUNT
        WHEN 'HUB_MEMB_ROWS'    THEN P.HUB_MEMB_ROWS_COUNT
        WHEN 'HUB_MEMB_ROWS_IN' THEN P.HUB_MEMB_ROWS_IN_COUNT
     END) - NVL(FC.INVALID_COUNT, 0) AS VALID_COUNT,
    NVL(FC.INVALID_COUNT, 0) AS INVALID_COUNT,
    CASE WHEN CM.CATEGORY = 'INFO'           THEN 'INFO'
         WHEN NVL(FC.INVALID_COUNT, 0) = 0   THEN 'PASS'
         ELSE 'FAIL' END AS STATUS,
    'DC5' AS DC_VERSION,
    1 AS RUN_VERSION,  -- TESTING ONLY: στο SSIS αντικαθίσταται από @[User::RunVersion] μέσω Derived Column.
    SYSDATE AS RUN_TIMESTAMP
FROM CHECK_META CM
CROSS JOIN POPULATIONS P
LEFT JOIN FINDINGS_COUNT FC ON FC.CHECK_ID = CM.CHECK_ID
ORDER BY REGEXP_SUBSTR(CM.CHECK_ID, '[A-Z]+'), TO_NUMBER(REGEXP_SUBSTR(CM.CHECK_ID, '[0-9]+'));</property>
