                  contactInfo="Oracle Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;1"
                  description="Oracle Source"
                  name="Customers_master"
                  usesDispositions="true"
                  version="1">
                  <properties>
                    <property
                      dataType="System.String"
                      description="The name of the table to be fetched."
                      expressionType="Notify"
                      name="TableName"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      expressionType="Notify"
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">WITH MCI AS (
    SELECT /*+ MATERIALIZE */
        PRFT_CUST_ID                   AS M_PRFT_CUST_ID,
        TRIM(CUSTOMER_CODE)            AS M_CUSTOMER_CODE,
        TRIM(TO_CHAR(CUST_TYPE))       AS M_CUST_TYPE,
        AFM_TAX_OFFICE                 AS M_AFM_TAX_OFFICE,
        AFM_NO                         AS M_AFM_NO,
        TELEPHONE_MOBILE               AS M_TEL_MOBILE,
        E_MAIL                         AS M_EMAIL,
        LATIN_SURNAME                  AS M_LATIN_SURNAME,
        -- τελικές τιμές της μετάπτωσης (12000 + διορθώσεις 12010), πριν το mapping σε PROFITS
        NATIONAL                       AS M_NATIONAL,
        CITIZEN                        AS M_CITIZEN,
        COMLANG                        AS M_COMLANG,
        BCOUNTRY                       AS M_BCOUNTRY,
        UDF_TEXT5                      AS M_UDF_TEXT5,
        ID_TYPE                        AS M_ID_TYPE,
        PROFF                          AS M_PROFF
      FROM MG_CUSTOMER_INTER
     WHERE ROW_STATUS = 1
),
MPP AS (
    SELECT /*+ MATERIALIZE */ PARAMETER_TYPE, TRIM(OLD_VALUE) AS OLD_VALUE, MIN(NEW_VALUE) AS NEW_VALUE
      FROM MG_PARAM_PARAMETER
     WHERE PARAMETER_TYPE IN ('NATIO','COMLA','EDULV','OIDTP','FALST','PROFF','PRFST',
                              'LEGAL','CNTRY','CITIZ','FINBK','AMLRI','TAXOF')
     GROUP BY PARAMETER_TYPE, TRIM(OLD_VALUE)
),
-- --------------------------------------------------------------------
-- R_* = HUB πίνακες. Τα HUB_MT_* είναι synonyms πάνω σε DB link (@Malta,
-- 10098), γι' αυτό κάθε πίνακας διαβάζεται ΜΙΑ φορά, μόνος του (ολόκληρο
-- το SELECT εκτελείται απομακρυσμένα), μόνο με τις στήλες που χρειάζονται
-- και με TRIM(customer_code) = CC. Όλα τα joins / anti-joins γίνονται μετά
-- τοπικά, πάνω στα materialized CTEs.
-- --------------------------------------------------------------------
R_CUSTP AS (
    SELECT /*+ MATERIALIZE */
        TRIM(customer_code) AS CC,
        ZGDCB, ZGNATY, ZGLANG, ZGIDTY, ZGIDNO, ZGTXNO, ZGINDY, ZGLGTP, ZGGHCL, ZGMKS1,
        ZGCSFN, ZGC2FN, ZGFNSP, ZGFNLN, ZGLNSP, ZGLNLN, ZGDTCT
    FROM HUB_MT_SSCUSTP
),
R_INCIP AS (
    SELECT /*+ MATERIALIZE */
        TRIM(customer_code) AS CC, ZKDTBR, ZKSEX, ZKKID, ZKEDUC, ZKMST, ZKOCPT, ZKSPNM
    FROM HUB_MT_SSINCIP
),
R_NICIP AS (
    SELECT /*+ MATERIALIZE */
        TRIM(customer_code) AS CC, XUINCN, XUDTIC, XUIDIC, XUC1TR, XUVATR
    FROM HUB_MT_SSNICIP
),
R_ICADP AS (
    SELECT /*+ MATERIALIZE */
        TRIM(customer_code) AS CC, ZYBCTD, ZYIDPL, ZYIDIC, ZYC1TR
    FROM HUB_MT_SSICADP
),
R_GHCLP AS (
    SELECT /*+ MATERIALIZE */ TRIM(VQGHCL) AS VQGHCL, VQCSTY
    FROM HUB_MT_SSGHCLP
),
R_SCCIP AS (
    SELECT /*+ MATERIALIZE */ TRIM(customer_code) AS CC, SCSCCF
    FROM HUB_MT_SSSCCIP
),
R_PRJIP AS (
    -- joint λογαριασμοί: κωδικοί joint (εξαιρούνται από τους ενεργούς πελάτες, όπως το view)
    SELECT /*+ MATERIALIZE */
        DISTINCT TRIM(customer_code) AS CC
    FROM HUB_MT_SSPRJIP
),
R_CAIFP AS (
    SELECT /*+ MATERIALIZE */
        SERIAL_NUMBER, ZUDCB, ZUDTBR, ZUNATY, ZUBCTD, ZUIDTY, ZUIDNO, ZUCSTY, ZUEINO,
        ZUF2N1, ZUFRN1, ZUC2CN, ZUCSCN
    FROM HUB_MT_SSCAIFP
    WHERE customer_code2 = '0000000'
),
R_NCUSP AS (
    SELECT /*+ MATERIALIZE */
        TRIM(customer_code) AS CC,
        ZWDCB, ZWDTBR, ZWSEX, ZWNATY, ZWBCTD, ZWLANG, ZWKID, ZWEDUC, ZWIDTY, ZWIDNO, ZWTXNO,
        ZWMST, ZWINDY, ZWOCPT, ZWLGTP, ZWPFCM, ZWGHCL, ZWF2N1, ZWFRN1, ZWCSSN,
        ZWIDCI
    FROM HUB_MT_SSNCUSP
),
HUB_C AS (
  SELECT /*+ MATERIALIZE */ * FROM (
    -- 1. SSCAIFP εκπρόσωποι μη-πελάτες (CUSTOMER_CODE2 = 0000000) -&gt; 'SSCAIFP-&lt;serial&gt;' του 12000
    --    (το φίλτρο ZUHUBN = 'N' του 12000 DC5 περνά μέσα από το join στο MCI)
    SELECT
        m.M_PRFT_CUST_ID                                          AS H_PRFT_CUST_ID,
        CAST('SSCAIFP' AS VARCHAR2(10))                           AS H_SRC,
        CAST(TO_CHAR(p.ZUDCB) AS VARCHAR2(200))                   AS H_DCB,
        CAST(TO_CHAR(p.ZUDTBR) AS VARCHAR2(200))                  AS H_DTBR,
        CAST(NULL AS VARCHAR2(200))                               AS H_SEX,
        CAST(TO_CHAR(p.ZUNATY) AS VARCHAR2(200))                  AS H_NATY,
        CAST(NULL AS VARCHAR2(200))                               AS H_LANG,
        CAST('0' AS VARCHAR2(200))                                AS H_KID,
        CAST(NULL AS VARCHAR2(200))                               AS H_EDUC,
        CAST(TO_CHAR(p.ZUIDTY) AS VARCHAR2(200))                  AS H_IDTY,
        CAST(TO_CHAR(p.ZUIDNO) AS VARCHAR2(200))                  AS H_IDNO,
        CAST(TO_CHAR(p.ZUEINO) AS VARCHAR2(200))                  AS H_TXNO,
        CAST(NULL AS VARCHAR2(200))                               AS H_MST,
        CAST(NULL AS VARCHAR2(200))                               AS H_INDY,
        CAST(NULL AS VARCHAR2(200))                               AS H_OCPT,
        CAST(NULL AS VARCHAR2(200))                               AS H_INCN,
        CAST(NULL AS VARCHAR2(200))                               AS H_LGTP,
        CAST(TO_CHAR(p.ZUCSTY) AS VARCHAR2(200))                  AS H_CSTY,
        CAST(NULL AS VARCHAR2(200))                               AS H_GHCL,
        CAST(CASE WHEN p.ZUCSTY = 'I' THEN COALESCE(SUBSTR(TRIM(p.ZUF2N1), 1, 20), SUBSTR(TRIM(p.ZUFRN1), 1, 20))
                  ELSE ' ' END AS VARCHAR2(200))                  AS H_FIRST,
        CAST(CASE WHEN p.ZUCSTY IN ('I','N') THEN COALESCE(TRIM(p.ZUC2CN), TRIM(p.ZUCSCN)) END
             AS VARCHAR2(200))                                    AS H_LAST,
        CAST(NULL AS VARCHAR2(200))                               AS H_FATHER,
        CAST(TO_CHAR(p.ZUBCTD) AS VARCHAR2(200))                  AS H_BCTD,
        DATE '0001-01-01'                                         AS H_DTIC,
        CAST(NULL AS VARCHAR2(200))                               AS H_IDPL,
        CAST(NULL AS VARCHAR2(200))                               AS H_IDIC,
        CAST(m.M_TEL_MOBILE AS VARCHAR2(200))                     AS H_TEN3,
        CAST(m.M_EMAIL AS VARCHAR2(200))                          AS H_IADD,
        CAST(NULL AS VARCHAR2(200))                               AS H_SCCF,
        CAST(NULL AS VARCHAR2(200))                               AS H_C1TR,
        CAST(NULL AS VARCHAR2(200))                               AS H_DTCT
    FROM R_CAIFP p
    JOIN MCI m
      ON m.M_CUSTOMER_CODE = 'SSCAIFP-' || TO_CHAR(TRIM(p.SERIAL_NUMBER))
    UNION ALL
    -- 2. Ενεργοί πελάτες SSCUSTP (χωρίς τους joint κωδικούς του SSPRJIP, όπως το view)
    SELECT
        m.M_PRFT_CUST_ID,
        CAST('SSCUSTP' AS VARCHAR2(10)),
        CAST(TO_CHAR(c.ZGDCB) AS VARCHAR2(200)),
        CAST(TO_CHAR(i.ZKDTBR) AS VARCHAR2(200)),
        CAST(TO_CHAR(i.ZKSEX) AS VARCHAR2(200)),
        CAST(TO_CHAR(c.ZGNATY) AS VARCHAR2(200)),
        CAST(TO_CHAR(c.ZGLANG) AS VARCHAR2(200)),
        CAST(TO_CHAR(i.ZKKID) AS VARCHAR2(200)),
        CAST(TO_CHAR(i.ZKEDUC) AS VARCHAR2(200)),
        CAST(TO_CHAR(c.ZGIDTY) AS VARCHAR2(200)),
        CAST(TO_CHAR(c.ZGIDNO) AS VARCHAR2(200)),
        -- ΑΦΜ όπως το 12000: φυσικά πρόσωπα ZGTXNO, νομικά πρόσωπα SSNICIP.XUVATR
        CAST(CASE WHEN g.VQCSTY = 'I' THEN TRIM(c.ZGTXNO)
                  WHEN g.VQCSTY = 'N' THEN TRIM(ni.XUVATR)
                  ELSE ' ' END AS VARCHAR2(200)),
        CAST(TO_CHAR(i.ZKMST) AS VARCHAR2(200)),
        CAST(TO_CHAR(c.ZGINDY) AS VARCHAR2(200)),
        CAST(TO_CHAR(i.ZKOCPT) AS VARCHAR2(200)),
        CAST(TO_CHAR(ni.XUINCN) AS VARCHAR2(200)),
        CAST(TO_CHAR(c.ZGLGTP) AS VARCHAR2(200)),
        CAST(TO_CHAR(g.VQCSTY) AS VARCHAR2(200)),
        CAST(TO_CHAR(c.ZGGHCL) AS VARCHAR2(200)),
        CAST(CASE WHEN g.VQCSTY = 'I'
                  THEN SUBSTR(NVL(REPLACE(TRIM(SUBSTR(c.ZGC2FN, c.ZGFNSP, c.ZGFNLN)), ' ', NULL),
                                  TRIM(SUBSTR(c.ZGCSFN, c.ZGFNSP, c.ZGFNLN))), 1, 20)
                  ELSE ' ' END AS VARCHAR2(200)),
        CAST(CASE WHEN g.VQCSTY = 'I'
                  THEN SUBSTR(NVL(REPLACE(TRIM(SUBSTR(c.ZGC2FN, c.ZGLNSP, c.ZGLNLN)), ' ', NULL),
                                  TRIM(SUBSTR(c.ZGCSFN, c.ZGLNSP, c.ZGLNLN))), 1, 70)
                  WHEN g.VQCSTY = 'N' THEN SUBSTR(TRIM(c.ZGC2FN), 1, 70)
             END AS VARCHAR2(200)),
        CAST(SUBSTR(NVL(i.ZKSPNM, ' '), 1, 20) AS VARCHAR2(200)),
        CAST(NVL(ic.ZYBCTD, ' ') AS VARCHAR2(200)),
        CASE WHEN TRIM(TO_CHAR(ni.XUDTIC)) IN ('0','99999999') THEN DATE '0001-01-01'
             ELSE TO_DATE(TRIM(TO_CHAR(ni.XUDTIC)), 'YYYYMMDD') END,
        CAST(TO_CHAR(ic.ZYIDPL) AS VARCHAR2(200)),
        CAST(TO_CHAR(COALESCE(ic.ZYIDIC, ni.XUIDIC)) AS VARCHAR2(200)),
        CAST(m.M_TEL_MOBILE AS VARCHAR2(200)),
        CAST(m.M_EMAIL AS VARCHAR2(200)),
        CAST(TO_CHAR(sc.SCSCCF) AS VARCHAR2(200)),
        CAST(TO_CHAR(COALESCE(ic.ZYC1TR, ni.XUC1TR)) AS VARCHAR2(200)),
        CAST(TO_CHAR(c.ZGDTCT) AS VARCHAR2(200))
    FROM R_CUSTP c
    JOIN MCI m
      ON m.M_CUSTOMER_CODE = c.CC
    LEFT JOIN R_INCIP i
           ON i.CC = c.CC
    LEFT JOIN R_NICIP ni
           ON ni.CC = c.CC
    LEFT JOIN R_GHCLP g
           ON g.VQGHCL = TRIM(c.ZGGHCL)
    LEFT JOIN R_ICADP ic
           ON ic.CC = c.CC
    LEFT JOIN R_SCCIP sc
           ON sc.CC = c.CC
    WHERE NOT EXISTS (SELECT 1 FROM R_PRJIP pj WHERE pj.CC = c.CC)
    UNION ALL
    -- 3. Connected parties SS@NCUSP που δεν είναι πελάτες SSCUSTP ('SS@NCUSPCustomersNotInSSCUSTP')
    SELECT
        m.M_PRFT_CUST_ID,
        CAST('SS@NCUSP' AS VARCHAR2(10)),
        CAST(TO_CHAR(n.ZWDCB) AS VARCHAR2(200)),
        CAST(TO_CHAR(n.ZWDTBR) AS VARCHAR2(200)),
        CAST(TO_CHAR(n.ZWSEX) AS VARCHAR2(200)),
        CAST(TO_CHAR(n.ZWNATY) AS VARCHAR2(200)),
        CAST(TO_CHAR(n.ZWLANG) AS VARCHAR2(200)),
        CAST(TO_CHAR(n.ZWKID) AS VARCHAR2(200)),
        CAST(TO_CHAR(n.ZWEDUC) AS VARCHAR2(200)),
        CAST(TO_CHAR(n.ZWIDTY) AS VARCHAR2(200)),
        CAST(TO_CHAR(n.ZWIDNO) AS VARCHAR2(200)),
        CAST(TO_CHAR(n.ZWTXNO) AS VARCHAR2(200)),
        CAST(TO_CHAR(n.ZWMST) AS VARCHAR2(200)),
        CAST(TO_CHAR(n.ZWINDY) AS VARCHAR2(200)),
        CAST(TO_CHAR(n.ZWOCPT) AS VARCHAR2(200)),
        CAST(NULL AS VARCHAR2(200)),
        CAST(TO_CHAR(n.ZWLGTP) AS VARCHAR2(200)),
        CAST(TO_CHAR(n.ZWPFCM) AS VARCHAR2(200)),
        CAST(TO_CHAR(n.ZWGHCL) AS VARCHAR2(200)),
        CAST(CASE WHEN n.ZWPFCM = 'I' THEN COALESCE(SUBSTR(TRIM(n.ZWF2N1), 1, 20), SUBSTR(TRIM(n.ZWFRN1), 1, 20))
                  ELSE ' ' END AS VARCHAR2(200)),
        CAST(CASE WHEN n.ZWPFCM IN ('I','N') THEN COALESCE(TRIM(n.ZWFRN1), TRIM(n.ZWCSSN)) END
             AS VARCHAR2(200)),
        CAST(NULL AS VARCHAR2(200)),
        CAST(TO_CHAR(n.ZWBCTD) AS VARCHAR2(200)),
        DATE '0001-01-01',
        CAST(NULL AS VARCHAR2(200)),
        CAST(TO_CHAR(n.ZWIDCI) AS VARCHAR2(200)),
        CAST(m.M_TEL_MOBILE AS VARCHAR2(200)),
        CAST(m.M_EMAIL AS VARCHAR2(200)),
        CAST(TO_CHAR(sc.SCSCCF) AS VARCHAR2(200)),
        CAST(NULL AS VARCHAR2(200)),
        CAST(NULL AS VARCHAR2(200))
    FROM R_NCUSP n
    JOIN MCI m
      ON m.M_CUSTOMER_CODE = n.CC
    LEFT JOIN R_SCCIP sc
           ON sc.CC = n.CC
    WHERE NOT EXISTS (SELECT 1 FROM R_CUSTP s WHERE s.CC = n.CC)
  )
),
SPC AS (
    -- CUSTOMER_SPECA (10101) ανά πελάτη: πλήθος κωδικών, κενές γραμμές, serial GENERIC_DETAIL SPECA
    SELECT /*+ MATERIALIZE */
        TO_CHAR(cs.ZGDCB) || LPAD(TO_CHAR(cs.ZGDCS), 6, '0')        AS SPECA_CUST,
        COUNT(DISTINCT TRIM(cs.SPECA))                               AS N_CODES,
        COUNT(CASE WHEN TRIM(cs.SPECA) IS NULL THEN 1 END)           AS N_BLANK,
        MIN(TRIM(cs.SPECA))                                          AS CODE_MIN,
        MAX(TRIM(cs.SPECA))                                          AS CODE_MAX,
        MIN(gd.SERIAL_NUM)                                           AS EXP_SERIAL
    FROM CUSTOMER_SPECA cs
    LEFT JOIN GENERIC_DETAIL gd
           ON gd.FK_GENERIC_HEADPAR = 'SPECA'
          AND TRIM(gd.SHORT_DESCRIPTION) = TRIM(cs.SPECA)
    GROUP BY TO_CHAR(cs.ZGDCB) || LPAD(TO_CHAR(cs.ZGDCS), 6, '0')
),
OID AS (
    -- αριθμοί ID του OTHER_ID ανά πελάτη PROFITS (CM-009), μία φορά αντί για correlated scan
    SELECT /*+ MATERIALIZE */ DISTINCT FK_CUSTOMERCUST_ID AS FK, TRIM(ID_NO) AS ID_NO
    FROM OTHER_ID
    WHERE TRIM(ID_NO) IS NOT NULL
),
GDCC AS (
    -- GENERIC_DETAIL CCODE (19000: SHORT_DESCRIPTION = ZGINDY σε μορφή NN.N / NN.NN).
    -- TRIM: το SHORT_DESCRIPTION είναι CHAR με κενά στο τέλος (το 19000 συγκρίνει CHAR με CHAR)
    SELECT /*+ MATERIALIZE */ TRIM(SHORT_DESCRIPTION) AS SHORT_DESCRIPTION, MIN(SERIAL_NUM) AS SERIAL_NUM
    FROM GENERIC_DETAIL
    WHERE FK_GENERIC_HEADPAR = 'CCODE'
    GROUP BY TRIM(SHORT_DESCRIPTION)
),
GDFS AS (
    SELECT /*+ MATERIALIZE */ DISTINCT SERIAL_NUM
    FROM GENERIC_DETAIL
    WHERE FK_GENERIC_HEADPAR = 'FINSC'
),
ACT AS (
    -- Activity στο PROFITS κατευθείαν από CUSTOMER_CATEGORY: το NCIS_Customers.Activity_Code
    -- είναι C4.FK_CATEGORYCATEGOR (η λέξη 'ACTIVITY') και όχι η τιμή - λάθος του 01_CUSTOMER.sql
    SELECT /*+ MATERIALIZE */ FK_CUSTOMERCUST_ID, MIN(FK_GENERIC_DETASER) AS P_ACTIVITY
    FROM CUSTOMER_CATEGORY
    WHERE FK_CATEGORYCATEGOR = 'ACTIVITY'
    GROUP BY FK_CUSTOMERCUST_ID
),
NA AS (
    SELECT /*+ MATERIALIZE */
        n.*,
        m.M_PRFT_CUST_ID, m.M_CUSTOMER_CODE, m.M_CUST_TYPE, m.M_AFM_TAX_OFFICE, m.M_AFM_NO,
        m.M_LATIN_SURNAME, m.M_NATIONAL, m.M_CITIZEN, m.M_COMLANG, m.M_BCOUNTRY,
        m.M_UDF_TEXT5, m.M_ID_TYPE, m.M_PROFF
    FROM NCIS_Customers n
    LEFT JOIN MCI m
           ON m.M_PRFT_CUST_ID = n.Customer_Code
),
NM AS (
    SELECT /*+ MATERIALIZE */
        a.*,
        CASE WHEN t.ENTRY_STATUS = 1 THEN tx.NEW_VALUE ELSE 0 END    AS E_TAXOF
    FROM NA a
    LEFT JOIN MPP tx
           ON tx.PARAMETER_TYPE = 'TAXOF'
          AND tx.OLD_VALUE = TRIM(a.M_AFM_TAX_OFFICE)
    LEFT JOIN TAX_OFFICE t
           ON t.ID = tx.NEW_VALUE
    WHERE a.M_PRFT_CUST_ID IS NOT NULL
),
B AS (
    SELECT /*+ MATERIALIZE */
        a.*,
        h.*,
        -- Αναμενόμενες τιμές = ΜΟΝΟ ό,τι στέλνουν τα scripts: η τελική τιμή του MG_CUSTOMER_INTER
        -- (12000 + διορθώσεις 12010) μεταφρασμένη με το MG_PARAM_PARAMETER. Καμία δική μας υπόθεση
        -- (defaults, κενό -&gt; κάτι, mapping 0 -&gt; κενό κ.λπ.).
        nat.NEW_VALUE                                   AS E_NATIO,      -- NATIONAL
        ctz.NEW_VALUE                                   AS E_CITIZ,      -- CITIZEN
        lng.NEW_VALUE                                   AS E_COMLA,      -- COMLANG
        edu.NEW_VALUE                                   AS E_EDULV,
        oid.NEW_VALUE                                   AS E_OIDTP,      -- ID_TYPE (12000: B + ZGCTRS MT -&gt; B_MT)
        fam.NEW_VALUE                                   AS E_FALST,
        prf.NEW_VALUE                                   AS E_PROFF,      -- PROFF
        pst.NEW_VALUE                                   AS E_PRFST,
        lgl.NEW_VALUE                                   AS E_LEGAL,
        cob.NEW_VALUE                                   AS E_CNTRY_BIRTH, -- BCOUNTRY
        aml.NEW_VALUE                                   AS E_AMLRI,
        txc.NEW_VALUE                                   AS E_CNTRY_TAX,  -- UDF_TEXT5
        -- Activity / Financial sector (19000): ZGINDY NN.NN -&gt; GENERIC_DETAIL CCODE serial (κατηγορία
        -- ACTIVITY, χωρίς εγγραφή -&gt; 0) -&gt; CAST(serial / 10 AS INT) = GENERIC_DETAIL FINSC serial
        -- (κατηγορίες ECONOMY / ECONOM1). Μόνο CUST_TYPE 1 ενεργοί πελάτες με VQCSTY I / N.
        CASE WHEN h.H_SRC = 'SSCUSTP' AND a.M_CUST_TYPE = '1' AND TRIM(h.H_CSTY) IN ('I','N')
             THEN 1 ELSE 0 END                          AS FIN_SCOPE,
        CASE WHEN h.H_SRC = 'SSCUSTP' AND a.M_CUST_TYPE = '1' AND TRIM(h.H_CSTY) IN ('I','N')
             THEN NVL(gcc.SERIAL_NUM, 0) END            AS E_CCODE,
        CASE WHEN h.H_SRC = 'SSCUSTP' AND a.M_CUST_TYPE = '1' AND TRIM(h.H_CSTY) IN ('I','N')
             THEN gfs.SERIAL_NUM END                    AS E_FINSC,
        act.P_ACTIVITY,
        sp.SPECA_CUST, sp.N_CODES, sp.N_BLANK, sp.CODE_MIN, sp.CODE_MAX, sp.EXP_SERIAL,
        -- scope SPECATEG: ενεργοί πελάτες I/N ή EXN/RCE (όπως τα 4 branches του CUSTOMER_SPECA)
        CASE WHEN h.H_SRC = 'SSCUSTP'
              AND (TRIM(h.H_CSTY) IN ('I','N') OR TRIM(h.H_GHCL) IN ('EXN','RCE'))
             THEN 1 ELSE 0 END                                       AS SPECA_SCOPE
    FROM NM a
    JOIN HUB_C h
      ON h.H_PRFT_CUST_ID = a.Customer_Code
    LEFT JOIN MPP nat ON nat.PARAMETER_TYPE = 'NATIO' AND nat.OLD_VALUE = TRIM(a.M_NATIONAL)
    LEFT JOIN MPP lng ON lng.PARAMETER_TYPE = 'COMLA' AND lng.OLD_VALUE = TRIM(a.M_COMLANG)
    LEFT JOIN MPP edu ON edu.PARAMETER_TYPE = 'EDULV' AND edu.OLD_VALUE = TRIM(h.H_EDUC)
    LEFT JOIN MPP oid ON oid.PARAMETER_TYPE = 'OIDTP' AND oid.OLD_VALUE = TRIM(a.M_ID_TYPE)
    LEFT JOIN MPP fam ON fam.PARAMETER_TYPE = 'FALST' AND fam.OLD_VALUE = TRIM(h.H_MST)
    LEFT JOIN MPP prf ON prf.PARAMETER_TYPE = 'PROFF' AND prf.OLD_VALUE = TRIM(a.M_PROFF)
    LEFT JOIN MPP pst ON pst.PARAMETER_TYPE = 'PRFST' AND pst.OLD_VALUE = TRIM(h.H_OCPT)
    LEFT JOIN MPP lgl ON lgl.PARAMETER_TYPE = 'LEGAL' AND lgl.OLD_VALUE = TRIM(h.H_LGTP)
    LEFT JOIN MPP cob ON cob.PARAMETER_TYPE = 'CNTRY' AND cob.OLD_VALUE = TRIM(a.M_BCOUNTRY)
    LEFT JOIN MPP ctz ON ctz.PARAMETER_TYPE = 'CITIZ' AND ctz.OLD_VALUE = TRIM(a.M_CITIZEN)
    LEFT JOIN MPP aml ON aml.PARAMETER_TYPE = 'AMLRI' AND aml.OLD_VALUE = TRIM(h.H_SCCF)
    LEFT JOIN GDCC gcc ON gcc.SHORT_DESCRIPTION =
              CASE WHEN LENGTH(h.H_INDY) = 3 THEN SUBSTR(h.H_INDY, 1, 2) || '.' || SUBSTR(h.H_INDY, 3, 1)
                   WHEN LENGTH(h.H_INDY) = 4 THEN SUBSTR(h.H_INDY, 1, 2) || '.' || SUBSTR(h.H_INDY, 3, 2)
                   ELSE h.H_INDY END
    LEFT JOIN GDFS gfs ON gfs.SERIAL_NUM = CAST(COALESCE(gcc.SERIAL_NUM, 0) / 10 AS INT)
    LEFT JOIN ACT  act ON act.FK_CUSTOMERCUST_ID = a.Customer_Code
    LEFT JOIN MPP txc ON txc.PARAMETER_TYPE = 'CNTRY'
                     AND txc.OLD_VALUE = TRIM(a.M_UDF_TEXT5)
    LEFT JOIN SPC sp  ON sp.SPECA_CUST = a.M_CUSTOMER_CODE
),
FINDINGS AS (
    -- Μία γραμμή ανά εύρημα. CUSTOMER_CODE = HUB πελάτης (MG_CUSTOMER_INTER.CUSTOMER_CODE,
    -- για synthetic 'SSCAIFP-&lt;serial&gt;'), SERIAL_NO = PROFITS CUST_ID (NCIS Customer_Code).
    -- Πάντα HUB vs NCIS: HUB_VALUE = η τιμή όπως είναι στον πίνακα HUB, NCIS_VALUE = η τιμή
    -- όπως είναι στο NCIS_Customers. Η αναμενόμενη τιμή PROFITS βγαίνει ΜΟΝΟ από τα scripts
    -- (τελική τιμή MG_CUSTOMER_INTER / κανόνες 12000 / 19000 / 19800) και γράφεται στο ISSUE:
    -- 'MISMATCH (EXPECTED &lt;τιμή&gt;)', ή 'NO_MAPPING (SENT &lt;τιμή&gt;)' όταν η τιμή που έστειλε η
    -- μετάπτωση δεν έχει γραμμή στο MG_PARAM_PARAMETER. HUB_VALUE = NULL όπου δεν υπάρχει πηγή
    -- HUB (CM-030 ασφαλιστική ενημερότητα).
    --==============================================================
    --CM-001. Branch_Code vs SSCUSTP.ZGDCB (HUB 999 -&gt; PROFITS 81 θεωρείται σωστό)
    SELECT
      CAST('CM-001_BRANCH_CODE_MISMATCH' AS VARCHAR2(50)) AS CHECK_NAME,
      CAST(M_CUSTOMER_CODE AS VARCHAR2(40)) AS CUSTOMER_CODE, CAST(TO_CHAR(Customer_Code) AS VARCHAR2(40)) AS SERIAL_NO,
      CAST(TRIM(H_DCB) AS VARCHAR2(200)) AS HUB_VALUE, CAST(TRIM(TO_CHAR(Branch_Code)) AS VARCHAR2(200)) AS NCIS_VALUE,
      CAST('MISMATCH' AS VARCHAR2(50)) AS ISSUE
    FROM B
    WHERE NOT (TRIM(H_DCB) = '999' AND TRIM(TO_CHAR(Branch_Code)) = '81')
      AND NVL(TRIM(TO_CHAR(Branch_Code)), 'X') &lt;&gt; NVL(TRIM(H_DCB), 'X')
    UNION ALL
    --==============================================================
    --CM-002. Date_of_Birth vs SSINCIP.ZKDTBR / ZUDTBR / ZWDTBR (κενό HUB -&gt; 0001-01-01 / 1901-01-01;
    --        DC5 19800: CUST_TYPE 3 χωρίς DOB παίρνει την ημερομηνία δημιουργίας)
    SELECT 'CM-002_DATE_OF_BIRTH_MISMATCH', M_CUSTOMER_CODE, TO_CHAR(Customer_Code),
           TRIM(H_DTBR), TO_CHAR(Date_of_Birth, 'YYYYMMDD'),
           CASE WHEN H_DTBR IS NULL OR TRIM(H_DTBR) IN ('0','99999999','-99999999')
                THEN 'NO_DATE_OF_BIRTH_IN_HUB' ELSE 'MISMATCH' END
    FROM B
    WHERE CASE
            WHEN H_DTBR IS NULL OR TRIM(H_DTBR) IN ('0','99999999','-99999999') THEN
                CASE WHEN NVL(TO_CHAR(Date_of_Birth, 'YYYYMMDD'), 'X') IN ('00010101','19010101') THEN 0
                     WHEN TRIM(TO_CHAR(Customer_Type)) = '3'
                      AND TO_CHAR(Date_of_Birth, 'YYYYMMDD') = TO_CHAR(Customer_Creation_Date, 'YYYYMMDD') THEN 0
                     ELSE 1 END
            ELSE
                CASE WHEN NVL(TO_CHAR(Date_of_Birth, 'YYYYMMDD'), 'X') = TRIM(H_DTBR) THEN 0 ELSE 1 END
          END = 1
    UNION ALL
    --==============================================================
    --CM-003. Sex vs SSINCIP.ZKSEX / ZWSEX (κενό HUB για CUST_TYPE 1 ή 'X' -&gt; 'M' θεωρείται σωστό)
    SELECT 'CM-003_SEX_MISMATCH', M_CUSTOMER_CODE, TO_CHAR(Customer_Code), TRIM(H_SEX), TRIM(Sex), 'MISMATCH'
    FROM B
    WHERE CASE WHEN TRIM(TO_CHAR(Customer_Type)) = '1' AND TRIM(H_SEX) IS NULL AND TRIM(Sex) = 'M' THEN 'MATCH_FOUND'
               WHEN TRIM(H_SEX) = 'X' AND TRIM(Sex) = 'M' THEN 'MATCH_FOUND'
               ELSE NVL(TRIM(Sex), 'X') END
       &lt;&gt; CASE WHEN TRIM(TO_CHAR(Customer_Type)) = '1' AND TRIM(H_SEX) IS NULL AND TRIM(Sex) = 'M' THEN 'MATCH_FOUND'
               WHEN TRIM(H_SEX) = 'X' AND TRIM(Sex) = 'M' THEN 'MATCH_FOUND'
               ELSE NVL(TRIM(H_SEX), 'X') END
    UNION ALL
    --==============================================================
    --CM-004. Nationality: HUB ZGNATY / ZUNATY / ZWNATY vs αναμενόμενο = NATIO(MG_CUSTOMER_INTER.NATIONAL)
    SELECT 'CM-004_NATIONALITY_MISMATCH', M_CUSTOMER_CODE, TO_CHAR(Customer_Code),
           TRIM(H_NATY), TRIM(TO_CHAR(Nationality)),
           CASE WHEN TRIM(M_NATIONAL) IS NOT NULL AND E_NATIO IS NULL THEN 'NO_MAPPING (SENT ' || TRIM(M_NATIONAL) || ')'
                WHEN E_NATIO IS NULL THEN 'MISMATCH (EXPECTED EMPTY)'
                ELSE 'MISMATCH (EXPECTED ' || TO_CHAR(E_NATIO) || ')' END
    FROM B
    WHERE NVL(TRIM(TO_CHAR(Nationality)), 'X') &lt;&gt; NVL(TRIM(TO_CHAR(E_NATIO)), 'X')
    UNION ALL
    --==============================================================
    --CM-005. Communication_Language: HUB ZGLANG vs αναμενόμενο = COMLA(MG_CUSTOMER_INTER.COMLANG)
    SELECT 'CM-005_COMMUNICATION_LANGUAGE_MISMATCH', M_CUSTOMER_CODE, TO_CHAR(Customer_Code),
           TRIM(H_LANG), TRIM(TO_CHAR(Communication_Language)),
           CASE WHEN TRIM(M_COMLANG) IS NOT NULL AND E_COMLA IS NULL THEN 'NO_MAPPING (SENT ' || TRIM(M_COMLANG) || ')'
                WHEN E_COMLA IS NULL THEN 'MISMATCH (EXPECTED EMPTY)'
                ELSE 'MISMATCH (EXPECTED ' || TO_CHAR(E_COMLA) || ')' END
    FROM B
    WHERE NVL(TRIM(TO_CHAR(Communication_Language)), 'X') &lt;&gt; NVL(TRIM(TO_CHAR(E_COMLA)), 'X')
    UNION ALL
    --==============================================================
    --CM-006. Number_of_Children vs ZKKID / ZWKID (12000: πάνω από 99 -&gt; 99, αρνητικό -&gt; 0, SSCAIFP = 0)
    SELECT 'CM-006_NUMBER_OF_CHILDREN_MISMATCH', M_CUSTOMER_CODE, TO_CHAR(Customer_Code),
           TRIM(H_KID), TO_CHAR(Number_of_Children), 'MISMATCH'
    FROM B
    WHERE NVL(TO_NUMBER(Number_of_Children), 0)
       &lt;&gt; CASE WHEN NVL(TO_NUMBER(TRIM(H_KID)), 0) &gt; 99 THEN 99
               WHEN NVL(TO_NUMBER(TRIM(H_KID)), 0) &lt; 0  THEN 0
               ELSE NVL(TO_NUMBER(TRIM(H_KID)), 0) END
    UNION ALL
    --==============================================================
    --CM-007. Education_Level vs ZKEDUC / ZWEDUC (EDULV)
    SELECT 'CM-007_EDUCATION_LEVEL_MISMATCH', M_CUSTOMER_CODE, TO_CHAR(Customer_Code),
           TRIM(H_EDUC), TRIM(TO_CHAR(Education_Level)),
           CASE WHEN E_EDULV IS NULL THEN 'NO_MAPPING' ELSE 'MISMATCH (EXPECTED ' || TO_CHAR(E_EDULV) || ')' END
    FROM B
    WHERE NVL(TRIM(TO_CHAR(Education_Level)), 'X') &lt;&gt; NVL(TRIM(TO_CHAR(E_EDULV)), 'X')
    UNION ALL
    --==============================================================
    --CM-008. Identification_ID_Type: HUB ZGIDTY vs αναμενόμενο = OIDTP(MG_CUSTOMER_INTER.ID_TYPE)
    SELECT 'CM-008_ID_TYPE_MISMATCH', M_CUSTOMER_CODE, TO_CHAR(Customer_Code),
           TRIM(H_IDTY), TRIM(TO_CHAR(Identification_ID_Type)),
           CASE WHEN TRIM(M_ID_TYPE) IS NOT NULL AND E_OIDTP IS NULL THEN 'NO_MAPPING (SENT ' || TRIM(M_ID_TYPE) || ')'
                WHEN E_OIDTP IS NULL THEN 'MISMATCH (EXPECTED EMPTY)'
                ELSE 'MISMATCH (EXPECTED ' || TO_CHAR(E_OIDTP) || ')' END
    FROM B
    WHERE NVL(TRIM(TO_CHAR(Identification_ID_Type)), 'X') &lt;&gt; NVL(TRIM(TO_CHAR(E_OIDTP)), 'X')
    UNION ALL
    --==============================================================
    --CM-009. Identification_ID vs ZGIDNO - δεν μετράει όταν ο αριθμός HUB υπάρχει στο OTHER_ID του πελάτη
    SELECT 'CM-009_ID_NUMBER_MISMATCH', b.M_CUSTOMER_CODE, TO_CHAR(b.Customer_Code),
           TRIM(b.H_IDNO), TRIM(b.Identification_ID), 'MISMATCH'
    FROM B b
    WHERE NVL(TRIM(b.Identification_ID), 'X') &lt;&gt; NVL(TRIM(b.H_IDNO), 'X')
      AND b.H_IDNO IS NOT NULL
      AND NOT EXISTS (SELECT 1 FROM OID o
                       WHERE o.ID_NO = TRIM(b.H_IDNO)
                         AND o.FK = b.M_PRFT_CUST_ID)
    UNION ALL
    --==============================================================
    --CM-010. Tax_ID vs ZGTXNO / ZWTXNO (μόνο όπου το PROFITS έχει Tax_ID)
    SELECT 'CM-010_TAX_ID_MISMATCH', M_CUSTOMER_CODE, TO_CHAR(Customer_Code), TRIM(H_TXNO), TRIM(Tax_ID), 'MISMATCH'
    FROM B
    WHERE Tax_ID IS NOT NULL
      AND NVL(TRIM(Tax_ID), 'X') &lt;&gt; NVL(TRIM(H_TXNO), 'X')
    UNION ALL
    --==============================================================
    --CM-011. Family_Status vs ZKMST / ZWMST (FALST)
    SELECT 'CM-011_FAMILY_STATUS_MISMATCH', M_CUSTOMER_CODE, TO_CHAR(Customer_Code),
           TRIM(H_MST), TRIM(TO_CHAR(Family_Status)),
           CASE WHEN E_FALST IS NULL THEN 'NO_MAPPING' ELSE 'MISMATCH (EXPECTED ' || TO_CHAR(E_FALST) || ')' END
    FROM B
    WHERE NVL(TRIM(TO_CHAR(Family_Status)), 'X') &lt;&gt; NVL(TRIM(TO_CHAR(E_FALST)), 'X')
    UNION ALL
    --==============================================================
    --CM-012. Activity (κατηγορία ACTIVITY) vs ZGINDY -&gt; GENERIC_DETAIL CCODE serial (19000).
    --        PROFITS τιμή από CUSTOMER_CATEGORY (το NCIS_Customers.Activity_Code είναι λάθος στήλη).
    --        Μόνο CUST_TYPE 1 ενεργοί πελάτες I / N (FIN_SCOPE), όπου ο κανόνας του 19000 είναι γνωστός.
    SELECT 'CM-012_ACTIVITY_CODE_MISMATCH', M_CUSTOMER_CODE, TO_CHAR(Customer_Code),
           TRIM(H_INDY), TRIM(TO_CHAR(P_ACTIVITY)),
           CASE WHEN E_CCODE = 0 THEN 'NO_CCODE_FOR_HUB_VALUE (EXPECTED 0)'
                ELSE 'MISMATCH (EXPECTED ' || TO_CHAR(E_CCODE) || ')' END
    FROM B
    WHERE FIN_SCOPE = 1
      AND NVL(TRIM(TO_CHAR(P_ACTIVITY)), 'X') &lt;&gt; NVL(TO_CHAR(E_CCODE), 'X')
    UNION ALL
    --==============================================================
    --CM-013. Profession: HUB ZGINDY vs αναμενόμενο = PROFF(MG_CUSTOMER_INTER.PROFF)
    SELECT 'CM-013_PROFESSION_MISMATCH', M_CUSTOMER_CODE, TO_CHAR(Customer_Code),
           TRIM(H_INDY), TRIM(TO_CHAR(Profession)),
           CASE WHEN TRIM(M_PROFF) IS NOT NULL AND E_PROFF IS NULL THEN 'NO_MAPPING (SENT ' || TRIM(M_PROFF) || ')'
                WHEN E_PROFF IS NULL THEN 'MISMATCH (EXPECTED EMPTY)'
                ELSE 'MISMATCH (EXPECTED ' || TO_CHAR(E_PROFF) || ')' END
    FROM B
    WHERE NVL(TRIM(TO_CHAR(Profession)), 'X') &lt;&gt; NVL(TRIM(TO_CHAR(E_PROFF)), 'X')
    UNION ALL
    --==============================================================
    --CM-014. Professional_Status vs ZKOCPT / ZWOCPT (PRFST)
    SELECT 'CM-014_PROFESSIONAL_STATUS_MISMATCH', M_CUSTOMER_CODE, TO_CHAR(Customer_Code),
           TRIM(H_OCPT), TRIM(TO_CHAR(Professional_Status)),
           CASE WHEN E_PRFST IS NULL THEN 'NO_MAPPING' ELSE 'MISMATCH (EXPECTED ' || TO_CHAR(E_PRFST) || ')' END
    FROM B
    WHERE NVL(TRIM(TO_CHAR(Professional_Status)), 'X') &lt;&gt; NVL(TRIM(TO_CHAR(E_PRFST)), 'X')
    UNION ALL
    --==============================================================
    --CM-015. Corporation_Registry_Number vs SSNICIP.XUINCN (νομικά πρόσωπα, όπου υπάρχει τιμή HUB)
    SELECT 'CM-015_CORP_REGISTRY_NUMBER_MISMATCH', M_CUSTOMER_CODE, TO_CHAR(Customer_Code),
           TRIM(H_INCN), TRIM(Corporation_Registry_Number), 'MISMATCH'
    FROM B
    WHERE TRIM(H_CSTY) = 'N'
      AND H_INCN IS NOT NULL
      AND NVL(TRIM(Corporation_Registry_Number), 'X') &lt;&gt; NVL(TRIM(H_INCN), 'X')
    UNION ALL
    --==============================================================
    --CM-016. Legal_Form vs ZGLGTP (LEGAL, νομικά πρόσωπα). DC5: χωρίς γραμμή LEGAL -&gt; default 0 (12000).
    --        Η κατηγορία LAWSHAPE δημιουργείται (19000) μόνο για πελάτες SSCUSTP -&gt; για SSCAIFP / SS@NCUSP αναμένεται κενό
    SELECT 'CM-016_LEGAL_FORM_MISMATCH', M_CUSTOMER_CODE, TO_CHAR(Customer_Code),
           TRIM(H_LGTP), TRIM(TO_CHAR(Legal_Form)),
           CASE WHEN H_SRC &lt;&gt; 'SSCUSTP' THEN 'MISMATCH (EXPECTED EMPTY, NOT SSCUSTP)'
                WHEN E_LEGAL IS NULL THEN 'NO_MAPPING (EXPECTED DEFAULT 0)'
                ELSE 'MISMATCH (EXPECTED ' || TO_CHAR(E_LEGAL) || ')' END
    FROM B
    WHERE TRIM(H_CSTY) = 'N'
      AND NVL(TRIM(TO_CHAR(Legal_Form)), 'X')
       &lt;&gt; CASE WHEN H_SRC = 'SSCUSTP' THEN TRIM(TO_CHAR(NVL(E_LEGAL, 0))) ELSE 'X' END
    UNION ALL
    --==============================================================
    --CM-017. Customer_Type vs VQCSTY / ZUCSTY / ZWPFCM (I -&gt; 1, N -&gt; 2, αλλιώς 3)
    SELECT 'CM-017_CUSTOMER_TYPE_MISMATCH', M_CUSTOMER_CODE, TO_CHAR(Customer_Code),
           TRIM(H_CSTY), TRIM(TO_CHAR(Customer_Type)),
           'MISMATCH (EXPECTED ' || CASE TRIM(H_CSTY) WHEN 'I' THEN '1' WHEN 'N' THEN '2' ELSE '3' END || ')'
    FROM B
    WHERE NVL(TRIM(TO_CHAR(Customer_Type)), 'X') &lt;&gt; CASE TRIM(H_CSTY) WHEN 'I' THEN '1' WHEN 'N' THEN '2' ELSE '3' END
    UNION ALL
    --==============================================================
    --CM-018. First_Name vs όνομα όπως το υπολογίζει το 12000 (ανά branch)
    SELECT 'CM-018_FIRST_NAME_MISMATCH', M_CUSTOMER_CODE, TO_CHAR(Customer_Code), TRIM(H_FIRST), TRIM(First_Name), 'MISMATCH'
    FROM B
    WHERE NVL(TRIM(First_Name), 'X') &lt;&gt; NVL(TRIM(H_FIRST), 'X')
    UNION ALL
    --==============================================================
    --CM-019. Surname vs επώνυμο / επωνυμία όπως το υπολογίζει το 12000 (ανά branch). Το PROFITS βάζει
    --        'UNKNOWN' για κενό επώνυμο, και το 19800 το αντικαθιστά με το LATIN_SURNAME για CUST_TYPE 2
    SELECT 'CM-019_LAST_NAME_MISMATCH', M_CUSTOMER_CODE, TO_CHAR(Customer_Code),
           CASE WHEN TRIM(H_LAST) IS NULL AND M_CUST_TYPE = '2' THEN TRIM(M_LATIN_SURNAME) ELSE TRIM(H_LAST) END,
           TRIM(Surname),
           CASE WHEN TRIM(H_LAST) IS NULL AND M_CUST_TYPE = '2' THEN 'MISMATCH (EXPECTED LATIN SURNAME, 19800)'
                ELSE 'MISMATCH' END
    FROM B
    WHERE NVL(NULLIF(TRIM(Surname), 'UNKNOWN'), 'X')
       &lt;&gt; NVL(CASE WHEN TRIM(H_LAST) IS NULL AND M_CUST_TYPE = '2' THEN TRIM(M_LATIN_SURNAME)
                   ELSE TRIM(H_LAST) END, 'X')
    UNION ALL
    --==============================================================
    --CM-020. Father_Name vs SSINCIP.ZKSPNM (20 χαρ.; SSCAIFP / SS@NCUSP κενό από τη μετάπτωση)
    SELECT 'CM-020_FATHER_NAME_MISMATCH', M_CUSTOMER_CODE, TO_CHAR(Customer_Code), TRIM(H_FATHER), TRIM(Father_Name), 'MISMATCH'
    FROM B
    WHERE NVL(TRIM(Father_Name), 'X') &lt;&gt; NVL(TRIM(H_FATHER), 'X')
    UNION ALL
    --==============================================================
    --CM-021. Country_of_Birth: HUB ZYBCTD / ZUBCTD / ZWBCTD vs αναμενόμενο = CNTRY(MG_CUSTOMER_INTER.BCOUNTRY)
    SELECT 'CM-021_COUNTRY_OF_BIRTH_MISMATCH', M_CUSTOMER_CODE, TO_CHAR(Customer_Code),
           TRIM(H_BCTD), TRIM(TO_CHAR(Country_of_Birth)),
           CASE WHEN TRIM(M_BCOUNTRY) IS NOT NULL AND E_CNTRY_BIRTH IS NULL THEN 'NO_MAPPING (SENT ' || TRIM(M_BCOUNTRY) || ')'
                WHEN E_CNTRY_BIRTH IS NULL THEN 'MISMATCH (EXPECTED EMPTY)'
                ELSE 'MISMATCH (EXPECTED ' || TO_CHAR(E_CNTRY_BIRTH) || ')' END
    FROM B
    WHERE NVL(TRIM(TO_CHAR(Country_of_Birth)), 'X') &lt;&gt; NVL(TRIM(TO_CHAR(E_CNTRY_BIRTH)), 'X')
    UNION ALL
    --==============================================================
    --CM-022. Identification_ID_Issue_Date vs SSNICIP.XUDTIC (κενό = 0001-01-01)
    SELECT 'CM-022_ID_ISSUE_DATE_MISMATCH', M_CUSTOMER_CODE, TO_CHAR(Customer_Code),
           TO_CHAR(H_DTIC, 'YYYYMMDD'), TO_CHAR(Identification_ID_Issue_Date, 'YYYYMMDD'), 'MISMATCH'
    FROM B
    WHERE NVL(TO_CHAR(Identification_ID_Issue_Date, 'YYYYMMDD'), '00010101') &lt;&gt; NVL(TO_CHAR(H_DTIC, 'YYYYMMDD'), '00010101')
    UNION ALL
    --==============================================================
    --CM-023. Identification_ID_Issue_Authority vs SSICADP.ZYIDPL
    SELECT 'CM-023_ID_ISSUE_AUTHORITY_MISMATCH', M_CUSTOMER_CODE, TO_CHAR(Customer_Code),
           TRIM(H_IDPL), TRIM(Identification_ID_Issue_Authority), 'MISMATCH'
    FROM B
    WHERE NVL(TRIM(Identification_ID_Issue_Authority), 'X') &lt;&gt; NVL(TRIM(H_IDPL), 'X')
    -- CM-024 (ID issue country) και CM-025 (Tax office): INFO, μόνο Master (βλ. FINDINGS_COUNT)
    UNION ALL
    --==============================================================
    --CM-026. Mobile_Telephone vs MG_CUSTOMER_INTER.TELEPHONE_MOBILE, δηλαδή η τιμή που διάλεξε το 12000
    --        (κύρια διεύθυνση του 10900, 15 πρώτοι χαρακτήρες, JH / J/H -&gt; κενό, SSCAIFP / SS@NCUSP κενό)
    SELECT 'CM-026_MOBILE_TELEPHONE_MISMATCH', M_CUSTOMER_CODE, TO_CHAR(Customer_Code),
           TRIM(H_TEN3), TRIM(Mobile_Telephone), 'MISMATCH'
    FROM B
    WHERE NVL(TRIM(Mobile_Telephone), 'X') &lt;&gt; NVL(TRIM(H_TEN3), 'X')
    UNION ALL
    --==============================================================
    --CM-027. Email vs MG_CUSTOMER_INTER.E_MAIL, δηλαδή η τιμή που διάλεξε το 12000 (κύρια διεύθυνση του 10900,
    --        JH / J/H -&gt; κενό, SSCAIFP / SS@NCUSP κενό)
    SELECT 'CM-027_EMAIL_MISMATCH', M_CUSTOMER_CODE, TO_CHAR(Customer_Code),
           TRIM(H_IADD), TRIM(email), 'MISMATCH'
    FROM B
    WHERE NVL(TRIM(email), 'X') &lt;&gt; NVL(TRIM(H_IADD), 'X')
    UNION ALL
    --==============================================================
    --CM-028. Citizenship: HUB ZGNATY / ZUNATY / ZWNATY vs αναμενόμενο = CITIZ(MG_CUSTOMER_INTER.CITIZEN)
    SELECT 'CM-028_CITIZENSHIP_MISMATCH', M_CUSTOMER_CODE, TO_CHAR(Customer_Code),
           TRIM(H_NATY), TRIM(TO_CHAR(Citizenship)),
           CASE WHEN TRIM(M_CITIZEN) IS NOT NULL AND E_CITIZ IS NULL THEN 'NO_MAPPING (SENT ' || TRIM(M_CITIZEN) || ')'
                WHEN E_CITIZ IS NULL THEN 'MISMATCH (EXPECTED EMPTY)'
                ELSE 'MISMATCH (EXPECTED ' || TO_CHAR(E_CITIZ) || ')' END
    FROM B
    WHERE NVL(TRIM(TO_CHAR(Citizenship)), 'X') &lt;&gt; NVL(TRIM(TO_CHAR(E_CITIZ)), 'X')
    UNION ALL
    --==============================================================
    --CM-029. Financial_Sector (κατηγορία ECONOM1) vs ZGINDY -&gt; CCODE serial / 10 -&gt; GENERIC_DETAIL FINSC (19000)
    --        Μόνο CUST_TYPE 1 ενεργοί πελάτες I / N (FIN_SCOPE)
    SELECT 'CM-029_FINANCIAL_SECTOR_MISMATCH', M_CUSTOMER_CODE, TO_CHAR(Customer_Code),
           TRIM(H_INDY), TRIM(TO_CHAR(Financial_Sector)),
           CASE WHEN E_FINSC IS NULL THEN 'NO_FINSC_FOR_HUB_VALUE (EXPECTED EMPTY)'
                ELSE 'MISMATCH (EXPECTED ' || TO_CHAR(E_FINSC) || ')' END
    FROM B
    WHERE FIN_SCOPE = 1
      AND NVL(TRIM(TO_CHAR(Financial_Sector)), 'X') &lt;&gt; NVL(TO_CHAR(E_FINSC), 'X')
    UNION ALL
    --==============================================================
    --CM-030. Insurance_Clearance_Expiration_Date &lt;&gt; 0001-01-01 (INFO, όλοι οι NCIS πελάτες, χωρίς πηγή HUB)
    --        DC5: το reset μεταφέρθηκε στο 19800, πριν το 40050 (γρ. 501) που βάζει 2999-12-31 σε όλους
    SELECT 'CM-030_INSURANCE_DATE_NOT_RESET', NVL(M_CUSTOMER_CODE, TO_CHAR(Customer_Code)), TO_CHAR(Customer_Code),
           CAST(NULL AS VARCHAR2(200)), TO_CHAR(Insurance_Clearance_Expiration_Date, 'YYYYMMDD'),
           CASE WHEN TO_CHAR(Insurance_Clearance_Expiration_Date, 'YYYYMMDD') = '29991231'
                THEN 'SET_TO_29991231_BY_40050 (EXPECTED 00010101)' ELSE 'OTHER_VALUE (EXPECTED 00010101)' END
    FROM NA
    WHERE NVL(TO_CHAR(Insurance_Clearance_Expiration_Date, 'YYYYMMDD'), 'X') &lt;&gt; '00010101'
    UNION ALL
    --==============================================================
    --CM-033. Special_Agreements (SPECATEG) vs κωδικός CUSTOMER_SPECA (10101) -&gt; serial GENERIC_DETAIL SPECA
    --        DC5 19000. Μόνο πελάτες με κωδικό - χωρίς / κενό κωδικό -&gt; CM-038
    SELECT 'CM-033_SPECIAL_AGREEMENTS_MISMATCH', M_CUSTOMER_CODE, TO_CHAR(Customer_Code),
           CODE_MIN || CASE WHEN N_CODES &gt; 1 THEN ' | ' || CODE_MAX END,
           TRIM(TO_CHAR(Special_Agreements)),
           CASE WHEN EXP_SERIAL IS NULL THEN 'CODE_NOT_IN_GENERIC_DETAIL'
                ELSE 'MISMATCH (EXPECTED ' || TO_CHAR(EXP_SERIAL) || ')' END
    FROM B
    WHERE N_CODES &gt; 0
      AND NVL(TRIM(TO_CHAR(Special_Agreements)), 'X') &lt;&gt; NVL(TRIM(TO_CHAR(EXP_SERIAL)), 'X')
    UNION ALL
    --==============================================================
    --CM-034. Tax_ID_Issue_Country: HUB ZYC1TR / XUC1TR vs αναμενόμενο = CNTRY(MG_CUSTOMER_INTER.UDF_TEXT5)
    SELECT 'CM-034_TAX_ID_ISSUE_COUNTRY_MISMATCH', M_CUSTOMER_CODE, TO_CHAR(Customer_Code),
           TRIM(H_C1TR), TRIM(TO_CHAR(Tax_ID_Issue_Country)),
           CASE WHEN TRIM(M_UDF_TEXT5) IS NOT NULL AND E_CNTRY_TAX IS NULL THEN 'NO_MAPPING (SENT ' || TRIM(M_UDF_TEXT5) || ')'
                WHEN E_CNTRY_TAX IS NULL THEN 'MISMATCH (EXPECTED EMPTY)'
                ELSE 'MISMATCH (EXPECTED ' || TO_CHAR(E_CNTRY_TAX) || ')' END
    FROM B
    WHERE NVL(TRIM(TO_CHAR(Tax_ID_Issue_Country)), 'X') &lt;&gt; NVL(TRIM(TO_CHAR(E_CNTRY_TAX)), 'X')
    UNION ALL
    --==============================================================
    --CM-035. Customer_Creation_Date vs SSCUSTP.ZGDTCT (INFO: η διόρθωση είναι απενεργοποιημένη στο 19800, CHS-544)
    SELECT 'CM-035_CREATION_DATE_MISMATCH', M_CUSTOMER_CODE, TO_CHAR(Customer_Code),
           TRIM(H_DTCT), TO_CHAR(Customer_Creation_Date, 'YYYYMMDD'), 'MISMATCH'
    FROM B
    WHERE M_CUST_TYPE IN ('1','2')
      AND NVL(TO_CHAR(Customer_Creation_Date, 'YYYYMMDD'), 'X')
       &lt;&gt; NVL(CASE WHEN TRIM(H_DTCT) IN ('0','99999999') THEN 'X'
                   ELSE TO_CHAR(TO_DATE(TRIM(H_DTCT), 'YYYYMMDD'), 'YYYYMMDD') END, 'X')
    UNION ALL
    --==============================================================
    --CM-036. AMLRICAT vs SSSCCIP.SCSCCF (AMLRI). Διόρθωση: το παλιό CM-037 μετρούσε με '=' αντί '&lt;&gt;'
    SELECT 'CM-036_AMLRICAT_MISMATCH', M_CUSTOMER_CODE, TO_CHAR(Customer_Code),
           TRIM(H_SCCF), TRIM(TO_CHAR(AMLRICAT)),
           CASE WHEN TRIM(H_SCCF) IS NOT NULL AND E_AMLRI IS NULL THEN 'NO_MAPPING'
                ELSE 'MISMATCH (EXPECTED ' || NVL(TO_CHAR(E_AMLRI), 'EMPTY') || ')' END
    FROM B
    WHERE NVL(TRIM(TO_CHAR(AMLRICAT)), 'X') &lt;&gt; NVL(TRIM(TO_CHAR(E_AMLRI)), 'X')
    UNION ALL
    --==============================================================
    --CM-038. Πελάτης SPECATEG scope χωρίς κωδικό στο CUSTOMER_SPECA ή μόνο με κενό κωδικό (F1 / F11)
    SELECT 'CM-038_SPECIAL_AGREEMENTS_CODE_MISSING', M_CUSTOMER_CODE, TO_CHAR(Customer_Code),
           'GHO=' || TRIM(H_GHCL) || '; TYPE=' || TRIM(H_CSTY), TRIM(TO_CHAR(Special_Agreements)),
           CASE WHEN SPECA_CUST IS NULL THEN 'NOT_IN_CUSTOMER_SPECA' ELSE 'BLANK_CODE_IN_CUSTOMER_SPECA' END
    FROM B
    WHERE SPECA_SCOPE = 1
      AND NVL(N_CODES, 0) = 0
    UNION ALL
    --==============================================================
    --CM-039. Πελάτης με περισσότερους από έναν κωδικούς στο CUSTOMER_SPECA (F3) - το 19000 φορτώνει όλους
    SELECT 'CM-039_SPECIAL_AGREEMENTS_MULTIPLE_CODES', M_CUSTOMER_CODE, TO_CHAR(Customer_Code),
           TO_CHAR(N_CODES) || ' codes: ' || CODE_MIN || ' | ' || CODE_MAX, TRIM(TO_CHAR(Special_Agreements)),
           'MULTIPLE_CODES'
    FROM B
    WHERE N_CODES &gt; 1
)
,
POPULATIONS AS (
    SELECT
        (SELECT COUNT(*) FROM B)                                         AS MATCHED_COUNT,
        (SELECT COUNT(*) FROM B WHERE TRIM(H_CSTY) = 'N')                AS MATCHED_N_COUNT,
        (SELECT COUNT(*) FROM B WHERE M_CUST_TYPE IN ('1','2'))          AS MATCHED_12_COUNT,
        (SELECT COUNT(*) FROM NM)                                        AS NCIS_LOADED_COUNT,
        (SELECT COUNT(*) FROM NCIS_Customers)                            AS NCIS_ALL_COUNT,
        (SELECT COUNT(*) FROM B WHERE N_CODES &gt; 0)                       AS SPECA_CODED_COUNT,
        (SELECT COUNT(*) FROM B WHERE SPECA_SCOPE = 1)                   AS SPECA_SCOPE_COUNT,
        (SELECT COUNT(*) FROM B WHERE FIN_SCOPE = 1)                     AS FIN_SCOPE_COUNT
    FROM DUAL
),
CHECK_META AS (
    -- CHECK_ID | CHECK_NAME | CATEGORY | DESCRIPTION | POPULATION_TYPE
    SELECT 'CM-001' AS CHECK_ID, 'CM-001_BRANCH_CODE_MISMATCH' AS CHECK_NAME, 'CROSS_SYSTEM_MISMATCH' AS CATEGORY, 'Branch of the customer in PROFITS is not the HUB branch. HUB branch 999 moved to PROFITS branch 81 is accepted (explained in the DC4 review, not a migration script rule).' AS DESCRIPTION, 'MATCHED' AS POPULATION_TYPE FROM DUAL UNION ALL
    SELECT 'CM-002', 'CM-002_DATE_OF_BIRTH_MISMATCH',              'CROSS_SYSTEM_MISMATCH', 'Date of birth in PROFITS differs from HUB. Empty HUB date: 01/01/0001 or 01/01/1901 accepted (1901 explained in the DC4 review, not a script rule); other types: creation date.', 'MATCHED' FROM DUAL UNION ALL
    SELECT 'CM-003', 'CM-003_SEX_MISMATCH',                        'CROSS_SYSTEM_MISMATCH', 'Sex in PROFITS differs from HUB. Unknown (X) migrated as male is accepted; empty migrated as male is also accepted for individuals (explained in the DC4 review, not a script rule).', 'MATCHED' FROM DUAL UNION ALL
    SELECT 'CM-004', 'CM-004_NATIONALITY_MISMATCH',                'CROSS_SYSTEM_MISMATCH', 'Nationality in PROFITS differs from the HUB nationality translated to its PROFITS code.', 'MATCHED' FROM DUAL UNION ALL
    SELECT 'CM-005', 'CM-005_COMMUNICATION_LANGUAGE_MISMATCH',     'CROSS_SYSTEM_MISMATCH', 'Communication language in PROFITS differs from the HUB language translated to its PROFITS code.', 'MATCHED' FROM DUAL UNION ALL
    SELECT 'CM-006', 'CM-006_NUMBER_OF_CHILDREN_MISMATCH',         'CROSS_SYSTEM_MISMATCH', 'Number of children in PROFITS differs from HUB. Values above 99 are expected as 99.', 'MATCHED' FROM DUAL UNION ALL
    SELECT 'CM-007', 'CM-007_EDUCATION_LEVEL_MISMATCH',            'CROSS_SYSTEM_MISMATCH', 'Education level in PROFITS differs from the HUB education level translated to its PROFITS code.', 'MATCHED' FROM DUAL UNION ALL
    SELECT 'CM-008', 'CM-008_ID_TYPE_MISMATCH',                    'CROSS_SYSTEM_MISMATCH', 'Identification document type in PROFITS differs from the HUB document type translated to its PROFITS code.', 'MATCHED' FROM DUAL UNION ALL
    SELECT 'CM-009', 'CM-009_ID_NUMBER_MISMATCH',                  'CROSS_SYSTEM_MISMATCH', 'Identification number in PROFITS differs from HUB and the HUB number is not held as another ID of the customer. To be confirmed.', 'MATCHED' FROM DUAL UNION ALL
    SELECT 'CM-010', 'CM-010_TAX_ID_MISMATCH',                     'CROSS_SYSTEM_MISMATCH', 'Tax ID in PROFITS differs from the HUB tax number the migration uses: tax ID for individuals, VAT number for companies (only customers with a tax ID in PROFITS).', 'MATCHED' FROM DUAL UNION ALL
    SELECT 'CM-011', 'CM-011_FAMILY_STATUS_MISMATCH',              'CROSS_SYSTEM_MISMATCH', 'Family status in PROFITS differs from the HUB marital status translated to its PROFITS code.', 'MATCHED' FROM DUAL UNION ALL
    SELECT 'CM-012', 'CM-012_ACTIVITY_CODE_MISMATCH',              'CROSS_SYSTEM_MISMATCH', 'Individuals: the activity category in PROFITS (read from the customer categories) differs from the activity code the migration builds from the HUB industry code.', 'FIN_SCOPE' FROM DUAL UNION ALL
    SELECT 'CM-013', 'CM-013_PROFESSION_MISMATCH',                 'CROSS_SYSTEM_MISMATCH', 'Profession in PROFITS differs from the HUB industry code translated to its PROFITS profession code.', 'MATCHED' FROM DUAL UNION ALL
    SELECT 'CM-014', 'CM-014_PROFESSIONAL_STATUS_MISMATCH',        'CROSS_SYSTEM_MISMATCH', 'Professional status in PROFITS differs from the HUB occupation code translated to its PROFITS code.', 'MATCHED' FROM DUAL UNION ALL
    SELECT 'CM-015', 'CM-015_CORP_REGISTRY_NUMBER_MISMATCH',       'CROSS_SYSTEM_MISMATCH', 'Companies: the registry number in PROFITS differs from the HUB company registration number.', 'MATCHED_N' FROM DUAL UNION ALL
    SELECT 'CM-016', 'CM-016_LEGAL_FORM_MISMATCH',                 'CROSS_SYSTEM_MISMATCH', 'Companies: the legal form in PROFITS differs from the HUB legal type translated to its PROFITS code (0 when there is no translation).', 'MATCHED_N' FROM DUAL UNION ALL
    SELECT 'CM-017', 'CM-017_CUSTOMER_TYPE_MISMATCH',              'CROSS_SYSTEM_MISMATCH', 'Customer type in PROFITS differs from HUB: individuals should be 1, companies 2 and any other customer 3.', 'MATCHED' FROM DUAL UNION ALL
    SELECT 'CM-018', 'CM-018_FIRST_NAME_MISMATCH',                 'CROSS_SYSTEM_MISMATCH', 'First name in PROFITS differs from the first name the migration builds from the HUB name fields.', 'MATCHED' FROM DUAL UNION ALL
    SELECT 'CM-019', 'CM-019_LAST_NAME_MISMATCH',                  'CROSS_SYSTEM_MISMATCH', 'Surname or company name in PROFITS differs from the name the migration builds from the HUB name fields.', 'MATCHED' FROM DUAL UNION ALL
    SELECT 'CM-020', 'CM-020_FATHER_NAME_MISMATCH',                'CROSS_SYSTEM_MISMATCH', 'Father name in PROFITS differs from HUB (first 20 characters).', 'MATCHED' FROM DUAL UNION ALL
    SELECT 'CM-021', 'CM-021_COUNTRY_OF_BIRTH_MISMATCH',           'CROSS_SYSTEM_MISMATCH', 'Country of birth in PROFITS differs from the country of birth the migration sends, translated to its PROFITS code.', 'MATCHED' FROM DUAL UNION ALL
    SELECT 'CM-022', 'CM-022_ID_ISSUE_DATE_MISMATCH',              'CROSS_SYSTEM_MISMATCH', 'Identification issue date in PROFITS differs from the HUB date of incorporation. Empty dates are expected as 01/01/0001.', 'MATCHED' FROM DUAL UNION ALL
    SELECT 'CM-023', 'CM-023_ID_ISSUE_AUTHORITY_MISMATCH',         'CROSS_SYSTEM_MISMATCH', 'Identification issue authority in PROFITS differs from the HUB document issue place.', 'MATCHED' FROM DUAL UNION ALL
    SELECT 'CM-024', 'CM-024_ID_ISSUE_COUNTRY_MISMATCH',           'INFO',                  'Information only: identification issue country differs from HUB. The PROFITS extract takes the wrong column and the migration sets Malta. No detail rows.', 'MATCHED' FROM DUAL UNION ALL
    SELECT 'CM-025', 'CM-025_TAX_OFFICE_MISMATCH',                 'INFO',                  'Information only: tax office in PROFITS differs from the migration default. There is no tax office field in HUB. No detail rows.', 'NCIS_LOADED' FROM DUAL UNION ALL
    SELECT 'CM-026', 'CM-026_MOBILE_TELEPHONE_MISMATCH',           'CROSS_SYSTEM_MISMATCH', 'Mobile number in PROFITS differs from the mobile number the migration selected from the main HUB address.', 'MATCHED' FROM DUAL UNION ALL
    SELECT 'CM-027', 'CM-027_EMAIL_MISMATCH',                      'CROSS_SYSTEM_MISMATCH', 'Email in PROFITS differs from the email the migration selected from the main HUB address.', 'MATCHED' FROM DUAL UNION ALL
    SELECT 'CM-028', 'CM-028_CITIZENSHIP_MISMATCH',                'CROSS_SYSTEM_MISMATCH', 'Citizenship in PROFITS differs from the HUB nationality translated to its PROFITS citizenship code.', 'MATCHED' FROM DUAL UNION ALL
    SELECT 'CM-029', 'CM-029_FINANCIAL_SECTOR_MISMATCH',           'CROSS_SYSTEM_MISMATCH', 'Individuals: the financial sector in PROFITS differs from the sector the migration derives from the HUB industry code (activity code divided by 10).', 'FIN_SCOPE' FROM DUAL UNION ALL
    SELECT 'CM-030', 'CM-030_INSURANCE_DATE_NOT_RESET',            'INFO',                  'Information only: customers whose insurance clearance date is not 01/01/0001 as the migration intends. A loan script may set 31/12/2999 after the reset.', 'NCIS_ALL' FROM DUAL UNION ALL
    SELECT 'CM-031', 'CM-031_CORP_REGISTRY_ISSUE_COUNTRY',         'INFO',                  'Information only: customers with a company registry issue country in PROFITS. No HUB source is known yet. No detail rows.', 'NCIS_ALL' FROM DUAL UNION ALL
    SELECT 'CM-032', 'CM-032_RISK_CLASSIFICATION',                 'INFO',                  'Information only: customers with a risk classification in PROFITS. The HUB mapping is not confirmed, so no comparison is made. No detail rows.', 'MATCHED' FROM DUAL UNION ALL
    SELECT 'CM-033', 'CM-033_SPECIAL_AGREEMENTS_MISMATCH',         'CROSS_SYSTEM_MISMATCH', 'Special agreements category in PROFITS differs from the agreed code of the migration rule (only customers that have a code).', 'SPECA_CODED' FROM DUAL UNION ALL
    SELECT 'CM-034', 'CM-034_TAX_ID_ISSUE_COUNTRY_MISMATCH',       'CROSS_SYSTEM_MISMATCH', 'Tax residence country in PROFITS differs from HUB translated to its PROFITS code. Expected empty when the tax number is empty.', 'MATCHED' FROM DUAL UNION ALL
    SELECT 'CM-035', 'CM-035_CREATION_DATE_MISMATCH',              'INFO',                  'Information only: creation date in PROFITS differs from the HUB contact date. The migration fix for this is switched off.', 'MATCHED_12' FROM DUAL UNION ALL
    SELECT 'CM-036', 'CM-036_AMLRICAT_MISMATCH',                   'CROSS_SYSTEM_MISMATCH', 'AML risk category in PROFITS differs from the HUB special category code translated to its PROFITS code.', 'MATCHED' FROM DUAL UNION ALL
    SELECT 'CM-037', 'CM-037_CUSTOMER_ENTRY_COMMENTS',             'INFO',                  'Information only: customers with entry comments in PROFITS. There is no HUB source. No detail rows.', 'NCIS_ALL' FROM DUAL UNION ALL
    SELECT 'CM-038', 'CM-038_SPECIAL_AGREEMENTS_CODE_MISSING',     'EXISTENCE',             'Customers that should get a special agreements category but have no code, or only an empty code, in the migration rule table.', 'SPECA_SCOPE' FROM DUAL UNION ALL
    SELECT 'CM-039', 'CM-039_SPECIAL_AGREEMENTS_MULTIPLE_CODES',   'DUPLICATE',             'Customers with more than one special agreements code in the migration rule table, so more than one category may be loaded.', 'SPECA_CODED' FROM DUAL
),
FINDINGS_COUNT AS (
    SELECT CHECK_ID, COUNT(*) AS INVALID_COUNT
    FROM (SELECT SUBSTR(CHECK_NAME, 1, INSTR(CHECK_NAME, '_') - 1) AS CHECK_ID FROM FINDINGS)
    GROUP BY CHECK_ID
    UNION ALL
    -- CM-024 / 025 / 031 / 032 / 037 (INFO, μόνο Master)
    -- CM-024: NCIS Identification_ID_Issue_Country = O.FKGD_HAS_TYPE (λάθος στήλη στο 01_CUSTOMER.sql)
    SELECT 'CM-024', COUNT(*) FROM B WHERE NVL(TRIM(Identification_ID_Issue_Country), 'X') &lt;&gt; NVL(TRIM(H_IDIC), 'X')
    UNION ALL
    -- CM-025: Tax office - δεν υπάρχει πεδίο στο HUB, η μετάπτωση βάζει default
    SELECT 'CM-025', COUNT(*) FROM NM WHERE NVL(TRIM(TO_CHAR(Tax_ID_Office)), 'X') &lt;&gt; NVL(TRIM(TO_CHAR(E_TAXOF)), 'X')
    UNION ALL
    SELECT 'CM-031', COUNT(*) FROM NCIS_Customers WHERE Corporation_Registry_Number_Issue_Country IS NOT NULL
    UNION ALL
    SELECT 'CM-032', COUNT(*) FROM B WHERE Risk_Classification IS NOT NULL
    UNION ALL
    SELECT 'CM-037', COUNT(*) FROM NCIS_Customers WHERE CUSTOMER_ENTRY_COMMENTS IS NOT NULL
)
SELECT
    CAST(CM.CHECK_ID AS VARCHAR2(10)) AS CHECK_ID,
    CAST(CM.CHECK_NAME AS VARCHAR2(50)) AS CHECK_NAME,
    CAST(CM.CATEGORY AS VARCHAR2(30)) AS CATEGORY,
    CAST(CM.DESCRIPTION AS VARCHAR2(200)) AS DESCRIPTION,
    (CASE CM.POPULATION_TYPE
        WHEN 'MATCHED'     THEN P.MATCHED_COUNT
        WHEN 'MATCHED_N'   THEN P.MATCHED_N_COUNT
        WHEN 'MATCHED_12'  THEN P.MATCHED_12_COUNT
        WHEN 'NCIS_LOADED' THEN P.NCIS_LOADED_COUNT
        WHEN 'NCIS_ALL'    THEN P.NCIS_ALL_COUNT
        WHEN 'SPECA_CODED' THEN P.SPECA_CODED_COUNT
        WHEN 'SPECA_SCOPE' THEN P.SPECA_SCOPE_COUNT
        WHEN 'FIN_SCOPE'   THEN P.FIN_SCOPE_COUNT
     END) AS TOTAL_RECORDS,
    (CASE CM.POPULATION_TYPE
        WHEN 'MATCHED'     THEN P.MATCHED_COUNT
        WHEN 'MATCHED_N'   THEN P.MATCHED_N_COUNT
        WHEN 'MATCHED_12'  THEN P.MATCHED_12_COUNT
        WHEN 'NCIS_LOADED' THEN P.NCIS_LOADED_COUNT
        WHEN 'NCIS_ALL'    THEN P.NCIS_ALL_COUNT
        WHEN 'SPECA_CODED' THEN P.SPECA_CODED_COUNT
        WHEN 'SPECA_SCOPE' THEN P.SPECA_SCOPE_COUNT
        WHEN 'FIN_SCOPE'   THEN P.FIN_SCOPE_COUNT
     END) - NVL(FC.INVALID_COUNT, 0) AS VALID_COUNT,
    NVL(FC.INVALID_COUNT, 0) AS INVALID_COUNT,
    CASE WHEN CM.CATEGORY = 'INFO'           THEN 'INFO'
         WHEN NVL(FC.INVALID_COUNT, 0) = 0   THEN 'PASS'
         ELSE 'FAIL' END AS STATUS,
    'DC5' AS DC_VERSION,
    1 AS RUN_VERSION,  -- TESTING ONLY: στο SSIS αντικαθίσταται από @[User::RunVersion] μέσω Derived Column.
    SYSDATE AS RUN_TIMESTAMP
FROM CHECK_META CM
CROSS JOIN POPULATIONS P
LEFT JOIN FINDINGS_COUNT FC ON FC.CHECK_ID = CM.CHECK_ID
ORDER BY REGEXP_SUBSTR(CM.CHECK_ID, '[A-Z]+'), TO_NUMBER(REGEXP_SUBSTR(CM.CHECK_ID, '[0-9]+'));</property>
