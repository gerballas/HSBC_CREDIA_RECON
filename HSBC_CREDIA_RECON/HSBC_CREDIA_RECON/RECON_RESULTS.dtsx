                          refId="Package\Sequence Container\SEPA_Detail\SEPA_detail.Outputs[Oracle Source Output].Columns[CHECK_ID]"
                          codePage="1253"
                          dataType="str"
                          externalMetadataColumnId="Package\Sequence Container\SEPA_Detail\SEPA_detail.Outputs[Oracle Source Output].ExternalColumns[CHECK_ID]"
                          length="10"
