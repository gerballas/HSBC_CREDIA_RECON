                      connectionManagerRefId="Project.ConnectionManagers[PRE Connection Manager]"
                      description="The ORACLE runtime connection used to access the database."
                      name="ORACLEConnection" />
                  </connections>
                  <outputs>
                    <output
                      refId="Package\Sequence Container\Customer_Groups_Detail\Customer_Groups_detail.Outputs[Oracle Source Output]"
                      errorRowDisposition="FailComponent"
                      name="Oracle Source Output"
                      truncationRowDisposition="FailComponent">
                      <outputColumns>
                        <outputColumn
                          refId="Package\Sequence Container\Customer_Groups_Detail\Customer_Groups_detail.Outputs[Oracle Source Output].Columns[CHECK_ID]"
                          codePage="1253"
                          dataType="str"
                          externalMetadataColumnId="Package\Sequence Container\Customer_Groups_Detail\Customer_Groups_detail.Outputs[Oracle Source Output].ExternalColumns[CHECK_ID]"
                          length="10"
                          lineageId="Package\Sequence Container\Customer_Groups_Detail\Customer_Groups_detail.Outputs[Oracle Source Output].Columns[CHECK_ID]"
                          name="CHECK_ID" />
                        <outputColumn
                          refId="Package\Sequence Container\Customer_Groups_Detail\Customer_Groups_detail.Outputs[Oracle Source Output].Columns[CHECK_NAME]"
                          codePage="1253"
                          dataType="str"
                          externalMetadataColumnId="Package\Sequence Container\Customer_Groups_Detail\Customer_Groups_detail.Outputs[Oracle Source Output].ExternalColumns[CHECK_NAME]"
                          length="50"
                          lineageId="Package\Sequence Container\Customer_Groups_Detail\Customer_Groups_detail.Outputs[Oracle Source Output].Columns[CHECK_NAME]"
                          name="CHECK_NAME" />
                        <outputColumn
                          refId="Package\Sequence Container\Customer_Groups_Detail\Customer_Groups_detail.Outputs[Oracle Source Output].Columns[DETAIL_ID]"
                          codePage="1253"
                          dataType="str"
                          externalMetadataColumnId="Package\Sequence Container\Customer_Groups_Detail\Customer_Groups_detail.Outputs[Oracle Source Output].ExternalColumns[DETAIL_ID]"
                          length="20"
                          lineageId="Package\Sequence Container\Customer_Groups_Detail\Customer_Groups_detail.Outputs[Oracle Source Output].Columns[DETAIL_ID]"
                          name="DETAIL_ID" />
                        <outputColumn
                          refId="Package\Sequence Container\Customer_Groups_Detail\Customer_Groups_detail.Outputs[Oracle Source Output].Columns[CUSTOMER_CODE]"
                          codePage="1253"
                          dataType="str"
                          externalMetadataColumnId="Package\Sequence Container\Customer_Groups_Detail\Customer_Groups_detail.Outputs[Oracle Source Output].ExternalColumns[CUSTOMER_CODE]"
                          length="30"
                          lineageId="Package\Sequence Container\Customer_Groups_Detail\Customer_Groups_detail.Outputs[Oracle Source Output].Columns[CUSTOMER_CODE]"
                          name="CUSTOMER_CODE" />
                        <outputColumn
                          refId="Package\Sequence Container\Customer_Groups_Detail\Customer_Groups_detail.Outputs[Oracle Source Output].Columns[HUB_VALUE]"
                          codePage="1253"
                          dataType="str"
