                <component
                  refId="Package\Sequence Container\Safe_Deposit_Boxes_Detail\Safe_Deposit_Boxes_detail"
                  componentClassID="Microsoft.SSISOracleSrc"
                  contactInfo="Oracle Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;1"
                  description="Oracle Source"
                  name="Safe_Deposit_Boxes_detail"
                  usesDispositions="true"
                  version="1">
                  <properties>
                    <property
                      dataType="System.String"
                      description="The name of the table to be fetched."
                      expressionType="Notify"
                      name="TableName"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      expressionType="Notify"
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">-- ====================================================================
-- SDB_RECON — DETAIL DC5 v1 (Safe Deposit Boxes)
-- Τροφοδοτεί: RECON.SDB_RECON_DETAIL (όνομα πίνακα προς επιβεβαίωση: δεν υπάρχει ακόμη στο
-- SSIS scripts\Recon_tables.sql)
-- Μία γραμμή ανά εύρημα για SDB-001 .. SDB-010 (μόνο ό,τι αποτυγχάνει). Τα INFO SDB-011 .. SDB-016
-- υπάρχουν μόνο στο Master.
--
-- Ζευγάρι του MasterSafeDepositBoxes_DC5_v1.sql: το κοινό κομμάτι και το FINDINGS είναι ΙΔΙΑ
-- αυτούσια και στα δύο αρχεία -&gt; INVALID_COUNT του Master = γραμμές εδώ ανά CHECK_ID.
-- Πηγές / κανόνες / αντιστοιχία με το DC4: βλ. header του Master.
--
--   - DETAIL_ID: '&lt;CHECK_ID&gt;_0000001', ...
--   - CUSTOMER_CODE: owner HUB (SBDCB + SBDCS). NULL για θυρίδα PROFITS χωρίς HUB.
--   - SERIAL_NO: branch-box ('&lt;SBBRNO&gt;-&lt;SBBONO&gt;'), + ' / &lt;πελάτης PROFITS&gt;' στα SDB-009 / 010.
--   - HUB_VALUE = τιμή HUB, NCIS_VALUE = τιμή PROFITS, 100 χαρ.
--   - ISSUE: 'MISMATCH (EXPECTED &lt;τιμή&gt;)', ή η αιτία για τα checks ύπαρξης. Έως 50 χαρακτήρες.
-- ====================================================================
WITH
-- --------------------------------------------------------------------
-- Κοινό κομμάτι (ΙΔΙΟ αυτούσιο στο Master και στο Detail).
--   R_SX   = HUB_MT_SXOWNSP (synonym @Malta, 10098): ΜΙΑ ανάγνωση, όλες οι θυρίδες (35500: χωρίς WHERE).
--            OWNER = TRIM(SBDCB || LPAD(SBDCS,6,'0')) (35500), X_PROD = 80001 όταν SBBXTY = 'PRCL', αλλιώς 80002,
--            DLUP_D = TO_DATE(SBDLUP,'YYYYMMDD') (RENTAL_DT / LAST_TRX_DT).
--   R_SX2  = "HUB_MT_SX@OWNSP" (@Malta): δεύτερο ownership file του DD, ΔΕΝ το διαβάζει το 35500 (μόνο INFO / αιτία).
--   R_JNT  = HUB_MT_SSPRJIP (@Malta): joint profile -&gt; μέλη. Το 35500 παίρνει τον holder 1 του HGR_MG_JOINT (10200:
--            τυχαία αρίθμηση) -&gt; δεκτό ΟΠΟΙΟΔΗΠΟΤΕ μέλος, όπως Debit Cards / Real Estate.
--   MCI    = MG_CUSTOMER_INTER ανά κωδικό: PID_OK (ROW_STATUS 1, 2ο UPDATE του 35500), PID_ANY (χωρίς φίλτρο, 1ο UPDATE).
--   HB     = θυρίδα HUB (branch + box) + αναμενόμενος πελάτης: DIRECT (owner με ROW_STATUS 1, υπερισχύει) / JOINT
--            (οποιοδήποτε μέλος) / NONE (μένει ο κωδικός HUB στο FK_CUST_ID).
--   EM     = αναμενόμενοι beneficiaries ανά θυρίδα: ο owner (DIRECT) και κάθε μέλος του joint profile με το ΔΙΚΟ του
--            PRFT_CUST_ID (απόφαση χρήστη 2026-11-17 - το 35500 γράφει λάθος τον κύριο πελάτη, b1.FK_CUST_ID).
--   BX / RN / BN = SAFE_DEPOSIT_BOX / SDB_RENTAL / SDB_BENEFICIARY.
-- --------------------------------------------------------------------
R_SX AS (
    SELECT /*+ MATERIALIZE */
           SBBRNO AS BRN, SBBONO AS BOX,
           TRIM(SBBXTY) AS BXTY, TRIM(SBMDFL) AS MDFL,
           TRIM(TRIM(TO_CHAR(SBDCB)) || LPAD(TRIM(TO_CHAR(SBDCS)), 6, '0')) AS OWNER,
           CASE WHEN SBBXTY = 'PRCL' THEN 80001 ELSE 80002 END AS X_PROD,
           TRIM(TO_CHAR(SBDLUP)) AS DLUP_T,
           TO_DATE(TRIM(TO_CHAR(SBDLUP)) DEFAULT NULL ON CONVERSION ERROR, 'YYYYMMDD') AS DLUP_D,
           TO_DATE(TRIM(TO_CHAR(SBBXAD)) DEFAULT NULL ON CONVERSION ERROR, 'YYYYMMDD') AS BXAD_D,
           CASE WHEN NVL(TRIM(SBCGK1), '0') &lt;&gt; '0' OR NVL(TRIM(SBCGK2), '0') &lt;&gt; '0'
                  OR NVL(TRIM(SBCGK3), '0') &lt;&gt; '0' OR NVL(TRIM(SBCGK4), '0') &lt;&gt; '0' THEN 1 ELSE 0 END AS HAS_CGK,
           CASE WHEN NVL(TRIM(TO_CHAR(SBNOKP)), '0') &lt;&gt; '0' OR NVL(TRIM(TO_CHAR(SBNOVT)), '0') &lt;&gt; '0' THEN 1 ELSE 0 END AS NOTGT
      FROM HUB_MT_SXOWNSP
),
R_SX2 AS (
    SELECT /*+ MATERIALIZE */ DISTINCT SBBRNO AS BRN, SBBONO AS BOX FROM "HUB_MT_SXOWNSP"
),
R_JNT AS (
    SELECT /*+ MATERIALIZE */ DISTINCT TRIM(CUSTOMER_CODE) AS JC, TRIM(CUSTOMER_CODE2) AS MC
      FROM HUB_MT_SSPRJIP
     WHERE TRIM(CUSTOMER_CODE) IN (SELECT OWNER FROM R_SX)
),
MCI AS (
    SELECT /*+ MATERIALIZE */
           TRIM(CUSTOMER_CODE) AS CC,
           MIN(CASE WHEN TRIM(TO_CHAR(ROW_STATUS)) = '1' THEN PRFT_CUST_ID END) AS PID_OK,
           MIN(PRFT_CUST_ID) AS PID_ANY, MAX(TRIM(TO_CHAR(ROW_STATUS))) AS RS
      FROM MG_CUSTOMER_INTER
     WHERE TRIM(CUSTOMER_CODE) IN (SELECT OWNER FROM R_SX UNION SELECT MC FROM R_JNT)
     GROUP BY TRIM(CUSTOMER_CODE)
),
JM AS (
    SELECT j.JC, j.MC, m.PID_ANY AS PID FROM R_JNT j LEFT JOIN MCI m ON m.CC = j.MC
),
HB AS (
    SELECT /*+ MATERIALIZE */
           s.BRN, s.BOX, COUNT(*) AS NH,
           MIN(s.OWNER) AS OWNER, MIN(s.BXTY) AS BXTY, MIN(s.X_PROD) AS X_PROD, MAX(s.X_PROD) AS X_PROD2,
           MIN(s.DLUP_T) AS DLUP_T, MIN(s.DLUP_D) AS DLUP_D, MIN(s.BXAD_D) AS BXAD_D,
           MAX(CASE WHEN s.MDFL = 'S' THEN 1 ELSE 0 END) AS SHADOW,
           MAX(s.HAS_CGK) AS HAS_CGK, MAX(s.NOTGT) AS NOTGT,
           TO_CHAR(s.BRN) || '-' || TO_CHAR(s.BOX) AS SKEY
      FROM R_SX s
     GROUP BY s.BRN, s.BOX
),
H AS (
    SELECT /*+ MATERIALIZE */
           b.*, m.PID_OK, m.RS,
           CASE WHEN m.PID_OK IS NOT NULL THEN 'DIRECT'
                WHEN EXISTS (SELECT 1 FROM R_JNT j WHERE j.JC = b.OWNER) THEN 'JOINT'
                ELSE 'NONE' END AS RES,
           (SELECT COUNT(*) FROM JM j WHERE j.JC = b.OWNER) AS N_MEM,
           (SELECT COUNT(*) FROM JM j WHERE j.JC = b.OWNER AND j.PID IS NOT NULL) AS N_MEM_MIG
      FROM HB b
      LEFT JOIN MCI m ON m.CC = b.OWNER
),
XR AS (
    -- αναμενόμενοι πελάτες της μίσθωσης (FK_CUST_ID): DIRECT -&gt; owner, JOINT -&gt; οποιοδήποτε μέλος
    SELECT h.BRN, h.BOX, h.PID_OK AS PID FROM H h WHERE h.RES = 'DIRECT'
    UNION ALL
    SELECT h.BRN, h.BOX, j.PID FROM H h JOIN JM j ON j.JC = h.OWNER WHERE h.RES = 'JOINT' AND j.PID IS NOT NULL
),
EM AS (
    -- αναμενόμενοι beneficiaries: owner (DIRECT) + κάθε μέλος του joint profile με το δικό του id
    SELECT DISTINCT x.BRN, x.BOX, x.PID
      FROM (SELECT h.BRN, h.BOX, h.PID_OK AS PID FROM H h WHERE h.RES = 'DIRECT'
            UNION ALL
            SELECT h.BRN, h.BOX, j.PID FROM H h JOIN JM j ON j.JC = h.OWNER WHERE j.PID IS NOT NULL) x
),
BX AS (
    SELECT /*+ MATERIALIZE */ FK_UNITCODE AS BRN, SDB_SN AS BOX, COUNT(*) AS N, MIN(FK_SDB_TYPEFK_PROD) AS PROD
      FROM SAFE_DEPOSIT_BOX
     GROUP BY FK_UNITCODE, SDB_SN
),
RN AS (
    SELECT /*+ MATERIALIZE */ FKSDB_UNIT AS BRN, FKSDB_SN AS BOX, COUNT(*) AS N,
           MIN(TRUNC(RENTAL_DT)) AS RENTAL_D, MIN(TRUNC(LAST_TRX_DT)) AS LAST_D, MIN(FK_CUST_ID) AS CID
      FROM SDB_RENTAL
     GROUP BY FKSDB_UNIT, FKSDB_SN
),
BN AS (
    SELECT /*+ MATERIALIZE */ FKSDB_RENTAL_UNIT AS BRN, FKSDB_RENTAL_SN AS BOX, FK_CUSTOMERCUST_ID AS CID, COUNT(*) AS N
      FROM SDB_BENEFICIARY
     GROUP BY FKSDB_RENTAL_UNIT, FKSDB_RENTAL_SN, FK_CUSTOMERCUST_ID
),
FINDINGS AS (
    -- Μία γραμμή ανά εύρημα. CUSTOMER_CODE = owner HUB (SBDCB + SBDCS), SERIAL_NO = branch-box (+ πελάτης PROFITS στα
    -- SDB-009 / 010). HUB_VALUE = τιμή HUB, NCIS_VALUE = τιμή PROFITS. Αναμενόμενη τιμή (μόνο από το 35500) στο ISSUE.
    --==============================================================
    --SDB-001. Θυρίδα του HUB χωρίς SAFE_DEPOSIT_BOX (branch + box).
    SELECT
      CAST('SDB-001_BOX_MISSING_IN_PROFITS' AS VARCHAR2(50)) AS CHECK_NAME,
      CAST(h.OWNER AS VARCHAR2(40)) AS CUSTOMER_CODE,
      CAST(h.SKEY AS VARCHAR2(40)) AS SERIAL_NO,
      CAST(SUBSTR('SBBXTY=' || h.BXTY || '; HUB ROWS=' || h.NH, 1, 200) AS VARCHAR2(200)) AS HUB_VALUE,
      CAST(NULL AS VARCHAR2(200)) AS NCIS_VALUE,
      CAST('MISSING IN PROFITS' AS VARCHAR2(50)) AS ISSUE
    FROM H h
    WHERE NOT EXISTS (SELECT 1 FROM BX x WHERE x.BRN = h.BRN AND x.BOX = h.BOX)
    UNION ALL
    --==============================================================
    --SDB-002. SAFE_DEPOSIT_BOX χωρίς θυρίδα στο SXOWNSP, ή περισσότερες γραμμές από όσες βγάζει το 35500.
    SELECT 'SDB-002_BOX_MISSING_IN_HUB', (SELECT MIN(h.OWNER) FROM H h WHERE h.BRN = x.BRN AND h.BOX = x.BOX),
           TO_CHAR(x.BRN) || '-' || TO_CHAR(x.BOX),
           (SELECT 'HUB ROWS=' || MIN(h.NH) FROM H h WHERE h.BRN = x.BRN AND h.BOX = x.BOX),
           'ROWS=' || x.N || '; PRODUCT=' || x.PROD,
           CASE WHEN NOT EXISTS (SELECT 1 FROM H h WHERE h.BRN = x.BRN AND h.BOX = x.BOX)
                THEN CASE WHEN EXISTS (SELECT 1 FROM R_SX2 z WHERE z.BRN = x.BRN AND z.BOX = x.BOX)
                          THEN 'ONLY IN SX@OWNSP (NOT READ BY 35500)' ELSE 'NOT IN HUB SXOWNSP' END
                ELSE SUBSTR('DUPLICATE IN PROFITS (' || x.N || ' ROWS)', 1, 50) END
    FROM BX x
    WHERE NOT EXISTS (SELECT 1 FROM H h WHERE h.BRN = x.BRN AND h.BOX = x.BOX)
       OR x.N &gt; (SELECT MIN(h.NH) FROM H h WHERE h.BRN = x.BRN AND h.BOX = x.BOX)
    UNION ALL
    --==============================================================
    --SDB-003. FK_SDB_TYPEFK_PROD vs SBBXTY (PRCL -&gt; 80001, αλλιώς 80002).
    SELECT 'SDB-003_BOX_TYPE_MISMATCH', h.OWNER, h.SKEY,
           'SBBXTY=' || NVL(h.BXTY, 'BLANK'), TO_CHAR(x.PROD),
           'MISMATCH (EXPECTED ' || h.X_PROD || ')'
    FROM H h
    JOIN BX x ON x.BRN = h.BRN AND x.BOX = h.BOX
    WHERE NVL(x.PROD, -1) &lt;&gt; h.X_PROD
    UNION ALL
    --==============================================================
    --SDB-004. Θυρίδα του HUB χωρίς SDB_RENTAL.
    SELECT 'SDB-004_RENTAL_MISSING_IN_PROFITS', h.OWNER, h.SKEY,
           'SBDLUP=' || NVL(h.DLUP_T, 'BLANK'), CAST(NULL AS VARCHAR2(200)),
           CASE WHEN h.DLUP_D IS NULL THEN 'SBDLUP NOT A DATE (35500 CREATE TABLE FAILS)' ELSE 'MISSING IN PROFITS' END
    FROM H h
    WHERE NOT EXISTS (SELECT 1 FROM RN r WHERE r.BRN = h.BRN AND r.BOX = h.BOX)
    UNION ALL
    --==============================================================
    --SDB-005. SDB_RENTAL χωρίς θυρίδα στο SXOWNSP, ή διπλή.
    SELECT 'SDB-005_RENTAL_MISSING_IN_HUB', (SELECT MIN(h.OWNER) FROM H h WHERE h.BRN = r.BRN AND h.BOX = r.BOX),
           TO_CHAR(r.BRN) || '-' || TO_CHAR(r.BOX),
           (SELECT 'HUB ROWS=' || MIN(h.NH) FROM H h WHERE h.BRN = r.BRN AND h.BOX = r.BOX),
           'ROWS=' || r.N || '; CUSTOMER=' || r.CID,
           CASE WHEN NOT EXISTS (SELECT 1 FROM H h WHERE h.BRN = r.BRN AND h.BOX = r.BOX) THEN 'NOT IN HUB SXOWNSP'
                ELSE SUBSTR('DUPLICATE IN PROFITS (' || r.N || ' ROWS)', 1, 50) END
    FROM RN r
    WHERE NOT EXISTS (SELECT 1 FROM H h WHERE h.BRN = r.BRN AND h.BOX = r.BOX)
       OR r.N &gt; (SELECT MIN(h.NH) FROM H h WHERE h.BRN = r.BRN AND h.BOX = r.BOX)
    UNION ALL
    --==============================================================
    --SDB-006. SDB_RENTAL.RENTAL_DT vs SBDLUP.
    SELECT 'SDB-006_RENTAL_DATE_MISMATCH', h.OWNER, h.SKEY,
           h.DLUP_T, TO_CHAR(r.RENTAL_D, 'YYYY-MM-DD'),
           'MISMATCH (EXPECTED ' || NVL(TO_CHAR(h.DLUP_D, 'YYYY-MM-DD'), 'EMPTY') || ')'
    FROM H h
    JOIN RN r ON r.BRN = h.BRN AND r.BOX = h.BOX
    WHERE NVL(r.RENTAL_D, DATE '0001-01-01') &lt;&gt; NVL(h.DLUP_D, DATE '0001-01-01')
    UNION ALL
    --==============================================================
    --SDB-007. SDB_RENTAL.LAST_TRX_DT vs SBDLUP.
    SELECT 'SDB-007_RENTAL_LAST_TRX_DATE_MISMATCH', h.OWNER, h.SKEY,
           h.DLUP_T, TO_CHAR(r.LAST_D, 'YYYY-MM-DD'),
           'MISMATCH (EXPECTED ' || NVL(TO_CHAR(h.DLUP_D, 'YYYY-MM-DD'), 'EMPTY') || ')'
    FROM H h
    JOIN RN r ON r.BRN = h.BRN AND r.BOX = h.BOX
    WHERE NVL(r.LAST_D, DATE '0001-01-01') &lt;&gt; NVL(h.DLUP_D, DATE '0001-01-01')
    UNION ALL
    --==============================================================
    --SDB-008. SDB_RENTAL.FK_CUST_ID vs owner (ROW_STATUS 1) ή μέλος του joint profile. Χωρίς μεταφερμένο πελάτη -&gt; FAIL.
    SELECT 'SDB-008_RENTAL_CUSTOMER_MISMATCH', h.OWNER, h.SKEY,
           'OWNER ' || h.OWNER || CASE WHEN h.RES = 'JOINT' THEN ' (JOINT, ' || h.N_MEM || ' MEMBERS)' END,
           TO_CHAR(r.CID),
           SUBSTR(CASE WHEN h.RES = 'NONE' THEN 'OWNER NOT MIGRATED (RS ' || NVL(h.RS, 'NONE') || ')'
                       WHEN h.RES = 'JOINT' AND h.N_MEM_MIG = 0 THEN 'JOINT: NO MEMBER MIGRATED'
                       WHEN h.RES = 'DIRECT' THEN 'MISMATCH (EXPECTED ' || h.PID_OK || ')'
                       ELSE 'MISMATCH (EXPECTED A JOINT MEMBER)' END, 1, 50)
    FROM H h
    JOIN RN r ON r.BRN = h.BRN AND r.BOX = h.BOX
    WHERE NOT EXISTS (SELECT 1 FROM XR x WHERE x.BRN = h.BRN AND x.BOX = h.BOX AND x.PID = r.CID)
    UNION ALL
    --==============================================================
    --SDB-009. Αναμενόμενος beneficiary (owner / κάθε μέλος joint με το δικό του id) χωρίς SDB_BENEFICIARY.
    --         Owner DIRECT που είναι και joint profile: το 35500 βάζει τα μέλη SERIAL_NO &gt; 1 -&gt; δεκτό να λείπει ένα μέλος.
    SELECT 'SDB-009_BENEFICIARY_MISSING_IN_PROFITS', h.OWNER, h.SKEY || ' / ' || e.PID,
           'HOLDER ' || e.PID, (SELECT 'BENEFICIARIES=' || SUM(b.N) FROM BN b WHERE b.BRN = h.BRN AND b.BOX = h.BOX),
           CASE WHEN e.PID = h.PID_OK THEN 'OWNER NOT A BENEFICIARY'
                WHEN EXISTS (SELECT 1 FROM BN b WHERE b.BRN = h.BRN AND b.BOX = h.BOX AND b.N &gt; 1)
                     THEN 'MAIN CUSTOMER WRITTEN (35500 ALIAS)'
                ELSE 'JOINT MEMBER NOT A BENEFICIARY' END
    FROM H h
    JOIN EM e ON e.BRN = h.BRN AND e.BOX = h.BOX
    WHERE NOT EXISTS (SELECT 1 FROM BN b WHERE b.BRN = h.BRN AND b.BOX = h.BOX AND b.CID = e.PID)
      AND NOT (h.RES = 'DIRECT' AND e.PID &lt;&gt; h.PID_OK
               AND (SELECT COUNT(*) FROM EM e2 WHERE e2.BRN = h.BRN AND e2.BOX = h.BOX AND e2.PID &lt;&gt; h.PID_OK
                       AND NOT EXISTS (SELECT 1 FROM BN b2 WHERE b2.BRN = h.BRN AND b2.BOX = h.BOX AND b2.CID = e2.PID)) = 1)
    UNION ALL
    --==============================================================
    --SDB-010. SDB_BENEFICIARY θυρίδας του HUB με πελάτη που δεν είναι holder, ή ο ίδιος πελάτης 2+ φορές.
    SELECT 'SDB-010_BENEFICIARY_NOT_EXPECTED', h.OWNER, h.SKEY || ' / ' || b.CID,
           'OWNER ' || h.OWNER, 'CUSTOMER=' || b.CID || '; ROWS=' || b.N,
           CASE WHEN NOT EXISTS (SELECT 1 FROM EM e WHERE e.BRN = b.BRN AND e.BOX = b.BOX AND e.PID = b.CID)
                THEN 'NOT A HUB HOLDER OF THE BOX'
                ELSE SUBSTR('SAME CUSTOMER ' || b.N || ' TIMES (35500 ALIAS)', 1, 50) END
    FROM BN b
    JOIN H h ON h.BRN = b.BRN AND h.BOX = b.BOX
    WHERE b.N &gt; 1
       OR NOT EXISTS (SELECT 1 FROM EM e WHERE e.BRN = b.BRN AND e.BOX = b.BOX AND e.PID = b.CID)
)
SELECT
    CAST(CHECK_ID || '_' || TO_CHAR(ROW_NUMBER() OVER (PARTITION BY CHECK_ID ORDER BY CUSTOMER_CODE, SERIAL_NO), 'FM0000000') AS VARCHAR2(20)) AS DETAIL_ID,
    CAST(CHECK_ID AS VARCHAR2(10)) AS CHECK_ID,
    CAST(CHECK_NAME AS VARCHAR2(50)) AS CHECK_NAME,
    CAST(SUBSTR(CUSTOMER_CODE, 1, 30) AS VARCHAR2(30)) AS CUSTOMER_CODE,
    CAST(SUBSTR(SERIAL_NO, 1, 30) AS VARCHAR2(30)) AS SERIAL_NO,
    CAST(SUBSTR(HUB_VALUE, 1, 100) AS VARCHAR2(100)) AS HUB_VALUE,
    CAST(SUBSTR(NCIS_VALUE, 1, 100) AS VARCHAR2(100)) AS NCIS_VALUE,
    CAST(SUBSTR(ISSUE, 1, 50) AS VARCHAR2(50)) AS ISSUE,
    'DC5' AS DC_VERSION,
    1 AS RUN_VERSION,  -- TESTING ONLY: στο SSIS αντικαθίσταται από @[User::RunVersion] μέσω Derived Column.
    SYSDATE AS RUN_TIMESTAMP
FROM (
    SELECT
        F.*,
        CAST(SUBSTR(CHECK_NAME, 1, INSTR(CHECK_NAME, '_') - 1) AS VARCHAR2(10)) AS CHECK_ID
    FROM FINDINGS F
)
ORDER BY REGEXP_SUBSTR(CHECK_ID, '[A-Z]+'), TO_NUMBER(REGEXP_SUBSTR(CHECK_ID, '[0-9]+')), CUSTOMER_CODE, SERIAL_NO;</property>
