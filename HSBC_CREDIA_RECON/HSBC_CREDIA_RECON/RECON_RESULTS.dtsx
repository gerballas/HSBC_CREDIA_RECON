                  <outputs>
                    <output
                      refId="Package\Sequence Container\Customer_Relations_Master\Customer_Relations_master.Outputs[Oracle Source Output]"
                      errorRowDisposition="FailComponent"
                      name="Oracle Source Output"
                      truncationRowDisposition="FailComponent">
                      <outputColumns>
                        <outputColumn
                          refId="Package\Sequence Container\Customer_Relations_Master\Customer_Relations_master.Outputs[Oracle Source Output].Columns[CHECK_ID]"
                          codePage="1253"
                          dataType="str"
                          externalMetadataColumnId="Package\Sequence Container\Customer_Relations_Master\Customer_Relations_master.Outputs[Oracle Source Output].ExternalColumns[CHECK_ID]"
                          length="10"
                          lineageId="Package\Sequence Container\Customer_Relations_Master\Customer_Relations_master.Outputs[Oracle Source Output].Columns[CHECK_ID]"
                          name="CHECK_ID" />
                        <outputColumn
                          refId="Package\Sequence Container\Customer_Relations_Master\Customer_Relations_master.Outputs[Oracle Source Output].Columns[CHECK_NAME]"
                          codePage="1253"
                          dataType="str"
                          externalMetadataColumnId="Package\Sequence Container\Customer_Relations_Master\Customer_Relations_master.Outputs[Oracle Source Output].ExternalColumns[CHECK_NAME]"
                          length="90"
