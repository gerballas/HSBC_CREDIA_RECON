                <component
                  refId="Package\Sequence Container\Real_Estate_Master\Real_Estate_master"
                  componentClassID="Microsoft.SSISOracleSrc"
                  contactInfo="Oracle Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;1"
                  description="Oracle Source"
                  name="Real_Estate_master"
                  usesDispositions="true"
                  version="1">
                  <properties>
                    <property
                      dataType="System.String"
                      description="The name of the table to be fetched."
                      expressionType="Notify"
                      name="TableName"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      expressionType="Notify"
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">-- ====================================================================
-- RE_RECON — MASTER DC5 v1 (Real Estate)
-- Τροφοδοτεί: RECON.RE_RECON_MASTER (όνομα πίνακα προς επιβεβαίωση: δεν υπάρχει ακόμη στο
-- SSIS scripts\Recon_tables.sql)
-- Μία γραμμή ΑΝΑ CHECK_ID — 27 γραμμές ανά run: REA-001 .. REA-027.
--
-- Real Estate (ME01 HUB, EIM 240825, DD v1.24): HUB SS@SECHP (εξασφαλίσεις ακινήτων) vs PROFITS REAL_ESTATE /
-- REAL_ESTATE_APPRSL / REAL_ESTATE_CUST. ΔΕΝ υπάρχει NCIS extract: οι τιμές PROFITS διαβάζονται απευθείας από τους
-- πίνακες (όπως Debit Cards / Gov Payments). Οι στήλες λέγονται NCIS_VALUE για συμβατότητα με το template.
-- Migration scripts: ΜΟΝΟ Migration Scripts\20261116_MigrationScripts (80000_MG_REAL_ESTATE, 80100, 90000, 10090,
-- 10098, 10200, 12000). Διαφορές DC4 -&gt; DC5: DC5\DC4_vs_DC5_MigrationScripts_RealEstate_Diff_Report.md.
-- Μορφή Master/Detail όπως το MasterGovPayments_DC5_v1.sql:
--   - ένα αυτοτελές SELECT, χωρίς views / πίνακες HGR_* (το DC4 v2 χρειαζόταν preamble με HGR_RE_*: εδώ κάθε πίνακας
--     HUB διαβάζεται ΜΙΑ φορά σε δικό του CTE R_* με MATERIALIZE). Το κοινό κομμάτι και το FINDINGS είναι ΙΔΙΑ αυτούσια
--     στο DetailRealEstate_DC5_v1.sql -&gt; INVALID_COUNT = γραμμές του Detail ανά CHECK_ID.
--     Τα INFO checks (REA-020 .. REA-027) υπολογίζονται μόνο εδώ, στο FINDINGS_COUNT.
--   - Παράγεται από τον generator (_generator\build.sh): re_master_head + re_common + re_master_tail.
--   - HUB από synonyms σε DB link @Malta (10098): HUB_MT_SSSECHP, HUB_MT_SSSTDPP, HUB_MT_SSCUSTP, HUB_MT_SSPRJIP.
--
-- ΑΡΧΗ: αναμενόμενη τιμή ΜΟΝΟ από τα scripts της μετάπτωσης (80000 20261116):
--   - Scope (ΝΕΟ στο DC5): TRIM(Y2SCCD) IN (SSSTDPP YHTBID 'Y1' με SUBSTR(YHDS50,-1,1) IN ('D','E')) και πελάτης στο
--     SSCUSTP. Στο DC4 ήταν Y2SCCD IN ('RMG','MTG','SMG'). Χωρίς φίλτρο shadow (REA-023).
--   - Κλειδί HUB -&gt; PROFITS (απόφαση χρήστη 2026-11-17): CUSTOMER_CODE + Y2SCSR + Y2SCCD -&gt; MG_COLLATERALS_REAL_ESTATE.SN
--     (migration table) = MG_REAL_ESTATE.SERIAL_NO -&gt; PRFT_ID (80100) = REAL_ESTATE.ID. Το SERIAL_NUMBER του SSSECHP
--     (ROWNUM του 10090) ΔΕΝ χρησιμοποιείται ως κλειδί.
--   - Ποσά: Y2SCVR / Y2INSA / 100 όταν CURRENCY.DISPLAYED_DECIMAL = 2 (LEFT JOIN: δεν βρέθηκε -&gt; /1). Y2SCVR -&gt;
--     COMMERCIAL_VAL_AMN, REAL_EST_VAL_AMN, TOTAL_VALUE_AMN, APPRSL MORTGAGE_VALUE / COMMERC_VALUE. Y2INSA -&gt; EST_INSUR_AMN.
--   - Ημερομηνίες: έγκυρη YYYYMMDD, αλλιώς 2999-12-31. END_DT = Y2SCEX, EVALUATION_DT = Y2VLD, ADOPTION_VAL_DT = Y2OVLD.
--   - Κείμενα: ADD_DESCR1 = πρώτοι 80 του Y2NAR1..Y2NARC, REAL_ESTATE_DESC = 'Residential Property for ' || ZGCSSN (40).
--     REEVAL_FREQ = 1 όταν Y2RUFQ &lt;&gt; ' ', αλλιώς 2. Νόμισμα appraisal = CURRENCY.ID_CURRENCY του Y2SCCY.
--   - Owner: MG_CUSTOMER_INTER του κωδικού (χωρίς ROW_STATUS). Joint (CUST_TYPE 3): το 80000 παίρνει τον holder 1 του
--     HGR_MG_JOINT, που το 10200 αριθμεί τυχαία -&gt; δεκτό ΟΠΟΙΟΔΗΠΟΤΕ μέλος (HUB_MT_SSPRJIP), όπως στα Debit Cards.
--     OWNERSH_PERC 100. Πελάτης που δεν μεταφέρθηκε -&gt; FAIL με γραμμές στο Detail (REA-010).
--   - HUB_VALUE = τιμή HUB, NCIS_VALUE = τιμή PROFITS, αναμενόμενη τιμή στο ISSUE.
--   - Detail: CUSTOMER_CODE = πελάτης HUB, SERIAL_NO = Y2SCCD-Y2SCSR / REAL_ESTATE.ID ('ID n' για ακίνητο χωρίς HUB).
--   - Μόνο checks HUB vs PROFITS (απόφαση χρήστη 2026-11-17). Prenotices (80200, αρχείο Excel) εκτός (REA-027).
--
-- ΑΝΤΙΣΤΟΙΧΙΑ με το DC4 Real_Estate_recon_v2.sql (REA-001..044, archive Scripts\Archived\RealEstate_20261117):
--   003 + 004 + 032 -&gt; 001 | 005 -&gt; 002 | 006 -&gt; 003 | 007 -&gt; 004 | 008 -&gt; 005 | 009 + 025 (APPRSL EST_INSUR) -&gt; 006
--   010 -&gt; 007 | 011 -&gt; 008 | 012 -&gt; 009 | 013 + 014 -&gt; 010 | 015 + 031 -&gt; 011 | 016 -&gt; 012 | 038 -&gt; 013
--   024 -&gt; 014 / 015 / 016 | 025 -&gt; 017 / 018 / 019 | 017 + 030 -&gt; 020 (INFO) | 018 -&gt; 021 (INFO) | 019 -&gt; 022 (INFO)
--   028 -&gt; 023 (INFO) | 027 -&gt; 024 (INFO) | 042 -&gt; 025 (INFO) | 036 -&gt; 026 (INFO) | 043 -&gt; 027 (INFO)
--   Αφαιρέθηκαν (όχι HUB vs PROFITS): 001 / 002 (προϋποθέσεις, counts - καλύπτονται από 001 / 002), 020 / 040 (CURRENCY),
--   021 (integrity), 022 / 023 / 044 (staging), 026 / 029 / 033 / 037 (data quality), 034 / 035 / 041 (σταθερές τιμές,
--   παράμετροι), 039 (λοιπά νομίσματα appraisal, όχι κανόνας του script).
--   Αντιστοιχία με τα 16 checks του DC4 Recon findings.xlsx (v1): v1 REA-001..016 -&gt; v2 ίδια -&gt; βλ. παραπάνω.
--
-- STATUS: PASS (INVALID_COUNT = 0) / FAIL / INFO. DESCRIPTION: απλή περιγραφή χωρίς κωδικούς.
--
-- TOTAL_RECORDS ανά POPULATION_TYPE:
--   HUB_ALL    = όλες οι γραμμές SSSECHP           HUB_CODE   = γραμμές με κωδικό του scope
--   HUB_IN     = εξασφαλίσεις που επιλέγει το 80000 PROF      = REAL_ESTATE εκτός prenotices
--   MATCHED    = HUB_IN με ακίνητο στο PROFITS      MATCHED_AP = MATCHED με appraisal
--   RC_HUB     = γραμμές REAL_ESTATE_CUST των ακινήτων του HUB   RE_ALL = όλες οι γραμμές REAL_ESTATE
-- ====================================================================
WITH
-- --------------------------------------------------------------------
-- Κοινό κομμάτι (ΙΔΙΟ αυτούσιο στο Master και στο Detail).
--   R_SEC  = HUB_MT_SSSECHP (synonym @Malta, 10098 / αντίγραφο του 10090 με CUSTOMER_CODE = Y2DCB || LPAD(Y2DCS,6,'0')):
--            ΜΙΑ ανάγνωση, όλες οι εξασφαλίσεις, μόνο οι στήλες που χρειάζονται.
--   R_STD  = HUB_MT_SSSTDPP (@Malta): κωδικοί του scope (80000 DC5: YHTBID 'Y1', SUBSTR(YHDS50,-1,1) IN ('D','E')).
--   R_CUS  = HUB_MT_SSCUSTP (@Malta): πελάτες HUB (φίλτρο του 80000) + ZGCSSN (REAL_ESTATE_DESC).
--   R_JNT  = HUB_MT_SSPRJIP (@Malta): joint profile -&gt; μέλη. Το 80000 παίρνει τον holder SERIAL_NO 1 του HGR_MG_JOINT
--            (10200: ORDER BY το ίδιο το κλειδί = τυχαίο μέλος) -&gt; δεκτό ΟΠΟΙΟΔΗΠΟΤΕ μέλος (όπως Debit Cards).
--   MCI    = MG_CUSTOMER_INTER ανά κωδικό (80000: LEFT JOIN χωρίς ROW_STATUS). CUR = CURRENCY ανά κωδικό νομίσματος.
--   HS     = εξασφαλίσεις που μεταφέρει το 80000 (κωδικός του scope + πελάτης στο SSCUSTP) + αναμενόμενες τιμές.
--   STK    = MG_COLLATERALS_REAL_ESTATE (80000, migration table): φυσικό κλειδί CUSTOMER_CODE + Y2SCSR + Y2SCCD -&gt; SN.
--   STG    = MG_REAL_ESTATE CollateralsRealEstate ανά SERIAL_NO (= SN): PRFT_ID (80100), ROW_STATUS, COLL_ERR_DESC.
--   PRE    = PRFT_ID των prenotices (80200, εκτός HUB). STA = κάθε PRFT_ID του MG_REAL_ESTATE.
--   RE / AP / RC = REAL_ESTATE / REAL_ESTATE_APPRSL (ανά ακίνητο) / REAL_ESTATE_CUST (90000).
--   H      = HS + staging + PROFITS ανά εξασφάλιση. M = H με ακίνητο στο PROFITS. MA = M με appraisal.
--   EO     = αναμενόμενοι owners ανά κωδικό πελάτη (μη joint: ο ίδιος, joint CUST_TYPE 3: κάθε μέλος).
--   RCH    = γραμμές REAL_ESTATE_CUST των ακινήτων του HUB + αν ο πελάτης είναι αναμενόμενος owner.
-- --------------------------------------------------------------------
R_SEC AS (
    SELECT /*+ MATERIALIZE */
           TRIM(CUSTOMER_CODE)          AS CC,
           TRIM(TO_CHAR(Y2SCSR))        AS SCSR,
           TRIM(Y2SCCD)                 AS SCCD,
           TRIM(Y2TANI)                 AS TANI,
           TRIM(Y2MDFL)                 AS MDFL,
           TRIM(Y2SCCY)                 AS CCY,
           Y2SCVR                       AS SCVR,
           Y2INSA                       AS INSA,
           CASE VALIDATE_CONVERSION(SUBSTR(TRIM(TO_CHAR(Y2VLD)), 1, 8) AS DATE, 'YYYYMMDD')
                WHEN 1 THEN TO_DATE(TRIM(TO_CHAR(Y2VLD)) DEFAULT NULL ON CONVERSION ERROR, 'YYYY-MM-DD')
                WHEN 0 THEN DATE '2999-12-31' END AS X_EVAL_D,
           CASE VALIDATE_CONVERSION(SUBSTR(TRIM(TO_CHAR(Y2SCEX)), 1, 8) AS DATE, 'YYYYMMDD')
                WHEN 1 THEN TO_DATE(TRIM(TO_CHAR(Y2SCEX)) DEFAULT NULL ON CONVERSION ERROR, 'YYYY-MM-DD')
                WHEN 0 THEN DATE '2999-12-31' END AS X_END_D,
           CASE VALIDATE_CONVERSION(SUBSTR(TRIM(TO_CHAR(Y2OVLD)), 1, 8) AS DATE, 'YYYYMMDD')
                WHEN 1 THEN TO_DATE(TRIM(TO_CHAR(Y2OVLD)) DEFAULT NULL ON CONVERSION ERROR, 'YYYY-MM-DD')
                WHEN 0 THEN DATE '2999-12-31' END AS X_ADOPT_D,
           CASE VALIDATE_CONVERSION(SUBSTR(TRIM(TO_CHAR(Y2ISEX)), 1, 8) AS DATE, 'YYYYMMDD')
                WHEN 1 THEN TO_DATE(TRIM(TO_CHAR(Y2ISEX)) DEFAULT NULL ON CONVERSION ERROR, 'YYYY-MM-DD')
                WHEN 0 THEN DATE '2999-12-31' END AS X_INSEX_D,
           CASE WHEN Y2RUFQ &lt;&gt; ' ' THEN '1' ELSE '2' END AS X_REEVAL,
           TRIM(Y2RUFQ)                 AS RUFQ,
           SUBSTR(TRIM(trim(Y2NAR1) || ' ' || trim(Y2NAR2) || trim(Y2NAR3) || ' ' || trim(Y2NAR4) || trim(Y2NAR5) || ' ' ||
                       trim(Y2NAR6) || trim(Y2NAR7) || ' ' || trim(Y2NAR8) || trim(Y2NARA) || ' ' || trim(Y2NARB) || trim(Y2NARC)), 1, 80) AS X_DESCR1,
           CASE WHEN NVL(TRIM(TO_CHAR(Y2SECD)), '0') &lt;&gt; '0'
                  OR NVL(TRIM(TO_CHAR(Y2CMUD)), '0') &lt;&gt; '0'
                  OR NVL(TRIM(TO_CHAR(Y2SGIN)), '0') &lt;&gt; '0'
                  OR NVL(TRIM(TO_CHAR(Y2REMT)), '0') &lt;&gt; '0'
                  OR NVL(TRIM(TO_CHAR(Y2SPA)), '0')  &lt;&gt; '0'
                THEN 1 ELSE 0 END       AS NOTGT
      FROM HUB_MT_SSSECHP
),
R_STD AS (
    SELECT /*+ MATERIALIZE */ DISTINCT TRIM(YHCODE) AS CODE
      FROM HUB_MT_SSSTDPP
     WHERE YHTBID = 'Y1' AND SUBSTR(YHDS50, -1, 1) IN ('D', 'E') AND TRIM(YHCODE) IS NOT NULL
),
R_CUS AS (
    SELECT /*+ MATERIALIZE */ TRIM(CUSTOMER_CODE) AS CC, MIN(TRIM(ZGCSSN)) AS CSSN
      FROM HUB_MT_SSCUSTP
     GROUP BY TRIM(CUSTOMER_CODE)
),
R_JNT AS (
    SELECT /*+ MATERIALIZE */ DISTINCT TRIM(CUSTOMER_CODE) AS JC, TRIM(CUSTOMER_CODE2) AS MC
      FROM HUB_MT_SSPRJIP
),
MCI AS (
    SELECT /*+ MATERIALIZE */ TRIM(CUSTOMER_CODE) AS CC, MIN(PRFT_CUST_ID) AS PID,
           MIN(TRIM(TO_CHAR(CUST_TYPE))) AS CT, COUNT(*) AS N
      FROM MG_CUSTOMER_INTER
     GROUP BY TRIM(CUSTOMER_CODE)
),
CUR AS (
    SELECT TRIM(SHORT_DESCR) AS CCY, MIN(DISPLAYED_DECIMAL) AS DEC, MIN(ID_CURRENCY) AS CID
      FROM CURRENCY
     GROUP BY TRIM(SHORT_DESCR)
),
HS AS (
    SELECT /*+ MATERIALIZE */
           s.*,
           c.CSSN,
           SUBSTR('Residential Property for ' || c.CSSN, 1, 40)            AS X_DESC,
           cu.CID                                                           AS X_CCY_ID,
           s.SCVR / (CASE WHEN cu.DEC = 2 THEN 100 ELSE 1 END)              AS X_VAL,
           s.INSA / (CASE WHEN cu.DEC = 2 THEN 100 ELSE 1 END)              AS X_INS
      FROM R_SEC s
      JOIN R_CUS c     ON c.CC = s.CC
      LEFT JOIN CUR cu ON cu.CCY = s.CCY
     WHERE s.SCCD IN (SELECT CODE FROM R_STD)
),
STK AS (
    SELECT /*+ MATERIALIZE */
           TRIM(CUSTOMER_CODE) AS CC, TRIM(SECURITY_SERIAL) AS SCSR, TRIM(SECURITY_CODE) AS SCCD, MIN(SN) AS SN
      FROM MG_COLLATERALS_REAL_ESTATE
     WHERE TRIM(FILE_NAME) = 'CollateralsRealEstate'
     GROUP BY TRIM(CUSTOMER_CODE), TRIM(SECURITY_SERIAL), TRIM(SECURITY_CODE)
),
STG AS (
    SELECT /*+ MATERIALIZE */
           SERIAL_NO AS SN, MIN(PRFT_ID) AS PRFT_ID,
           MIN(TRIM(TO_CHAR(ROW_STATUS))) AS RS, MIN(TRIM(COLL_ERR_DESC)) AS ERR
      FROM MG_REAL_ESTATE
     WHERE TRIM(FILE_NAME) = 'CollateralsRealEstate'
     GROUP BY SERIAL_NO
),
PRE AS (
    SELECT DISTINCT PRFT_ID FROM MG_REAL_ESTATE WHERE TRIM(FILE_NAME) = 'REAL_ESTATE_PRENOTICES' AND PRFT_ID IS NOT NULL
),
STA AS (
    SELECT DISTINCT PRFT_ID FROM MG_REAL_ESTATE WHERE PRFT_ID IS NOT NULL
),
RE AS (
    SELECT /*+ MATERIALIZE */
           ID, COMMERCIAL_VAL_AMN AS COMM_V, REAL_EST_VAL_AMN AS RE_V, TOTAL_VALUE_AMN AS TOT_V,
           EST_INSUR_AMN AS INS_V, TRIM(ADD_DESCR1) AS DESCR1, TRIM(REAL_ESTATE_DESC) AS RDESC,
           TRIM(TO_CHAR(REEVAL_FREQ)) AS REEVAL
      FROM REAL_ESTATE
),
AP AS (
    SELECT /*+ MATERIALIZE */
           FK_REAL_ESTATEID AS RE_ID, COUNT(*) AS N,
           MIN(TRUNC(END_DT)) AS END_D, MIN(TRUNC(EVALUATION_DT)) AS EVAL_D, MIN(TRUNC(ADOPTION_VAL_DT)) AS ADOPT_D,
           MIN(MORTGAGE_VALUE) AS MORT_V, MIN(COMMERC_VALUE) AS COMM_V, MIN(EST_INSUR_AMN) AS INS_V,
           MIN(TRIM(TO_CHAR(REEVAL_FREQ))) AS REEVAL,
           MIN(FK_MOR_CURR_ID) AS MOR_C, MIN(FK_COMM_CURR_ID) AS COMM_C, MIN(FK_INS_CURR_ID) AS INS_C
      FROM REAL_ESTATE_APPRSL
     GROUP BY FK_REAL_ESTATEID
),
RC AS (
    SELECT /*+ MATERIALIZE */ FK_REAL_ESTATEID AS RE_ID, FK_CUSTOMERCUST_ID AS CID, OWNERSH_PERC AS PERC
      FROM REAL_ESTATE_CUST
),
H AS (
    SELECT /*+ MATERIALIZE */
           h.*,
           h.SCCD || '-' || h.SCSR || CASE WHEN r.ID IS NOT NULL THEN ' / ' || r.ID END AS SKEY,
           k.SN, g.SN AS G_SN, g.PRFT_ID, g.RS, g.ERR,
           r.ID AS P_ID, r.COMM_V, r.RE_V, r.TOT_V, r.INS_V, r.DESCR1, r.RDESC, r.REEVAL,
           a.N AS AP_N, a.END_D, a.EVAL_D, a.ADOPT_D, a.MORT_V, a.COMM_V AS AP_COMM_V, a.INS_V AS AP_INS_V,
           a.REEVAL AS AP_REEVAL, a.MOR_C, a.COMM_C, a.INS_C
      FROM HS h
      LEFT JOIN STK k ON k.CC = h.CC AND k.SCSR = h.SCSR AND k.SCCD = h.SCCD
      LEFT JOIN STG g ON g.SN = k.SN
      LEFT JOIN RE r  ON r.ID = g.PRFT_ID
      LEFT JOIN AP a  ON a.RE_ID = r.ID
),
EO AS (
    SELECT /*+ MATERIALIZE */ DISTINCT x.CC, x.PID
      FROM (SELECT m.CC, m.PID
              FROM MCI m
             WHERE NVL(m.CT, '#') &lt;&gt; '3'
            UNION ALL
            SELECT j.JC, mm.PID
              FROM R_JNT j
              JOIN MCI m  ON m.CC = j.JC AND m.CT = '3'
              JOIN MCI mm ON mm.CC = j.MC) x
     WHERE x.CC IN (SELECT CC FROM HS)
       AND x.PID IS NOT NULL
),
RCH AS (
    SELECT /*+ MATERIALIZE */
           r.RE_ID, r.CID, r.PERC, h.CC, h.SKEY,
           CASE WHEN e.PID IS NOT NULL THEN 'Y' ELSE 'N' END AS EXP_OK,
           COUNT(*) OVER (PARTITION BY r.RE_ID) AS N_OWN,
           ROW_NUMBER() OVER (PARTITION BY r.RE_ID ORDER BY CASE WHEN e.PID IS NOT NULL THEN 0 ELSE 1 END, r.CID) AS RN
      FROM RC r
      JOIN (SELECT P_ID, MIN(CC) AS CC, MIN(SKEY) AS SKEY FROM H WHERE P_ID IS NOT NULL GROUP BY P_ID) h ON h.P_ID = r.RE_ID
      LEFT JOIN EO e ON e.CC = h.CC AND e.PID = r.CID
),
FINDINGS AS (
    -- Μία γραμμή ανά εύρημα. CUSTOMER_CODE = πελάτης HUB (SSSECHP.CUSTOMER_CODE), SERIAL_NO = Y2SCCD-Y2SCSR / REAL_ESTATE.ID
    -- ('ID n' για ακίνητο PROFITS χωρίς HUB). HUB_VALUE = τιμή HUB, NCIS_VALUE = τιμή PROFITS (δεν υπάρχει NCIS extract).
    -- Αναμενόμενη τιμή (μόνο από τα scripts) στο ISSUE.
    --==============================================================
    --REA-001. Εξασφάλιση που μεταφέρει το 80000 χωρίς ακίνητο στο REAL_ESTATE. ISSUE = πού χάθηκε.
    SELECT
      CAST('REA-001_PROPERTY_MISSING_IN_PROFITS' AS VARCHAR2(50)) AS CHECK_NAME,
      CAST(h.CC AS VARCHAR2(40)) AS CUSTOMER_CODE,
      CAST(h.SKEY AS VARCHAR2(40)) AS SERIAL_NO,
      CAST(SUBSTR('Y2SCCD=' || h.SCCD || '; Y2SCVR=' || h.SCVR || ' ' || h.CCY, 1, 200) AS VARCHAR2(200)) AS HUB_VALUE,
      CAST(NULL AS VARCHAR2(200)) AS NCIS_VALUE,
      CAST(SUBSTR(CASE WHEN h.SN IS NULL      THEN 'NOT IN MG_COLLATERALS_REAL_ESTATE'
                       WHEN h.G_SN IS NULL    THEN 'NOT IN MG_REAL_ESTATE'
                       WHEN h.PRFT_ID IS NULL THEN CASE WHEN h.RS = '2' THEN 'REJECTED: ' || NVL(h.ERR, '-')
                                                        ELSE 'STAGED WITHOUT PRFT_ID' END
                       ELSE 'PRFT_ID ' || h.PRFT_ID || ' NOT IN REAL_ESTATE' END, 1, 50) AS VARCHAR2(50)) AS ISSUE
    FROM H h
    WHERE h.P_ID IS NULL
    UNION ALL
    --==============================================================
    --REA-002. Ακίνητο στο REAL_ESTATE που δεν είναι εξασφάλιση του HUB (εκτός prenotices, REA-027).
    SELECT 'REA-002_PROPERTY_MISSING_IN_HUB', CAST(NULL AS VARCHAR2(40)), 'ID ' || r.ID,
           CAST(NULL AS VARCHAR2(200)),
           SUBSTR('DESC=' || r.RDESC || '; VALUE=' || r.COMM_V, 1, 200),
           CASE WHEN r.ID IN (SELECT PRFT_ID FROM STA) THEN 'STAGED, NOT IN THE HUB SCOPE'
                ELSE 'NOT IN MG_REAL_ESTATE' END
    FROM RE r
    WHERE r.ID NOT IN (SELECT P_ID FROM H WHERE P_ID IS NOT NULL)
      AND r.ID NOT IN (SELECT PRFT_ID FROM PRE)
    UNION ALL
    --==============================================================
    --REA-003. REAL_ESTATE.COMMERCIAL_VAL_AMN vs Y2SCVR (/100 όταν DISPLAYED_DECIMAL = 2).
    SELECT 'REA-003_COMMERCIAL_VALUE_MISMATCH', h.CC, h.SKEY,
           h.SCVR || ' ' || h.CCY, TO_CHAR(h.COMM_V),
           SUBSTR('MISMATCH (EXPECTED ' || TO_CHAR(ROUND(h.X_VAL, 2)) || ')', 1, 50)
    FROM H h
    WHERE h.P_ID IS NOT NULL AND NVL(ROUND(h.COMM_V, 2), -1) &lt;&gt; NVL(ROUND(h.X_VAL, 2), -1)
    UNION ALL
    --==============================================================
    --REA-004. REAL_ESTATE.REAL_EST_VAL_AMN vs Y2SCVR.
    SELECT 'REA-004_REAL_ESTATE_VALUE_MISMATCH', h.CC, h.SKEY,
           h.SCVR || ' ' || h.CCY, TO_CHAR(h.RE_V),
           SUBSTR('MISMATCH (EXPECTED ' || TO_CHAR(ROUND(h.X_VAL, 2)) || ')', 1, 50)
    FROM H h
    WHERE h.P_ID IS NOT NULL AND NVL(ROUND(h.RE_V, 2), -1) &lt;&gt; NVL(ROUND(h.X_VAL, 2), -1)
    UNION ALL
    --==============================================================
    --REA-005. REAL_ESTATE.TOTAL_VALUE_AMN vs Y2SCVR.
    SELECT 'REA-005_TOTAL_VALUE_MISMATCH', h.CC, h.SKEY,
           h.SCVR || ' ' || h.CCY, TO_CHAR(h.TOT_V),
           SUBSTR('MISMATCH (EXPECTED ' || TO_CHAR(ROUND(h.X_VAL, 2)) || ')', 1, 50)
    FROM H h
    WHERE h.P_ID IS NOT NULL AND NVL(ROUND(h.TOT_V, 2), -1) &lt;&gt; NVL(ROUND(h.X_VAL, 2), -1)
    UNION ALL
    --==============================================================
    --REA-006. EST_INSUR_AMN (REAL_ESTATE και REAL_ESTATE_APPRSL) vs Y2INSA (/100 όταν DISPLAYED_DECIMAL = 2).
    SELECT 'REA-006_INSURED_AMOUNT_MISMATCH', h.CC, h.SKEY,
           h.INSA || ' ' || h.CCY,
           SUBSTR('REAL_ESTATE=' || h.INS_V || CASE WHEN h.AP_N IS NOT NULL THEN '; APPRSL=' || h.AP_INS_V END, 1, 200),
           SUBSTR('MISMATCH (EXPECTED ' || TO_CHAR(ROUND(h.X_INS, 2)) || ')', 1, 50)
    FROM H h
    WHERE h.P_ID IS NOT NULL
      AND (NVL(ROUND(h.INS_V, 2), -1) &lt;&gt; NVL(ROUND(h.X_INS, 2), -1)
           OR (h.AP_N IS NOT NULL AND NVL(ROUND(h.AP_INS_V, 2), -1) &lt;&gt; NVL(ROUND(h.X_INS, 2), -1)))
    UNION ALL
    --==============================================================
    --REA-007. REAL_ESTATE.ADD_DESCR1 vs Y2NAR1..Y2NARC (πρώτοι 80 χαρακτήρες).
    SELECT 'REA-007_DESCRIPTION_MISMATCH', h.CC, h.SKEY,
           SUBSTR(h.X_DESCR1, 1, 200), SUBSTR(h.DESCR1, 1, 200),
           'MISMATCH (EXPECTED HUB NARRATIVE, 80 CHARS)'
    FROM H h
    WHERE h.P_ID IS NOT NULL AND NVL(h.DESCR1, '~') &lt;&gt; NVL(TRIM(h.X_DESCR1), '~')
    UNION ALL
    --==============================================================
    --REA-008. REAL_ESTATE.REAL_ESTATE_DESC vs 'Residential Property for ' || ZGCSSN (40).
    SELECT 'REA-008_PROPERTY_NAME_MISMATCH', h.CC, h.SKEY,
           'ZGCSSN=' || h.CSSN, h.RDESC,
           SUBSTR('MISMATCH (EXPECTED ' || TRIM(h.X_DESC) || ')', 1, 50)
    FROM H h
    WHERE h.P_ID IS NOT NULL AND NVL(h.RDESC, '~') &lt;&gt; NVL(TRIM(h.X_DESC), '~')
    UNION ALL
    --==============================================================
    --REA-009. REEVAL_FREQ (REAL_ESTATE και REAL_ESTATE_APPRSL) vs Y2RUFQ (όχι κενό -&gt; 1, αλλιώς 2).
    SELECT 'REA-009_REVALUATION_FREQ_MISMATCH', h.CC, h.SKEY,
           'Y2RUFQ=' || NVL(h.RUFQ, 'BLANK'),
           'REAL_ESTATE=' || h.REEVAL || CASE WHEN h.AP_N IS NOT NULL THEN '; APPRSL=' || h.AP_REEVAL END,
           'MISMATCH (EXPECTED ' || h.X_REEVAL || ')'
    FROM H h
    WHERE h.P_ID IS NOT NULL
      AND (NVL(h.REEVAL, '#') &lt;&gt; h.X_REEVAL OR (h.AP_N IS NOT NULL AND NVL(h.AP_REEVAL, '#') &lt;&gt; h.X_REEVAL))
    UNION ALL
    --==============================================================
    --REA-010. Ακίνητο του HUB χωρίς τον αναμενόμενο owner στο REAL_ESTATE_CUST (joint: οποιοδήποτε μέλος).
    SELECT 'REA-010_OWNER_MISSING_IN_PROFITS', h.CC, h.SKEY,
           'CUSTOMER ' || h.CC || CASE WHEN m.CT = '3' THEN ' (JOINT PROFILE)' END,
           SUBSTR((SELECT 'OWNERS=' || COUNT(*) || '; FIRST=' || MIN(r.CID) FROM RC r WHERE r.RE_ID = h.P_ID), 1, 200),
           SUBSTR(CASE WHEN m.CC IS NULL THEN 'OWNER NOT IN MG_CUSTOMER_INTER'
                       WHEN NOT EXISTS (SELECT 1 FROM EO e WHERE e.CC = h.CC)
                            THEN CASE WHEN m.CT = '3' THEN 'JOINT: NO MEMBER MIGRATED' ELSE 'OWNER HAS NO PRFT_CUST_ID' END
                       WHEN NOT EXISTS (SELECT 1 FROM RC r WHERE r.RE_ID = h.P_ID) THEN 'NO OWNER IN PROFITS'
                       ELSE 'OTHER OWNER IN PROFITS' END, 1, 50)
    FROM H h
    LEFT JOIN MCI m ON m.CC = h.CC
    WHERE h.P_ID IS NOT NULL
      AND NOT EXISTS (SELECT 1 FROM RC r JOIN EO e ON e.PID = r.CID WHERE r.RE_ID = h.P_ID AND e.CC = h.CC)
    UNION ALL
    --==============================================================
    --REA-011. Γραμμή REAL_ESTATE_CUST ακινήτου του HUB με πελάτη που δεν είναι ο owner, ή 2ος owner.
    SELECT 'REA-011_OWNER_NOT_EXPECTED', x.CC, x.SKEY,
           'CUSTOMER ' || x.CC, 'OWNER=' || x.CID || '; OWNER ROWS=' || x.N_OWN,
           CASE WHEN x.EXP_OK = 'N' THEN 'NOT THE HUB OWNER'
                ELSE SUBSTR('MORE THAN ONE OWNER (' || x.N_OWN || ' ROWS)', 1, 50) END
    FROM RCH x
    WHERE x.EXP_OK = 'N' OR x.RN &gt; 1
    UNION ALL
    --==============================================================
    --REA-012. REAL_ESTATE_CUST.OWNERSH_PERC &lt;&gt; 100 σε ακίνητο του HUB (80000 / 90000: 100).
    SELECT 'REA-012_OWNERSHIP_PERCENT_MISMATCH', x.CC, x.SKEY,
           'CUSTOMER ' || x.CC, 'OWNER=' || x.CID || '; PERC=' || x.PERC,
           'MISMATCH (EXPECTED 100)'
    FROM RCH x
    WHERE NVL(x.PERC, -1) &lt;&gt; 100
    UNION ALL
    --==============================================================
    --REA-013. Ακίνητο του HUB χωρίς appraisal ή με περισσότερα από ένα.
    SELECT 'REA-013_APPRAISAL_MISSING_IN_PROFITS', h.CC, h.SKEY,
           'Y2SCVR=' || h.SCVR || ' ' || h.CCY, NVL(TO_CHAR(h.AP_N), '0') || ' APPRAISAL ROWS',
           CASE WHEN h.AP_N IS NULL THEN 'NO APPRAISAL IN PROFITS'
                ELSE SUBSTR('MORE THAN ONE APPRAISAL (' || h.AP_N || ')', 1, 50) END
    FROM H h
    WHERE h.P_ID IS NOT NULL AND NVL(h.AP_N, 0) &lt;&gt; 1
    UNION ALL
    --==============================================================
    --REA-014. REAL_ESTATE_APPRSL.END_DT vs Y2SCEX (80000: έγκυρη ημερομηνία, αλλιώς 2999-12-31).
    SELECT 'REA-014_APPRAISAL_END_DATE_MISMATCH', h.CC, h.SKEY,
           TO_CHAR(h.X_END_D, 'YYYY-MM-DD'), TO_CHAR(h.END_D, 'YYYY-MM-DD'),
           'MISMATCH (EXPECTED ' || NVL(TO_CHAR(h.X_END_D, 'YYYY-MM-DD'), 'EMPTY') || ')'
    FROM H h
    WHERE h.AP_N IS NOT NULL AND NVL(h.END_D, DATE '0001-01-01') &lt;&gt; NVL(TRUNC(h.X_END_D), DATE '0001-01-01')
    UNION ALL
    --==============================================================
    --REA-015. REAL_ESTATE_APPRSL.EVALUATION_DT vs Y2VLD.
    SELECT 'REA-015_APPRAISAL_VALUATION_DATE_MISMATCH', h.CC, h.SKEY,
           TO_CHAR(h.X_EVAL_D, 'YYYY-MM-DD'), TO_CHAR(h.EVAL_D, 'YYYY-MM-DD'),
           'MISMATCH (EXPECTED ' || NVL(TO_CHAR(h.X_EVAL_D, 'YYYY-MM-DD'), 'EMPTY') || ')'
    FROM H h
    WHERE h.AP_N IS NOT NULL AND NVL(h.EVAL_D, DATE '0001-01-01') &lt;&gt; NVL(TRUNC(h.X_EVAL_D), DATE '0001-01-01')
    UNION ALL
    --==============================================================
    --REA-016. REAL_ESTATE_APPRSL.ADOPTION_VAL_DT vs Y2OVLD.
    SELECT 'REA-016_APPRAISAL_ORIGINAL_DATE_MISMATCH', h.CC, h.SKEY,
           TO_CHAR(h.X_ADOPT_D, 'YYYY-MM-DD'), TO_CHAR(h.ADOPT_D, 'YYYY-MM-DD'),
           'MISMATCH (EXPECTED ' || NVL(TO_CHAR(h.X_ADOPT_D, 'YYYY-MM-DD'), 'EMPTY') || ')'
    FROM H h
    WHERE h.AP_N IS NOT NULL AND NVL(h.ADOPT_D, DATE '0001-01-01') &lt;&gt; NVL(TRUNC(h.X_ADOPT_D), DATE '0001-01-01')
    UNION ALL
    --==============================================================
    --REA-017. REAL_ESTATE_APPRSL.MORTGAGE_VALUE vs Y2SCVR.
    SELECT 'REA-017_APPRAISAL_MORTGAGE_VALUE_MISMATCH', h.CC, h.SKEY,
           h.SCVR || ' ' || h.CCY, TO_CHAR(h.MORT_V),
           SUBSTR('MISMATCH (EXPECTED ' || TO_CHAR(ROUND(h.X_VAL, 2)) || ')', 1, 50)
    FROM H h
    WHERE h.AP_N IS NOT NULL AND NVL(ROUND(h.MORT_V, 2), -1) &lt;&gt; NVL(ROUND(h.X_VAL, 2), -1)
    UNION ALL
    --==============================================================
    --REA-018. REAL_ESTATE_APPRSL.COMMERC_VALUE vs Y2SCVR (staging APP_COMMERC_AMN).
    SELECT 'REA-018_APPRAISAL_COMMERCIAL_VALUE_MISMATCH', h.CC, h.SKEY,
           h.SCVR || ' ' || h.CCY, TO_CHAR(h.AP_COMM_V),
           SUBSTR('MISMATCH (EXPECTED ' || TO_CHAR(ROUND(h.X_VAL, 2)) || ')', 1, 50)
    FROM H h
    WHERE h.AP_N IS NOT NULL AND NVL(ROUND(h.AP_COMM_V, 2), -1) &lt;&gt; NVL(ROUND(h.X_VAL, 2), -1)
    UNION ALL
    --==============================================================
    --REA-019. REAL_ESTATE_APPRSL FK_MOR / FK_COMM / FK_INS_CURR_ID vs CURRENCY.ID_CURRENCY του Y2SCCY
    --         (80000: MOR / COMM / INS_CURR_DESCR = Y2SCCY).
    SELECT 'REA-019_APPRAISAL_CURRENCY_MISMATCH', h.CC, h.SKEY,
           'Y2SCCY=' || h.CCY, 'MOR=' || h.MOR_C || '; COMM=' || h.COMM_C || '; INS=' || h.INS_C,
           SUBSTR(RTRIM(CASE WHEN NVL(h.MOR_C, -1)  &lt;&gt; NVL(h.X_CCY_ID, -2) THEN 'MOR/' END
                     || CASE WHEN NVL(h.COMM_C, -1) &lt;&gt; NVL(h.X_CCY_ID, -2) THEN 'COMM/' END
                     || CASE WHEN NVL(h.INS_C, -1)  &lt;&gt; NVL(h.X_CCY_ID, -2) THEN 'INS/' END, '/')
                  || ' CURR MISMATCH (EXPECTED ' || NVL(TO_CHAR(h.X_CCY_ID), 'NONE') || ')', 1, 50)
    FROM H h
    WHERE h.AP_N IS NOT NULL
      AND (NVL(h.MOR_C, -1) &lt;&gt; NVL(h.X_CCY_ID, -2) OR NVL(h.COMM_C, -1) &lt;&gt; NVL(h.X_CCY_ID, -2) OR NVL(h.INS_C, -1) &lt;&gt; NVL(h.X_CCY_ID, -2))
)
,
POPULATIONS AS (
    SELECT
        (SELECT COUNT(*) FROM R_SEC)                                                 AS HUB_ALL_COUNT,
        (SELECT COUNT(*) FROM R_SEC WHERE SCCD IN (SELECT CODE FROM R_STD))           AS HUB_CODE_COUNT,
        (SELECT COUNT(*) FROM H)                                                     AS HUB_IN_COUNT,
        (SELECT COUNT(*) FROM RE WHERE ID NOT IN (SELECT PRFT_ID FROM PRE))           AS PROF_COUNT,
        (SELECT COUNT(*) FROM H WHERE P_ID IS NOT NULL)                              AS MATCHED_COUNT,
        (SELECT COUNT(*) FROM H WHERE AP_N IS NOT NULL)                              AS MATCHED_AP_COUNT,
        (SELECT COUNT(*) FROM RCH)                                                   AS RC_HUB_COUNT,
        (SELECT COUNT(*) FROM RE)                                                    AS RE_ALL_COUNT
    FROM DUAL
),
CHECK_META AS (
    -- CHECK_ID | CHECK_NAME | CATEGORY | DESCRIPTION | POPULATION_TYPE
    SELECT 'REA-001' AS CHECK_ID, 'REA-001_PROPERTY_MISSING_IN_PROFITS' AS CHECK_NAME, 'EXISTENCE' AS CATEGORY, 'HUB real estate securities that the migration selects but that are not in PROFITS. The detail rows give the step where the property was lost.' AS DESCRIPTION, 'HUB_IN' AS POPULATION_TYPE FROM DUAL UNION ALL
    SELECT 'REA-002', 'REA-002_PROPERTY_MISSING_IN_HUB',               'EXISTENCE',             'Properties in PROFITS that are not HUB real estate securities selected by the migration. Prenotice properties are left out.', 'PROF' FROM DUAL UNION ALL
    SELECT 'REA-003', 'REA-003_COMMERCIAL_VALUE_MISMATCH',             'CROSS_SYSTEM_MISMATCH', 'The commercial value of the property in PROFITS differs from the HUB security value, in currency units.', 'MATCHED' FROM DUAL UNION ALL
    SELECT 'REA-004', 'REA-004_REAL_ESTATE_VALUE_MISMATCH',            'CROSS_SYSTEM_MISMATCH', 'The real estate value in PROFITS differs from the HUB security value, in currency units.', 'MATCHED' FROM DUAL UNION ALL
    SELECT 'REA-005', 'REA-005_TOTAL_VALUE_MISMATCH',                  'CROSS_SYSTEM_MISMATCH', 'The total value of the property in PROFITS differs from the HUB security value, in currency units.', 'MATCHED' FROM DUAL UNION ALL
    SELECT 'REA-006', 'REA-006_INSURED_AMOUNT_MISMATCH',               'CROSS_SYSTEM_MISMATCH', 'The insured amount of the property or of its appraisal in PROFITS differs from the HUB insurance amount, in currency units.', 'MATCHED' FROM DUAL UNION ALL
    SELECT 'REA-007', 'REA-007_DESCRIPTION_MISMATCH',                  'CROSS_SYSTEM_MISMATCH', 'The additional description in PROFITS differs from the HUB security narrative lines joined (first 80 characters).', 'MATCHED' FROM DUAL UNION ALL
    SELECT 'REA-008', 'REA-008_PROPERTY_NAME_MISMATCH',                'CROSS_SYSTEM_MISMATCH', 'The property description in PROFITS differs from Residential Property for plus the HUB customer short name (40 characters).', 'MATCHED' FROM DUAL UNION ALL
    SELECT 'REA-009', 'REA-009_REVALUATION_FREQ_MISMATCH',             'CROSS_SYSTEM_MISMATCH', 'The revaluation frequency of the property or its appraisal in PROFITS differs from the value the migration sets from the HUB revaluation indicator.', 'MATCHED' FROM DUAL UNION ALL
    SELECT 'REA-010', 'REA-010_OWNER_MISSING_IN_PROFITS',              'EXISTENCE',             'Properties in PROFITS without the migrated HUB security customer as owner (joint profiles: any member). The detail rows give the reason.', 'MATCHED' FROM DUAL UNION ALL
    SELECT 'REA-011', 'REA-011_OWNER_NOT_EXPECTED',                    'EXISTENCE',             'Owner rows of HUB properties in PROFITS whose customer is not the migrated HUB owner, or a second owner of the same property.', 'RC_HUB' FROM DUAL UNION ALL
    SELECT 'REA-012', 'REA-012_OWNERSHIP_PERCENT_MISMATCH',            'CROSS_SYSTEM_MISMATCH', 'Owner rows of HUB properties in PROFITS with an ownership percentage other than the 100 the migration sets.', 'RC_HUB' FROM DUAL UNION ALL
    SELECT 'REA-013', 'REA-013_APPRAISAL_MISSING_IN_PROFITS',          'EXISTENCE',             'HUB properties in PROFITS with no appraisal, or with more than one.', 'MATCHED' FROM DUAL UNION ALL
    SELECT 'REA-014', 'REA-014_APPRAISAL_END_DATE_MISMATCH',           'CROSS_SYSTEM_MISMATCH', 'The appraisal end date in PROFITS differs from the HUB security expiry date the migration sends (31/12/2999 when not a valid date).', 'MATCHED_AP' FROM DUAL UNION ALL
    SELECT 'REA-015', 'REA-015_APPRAISAL_VALUATION_DATE_MISMATCH',     'CROSS_SYSTEM_MISMATCH', 'The appraisal valuation date in PROFITS differs from the HUB valuation date the migration sends (31/12/2999 when not a valid date).', 'MATCHED_AP' FROM DUAL UNION ALL
    SELECT 'REA-016', 'REA-016_APPRAISAL_ORIGINAL_DATE_MISMATCH',      'CROSS_SYSTEM_MISMATCH', 'The appraisal adoption date in PROFITS differs from the HUB original valuation date the migration sends (31/12/2999 when not a valid date).', 'MATCHED_AP' FROM DUAL UNION ALL
    SELECT 'REA-017', 'REA-017_APPRAISAL_MORTGAGE_VALUE_MISMATCH',     'CROSS_SYSTEM_MISMATCH', 'The appraisal mortgage value in PROFITS differs from the HUB security value, in currency units.', 'MATCHED_AP' FROM DUAL UNION ALL
    SELECT 'REA-018', 'REA-018_APPRAISAL_COMMERCIAL_VALUE_MISMATCH',   'CROSS_SYSTEM_MISMATCH', 'The appraisal commercial value in PROFITS differs from the HUB security value, in currency units.', 'MATCHED_AP' FROM DUAL UNION ALL
    SELECT 'REA-019', 'REA-019_APPRAISAL_CURRENCY_MISMATCH',           'CROSS_SYSTEM_MISMATCH', 'The mortgage, commercial or insurance currency of the appraisal in PROFITS is not the HUB security currency.', 'MATCHED_AP' FROM DUAL UNION ALL
    SELECT 'REA-020', 'REA-020_SECURITIES_IN_SCOPE',                   'INFO',                  'Information only: HUB securities the migration selects as real estate, by security code (codes whose parameter description ends in D or E). No detail rows.', 'HUB_ALL' FROM DUAL UNION ALL
    SELECT 'REA-021', 'REA-021_TANGIBLE_CODES_OUT_OF_SCOPE',           'INFO',                  'Information only: tangible HUB securities whose code is not selected as real estate. No detail rows.', 'HUB_ALL' FROM DUAL UNION ALL
    SELECT 'REA-022', 'REA-022_CUSTOMER_NOT_IN_HUB',                   'INFO',                  'Information only: real estate securities whose customer is not in the HUB customer file, which the migration leaves out without a message. No detail rows.', 'HUB_CODE' FROM DUAL UNION ALL
    SELECT 'REA-023', 'REA-023_SHADOW_RECORDS',                        'INFO',                  'Information only: selected HUB securities that are shadow records. The migration does not filter them out. No detail rows.', 'HUB_IN' FROM DUAL UNION ALL
    SELECT 'REA-024', 'REA-024_JOINT_CO_OWNERS_NOT_MIGRATED',          'INFO',                  'Information only: selected securities of joint profiles with more than one member; the migration keeps one member as owner with 100 percent. No detail rows.', 'HUB_IN' FROM DUAL UNION ALL
    SELECT 'REA-025', 'REA-025_INSURANCE_EXPIRY_NOT_MIGRATED',         'INFO',                  'Information only: selected securities with a HUB insurance expiry date, which the migration converts but does not load. No detail rows.', 'HUB_IN' FROM DUAL UNION ALL
    SELECT 'REA-026', 'REA-026_HUB_FIELDS_NOT_MIGRATED',               'INFO',                  'Information only: selected securities with central bank code, CARM id, sign indicator, remaining term or pledged amount set in HUB, which the migration does not load. No detail rows.', 'HUB_IN' FROM DUAL UNION ALL
    SELECT 'REA-027', 'REA-027_PRENOTICE_PROPERTIES',                  'INFO',                  'Information only: properties in PROFITS loaded from the prenotice file, not from HUB. No detail rows.', 'RE_ALL' FROM DUAL
),
FINDINGS_COUNT AS (
    SELECT CHECK_ID, COUNT(*) AS INVALID_COUNT
    FROM (SELECT SUBSTR(CHECK_NAME, 1, INSTR(CHECK_NAME, '_') - 1) AS CHECK_ID FROM FINDINGS)
    GROUP BY CHECK_ID
    UNION ALL
    -- INFO, μόνο Master (χωρίς γραμμές στο Detail)
    SELECT 'REA-020', P.HUB_IN_COUNT FROM POPULATIONS P -- INFO
    UNION ALL
    SELECT 'REA-021', COUNT(*) FROM R_SEC WHERE TANI = 'Y' AND NVL(SCCD, '#') NOT IN (SELECT CODE FROM R_STD) -- INFO
    UNION ALL
    SELECT 'REA-022', COUNT(*) FROM R_SEC s WHERE s.SCCD IN (SELECT CODE FROM R_STD) AND NOT EXISTS (SELECT 1 FROM R_CUS c WHERE c.CC = s.CC) -- INFO
    UNION ALL
    SELECT 'REA-023', COUNT(*) FROM H WHERE MDFL = 'S' -- INFO
    UNION ALL
    SELECT 'REA-024', COUNT(*) FROM H h JOIN MCI m ON m.CC = h.CC AND m.CT = '3' WHERE (SELECT COUNT(*) FROM R_JNT j WHERE j.JC = h.CC) &gt; 1 -- INFO
    UNION ALL
    SELECT 'REA-025', COUNT(*) FROM H WHERE X_INSEX_D IS NOT NULL AND X_INSEX_D &lt;&gt; DATE '2999-12-31' -- INFO
    UNION ALL
    SELECT 'REA-026', COUNT(*) FROM H WHERE NOTGT = 1 -- INFO
    UNION ALL
    SELECT 'REA-027', COUNT(*) FROM RE WHERE ID IN (SELECT PRFT_ID FROM PRE) -- INFO
)
SELECT
    CAST(CM.CHECK_ID AS VARCHAR2(10)) AS CHECK_ID,
    CAST(CM.CHECK_NAME AS VARCHAR2(50)) AS CHECK_NAME,
    CAST(CM.CATEGORY AS VARCHAR2(30)) AS CATEGORY,
    CAST(CM.DESCRIPTION AS VARCHAR2(200)) AS DESCRIPTION,
    (CASE CM.POPULATION_TYPE
        WHEN 'HUB_ALL'    THEN P.HUB_ALL_COUNT
        WHEN 'HUB_CODE'   THEN P.HUB_CODE_COUNT
        WHEN 'HUB_IN'     THEN P.HUB_IN_COUNT
        WHEN 'PROF'       THEN P.PROF_COUNT
        WHEN 'MATCHED'    THEN P.MATCHED_COUNT
        WHEN 'MATCHED_AP' THEN P.MATCHED_AP_COUNT
        WHEN 'RC_HUB'     THEN P.RC_HUB_COUNT
        WHEN 'RE_ALL'     THEN P.RE_ALL_COUNT
     END) AS TOTAL_RECORDS,
    (CASE CM.POPULATION_TYPE
        WHEN 'HUB_ALL'    THEN P.HUB_ALL_COUNT
        WHEN 'HUB_CODE'   THEN P.HUB_CODE_COUNT
        WHEN 'HUB_IN'     THEN P.HUB_IN_COUNT
        WHEN 'PROF'       THEN P.PROF_COUNT
        WHEN 'MATCHED'    THEN P.MATCHED_COUNT
        WHEN 'MATCHED_AP' THEN P.MATCHED_AP_COUNT
        WHEN 'RC_HUB'     THEN P.RC_HUB_COUNT
        WHEN 'RE_ALL'     THEN P.RE_ALL_COUNT
     END) - NVL(FC.INVALID_COUNT, 0) AS VALID_COUNT,
    NVL(FC.INVALID_COUNT, 0) AS INVALID_COUNT,
    CASE WHEN CM.CATEGORY = 'INFO'           THEN 'INFO'
         WHEN NVL(FC.INVALID_COUNT, 0) = 0   THEN 'PASS'
         ELSE 'FAIL' END AS STATUS,
    'DC5' AS DC_VERSION,
    1 AS RUN_VERSION,  -- TESTING ONLY: στο SSIS αντικαθίσταται από @[User::RunVersion] μέσω Derived Column.
    SYSDATE AS RUN_TIMESTAMP
FROM CHECK_META CM
CROSS JOIN POPULATIONS P
LEFT JOIN FINDINGS_COUNT FC ON FC.CHECK_ID = CM.CHECK_ID
ORDER BY REGEXP_SUBSTR(CM.CHECK_ID, '[A-Z]+'), TO_NUMBER(REGEXP_SUBSTR(CM.CHECK_ID, '[0-9]+'));</property>
