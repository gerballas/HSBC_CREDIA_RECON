                          name="NCIS_VALUE" />
                        <outputColumn
                          refId="Package\Sequence Container\SEPA_Detail\SEPA_detail.Outputs[Oracle Source Output].Columns[ISSUE]"
                          codePage="1253"
                          dataType="str"
                          externalMetadataColumnId="Package\Sequence Container\SEPA_Detail\SEPA_detail.Outputs[Oracle Source Output].ExternalColumns[ISSUE]"
                          length="50"
