                      description="The name of the table to be fetched."
                      expressionType="Notify"
                      name="TableName"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      expressionType="Notify"
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">-- ====================================================================
-- BEN_RECON — MASTER DC5 v1.2 (Beneficiaries: deposit co-holders, loan co-borrowers)
-- Τροφοδοτεί: RECON.BEN_RECON_MASTER (όνομα πίνακα προς επιβεβαίωση: δεν υπάρχει ακόμη στο
-- SSIS scripts\Recon_tables.sql)
-- Μία γραμμή ΑΝΑ CHECK_ID — 7 γραμμές ανά run: BEN-001 .. BEN-007.
--
-- Beneficiaries (ME01 HUB, EIM 240825, DD v1.24): HUB SS@PRJIP (joint profiles) + DDACMSP / TDACMSP / LSACMSP vs
-- PROFITS BENEFICIARY / DEPOSIT_ACCOUNT / AGREEMENT_BENEF. Guarantors: χωριστό σετ (Guarantors\MasterGuarantors_DC5_v1.sql).
-- ΔΕΝ υπάρχει NCIS extract: οι τιμές PROFITS διαβάζονται απευθείας από τους πίνακες.
-- Migration scripts: ΜΟΝΟ Migration Scripts\20261116_MigrationScripts (55000_CoBeneficiaries = 45000 του DC4 + LG
-- guarantors + ACCOUNT_MAX_BENEF 99 + load balancing, 10200, 10090, 12000, 30001, 40001).
-- Διαφορές DC4 -&gt; DC5: DC5\DC4_vs_DC5_MigrationScripts_GuarantorsBeneficiaries_Diff_Report.md.
-- Μορφή Master/Detail όπως το MasterSafeDepositBoxes_DC5_v1.sql: ένα αυτοτελές SELECT, χωρίς views / πίνακες HGR_* (το DC4
--   v2 χρειαζόταν 2 preambles με HGR_BEN_*). Το κοινό κομμάτι και το FINDINGS είναι ΙΔΙΑ αυτούσια στο
--   DetailBeneficiaries_DC5_v1.2.sql. Τα INFO (BEN-006 / 007) υπολογίζονται μόνο εδώ. Generator: _generator\build.sh (παράγει μόνο τη v1· η v1.2 δεν βγαίνει από αυτόν).
--   HUB από synonyms σε DB link @Malta (10098): HUB_MT_SSPRJIP, HUB_MT_DDACMSP, HUB_MT_TDACMSP, HUB_MT_DCACMSP,
--   HUB_MT_LSACMSP, κάθε πίνακας ΜΙΑ φορά σε δικό του CTE (R_*), μόνο οι στήλες που χρειάζονται.
--
-- ΑΡΧΗ: αναμενόμενη τιμή ΜΟΝΟ από τα scripts (55000 / 10200):
--   - Joint: HGR_MG_JOINT (10200, από SSPRJIP) -&gt; τα μέλη SERIAL_NO &gt; 1 γίνονται co-holders, το μέλος 1 κάτοχος.
--     Το 10200 αριθμεί με ORDER BY το ίδιο το κλειδί (τυχαίο) -&gt; σύγκριση ΣΥΝΟΛΟΥ: κάτοχος + co-holders = όλα τα μέλη.
--   - Καταθέσεις: λογαριασμοί DDACMSP + TDACMSP του joint owner (55000 HGR_MG_JOINT_ACCOUNT) -&gt; DEPOSIT_BENEF -&gt;
--     BENEFICIARY.FK_DEPOSIT_ACCOACC = MG_DPAC_LOAD.PRFT_DEP_ACC_NO. Κύριος κάτοχος δεκτός και από DEPOSIT_ACCOUNT.
--   - Δάνεια: LSACMSP του joint owner -&gt; LOAN_BENEF -&gt; agreement (MG_LNS_MNT_LOAD.AGREEMENT_CODE -&gt; MG_AGR_MNT_LOAD
--     LOANAGREEMENTS 4-part key) -&gt; AGREEMENT_BENEF, MAIN_BENEF_FLG 0. Πελάτης agreement = MG_AGR_MNT_LOAD.CUST_ID.
--   - Μέλος που δεν μεταφέρθηκε -&gt; FAIL με την αιτία (όπως σε όλες τις κατηγορίες). Μόνο checks HUB vs PROFITS.
--   - Detail: CUSTOMER_CODE = μέλος / owner HUB, SERIAL_NO = λογαριασμός HUB (BEN-001 / 002) ή agreement code (003..005).
--
-- ΑΝΤΙΣΤΟΙΧΙΑ με το DC4 Beneficiaries_recon_v2.sql (BEN-001..035, archive Scripts\Archived\Beneficiaries_20261118):
--   003 / 004 / 005 + 024..028 (σύνολο κατόχων) -&gt; 001 | 007 + 025 (αντίστροφο) -&gt; 002 | 009 + 012 -&gt; 003
--   010 -&gt; 004 | 011 -&gt; 005 | 021..023 -&gt; 006 (INFO) | 034 / 035 -&gt; 007 (INFO)
--   Αφαιρέθηκαν: 001 / 002 (κλειδιά), 006 (BENEFICIARY_SN: εξαρτάται από την τυχαία σειρά), 008 (count), 013..020
--   (κλειδιά / staging / σύγκριση SSPRJIP με HGR_MG_JOINT), 029..033 (κύριος κάτοχος: καλύπτεται από Deposits / Loans).
--
-- STATUS: PASS (INVALID_COUNT = 0) / FAIL / INFO. DESCRIPTION: απλή περιγραφή χωρίς κωδικούς.
-- TOTAL_RECORDS ανά POPULATION_TYPE:
--   DEP_PAIRS = (λογαριασμός, μέλος) joint λογαριασμών που μεταφέρθηκαν   DEP_BEN = BENEFICIARY (λογαριασμός, πελάτης)
--   LNS_PAIRS = (agreement, μέλος) joint δανείων εκτός του πελάτη του agreement   LNS_BEN = AGREEMENT_BENEF (agreement, πελάτης)
--   LNS_COB = co-borrowers joint δανείων στο PROFITS   JNT_ALL = μέλη SSPRJIP   DCA_JNT = λογαριασμοί DCACMSP joint owners
-- v1.2 (βελτιστοποίηση, ΙΔΙΑ λογική / ίδια αποτελέσματα με v1): χωρίς inline views, scalar subqueries και correlated
--   EXISTS / NOT EXISTS / IN. Τα lookups είναι CTE με μοναδικό κλειδί + LEFT JOIN (anti-join = LEFT JOIN ... IS NULL).
--   Μονό πέρασμα για DEXP / LEXP, MG_BENEF_INTER, R_JNT και R_DCA. CHECK_ID ως στήλη του FINDINGS (χωρίς SUBSTR / REGEXP).
-- v1.2 update (2026-11-19): το σχόλιο μετά το τελικό ; μεταφέρθηκε μία γραμμή πάνω (ORA-00933 στο SSIS). Ίδια λογική.
-- ====================================================================
WITH
-- --------------------------------------------------------------------
-- Κοινό κομμάτι (ΙΔΙΟ αυτούσιο στο Master και στο Detail).
-- v1.2: χωρίς inline views (SELECT μέσα σε FROM), χωρίς scalar subqueries στο SELECT και χωρίς correlated
--       EXISTS / NOT EXISTS / IN: κάθε lookup είναι προ-υπολογισμένο CTE με μοναδικό κλειδί + LEFT JOIN.
--   R_JNT  = HUB_MT_SSPRJIP (synonym @Malta): joint profile -&gt; μέλη, όπως το 10200 (HGR_MG_JOINT):
--            JC = TRIM(X0DCB) || LPAD(TRIM(X0DCS),6,'0'), MC = TRIM(X0DCBH) || LPAD(TRIM(X0DCSH),6,'0'). Χωρίς φίλτρο shadow.
--            Το 10200 αριθμεί τα μέλη με ORDER BY το ίδιο το κλειδί (τυχαίο μέλος 1) -&gt; σύγκριση ΣΥΝΟΛΟΥ μελών.
--   R_DDA / R_TDA = HUB_MT_DDACMSP / TDACMSP (@Malta): λογαριασμός -&gt; owner (MIN(CUSTOMER_CODE), 10090), ήδη ανά λογαριασμό.
--   R_DCA  = HUB_MT_DCACMSP (@Malta): ζεύγη (λογαριασμός, owner), μόνο για τα INFO του Master.
--   R_LSA  = HUB_MT_LSACMSP (@Malta): δάνειο (OLD_LNS_NO) -&gt; owner (MIN), ήδη ανά δάνειο.
--   HUB_ACC = λογαριασμοί DD + TD του HUB (55000: HGR_MG_JOINT_ACCOUNT) -&gt; owner, μοναδικοί ανά λογαριασμό.
--   JC     = joint owners (μοναδικοί).  MCI = MG_CUSTOMER_INTER ανά κωδικό (55000: INNER JOIN χωρίς ROW_STATUS) -&gt; PRFT_CUST_ID.
--   DPAC   = MG_DPAC_LOAD ανά λογαριασμό -&gt; PRFT_DEP_ACC_NO.  DACC = HUB_ACC + DPAC + σημαία joint.  DACC_P = λογαριασμοί PROFITS.
--   DEXP   = αναμενόμενοι κάτοχοι ανά λογαριασμό: joint owner -&gt; κάθε μέλος (το μέλος 1 γίνεται κάτοχος, τα άλλα
--            DEPOSIT_BENEF -&gt; BENEFICIARY), αλλιώς ο owner. Ένα πέρασμα του DACC.  DEXP_K = μοναδικά (PACC, PID).
--   LNS_MNT / AGR_MNT = MG_LNS_MNT_LOAD ανά δάνειο / MG_AGR_MNT_LOAD LOANAGREEMENTS ανά agreement code.
--   LAGR   = δάνεια του HUB -&gt; agreement (4-part key + CUST_ID).  LAGR_K = LAGR μοναδικά ανά 4-part key.
--   LEXP   = αναμενόμενοι ανά agreement: joint owner -&gt; κάθε μέλος (μέλος 1 = πελάτης του agreement, τα άλλα LOAN_BENEF -&gt;
--            AGREEMENT_BENEF), αλλιώς ο owner. Ένα πέρασμα του LAGR.  LEXP_K = μοναδικά (4-part key, PID).
--   STG    = MG_BENEF_INTER DEPOSIT_BENEF + LOAN_BENEF σε ΕΝΑ πέρασμα (μόνο για την αιτία στο ISSUE).
--   BN     = BENEFICIARY των λογαριασμών του HUB.  BN_CNT = κάτοχοι ανά λογαριασμό.
--   DA     = DEPOSIT_ACCOUNT (κύριος κάτοχος: δεκτός και χωρίς γραμμή BENEFICIARY).
--   AB     = AGREEMENT_BENEF ΜΟΝΟ των agreements των δανείων του HUB (= το παλιό ABH) + IS_EXP (ο πελάτης είναι
--            αναμενόμενος δανειολήπτης στο HUB).  AB_CNT = beneficiaries ανά agreement.
-- --------------------------------------------------------------------
R_JNT AS (
    SELECT /*+ MATERIALIZE */
           TRIM(TO_CHAR(X0DCB))  || LPAD(TRIM(TO_CHAR(X0DCS)), 6, '0')  AS JC,
           TRIM(TO_CHAR(X0DCBH)) || LPAD(TRIM(TO_CHAR(X0DCSH)), 6, '0') AS MC,
           MAX(CASE WHEN X0MDFL = 'S' THEN 1 ELSE 0 END)                AS SHADOW
      FROM HUB_MT_SSPRJIP
     GROUP BY TRIM(TO_CHAR(X0DCB))  || LPAD(TRIM(TO_CHAR(X0DCS)), 6, '0'),
              TRIM(TO_CHAR(X0DCBH)) || LPAD(TRIM(TO_CHAR(X0DCSH)), 6, '0')
),
R_DDA AS (
    SELECT /*+ MATERIALIZE */ TRIM(ACCOUNT_NO) AS ACC, MIN(TRIM(CUSTOMER_CODE)) AS OWN
      FROM HUB_MT_DDACMSP WHERE ACCOUNT_NO IS NOT NULL GROUP BY TRIM(ACCOUNT_NO)
),
R_TDA AS (
    SELECT /*+ MATERIALIZE */ TRIM(ACCOUNT_NO) AS ACC, MIN(TRIM(CUSTOMER_CODE)) AS OWN
      FROM HUB_MT_TDACMSP WHERE ACCOUNT_NO IS NOT NULL GROUP BY TRIM(ACCOUNT_NO)
),
R_DCA AS (
    SELECT /*+ MATERIALIZE */ DISTINCT TRIM(ACCOUNT_NO) AS ACC, TRIM(CUSTOMER_CODE) AS OWN FROM HUB_MT_DCACMSP WHERE ACCOUNT_NO IS NOT NULL
),
R_LSA AS (
    SELECT /*+ MATERIALIZE */ TRIM(OLD_LNS_NO) AS LNS, MIN(TRIM(CUSTOMER_CODE)) AS OWN
      FROM HUB_MT_LSACMSP WHERE OLD_LNS_NO IS NOT NULL GROUP BY TRIM(OLD_LNS_NO)
),
R_DTA AS (
    SELECT ACC, OWN FROM R_DDA
    UNION ALL
    SELECT ACC, OWN FROM R_TDA
),
HUB_ACC AS (
    SELECT /*+ MATERIALIZE */ ACC, MIN(OWN) AS OWN FROM R_DTA GROUP BY ACC
),
JC AS (
    SELECT /*+ MATERIALIZE */ DISTINCT JC FROM R_JNT
),
MCI AS (
    SELECT /*+ MATERIALIZE */ TRIM(CUSTOMER_CODE) AS CC, MIN(PRFT_CUST_ID) AS PID
      FROM MG_CUSTOMER_INTER
     GROUP BY TRIM(CUSTOMER_CODE)
),
DPAC AS (
    SELECT TRIM(ACCOUNT_NO) AS ACC, MIN(PRFT_DEP_ACC_NO) AS PACC
      FROM MG_DPAC_LOAD
     WHERE NVL(PRFT_DEP_ACC_NO, 0) &lt;&gt; 0
     GROUP BY TRIM(ACCOUNT_NO)
),
DACC AS (
    SELECT /*+ MATERIALIZE */
           h.ACC, h.OWN, p.PACC,
           CASE WHEN j.JC IS NOT NULL THEN 'Y' ELSE 'N' END AS JNT
      FROM HUB_ACC h
      JOIN DPAC p ON p.ACC = h.ACC
      LEFT JOIN JC j ON j.JC = h.OWN
),
DACC_P AS (
    SELECT /*+ MATERIALIZE */ DISTINCT PACC FROM DACC
),
DEXP AS (
    -- joint: μία γραμμή ανά μέλος (R_JNT), αλλιώς μία γραμμή με τον owner
    SELECT /*+ MATERIALIZE */
           d.ACC, d.OWN, d.PACC, d.JNT,
           CASE WHEN d.JNT = 'Y' THEN j.MC ELSE d.OWN END AS CC,
           mc.PID
      FROM DACC d
      LEFT JOIN R_JNT j ON j.JC = d.OWN AND d.JNT = 'Y'
      LEFT JOIN MCI mc  ON mc.CC = CASE WHEN d.JNT = 'Y' THEN j.MC ELSE d.OWN END
),
DEXP_K AS (
    SELECT DISTINCT PACC, PID FROM DEXP WHERE PID IS NOT NULL
),
LNS_MNT AS (
    SELECT TRIM(OLD_LNS_NO) AS LNS, TRIM(MIN(AGREEMENT_CODE)) AS AGR
      FROM MG_LNS_MNT_LOAD
     GROUP BY TRIM(OLD_LNS_NO)
),
AGR_MNT AS (
    SELECT TRIM(AGREEMENT_CODE) AS AGR, MIN(NEW_AGR_UNIT) AS AU, MIN(NEW_AGR_YEAR) AS AY,
           MIN(NEW_AGR_SN) AS AS_, MIN(NEW_AGR_MEM_SN) AS AM, MIN(CUST_ID) AS ACID
      FROM MG_AGR_MNT_LOAD
     WHERE TRIM(FILE_NAME) = 'LOANAGREEMENTS'
     GROUP BY TRIM(AGREEMENT_CODE)
),
LAGR AS (
    SELECT /*+ MATERIALIZE */
           l.LNS, l.OWN, ml.AGR, a.AU, a.AY, a.AS_, a.AM, a.ACID,
           CASE WHEN j.JC IS NOT NULL THEN 'Y' ELSE 'N' END AS JNT
      FROM R_LSA l
      JOIN LNS_MNT ml ON ml.LNS = l.LNS
      JOIN AGR_MNT a  ON a.AGR = ml.AGR
      LEFT JOIN JC j  ON j.JC = l.OWN
),
LAGR_K AS (
    SELECT AU, AY, AS_, AM, MIN(LNS) AS LNS, MIN(OWN) AS OWN, MIN(AGR) AS AGR, MIN(ACID) AS ACID, MIN(JNT) AS JNT
      FROM LAGR
     GROUP BY AU, AY, AS_, AM
),
LEXP AS (
    -- joint: μία γραμμή ανά μέλος (R_JNT), αλλιώς μία γραμμή με τον owner
    SELECT /*+ MATERIALIZE */
           g.LNS, g.OWN, g.AGR, g.AU, g.AY, g.AS_, g.AM, g.ACID, g.JNT,
           CASE WHEN g.JNT = 'Y' THEN j.MC ELSE g.OWN END AS CC,
           mc.PID
      FROM LAGR g
      LEFT JOIN R_JNT j ON j.JC = g.OWN AND g.JNT = 'Y'
      LEFT JOIN MCI mc  ON mc.CC = CASE WHEN g.JNT = 'Y' THEN j.MC ELSE g.OWN END
),
LEXP_K AS (
    SELECT DISTINCT AU, AY, AS_, AM, PID FROM LEXP WHERE PID IS NOT NULL
),
STG AS (
    SELECT /*+ MATERIALIZE */
           TRIM(FILE_NAME) AS FN, TRIM(ACCOUNT_NO) AS ACC, TRIM(CUSTOMER_CODE) AS CC,
           MAX(TRIM(TO_CHAR(ROW_STATUS))) AS RS, MIN(TRIM(ROW_ERR_DESC)) AS ERR
      FROM MG_BENEF_INTER
     WHERE TRIM(FILE_NAME) IN ('DEPOSIT_BENEF', 'LOAN_BENEF')
     GROUP BY TRIM(FILE_NAME), TRIM(ACCOUNT_NO), TRIM(CUSTOMER_CODE)
),
BN AS (
    SELECT /*+ MATERIALIZE */ b.FK_DEPOSIT_ACCOACC AS PACC, b.FK_CUSTOMERCUST_ID AS CID, COUNT(*) AS N
      FROM BENEFICIARY b
      JOIN DACC_P p ON p.PACC = b.FK_DEPOSIT_ACCOACC
     GROUP BY b.FK_DEPOSIT_ACCOACC, b.FK_CUSTOMERCUST_ID
),
BN_CNT AS (
    SELECT PACC, COUNT(*) AS NH FROM BN GROUP BY PACC
),
DA AS (
    SELECT DISTINCT a.ACCOUNT_NUMBER AS PACC, a.FK_CUSTOMERCUST_ID AS CID
      FROM DEPOSIT_ACCOUNT a
      JOIN DACC_P p ON p.PACC = a.ACCOUNT_NUMBER
),
AB AS (
    -- γραμμές AGREEMENT_BENEF των agreements των δανείων του HUB (LAGR_K μοναδικό ανά key, LEXP_K ανά key + πελάτη)
    SELECT /*+ MATERIALIZE */
           b.FK_AGREEMENTFK_UNI AS AU, b.FK_AGREEMENTAGR_YE AS AY, b.FK_AGREEMENTAGR_SN AS AS_, b.FK_AGREEMENTAGR_ME AS AM,
           b.FK_CUSTOMERCUST_ID AS CID, COUNT(*) AS N, MIN(TRIM(b.MAIN_BENEF_FLG)) AS FLG, MAX(TRIM(b.MAIN_BENEF_FLG)) AS FLG2,
           g.LNS, g.OWN, g.AGR, g.ACID, g.JNT,
           MAX(CASE WHEN k.AU IS NOT NULL THEN 'Y' ELSE 'N' END) AS IS_EXP
      FROM AGREEMENT_BENEF b
      JOIN LAGR_K g
        ON g.AU = b.FK_AGREEMENTFK_UNI AND g.AY = b.FK_AGREEMENTAGR_YE AND g.AS_ = b.FK_AGREEMENTAGR_SN AND g.AM = b.FK_AGREEMENTAGR_ME
      LEFT JOIN LEXP_K k
        ON k.AU = b.FK_AGREEMENTFK_UNI AND k.AY = b.FK_AGREEMENTAGR_YE AND k.AS_ = b.FK_AGREEMENTAGR_SN AND k.AM = b.FK_AGREEMENTAGR_ME
       AND k.PID = b.FK_CUSTOMERCUST_ID
     GROUP BY b.FK_AGREEMENTFK_UNI, b.FK_AGREEMENTAGR_YE, b.FK_AGREEMENTAGR_SN, b.FK_AGREEMENTAGR_ME, b.FK_CUSTOMERCUST_ID,
              g.LNS, g.OWN, g.AGR, g.ACID, g.JNT
),
AB_CNT AS (
    SELECT AU, AY, AS_, AM, COUNT(*) AS NB FROM AB GROUP BY AU, AY, AS_, AM
),
FINDINGS AS (
    -- Μία γραμμή ανά εύρημα. CUSTOMER_CODE = μέλος / owner HUB, SERIAL_NO = λογαριασμός HUB / agreement code.
    -- HUB_VALUE = τιμή HUB, NCIS_VALUE = τιμή PROFITS. Αναμενόμενη τιμή (μόνο από το 55000) στο ISSUE.
    --==============================================================
    --BEN-001. Μέλος του joint owner λογαριασμού DD / TD χωρίς BENEFICIARY στον λογαριασμό PROFITS.
    SELECT
      CAST('BEN-001' AS VARCHAR2(10)) AS CHECK_ID,
      CAST('BEN-001_DEPOSIT_HOLDER_MISSING_IN_PROFITS' AS VARCHAR2(50)) AS CHECK_NAME,
      CAST(e.CC AS VARCHAR2(40)) AS CUSTOMER_CODE,
      CAST(e.ACC AS VARCHAR2(40)) AS SERIAL_NO,
      CAST(SUBSTR('JOINT OWNER ' || e.OWN || '; MEMBER ' || e.CC, 1, 200) AS VARCHAR2(200)) AS HUB_VALUE,
      CAST(SUBSTR('ACCOUNT ' || e.PACC || '; HOLDERS=' || NVL(c.NH, 0), 1, 200) AS VARCHAR2(200)) AS NCIS_VALUE,
      CAST(SUBSTR(CASE WHEN e.PID IS NULL THEN 'MEMBER NOT IN MG_CUSTOMER_INTER'
                       WHEN s.RS = '2'    THEN 'REJECTED: ' || NVL(s.ERR, '-')
                       ELSE 'MISSING IN PROFITS' END, 1, 50) AS VARCHAR2(50)) AS ISSUE
    FROM DEXP e
    LEFT JOIN BN b     ON b.PACC = e.PACC AND b.CID = e.PID
    LEFT JOIN DA a     ON a.PACC = e.PACC AND a.CID = e.PID
    LEFT JOIN BN_CNT c ON c.PACC = e.PACC
    LEFT JOIN STG s    ON s.FN = 'DEPOSIT_BENEF' AND s.ACC = e.ACC AND s.CC = e.CC
    WHERE e.JNT = 'Y'
      AND b.PACC IS NULL
      AND a.PACC IS NULL
    UNION ALL
    --==============================================================
    --BEN-002. BENEFICIARY λογαριασμού του HUB με πελάτη που δεν είναι κάτοχος στο HUB (joint: μέλος, αλλιώς owner), ή διπλός.
    SELECT 'BEN-002', 'BEN-002_DEPOSIT_BENEFICIARY_NOT_EXPECTED', d.OWN, d.ACC,
           'OWNER ' || d.OWN || CASE WHEN d.JNT = 'Y' THEN ' (JOINT)' END,
           'ACCOUNT ' || b.PACC || '; CUSTOMER=' || b.CID || '; ROWS=' || b.N,
           CASE WHEN k.PACC IS NULL THEN 'NOT A HUB HOLDER OF THE ACCOUNT'
                ELSE SUBSTR('DUPLICATE IN PROFITS (' || b.N || ' ROWS)', 1, 50) END
    FROM BN b
    JOIN DACC d        ON d.PACC = b.PACC
    LEFT JOIN DEXP_K k ON k.PACC = b.PACC AND k.PID = b.CID
    WHERE b.N &gt; 1 OR k.PACC IS NULL
    UNION ALL
    --==============================================================
    --BEN-003. Μέλος του joint owner δανείου που δεν είναι ούτε πελάτης του agreement ούτε AGREEMENT_BENEF.
    SELECT 'BEN-003', 'BEN-003_LOAN_COBORROWER_MISSING_IN_PROFITS', e.CC, e.AGR,
           SUBSTR('LOAN ' || e.LNS || '; JOINT OWNER ' || e.OWN, 1, 200),
           SUBSTR('AGREEMENT CUSTOMER=' || e.ACID || '; BENEFICIARIES=' || NVL(c.NB, 0), 1, 200),
           SUBSTR(CASE WHEN e.PID IS NULL THEN 'MEMBER NOT IN MG_CUSTOMER_INTER'
                       WHEN s.RS = '2'    THEN 'REJECTED: ' || NVL(s.ERR, '-')
                       ELSE 'MISSING IN PROFITS' END, 1, 50)
    FROM LEXP e
    LEFT JOIN AB b     ON b.AU = e.AU AND b.AY = e.AY AND b.AS_ = e.AS_ AND b.AM = e.AM AND b.CID = e.PID
    LEFT JOIN AB_CNT c ON c.AU = e.AU AND c.AY = e.AY AND c.AS_ = e.AS_ AND c.AM = e.AM
    LEFT JOIN STG s    ON s.FN = 'LOAN_BENEF' AND s.ACC = e.AGR AND s.CC = e.CC
    WHERE e.JNT = 'Y'
      AND NVL(e.PID, -1) &lt;&gt; NVL(e.ACID, -2)
      AND b.AU IS NULL
    UNION ALL
    --==============================================================
    --BEN-004. AGREEMENT_BENEF agreement δανείου του HUB με πελάτη που δεν είναι δανειολήπτης στο HUB, ή διπλός.
    SELECT 'BEN-004', 'BEN-004_LOAN_BENEFICIARY_NOT_EXPECTED', b.OWN, b.AGR,
           SUBSTR('LOAN ' || b.LNS || '; OWNER ' || b.OWN || CASE WHEN b.JNT = 'Y' THEN ' (JOINT)' END, 1, 200),
           'CUSTOMER=' || b.CID || '; ROWS=' || b.N || '; MAIN_BENEF_FLG=' || b.FLG,
           CASE WHEN b.IS_EXP = 'N' THEN 'NOT A HUB BORROWER OF THE LOAN'
                ELSE SUBSTR('DUPLICATE IN PROFITS (' || b.N || ' ROWS)', 1, 50) END
    FROM AB b
    WHERE b.N &gt; 1 OR b.IS_EXP = 'N'
    UNION ALL
    --==============================================================
    --BEN-005. Co-borrower (μέλος που δεν είναι πελάτης του agreement) με MAIN_BENEF_FLG &lt;&gt; 0 (55000: '0').
    SELECT 'BEN-005', 'BEN-005_LOAN_COBORROWER_MAIN_FLAG_MISMATCH', b.OWN, b.AGR,
           SUBSTR('LOAN ' || b.LNS || '; JOINT OWNER ' || b.OWN, 1, 200),
           'CUSTOMER=' || b.CID || '; MAIN_BENEF_FLG=' || b.FLG || CASE WHEN b.FLG2 &lt;&gt; b.FLG THEN '/' || b.FLG2 END,
           'MISMATCH (EXPECTED 0)'
    FROM AB b
    WHERE b.JNT = 'Y'
      AND NVL(b.CID, -1) &lt;&gt; NVL(b.ACID, -2)
      AND b.IS_EXP = 'Y'
      AND (NVL(b.FLG, '#') &lt;&gt; '0' OR NVL(b.FLG2, '#') &lt;&gt; '0')
)
,
JNT_STATS AS (
    -- ένα πέρασμα του R_JNT: πληθυσμός JNT_ALL + INFO BEN-006
    SELECT COUNT(*) AS N_ALL, COUNT(CASE WHEN SHADOW = 1 THEN 1 END) AS N_SHADOW FROM R_JNT
),
DCA_STATS AS (
    -- ένα πέρασμα του R_DCA: πληθυσμός DCA_JNT + INFO BEN-007 (λογαριασμός όχι σε DDACMSP / TDACMSP = όχι στο HUB_ACC)
    SELECT COUNT(*) AS N_JNT, COUNT(CASE WHEN h.ACC IS NULL THEN 1 END) AS N_ONLY_DC
      FROM R_DCA a
      JOIN JC j           ON j.JC = a.OWN
      LEFT JOIN HUB_ACC h ON h.ACC = a.ACC
),
POPS AS (
    SELECT 'DEP_PAIRS' AS POPULATION_TYPE, COUNT(*) AS CNT FROM DEXP WHERE JNT = 'Y'
    UNION ALL SELECT 'DEP_BEN',   COUNT(*) FROM BN
    UNION ALL SELECT 'LNS_PAIRS', COUNT(*) FROM LEXP WHERE JNT = 'Y' AND NVL(PID, -1) &lt;&gt; NVL(ACID, -2)
    UNION ALL SELECT 'LNS_BEN',   COUNT(*) FROM AB
    UNION ALL SELECT 'LNS_COB',   COUNT(*) FROM AB WHERE JNT = 'Y' AND NVL(CID, -1) &lt;&gt; NVL(ACID, -2) AND IS_EXP = 'Y'
    UNION ALL SELECT 'JNT_ALL',   N_ALL FROM JNT_STATS
    UNION ALL SELECT 'DCA_JNT',   N_JNT FROM DCA_STATS
),
CHECK_META AS (
    -- CHECK_ID | CHECK_NAME | CATEGORY | DESCRIPTION | POPULATION_TYPE
    SELECT 'BEN-001' AS CHECK_ID, 'BEN-001_DEPOSIT_HOLDER_MISSING_IN_PROFITS' AS CHECK_NAME, 'EXISTENCE' AS CATEGORY, 'Members of the HUB joint owner of a migrated current or term deposit account that are not holders of the account in PROFITS. The detail rows give the reason.' AS DESCRIPTION, 'DEP_PAIRS' AS POPULATION_TYPE FROM DUAL UNION ALL
    SELECT 'BEN-002', 'BEN-002_DEPOSIT_BENEFICIARY_NOT_EXPECTED',   'EXISTENCE',             'Holders of migrated HUB deposit accounts in PROFITS that are not owners or joint members of the account in HUB, or held more than once.', 'DEP_BEN' FROM DUAL UNION ALL
    SELECT 'BEN-003', 'BEN-003_LOAN_COBORROWER_MISSING_IN_PROFITS', 'EXISTENCE',             'Members of the HUB joint owner of a migrated loan that are neither the agreement customer nor a co-borrower of the agreement in PROFITS.', 'LNS_PAIRS' FROM DUAL UNION ALL
    SELECT 'BEN-004', 'BEN-004_LOAN_BENEFICIARY_NOT_EXPECTED',      'EXISTENCE',             'Co-borrowers of migrated HUB loan agreements in PROFITS that are not borrowers or joint members of the loan in HUB, or held more than once.', 'LNS_BEN' FROM DUAL UNION ALL
    SELECT 'BEN-005', 'BEN-005_LOAN_COBORROWER_MAIN_FLAG_MISMATCH', 'CROSS_SYSTEM_MISMATCH', 'Co-borrowers of joint HUB loans marked as main beneficiary in PROFITS; the migration loads them as not main.', 'LNS_COB' FROM DUAL UNION ALL
    SELECT 'BEN-006', 'BEN-006_SHADOW_JOINT_RECORDS',               'INFO',                  'Information only: HUB joint profile member records that are shadow records. The migration does not filter them out. No detail rows.', 'JNT_ALL' FROM DUAL UNION ALL
    SELECT 'BEN-007', 'BEN-007_JOINT_ACCOUNTS_ONLY_IN_DC_FILE',     'INFO',                  'Information only: accounts of HUB joint owners that are only in the overdraft control file, so the migration gives them no co-holders. No detail rows.', 'DCA_JNT' FROM DUAL
),
FINDINGS_COUNT AS (
    SELECT CHECK_ID, COUNT(*) AS INVALID_COUNT FROM FINDINGS GROUP BY CHECK_ID
    UNION ALL
    -- INFO, μόνο Master (χωρίς γραμμές στο Detail)
    SELECT 'BEN-006', N_SHADOW FROM JNT_STATS -- INFO
    UNION ALL
    SELECT 'BEN-007', N_ONLY_DC FROM DCA_STATS -- INFO
)
SELECT
    CAST(CM.CHECK_ID AS VARCHAR2(10)) AS CHECK_ID,
    CAST(CM.CHECK_NAME AS VARCHAR2(50)) AS CHECK_NAME,
    CAST(CM.CATEGORY AS VARCHAR2(30)) AS CATEGORY,
    CAST(CM.DESCRIPTION AS VARCHAR2(200)) AS DESCRIPTION,
    NVL(P.CNT, 0) AS TOTAL_RECORDS,
    NVL(P.CNT, 0) - NVL(FC.INVALID_COUNT, 0) AS VALID_COUNT,
    NVL(FC.INVALID_COUNT, 0) AS INVALID_COUNT,
    CASE WHEN CM.CATEGORY = 'INFO'           THEN 'INFO'
         WHEN NVL(FC.INVALID_COUNT, 0) = 0   THEN 'PASS'
         ELSE 'FAIL' END AS STATUS,
    'DC5' AS DC_VERSION,
    1 AS RUN_VERSION,  -- TESTING ONLY: στο SSIS αντικαθίσταται από @[User::RunVersion] μέσω Derived Column.
    SYSDATE AS RUN_TIMESTAMP
FROM CHECK_META CM
LEFT JOIN POPS P ON P.POPULATION_TYPE = CM.POPULATION_TYPE
LEFT JOIN FINDINGS_COUNT FC ON FC.CHECK_ID = CM.CHECK_ID
-- 'BEN-' + 3 ψηφία: η αλφαβητική σειρά = αριθμητική
ORDER BY CM.CHECK_ID;</property>
