            <pipeline
              version="1">
              <components>
                <component
                  refId="Package\Sequence Container\Debit_Cards_Master\Debit_Cards_master"
                  componentClassID="Microsoft.SSISOracleSrc"
                  contactInfo="Oracle Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;1"
                  description="Oracle Source"
                  name="Debit_Cards_master"
                  usesDispositions="true"
                  version="1">
                  <properties>
                    <property
                      dataType="System.String"
                      description="The name of the table to be fetched."
                      expressionType="Notify"
                      name="TableName"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      expressionType="Notify"
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">-- ====================================================================
-- DC_RECON — MASTER DC5 v1 (Debit Cards)
-- Τροφοδοτεί: RECON.DC_RECON_MASTER (όνομα πίνακα προς επιβεβαίωση: δεν υπάρχει ακόμη στο
-- SSIS scripts\Recon_tables.sql)
-- Μία γραμμή ΑΝΑ CHECK_ID — 13 γραμμές ανά run: DC-001 .. DC-013.
--
-- Debit Cards (ME04 ATM, EIM 240314, DD v1.14): HUB ATM_MT_ATCAHFP vs PROFITS CMS_CARD / CMS_CARD_ACCOUNT.
-- ΔΕΝ υπάρχει NCIS extract για κάρτες: οι τιμές PROFITS διαβάζονται απευθείας από τους πίνακες CMS_CARD*
-- (απόφαση χρήστη 2026-11-17). Οι στήλες λέγονται NCIS_VALUE για συμβατότητα με το template.
-- Migration scripts: ΜΟΝΟ Migration Scripts\20261116_MigrationScripts (62000_Cards, 10090).
-- Διαφορές DC4 -&gt; DC5: DC5\DC4_vs_DC5_MigrationScripts_DebitCards_Diff_Report.md.
-- Μορφή Master/Detail όπως το MasterCustomerAddresses_DC5_v3.sql:
--   - ένα αυτοτελές SELECT, χωρίς views / πίνακες HGR_*. Το κοινό κομμάτι (CTEs) και το FINDINGS είναι ΙΔΙΑ
--     αυτούσια στο DetailDebitCards_DC5_v1.sql -&gt; INVALID_COUNT = γραμμές του Detail ανά CHECK_ID.
--   - Παράγεται από τον generator (_generator\build.sh): dc_master_head + dc_common + dc_master_tail.
--   - HUB από synonyms σε DB link @Malta (10098): ATM_MT_ATCAHFP, HUB_MT_SSPRJIP, HUB_MT_SSCUSTP,
--     κάθε πίνακας ΜΙΑ φορά σε δικό του CTE (R_*), μόνο οι στήλες που χρειάζονται.
--
-- ΑΡΧΗ: αναμενόμενη τιμή ΜΟΝΟ από τα scripts της μετάπτωσης (62000_Cards 20261116):
--   - Επιλογή: ACCDST = 'A' και (ACCDEX ή ACCEXN) &gt;= YYMM(BANK_PARAMETERS.CURR_TRX_DATE).
--   - Αριθμός κάρτας: SUBSTR(LPAD(TO_CHAR(ACCDNO),16,'0'),-16) = TRIM(CMS_CARD.FULL_CARD_NO).
--   - Πελάτης: ATCAHFP.CUSTOMER_CODE (10090: ACDCB || LPAD(ACDCS,6,'0')). Αν είναι joint profile
--     (HUB_MT_SSPRJIP), το 62000 τον αλλάζει σε ένα μέλος, που επιλέγεται τυχαία: δεκτό ΟΠΟΙΟΔΗΠΟΤΕ μέλος
--     (απόφαση χρήστη 2026-11-17). PRFT_CUST_ID από MG_CUSTOMER_INTER. Απόρριψη: CUSTOMER NOT FOUND.
--   - Τύπος: GENERIC_DETAIL CARTP, DETAILED_ANALYSIS = ACPDTY -&gt; SERIAL_NUM. Απόρριψη: 'Card Product outside
--     Product Parameterization' (μόνο αν ο πελάτης βρέθηκε).
--   - Λήξη: '20' || YY || MM || '01' από το μεγαλύτερο ACCDEX / ACCEXN (CASE του 62000).
--   - Όνομα: ACCAHN πλήρες (FD_EMBOSS_NAME). Η στήλη του loader δεν φαίνεται (to be confirmed with NC).
--   - Ημερομηνία έκδοσης: ACLISS (ORIGINAL_ISSUE_DAT) vs CREATION_DATE.
--   - Λογαριασμοί: PRIMARY_ACC_1 = τελευταία 12 του ACPAN, ACCOUNT_2 / _3 = ACSAN1 / ACSAN2, όταν υπάρχουν στο
--     MG_DPAC_LOAD. Σύνδεση στο CMS_CARD_ACCOUNT (FK_CARD_SN = CARD_SN): δεκτός ο αριθμός HUB ή το
--     DEP_ACC_NUMBER του PROFITS (ο πίνακας ήταν κενός στο DC4 / DC5, μορφή to be confirmed with NC).
--   - DC-002 (πελάτης) και DC-013 (2ος / 3ος λογαριασμός που δεν στέλνεται): ο κανόνας είναι του script, αλλά
--     η κάρτα / ο λογαριασμός λείπει από το PROFITS -&gt; FAIL με γραμμές στο Detail (απόφαση χρήστη 2026-11-17).
--   - DC-008 (πελάτης κάτοχος του λογαριασμού): κανόνας του DC4 review, όχι του 62000.
--   - HUB_VALUE = τιμή HUB, NCIS_VALUE = τιμή PROFITS, αναμενόμενη τιμή στο ISSUE.
--   - Detail: CUSTOMER_CODE = πελάτης HUB, SERIAL_NO = αριθμός κάρτας masked ('****' || 4 τελευταία, όπως DC4).
--   - Μόνο checks HUB vs PROFITS (απόφαση χρήστη 2026-11-17). Το MG_CMS διαβάζεται μόνο για την αιτία στο
--     ISSUE του DC-001.
--
-- ΑΝΤΙΣΤΟΙΧΙΑ με το DC4 DebitCards_recon.sql (DC4 IDs DC-001..024, archive Scripts\Archived\DebitCards_20261117):
--   DC4 DC-002 + DC-009 -&gt; DC-001 | DC4 DC-006 -&gt; DC-002 | DC4 DC-003 + DC-010 (κάρτα όχι από το HUB) -&gt; DC-004
--   DC4 DC-004 / DC-010 (διπλές) -&gt; DC-005 | DC4 DC-011 / 012 / 024 -&gt; DC-006 | DC4 DC-013 -&gt; DC-007
--   DC4 DC-014 -&gt; DC-008 | DC4 DC-015 -&gt; DC-009 | DC4 DC-018 -&gt; DC-010 | DC4 DC-022 -&gt; DC-011
--   DC4 DC-007 + DC-020 -&gt; DC-012 | DC4 DC-008 -&gt; DC-013
--   Νέο: DC-003 (προϊόν εκτός παραμετροποίησης, 62000 20261116).
--   Αφαιρέθηκαν από το DC4: DC-005 (κανόνας SYSDATE, δεν υπάρχει πια), DC-016 (limit group hardcoded DEFAULTLMT,
--   χωρίς πηγή HUB), DC-012 / DC-024 και το MG_CMS κομμάτι του DC-004 (μόνο staging, όχι HUB vs PROFITS),
--   DC-019 (όγκοι CMS_CARD / APPL / TRANS, χωρίς πηγή HUB).
--   Αφαιρέθηκαν 2026-11-17 (απόφαση χρήστη: κοιτάνε μία πλευρά, χωρίς σύγκριση HUB vs PROFITS) τα INFO:
--   DC4 DC-001 (κάρτα σε πολλές γραμμές HUB), DC4 DC-023 (κάρτες HUB που δεν επιλέγονται), DC4 DC-017 (status
--   PROFITS), DC4 DC-021 (κάρτες σε joint profile). Η πληροφορία τους είναι στο FINDING / EXPLANATION των
--   DC-001 / DC-002 (επιλογή), DC-004 (status), DC-007 (joint) στο Excel αποτελεσμάτων.
--   ΑΝΑΡΙΘΜΗΣΗ 2026-11-17 (v1 πριν -&gt; τώρα): DC-003..DC-015 -&gt; DC-001..DC-013 (παλιό ID - 2).
--
-- STATUS: PASS (INVALID_COUNT = 0) / FAIL. DESCRIPTION: απλή περιγραφή χωρίς κωδικούς.
--
-- TOTAL_RECORDS ανά POPULATION_TYPE:
--   SEL         = κάρτες που επιλέγει το 62000
--   EXP         = επιλεγμένες κάρτες που περνούν και τους κανόνες πελάτη / προϊόντος
--   PROF        = διακριτοί αριθμοί κάρτας στο CMS_CARD
--   MATCHED     = επιλεγμένες κάρτες που υπάρχουν στο CMS_CARD
--   MATCHED_ACC = ίδιες, με κύριο λογαριασμό στο PROFITS_ACCOUNT
--   MATCHED_PRI = ίδιες, με κύριο λογαριασμό στο HUB (ACPAN &lt;&gt; 0)
--   SEC         = 2οι / 3οι λογαριασμοί HUB των καρτών MATCHED (ένας ανά λογαριασμό)
-- ====================================================================
WITH
-- --------------------------------------------------------------------
-- Κοινό κομμάτι (ΙΔΙΟ αυτούσιο στο Master και στο Detail).
--   R_ATC  = ATM_MT_ATCAHFP (synonym @Malta, 10098): ΜΙΑ ανάγνωση, όλες οι γραμμές, μόνο οι στήλες
--            που χρειάζονται. PAN όπως το 62000: SUBSTR(LPAD(TO_CHAR(ACCDNO),16,'0'),-16).
--            CC = ATCAHFP.CUSTOMER_CODE (10090: ACDCB || LPAD(ACDCS,6,'0')).
--   R_JNT  = HUB_MT_SSPRJIP (@Malta): joint profile (CUSTOMER_CODE) -&gt; μέλος (CUSTOMER_CODE2).
--   R_CUST = HUB_MT_SSCUSTP (@Malta): κωδικοί πελατών HUB (μόνο για την αιτία στο DC-002).
--   BP     = BANK_PARAMETERS.CURR_TRX_DATE σε YYMM (φίλτρο λήξης του 62000).
--   XP     = αναμενόμενες τιμές PROFITS που ΔΕΝ βγαίνουν από τα scripts (αλλάζουν εδώ μόνο):
--            X_ENTRY_ST = ENTRY_STATUS ενεργής κάρτας (DC-014). Υπόθεση '1' (όπως GENERIC_DETAIL), to be confirmed with NC.
--            DEF_LIMIT  = limit group που βάζει hardcoded το 62000 (LIMIT_GROUP 'DEFAULTLMT', DC-015).
--   L_*    = όρια κάρτας HUB (DD ME04 v1.14, Integer χωρίς δεκαδικά, μονάδα to be confirmed): ACL* = όρια κύκλου,
--            ACV* = VIP όρια κύκλου. Το 62000 δεν μεταφέρει κανένα (DC-015).
--   A      = όλες οι γραμμές HUB + E (λήξη όπως το 62000: CASE WHEN ACCDEX &gt; ACCEXN ...) + SEL
--            (62000: ACCDST = 'A' AND (ACCDEX &gt;= YYMM OR ACCEXN &gt;= YYMM)).
--   HC     = ανά αριθμό κάρτας, όλες οι γραμμές HUB.
--   HS     = επιλεγμένες κάρτες, μία ανά αριθμό (η γραμμή με τη μεγαλύτερη λήξη).
--   MCI    = MG_CUSTOMER_INTER (12000): πελάτης -&gt; PRFT_CUST_ID. MCIR = το αντίστροφο.
--   EC     = αναμενόμενοι πελάτες ανά κάρτα. 62000: πελάτης που είναι joint profile -&gt; ένα μέλος του
--            (SERIAL_NO 1 με ORDER BY τον κωδικό του profile = τυχαίο μέλος). Απόφαση χρήστη
--            2026-11-17: δεκτό ΟΠΟΙΟΔΗΠΟΤΕ μέλος του profile.
--   GDP    = GENERIC_DETAIL CARTP (ENTRY_STATUS 1): DETAILED_ANALYSIS (= ACPDTY) -&gt; SERIAL_NUM (62000).
--   SX     = επιλεγμένες κάρτες + αν περνούν τους κανόνες πελάτη / προϊόντος του 62000 + αν είναι στο PROFITS.
--   MGC    = MG_CMS (62000): status / σφάλμα φόρτωσης, ΜΟΝΟ για την αιτία στο ISSUE του DC-001.
--   C      = CMS_CARD, μία γραμμή ανά αριθμό κάρτας (μικρότερο CARD_SN) + N_CMS = γραμμές ανά αριθμό.
--   CCA    = CMS_CARD_ACCOUNT (σύνδεση κάρτας - λογαριασμού, FK_CARD_SN = CMS_CARD.CARD_SN).
--   MDL    = MG_DPAC_LOAD: λογαριασμοί που στέλνει η μετάπτωση (62000: PRIMARY_ACC_1 / ACCOUNT_2 / _3).
--   PA     = PROFITS_ACCOUNT (αριθμός HUB -&gt; DEP_ACC_NUMBER, owner). BN = BENEFICIARY.
--   B      = επιλεγμένες κάρτες HUB που υπάρχουν στο CMS_CARD + αναμενόμενες τιμές (X_*).
--   SA     = 2ος / 3ος λογαριασμός HUB (ACSAN1 / ACSAN2 &lt;&gt; 0) των καρτών του B, μία γραμμή ανά λογαριασμό.
-- --------------------------------------------------------------------
R_ATC AS (
    SELECT /*+ MATERIALIZE */
           SUBSTR(LPAD(TO_CHAR(ACCDNO), 16, '0'), -16) AS PAN,
           TRIM(ACCDST)                                AS ST,
           ACCDEX, ACCEXN,
           TRIM(CUSTOMER_CODE)                         AS CC,
           TRIM(ACPDTY)                                AS PRODUCT,
           TRIM(ACCAHN)                                AS NAME,
           ACLISS,
           SUBSTR(ACPAN, -12)                          AS PRIM,
           TRIM(ACSAN1)                                AS SAN1,
           TRIM(ACSAN2)                                AS SAN2,
           NVL(ACLCWD, 0) AS L_CWD,  NVL(ACLPUR, 0) AS L_PUR,  NVL(ACLTFW, 0) AS L_TFW,
           NVL(ACLTFO, 0) AS L_TFO,  NVL(ACLUBP, 0) AS L_UBP,  NVL(ACLSIG, 0) AS L_SIG,
           NVL(ACVCWD, 0) AS V_CWD,  NVL(ACVPUR, 0) AS V_PUR,  NVL(ACVTFW, 0) AS V_TFW,
           NVL(ACVTFO, 0) AS V_TFO,  NVL(ACVUBP, 0) AS V_UBP,  NVL(ACVSIG, 0) AS V_SIG
      FROM ATM_MT_ATCAHFP
),
R_JNT AS (
    SELECT /*+ MATERIALIZE */ DISTINCT TRIM(CUSTOMER_CODE) AS JC, TRIM(CUSTOMER_CODE2) AS MC
      FROM HUB_MT_SSPRJIP
),
R_CUST AS (
    SELECT /*+ MATERIALIZE */ DISTINCT TRIM(CUSTOMER_CODE) AS CC
      FROM HUB_MT_SSCUSTP
),
BP AS (
    SELECT MAX(TO_NUMBER(TO_CHAR(CURR_TRX_DATE, 'YYMM'))) AS YYMM FROM BANK_PARAMETERS
),
XP AS (
    SELECT '1' AS X_ENTRY_ST, 'DEFAULTLMT' AS DEF_LIMIT FROM DUAL
),
A AS (
    SELECT r.PAN, r.ST, r.ACCDEX, r.ACCEXN, r.CC, r.PRODUCT, r.NAME, r.ACLISS, r.PRIM, r.SAN1, r.SAN2,
           r.L_CWD, r.L_PUR, r.L_TFW, r.L_TFO, r.L_UBP, r.L_SIG,
           r.V_CWD, r.V_PUR, r.V_TFW, r.V_TFO, r.V_UBP, r.V_SIG,
           CASE WHEN r.ACCDEX &gt; r.ACCEXN THEN r.ACCDEX ELSE r.ACCEXN END AS E,
           CASE WHEN r.ST = 'A' AND (r.ACCDEX &gt;= bp.YYMM OR r.ACCEXN &gt;= bp.YYMM) THEN 1 ELSE 0 END AS SEL
      FROM R_ATC r
     CROSS JOIN BP bp
),
HC AS (
    SELECT /*+ MATERIALIZE */
           PAN,
           COUNT(*)                                  AS N_ROWS,
           SUM(SEL)                                  AS N_SEL,
           MIN(CC)                                   AS CC,
           MAX(CASE WHEN ST = 'A' THEN 1 ELSE 0 END) AS ANY_A,
           MAX(ST)                                   AS ST_MAX,
           MAX(E)                                    AS E_MAX
      FROM A
     GROUP BY PAN
),
HS AS (
    SELECT /*+ MATERIALIZE */ PAN, ST, ACCDEX, ACCEXN, E, CC, PRODUCT, NAME, ACLISS, PRIM, SAN1, SAN2,
           L_CWD, L_PUR, L_TFW, L_TFO, L_UBP, L_SIG, V_CWD, V_PUR, V_TFW, V_TFO, V_UBP, V_SIG
      FROM (
            SELECT a.*,
                   ROW_NUMBER() OVER (PARTITION BY a.PAN ORDER BY a.E DESC NULLS LAST, a.ACLISS DESC NULLS LAST) AS RN
              FROM A a
             WHERE a.SEL = 1
           )
     WHERE RN = 1
),
MCI AS (
    SELECT /*+ MATERIALIZE */ TRIM(CUSTOMER_CODE) AS CC, MIN(PRFT_CUST_ID) AS ID
      FROM MG_CUSTOMER_INTER
     GROUP BY TRIM(CUSTOMER_CODE)
),
MCIR AS (
    SELECT ID, MIN(CC) AS CC FROM MCI WHERE ID IS NOT NULL GROUP BY ID
),
EC AS (
    SELECT /*+ MATERIALIZE */
           h.PAN,
           CASE WHEN j.JC IS NULL THEN 'N' ELSE 'Y' END AS JNT,
           NVL(j.MC, h.CC)                              AS ECC,
           m.ID
      FROM HS h
      LEFT JOIN R_JNT j ON j.JC = h.CC
      LEFT JOIN MCI m   ON m.CC = NVL(j.MC, h.CC)
),
ECA AS (
    SELECT PAN, MAX(JNT) AS JNT, COUNT(*) AS N_EC, COUNT(ID) AS N_EC_MIG, MIN(ID) AS ID_MIN
      FROM EC
     GROUP BY PAN
),
GDP AS (
    SELECT /*+ MATERIALIZE */ DISTINCT TRIM(DETAILED_ANALYSIS) AS DA, SERIAL_NUM AS SN
      FROM GENERIC_DETAIL
     WHERE FK_GENERIC_HEADPAR = 'CARTP'
       AND TRIM(ENTRY_STATUS) = '1'
       AND TRIM(DETAILED_ANALYSIS) IS NOT NULL
),
GDA AS (
    SELECT DA, MIN(SN) AS SN_MIN, MAX(SN) AS SN_MAX FROM GDP GROUP BY DA
),
C AS (
    SELECT /*+ MATERIALIZE */ PAN, CARD_SN, FK_CUST_ID, CARD_EXPIRY_DATE, FK_CRDTYP_GENERIC_SN, ENTRY_ST,
           PROD_ST, LIMIT_GRP, CNAME, CSURNAME, CREATION_DATE, N_CMS
      FROM (
            SELECT TRIM(FULL_CARD_NO)          AS PAN,
                   CARD_SN, FK_CUST_ID, CARD_EXPIRY_DATE, FK_CRDTYP_GENERIC_SN,
                   TRIM(ENTRY_STATUS)          AS ENTRY_ST,
                   TRIM(PRODUCTION_STATUS)     AS PROD_ST,
                   TRIM(FK_CMS_LIMIT_HDCD)     AS LIMIT_GRP,
                   TRIM(CARD_NAME_LATIN)       AS CNAME,
                   TRIM(CARD_SURNAME_LATIN)    AS CSURNAME,
                   CREATION_DATE,
                   COUNT(*) OVER (PARTITION BY TRIM(FULL_CARD_NO))                     AS N_CMS,
                   ROW_NUMBER() OVER (PARTITION BY TRIM(FULL_CARD_NO) ORDER BY CARD_SN) AS RN
              FROM CMS_CARD
           )
     WHERE RN = 1
),
CCA AS (
    SELECT /*+ MATERIALIZE */ FK_CARD_SN AS CSN, TRIM(ACCOUNT_NUMBER) AS ACC FROM CMS_CARD_ACCOUNT
),
CCN AS (
    SELECT CSN, COUNT(*) AS N, MIN(ACC) AS ACC_MIN FROM CCA GROUP BY CSN
),
MGC AS (
    SELECT TRIM(PAN) AS PAN, MAX(TRIM(TO_CHAR(ROW_STATUS))) AS RST, MAX(TRIM(ROW_ERR_DESC)) AS ERR
      FROM MG_CMS
     GROUP BY TRIM(PAN)
),
MDL AS (
    SELECT /*+ MATERIALIZE */ DISTINCT TRIM(ACCOUNT_NO) AS ACC FROM MG_DPAC_LOAD
),
PA AS (
    SELECT /*+ MATERIALIZE */ TRIM(ACCOUNT_NUMBER) AS ACC, MIN(DEP_ACC_NUMBER) AS DEP, MIN(CUST_ID) AS OWNER
      FROM PROFITS_ACCOUNT
     GROUP BY TRIM(ACCOUNT_NUMBER)
),
BN AS (
    SELECT /*+ MATERIALIZE */ DISTINCT FK_DEPOSIT_ACCOACC AS DEP, FK_CUSTOMERCUST_ID AS CID FROM BENEFICIARY
),
SX AS (
    SELECT /*+ MATERIALIZE */
           h.PAN, h.CC, h.PRODUCT, h.E,
           e.JNT, e.N_EC, e.N_EC_MIG,
           CASE WHEN e.N_EC_MIG &gt; 0     THEN 'Y' ELSE 'N' END AS CUST_OK,
           CASE WHEN g.DA IS NOT NULL   THEN 'Y' ELSE 'N' END AS PROD_OK,
           CASE WHEN c.PAN IS NOT NULL  THEN 'Y' ELSE 'N' END AS IN_CMS,
           CASE WHEN rc.CC IS NOT NULL  THEN 'Y' ELSE 'N' END AS CC_IN_HUB
      FROM HS h
      JOIN ECA e         ON e.PAN = h.PAN
      LEFT JOIN GDA g    ON g.DA = h.PRODUCT
      LEFT JOIN C c      ON c.PAN = h.PAN
      LEFT JOIN R_CUST rc ON rc.CC = h.CC
),
B AS (
    SELECT /*+ MATERIALIZE */
           h.PAN, h.CC, h.ST, h.ACCDEX, h.ACCEXN, h.E, h.PRODUCT, h.NAME, h.ACLISS, h.PRIM, h.SAN1, h.SAN2,
           h.L_CWD, h.L_PUR, h.L_TFW, h.L_TFO, h.L_UBP, h.L_SIG,
           h.V_CWD, h.V_PUR, h.V_TFW, h.V_TFO, h.V_UBP, h.V_SIG,
           '20' || SUBSTR(TO_CHAR(h.E), 1, 2) || SUBSTR(TO_CHAR(h.E), 3, 2) || '01' AS X_EXP_S,
           TO_DATE('20' || SUBSTR(TO_CHAR(h.E), 1, 2) || SUBSTR(TO_CHAR(h.E), 3, 2) || '01'
                   DEFAULT NULL ON CONVERSION ERROR, 'YYYYMMDD')                  AS X_EXP,
           e.JNT, e.N_EC, e.N_EC_MIG, e.ID_MIN,
           g.SN_MIN, g.SN_MAX,
           c.CARD_SN, c.FK_CUST_ID, c.CARD_EXPIRY_DATE, c.FK_CRDTYP_GENERIC_SN, c.ENTRY_ST,
           c.PROD_ST, c.LIMIT_GRP,
           c.CNAME, c.CSURNAME, c.CREATION_DATE,
           md.ACC   AS X_PRIM,
           pa.DEP   AS PRIM_DEP,
           pa.OWNER AS PRIM_OWNER
      FROM HS h
      JOIN C c        ON c.PAN = h.PAN
      JOIN ECA e      ON e.PAN = h.PAN
      LEFT JOIN GDA g ON g.DA = h.PRODUCT
      LEFT JOIN MDL md ON md.ACC = h.PRIM
      LEFT JOIN PA pa  ON pa.ACC = h.PRIM
),
SA AS (
    -- X_ACC   = ο λογαριασμός όπως τον ψάχνει το 62000 (TRIM(ACSAN1) = TRIM(ACCOUNT_NO)): αναμενόμενη τιμή.
    -- X_ACC12 = ο ίδιος με LPAD 12: ACSAN1 / ACSAN2 είναι αριθμητικά και χάνουν το 0 στην αρχή
    --           (διαγνωστικό 2026-11-17: 0 βρίσκονται όπως είναι, 11.027 / 18.545 με LPAD 12). Μόνο για την αιτία στο ISSUE.
    SELECT s.PAN, s.CC, s.CARD_SN, s.SLOT, s.HUB_FLD, s.ACC,
           md.ACC   AS X_ACC,
           md12.ACC AS X_ACC12,
           pa.DEP   AS DEP
      FROM (
            SELECT PAN, CC, CARD_SN, 2 AS SLOT, 'ACSAN1' AS HUB_FLD, SAN1 AS ACC FROM B WHERE NVL(SAN1, '0') &lt;&gt; '0'
            UNION ALL
            SELECT PAN, CC, CARD_SN, 3, 'ACSAN2', SAN2 FROM B WHERE NVL(SAN2, '0') &lt;&gt; '0'
           ) s
      LEFT JOIN MDL md   ON md.ACC   = s.ACC
      LEFT JOIN MDL md12 ON md12.ACC = LPAD(s.ACC, 12, '0')
      LEFT JOIN PA pa    ON pa.ACC   = s.ACC
),
FINDINGS AS (
    -- Μία γραμμή ανά εύρημα. CUSTOMER_CODE = πελάτης HUB (ATCAHFP.CUSTOMER_CODE), SERIAL_NO = αριθμός
    -- κάρτας masked ('****' || 4 τελευταία, όπως στο DC4). HUB_VALUE = τιμή όπως είναι στο HUB,
    -- NCIS_VALUE = τιμή όπως είναι στο PROFITS (CMS_CARD*). Η αναμενόμενη τιμή (μόνο από τα scripts) στο ISSUE.
    --==============================================================
    --DC-001. Κάρτα που περνά όλους τους κανόνες του 62000 (επιλογή, πελάτης, προϊόν) και λείπει από το CMS_CARD.
    --        ISSUE = αιτία από το MG_CMS.
    SELECT
      CAST('DC-001_CARD_MISSING_IN_PROFITS' AS VARCHAR2(50)) AS CHECK_NAME,
      CAST(x.CC AS VARCHAR2(40)) AS CUSTOMER_CODE,
      CAST('****' || SUBSTR(x.PAN, -4) AS VARCHAR2(40)) AS SERIAL_NO,
      CAST(SUBSTR('ACPDTY=' || x.PRODUCT || '; EXPIRY=' || TO_CHAR(x.E)
                  || CASE WHEN x.JNT = 'Y' THEN '; JOINT PROFILE, MEMBERS MIGRATED ' || x.N_EC_MIG || '/' || x.N_EC END, 1, 200) AS VARCHAR2(200)) AS HUB_VALUE,
      CAST(NULL AS VARCHAR2(200)) AS NCIS_VALUE,
      CAST(SUBSTR(
        CASE WHEN g.PAN IS NULL THEN 'NOT IN MG_CMS'
             WHEN g.RST = '2'   THEN 'REJECTED: ' || NVL(g.ERR, '-')
             ELSE 'MG_CMS STATUS ' || g.RST || ', NOT IN CMS_CARD' END, 1, 50) AS VARCHAR2(50)) AS ISSUE
    FROM SX x
    LEFT JOIN MGC g ON g.PAN = x.PAN
    WHERE x.CUST_OK = 'Y' AND x.PROD_OK = 'Y' AND x.IN_CMS = 'N'
    UNION ALL
    --==============================================================
    --DC-002. Επιλεγμένη κάρτα που δεν μεταφέρθηκε γιατί ο πελάτης της δεν μεταφέρθηκε
    --        (62000: CUSTOMER NOT FOUND = CLIENT_ID_1 όχι στο MG_CUSTOMER_INTER).
    SELECT 'DC-002_CARD_CUSTOMER_NOT_MIGRATED', x.CC, '****' || SUBSTR(x.PAN, -4),
           CASE WHEN x.JNT = 'Y' THEN 'JOINT PROFILE, ' || x.N_EC || ' MEMBERS' ELSE 'CUSTOMER ' || x.CC END,
           CAST(NULL AS VARCHAR2(200)),
           CASE WHEN x.JNT = 'Y'       THEN 'JOINT: NO MEMBER MIGRATED'
                WHEN x.CC IS NULL      THEN 'CUSTOMER CODE EMPTY'
                WHEN x.CC_IN_HUB = 'N' THEN 'CUSTOMER NOT IN HUB SSCUSTP'
                ELSE 'CUSTOMER NOT MIGRATED' END
    FROM SX x
    WHERE x.CUST_OK = 'N' AND x.IN_CMS = 'N'
    UNION ALL
    --==============================================================
    --DC-003. Επιλεγμένη κάρτα με μεταφερμένο πελάτη που δεν μεταφέρθηκε γιατί το προϊόν (ACPDTY) δεν είναι
    --        στο GENERIC_DETAIL CARTP (62000: 'Card Product outside Product Parameterization').
    SELECT 'DC-003_CARD_PRODUCT_NOT_PARAMETERIZED', x.CC, '****' || SUBSTR(x.PAN, -4),
           'ACPDTY=' || x.PRODUCT, CAST(NULL AS VARCHAR2(200)),
           SUBSTR('NO_MAPPING (SENT ' || NVL(x.PRODUCT, 'EMPTY') || ')', 1, 50)
    FROM SX x
    WHERE x.CUST_OK = 'Y' AND x.PROD_OK = 'N' AND x.IN_CMS = 'N'
    UNION ALL
    --==============================================================
    --DC-004. Κάρτα στο CMS_CARD που δεν είναι επιλεγμένη κάρτα του HUB.
    SELECT 'DC-004_CARD_MISSING_IN_HUB', hc.CC, '****' || SUBSTR(c.PAN, -4),
           CASE WHEN hc.PAN IS NOT NULL
                THEN 'ROWS=' || hc.N_ROWS || '; ACCDST=' || hc.ST_MAX || '; EXPIRY=' || TO_CHAR(hc.E_MAX) END,
           SUBSTR('CARD_SN=' || c.CARD_SN || '; ENTRY_STATUS=' || c.ENTRY_ST || '; LIMIT=' || c.LIMIT_GRP, 1, 200),
           SUBSTR(CASE WHEN hc.PAN IS NULL THEN 'NOT IN HUB'
                       WHEN hc.ANY_A = 0   THEN 'HUB CARD NOT ACTIVE (ACCDST ' || hc.ST_MAX || ')'
                       ELSE 'HUB CARD EXPIRED (EXPIRY ' || TO_CHAR(hc.E_MAX) || ')' END, 1, 50)
    FROM C c
    LEFT JOIN HS h  ON h.PAN = c.PAN
    LEFT JOIN HC hc ON hc.PAN = c.PAN
    WHERE h.PAN IS NULL
    UNION ALL
    --==============================================================
    --DC-005. Αριθμός κάρτας που υπάρχει πάνω από μία φορά στο CMS_CARD (μία γραμμή ανά κάρτα).
    SELECT 'DC-005_CARD_DUPLICATE_IN_PROFITS', hc.CC, '****' || SUBSTR(c.PAN, -4),
           CASE WHEN hc.PAN IS NOT NULL THEN 'ROWS=' || hc.N_ROWS || '; SELECTED ROWS=' || hc.N_SEL END,
           'CMS_CARD ROWS=' || c.N_CMS,
           'IN CMS_CARD ' || c.N_CMS || ' TIMES'
    FROM C c
    LEFT JOIN HC hc ON hc.PAN = c.PAN
    WHERE c.N_CMS &gt; 1
    UNION ALL
    --==============================================================
    --DC-006. Λήξη: 62000 '20' || YY || MM || '01' από το μεγαλύτερο ACCDEX / ACCEXN vs CMS_CARD.CARD_EXPIRY_DATE
    SELECT 'DC-006_EXPIRY_DATE_MISMATCH', b.CC, '****' || SUBSTR(b.PAN, -4),
           'ACCDEX=' || TO_CHAR(b.ACCDEX) || '; ACCEXN=' || TO_CHAR(b.ACCEXN),
           TO_CHAR(b.CARD_EXPIRY_DATE, 'YYYY-MM-DD'),
           SUBSTR('MISMATCH (EXPECTED ' || NVL(TO_CHAR(b.X_EXP, 'YYYY-MM-DD'), 'INVALID ' || b.X_EXP_S) || ')', 1, 50)
    FROM B b
    WHERE NVL(TO_CHAR(b.CARD_EXPIRY_DATE, 'YYYYMMDD'), 'X') &lt;&gt; NVL(TO_CHAR(b.X_EXP, 'YYYYMMDD'), 'X')
    UNION ALL
    --==============================================================
    --DC-007. Πελάτης: ATCAHFP.CUSTOMER_CODE (joint profile -&gt; οποιοδήποτε μέλος, SSPRJIP) -&gt; MG_CUSTOMER_INTER
    --        PRFT_CUST_ID vs CMS_CARD.FK_CUST_ID
    SELECT 'DC-007_CARD_CUSTOMER_MISMATCH', b.CC, '****' || SUBSTR(b.PAN, -4),
           SUBSTR('CUSTOMER ' || b.CC || CASE WHEN b.JNT = 'Y' THEN ' (JOINT PROFILE, ' || b.N_EC || ' MEMBERS)' END, 1, 200),
           SUBSTR('CUST_ID=' || TO_CHAR(b.FK_CUST_ID) || CASE WHEN mr.CC IS NOT NULL THEN ' (' || mr.CC || ')' END, 1, 200),
           SUBSTR(CASE WHEN b.N_EC_MIG = 0 THEN 'CUSTOMER NOT MIGRATED'
                       WHEN b.JNT = 'Y'    THEN 'NOT A JOINT MEMBER (' || b.N_EC_MIG || ' MIGRATED MEMBERS)'
                       ELSE 'MISMATCH (EXPECTED ' || TO_CHAR(b.ID_MIN) || ')' END, 1, 50)
    FROM B b
    LEFT JOIN MCIR mr ON mr.ID = b.FK_CUST_ID
    WHERE NOT EXISTS (SELECT 1 FROM EC e WHERE e.PAN = b.PAN AND e.ID = b.FK_CUST_ID)
    UNION ALL
    --==============================================================
    --DC-008. Ο πελάτης της κάρτας (CMS_CARD.FK_CUST_ID) δεν είναι κάτοχος (BENEFICIARY) του κύριου λογαριασμού
    --        (τελευταία 12 του ACPAN -&gt; PROFITS_ACCOUNT). Κανόνας του DC4 review, όχι του 62000.
    SELECT 'DC-008_CARD_CUSTOMER_NOT_ACC_HOLDER', b.CC, '****' || SUBSTR(b.PAN, -4),
           'ACPAN ACCOUNT=' || b.PRIM,
           'CUST_ID=' || TO_CHAR(b.FK_CUST_ID) || '; ACCOUNT OWNER=' || TO_CHAR(b.PRIM_OWNER),
           'CARD CUSTOMER NOT A HOLDER OF THE ACCOUNT'
    FROM B b
    WHERE b.PRIM_DEP IS NOT NULL
      AND NOT EXISTS (SELECT 1 FROM BN n WHERE n.DEP = b.PRIM_DEP AND n.CID = b.FK_CUST_ID)
    UNION ALL
    --==============================================================
    --DC-009. Τύπος: ACPDTY -&gt; GENERIC_DETAIL CARTP (DETAILED_ANALYSIS -&gt; SERIAL_NUM, 62000) vs FK_CRDTYP_GENERIC_SN
    SELECT 'DC-009_CARD_TYPE_MISMATCH', b.CC, '****' || SUBSTR(b.PAN, -4),
           'ACPDTY=' || b.PRODUCT, TO_CHAR(b.FK_CRDTYP_GENERIC_SN),
           SUBSTR(CASE WHEN b.SN_MIN IS NULL     THEN 'NO_MAPPING (SENT ' || NVL(b.PRODUCT, 'EMPTY') || ')'
                       WHEN b.SN_MIN = b.SN_MAX  THEN 'MISMATCH (EXPECTED ' || TO_CHAR(b.SN_MIN) || ')'
                       ELSE 'MISMATCH (EXPECTED ' || TO_CHAR(b.SN_MIN) || '..' || TO_CHAR(b.SN_MAX) || ')' END, 1, 50)
    FROM B b
    WHERE NOT EXISTS (SELECT 1 FROM GDP g WHERE g.DA = b.PRODUCT AND g.SN = b.FK_CRDTYP_GENERIC_SN)
    UNION ALL
    --==============================================================
    --DC-010. Όνομα: ACCAHN (62000 FD_EMBOSS_NAME, πλήρες) vs CMS_CARD.CARD_NAME_LATIN.
    --        Η στήλη του loader δεν φαίνεται στα scripts (to be confirmed with NC).
    SELECT 'DC-010_CARDHOLDER_NAME_MISMATCH', b.CC, '****' || SUBSTR(b.PAN, -4),
           b.NAME,
           SUBSTR(b.CNAME || CASE WHEN b.CSURNAME IS NOT NULL THEN ' / SURNAME ' || b.CSURNAME END, 1, 200),
           SUBSTR(CASE WHEN b.CNAME = SUBSTR(b.NAME, 1, 20) THEN 'TRUNCATED TO 20 CHARACTERS'
                       ELSE 'MISMATCH (EXPECTED ' || NVL(b.NAME, 'EMPTY') || ')' END, 1, 50)
    FROM B b
    WHERE NVL(b.CNAME, 'X') &lt;&gt; NVL(b.NAME, 'X')
    UNION ALL
    --==============================================================
    --DC-011. Ημερομηνία έκδοσης: ACLISS (62000 ORIGINAL_ISSUE_DAT) vs CMS_CARD.CREATION_DATE
    SELECT 'DC-011_ISSUE_DATE_MISMATCH', b.CC, '****' || SUBSTR(b.PAN, -4),
           'ACLISS=' || TRIM(TO_CHAR(b.ACLISS)),
           TO_CHAR(b.CREATION_DATE, 'YYYY-MM-DD'),
           SUBSTR('MISMATCH (EXPECTED ' || NVL(TRIM(TO_CHAR(b.ACLISS)), 'EMPTY') || ')', 1, 50)
    FROM B b
    WHERE NVL(TO_CHAR(b.CREATION_DATE, 'YYYYMMDD'), 'X') &lt;&gt; NVL(TRIM(TO_CHAR(b.ACLISS)), 'X')
    UNION ALL
    --==============================================================
    --DC-012. Κύριος λογαριασμός (τελευταία 12 του ACPAN, 62000 PRIMARY_ACC_1 μέσω MG_DPAC_LOAD) χωρίς σύνδεση
    --        στο CMS_CARD_ACCOUNT. Δεκτός ο αριθμός HUB ή το DEP_ACC_NUMBER του PROFITS (μορφή to be confirmed with NC).
    SELECT 'DC-012_PRIMARY_ACCOUNT_NOT_LINKED', b.CC, '****' || SUBSTR(b.PAN, -4),
           'ACPAN ACCOUNT=' || b.PRIM,
           CASE WHEN n.CSN IS NULL THEN 'NO CMS_CARD_ACCOUNT ROW' ELSE n.N || ' LINKED, E.G. ' || n.ACC_MIN END,
           SUBSTR(CASE WHEN b.X_PRIM IS NULL THEN 'NOT SENT (NOT A MIGRATED ACCOUNT)'
                       ELSE 'NOT LINKED (EXPECTED ' || b.PRIM || ')' END, 1, 50)
    FROM B b
    LEFT JOIN CCN n ON n.CSN = b.CARD_SN
    WHERE NVL(b.PRIM, '0') &lt;&gt; '0'
      AND NOT EXISTS (SELECT 1 FROM CCA a WHERE a.CSN = b.CARD_SN AND (a.ACC = b.PRIM OR a.ACC = TO_CHAR(b.PRIM_DEP)))
    UNION ALL
    --==============================================================
    --DC-013. 2ος / 3ος λογαριασμός HUB (ACSAN1 / ACSAN2, 62000 ACCOUNT_2 / _3 μέσω MG_DPAC_LOAD) χωρίς σύνδεση
    --        στο CMS_CARD_ACCOUNT. Μία γραμμή ανά λογαριασμό.
    SELECT 'DC-013_SECONDARY_ACCOUNT_NOT_LINKED', s.CC, '****' || SUBSTR(s.PAN, -4),
           s.HUB_FLD || '=' || s.ACC,
           CASE WHEN n.CSN IS NULL THEN 'NO CMS_CARD_ACCOUNT ROW' ELSE n.N || ' LINKED, E.G. ' || n.ACC_MIN END,
           SUBSTR(CASE WHEN s.X_ACC IS NULL AND s.X_ACC12 IS NOT NULL
                            THEN 'ACCOUNT ' || s.SLOT || ' NOT SENT (12-DIGIT ACCOUNT MIGRATED)'
                       WHEN s.X_ACC IS NULL
                            THEN 'ACCOUNT ' || s.SLOT || ' NOT SENT (NOT A MIGRATED ACCOUNT)'
                       ELSE 'ACCOUNT ' || s.SLOT || ' NOT LINKED' END, 1, 50)
    FROM SA s
    LEFT JOIN CCN n ON n.CSN = s.CARD_SN
    WHERE NOT EXISTS (SELECT 1 FROM CCA a WHERE a.CSN = s.CARD_SN AND (a.ACC = s.ACC OR a.ACC = TO_CHAR(s.DEP)))
    UNION ALL
    --==============================================================
    --DC-014. Κατάσταση: ATCAHFP.ACCDST (62000 CARD_STATUS, πάντα A στον πληθυσμό) vs CMS_CARD.ENTRY_STATUS.
    --        Η αντιστοίχιση A -&gt; PROFITS δεν είναι στα scripts: αναμενόμενη τιμή = XP.X_ENTRY_ST (to be confirmed with NC).
    --        Το PRODUCTION_STATUS φαίνεται στο NCIS_VALUE αλλά δεν κρίνει το αποτέλεσμα.
    SELECT 'DC-014_CARD_STATUS_MISMATCH', b.CC, '****' || SUBSTR(b.PAN, -4),
           'ACCDST=' || b.ST,
           'ENTRY_STATUS=' || NVL(b.ENTRY_ST, 'EMPTY') || '; PRODUCTION_STATUS=' || NVL(b.PROD_ST, 'EMPTY'),
           SUBSTR('MISMATCH (EXPECTED ENTRY_STATUS ' || xp.X_ENTRY_ST || ')', 1, 50)
    FROM B b
    CROSS JOIN XP xp
    WHERE NVL(b.ENTRY_ST, 'X') &lt;&gt; xp.X_ENTRY_ST
    UNION ALL
    --==============================================================
    --DC-015. Όρια: όρια κάρτας HUB (ACL* / ACV*) που δεν μεταφέρονται: κάρτα με τουλάχιστον ένα μη μηδενικό όριο
    --        στο HUB και το hardcoded default limit group (62000 LIMIT_GROUP 'DEFAULTLMT') στο CMS_CARD.FK_CMS_LIMIT_HDCD.
    -- TODO: confirm limit amount table with NC (ποσά του limit group στο PROFITS), για σύγκριση ποσού-ποσού.
    SELECT 'DC-015_CARD_LIMITS_NOT_MIGRATED', b.CC, '****' || SUBSTR(b.PAN, -4),
           SUBSTR(   CASE WHEN b.L_CWD &lt;&gt; 0 THEN '; CWD=' || TO_CHAR(b.L_CWD) END
                  || CASE WHEN b.L_PUR &lt;&gt; 0 THEN '; PUR=' || TO_CHAR(b.L_PUR) END
                  || CASE WHEN b.L_TFW &lt;&gt; 0 THEN '; TFW=' || TO_CHAR(b.L_TFW) END
                  || CASE WHEN b.L_TFO &lt;&gt; 0 THEN '; TFO=' || TO_CHAR(b.L_TFO) END
                  || CASE WHEN b.L_UBP &lt;&gt; 0 THEN '; UBP=' || TO_CHAR(b.L_UBP) END
                  || CASE WHEN b.L_SIG &lt;&gt; 0 THEN '; SIG=' || TO_CHAR(b.L_SIG) END
                  || CASE WHEN b.V_CWD &lt;&gt; 0 THEN '; VIP CWD=' || TO_CHAR(b.V_CWD) END
                  || CASE WHEN b.V_PUR &lt;&gt; 0 THEN '; VIP PUR=' || TO_CHAR(b.V_PUR) END
                  || CASE WHEN b.V_TFW &lt;&gt; 0 THEN '; VIP TFW=' || TO_CHAR(b.V_TFW) END
                  || CASE WHEN b.V_TFO &lt;&gt; 0 THEN '; VIP TFO=' || TO_CHAR(b.V_TFO) END
                  || CASE WHEN b.V_UBP &lt;&gt; 0 THEN '; VIP UBP=' || TO_CHAR(b.V_UBP) END
                  || CASE WHEN b.V_SIG &lt;&gt; 0 THEN '; VIP SIG=' || TO_CHAR(b.V_SIG) END, 3, 200),
           'LIMIT GROUP=' || NVL(b.LIMIT_GRP, 'EMPTY'),
           'HUB LIMITS NOT MIGRATED (DEFAULT GROUP)'
    FROM B b
    CROSS JOIN XP xp
    WHERE NVL(b.LIMIT_GRP, 'X') = xp.DEF_LIMIT
      AND (   b.L_CWD &lt;&gt; 0 OR b.L_PUR &lt;&gt; 0 OR b.L_TFW &lt;&gt; 0 OR b.L_TFO &lt;&gt; 0 OR b.L_UBP &lt;&gt; 0 OR b.L_SIG &lt;&gt; 0
           OR b.V_CWD &lt;&gt; 0 OR b.V_PUR &lt;&gt; 0 OR b.V_TFW &lt;&gt; 0 OR b.V_TFO &lt;&gt; 0 OR b.V_UBP &lt;&gt; 0 OR b.V_SIG &lt;&gt; 0)
)
,
POPULATIONS AS (
    SELECT
        (SELECT COUNT(*) FROM SX)                                                  AS SEL_COUNT,
        (SELECT COUNT(*) FROM SX WHERE CUST_OK = 'Y' AND PROD_OK = 'Y')            AS EXP_COUNT,
        (SELECT COUNT(*) FROM C)                                                   AS PROF_COUNT,
        (SELECT COUNT(*) FROM B)                                                   AS MATCHED_COUNT,
        (SELECT COUNT(*) FROM B WHERE PRIM_DEP IS NOT NULL)                        AS MATCHED_ACC_COUNT,
        (SELECT COUNT(*) FROM B WHERE NVL(PRIM, '0') &lt;&gt; '0')                       AS MATCHED_PRI_COUNT,
        (SELECT COUNT(*) FROM SA)                                                  AS SEC_COUNT
    FROM DUAL
),
CHECK_META AS (
    -- CHECK_ID | CHECK_NAME | CATEGORY | DESCRIPTION | POPULATION_TYPE
    SELECT 'DC-001' AS CHECK_ID, 'DC-001_CARD_MISSING_IN_PROFITS' AS CHECK_NAME, 'EXISTENCE' AS CATEGORY, 'Active HUB cards that pass every migration rule (customer and product) but are not in PROFITS. The detail rows give the reason from the migration tables.' AS DESCRIPTION, 'EXP' AS POPULATION_TYPE FROM DUAL UNION ALL
    SELECT 'DC-002', 'DC-002_CARD_CUSTOMER_NOT_MIGRATED',     'EXISTENCE',             'Active HUB cards not in PROFITS because the card customer was not migrated, so the migration rejects the card.', 'SEL' FROM DUAL UNION ALL
    SELECT 'DC-003', 'DC-003_CARD_PRODUCT_NOT_PARAMETERIZED', 'EXISTENCE',             'Active HUB cards not in PROFITS because the HUB card product is not set up as a card type in PROFITS, so the migration rejects the card.', 'SEL' FROM DUAL UNION ALL
    SELECT 'DC-004', 'DC-004_CARD_MISSING_IN_HUB',            'EXISTENCE',             'Cards in PROFITS that do not match any HUB card the migration selects (active and not expired): the card is not in HUB at all, or is inactive or expired in HUB.', 'PROF' FROM DUAL UNION ALL
    SELECT 'DC-005', 'DC-005_CARD_DUPLICATE_IN_PROFITS',      'EXISTENCE',             'Card numbers held more than once in PROFITS.', 'PROF' FROM DUAL UNION ALL
    SELECT 'DC-006', 'DC-006_EXPIRY_DATE_MISMATCH',           'CROSS_SYSTEM_MISMATCH', 'The card expiry date in PROFITS differs from the first day of the HUB expiry month, the date the migration sends.', 'MATCHED' FROM DUAL UNION ALL
    SELECT 'DC-007', 'DC-007_CARD_CUSTOMER_MISMATCH',         'CROSS_SYSTEM_MISMATCH', 'The card customer in PROFITS is not the migrated HUB card customer (cards on joint profiles: any member of the profile).', 'MATCHED' FROM DUAL UNION ALL
    SELECT 'DC-008', 'DC-008_CARD_CUSTOMER_NOT_ACC_HOLDER',   'CROSS_SYSTEM_MISMATCH', 'The card customer in PROFITS does not hold the card primary account. Explained in the DC4 review, not a migration script rule.', 'MATCHED_ACC' FROM DUAL UNION ALL
    SELECT 'DC-009', 'DC-009_CARD_TYPE_MISMATCH',             'CROSS_SYSTEM_MISMATCH', 'The card type in PROFITS differs from the card type the migration sets for the HUB card product.', 'MATCHED' FROM DUAL UNION ALL
    SELECT 'DC-010', 'DC-010_CARDHOLDER_NAME_MISMATCH',       'CROSS_SYSTEM_MISMATCH', 'The cardholder name in PROFITS differs from the full HUB cardholder name the migration sends. Target column to be confirmed with NC.', 'MATCHED' FROM DUAL UNION ALL
    SELECT 'DC-011', 'DC-011_ISSUE_DATE_MISMATCH',            'CROSS_SYSTEM_MISMATCH', 'The card creation date in PROFITS differs from the HUB current issue date the migration sends.', 'MATCHED' FROM DUAL UNION ALL
    SELECT 'DC-012', 'DC-012_PRIMARY_ACCOUNT_NOT_LINKED',     'CROSS_SYSTEM_MISMATCH', 'The HUB primary account of the card is not linked to the card in PROFITS.', 'MATCHED_PRI' FROM DUAL UNION ALL
    SELECT 'DC-013', 'DC-013_SECONDARY_ACCOUNT_NOT_LINKED',   'CROSS_SYSTEM_MISMATCH', 'A second or third HUB account of the card is not linked to the card in PROFITS. One row per account.', 'SEC' FROM DUAL UNION ALL
    SELECT 'DC-014', 'DC-014_CARD_STATUS_MISMATCH',           'CROSS_SYSTEM_MISMATCH', 'The card status in PROFITS is not active for an active HUB card (ACCDST A). Active value assumed ENTRY_STATUS 1, to be confirmed with NC.', 'MATCHED' FROM DUAL UNION ALL
    SELECT 'DC-015', 'DC-015_CARD_LIMITS_NOT_MIGRATED',       'CROSS_SYSTEM_MISMATCH', 'The HUB card has its own limits (cash, purchase, transfer, bill, VIP) but PROFITS has the default limit group of the migration. Amounts to be confirmed with NC.', 'MATCHED' FROM DUAL
),
FINDINGS_COUNT AS (
    SELECT CHECK_ID, COUNT(*) AS INVALID_COUNT
    FROM (SELECT SUBSTR(CHECK_NAME, 1, INSTR(CHECK_NAME, '_') - 1) AS CHECK_ID FROM FINDINGS)
    GROUP BY CHECK_ID
)
SELECT
    CAST(CM.CHECK_ID AS VARCHAR2(10)) AS CHECK_ID,
    CAST(CM.CHECK_NAME AS VARCHAR2(50)) AS CHECK_NAME,
    CAST(CM.CATEGORY AS VARCHAR2(30)) AS CATEGORY,
    CAST(CM.DESCRIPTION AS VARCHAR2(200)) AS DESCRIPTION,
    (CASE CM.POPULATION_TYPE
        WHEN 'SEL'         THEN P.SEL_COUNT
        WHEN 'EXP'         THEN P.EXP_COUNT
        WHEN 'PROF'        THEN P.PROF_COUNT
        WHEN 'MATCHED'     THEN P.MATCHED_COUNT
        WHEN 'MATCHED_ACC' THEN P.MATCHED_ACC_COUNT
        WHEN 'MATCHED_PRI' THEN P.MATCHED_PRI_COUNT
        WHEN 'SEC'         THEN P.SEC_COUNT
     END) AS TOTAL_RECORDS,
    (CASE CM.POPULATION_TYPE
        WHEN 'SEL'         THEN P.SEL_COUNT
        WHEN 'EXP'         THEN P.EXP_COUNT
        WHEN 'PROF'        THEN P.PROF_COUNT
        WHEN 'MATCHED'     THEN P.MATCHED_COUNT
        WHEN 'MATCHED_ACC' THEN P.MATCHED_ACC_COUNT
        WHEN 'MATCHED_PRI' THEN P.MATCHED_PRI_COUNT
        WHEN 'SEC'         THEN P.SEC_COUNT
     END) - NVL(FC.INVALID_COUNT, 0) AS VALID_COUNT,
    NVL(FC.INVALID_COUNT, 0) AS INVALID_COUNT,
    CASE WHEN CM.CATEGORY = 'INFO'           THEN 'INFO'
         WHEN NVL(FC.INVALID_COUNT, 0) = 0   THEN 'PASS'
         ELSE 'FAIL' END AS STATUS,
    'DC5' AS DC_VERSION,
    1 AS RUN_VERSION,  -- TESTING ONLY: στο SSIS αντικαθίσταται από @[User::RunVersion] μέσω Derived Column.
    SYSDATE AS RUN_TIMESTAMP
FROM CHECK_META CM
CROSS JOIN POPULATIONS P
LEFT JOIN FINDINGS_COUNT FC ON FC.CHECK_ID = CM.CHECK_ID
ORDER BY REGEXP_SUBSTR(CM.CHECK_ID, '[A-Z]+'), TO_NUMBER(REGEXP_SUBSTR(CM.CHECK_ID, '[0-9]+'));</property>
