                      synchronousInputId="Package\Sequence Container\TPSO_Detail\OLE DB Destination.Inputs[OLE DB Destination Input]">
                      <outputColumns>
                        <outputColumn
                          refId="Package\Sequence Container\TPSO_Detail\OLE DB Destination.Outputs[OLE DB Destination Error Output].Columns[ErrorCode]"
                          dataType="i4"
                          lineageId="Package\Sequence Container\TPSO_Detail\OLE DB Destination.Outputs[OLE DB Destination Error Output].Columns[ErrorCode]"
                          name="ErrorCode"
                          specialFlags="1" />
                        <outputColumn
                          refId="Package\Sequence Container\TPSO_Detail\OLE DB Destination.Outputs[OLE DB Destination Error Output].Columns[ErrorColumn]"
                          dataType="i4"
                          lineageId="Package\Sequence Container\TPSO_Detail\OLE DB Destination.Outputs[OLE DB Destination Error Output].Columns[ErrorColumn]"
                          name="ErrorColumn"
                          specialFlags="2" />
                      </outputColumns>
                      <externalMetadataColumns />
                    </output>
                  </outputs>
                </component>
                <component
                  refId="Package\Sequence Container\TPSO_Detail\TPSO_detail"
                  componentClassID="Microsoft.SSISOracleSrc"
                  contactInfo="Oracle Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;1"
                  description="Oracle Source"
                  name="TPSO_detail"
                  usesDispositions="true"
                  version="1">
                  <properties>
                    <property
                      dataType="System.String"
                      description="The name of the table to be fetched."
                      expressionType="Notify"
                      name="TableName"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      expressionType="Notify"
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">-- ====================================================================
-- TPSO_RECON — DETAIL DC5 v1
-- Τροφοδοτεί: RECON.TPSO_RECON_DETAIL
-- Μία γραμμή ανά εύρημα για SO-001 .. SO-020 (μόνο ό,τι αποτυγχάνει). Τα INFO SO-021 .. SO-026
-- υπάρχουν μόνο στο Master.
--
-- Ζευγάρι του MasterTPSO_DC5_v1.sql: το κοινό κομμάτι και το FINDINGS είναι ΙΔΙΑ
-- αυτούσια και στα δύο αρχεία -&gt; INVALID_COUNT του Master = γραμμές εδώ ανά CHECK_ID.
-- Πηγές / κανόνες / αντιστοιχία με το DC4: βλ. header του Master.
--
--   - DETAIL_ID: '&lt;CHECK_ID&gt;_0000001', ...
--   - CUSTOMER_CODE: λογαριασμός χρέωσης HUB (AFSIMSP.ACCOUNT_NO). NULL στο SO-002 όταν η εντολή δεν είναι στο HUB.
--   - SERIAL_NO: AFSIMSP.SERIAL_NUMBER = TP_SO_COMMITMENT.OTHER_SYS_IDENTIFIER.
--   - HUB_VALUE = τιμή HUB, NCIS_VALUE = τιμή TP_SO_COMMITMENT (δεν υπάρχει NCIS extract), 100 χαρ.
--   - ISSUE: 'MISMATCH (EXPECTED &lt;τιμή&gt;)', ή η αιτία για τα checks ύπαρξης / λογαριασμού που λείπει.
--     Έως 50 χαρακτήρες, ποτέ κενό.
-- ====================================================================
WITH
-- --------------------------------------------------------------------
-- Κοινό κομμάτι (ΙΔΙΟ αυτούσιο στο Master και στο Detail).
--   R_SO = HUB_MT_AFSIMSP (synonym σε DB link @Malta, 10098 - ΟΧΙ πια DATACUT4@DATACUT4_MALTA):
--          ΜΙΑ φορά, μόνο οι στήλες που χρειάζονται, μία γραμμή ανά SERIAL_NUMBER.
--          ACCOUNT_NO / CREDIT_ACCOUNT_NO / SERIAL_NUMBER τα προσθέτει το 10090 (γρ. 181-187, 452-454).
--   PA   = PROFITS_ACCOUNT, μία γραμμή ανά ACCOUNT_NUMBER (60000: debit / credit account lookup)
--   CY   = CURRENCY (60000: /100 όταν DISPLAYED_DECIMAL = 2)
--   GDC  = GENERIC_DETAIL CURRE (60000: CREDIT_ACCOUNT_CURRENCY, default 19)
--   MD   = BANK_PARAMETERS.CURR_TRX_DATE (90000: activation date όταν το HUB δεν έχει ημερομηνία)
--   MIG  = MIGR_TP_SO_COMMITMENT (60000 / loader): FILE_NAME, ROW_STATUS, ROW_ERR_DESC
--   TP   = TP_SO_COMMITMENT (πλευρά PROFITS - δεν υπάρχει NCIS extract για τα standing orders,
--          απόφαση χρήστη 2026-11-17: NCIS_VALUE = τιμή του TP_SO_COMMITMENT)
--   H0/H = HUB standing order + αναμενόμενη τιμή (E_*) κατά 60000 / 60005 / 90000
--   B    = standing orders και στα δύο (H x TP, κλειδί SERIAL_NUMBER = OTHER_SYS_IDENTIFIER)
-- --------------------------------------------------------------------
R_SO AS (
    SELECT /*+ MATERIALIZE */ SN, AN, CAN, PYMD, ISTY, PRDY, SICY, APAC, MDFL,
           FNSIAM, FNDTNI, FNISTT, FNIGTT, FNTMRT, FNTMCR, FNDLAC, FNDTEX, DPM
    FROM (
        SELECT SERIAL_NUMBER                       AS SN,
               TRIM(ACCOUNT_NO)                    AS AN,
               TRIM(CREDIT_ACCOUNT_NO)             AS CAN,
               NVL(TRIM(FNPYMD), ' ')              AS PYMD,
               TRIM(TO_CHAR(FNISTY))               AS ISTY,
               TRIM(FNPRDY)                        AS PRDY,
               TRIM(FNSICY)                        AS SICY,
               TRIM(FNAPAC)                        AS APAC,
               TRIM(FNMDFL)                        AS MDFL,
               FNSIAM, FNDTNI, FNISTT, FNIGTT, FNTMRT, FNTMCR, FNDLAC, FNDTEX,
               SUBSTR(TRIM(FNDPM1) || '/' || TRIM(FNDPM2) || '/' || TRIM(FNDPM3), 1, 40) AS DPM,
               ROW_NUMBER() OVER (PARTITION BY SERIAL_NUMBER ORDER BY NULL) AS RN
          FROM HUB_MT_AFSIMSP
    )
    WHERE RN = 1
),
PA AS (
    SELECT /*+ MATERIALIZE */ TRIM(ACCOUNT_NUMBER) AS ACC, MIN(CUST_ID) AS CUST_ID, MIN(DEP_ACC_NUMBER) AS DEP_ACC,
           MIN(MOVEMENT_CURRENCY) AS CCY, MIN(MONOTORING_UNIT) AS UNIT
      FROM PROFITS_ACCOUNT
     GROUP BY TRIM(ACCOUNT_NUMBER)
),
CY AS (
    SELECT TRIM(SHORT_DESCR) AS CCY, MIN(DISPLAYED_DECIMAL) AS DEC FROM CURRENCY GROUP BY TRIM(SHORT_DESCR)
),
GDC AS (
    SELECT TRIM(SHORT_DESCRIPTION) AS CCY, MIN(SERIAL_NUM) AS SNUM
      FROM GENERIC_DETAIL WHERE PARAMETER_TYPE = 'CURRE' GROUP BY TRIM(SHORT_DESCRIPTION)
),
MD AS (
    SELECT MIN(CURR_TRX_DATE) AS MDT FROM BANK_PARAMETERS
),
MIG AS (
    SELECT /*+ MATERIALIZE */ OSI, FNAME, RSTAT, RERR
    FROM (
        SELECT TO_NUMBER(TRIM(TO_CHAR(OTHER_SYS_IDENTIFIER)) DEFAULT NULL ON CONVERSION ERROR) AS OSI,
               TRIM(FILE_NAME) AS FNAME, TRIM(TO_CHAR(ROW_STATUS)) AS RSTAT, TRIM(ROW_ERR_DESC) AS RERR,
               ROW_NUMBER() OVER (PARTITION BY TRIM(TO_CHAR(OTHER_SYS_IDENTIFIER)) ORDER BY ROW_STATUS) AS RN
          FROM MIGR_TP_SO_COMMITMENT
    )
    WHERE RN = 1
),
TP AS (
    SELECT /*+ MATERIALIZE */
           TO_NUMBER(TRIM(OTHER_SYS_IDENTIFIER) DEFAULT NULL ON CONVERSION ERROR) AS OSI,
           TRIM(OTHER_SYS_IDENTIFIER) AS OSI_TXT,
           PAYMENT_AMOUNT, FIRST_PAYMENT_AMN, LAST_PAYMENT_AMN,
           DR_ACC_CUSTOMER_ID, CR_ACC_CUSTOMER_ID, FK_DEBIT_DEP_ACC, FK_CREDIT_DEP_ACC,
           DR_ACC_CURRENCY, CR_ACC_CURRENCY,
           TRUNC(ACTIVATION_DATE) AS ACTIVATION_DATE, TRUNC(FIRST_PAYMENT_DATE) AS FIRST_PAYMENT_DATE,
           TRUNC(LAST_PAYMENT_DATE) AS LAST_PAYMENT_DATE,
           TRIM(TO_CHAR(FREQUENCY_UNIT)) AS FREQUENCY_UNIT, FREQUENCY, MAX_NO_OF_ATTEMPTS, ALLOW_NOT_EX_TRIES,
           TRIM(TO_CHAR(CR_CHARGE_TYPE)) AS CR_CHARGE_TYPE, TRIM(DR_ACC_COMMENTS) AS DR_ACC_COMMENTS,
           TRIM(CR_ACC_COMMENTS) AS CR_ACC_COMMENTS, FK_UNITCODE
      FROM TP_SO_COMMITMENT
),
H0 AS (
    SELECT s.*,
           -- 60000: FILE_NAME (FNPYMD / FNISTY / FNSICY). CO / CT δεν επιλέγονται
           CASE WHEN s.PYMD IN ('CO', 'CT')                          THEN 'EXCLUDED'
                WHEN s.PYMD IN ('LP', 'TT') AND s.SICY =  'EUR'      THEN 'EFT'
                WHEN s.PYMD IN ('LP', 'TT')                          THEN 'SWIFT'
                WHEN s.PYMD = 'T' AND s.ISTY IN ('1','2','3','4','5') THEN 'TP_SO_COMMITMENT'
                WHEN s.PYMD = ' '                                    THEN 'BILL_PAYMENTS'
           END AS E_FILE,
           -- 60000: ROW_STATUS 9 (old instruction / SWIFT / bill payments manual), αλλιώς προς φόρτωση
           CASE WHEN s.PYMD IN ('CO', 'CT')                                  THEN 'EXCLUDED'
                WHEN s.PYMD = 'T' AND s.ISTY IN ('2','4') AND s.FNDLAC &lt; 20210101 THEN 'OLD'
                WHEN s.PYMD = 'T' AND s.ISTY = '1' AND s.FNDTEX &lt;&gt; 99999999       THEN 'OLD'
                WHEN s.PYMD IN ('LP', 'TT') AND NVL(s.SICY, 'X') &lt;&gt; 'EUR'        THEN 'MANUAL'
                WHEN s.PYMD = ' '                                                THEN 'MANUAL'
                ELSE 'LOAD'
           END AS DISP,
           -- 60000: next instruction date FNDTNI (0 -&gt; 0001-01-01, άκυρη μέρα -&gt; τέλος μήνα)
           CASE WHEN s.FNDTNI = 0 THEN DATE '0001-01-01'
                WHEN VALIDATE_CONVERSION(SUBSTR(TO_CHAR(s.FNDTNI), 1, 8) AS DATE, 'YYYYMMDD') = 1 THEN TO_DATE(TO_CHAR(s.FNDTNI), 'YYYYMMDD')
                WHEN VALIDATE_CONVERSION(SUBSTR(TO_CHAR(s.FNDTNI), 1, 8) AS DATE, 'YYYYMMDD') = 0 THEN LAST_DAY(TO_DATE(SUBSTR(TO_CHAR(s.FNDTNI), 1, 6) || '01', 'YYYYMMDD'))
                ELSE DATE '0001-01-01'
           END AS NI_DATE,
           -- 60000: FREQUENCY_UNIT (1 days / 2 months / 3 years / 4 end of month)
           CASE WHEN s.PYMD = 'T' AND s.ISTY IN ('2','4') THEN '1'
                WHEN s.PYMD = 'T' AND s.ISTY = '1' AND s.PRDY IN ('Q','M','B','H') THEN '2'
                WHEN s.PYMD = 'T' AND s.ISTY = '1' AND s.PRDY IN ('X','W','D','F') THEN '1'
                WHEN s.PYMD = 'T' AND s.ISTY = '1' AND s.PRDY = 'Y' THEN '3'
                ELSE '2'
           END AS S_FU,
           pa.CUST_ID AS PA_CUST, pa.DEP_ACC AS PA_DEP, pa.CCY AS PA_CCY, pa.UNIT AS PA_UNIT, pa.ACC AS PA_ACC,
           pc.CUST_ID AS PC_CUST, pc.DEP_ACC AS PC_DEP, pc.ACC AS PC_ACC,
           cy.DEC, NVL(gdc.SNUM, 19) AS E_CR_CCY, md.MDT
      FROM R_SO s
      LEFT JOIN PA pa  ON pa.ACC = s.AN
      LEFT JOIN PA pc  ON pc.ACC = s.CAN
      LEFT JOIN CY cy  ON cy.CCY = s.SICY
      LEFT JOIN GDC gdc ON gdc.CCY = s.SICY
      CROSS JOIN MD md
),
H AS (
    SELECT h.*,
           h.FNSIAM / (CASE WHEN h.DEC = 2 THEN 100 ELSE 1 END)                    AS E_AMT,
           h.PA_CUST                                                               AS E_DR_CUST,
           CASE WHEN h.PYMD IN ('LP', 'TT') THEN NULL ELSE h.PC_CUST END           AS E_CR_CUST,
           h.PA_DEP                                                                AS E_DR_DEP,
           CASE WHEN h.PYMD IN ('LP', 'TT') THEN NULL ELSE h.PC_DEP END            AS E_CR_DEP,
           h.PA_CCY                                                                AS E_DR_CCY,
           h.PA_UNIT                                                               AS E_UNIT,
           -- 90000: 0001-01-01 -&gt; ημερομηνία μετάπτωσης (εκτός σύγκρισης, βλ. SO-021)
           CASE WHEN h.NI_DATE = DATE '0001-01-01' THEN NULL ELSE h.NI_DATE END    AS E_ACT,
           -- 60000: type 2/4 -&gt; 2999-12-31, αλλιώς FNDTNI + (FNISTT - FNIGTT) μήνες. 90000: 9999-12-31 -&gt; 2999-12-31
           CASE WHEN h.PYMD = 'T' AND h.ISTY IN ('2','4') THEN DATE '2999-12-31'
                WHEN ADD_MONTHS(h.NI_DATE, h.FNISTT - h.FNIGTT) = DATE '9999-12-31' THEN DATE '2999-12-31'
                ELSE ADD_MONTHS(h.NI_DATE, h.FNISTT - h.FNIGTT)
           END                                                                     AS E_LAST,
           -- 90000 CHS-399 (και 60005): μήνας -&gt; τέλος μήνα όταν η activation day είναι 29-31
           CASE WHEN h.S_FU = '2'
                 AND TO_CHAR(CASE WHEN h.NI_DATE = DATE '0001-01-01' THEN h.MDT ELSE h.NI_DATE END, 'DD') IN ('29','30','31')
                THEN '4' ELSE h.S_FU END                                           AS E_FU,
           -- 60000: FREQUENCY
           CASE WHEN h.PYMD = 'T' AND h.ISTY = '1' AND h.PRDY = 'Q' THEN 3
                WHEN h.PYMD = 'T' AND h.ISTY = '1' AND h.PRDY = 'B' THEN 2
                WHEN h.PYMD = 'T' AND h.ISTY = '1' AND h.PRDY = 'H' THEN 6
                WHEN h.PYMD = 'T' AND h.ISTY = '1' AND h.PRDY = 'W' THEN 7
                WHEN h.PYMD = 'T' AND h.ISTY = '1' AND h.PRDY = 'A' THEN 15
                ELSE 1
           END                                                                     AS E_FREQ,
           CASE WHEN TO_NUMBER(h.FNTMRT) &gt; 99 THEN 99 ELSE TO_NUMBER(h.FNTMRT) END  AS E_MAXATT,
           h.FNTMCR                                                                AS E_TRIES,
           -- 60000: type 1 / 2 -&gt; 0, type 4 -&gt; 1, LP / TT / blank -&gt; 0. 90000 CHS-350: type 2 / 4 -&gt; 1, 3 / 5 -&gt; κενό
           CASE WHEN h.PYMD = 'T' AND h.ISTY = '1'         THEN '0'
                WHEN h.PYMD = 'T' AND h.ISTY IN ('2','4')  THEN '1'
                WHEN h.PYMD IN ('LP', 'TT', ' ')           THEN '0'
           END                                                                     AS E_CRCH,
           -- αιτία όταν ο λογαριασμός πίστωσης δεν βρίσκεται (FNAPAC -&gt; CREDIT_ACCOUNT_NO, 10090)
           CASE WHEN h.APAC IS NULL                                  THEN 'FNAPAC BLANK'
                WHEN NVL(h.CAN, '000000000000') = '000000000000'     THEN 'FNAPAC NOT HSBC FORMAT'
                WHEN h.PC_ACC IS NULL                                THEN 'NOT IN PROFITS_ACCOUNT'
                ELSE 'FOUND NOW'
           END                                                                     AS CR_STAT
      FROM H0 h
),
B AS (
    SELECT /*+ MATERIALIZE */ h.*, t.PAYMENT_AMOUNT, t.FIRST_PAYMENT_AMN, t.LAST_PAYMENT_AMN,
           t.DR_ACC_CUSTOMER_ID, t.CR_ACC_CUSTOMER_ID, t.FK_DEBIT_DEP_ACC, t.FK_CREDIT_DEP_ACC,
           t.DR_ACC_CURRENCY, t.CR_ACC_CURRENCY, t.ACTIVATION_DATE, t.FIRST_PAYMENT_DATE, t.LAST_PAYMENT_DATE,
           t.FREQUENCY_UNIT, t.FREQUENCY, t.MAX_NO_OF_ATTEMPTS, t.ALLOW_NOT_EX_TRIES, t.CR_CHARGE_TYPE,
           t.DR_ACC_COMMENTS, t.CR_ACC_COMMENTS, t.FK_UNITCODE
      FROM H h
      JOIN TP t ON t.OSI = h.SN
),
FINDINGS AS (
    -- Μία γραμμή ανά εύρημα. CUSTOMER_CODE = λογαριασμός χρέωσης HUB (AFSIMSP.ACCOUNT_NO),
    -- SERIAL_NO = AFSIMSP.SERIAL_NUMBER (= OTHER_SYS_IDENTIFIER). HUB_VALUE = τιμή HUB,
    -- NCIS_VALUE = τιμή TP_SO_COMMITMENT. Η αναμενόμενη τιμή (μόνο από τα scripts) στο ISSUE.
    --==============================================================
    --SO-001. HUB standing order προς φόρτωση (όχι CO/CT, old, manual) που δεν είναι στο TP_SO_COMMITMENT.
    --        ISSUE = αιτία από MIGR_TP_SO_COMMITMENT (πρώην SO-002 / 005 / 006 / 007 / 008)
    SELECT
      CAST('SO-001_SO_MISSING_IN_PROFITS' AS VARCHAR2(50)) AS CHECK_NAME,
      CAST(h.AN AS VARCHAR2(40)) AS CUSTOMER_CODE, CAST(TO_CHAR(h.SN) AS VARCHAR2(40)) AS SERIAL_NO,
      CAST('FNPYMD=' || h.PYMD || '; FNISTY=' || h.ISTY || '; FNSICY=' || h.SICY || '; FNAPAC=' || h.APAC AS VARCHAR2(200)) AS HUB_VALUE,
      CAST(NULL AS VARCHAR2(200)) AS NCIS_VALUE,
      CAST(SUBSTR(
        CASE WHEN m.OSI IS NULL THEN 'NOT_IN_MIGR_TP_SO_COMMITMENT'
             WHEN m.RSTAT = '2' AND UPPER(m.RERR) LIKE '%CREDIT ACCOUNT%' THEN 'REJ CREDIT ACC: ' || h.CR_STAT
             WHEN m.RSTAT = '2' AND UPPER(m.RERR) LIKE '%DEBIT ACCOUNT%'
                  THEN 'REJ DEBIT ACC: ' || CASE WHEN h.PA_ACC IS NULL THEN 'NOT IN PROFITS_ACCOUNT' ELSE 'FOUND NOW' END
             WHEN m.RSTAT = '2' THEN 'REJECTED: ' || NVL(m.RERR, '-')
             WHEN m.RSTAT = '9' THEN 'PARKED: ' || NVL(m.RERR, '-')
             WHEN m.RSTAT = '1' THEN 'LOADED_BUT_NOT_IN_TP_SO_COMMITMENT'
             ELSE 'NOT_LOADED (ROW_STATUS ' || NVL(m.RSTAT, '-') || ')' END, 1, 50) AS VARCHAR2(50)) AS ISSUE
    FROM H h
    LEFT JOIN TP t  ON t.OSI = h.SN
    LEFT JOIN MIG m ON m.OSI = h.SN
    WHERE h.DISP = 'LOAD'
      AND t.OSI IS NULL
    UNION ALL
    --==============================================================
    --SO-002. TP_SO_COMMITMENT χωρίς HUB standing order, ή με HUB εντολή που το 60000 δεν φορτώνει
    --        (CO/CT, old, manual) (πρώην SO-009 / 004 / 003)
    SELECT 'SO-002_SO_NOT_EXPECTED_IN_PROFITS', h.AN, NVL(TO_CHAR(h.SN), t.OSI_TXT),
           CASE WHEN h.SN IS NULL THEN NULL ELSE 'FNPYMD=' || h.PYMD || '; FNISTY=' || h.ISTY || '; E_FILE=' || h.E_FILE END,
           'OTHER_SYS_IDENTIFIER=' || t.OSI_TXT,
           CASE WHEN h.SN IS NULL THEN 'NOT_IN_HUB'
                ELSE 'EXPECTED_NOT_MIGRATED (' || h.DISP || ')' END
    FROM TP t
    LEFT JOIN H h ON h.SN = t.OSI
    WHERE h.SN IS NULL OR h.DISP &lt;&gt; 'LOAD'
    UNION ALL
    --==============================================================
    --SO-003. PAYMENT_AMOUNT vs FNSIAM (/100 για νόμισμα με 2 δεκαδικά, 60000)
    SELECT 'SO-003_PAYMENT_AMOUNT_MISMATCH', AN, TO_CHAR(SN), 'FNSIAM=' || TO_CHAR(FNSIAM) || ' ' || SICY, TO_CHAR(PAYMENT_AMOUNT),
           SUBSTR('MISMATCH (EXPECTED ' || NVL(TO_CHAR(E_AMT), 'EMPTY') || ')', 1, 50)
    FROM B
    WHERE ABS(NVL(PAYMENT_AMOUNT, -1) - NVL(E_AMT, -1)) &gt; 0.005
    UNION ALL
    --==============================================================
    --SO-004. FIRST_PAYMENT_AMN / LAST_PAYMENT_AMN vs FNSIAM (60000: ίδιο ποσό)
    SELECT 'SO-004_FIRST_LAST_AMOUNT_MISMATCH', AN, TO_CHAR(SN), 'FNSIAM=' || TO_CHAR(FNSIAM) || ' ' || SICY,
           'FIRST=' || TO_CHAR(FIRST_PAYMENT_AMN) || '; LAST=' || TO_CHAR(LAST_PAYMENT_AMN),
           SUBSTR('MISMATCH (EXPECTED ' || NVL(TO_CHAR(E_AMT), 'EMPTY') || ')', 1, 50)
    FROM B
    WHERE ABS(NVL(FIRST_PAYMENT_AMN, -1) - NVL(E_AMT, -1)) &gt; 0.005
       OR ABS(NVL(LAST_PAYMENT_AMN, -1) - NVL(E_AMT, -1)) &gt; 0.005
    UNION ALL
    --==============================================================
    --SO-005. DR_ACC_CUSTOMER_ID vs PROFITS_ACCOUNT.CUST_ID του λογαριασμού χρέωσης HUB (60000)
    SELECT 'SO-005_DR_CUSTOMER_MISMATCH', AN, TO_CHAR(SN), 'ACCOUNT_NO=' || AN, TO_CHAR(DR_ACC_CUSTOMER_ID),
           CASE WHEN PA_ACC IS NULL THEN 'DEBIT ACC NOT IN PROFITS_ACCOUNT'
                ELSE SUBSTR('MISMATCH (EXPECTED ' || NVL(TO_CHAR(E_DR_CUST), 'EMPTY') || ')', 1, 50) END
    FROM B
    WHERE NVL(DR_ACC_CUSTOMER_ID, -1) &lt;&gt; NVL(E_DR_CUST, -1)
    UNION ALL
    --==============================================================
    --SO-006. CR_ACC_CUSTOMER_ID vs PROFITS_ACCOUNT.CUST_ID του λογαριασμού πίστωσης (FNAPAC, 60000; LP/TT -&gt; κενό)
    SELECT 'SO-006_CR_CUSTOMER_MISMATCH', AN, TO_CHAR(SN), 'FNAPAC=' || APAC, TO_CHAR(CR_ACC_CUSTOMER_ID),
           CASE WHEN PYMD NOT IN ('LP', 'TT') AND PC_ACC IS NULL THEN SUBSTR('CREDIT ACC: ' || CR_STAT, 1, 50)
                ELSE SUBSTR('MISMATCH (EXPECTED ' || NVL(TO_CHAR(E_CR_CUST), 'EMPTY') || ')', 1, 50) END
    FROM B
    WHERE NVL(CR_ACC_CUSTOMER_ID, -1) &lt;&gt; NVL(E_CR_CUST, -1)
    UNION ALL
    --==============================================================
    --SO-007. FK_DEBIT_DEP_ACC vs PROFITS_ACCOUNT.DEP_ACC_NUMBER του λογαριασμού χρέωσης HUB
    SELECT 'SO-007_DEBIT_ACCOUNT_MISMATCH', AN, TO_CHAR(SN), 'ACCOUNT_NO=' || AN, TO_CHAR(FK_DEBIT_DEP_ACC),
           CASE WHEN PA_ACC IS NULL THEN 'DEBIT ACC NOT IN PROFITS_ACCOUNT'
                ELSE SUBSTR('MISMATCH (EXPECTED ' || NVL(TO_CHAR(E_DR_DEP), 'EMPTY') || ')', 1, 50) END
    FROM B
    WHERE NVL(FK_DEBIT_DEP_ACC, -1) &lt;&gt; NVL(E_DR_DEP, -1)
    UNION ALL
    --==============================================================
    --SO-008. FK_CREDIT_DEP_ACC vs PROFITS_ACCOUNT.DEP_ACC_NUMBER του λογαριασμού πίστωσης (FNAPAC; LP/TT -&gt; κενό)
    SELECT 'SO-008_CREDIT_ACCOUNT_MISMATCH', AN, TO_CHAR(SN), 'FNAPAC=' || APAC, TO_CHAR(FK_CREDIT_DEP_ACC),
           CASE WHEN PYMD NOT IN ('LP', 'TT') AND PC_ACC IS NULL THEN SUBSTR('CREDIT ACC: ' || CR_STAT, 1, 50)
                ELSE SUBSTR('MISMATCH (EXPECTED ' || NVL(TO_CHAR(E_CR_DEP), 'EMPTY') || ')', 1, 50) END
    FROM B
    WHERE NVL(FK_CREDIT_DEP_ACC, -1) &lt;&gt; NVL(E_CR_DEP, -1)
    UNION ALL
    --==============================================================
    --SO-009. DR_ACC_CURRENCY vs PROFITS_ACCOUNT.MOVEMENT_CURRENCY του λογαριασμού χρέωσης (60000)
    SELECT 'SO-009_DR_CURRENCY_MISMATCH', AN, TO_CHAR(SN), 'ACCOUNT_NO=' || AN || '; FNSICY=' || SICY, TO_CHAR(DR_ACC_CURRENCY),
           CASE WHEN PA_ACC IS NULL THEN 'DEBIT ACC NOT IN PROFITS_ACCOUNT'
                ELSE SUBSTR('MISMATCH (EXPECTED ' || NVL(TO_CHAR(E_DR_CCY), 'EMPTY') || ')', 1, 50) END
    FROM B
    WHERE NVL(DR_ACC_CURRENCY, -1) &lt;&gt; NVL(E_DR_CCY, -1)
    UNION ALL
    --==============================================================
    --SO-010. CR_ACC_CURRENCY vs FNSICY (GENERIC_DETAIL CURRE, default 19, 60000)
    SELECT 'SO-010_CR_CURRENCY_MISMATCH', AN, TO_CHAR(SN), 'FNSICY=' || SICY, TO_CHAR(CR_ACC_CURRENCY),
           SUBSTR('MISMATCH (EXPECTED ' || TO_CHAR(E_CR_CCY) || ')', 1, 50)
    FROM B
    WHERE NVL(CR_ACC_CURRENCY, -1) &lt;&gt; E_CR_CCY
    UNION ALL
    --==============================================================
    --SO-011. ACTIVATION_DATE vs FNDTNI (μόνο όπου το HUB έχει ημερομηνία· FNDTNI 0 -&gt; SO-021)
    SELECT 'SO-011_ACTIVATION_DATE_MISMATCH', AN, TO_CHAR(SN), 'FNDTNI=' || TO_CHAR(FNDTNI), TO_CHAR(ACTIVATION_DATE, 'YYYY-MM-DD'),
           'MISMATCH (EXPECTED ' || TO_CHAR(E_ACT, 'YYYY-MM-DD') || ')'
    FROM B
    WHERE E_ACT IS NOT NULL
      AND NVL(ACTIVATION_DATE, DATE '0001-01-01') &lt;&gt; E_ACT
    UNION ALL
    --==============================================================
    --SO-012. FIRST_PAYMENT_DATE vs FNDTNI (90000: FIRST_PAYMENT_DATE = ACTIVATION_DATE· μόνο όπου το HUB έχει ημερομηνία)
    SELECT 'SO-012_FIRST_PAYMENT_DATE_MISMATCH', AN, TO_CHAR(SN), 'FNDTNI=' || TO_CHAR(FNDTNI), TO_CHAR(FIRST_PAYMENT_DATE, 'YYYY-MM-DD'),
           'MISMATCH (EXPECTED ' || TO_CHAR(E_ACT, 'YYYY-MM-DD') || ')'
    FROM B
    WHERE E_ACT IS NOT NULL
      AND NVL(FIRST_PAYMENT_DATE, DATE '0001-01-01') &lt;&gt; E_ACT
    UNION ALL
    --==============================================================
    --SO-013. LAST_PAYMENT_DATE vs 60000 (type 2/4 -&gt; 2999-12-31, αλλιώς FNDTNI + FNISTT - FNIGTT μήνες) + 90000
    --        (9999-12-31 -&gt; 2999-12-31). Αντικαθιστά το SO-020 του DC4 (last &lt; activation, μόνο PROFITS)
    SELECT 'SO-013_LAST_PAYMENT_DATE_MISMATCH', AN, TO_CHAR(SN),
           'FNDTNI=' || TO_CHAR(FNDTNI) || '; FNISTT=' || TO_CHAR(FNISTT) || '; FNIGTT=' || TO_CHAR(FNIGTT) || '; FNISTY=' || ISTY,
           TO_CHAR(LAST_PAYMENT_DATE, 'SYYYY-MM-DD'),
           'MISMATCH (EXPECTED ' || TO_CHAR(E_LAST, 'SYYYY-MM-DD') || ')'
    FROM B
    WHERE NVL(LAST_PAYMENT_DATE, DATE '0001-01-01') &lt;&gt; NVL(E_LAST, DATE '0001-01-01')
    UNION ALL
    --==============================================================
    --SO-014. FREQUENCY_UNIT vs FNPRDY / FNISTY (60000· 90000 CHS-399: 2 -&gt; 4 όταν η activation day είναι 29-31)
    SELECT 'SO-014_FREQUENCY_UNIT_MISMATCH', AN, TO_CHAR(SN), 'FNPRDY=' || PRDY || '; FNISTY=' || ISTY || '; FNDTNI=' || TO_CHAR(FNDTNI),
           FREQUENCY_UNIT, 'MISMATCH (EXPECTED ' || E_FU || ')'
    FROM B
    WHERE NVL(FREQUENCY_UNIT, 'X') &lt;&gt; E_FU
    UNION ALL
    --==============================================================
    --SO-015. FREQUENCY vs FNPRDY (60000: Q 3 / B 2 / H 6 / W 7 / A 15 / αλλιώς 1)
    SELECT 'SO-015_FREQUENCY_MISMATCH', AN, TO_CHAR(SN), 'FNPRDY=' || PRDY || '; FNISTY=' || ISTY, TO_CHAR(FREQUENCY),
           'MISMATCH (EXPECTED ' || TO_CHAR(E_FREQ) || ')'
    FROM B
    WHERE NVL(FREQUENCY, -1) &lt;&gt; E_FREQ
    UNION ALL
    --==============================================================
    --SO-016. MAX_NO_OF_ATTEMPTS vs FNTMRT (60000: έως 99)
    SELECT 'SO-016_MAX_ATTEMPTS_MISMATCH', AN, TO_CHAR(SN), 'FNTMRT=' || TO_CHAR(FNTMRT), TO_CHAR(MAX_NO_OF_ATTEMPTS),
           SUBSTR('MISMATCH (EXPECTED ' || NVL(TO_CHAR(E_MAXATT), 'EMPTY') || ')', 1, 50)
    FROM B
    WHERE NVL(MAX_NO_OF_ATTEMPTS, -1) &lt;&gt; NVL(E_MAXATT, -1)
    UNION ALL
    --==============================================================
    --SO-017. ALLOW_NOT_EX_TRIES vs FNTMCR (60000)
    SELECT 'SO-017_ALLOWED_TRIES_MISMATCH', AN, TO_CHAR(SN), 'FNTMCR=' || TO_CHAR(FNTMCR), TO_CHAR(ALLOW_NOT_EX_TRIES),
           SUBSTR('MISMATCH (EXPECTED ' || NVL(TO_CHAR(E_TRIES), 'EMPTY') || ')', 1, 50)
    FROM B
    WHERE NVL(ALLOW_NOT_EX_TRIES, -1) &lt;&gt; NVL(E_TRIES, -1)
    UNION ALL
    --==============================================================
    --SO-018. CR_CHARGE_TYPE vs FNISTY (60000 + 90000 CHS-350: 1 -&gt; 0, 2 / 4 -&gt; 1, 3 / 5 -&gt; κενό, LP / TT / blank -&gt; 0)
    SELECT 'SO-018_CR_CHARGE_TYPE_MISMATCH', AN, TO_CHAR(SN), 'FNPYMD=' || PYMD || '; FNISTY=' || ISTY, CR_CHARGE_TYPE,
           'MISMATCH (EXPECTED ' || NVL(E_CRCH, 'EMPTY') || ')'
    FROM B
    WHERE NVL(CR_CHARGE_TYPE, 'X') &lt;&gt; NVL(E_CRCH, 'X')
    UNION ALL
    --==============================================================
    --SO-019. DR_ACC_COMMENTS / CR_ACC_COMMENTS vs FNDPM1 / FNDPM2 / FNDPM3 (60000: ενωμένα με /, 40 χαρακτήρες)
    SELECT 'SO-019_COMMENTS_MISMATCH', AN, TO_CHAR(SN), DPM,
           SUBSTR('DR=' || DR_ACC_COMMENTS || '; CR=' || CR_ACC_COMMENTS, 1, 200),
           'MISMATCH'
    FROM B
    WHERE NVL(DR_ACC_COMMENTS, 'X') &lt;&gt; NVL(TRIM(DPM), 'X')
       OR NVL(CR_ACC_COMMENTS, 'X') &lt;&gt; NVL(TRIM(DPM), 'X')
    UNION ALL
    --==============================================================
    --SO-020. FK_UNITCODE vs PROFITS_ACCOUNT.MONOTORING_UNIT του λογαριασμού χρέωσης (60000 RESPONSIBLE_UNIT)
    SELECT 'SO-020_UNIT_MISMATCH', AN, TO_CHAR(SN), 'ACCOUNT_NO=' || AN, TO_CHAR(FK_UNITCODE),
           CASE WHEN PA_ACC IS NULL THEN 'DEBIT ACC NOT IN PROFITS_ACCOUNT'
                ELSE SUBSTR('MISMATCH (EXPECTED ' || NVL(TO_CHAR(E_UNIT), 'EMPTY') || ')', 1, 50) END
    FROM B
    WHERE NVL(FK_UNITCODE, -1) &lt;&gt; NVL(E_UNIT, -1)
)
SELECT
    CAST(CHECK_ID || '_' || TO_CHAR(ROW_NUMBER() OVER (PARTITION BY CHECK_ID ORDER BY CUSTOMER_CODE, SERIAL_NO), 'FM0000000') AS VARCHAR2(20)) AS DETAIL_ID,
    CAST(CHECK_ID AS VARCHAR2(10)) AS CHECK_ID,
    CAST(CHECK_NAME AS VARCHAR2(50)) AS CHECK_NAME,
    CAST(SUBSTR(CUSTOMER_CODE, 1, 30) AS VARCHAR2(30)) AS CUSTOMER_CODE,
    CAST(SUBSTR(SERIAL_NO, 1, 30) AS VARCHAR2(30)) AS SERIAL_NO,
    CAST(SUBSTR(HUB_VALUE, 1, 100) AS VARCHAR2(100)) AS HUB_VALUE,
    CAST(SUBSTR(NCIS_VALUE, 1, 100) AS VARCHAR2(100)) AS NCIS_VALUE,
    CAST(SUBSTR(ISSUE, 1, 50) AS VARCHAR2(50)) AS ISSUE,
    'DC5' AS DC_VERSION,
    1 AS RUN_VERSION,  -- TESTING ONLY: στο SSIS αντικαθίσταται από @[User::RunVersion] μέσω Derived Column.
    SYSDATE AS RUN_TIMESTAMP
FROM (
    SELECT
        F.*,
        CAST(SUBSTR(CHECK_NAME, 1, INSTR(CHECK_NAME, '_') - 1) AS VARCHAR2(10)) AS CHECK_ID
    FROM FINDINGS F
)
ORDER BY REGEXP_SUBSTR(CHECK_ID, '[A-Z]+'), TO_NUMBER(REGEXP_SUBSTR(CHECK_ID, '[0-9]+')), CUSTOMER_CODE, SERIAL_NO;</property>
