                        <externalMetadataColumn
                          refId="Package\Sequence Container\Customers_Detail\Customers_detail.Outputs[Oracle Source Output].ExternalColumns[HUB_VALUE]"
                          codePage="1253"
                          dataType="str"
                          length="100"
