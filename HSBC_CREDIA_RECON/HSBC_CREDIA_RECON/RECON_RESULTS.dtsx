                      expressionType="Notify"
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">-- ====================================================================
-- FAT_RECON — MASTER DC5 v1 (FATCA)
-- Τροφοδοτεί: RECON.FAT_RECON_MASTER (όνομα πίνακα προς επιβεβαίωση: δεν υπάρχει ακόμη στο
-- SSIS scripts\Recon_tables.sql)
-- Μία γραμμή ΑΝΑ CHECK_ID — 23 γραμμές ανά run: FAT-001 .. FAT-023.
--
-- FATCA (ME01 HUB, EIM 240825, DD v1.24): HUB SS@TXDPP (tax documents) vs PROFITS USER_DEF_TABLE / USER_DEFINED_FIELDS
-- (tag set FATCA, PFTAG7000..7014). ΔΕΝ υπάρχει NCIS extract: οι τιμές PROFITS διαβάζονται απευθείας από τους πίνακες.
-- Οι στήλες λέγονται NCIS_VALUE για συμβατότητα με το template.
-- Migration scripts: ΜΟΝΟ Migration Scripts\20261116_MigrationScripts (19600_FATCA = 74000 του DC4 χωρίς αλλαγή, 10090,
-- 10098, 12000). Διαφορές DC4 -&gt; DC5: DC5\DC4_vs_DC5_MigrationScripts_FATCA_Diff_Report.md. Δεν υπήρχε DC4 recon.
-- Μορφή Master/Detail όπως το MasterRealEstate_DC5_v1.sql:
--   - ένα αυτοτελές SELECT, χωρίς views / πίνακες HGR_*. Το κοινό κομμάτι και το FINDINGS είναι ΙΔΙΑ αυτούσια στο
--     DetailFATCA_DC5_v1.sql -&gt; INVALID_COUNT = γραμμές του Detail ανά CHECK_ID.
--     Τα INFO checks (FAT-019 .. FAT-023) υπολογίζονται μόνο εδώ, στο FINDINGS_COUNT.
--   - Παράγεται από τον generator (_generator\build.sh): gen_parts.sh (tags.txt -&gt; ένα check ανά tag) +
--     fat_master_head + fat_common + fat_master_tail.
--   - HUB από synonym σε DB link @Malta (10098): HUB_MT_SSTXDPP, ΜΙΑ ανάγνωση σε CTE R_TX.
--
-- ΑΡΧΗ: αναμενόμενη τιμή ΜΟΝΟ από το 19600:
--   - Scope: SSTXDPP TDTDTY IN ('W8') AND TDTDDE = '99999999' AND TDAIFL = 'Y', πελάτης στο MG_CUSTOMER_INTER με
--     ROW_STATUS 1. Πελάτης που δεν μεταφέρθηκε -&gt; FAIL στο FAT-001 με την αιτία (απόφαση χρήστη 2026-11-17).
--   - Κλειδί: USER_DEF_TABLE.ACCOUNT_NUMBER / USER_DEFINED_FIELDS.UD_ACCOUNT_NUMBER = PRFT_CUST_ID (με κενά μπροστά).
--   - USER_DEFINED_FIELDS: ένα ανά γραμμή W8 x tag, FIELD_VALUE = η τιμή του HUB όπως είναι (και οι ημερομηνίες).
--     Πελάτης με 2+ W8: δεκτή οποιαδήποτε από τις τιμές HUB του (FAT-003 .. 017), αναμενόμενες γραμμές = W8 x γραμμές MCI
--     (FAT-018).
--   - Μόνο checks HUB vs PROFITS (απόφαση χρήστη 2026-11-17). Η παραμετροποίηση (GENERIC_DETAIL PFTAG, PFG_*,
--     PROD_PFG_SET) και οι σταθερές τιμές δεν ελέγχονται.
--   - HUB_VALUE = τιμή HUB, NCIS_VALUE = τιμή PROFITS, αναμενόμενη τιμή στο ISSUE. Πραγματικές τιμές (και masked πεδία).
--   - Detail: CUSTOMER_CODE = πελάτης HUB, SERIAL_NO = tag (FAT-003 .. 018) ή PRFT_CUST_ID (FAT-001 / 002).
--
-- STATUS: PASS (INVALID_COUNT = 0) / FAIL / INFO. DESCRIPTION: απλή περιγραφή χωρίς κωδικούς.
--
-- TOTAL_RECORDS ανά POPULATION_TYPE:
--   HUB_CUST  = πελάτες HUB με W8 του scope        PROF_CUST = πελάτες με εγγραφή FATCA στο USER_DEF_TABLE
--   PFTAG70nn = πελάτες και στα δύο με γραμμή του tag στο PROFITS    TAG_ROWS = πελάτες και στα δύο x 15 tags
--   TX_ALL    = όλες οι γραμμές SSTXDPP   W8_ALL = γραμμές W8   SC_ROWS = γραμμές W8 του scope
-- ====================================================================
WITH
-- --------------------------------------------------------------------
-- Κοινό κομμάτι (ΙΔΙΟ αυτούσιο στο Master και στο Detail).
--   R_TX   = HUB_MT_SSTXDPP (synonym @Malta, 10098 / αντίγραφο του 10090 με CUSTOMER_CODE = TDDCB || LPAD(TDDCS,6,'0')):
--            ΜΙΑ ανάγνωση, όλες οι γραμμές, μόνο οι στήλες που χρειάζονται. SC = 1 όταν η γραμμή είναι στο scope του 19600
--            (TDTDTY 'W8', TDTDDE '99999999', TDAIFL 'Y'). V00..V14 = οι 15 τιμές που γράφει το 19600 (όπως είναι στο HUB).
--   MCI    = MG_CUSTOMER_INTER ανά κωδικό: PID = PRFT_CUST_ID της γραμμής με ROW_STATUS 1 (19600: INNER JOIN ... AND
--            ROW_STATUS = 1), N_OK = γραμμές με ROW_STATUS 1 (το join τις πολλαπλασιάζει).
--   TSC    = πελάτες HUB με γραμμή του scope (NH = γραμμές) + MCI.
--   UDT    = USER_DEF_TABLE FATCA (ACCOUNT_NUMBER = PRFT_CUST_ID), ανά πελάτη.  PV = USER_DEFINED_FIELDS FATCA (PID, TAG, τιμή).
--   MC     = πελάτες του scope που υπάρχουν στο USER_DEF_TABLE.
--   TAGS   = τα 15 tags του 19600 (PFTAG7000..7014) -&gt; πεδίο HUB.  HV = τιμές HUB ανά πελάτη + tag (όλες οι γραμμές του scope).
--   HVA / PVA = ανά πελάτη + tag: τιμές HUB / PROFITS.  TAGCMP = σύγκριση ανά πελάτη + tag (OK = κάθε τιμή PROFITS είναι
--            μία από τις τιμές HUB του πελάτη: πελάτης με 2+ W8 -&gt; δεκτή οποιαδήποτε).
--   TCNT   = ανά πελάτη + tag: γραμμές PROFITS vs αναμενόμενες (NH x N_OK).
-- --------------------------------------------------------------------
R_TX AS (
    SELECT /*+ MATERIALIZE */
           TRIM(CUSTOMER_CODE)                AS CC,
           TRIM(TDTDTY)                       AS DTY,
           TRIM(TO_CHAR(TDTDDE))              AS DDE,
           TRIM(TDAIFL)                       AS AIFL,
           CASE WHEN TDTDTY IN ('W8') AND TDTDDE = '99999999' AND TDAIFL = 'Y' THEN 1 ELSE 0 END AS SC,
           TRIM(TO_CHAR(TDTXDX))  AS V00, TRIM(TO_CHAR(TDTDTY))  AS V01, TRIM(TO_CHAR(TDTCCO))  AS V02,
           TRIM(TO_CHAR(TDTXDC))  AS V03, TRIM(TO_CHAR(TDTDTI))  AS V04, TRIM(TO_CHAR(TDTDRD))  AS V05,
           TRIM(TO_CHAR(TDTDDE))  AS V06, TRIM(TO_CHAR(TDEINO))  AS V07, TRIM(TO_CHAR(TDNAD12)) AS V08,
           TRIM(TO_CHAR(TDNAD13)) AS V09, TRIM(TO_CHAR(TDNAD14)) AS V10, TRIM(TO_CHAR(TDADCE))  AS V11,
           TRIM(TO_CHAR(TDLTNO))  AS V12, TRIM(TO_CHAR(TDFEIN))  AS V13, TRIM(TO_CHAR(TDQEIN))  AS V14,
           CASE WHEN NVL(TRIM(TO_CHAR(TDCTCD)), '0') &lt;&gt; '0' OR NVL(TRIM(TO_CHAR(TDTXRG)), '0') &lt;&gt; '0'
                  OR NVL(TRIM(TO_CHAR(TDCTCG)), '0') &lt;&gt; '0' OR NVL(TRIM(TO_CHAR(TDTDCT)), '0') &lt;&gt; '0'
                  OR NVL(TRIM(TO_CHAR(TDTDSI)), '0') &lt;&gt; '0' OR NVL(TRIM(TO_CHAR(TDGIDN)), '0') &lt;&gt; '0'
                THEN 1 ELSE 0 END                AS NOTGT
      FROM HUB_MT_SSTXDPP
),
MCI AS (
    SELECT /*+ MATERIALIZE */
           TRIM(CUSTOMER_CODE) AS CC,
           MIN(CASE WHEN TRIM(TO_CHAR(ROW_STATUS)) = '1' THEN PRFT_CUST_ID END) AS PID,
           SUM(CASE WHEN TRIM(TO_CHAR(ROW_STATUS)) = '1' THEN 1 ELSE 0 END)     AS N_OK,
           MAX(TRIM(TO_CHAR(ROW_STATUS)))                                        AS RS
      FROM MG_CUSTOMER_INTER
     WHERE TRIM(CUSTOMER_CODE) IN (SELECT CC FROM R_TX WHERE SC = 1)
     GROUP BY TRIM(CUSTOMER_CODE)
),
TSC AS (
    SELECT /*+ MATERIALIZE */
           t.CC, COUNT(*) AS NH, MIN(m.PID) AS PID, MIN(NVL(m.N_OK, 0)) AS N_OK, MIN(m.RS) AS RS,
           MIN(CASE WHEN m.CC IS NOT NULL THEN 'Y' ELSE 'N' END) AS IN_MCI
      FROM R_TX t
      LEFT JOIN MCI m ON m.CC = t.CC
     WHERE t.SC = 1
     GROUP BY t.CC
),
UDT AS (
    SELECT /*+ MATERIALIZE */
           TO_NUMBER(TRIM(ACCOUNT_NUMBER) DEFAULT NULL ON CONVERSION ERROR) AS PID, COUNT(*) AS N
      FROM USER_DEF_TABLE
     WHERE TRIM(TAG_SET_CODE) = 'FATCA'
     GROUP BY TO_NUMBER(TRIM(ACCOUNT_NUMBER) DEFAULT NULL ON CONVERSION ERROR)
),
PV AS (
    SELECT /*+ MATERIALIZE */
           TO_NUMBER(TRIM(UD_ACCOUNT_NUMBER) DEFAULT NULL ON CONVERSION ERROR) AS PID,
           TRIM(PFG_TAG) AS TAG, TRIM(FIELD_VALUE) AS V
      FROM USER_DEFINED_FIELDS
     WHERE TRIM(PFG_TAG_SET_CODE) = 'FATCA'
),
MC AS (
    SELECT /*+ MATERIALIZE */ c.CC, c.PID, c.NH, c.N_OK
      FROM TSC c
     WHERE c.PID IS NOT NULL
       AND EXISTS (SELECT 1 FROM UDT u WHERE u.PID = c.PID)
),
TAGS AS (
    SELECT 'PFTAG7000' AS TAG, 0 AS N, 'TDTXDX' AS FLD FROM DUAL UNION ALL
    SELECT 'PFTAG7001', 1, 'TDTDTY' FROM DUAL UNION ALL
    SELECT 'PFTAG7002', 2, 'TDTCCO' FROM DUAL UNION ALL
    SELECT 'PFTAG7003', 3, 'TDTXDC' FROM DUAL UNION ALL
    SELECT 'PFTAG7004', 4, 'TDTDTI' FROM DUAL UNION ALL
    SELECT 'PFTAG7005', 5, 'TDTDRD' FROM DUAL UNION ALL
    SELECT 'PFTAG7006', 6, 'TDTDDE' FROM DUAL UNION ALL
    SELECT 'PFTAG7007', 7, 'TDEINO' FROM DUAL UNION ALL
    SELECT 'PFTAG7008', 8, 'TDNAD12' FROM DUAL UNION ALL
    SELECT 'PFTAG7009', 9, 'TDNAD13' FROM DUAL UNION ALL
    SELECT 'PFTAG7010', 10, 'TDNAD14' FROM DUAL UNION ALL
    SELECT 'PFTAG7011', 11, 'TDADCE' FROM DUAL UNION ALL
    SELECT 'PFTAG7012', 12, 'TDLTNO' FROM DUAL UNION ALL
    SELECT 'PFTAG7013', 13, 'TDFEIN' FROM DUAL UNION ALL
    SELECT 'PFTAG7014', 14, 'TDQEIN' FROM DUAL
),
HV AS (
    SELECT /*+ MATERIALIZE */
           s.CC, t.TAG,
           DECODE(t.N, 0, s.V00, 1, s.V01, 2, s.V02, 3, s.V03, 4, s.V04, 5, s.V05, 6, s.V06, 7, s.V07,
                       8, s.V08, 9, s.V09, 10, s.V10, 11, s.V11, 12, s.V12, 13, s.V13, 14, s.V14) AS V
      FROM R_TX s
     CROSS JOIN TAGS t
     WHERE s.SC = 1
),
HVA AS (
    SELECT CC, TAG, MIN(V) AS HV, COUNT(DISTINCT NVL(V, '~')) AS NDV FROM HV GROUP BY CC, TAG
),
PVA AS (
    SELECT PID, TAG, MIN(V) AS PV, COUNT(*) AS NP FROM PV GROUP BY PID, TAG
),
TAGCMP AS (
    SELECT /*+ MATERIALIZE */
           m.CC, m.PID, a.TAG, a.HV, a.NDV, p.PV, p.NP,
           CASE WHEN EXISTS (SELECT 1 FROM PV x
                              WHERE x.PID = m.PID AND x.TAG = a.TAG
                                AND NOT EXISTS (SELECT 1 FROM HV y
                                                 WHERE y.CC = m.CC AND y.TAG = a.TAG AND NVL(y.V, '~') = NVL(x.V, '~')))
                THEN 'N' ELSE 'Y' END AS OK
      FROM MC m
      JOIN HVA a ON a.CC = m.CC
      JOIN PVA p ON p.PID = m.PID AND p.TAG = a.TAG
),
TCNT AS (
    SELECT /*+ MATERIALIZE */
           m.CC, m.PID, t.TAG, m.NH * m.N_OK AS X, NVL(p.NP, 0) AS P
      FROM MC m
     CROSS JOIN TAGS t
      LEFT JOIN PVA p ON p.PID = m.PID AND p.TAG = t.TAG
),
FINDINGS AS (
    -- Μία γραμμή ανά εύρημα. CUSTOMER_CODE = πελάτης HUB (SSTXDPP.CUSTOMER_CODE), SERIAL_NO = tag (PFTAG70nn) ή
    -- PRFT_CUST_ID. HUB_VALUE = τιμή HUB, NCIS_VALUE = τιμή PROFITS (δεν υπάρχει NCIS extract). Αναμενόμενη τιμή στο ISSUE.
    --==============================================================
    --FAT-001. Πελάτης HUB με W8 του scope χωρίς εγγραφή FATCA στο USER_DEF_TABLE. ISSUE = αιτία.
    SELECT
      CAST('FAT-001_FATCA_RECORD_MISSING_IN_PROFITS' AS VARCHAR2(50)) AS CHECK_NAME,
      CAST(c.CC AS VARCHAR2(40)) AS CUSTOMER_CODE,
      CAST(TO_CHAR(c.PID) AS VARCHAR2(40)) AS SERIAL_NO,
      CAST('W8 ROWS=' || c.NH AS VARCHAR2(200)) AS HUB_VALUE,
      CAST(NULL AS VARCHAR2(200)) AS NCIS_VALUE,
      CAST(SUBSTR(CASE WHEN c.IN_MCI = 'N'  THEN 'CUSTOMER NOT IN MG_CUSTOMER_INTER'
                       WHEN c.PID IS NULL   THEN 'CUSTOMER NOT MIGRATED (ROW_STATUS ' || NVL(c.RS, '-') || ')'
                       ELSE 'MISSING IN PROFITS' END, 1, 50) AS VARCHAR2(50)) AS ISSUE
    FROM TSC c
    WHERE c.PID IS NULL OR NOT EXISTS (SELECT 1 FROM UDT u WHERE u.PID = c.PID)
    UNION ALL
    --==============================================================
    --FAT-002. Εγγραφή FATCA στο USER_DEF_TABLE χωρίς πελάτη HUB του scope, ή διπλή.
    SELECT 'FAT-002_FATCA_RECORD_MISSING_IN_HUB',
           (SELECT MIN(c.CC) FROM TSC c WHERE c.PID = u.PID), TO_CHAR(u.PID),
           CAST(NULL AS VARCHAR2(200)), 'ROWS=' || u.N,
           CASE WHEN NOT EXISTS (SELECT 1 FROM TSC c WHERE c.PID = u.PID) THEN 'NOT A HUB W8 CUSTOMER IN SCOPE'
                ELSE SUBSTR('DUPLICATE IN PROFITS (' || u.N || ' ROWS)', 1, 50) END
    FROM UDT u
    WHERE NOT EXISTS (SELECT 1 FROM TSC c WHERE c.PID = u.PID) OR u.N &gt; 1
    UNION ALL
    --==============================================================
    --FAT-003. USER_DEFINED_FIELDS PFTAG7000 (identity document number) vs SSTXDPP.TDTXDX (19600: η τιμή όπως είναι στο HUB).
    SELECT 'FAT-003_IDENTITY_DOC_NO_MISMATCH', x.CC, 'PFTAG7000',
           SUBSTR(NVL(x.HV, '(EMPTY)') || CASE WHEN x.NDV &gt; 1 THEN ' (+' || (x.NDV - 1) || ' OTHER W8)' END, 1, 200),
           SUBSTR(NVL(x.PV, '(EMPTY)'), 1, 200),
           SUBSTR('MISMATCH (EXPECTED ' || NVL(x.HV, 'EMPTY') || ')', 1, 50)
    FROM TAGCMP x
    WHERE x.TAG = 'PFTAG7000' AND x.OK = 'N'
    UNION ALL
    --==============================================================
    --FAT-004. USER_DEFINED_FIELDS PFTAG7001 (tax documentation type) vs SSTXDPP.TDTDTY (19600: η τιμή όπως είναι στο HUB).
    SELECT 'FAT-004_DOC_TYPE_MISMATCH', x.CC, 'PFTAG7001',
           SUBSTR(NVL(x.HV, '(EMPTY)') || CASE WHEN x.NDV &gt; 1 THEN ' (+' || (x.NDV - 1) || ' OTHER W8)' END, 1, 200),
           SUBSTR(NVL(x.PV, '(EMPTY)'), 1, 200),
           SUBSTR('MISMATCH (EXPECTED ' || NVL(x.HV, 'EMPTY') || ')', 1, 50)
    FROM TAGCMP x
    WHERE x.TAG = 'PFTAG7001' AND x.OK = 'N'
    UNION ALL
    --==============================================================
    --FAT-005. USER_DEFINED_FIELDS PFTAG7002 (customer tax classification country) vs SSTXDPP.TDTCCO (19600: η τιμή όπως είναι στο HUB).
    SELECT 'FAT-005_TAX_CLASS_COUNTRY_MISMATCH', x.CC, 'PFTAG7002',
           SUBSTR(NVL(x.HV, '(EMPTY)') || CASE WHEN x.NDV &gt; 1 THEN ' (+' || (x.NDV - 1) || ' OTHER W8)' END, 1, 200),
           SUBSTR(NVL(x.PV, '(EMPTY)'), 1, 200),
           SUBSTR('MISMATCH (EXPECTED ' || NVL(x.HV, 'EMPTY') || ')', 1, 50)
    FROM TAGCMP x
    WHERE x.TAG = 'PFTAG7002' AND x.OK = 'N'
    UNION ALL
    --==============================================================
    --FAT-006. USER_DEFINED_FIELDS PFTAG7003 (tax documentation country of issue) vs SSTXDPP.TDTXDC (19600: η τιμή όπως είναι στο HUB).
    SELECT 'FAT-006_DOC_ISSUE_COUNTRY_MISMATCH', x.CC, 'PFTAG7003',
           SUBSTR(NVL(x.HV, '(EMPTY)') || CASE WHEN x.NDV &gt; 1 THEN ' (+' || (x.NDV - 1) || ' OTHER W8)' END, 1, 200),
           SUBSTR(NVL(x.PV, '(EMPTY)'), 1, 200),
           SUBSTR('MISMATCH (EXPECTED ' || NVL(x.HV, 'EMPTY') || ')', 1, 50)
    FROM TAGCMP x
    WHERE x.TAG = 'PFTAG7003' AND x.OK = 'N'
    UNION ALL
    --==============================================================
    --FAT-007. USER_DEFINED_FIELDS PFTAG7004 (tax documentation date of issue) vs SSTXDPP.TDTDTI (19600: η τιμή όπως είναι στο HUB).
    SELECT 'FAT-007_DOC_ISSUE_DATE_MISMATCH', x.CC, 'PFTAG7004',
           SUBSTR(NVL(x.HV, '(EMPTY)') || CASE WHEN x.NDV &gt; 1 THEN ' (+' || (x.NDV - 1) || ' OTHER W8)' END, 1, 200),
           SUBSTR(NVL(x.PV, '(EMPTY)'), 1, 200),
           SUBSTR('MISMATCH (EXPECTED ' || NVL(x.HV, 'EMPTY') || ')', 1, 50)
    FROM TAGCMP x
    WHERE x.TAG = 'PFTAG7004' AND x.OK = 'N'
    UNION ALL
    --==============================================================
    --FAT-008. USER_DEFINED_FIELDS PFTAG7005 (tax documentation date received) vs SSTXDPP.TDTDRD (19600: η τιμή όπως είναι στο HUB).
    SELECT 'FAT-008_DOC_RECEIVED_DATE_MISMATCH', x.CC, 'PFTAG7005',
           SUBSTR(NVL(x.HV, '(EMPTY)') || CASE WHEN x.NDV &gt; 1 THEN ' (+' || (x.NDV - 1) || ' OTHER W8)' END, 1, 200),
           SUBSTR(NVL(x.PV, '(EMPTY)'), 1, 200),
           SUBSTR('MISMATCH (EXPECTED ' || NVL(x.HV, 'EMPTY') || ')', 1, 50)
    FROM TAGCMP x
    WHERE x.TAG = 'PFTAG7005' AND x.OK = 'N'
    UNION ALL
    --==============================================================
    --FAT-009. USER_DEFINED_FIELDS PFTAG7006 (tax documentation date of expiry) vs SSTXDPP.TDTDDE (19600: η τιμή όπως είναι στο HUB).
    SELECT 'FAT-009_DOC_EXPIRY_DATE_MISMATCH', x.CC, 'PFTAG7006',
           SUBSTR(NVL(x.HV, '(EMPTY)') || CASE WHEN x.NDV &gt; 1 THEN ' (+' || (x.NDV - 1) || ' OTHER W8)' END, 1, 200),
           SUBSTR(NVL(x.PV, '(EMPTY)'), 1, 200),
           SUBSTR('MISMATCH (EXPECTED ' || NVL(x.HV, 'EMPTY') || ')', 1, 50)
    FROM TAGCMP x
    WHERE x.TAG = 'PFTAG7006' AND x.OK = 'N'
    UNION ALL
    --==============================================================
    --FAT-010. USER_DEFINED_FIELDS PFTAG7007 (EIN / TIN number) vs SSTXDPP.TDEINO (19600: η τιμή όπως είναι στο HUB).
    SELECT 'FAT-010_EIN_TIN_MISMATCH', x.CC, 'PFTAG7007',
           SUBSTR(NVL(x.HV, '(EMPTY)') || CASE WHEN x.NDV &gt; 1 THEN ' (+' || (x.NDV - 1) || ' OTHER W8)' END, 1, 200),
           SUBSTR(NVL(x.PV, '(EMPTY)'), 1, 200),
           SUBSTR('MISMATCH (EXPECTED ' || NVL(x.HV, 'EMPTY') || ')', 1, 50)
    FROM TAGCMP x
    WHERE x.TAG = 'PFTAG7007' AND x.OK = 'N'
    UNION ALL
    --==============================================================
    --FAT-011. USER_DEFINED_FIELDS PFTAG7008 (name on the tax documentation) vs SSTXDPP.TDNAD12 (19600: η τιμή όπως είναι στο HUB).
    SELECT 'FAT-011_DOC_NAME_MISMATCH', x.CC, 'PFTAG7008',
           SUBSTR(NVL(x.HV, '(EMPTY)') || CASE WHEN x.NDV &gt; 1 THEN ' (+' || (x.NDV - 1) || ' OTHER W8)' END, 1, 200),
           SUBSTR(NVL(x.PV, '(EMPTY)'), 1, 200),
           SUBSTR('MISMATCH (EXPECTED ' || NVL(x.HV, 'EMPTY') || ')', 1, 50)
    FROM TAGCMP x
    WHERE x.TAG = 'PFTAG7008' AND x.OK = 'N'
    UNION ALL
    --==============================================================
    --FAT-012. USER_DEFINED_FIELDS PFTAG7009 (address line 1 on the tax documentation) vs SSTXDPP.TDNAD13 (19600: η τιμή όπως είναι στο HUB).
    SELECT 'FAT-012_DOC_ADDRESS_1_MISMATCH', x.CC, 'PFTAG7009',
           SUBSTR(NVL(x.HV, '(EMPTY)') || CASE WHEN x.NDV &gt; 1 THEN ' (+' || (x.NDV - 1) || ' OTHER W8)' END, 1, 200),
           SUBSTR(NVL(x.PV, '(EMPTY)'), 1, 200),
           SUBSTR('MISMATCH (EXPECTED ' || NVL(x.HV, 'EMPTY') || ')', 1, 50)
    FROM TAGCMP x
    WHERE x.TAG = 'PFTAG7009' AND x.OK = 'N'
    UNION ALL
    --==============================================================
    --FAT-013. USER_DEFINED_FIELDS PFTAG7010 (address line 2 on the tax documentation) vs SSTXDPP.TDNAD14 (19600: η τιμή όπως είναι στο HUB).
    SELECT 'FAT-013_DOC_ADDRESS_2_MISMATCH', x.CC, 'PFTAG7010',
           SUBSTR(NVL(x.HV, '(EMPTY)') || CASE WHEN x.NDV &gt; 1 THEN ' (+' || (x.NDV - 1) || ' OTHER W8)' END, 1, 200),
           SUBSTR(NVL(x.PV, '(EMPTY)'), 1, 200),
           SUBSTR('MISMATCH (EXPECTED ' || NVL(x.HV, 'EMPTY') || ')', 1, 50)
    FROM TAGCMP x
    WHERE x.TAG = 'PFTAG7010' AND x.OK = 'N'
    UNION ALL
    --==============================================================
    --FAT-014. USER_DEFINED_FIELDS PFTAG7011 (address country code) vs SSTXDPP.TDADCE (19600: η τιμή όπως είναι στο HUB).
    SELECT 'FAT-014_ADDRESS_COUNTRY_MISMATCH', x.CC, 'PFTAG7011',
           SUBSTR(NVL(x.HV, '(EMPTY)') || CASE WHEN x.NDV &gt; 1 THEN ' (+' || (x.NDV - 1) || ' OTHER W8)' END, 1, 200),
           SUBSTR(NVL(x.PV, '(EMPTY)'), 1, 200),
           SUBSTR('MISMATCH (EXPECTED ' || NVL(x.HV, 'EMPTY') || ')', 1, 50)
    FROM TAGCMP x
    WHERE x.TAG = 'PFTAG7011' AND x.OK = 'N'
    UNION ALL
    --==============================================================
    --FAT-015. USER_DEFINED_FIELDS PFTAG7012 (local tax number) vs SSTXDPP.TDLTNO (19600: η τιμή όπως είναι στο HUB).
    SELECT 'FAT-015_LOCAL_TAX_NO_MISMATCH', x.CC, 'PFTAG7012',
           SUBSTR(NVL(x.HV, '(EMPTY)') || CASE WHEN x.NDV &gt; 1 THEN ' (+' || (x.NDV - 1) || ' OTHER W8)' END, 1, 200),
           SUBSTR(NVL(x.PV, '(EMPTY)'), 1, 200),
           SUBSTR('MISMATCH (EXPECTED ' || NVL(x.HV, 'EMPTY') || ')', 1, 50)
    FROM TAGCMP x
    WHERE x.TAG = 'PFTAG7012' AND x.OK = 'N'
    UNION ALL
    --==============================================================
    --FAT-016. USER_DEFINED_FIELDS PFTAG7013 (FFI EIN) vs SSTXDPP.TDFEIN (19600: η τιμή όπως είναι στο HUB).
    SELECT 'FAT-016_FFI_EIN_MISMATCH', x.CC, 'PFTAG7013',
           SUBSTR(NVL(x.HV, '(EMPTY)') || CASE WHEN x.NDV &gt; 1 THEN ' (+' || (x.NDV - 1) || ' OTHER W8)' END, 1, 200),
           SUBSTR(NVL(x.PV, '(EMPTY)'), 1, 200),
           SUBSTR('MISMATCH (EXPECTED ' || NVL(x.HV, 'EMPTY') || ')', 1, 50)
    FROM TAGCMP x
    WHERE x.TAG = 'PFTAG7013' AND x.OK = 'N'
    UNION ALL
    --==============================================================
    --FAT-017. USER_DEFINED_FIELDS PFTAG7014 (QI EIN) vs SSTXDPP.TDQEIN (19600: η τιμή όπως είναι στο HUB).
    SELECT 'FAT-017_QI_EIN_MISMATCH', x.CC, 'PFTAG7014',
           SUBSTR(NVL(x.HV, '(EMPTY)') || CASE WHEN x.NDV &gt; 1 THEN ' (+' || (x.NDV - 1) || ' OTHER W8)' END, 1, 200),
           SUBSTR(NVL(x.PV, '(EMPTY)'), 1, 200),
           SUBSTR('MISMATCH (EXPECTED ' || NVL(x.HV, 'EMPTY') || ')', 1, 50)
    FROM TAGCMP x
    WHERE x.TAG = 'PFTAG7014' AND x.OK = 'N'
    UNION ALL
    --==============================================================
    --FAT-018. Γραμμές USER_DEFINED_FIELDS ανά πελάτη + tag διαφορετικές από τις αναμενόμενες (γραμμές W8 x γραμμές MCI).
    SELECT 'FAT-018_FIELD_ROW_COUNT_MISMATCH', x.CC, x.TAG,
           'EXPECTED ROWS ' || x.X, 'ROWS ' || x.P,
           CASE WHEN x.P = 0 THEN 'TAG ROW MISSING IN PROFITS'
                ELSE SUBSTR(x.P || ' ROWS (EXPECTED ' || x.X || ')', 1, 50) END
    FROM TCNT x
    WHERE x.P &lt;&gt; x.X
)
,
POPS AS (
    -- POPULATION_TYPE | CNT (για τα checks ανά tag: POPULATION_TYPE = tag, CNT = πελάτες με γραμμή του tag και στα δύο)
    SELECT 'HUB_CUST' AS POPULATION_TYPE, COUNT(*) AS CNT FROM TSC
    UNION ALL SELECT 'PROF_CUST', COUNT(*) FROM UDT
    UNION ALL SELECT 'TAG_ROWS', COUNT(*) FROM TCNT
    UNION ALL SELECT 'TX_ALL', COUNT(*) FROM R_TX
    UNION ALL SELECT 'W8_ALL', COUNT(*) FROM R_TX WHERE DTY = 'W8'
    UNION ALL SELECT 'SC_ROWS', COUNT(*) FROM R_TX WHERE SC = 1
    UNION ALL SELECT TAG, COUNT(*) FROM TAGCMP GROUP BY TAG
    UNION ALL SELECT t.TAG, 0 FROM TAGS t WHERE NOT EXISTS (SELECT 1 FROM TAGCMP x WHERE x.TAG = t.TAG)
),
CHECK_META AS (
    -- CHECK_ID | CHECK_NAME | CATEGORY | DESCRIPTION | POPULATION_TYPE
    SELECT 'FAT-001' AS CHECK_ID, 'FAT-001_FATCA_RECORD_MISSING_IN_PROFITS' AS CHECK_NAME, 'EXISTENCE' AS CATEGORY, 'HUB customers with an active W8 tax document that the migration selects but with no FATCA record in PROFITS. The detail rows give the reason.' AS DESCRIPTION, 'HUB_CUST' AS POPULATION_TYPE FROM DUAL UNION ALL
    SELECT 'FAT-002', 'FAT-002_FATCA_RECORD_MISSING_IN_HUB', 'EXISTENCE', 'FATCA records in PROFITS whose customer has no active W8 tax document selected by the migration in HUB, or held more than once.', 'PROF_CUST' FROM DUAL UNION ALL
    SELECT 'FAT-003', 'FAT-003_IDENTITY_DOC_NO_MISMATCH', 'CROSS_SYSTEM_MISMATCH', 'The identity document number of the FATCA record in PROFITS differs from the HUB tax document value the migration sends.', 'PFTAG7000' FROM DUAL UNION ALL
    SELECT 'FAT-004', 'FAT-004_DOC_TYPE_MISMATCH', 'CROSS_SYSTEM_MISMATCH', 'The tax documentation type of the FATCA record in PROFITS differs from the HUB tax document value the migration sends.', 'PFTAG7001' FROM DUAL UNION ALL
    SELECT 'FAT-005', 'FAT-005_TAX_CLASS_COUNTRY_MISMATCH', 'CROSS_SYSTEM_MISMATCH', 'The customer tax classification country of the FATCA record in PROFITS differs from the HUB tax document value the migration sends.', 'PFTAG7002' FROM DUAL UNION ALL
    SELECT 'FAT-006', 'FAT-006_DOC_ISSUE_COUNTRY_MISMATCH', 'CROSS_SYSTEM_MISMATCH', 'The tax documentation country of issue of the FATCA record in PROFITS differs from the HUB tax document value the migration sends.', 'PFTAG7003' FROM DUAL UNION ALL
    SELECT 'FAT-007', 'FAT-007_DOC_ISSUE_DATE_MISMATCH', 'CROSS_SYSTEM_MISMATCH', 'The tax documentation date of issue of the FATCA record in PROFITS differs from the HUB tax document value the migration sends.', 'PFTAG7004' FROM DUAL UNION ALL
    SELECT 'FAT-008', 'FAT-008_DOC_RECEIVED_DATE_MISMATCH', 'CROSS_SYSTEM_MISMATCH', 'The tax documentation date received of the FATCA record in PROFITS differs from the HUB tax document value the migration sends.', 'PFTAG7005' FROM DUAL UNION ALL
    SELECT 'FAT-009', 'FAT-009_DOC_EXPIRY_DATE_MISMATCH', 'CROSS_SYSTEM_MISMATCH', 'The tax documentation date of expiry of the FATCA record in PROFITS differs from the HUB tax document value the migration sends.', 'PFTAG7006' FROM DUAL UNION ALL
    SELECT 'FAT-010', 'FAT-010_EIN_TIN_MISMATCH', 'CROSS_SYSTEM_MISMATCH', 'The EIN / TIN number of the FATCA record in PROFITS differs from the HUB tax document value the migration sends.', 'PFTAG7007' FROM DUAL UNION ALL
    SELECT 'FAT-011', 'FAT-011_DOC_NAME_MISMATCH', 'CROSS_SYSTEM_MISMATCH', 'The name on the tax documentation of the FATCA record in PROFITS differs from the HUB tax document value the migration sends.', 'PFTAG7008' FROM DUAL UNION ALL
    SELECT 'FAT-012', 'FAT-012_DOC_ADDRESS_1_MISMATCH', 'CROSS_SYSTEM_MISMATCH', 'The address line 1 on the tax documentation of the FATCA record in PROFITS differs from the HUB tax document value the migration sends.', 'PFTAG7009' FROM DUAL UNION ALL
    SELECT 'FAT-013', 'FAT-013_DOC_ADDRESS_2_MISMATCH', 'CROSS_SYSTEM_MISMATCH', 'The address line 2 on the tax documentation of the FATCA record in PROFITS differs from the HUB tax document value the migration sends.', 'PFTAG7010' FROM DUAL UNION ALL
    SELECT 'FAT-014', 'FAT-014_ADDRESS_COUNTRY_MISMATCH', 'CROSS_SYSTEM_MISMATCH', 'The address country code of the FATCA record in PROFITS differs from the HUB tax document value the migration sends.', 'PFTAG7011' FROM DUAL UNION ALL
    SELECT 'FAT-015', 'FAT-015_LOCAL_TAX_NO_MISMATCH', 'CROSS_SYSTEM_MISMATCH', 'The local tax number of the FATCA record in PROFITS differs from the HUB tax document value the migration sends.', 'PFTAG7012' FROM DUAL UNION ALL
    SELECT 'FAT-016', 'FAT-016_FFI_EIN_MISMATCH', 'CROSS_SYSTEM_MISMATCH', 'The FFI EIN of the FATCA record in PROFITS differs from the HUB tax document value the migration sends.', 'PFTAG7013' FROM DUAL UNION ALL
    SELECT 'FAT-017', 'FAT-017_QI_EIN_MISMATCH', 'CROSS_SYSTEM_MISMATCH', 'The QI EIN of the FATCA record in PROFITS differs from the HUB tax document value the migration sends.', 'PFTAG7014' FROM DUAL UNION ALL
    SELECT 'FAT-018', 'FAT-018_FIELD_ROW_COUNT_MISMATCH', 'EXISTENCE', 'FATCA field rows in PROFITS per customer and field that are missing or more than the migration loads (one per HUB W8 document).', 'TAG_ROWS' FROM DUAL UNION ALL
    SELECT 'FAT-019', 'FAT-019_DOCUMENTS_NOT_W8', 'INFO', 'Information only: HUB tax documents of another type than W8, which the migration does not load as FATCA. No detail rows.', 'TX_ALL' FROM DUAL UNION ALL
    SELECT 'FAT-020', 'FAT-020_W8_WITH_EXPIRY_DATE', 'INFO', 'Information only: HUB W8 documents with an expiry date, which the migration does not load. No detail rows.', 'W8_ALL' FROM DUAL UNION ALL
    SELECT 'FAT-021', 'FAT-021_W8_NOT_ACTIVE', 'INFO', 'Information only: HUB W8 documents with no expiry date that are not flagged active, which the migration does not load. No detail rows.', 'W8_ALL' FROM DUAL UNION ALL
    SELECT 'FAT-022', 'FAT-022_CUSTOMERS_WITH_SEVERAL_W8', 'INFO', 'Information only: HUB customers with more than one selected W8 document; the migration loads the FATCA fields once per document. No detail rows.', 'HUB_CUST' FROM DUAL UNION ALL
    SELECT 'FAT-023', 'FAT-023_HUB_FIELDS_NOT_MIGRATED', 'INFO', 'Information only: selected HUB W8 documents with other tax document fields set that the migration does not load. No detail rows.', 'SC_ROWS' FROM DUAL
),
FINDINGS_COUNT AS (
    SELECT CHECK_ID, COUNT(*) AS INVALID_COUNT
    FROM (SELECT SUBSTR(CHECK_NAME, 1, INSTR(CHECK_NAME, '_') - 1) AS CHECK_ID FROM FINDINGS)
    GROUP BY CHECK_ID
    UNION ALL
    -- INFO, μόνο Master (χωρίς γραμμές στο Detail)
    SELECT 'FAT-019', COUNT(*) FROM R_TX WHERE NVL(DTY, '#') &lt;&gt; 'W8' -- INFO
    UNION ALL
    SELECT 'FAT-020', COUNT(*) FROM R_TX WHERE DTY = 'W8' AND NVL(DDE, '#') &lt;&gt; '99999999' -- INFO
    UNION ALL
    SELECT 'FAT-021', COUNT(*) FROM R_TX WHERE DTY = 'W8' AND DDE = '99999999' AND NVL(AIFL, '#') &lt;&gt; 'Y' -- INFO
    UNION ALL
    SELECT 'FAT-022', COUNT(*) FROM TSC WHERE NH &gt; 1 -- INFO
    UNION ALL
    SELECT 'FAT-023', COUNT(*) FROM R_TX WHERE SC = 1 AND NOTGT = 1 -- INFO
)
SELECT
    CAST(CM.CHECK_ID AS VARCHAR2(10)) AS CHECK_ID,
    CAST(CM.CHECK_NAME AS VARCHAR2(50)) AS CHECK_NAME,
    CAST(CM.CATEGORY AS VARCHAR2(30)) AS CATEGORY,
    CAST(CM.DESCRIPTION AS VARCHAR2(200)) AS DESCRIPTION,
    NVL(P.CNT, 0) AS TOTAL_RECORDS,
    NVL(P.CNT, 0) - NVL(FC.INVALID_COUNT, 0) AS VALID_COUNT,
    NVL(FC.INVALID_COUNT, 0) AS INVALID_COUNT,
    CASE WHEN CM.CATEGORY = 'INFO'           THEN 'INFO'
         WHEN NVL(FC.INVALID_COUNT, 0) = 0   THEN 'PASS'
         ELSE 'FAIL' END AS STATUS,
    'DC5' AS DC_VERSION,
    1 AS RUN_VERSION,  -- TESTING ONLY: στο SSIS αντικαθίσταται από @[User::RunVersion] μέσω Derived Column.
    SYSDATE AS RUN_TIMESTAMP
FROM CHECK_META CM
LEFT JOIN POPS P ON P.POPULATION_TYPE = CM.POPULATION_TYPE
LEFT JOIN FINDINGS_COUNT FC ON FC.CHECK_ID = CM.CHECK_ID
ORDER BY REGEXP_SUBSTR(CM.CHECK_ID, '[A-Z]+'), TO_NUMBER(REGEXP_SUBSTR(CM.CHECK_ID, '[0-9]+'));</property>
