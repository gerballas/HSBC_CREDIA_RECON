                          codePage="1253"
                          dataType="str"
                          externalMetadataColumnId="Package\Sequence Container\Customers_Detail\Customers_detail.Outputs[Oracle Source Output].ExternalColumns[SERIAL_NO]"
                          length="30"
                          lineageId="Package\Sequence Container\Customers_Detail\Customers_detail.Outputs[Oracle Source Output].Columns[SERIAL_NO]"
                          name="SERIAL_NO" />
                        <outputColumn
                          refId="Package\Sequence Container\Customers_Detail\Customers_detail.Outputs[Oracle Source Output].Columns[HUB_VALUE]"
                          codePage="1253"
                          dataType="str"
                          externalMetadataColumnId="Package\Sequence Container\Customers_Detail\Customers_detail.Outputs[Oracle Source Output].ExternalColumns[HUB_VALUE]"
                          length="100"
                          lineageId="Package\Sequence Container\Customers_Detail\Customers_detail.Outputs[Oracle Source Output].Columns[HUB_VALUE]"
                          name="HUB_VALUE" />
                        <outputColumn
                          refId="Package\Sequence Container\Customers_Detail\Customers_detail.Outputs[Oracle Source Output].Columns[NCIS_VALUE]"
                          codePage="1253"
                          dataType="str"
                          externalMetadataColumnId="Package\Sequence Container\Customers_Detail\Customers_detail.Outputs[Oracle Source Output].ExternalColumns[NCIS_VALUE]"
                          length="100"
                          lineageId="Package\Sequence Container\Customers_Detail\Customers_detail.Outputs[Oracle Source Output].Columns[NCIS_VALUE]"
                          name="NCIS_VALUE" />
                        <outputColumn
                          refId="Package\Sequence Container\Customers_Detail\Customers_detail.Outputs[Oracle Source Output].Columns[ISSUE]"
                          codePage="1253"
                          dataType="str"
                          externalMetadataColumnId="Package\Sequence Container\Customers_Detail\Customers_detail.Outputs[Oracle Source Output].ExternalColumns[ISSUE]"
