                      expressionType="Notify"
                      name="PrefetchCount">0</property>
                    <property
                      dataType="System.Int32"
                      description="The mode used to access the database."
                      name="AccessMode"
                      typeConverter="AccessMode">1</property>
                  </properties>
                  <connections>
                    <connection
                      refId="Package\Sequence Container\Bank_Drafts_Detail\Bank_Drafts_detail.Connections[ORACLEConnection]"
                      connectionManagerID="{ECA91632-834F-4B2F-85DF-6CA637347F58}:external"
                      connectionManagerRefId="Project.ConnectionManagers[PRE Connection Manager]"
                      description="The ORACLE runtime connection used to access the database."
                      name="ORACLEConnection" />
                  </connections>
                  <outputs>
                    <output
                      refId="Package\Sequence Container\Bank_Drafts_Detail\Bank_Drafts_detail.Outputs[Oracle Source Output]"
                      errorRowDisposition="FailComponent"
                      name="Oracle Source Output"
                      truncationRowDisposition="FailComponent">
                      <outputColumns>
                        <outputColumn
                          refId="Package\Sequence Container\Bank_Drafts_Detail\Bank_Drafts_detail.Outputs[Oracle Source Output].Columns[CHECK_ID]"
                          codePage="1253"
                          dataType="str"
                          externalMetadataColumnId="Package\Sequence Container\Bank_Drafts_Detail\Bank_Drafts_detail.Outputs[Oracle Source Output].ExternalColumns[CHECK_ID]"
                          length="10"
                          lineageId="Package\Sequence Container\Bank_Drafts_Detail\Bank_Drafts_detail.Outputs[Oracle Source Output].Columns[CHECK_ID]"
                          name="CHECK_ID" />
                        <outputColumn
                          refId="Package\Sequence Container\Bank_Drafts_Detail\Bank_Drafts_detail.Outputs[Oracle Source Output].Columns[CHECK_NAME]"
                          codePage="1253"
                          dataType="str"
                          externalMetadataColumnId="Package\Sequence Container\Bank_Drafts_Detail\Bank_Drafts_detail.Outputs[Oracle Source Output].ExternalColumns[CHECK_NAME]"
                          length="50"
