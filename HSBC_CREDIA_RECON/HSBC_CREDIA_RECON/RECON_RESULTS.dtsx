        <DTS:Executable
          DTS:refId="Package\Sequence Container\Bank_Drafts_Master"
          DTS:CreationName="Microsoft.Pipeline"
          DTS:Description="Data Flow Task"
          DTS:DTSID="{518e7d49-bc5e-4ced-8cab-2e94e301683f}"
          DTS:ExecutableType="Microsoft.Pipeline"
          DTS:LocaleID="-1"
          DTS:ObjectName="Bank_Drafts_Master"
          DTS:TaskContact="Performs high-performance data extraction, transformation and loading;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1">
          <DTS:Variables />
          <DTS:ObjectData>
            <pipeline
              version="1">
              <components>
                <component
                  refId="Package\Sequence Container\Bank_Drafts_Master\Bank_Drafts_master"
                  componentClassID="Microsoft.SSISOracleSrc"
                  contactInfo="Oracle Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;1"
                  description="Oracle Source"
                  name="Bank_Drafts_master"
                  usesDispositions="true"
                  version="1">
                  <properties>
                    <property
                      dataType="System.String"
                      description="The name of the table to be fetched."
                      expressionType="Notify"
                      name="TableName"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      expressionType="Notify"
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">-- ====================================================================
-- BD_RECON — MASTER DC5 v1 (Bank Drafts - HSBC cashier orders)
-- Τροφοδοτεί: RECON.BD_RECON_MASTER (όνομα πίνακα προς επιβεβαίωση: δεν υπάρχει ακόμη στο
-- SSIS scripts\Recon_tables.sql)
-- Μία γραμμή ΑΝΑ CHECK_ID — 14 γραμμές ανά run: BD-001 .. BD-014.
--
-- Bank Drafts (ME01 HUB, EIM 240825, DD v1.24): HUB OR@COMSP vs PROFITS INCOMING_DRAFTS. Οι τιμές PROFITS διαβάζονται
-- απευθείας από το INCOMING_DRAFTS (απόφαση χρήστη 2026-11-17): το NCIS extract 06_BANK_DRAFTS.sql (NCIS_ΒΑΝΚ_DRAFTS,
-- ΠΡΟΣΟΧΗ: «ΒΑΝΚ» με ελληνικούς χαρακτήρες) είναι προβολή 5 στηλών του ίδιου πίνακα. Οι στήλες λέγονται NCIS_VALUE για
-- συμβατότητα με το template.
-- Migration scripts: ΜΟΝΟ Migration Scripts\20261116_MigrationScripts (35000_BankDrafts = 61000 του DC4 + DMOD 100,
-- 35005_BankDraftsExceptions ΝΕΟ, 90001, 90000). Διαφορές DC4 -&gt; DC5: DC5\DC4_vs_DC5_MigrationScripts_BankDrafts_Diff_Report.md.
-- Μορφή Master/Detail όπως το MasterFATCA_DC5_v1.sql:
--   - ένα αυτοτελές SELECT, χωρίς views / πίνακες HGR_* (το DC4 recon χρειαζόταν τα views v_reconciliation_bank_drafts* και
--     τον πίνακα HGR_BD_RECON_STAGING). Το κοινό κομμάτι και το FINDINGS είναι ΙΔΙΑ αυτούσια στο DetailBankDrafts_DC5_v1.sql
--     -&gt; INVALID_COUNT = γραμμές του Detail ανά CHECK_ID. Τα INFO checks (BD-011 .. BD-014) υπολογίζονται μόνο εδώ.
--   - Παράγεται από τον generator (_generator\build.sh): bd_master_head + bd_common + bd_master_tail.
--   - HUB από synonym σε DB link @Malta (10098): HUB_MT_ORCOMSP, ΜΙΑ ανάγνωση σε CTE R_OR.
--
-- ΑΡΧΗ: αναμενόμενη τιμή ΜΟΝΟ από τα scripts (35000 / 35005 / 90001):
--   - Scope: όλες οι γραμμές ORCOMSP (35000 χωρίς WHERE, χωρίς φίλτρο shadow / αντιλογισμού / status).
--   - Κλειδί HUB -&gt; PROFITS (απόφαση χρήστη 2026-11-17): TO_NUMBER(BANK_DRAFT_NO) = αριθμός HUB (ψηφία του
--     SUBSTR(ORTRNO,3,12)) ή RPAD(branch,4,'0') || αριθμός (35005, διπλοί αριθμοί). Ζεύγος ένα προς ένα, πρώτα ίδιο ποσό,
--     μετά ίδιο branch. Στο DC4 το loader έδινε νέο αριθμό και το DC4 recon συνέδεε με τη σειρά φόρτωσης. Αν το loader
--     εξακολουθεί να δίνει νέο αριθμό, το BD-001 / 002 θα αποτύχουν σε όλα.
--   - Ποσό ORCOAM / 100. Νόμισμα CURRENCY.ID_CURRENCY του ORCOCY. Branch ORBRNO. Ημερομηνία ORCPDT (μη έγκυρη μέρα -&gt;
--     τελευταία του μήνα). Issuer ORPCNM (30). Beneficiary ORBEA1..4 (80) vs BENEF_LONG_NAME.
--   - Status: O -&gt; 1, S -&gt; 7, ' ' -&gt; 7. Χωρίς κανόνα (P, κενό) -&gt; FAIL NO_MAPPING (BD-009, όπως DC4 BD-014).
--   - Αντιλογισμένα (ORRVCD = Y) ενεργά -&gt; FAIL (BD-010): κανόνας του DC4 review (BD-015), όχι του script.
--   - HUB_VALUE = τιμή HUB, NCIS_VALUE = τιμή PROFITS, αναμενόμενη τιμή στο ISSUE.
--   - Detail: CUSTOMER_CODE = αριθμός draft HUB (το ORCOMSP δεν έχει πελάτη), SERIAL_NO = αριθμός / branch / BANK_DRAFT_NO.
--
-- ΑΝΤΙΣΤΟΙΧΙΑ με το DC4 Bank_Drafts_recon.sql (BD-001..020, archive Scripts\Archived\BankDrafts_20261117):
--   002 + 004 + 005 -&gt; 001 | 003 -&gt; 002 (PROFITS χωρίς HUB) | 007 -&gt; 003 | 008 -&gt; 004 | 009 -&gt; 005 | 010 -&gt; 006
--   011 -&gt; 007 | 012 + 020 -&gt; 008 | 013 + 014 -&gt; 009 | 015 -&gt; 010 | 017 -&gt; 011 (INFO) | 018 -&gt; 012 (INFO)
--   Νέα: 013 (shadow), 014 (αριθμός με πρόθεμα branch, 35005).
--   Αφαιρέθηκαν: 001 (μοναδικότητα κλειδιού του DC4), 006 (κλειδί σειράς φόρτωσης), 016 (ο αριθμός του HUB: καλύπτεται από
--   το κλειδί του 001 / 002), 019 (κατανομή status: καλύπτεται από 009 / 010).
--
-- STATUS: PASS (INVALID_COUNT = 0) / FAIL / INFO. DESCRIPTION: απλή περιγραφή χωρίς κωδικούς.
--
-- TOTAL_RECORDS ανά POPULATION_TYPE:
--   HUB_ALL = όλες οι γραμμές ORCOMSP   PROF = γραμμές INCOMING_DRAFTS   MATCHED = ζεύγη HUB / PROFITS
--   MATCHED_REV = ζεύγη με ORRVCD = Y   HUB_O = γραμμές HUB με ORDSTS = O
-- ====================================================================
WITH
-- --------------------------------------------------------------------
-- Κοινό κομμάτι (ΙΔΙΟ αυτούσιο στο Master και στο Detail).
--   R_OR   = HUB_MT_ORCOMSP (synonym @Malta, 10098): ΜΙΑ ανάγνωση, όλες οι γραμμές (35000: χωρίς WHERE), με τις
--            αναμενόμενες τιμές όπως τις βγάζει το 35000:
--            NO   = αριθμός draft: TRIM(SUBSTR(ORTRNO,3,12)) μόνο τα ψηφία (35000 UPDATE REGEXP_REPLACE)
--            N1   = TO_NUMBER(NO) (μοναδικός αριθμός), N2 = TO_NUMBER(RPAD(branch,4,'0') || NO) (35005: διπλός αριθμός)
--            AMT  = ORCOAM / 100, UNIT = TO_NUMBER(ORBRNO), ISS_D = ORCPDT (μη έγκυρη μέρα -&gt; τελευταία του μήνα),
--            ISS  = ORPCNM (30), BEN = ORBEA1..4 (80), X_ST = status του 35000 (O -&gt; 1, S -&gt; 7, ' ' -&gt; 7, αλλιώς κενό).
--   CUR    = CURRENCY ανά κωδικό.  STG = MG_FT_OBJ_INTER BANK_DRAFTS (μόνο για την αιτία στο BD-001).
--   PR     = INCOMING_DRAFTS (PN = TO_NUMBER(BANK_DRAFT_NO)). Το NCIS extract 06_BANK_DRAFTS είναι προβολή του ίδιου πίνακα.
--   CAND   = ζεύγη HUB / PROFITS με PN = N1 ή N2. PAIR = ένα προς ένα (καλύτερο ζεύγος για τη γραμμή HUB ΚΑΙ για τη
--            γραμμή PROFITS, πρώτα ίδιο ποσό, μετά ίδιο branch). Απόφαση χρήστη 2026-11-17 (DC4: σειρά φόρτωσης).
--   B      = HUB + PROFITS του ζεύγους + αναμενόμενες τιμές.
-- --------------------------------------------------------------------
R_OR AS (
    SELECT /*+ MATERIALIZE */
           ROW_NUMBER() OVER (ORDER BY ORTRNO, ORBRNO, ORCOAM, ORCPDT, ORPCNM)       AS HID,
           TRIM(REGEXP_REPLACE(TRIM(SUBSTR(ORTRNO, 3, 12)), '[^0-9]', ''))           AS NO,
           ORCOAM / 100                                                              AS AMT,
           TO_NUMBER(TRIM(ORBRNO))                                                   AS UNIT,
           TRIM(ORCOCY)                                                              AS CCY,
           CASE VALIDATE_CONVERSION(SUBSTR(TO_CHAR(ORCPDT), 1, 8) AS DATE, 'YYYYMMDD')
                WHEN 1 THEN TO_DATE(SUBSTR(TO_CHAR(ORCPDT), 1, 8), 'YYYYMMDD')
                WHEN 0 THEN LAST_DAY(TO_DATE(SUBSTR(TO_CHAR(ORCPDT), 1, 6) || '01' DEFAULT NULL ON CONVERSION ERROR, 'YYYYMMDD'))
           END                                                                       AS ISS_D,
           TRIM(TO_CHAR(ORCPDT))                                                     AS CPDT,
           TRIM(SUBSTR(TRIM(ORPCNM), 1, 30))                                         AS ISS,
           TRIM(SUBSTR(TRIM(ORBEA1) || TRIM(ORBEA2) || TRIM(ORBEA3) || TRIM(ORBEA4), 1, 80)) AS BEN,
           ORDSTS                                                                    AS DSTS,
           TRIM(ORRVCD)                                                              AS RVCD,
           TRIM(ORMDFL)                                                              AS MDFL,
           CASE WHEN ORDSTS = 'O' THEN '1' WHEN ORDSTS = 'S' THEN '7' WHEN ORDSTS = ' ' THEN '7' END AS X_ST
      FROM HUB_MT_ORCOMSP
),
H AS (
    SELECT /*+ MATERIALIZE */
           r.*,
           TO_NUMBER(r.NO DEFAULT NULL ON CONVERSION ERROR)                                    AS N1,
           TO_NUMBER(RPAD(TO_CHAR(r.UNIT), 4, '0') || r.NO DEFAULT NULL ON CONVERSION ERROR)   AS N2,
           COUNT(*) OVER (PARTITION BY r.NO)                                                   AS N_SAME
      FROM R_OR r
),
CUR AS (
    SELECT TRIM(SHORT_DESCR) AS CCY, MIN(ID_CURRENCY) AS CID FROM CURRENCY GROUP BY TRIM(SHORT_DESCR)
),
STG AS (
    SELECT /*+ MATERIALIZE */
           TRIM(FT_OBJ_NO) AS NO, MG_FT_OBJ_AMNT AS AMT, MG_FT_OBJ_ISS_UNIT AS UNIT,
           TRIM(MG_FT_OBJ_ISSUER) AS ISS, TRIM(MG_FT_OBJ_BENEF) AS BEN,
           TRIM(TO_CHAR(FT_STATUS)) AS ST, TRIM(FT_ERR_DESC) AS ERR
      FROM MG_FT_OBJ_INTER
     WHERE TRIM(FILE_NAME) = 'BANK_DRAFTS'
),
PR AS (
    SELECT /*+ MATERIALIZE */
           ROWIDTOCHAR(ROWID) AS RID,
           TRIM(BANK_DRAFT_NO) AS BDN,
           TO_NUMBER(TRIM(BANK_DRAFT_NO) DEFAULT NULL ON CONVERSION ERROR) AS PN,
           DRAFT_AMOUNT AS AMT, FK0UNITCODE AS UNIT, FK_CURRENCYID_CURR AS CID,
           TRUNC(ISSUE_RECEIPT_DATE) AS ISS_D, TRIM(ENTRY_STATUS) AS ST,
           TRIM(ISSUER_NAME) AS ISS, TRIM(BENEF_NAME) AS BENS, TRIM(BENEF_LONG_NAME) AS BENL
      FROM INCOMING_DRAFTS
),
CAND AS (
    SELECT /*+ MATERIALIZE */
           h.HID, p.RID,
           ROW_NUMBER() OVER (PARTITION BY h.HID ORDER BY CASE WHEN p.AMT = h.AMT THEN 0 ELSE 1 END,
                                                          CASE WHEN p.UNIT = h.UNIT THEN 0 ELSE 1 END, p.RID) AS RH,
           ROW_NUMBER() OVER (PARTITION BY p.RID ORDER BY CASE WHEN p.AMT = h.AMT THEN 0 ELSE 1 END,
                                                          CASE WHEN p.UNIT = h.UNIT THEN 0 ELSE 1 END, h.HID) AS RP
      FROM H h
      JOIN PR p ON p.PN = h.N1 OR p.PN = h.N2
),
PAIR AS (
    SELECT HID, RID FROM CAND WHERE RH = 1 AND RP = 1
),
B AS (
    SELECT /*+ MATERIALIZE */
           h.*, c.CID AS X_CID,
           p.RID, p.BDN, p.PN, p.AMT AS P_AMT, p.UNIT AS P_UNIT, p.CID AS P_CID, p.ISS_D AS P_ISS_D, p.ST AS P_ST,
           p.ISS AS P_ISS, p.BENS AS P_BENS, p.BENL AS P_BENL,
           h.NO || ' / BR ' || h.UNIT || CASE WHEN p.BDN IS NOT NULL THEN ' / ' || p.BDN END AS SKEY
      FROM H h
      LEFT JOIN CUR c  ON c.CCY = h.CCY
      LEFT JOIN PAIR x ON x.HID = h.HID
      LEFT JOIN PR p   ON p.RID = x.RID
),
FINDINGS AS (
    -- Μία γραμμή ανά εύρημα. CUSTOMER_CODE = αριθμός draft του HUB (δεν υπάρχει πελάτης στο ORCOMSP), SERIAL_NO =
    -- αριθμός HUB / branch / BANK_DRAFT_NO. HUB_VALUE = τιμή HUB, NCIS_VALUE = τιμή PROFITS (INCOMING_DRAFTS).
    -- Αναμενόμενη τιμή (μόνο από τα scripts, ή κανόνας του DC4 review όπου σημειώνεται) στο ISSUE.
    --==============================================================
    --BD-001. Cashier order του HUB χωρίς draft στο INCOMING_DRAFTS. ISSUE = αιτία από το MG_FT_OBJ_INTER.
    SELECT
      CAST('BD-001_DRAFT_MISSING_IN_PROFITS' AS VARCHAR2(50)) AS CHECK_NAME,
      CAST(b.NO AS VARCHAR2(40)) AS CUSTOMER_CODE,
      CAST(b.SKEY AS VARCHAR2(40)) AS SERIAL_NO,
      CAST(SUBSTR('AMOUNT=' || b.AMT || ' ' || b.CCY || '; ORDSTS=' || NVL(TRIM(b.DSTS), 'BLANK') || '; ISSUER=' || NVL(b.ISS, 'BLANK'), 1, 200) AS VARCHAR2(200)) AS HUB_VALUE,
      CAST(NULL AS VARCHAR2(200)) AS NCIS_VALUE,
      CAST(SUBSTR(NVL((SELECT CASE WHEN MIN(s.ST) = '2' THEN 'REJECTED: ' || NVL(MIN(s.ERR), '-')
                                   ELSE 'STAGED (FT_STATUS ' || MIN(s.ST) || '), NOT IN INCOMING_DRAFTS' END
                         FROM STG s
                        WHERE s.AMT = b.AMT AND s.UNIT = b.UNIT
                          AND NVL(s.ISS, '~') = NVL(b.ISS, '~') AND NVL(s.BEN, '~') = NVL(b.BEN, '~')
                          AND (s.NO = b.NO OR s.NO = RPAD(TO_CHAR(b.UNIT), 4, '0') || b.NO)
                       HAVING COUNT(*) &gt; 0), 'NOT IN MG_FT_OBJ_INTER'), 1, 50) AS VARCHAR2(50)) AS ISSUE
    FROM B b
    WHERE b.RID IS NULL
    UNION ALL
    --==============================================================
    --BD-002. Draft στο INCOMING_DRAFTS που δεν είναι cashier order του HUB.
    SELECT 'BD-002_DRAFT_MISSING_IN_HUB', CAST(NULL AS VARCHAR2(40)), 'PROFITS ' || p.BDN,
           CAST(NULL AS VARCHAR2(200)),
           SUBSTR('AMOUNT=' || p.AMT || '; BRANCH=' || p.UNIT || '; STATUS=' || p.ST, 1, 200),
           CASE WHEN EXISTS (SELECT 1 FROM CAND c WHERE c.RID = p.RID) THEN 'HUB NUMBER MATCHED TO ANOTHER DRAFT'
                ELSE 'NOT IN HUB ORCOMSP' END
    FROM PR p
    WHERE NOT EXISTS (SELECT 1 FROM PAIR x WHERE x.RID = p.RID)
    UNION ALL
    --==============================================================
    --BD-003. DRAFT_AMOUNT vs ORCOAM / 100.
    SELECT 'BD-003_AMOUNT_MISMATCH', b.NO, b.SKEY,
           TO_CHAR(b.AMT) || ' ' || b.CCY, TO_CHAR(b.P_AMT),
           SUBSTR('MISMATCH (EXPECTED ' || TO_CHAR(b.AMT) || ')', 1, 50)
    FROM B b
    WHERE b.RID IS NOT NULL AND NVL(b.P_AMT, -1) &lt;&gt; NVL(b.AMT, -1)
    UNION ALL
    --==============================================================
    --BD-004. FK_CURRENCYID_CURR vs ORCOCY (CURRENCY.SHORT_DESCR -&gt; ID_CURRENCY).
    SELECT 'BD-004_CURRENCY_MISMATCH', b.NO, b.SKEY,
           b.CCY, TO_CHAR(b.P_CID),
           SUBSTR('MISMATCH (EXPECTED ' || NVL(TO_CHAR(b.X_CID), 'NO CURRENCY') || ')', 1, 50)
    FROM B b
    WHERE b.RID IS NOT NULL AND NVL(b.P_CID, -1) &lt;&gt; NVL(b.X_CID, -2)
    UNION ALL
    --==============================================================
    --BD-005. FK0UNITCODE (branch έκδοσης) vs ORBRNO.
    SELECT 'BD-005_BRANCH_MISMATCH', b.NO, b.SKEY,
           TO_CHAR(b.UNIT), TO_CHAR(b.P_UNIT),
           SUBSTR('MISMATCH (EXPECTED ' || TO_CHAR(b.UNIT) || ')', 1, 50)
    FROM B b
    WHERE b.RID IS NOT NULL AND NVL(b.P_UNIT, -1) &lt;&gt; NVL(b.UNIT, -1)
    UNION ALL
    --==============================================================
    --BD-006. ISSUE_RECEIPT_DATE vs ORCPDT (μη έγκυρη μέρα -&gt; τελευταία του μήνα, 35000).
    SELECT 'BD-006_ISSUE_DATE_MISMATCH', b.NO, b.SKEY,
           b.CPDT, TO_CHAR(b.P_ISS_D, 'YYYY-MM-DD'),
           'MISMATCH (EXPECTED ' || NVL(TO_CHAR(b.ISS_D, 'YYYY-MM-DD'), 'EMPTY') || ')'
    FROM B b
    WHERE b.RID IS NOT NULL AND NVL(b.P_ISS_D, DATE '0001-01-01') &lt;&gt; NVL(TRUNC(b.ISS_D), DATE '0001-01-01')
    UNION ALL
    --==============================================================
    --BD-007. ISSUER_NAME vs ORPCNM (πρώτοι 30 χαρακτήρες).
    SELECT 'BD-007_ISSUER_NAME_MISMATCH', b.NO, b.SKEY,
           b.ISS, b.P_ISS,
           SUBSTR('MISMATCH (EXPECTED ' || NVL(b.ISS, 'EMPTY') || ')', 1, 50)
    FROM B b
    WHERE b.RID IS NOT NULL AND NVL(b.P_ISS, '~') &lt;&gt; NVL(b.ISS, '~')
    UNION ALL
    --==============================================================
    --BD-008. BENEF_LONG_NAME vs ORBEA1..4 (35000: έως 80 χαρακτήρες).
    SELECT 'BD-008_BENEFICIARY_MISMATCH', b.NO, b.SKEY,
           SUBSTR(b.BEN, 1, 200), SUBSTR(b.P_BENL, 1, 200),
           CASE WHEN b.P_BENL IS NOT NULL AND b.P_BENL = TRIM(SUBSTR(b.BEN, 1, LENGTH(b.P_BENL)))
                THEN SUBSTR('TRUNCATED TO ' || LENGTH(b.P_BENL) || ' (HUB ' || LENGTH(b.BEN) || ')', 1, 50)
                ELSE 'MISMATCH (EXPECTED HUB BENEFICIARY, 80 CHARS)' END
    FROM B b
    WHERE b.RID IS NOT NULL AND NVL(b.P_BENL, '~') &lt;&gt; NVL(b.BEN, '~')
    UNION ALL
    --==============================================================
    --BD-009. ENTRY_STATUS vs status του 35000 (O -&gt; 1, S -&gt; 7, ' ' -&gt; 7). Χωρίς κανόνα (π.χ. P) -&gt; NO_MAPPING.
    SELECT 'BD-009_STATUS_MISMATCH', b.NO, b.SKEY,
           'ORDSTS=' || NVL(TRIM(b.DSTS), 'BLANK') || '; ORRVCD=' || NVL(b.RVCD, 'BLANK'), b.P_ST,
           CASE WHEN b.X_ST IS NULL THEN SUBSTR('NO_MAPPING (SENT EMPTY FOR ' || NVL(TRIM(b.DSTS), 'BLANK') || ')', 1, 50)
                ELSE 'MISMATCH (EXPECTED ' || b.X_ST || ')' END
    FROM B b
    WHERE b.RID IS NOT NULL AND (b.X_ST IS NULL OR NVL(b.P_ST, '~') &lt;&gt; b.X_ST)
    UNION ALL
    --==============================================================
    --BD-010. Αντιλογισμένο cashier order (ORRVCD = Y) ενεργό στο PROFITS (ENTRY_STATUS &lt;&gt; 0).
    --        Κανόνας του DC4 review (BD-015), όχι του 35000.
    SELECT 'BD-010_REVERSED_DRAFT_LIVE', b.NO, b.SKEY,
           'ORRVCD=Y; ORDSTS=' || NVL(TRIM(b.DSTS), 'BLANK'), b.P_ST,
           'LIVE IN PROFITS (EXPECTED 0, DC4 REVIEW RULE)'
    FROM B b
    WHERE b.RID IS NOT NULL AND b.RVCD = 'Y' AND NVL(b.P_ST, '~') &lt;&gt; '0'
)
,
POPS AS (
    SELECT 'HUB_ALL' AS POPULATION_TYPE, COUNT(*) AS CNT FROM H
    UNION ALL SELECT 'PROF', COUNT(*) FROM PR
    UNION ALL SELECT 'MATCHED', COUNT(*) FROM B WHERE RID IS NOT NULL
    UNION ALL SELECT 'MATCHED_REV', COUNT(*) FROM B WHERE RID IS NOT NULL AND RVCD = 'Y'
    UNION ALL SELECT 'HUB_O', COUNT(*) FROM H WHERE DSTS = 'O'
),
CHECK_META AS (
    -- CHECK_ID | CHECK_NAME | CATEGORY | DESCRIPTION | POPULATION_TYPE
    SELECT 'BD-001' AS CHECK_ID, 'BD-001_DRAFT_MISSING_IN_PROFITS' AS CHECK_NAME, 'EXISTENCE' AS CATEGORY, 'HUB cashier orders that are not in PROFITS as bank drafts. The detail rows give the reason from the migration staging table.' AS DESCRIPTION, 'HUB_ALL' AS POPULATION_TYPE FROM DUAL UNION ALL
    SELECT 'BD-002', 'BD-002_DRAFT_MISSING_IN_HUB',        'EXISTENCE',             'Bank drafts in PROFITS that are not HUB cashier orders.', 'PROF' FROM DUAL UNION ALL
    SELECT 'BD-003', 'BD-003_AMOUNT_MISMATCH',             'CROSS_SYSTEM_MISMATCH', 'The draft amount in PROFITS differs from the HUB cashier order amount, in currency units.', 'MATCHED' FROM DUAL UNION ALL
    SELECT 'BD-004', 'BD-004_CURRENCY_MISMATCH',           'CROSS_SYSTEM_MISMATCH', 'The draft currency in PROFITS differs from the HUB cashier order currency.', 'MATCHED' FROM DUAL UNION ALL
    SELECT 'BD-005', 'BD-005_BRANCH_MISMATCH',             'CROSS_SYSTEM_MISMATCH', 'The issuing branch in PROFITS differs from the HUB cashier order branch.', 'MATCHED' FROM DUAL UNION ALL
    SELECT 'BD-006', 'BD-006_ISSUE_DATE_MISMATCH',         'CROSS_SYSTEM_MISMATCH', 'The issue date in PROFITS differs from the HUB capture date the migration sends (last day of the month when the day is not valid).', 'MATCHED' FROM DUAL UNION ALL
    SELECT 'BD-007', 'BD-007_ISSUER_NAME_MISMATCH',        'CROSS_SYSTEM_MISMATCH', 'The issuer name in PROFITS differs from the HUB purchaser name (first 30 characters).', 'MATCHED' FROM DUAL UNION ALL
    SELECT 'BD-008', 'BD-008_BENEFICIARY_MISMATCH',        'CROSS_SYSTEM_MISMATCH', 'The beneficiary long name in PROFITS differs from the four HUB beneficiary lines joined (up to 80 characters).', 'MATCHED' FROM DUAL UNION ALL
    SELECT 'BD-009', 'BD-009_STATUS_MISMATCH',             'CROSS_SYSTEM_MISMATCH', 'The draft status in PROFITS differs from the status the migration sets from the HUB status, or the migration has no status for the HUB status.', 'MATCHED' FROM DUAL UNION ALL
    SELECT 'BD-010', 'BD-010_REVERSED_DRAFT_LIVE',         'CROSS_SYSTEM_MISMATCH', 'Reversed HUB cashier orders held as live drafts in PROFITS. Explained in the DC4 review, not a migration script rule.', 'MATCHED_REV' FROM DUAL UNION ALL
    SELECT 'BD-011', 'BD-011_DUPLICATE_HUB_NUMBERS',       'INFO',                  'Information only: HUB cashier orders sharing their draft number with another order (rows beyond the first per number). No detail rows.', 'HUB_ALL' FROM DUAL UNION ALL
    SELECT 'BD-012', 'BD-012_OLD_OUTSTANDING_ORDERS',      'INFO',                  'Information only: outstanding HUB cashier orders issued more than five years before the migration date. Explained in the DC4 review. No detail rows.', 'HUB_O' FROM DUAL UNION ALL
    SELECT 'BD-013', 'BD-013_SHADOW_RECORDS',              'INFO',                  'Information only: HUB cashier orders that are shadow records. The migration does not filter them out. No detail rows.', 'HUB_ALL' FROM DUAL UNION ALL
    SELECT 'BD-014', 'BD-014_DRAFT_NUMBER_WITH_BRANCH',    'INFO',                  'Information only: drafts in PROFITS whose number is the branch followed by the HUB number, used by the migration for duplicate numbers. No detail rows.', 'MATCHED' FROM DUAL
),
FINDINGS_COUNT AS (
    SELECT CHECK_ID, COUNT(*) AS INVALID_COUNT
    FROM (SELECT SUBSTR(CHECK_NAME, 1, INSTR(CHECK_NAME, '_') - 1) AS CHECK_ID FROM FINDINGS)
    GROUP BY CHECK_ID
    UNION ALL
    -- INFO, μόνο Master (χωρίς γραμμές στο Detail)
    SELECT 'BD-011', COUNT(*) - COUNT(DISTINCT NO) FROM H WHERE N_SAME &gt; 1 -- INFO
    UNION ALL
    SELECT 'BD-012', COUNT(*) FROM H WHERE DSTS = 'O' AND ISS_D &lt; ADD_MONTHS((SELECT MAX(TRUNC(CURR_TRX_DATE)) FROM BANK_PARAMETERS), -60) -- INFO
    UNION ALL
    SELECT 'BD-013', COUNT(*) FROM H WHERE MDFL = 'S' -- INFO
    UNION ALL
    SELECT 'BD-014', COUNT(*) FROM B WHERE RID IS NOT NULL AND PN = N2 AND NVL(N1, -1) &lt;&gt; PN -- INFO
)
SELECT
    CAST(CM.CHECK_ID AS VARCHAR2(10)) AS CHECK_ID,
    CAST(CM.CHECK_NAME AS VARCHAR2(50)) AS CHECK_NAME,
    CAST(CM.CATEGORY AS VARCHAR2(30)) AS CATEGORY,
    CAST(CM.DESCRIPTION AS VARCHAR2(200)) AS DESCRIPTION,
    NVL(P.CNT, 0) AS TOTAL_RECORDS,
    NVL(P.CNT, 0) - NVL(FC.INVALID_COUNT, 0) AS VALID_COUNT,
    NVL(FC.INVALID_COUNT, 0) AS INVALID_COUNT,
    CASE WHEN CM.CATEGORY = 'INFO'           THEN 'INFO'
         WHEN NVL(FC.INVALID_COUNT, 0) = 0   THEN 'PASS'
         ELSE 'FAIL' END AS STATUS,
    'DC5' AS DC_VERSION,
    1 AS RUN_VERSION,  -- TESTING ONLY: στο SSIS αντικαθίσταται από @[User::RunVersion] μέσω Derived Column.
    SYSDATE AS RUN_TIMESTAMP
FROM CHECK_META CM
LEFT JOIN POPS P ON P.POPULATION_TYPE = CM.POPULATION_TYPE
LEFT JOIN FINDINGS_COUNT FC ON FC.CHECK_ID = CM.CHECK_ID
ORDER BY REGEXP_SUBSTR(CM.CHECK_ID, '[A-Z]+'), TO_NUMBER(REGEXP_SUBSTR(CM.CHECK_ID, '[0-9]+'));</property>
