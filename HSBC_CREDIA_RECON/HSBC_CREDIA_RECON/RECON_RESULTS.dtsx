        <DTS:Executable
          DTS:refId="Package\Sequence Container\Customer_Relations_Master"
          DTS:CreationName="Microsoft.Pipeline"
          DTS:Description="Data Flow Task"
          DTS:DTSID="{38774ded-6a9e-4b95-9246-f3a73d902c1c}"
          DTS:ExecutableType="Microsoft.Pipeline"
          DTS:LocaleID="-1"
          DTS:ObjectName="Customer_Relations_Master"
          DTS:TaskContact="Performs high-performance data extraction, transformation and loading;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1">
          <DTS:Variables />
          <DTS:ObjectData>
            <pipeline
              version="1">
              <components>
                <component
                  refId="Package\Sequence Container\Customer_Relations_Master\Customer_Relations_master"
                  componentClassID="Microsoft.SSISOracleSrc"
                  contactInfo="Oracle Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;1"
                  description="Oracle Source"
                  name="Customer_Relations_master"
                  usesDispositions="true"
                  version="1">
                  <properties>
                    <property
                      dataType="System.String"
                      description="The name of the table to be fetched."
                      expressionType="Notify"
                      name="TableName"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      expressionType="Notify"
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">-- ====================================================================
-- CUST_RELATION_RECON — MASTER DC5
-- Τροφοδοτεί: RECON.CUST_RELATION_MASTER
-- Μία γραμμή ΑΝΑ CHECK_ID — 8 γραμμές ανά run: CR-001 .. CR-008.
--
-- Customer Relations (ME01_HUB, EIM 240825): HUB SSCAIFP / SS@CAIFP vs PROFITS
-- RELATIONSHIP. Μορφή Master/Detail όπως οι Customers / Customer Addresses:
--   - ένα αυτοτελές SELECT. Το κοινό κομμάτι (CTEs) και το FINDINGS είναι ΙΔΙΑ
--     αυτούσια στο DetailCustomerRelations_DC5.sql -&gt; INVALID_COUNT = γραμμές Detail.
--   - Παράγεται από τον generator (_generator): cr_master_head + cr_common + cr_master_tail.
--   - HUB από τα HUB_MT_* synonyms (DB link @Malta): κάθε πίνακας ΜΙΑ φορά (R_*).
--   - Δεν υπάρχει NCIS extract για τις σχέσεις: πλευρά PROFITS = RELATIONSHIP
--     (FKCUST_HAS_AS_FIRS = αντιπρόσωπος, FKCUST_HAS_AS_SECO = εταιρεία, FK_RELATIONSHIPTYP).
--
-- ΑΡΧΗ: αναμενόμενη τιμή ΜΟΝΟ από τα scripts της μετάπτωσης:
--   - Σχέσεις που επιλέγει το 18000: τα δύο INSERT με τα ίδια φίλτρα (ZUCTCG όχι 2 / 7 / A / G,
--     CUSTOMER_CODE2 όχι -0-0, διαφορετικοί πελάτες πριν / μετά το joint redirect).
--   - Joint redirect: HGR_MG_JOINT (10200), όπως το διαβάζει το 18000 (απόφαση 2026-11-12).
--   - Τύπος: MG_CUST_RELATION.RELATION_TYPE (18000: τύπος 1 -&gt; 1 + υποτύπος SS@CAIFP, αλλιώς 10)
--     μεταφρασμένος με MG_PARAM_PARAMETER RELAT (10010 + catch-all REPRESENTS του 18000).
--   - Το 19800 σβήνει από το MG_CUST_RELATION τις γραμμές που απέρριψε η φόρτωση: γι' αυτό το
--     CR-001 συγκρίνει τις σχέσεις του HUB (κανόνας 18000) με το MG_CUST_RELATION.
--   - Πεδία HUB που το 18000 δεν μεταφέρει (CR-007 ημερομηνίες κηδεμονίας, CR-008 ποσοστό
--     beneficial owner): FAIL «not migrated», όπως το CGR-011 των Groups (απόφαση 2026-11-12).
--   - HUB_VALUE = τιμή HUB, NCIS_VALUE = τιμή PROFITS, αναμενόμενη τιμή στο ISSUE.
--
-- ΑΝΤΙΣΤΟΙΧΙΑ με το Cust_Relations_recon_v2.sql (REL-001..043):
--   REL-016 -&gt; CR-001 | REL-005 -&gt; CR-002 | REL-004 / 006 / 007 -&gt; CR-003 | REL-008 -&gt; CR-004
--   REL-009 / 010 -&gt; CR-005 | REL-018 -&gt; CR-006 | REL-026 -&gt; CR-007 | REL-027 -&gt; CR-008
--   Αφαιρέθηκαν: data quality / business / ρυθμίσεις / έλεγχοι μόνο PROFITS ή μόνο HUB
--   (REL-001, 002, 011-015, 017, 019-025, 028-043). Ο ξαναϋπολογισμός του 18000 και του
--   joint του v2 αντικαταστάθηκε από MG_CUST_RELATION / HGR_MG_JOINT.
--
-- DC4 -&gt; DC5: 18000 - ο τύπος 1 χωρίς υποτύπο γίνεται πλέον 10; 10010 - RELAT '1' αντικαταστάθηκε
-- από '10' -&gt; PARENT_CHILD. 12000 - SSCAIFP μόνο με ZUHUBN = N (ποιοι synthetic αντιπρόσωποι
-- φορτώνονται). 10200 / 10090 / 19800 deletes: ίδια. Το αναμενόμενο διαβάζεται τη στιγμή του run
-- (MG_CUST_RELATION, MG_PARAM_PARAMETER), οπότε οι αλλαγές περνούν χωρίς αλλαγή κώδικα.
--
-- STATUS: PASS (INVALID_COUNT = 0) / FAIL. DESCRIPTION: απλή περιγραφή χωρίς κωδικούς.
--
-- TOTAL_RECORDS ανά POPULATION_TYPE:
--   HUB_REL     = σχέσεις HUB που επιλέγει το 18000 (μετά το joint)
--   SENT        = σχέσεις στο MG_CUST_RELATION
--   SENT_LOADED = σχέσεις στο MG_CUST_RELATION με τους δύο πελάτες loaded
--   PRF_MIG     = γραμμές RELATIONSHIP μεταξύ πελατών της μετάπτωσης
--   TYPES       = τύποι σχέσης (μετάπτωση ή PROFITS)
--   GUARD       = σχέσεις κηδεμονίας στο MG_CUST_RELATION (10 / 1G / 1C / 1P)
-- ====================================================================
WITH
-- --------------------------------------------------------------------
-- Κοινό κομμάτι (ΙΔΙΟ αυτούσιο στο Master και στο Detail).
--   MIG / MIGP = πελάτες που φορτώθηκαν (MG_CUSTOMER_INTER ROW_STATUS = 1, PRFT_CUST_ID &gt; 0):
--                HUB κωδικός -&gt; PROFITS id και αντίστροφα (synthetic: 'SSCAIFP-&lt;serial&gt;')
--   JOINT      = HGR_MG_JOINT (10200): joint κωδικός -&gt; δικαιούχος, όπως το διαβάζει το 18000
--   MPP_RELAT  = MG_PARAM_PARAMETER RELAT (10010 + catch-all REPRESENTS του 18000), de-dup MIN
--   R_*        = HUB πίνακες (synonyms σε DB link @Malta), ΜΙΑ φορά ο καθένας
--   H          = σχέσεις HUB που επιλέγει το 18000 (τα δύο INSERT, ίδια φίλτρα, joint redirect)
--   HP         = H ανά ζευγάρι (εταιρεία, αντιπρόσωπος)
--   M / ME     = MG_CUST_RELATION (18000, μετά το delete των απορριφθέντων του 19800), με PROFITS ids
--   P          = RELATIONSHIP (FKCUST_HAS_AS_FIRS = αντιπρόσωπος, FKCUST_HAS_AS_SECO = εταιρεία)
--   CAIF2      = SS@CAIFP (HUB_MT_SSCAIFP2) με joint redirect, για τις ημερομηνίες κηδεμονίας
-- Detail: CUSTOMER_CODE = κωδικός HUB της εταιρείας (company), SERIAL_NO = κωδικός HUB του
-- αντιπροσώπου (representative), μετά το joint redirect.
-- --------------------------------------------------------------------
MIG AS (
    SELECT /*+ MATERIALIZE */ CC, PRFT
    FROM (
        SELECT TRIM(CUSTOMER_CODE) AS CC, PRFT_CUST_ID AS PRFT,
               ROW_NUMBER() OVER (PARTITION BY TRIM(CUSTOMER_CODE) ORDER BY PRFT_CUST_ID) AS RN
          FROM MG_CUSTOMER_INTER
         WHERE ROW_STATUS = 1
           AND PRFT_CUST_ID &gt; 0
    )
    WHERE RN = 1
),
MIGP AS (
    SELECT /*+ MATERIALIZE */ PRFT, MIN(CC) AS CC FROM MIG GROUP BY PRFT
),
JOINT AS (
    SELECT /*+ MATERIALIZE */ TRIM(CUSTOMER_1) AS C, TRIM(CUSTOMER_BENEF_LIST) AS B
      FROM HGR_MG_JOINT
),
MPP_RELAT AS (
    SELECT /*+ MATERIALIZE */ TRIM(OLD_VALUE) AS OV, MIN(TRIM(NEW_REL_VALUE)) AS NV
      FROM MG_PARAM_PARAMETER
     WHERE TRIM(PARAMETER_TYPE) = 'RELAT'
     GROUP BY TRIM(OLD_VALUE)
),
R_CAIFP AS (
    SELECT /*+ MATERIALIZE */
        SERIAL_NUMBER, ZUCTCG, ZUUSBO,
        TRIM(customer_code)  AS C1,
        TRIM(customer_code2) AS C2
    FROM HUB_MT_SSCAIFP
),
R_CAIFP2 AS (
    SELECT /*+ MATERIALIZE */
        TRIM(customer_code)  AS C1,
        TRIM(customer_code2) AS C2,
        TRIM(TO_CHAR("Z@GEXP")) AS GEXP,
        TRIM(TO_CHAR("Z@GORD")) AS GORD
    FROM HUB_MT_SSCAIFP2
),
H AS (
    -- 18000 INSERT 1: πελάτης -&gt; πελάτης
    SELECT /*+ MATERIALIZE */
        'CustomerRelations'                AS BRANCH,
        s.SERIAL_NUMBER                    AS HUB_SERIAL,
        TRIM(s.ZUCTCG)                     AS RAW_TYPE,
        s.ZUUSBO                           AS USBO,
        s.C1                               AS H_C1,
        s.C2                               AS H_C2,
        COALESCE(j1.B, s.C1)               AS COMP,
        COALESCE(j2.B, s.C2)               AS REPR
    FROM R_CAIFP s
    LEFT JOIN JOINT j1 ON j1.C = s.C1
    LEFT JOIN JOINT j2 ON j2.C = s.C2
    WHERE s.C1 &lt;&gt; s.C2
      AND COALESCE(j1.B, s.C1) &lt;&gt; COALESCE(j2.B, s.C2)
      AND s.C2 &lt;&gt; '-0-0'
      AND s.C2 &lt;&gt; '0000000'
      AND s.ZUCTCG NOT IN ('2', '7', 'A', 'G')
    UNION ALL
    -- 18000 INSERT 2: πελάτης -&gt; αντιπρόσωπος που δεν είναι πελάτης (synthetic SSCAIFP-&lt;serial&gt;)
    SELECT
        'CustomerRelationsSSCAIFP',
        s.SERIAL_NUMBER,
        TRIM(s.ZUCTCG),
        s.ZUUSBO,
        s.C1,
        s.C2,
        COALESCE(j1.B, s.C1),
        'SSCAIFP-' || TO_CHAR(TRIM(s.SERIAL_NUMBER))
    FROM R_CAIFP s
    LEFT JOIN JOINT j1 ON j1.C = s.C1
    WHERE s.C2 = '0000000'
      AND s.ZUCTCG NOT IN ('2', '7', 'A', 'G')
),
HP AS (
    SELECT /*+ MATERIALIZE */
        COMP, REPR,
        MIN(RAW_TYPE) AS RAW_MIN, MAX(RAW_TYPE) AS RAW_MAX,
        MAX(USBO) AS USBO_MAX
    FROM H
    GROUP BY COMP, REPR
),
M AS (
    SELECT /*+ MATERIALIZE */ DISTINCT
        TRIM(COMPANY_CUST_ID)   AS COMP,
        TRIM(REPRESENT_CUST_ID) AS REPR,
        TRIM(RELATION_TYPE)     AS RTYPE
    FROM MG_CUST_RELATION
),
ME AS (
    SELECT /*+ MATERIALIZE */
        m.COMP, m.REPR, m.RTYPE,
        r.NV                     AS TYPE_NAME,
        mc.PRFT                  AS COMP_ID,
        mr.PRFT                  AS REPR_ID,
        hp.RAW_MIN, hp.RAW_MAX, hp.USBO_MAX
    FROM M m
    LEFT JOIN MPP_RELAT r ON r.OV = m.RTYPE
    LEFT JOIN MIG mc      ON mc.CC = m.COMP
    LEFT JOIN MIG mr      ON mr.CC = m.REPR
    LEFT JOIN HP hp       ON hp.COMP = m.COMP AND hp.REPR = m.REPR
),
P AS (
    SELECT /*+ MATERIALIZE */
        FKCUST_HAS_AS_FIRS       AS FIRST_ID,
        FKCUST_HAS_AS_SECO       AS SECOND_ID,
        TRIM(FK_RELATIONSHIPTYP) AS TYPE_ID
    FROM RELATIONSHIP
),
PPAIR AS (
    -- τύποι PROFITS ανά ζευγάρι (αντιπρόσωπος, εταιρεία)
    SELECT /*+ MATERIALIZE */ FIRST_ID, SECOND_ID,
           MIN(TYPE_ID) AS T_MIN, MAX(TYPE_ID) AS T_MAX, COUNT(*) AS N
    FROM P
    GROUP BY FIRST_ID, SECOND_ID
),
MS AS (
    -- κατάσταση κάθε σχέσης που στάλθηκε, με πελάτες loaded
    SELECT /*+ MATERIALIZE */
        e.*,
        CASE WHEN EXISTS (SELECT 1 FROM P p WHERE p.FIRST_ID = e.REPR_ID AND p.SECOND_ID = e.COMP_ID AND p.TYPE_ID = e.TYPE_NAME) THEN 'MATCHED'
             WHEN d.FIRST_ID IS NOT NULL THEN 'OTHER_TYPE'
             WHEN rv.FIRST_ID IS NOT NULL THEN 'REVERSED'
             ELSE 'NO_RELATION' END                  AS STATE,
        d.T_MIN  AS D_T_MIN,  d.T_MAX  AS D_T_MAX,
        rv.T_MIN AS RV_T_MIN, rv.T_MAX AS RV_T_MAX
    FROM ME e
    LEFT JOIN PPAIR d  ON d.FIRST_ID = e.REPR_ID  AND d.SECOND_ID = e.COMP_ID
    LEFT JOIN PPAIR rv ON rv.FIRST_ID = e.COMP_ID AND rv.SECOND_ID = e.REPR_ID
    WHERE e.COMP_ID IS NOT NULL
      AND e.REPR_ID IS NOT NULL
),
CAIF2 AS (
    SELECT /*+ MATERIALIZE */
        COALESCE(j1.B, c.C1) AS COMP,
        COALESCE(j2.B, c.C2) AS REPR,
        MAX(CASE WHEN LTRIM(c.GEXP, '0') IS NOT NULL THEN c.GEXP END) AS GEXP,
        MAX(CASE WHEN LTRIM(c.GORD, '0') IS NOT NULL THEN c.GORD END) AS GORD
    FROM R_CAIFP2 c
    LEFT JOIN JOINT j1 ON j1.C = c.C1
    LEFT JOIN JOINT j2 ON j2.C = c.C2
    GROUP BY COALESCE(j1.B, c.C1), COALESCE(j2.B, c.C2)
),
TYPES AS (
    SELECT /*+ MATERIALIZE */ NVL(h.T, p.T) AS TYPE_NAME, h.N AS HUB_N, p.N AS PRF_N
      FROM (SELECT TYPE_NAME AS T, COUNT(*) AS N FROM MS GROUP BY TYPE_NAME) h
      FULL OUTER JOIN
           (SELECT p.TYPE_ID AS T, COUNT(*) AS N
              FROM P p
              JOIN MIGP a ON a.PRFT = p.FIRST_ID
              JOIN MIGP b ON b.PRFT = p.SECOND_ID
             GROUP BY p.TYPE_ID) p
        ON p.T = h.T
),
FINDINGS AS (
    --==============================================================
    --CR-001. Σχέση HUB που επιλέγει το 18000 αλλά δεν υπάρχει στο MG_CUST_RELATION (το 19800 σβήνει
    --        τις γραμμές που απέρριψε η φόρτωση). ISSUE = πιθανή αιτία
    SELECT
      CAST('CR-001_HUB_RELATION_NOT_MIGRATED' AS VARCHAR2(50)) AS CHECK_NAME,
      CAST(h.COMP AS VARCHAR2(40)) AS CUSTOMER_CODE, CAST(h.REPR AS VARCHAR2(40)) AS SERIAL_NO,
      CAST('ZUCTCG=' || h.RAW_TYPE || '; SSCAIFP ' || h.H_C1 || ' -&gt; ' || h.H_C2 AS VARCHAR2(200)) AS HUB_VALUE,
      CAST(NULL AS VARCHAR2(200)) AS NCIS_VALUE,
      CAST(CASE WHEN mc.CC IS NULL AND mr.CC IS NULL THEN 'BOTH_CUSTOMERS_NOT_LOADED'
                WHEN mc.CC IS NULL THEN 'COMPANY_NOT_LOADED'
                WHEN mr.CC IS NULL THEN 'REPRESENTATIVE_NOT_LOADED'
                ELSE 'REJECTED_BY_PROFITS_LOAD' END AS VARCHAR2(50)) AS ISSUE
    FROM H h
    LEFT JOIN (SELECT DISTINCT COMP, REPR FROM M) m ON m.COMP = h.COMP AND m.REPR = h.REPR
    LEFT JOIN MIG mc ON mc.CC = h.COMP
    LEFT JOIN MIG mr ON mr.CC = h.REPR
    WHERE m.COMP IS NULL
    UNION ALL
    --==============================================================
    --CR-002. Σχέση που στάλθηκε (MG_CUST_RELATION) χωρίς καμία σχέση στο PROFITS για το ζευγάρι,
    --        σε καμία κατεύθυνση. Και σχέσεις του MG με πελάτη που δεν φορτώθηκε
    SELECT 'CR-002_RELATION_MISSING_IN_PROFITS', COMP, REPR,
           'ZUCTCG=' || NVL(RAW_MIN, '?') || CASE WHEN RAW_MAX &lt;&gt; RAW_MIN THEN ' | ' || RAW_MAX END, CAST(NULL AS VARCHAR2(200)),
           'NO_RELATION (EXPECTED ' || NVL(TYPE_NAME, 'NO_RELAT ' || RTYPE) || ')'
    FROM MS
    WHERE STATE = 'NO_RELATION'
    UNION ALL
    SELECT 'CR-002_RELATION_MISSING_IN_PROFITS', COMP, REPR,
           'ZUCTCG=' || NVL(RAW_MIN, '?'), CAST(NULL AS VARCHAR2(200)),
           CASE WHEN COMP_ID IS NULL AND REPR_ID IS NULL THEN 'BOTH_CUSTOMERS_NOT_LOADED'
                WHEN COMP_ID IS NULL THEN 'COMPANY_NOT_LOADED'
                ELSE 'REPRESENTATIVE_NOT_LOADED' END
    FROM ME
    WHERE COMP_ID IS NULL OR REPR_ID IS NULL
    UNION ALL
    --==============================================================
    --CR-003. Το ζευγάρι υπάρχει στο PROFITS (ίδια κατεύθυνση) αλλά όχι με τον τύπο που στέλνει η μετάπτωση
    --        (MG_CUST_RELATION.RELATION_TYPE -&gt; RELAT)
    SELECT 'CR-003_RELATION_TYPE_MISMATCH', COMP, REPR,
           'ZUCTCG=' || NVL(RAW_MIN, '?') || CASE WHEN RAW_MAX &lt;&gt; RAW_MIN THEN ' | ' || RAW_MAX END,
           D_T_MIN || CASE WHEN D_T_MAX &lt;&gt; D_T_MIN THEN ' | ' || D_T_MAX END,
           SUBSTR('MISMATCH (EXPECTED ' || NVL(TYPE_NAME, 'NO_RELAT ' || RTYPE) || ')', 1, 50)
    FROM MS
    WHERE STATE = 'OTHER_TYPE'
    UNION ALL
    --==============================================================
    --CR-004. Η σχέση υπάρχει στο PROFITS μόνο ανάποδα (εταιρεία πρώτη, αντιπρόσωπος δεύτερος)
    SELECT 'CR-004_RELATION_REVERSED', COMP, REPR,
           'ZUCTCG=' || NVL(RAW_MIN, '?'),
           RV_T_MIN || CASE WHEN RV_T_MAX &lt;&gt; RV_T_MIN THEN ' | ' || RV_T_MAX END,
           SUBSTR('REVERSED_IN_PROFITS (EXPECTED ' || NVL(TYPE_NAME, 'NO_RELAT ' || RTYPE) || ')', 1, 50)
    FROM MS
    WHERE STATE = 'REVERSED'
    UNION ALL
    --==============================================================
    --CR-005. Σχέση PROFITS μεταξύ πελατών της μετάπτωσης, για ζευγάρι που η μετάπτωση δεν στέλνει
    --        (σε καμία κατεύθυνση, με κανέναν τύπο)
    SELECT 'CR-005_RELATION_MISSING_IN_HUB', b.CC, a.CC, CAST(NULL AS VARCHAR2(200)), p.TYPE_ID,
           'NOT_SENT_BY_MIGRATION'
    FROM P p
    JOIN MIGP a ON a.PRFT = p.FIRST_ID
    JOIN MIGP b ON b.PRFT = p.SECOND_ID
    LEFT JOIN (SELECT DISTINCT REPR_ID, COMP_ID FROM ME WHERE REPR_ID IS NOT NULL AND COMP_ID IS NOT NULL) e1
           ON e1.REPR_ID = p.FIRST_ID AND e1.COMP_ID = p.SECOND_ID
    LEFT JOIN (SELECT DISTINCT REPR_ID, COMP_ID FROM ME WHERE REPR_ID IS NOT NULL AND COMP_ID IS NOT NULL) e2
           ON e2.REPR_ID = p.SECOND_ID AND e2.COMP_ID = p.FIRST_ID
    WHERE e1.REPR_ID IS NULL
      AND e2.REPR_ID IS NULL
    UNION ALL
    --==============================================================
    --CR-006. Πλήθος σχέσεων ανά τύπο: στάλθηκαν (MG_CUST_RELATION, πελάτες loaded) vs RELATIONSHIP
    --        μεταξύ πελατών της μετάπτωσης. Μία γραμμή ανά τύπο (CUSTOMER_CODE = τύπος)
    SELECT 'CR-006_RELATION_COUNT_PER_TYPE', NVL(TYPE_NAME, '(no RELAT)'), CAST(NULL AS VARCHAR2(40)),
           TO_CHAR(NVL(HUB_N, 0)), TO_CHAR(NVL(PRF_N, 0)),
           'COUNT_DIFFERS (EXPECTED ' || TO_CHAR(NVL(HUB_N, 0)) || ')'
    FROM TYPES
    WHERE NVL(HUB_N, 0) &lt;&gt; NVL(PRF_N, 0)
    UNION ALL
    --==============================================================
    --CR-007. Σχέση κηδεμονίας (τύπος 1 του HUB -&gt; 10 / 1G / 1C / 1P) με ημερομηνία λήξης / έναρξης στο
    --        SS@CAIFP (Z@GEXP / Z@GORD): το 18000 δεν τη μεταφέρει (EXPIRE_DATE NULL). To be confirmed with NC
    SELECT 'CR-007_GUARDIANSHIP_DATES_NOT_MIGRATED', e.COMP, e.REPR,
           'Z@GEXP=' || NVL(c.GEXP, 'empty') || '; Z@GORD=' || NVL(c.GORD, 'empty'), CAST(NULL AS VARCHAR2(200)),
           'NOT_MIGRATED_BY_18000'
    FROM ME e
    JOIN CAIF2 c ON c.COMP = e.COMP AND c.REPR = e.REPR
    WHERE e.RTYPE IN ('10', '1G', '1C', '1P')
      AND (c.GEXP IS NOT NULL OR c.GORD IS NOT NULL)
    UNION ALL
    --==============================================================
    --CR-008. Σχέση με ποσοστό beneficial owner στο HUB (SSCAIFP.ZUUSBO &gt; 0): το 18000 δεν το μεταφέρει.
    --        To be confirmed with NC
    SELECT 'CR-008_BENEFICIAL_OWNER_PCT_NOT_MIGRATED', COMP, REPR,
           'ZUUSBO=' || TO_CHAR(USBO_MAX), CAST(NULL AS VARCHAR2(200)),
           'NOT_MIGRATED_BY_18000'
    FROM ME
    WHERE NVL(USBO_MAX, 0) &gt; 0
)
,
POPULATIONS AS (
    SELECT
        (SELECT COUNT(*) FROM H)                                              AS HUB_REL_COUNT,
        (SELECT COUNT(*) FROM ME)                                             AS SENT_COUNT,
        (SELECT COUNT(*) FROM MS)                                             AS SENT_LOADED_COUNT,
        (SELECT COUNT(*) FROM P p JOIN MIGP a ON a.PRFT = p.FIRST_ID
                                  JOIN MIGP b ON b.PRFT = p.SECOND_ID)        AS PRF_MIG_COUNT,
        (SELECT COUNT(*) FROM TYPES)                                          AS TYPES_COUNT,
        (SELECT COUNT(*) FROM ME WHERE RTYPE IN ('10', '1G', '1C', '1P'))     AS GUARD_COUNT
    FROM DUAL
),
CHECK_META AS (
    -- CHECK_ID | CHECK_NAME | CATEGORY | DESCRIPTION | POPULATION_TYPE
    SELECT 'CR-001' AS CHECK_ID, 'CR-001_HUB_RELATION_NOT_MIGRATED' AS CHECK_NAME, 'EXISTENCE' AS CATEGORY, 'HUB relations that the migration selects but that did not reach PROFITS (rejected by the load). The detail rows give the likely reason, e.g. a customer not migrated.' AS DESCRIPTION, 'HUB_REL' AS POPULATION_TYPE FROM DUAL UNION ALL
    SELECT 'CR-002', 'CR-002_RELATION_MISSING_IN_PROFITS',          'EXISTENCE',             'Relations sent by the migration with no relation at all between the two customers in PROFITS, or whose customer was not migrated.', 'SENT' FROM DUAL UNION ALL
    SELECT 'CR-003', 'CR-003_RELATION_TYPE_MISMATCH',               'CROSS_SYSTEM_MISMATCH', 'The two customers are related in PROFITS, but not with the relation type the migration sent from the HUB relation code.', 'SENT_LOADED' FROM DUAL UNION ALL
    SELECT 'CR-004', 'CR-004_RELATION_REVERSED',                    'CROSS_SYSTEM_MISMATCH', 'The relation exists in PROFITS only in the opposite direction (company and representative swapped).', 'SENT_LOADED' FROM DUAL UNION ALL
    SELECT 'CR-005', 'CR-005_RELATION_MISSING_IN_HUB',              'EXISTENCE',             'Relations in PROFITS between migrated customers that the migration did not send.', 'PRF_MIG' FROM DUAL UNION ALL
    SELECT 'CR-006', 'CR-006_RELATION_COUNT_PER_TYPE',              'CONTROL_TOTAL',         'Relation types whose number of relations in PROFITS differs from the number the migration sent. One row per type.', 'TYPES' FROM DUAL UNION ALL
    SELECT 'CR-007', 'CR-007_GUARDIANSHIP_DATES_NOT_MIGRATED',      'CROSS_SYSTEM_MISMATCH', 'Guardianship relations with a start or expiry date in HUB, which the migration does not carry. To be confirmed with NC.', 'GUARD' FROM DUAL UNION ALL
    SELECT 'CR-008', 'CR-008_BENEFICIAL_OWNER_PCT_NOT_MIGRATED',    'CROSS_SYSTEM_MISMATCH', 'Relations with a beneficial owner percentage in HUB, which the migration does not carry. To be confirmed with NC.', 'SENT' FROM DUAL
),
FINDINGS_COUNT AS (
    SELECT CHECK_ID, COUNT(*) AS INVALID_COUNT
    FROM (SELECT SUBSTR(CHECK_NAME, 1, INSTR(CHECK_NAME, '_') - 1) AS CHECK_ID FROM FINDINGS)
    GROUP BY CHECK_ID
)
SELECT
    CAST(CM.CHECK_ID AS VARCHAR2(10)) AS CHECK_ID,
    CAST(CM.CHECK_NAME AS VARCHAR2(50)) AS CHECK_NAME,
    CAST(CM.CATEGORY AS VARCHAR2(30)) AS CATEGORY,
    CAST(CM.DESCRIPTION AS VARCHAR2(200)) AS DESCRIPTION,
    (CASE CM.POPULATION_TYPE
        WHEN 'HUB_REL'     THEN P.HUB_REL_COUNT
        WHEN 'SENT'        THEN P.SENT_COUNT
        WHEN 'SENT_LOADED' THEN P.SENT_LOADED_COUNT
        WHEN 'PRF_MIG'     THEN P.PRF_MIG_COUNT
        WHEN 'TYPES'       THEN P.TYPES_COUNT
        WHEN 'GUARD'       THEN P.GUARD_COUNT
     END) AS TOTAL_RECORDS,
    (CASE CM.POPULATION_TYPE
        WHEN 'HUB_REL'     THEN P.HUB_REL_COUNT
        WHEN 'SENT'        THEN P.SENT_COUNT
        WHEN 'SENT_LOADED' THEN P.SENT_LOADED_COUNT
        WHEN 'PRF_MIG'     THEN P.PRF_MIG_COUNT
        WHEN 'TYPES'       THEN P.TYPES_COUNT
        WHEN 'GUARD'       THEN P.GUARD_COUNT
     END) - NVL(FC.INVALID_COUNT, 0) AS VALID_COUNT,
    NVL(FC.INVALID_COUNT, 0) AS INVALID_COUNT,
    CASE WHEN CM.CATEGORY = 'INFO'           THEN 'INFO'
         WHEN NVL(FC.INVALID_COUNT, 0) = 0   THEN 'PASS'
         ELSE 'FAIL' END AS STATUS,
    'DC5' AS DC_VERSION,
    1 AS RUN_VERSION,  -- TESTING ONLY: στο SSIS αντικαθίσταται από @[User::RunVersion] μέσω Derived Column.
    SYSDATE AS RUN_TIMESTAMP
FROM CHECK_META CM
CROSS JOIN POPULATIONS P
LEFT JOIN FINDINGS_COUNT FC ON FC.CHECK_ID = CM.CHECK_ID
ORDER BY REGEXP_SUBSTR(CM.CHECK_ID, '[A-Z]+'), TO_NUMBER(REGEXP_SUBSTR(CM.CHECK_ID, '[0-9]+'));</property>
                    <property
                      dataType="System.Int32"
                      description="Specify the number of rows fetched per batch."
                      expressionType="Notify"
                      name="BatchSize">1000</property>
