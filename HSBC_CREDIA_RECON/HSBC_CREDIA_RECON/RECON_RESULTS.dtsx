                          name="STATUS" />
                        <outputColumn
                          refId="Package\Sequence Container\Deposits_Master\Deposits_master.Outputs[Oracle Source Output].Columns[DESCRIPTION]"
                          codePage="1253"
                          dataType="str"
                          externalMetadataColumnId="Package\Sequence Container\Deposits_Master\Deposits_master.Outputs[Oracle Source Output].ExternalColumns[DESCRIPTION]"
                          length="200"
                          lineageId="Package\Sequence Container\Deposits_Master\Deposits_master.Outputs[Oracle Source Output].Columns[DESCRIPTION]"
                          name="DESCRIPTION" />
                        <outputColumn
                          refId="Package\Sequence Container\Deposits_Master\Deposits_master.Outputs[Oracle Source Output].Columns[TOTAL_RECORDS]"
                          dataType="r8"
                          externalMetadataColumnId="Package\Sequence Container\Deposits_Master\Deposits_master.Outputs[Oracle Source Output].ExternalColumns[TOTAL_RECORDS]"
                          lineageId="Package\Sequence Container\Deposits_Master\Deposits_master.Outputs[Oracle Source Output].Columns[TOTAL_RECORDS]"
                          name="TOTAL_RECORDS" />
                        <outputColumn
                          refId="Package\Sequence Container\Deposits_Master\Deposits_master.Outputs[Oracle Source Output].Columns[VALID_COUNT]"
                          dataType="r8"
                          externalMetadataColumnId="Package\Sequence Container\Deposits_Master\Deposits_master.Outputs[Oracle Source Output].ExternalColumns[VALID_COUNT]"
                          lineageId="Package\Sequence Container\Deposits_Master\Deposits_master.Outputs[Oracle Source Output].Columns[VALID_COUNT]"
                          name="VALID_COUNT" />
                        <outputColumn
