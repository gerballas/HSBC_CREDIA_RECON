                          codePage="1253"
                          dataType="str"
                          externalMetadataColumnId="Package\Sequence Container\Customer_Categories_Detail\Customer_Categories_detail.Outputs[Oracle Source Output].ExternalColumns[CHECK_ID]"
                          length="10"
