        <DTS:Executable
          DTS:refId="Package\Sequence Container\Customer_Categories_Master"
          DTS:CreationName="Microsoft.Pipeline"
          DTS:Description="Data Flow Task"
          DTS:DTSID="{620642d5-757d-416d-8503-ea04fc7f710d}"
          DTS:ExecutableType="Microsoft.Pipeline"
          DTS:LocaleID="-1"
          DTS:ObjectName="Customer_Categories_Master"
          DTS:TaskContact="Performs high-performance data extraction, transformation and loading;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1">
          <DTS:Variables />
          <DTS:ObjectData>
            <pipeline
              version="1">
              <components>
                <component
                  refId="Package\Sequence Container\Customer_Categories_Master\Customer_Categories_master"
                  componentClassID="Microsoft.SSISOracleSrc"
                  contactInfo="Oracle Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;1"
                  description="Oracle Source"
                  name="Customer_Categories_master"
                  usesDispositions="true"
                  version="1">
                  <properties>
                    <property
                      dataType="System.String"
                      description="The name of the table to be fetched."
                      expressionType="Notify"
                      name="TableName"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      expressionType="Notify"
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">-- ====================================================================
-- CAT_RECON — MASTER DC5 v2
-- Τροφοδοτεί: RECON.CAT_RECON_MASTER
-- ΜΕΤΟΝΟΜΑΣΙΑ 2026-11-13 (μόνο όνομα / περιγραφή, ίδια λογική): CTG-011_VALUE_NOT_IN_PROFITS_LIST -&gt;
-- CTG-011_HUB_VALUE_LOST_NO_PROFITS_CODE, CTG-012_MULTIPLE_VALUES_PER_CUSTOMER -&gt; CTG-012_ONLY_ONE_OF_SEVERAL_VALUES_KEPT.
-- Μία γραμμή ΑΝΑ CHECK_ID — 14 γραμμές ανά run: CTG-001 .. CTG-014.
--
-- Customer Categories (ME01_HUB, EIM 240825): HUB vs PROFITS CUSTOMER_CATEGORY
-- για τις 9 κατηγορίες του 19000_MG_CUST_CATEGORIES.sql (DC5 drop):
--   SPECATEG (SPECA), LCUSCAT (CLOAN), AMLRICAT (AMLRI), ACTIVITY (CCODE),
--   ACTIVIT1 (CCOBK), ECONOMY (FINSC), ECONOM1 (FINBK), INCLEVEL (INCLV),
--   LAWSHAPE (LEGAL).
-- Μορφή Master/Detail των Customer Addresses / Customers
-- (MasterCustomerAddresses_DC5_v2.sql, MasterCustomers_DC5_v2.sql):
--   - ένα αυτοτελές SELECT, χωρίς views και χωρίς HGR_* πίνακες. Το prologue
--     (CTEs) και το FINDINGS είναι ΙΔΙΑ αυτούσια στο
--     DetailCustomerCategories_DC5_v2.sql -&gt; INVALID_COUNT = γραμμές του
--     Detail ανά CHECK_ID (εκτός από το CTG-014, INFO, μόνο Master).
--   - Παράγεται από τον generator (_generator\build_cat.ps1):
--     cat_master_head + cat_common + cat_master_tail.
--   - HUB από τα HUB_MT_* synonyms (DB link @Malta): κάθε πίνακας ΜΙΑ φορά
--     σε δικό του CTE (R_*), μόνο οι στήλες που χρειάζονται.
--   - MG / PROFITS πίνακες:
--       MG_CUSTOMER_INTER   - γέφυρα HUB -&gt; PRFT_CUST_ID (ROW_STATUS = 1), CUST_TYPE
--       MG_PARAM_PARAMETER  - τελικό mapping (10010 + 19000)
--       CUSTOMER_SPECA / CUSTOMER_CLOAN - κανόνες SPECATEG / LCUSCAT του 10101,
--                             όπως τους διαβάζει το 19000 (Migration table, not HUB)
--       CUSTOMER_CATEGORY + GENERIC_DETAIL - πλευρά PROFITS. Το NCIS extract
--                             (01_CUSTOMER.sql) δεν καλύπτει τις περισσότερες
--                             κατηγορίες, γι' αυτό διαβάζεται το CUSTOMER_CATEGORY
--                             (συμφωνήθηκε 2026-11-12).
--
-- ΑΡΧΗ: αναμενόμενη τιμή ΜΟΝΟ από τα scripts της μετάπτωσης.
--   - SENT = η τιμή που βάζει το 19000 στο MG_CUST_CATEGORIES, ξαναϋπολογισμένη
--     με τον κανόνα του 19000 (HUB_MT_* ή CUSTOMER_SPECA / CUSTOMER_CLOAN).
--   - Αναμενόμενος κωδικός PROFITS = MG_PARAM_PARAMETER(&lt;λίστα&gt;, SENT). Για το
--     SPECATEG κανένα DC5 script δεν γεμίζει το MG_PARAM_PARAMETER 'SPECA' -&gt;
--     GENERIC_DETAIL SPECA μέσω TRIM(SHORT_DESCRIPTION), όπως το CM-033
--     (συμφωνήθηκε, to be confirmed with NC).
--   - Πληθυσμός: πελάτες loaded (MG_CUSTOMER_INTER ROW_STATUS = 1, PRFT_CUST_ID &gt; 0).
--   - Mapping σε 0 (placeholder, η λίστα δεν έχει την τιμή): στο CTG-001..009
--     είναι η αναμενόμενη τιμή (PASS αν το PROFITS έχει 0), και καταγράφεται στο
--     CTG-011 (συμφωνήθηκε). Για INCLEVEL / LAWSHAPE το 0 είναι ρητό mapping του
--     10010 και δεν θεωρείται placeholder.
--   - Πολλές τιμές για τον ίδιο πελάτη / κατηγορία: PASS στο CTG-001..009 όταν
--     το PROFITS κρατά μία από αυτές. Η απώλεια των υπολοίπων -&gt; CTG-012.
--   - HUB_VALUE = τιμή HUB, NCIS_VALUE = FK_GENERIC_DETASER του PROFITS,
--     αναμενόμενη τιμή στο ISSUE: MISMATCH (EXPECTED n), NO_MAPPING (SENT x),
--     BLANK_CODE_SENT, MISSING_IN_PROFITS (...), NOT_EXPECTED_FROM_HUB.
--
-- ΑΝΤΙΣΤΟΙΧΙΑ με το MasterCustomerCategories_DC5.sql (v1 του DC5, μένει ως έχει):
--   v1 CTG-001 MISSING_IN_PROFITS     -&gt; ISSUE MISSING_IN_PROFITS στα CTG-001..009
--   v1 CTG-002 MISSING_IN_HUB         -&gt; ISSUE NOT_EXPECTED_FROM_HUB στα CTG-001..009
--   v1 CTG-003 PARAMETER_LIST         -&gt; CTG-010
--   v1 CTG-004 VALUE_MISMATCH         -&gt; CTG-001..009 (ένα ανά κατηγορία)
--   v1 CTG-005 COUNT_MISMATCH         -&gt; CTG-014 (INFO)
--   v1 CTG-006 CUSTOMERS_PER_VALUE    -&gt; καλύπτεται από τα CTG-001..009, αφαιρέθηκε
--   v1 CTG-007 FEWER_STAGED           -&gt; αφαιρέθηκε (staging, όχι HUB vs PROFITS)
--   v1 CTG-008 AMLRICAT_VS_AGREED     -&gt; αφαιρέθηκε: το 19000 σβήνει το AMLRI του
--                                        10010 και το ξαναφτιάχνει, άρα το τελικό
--                                        mapping είναι αυτό του 19000 (CTG-003)
--   v1 CTG-009 PLACEHOLDER_NO_HUB     -&gt; ISSUE NOT_EXPECTED_FROM_HUB στα CTG-001..009
--   νέα: CTG-011 (DC4 placeholder 0), CTG-012 (DC4 LCUSCAT EXI / EXN), CTG-013 (DC4)
--
-- STATUS: PASS (INVALID_COUNT = 0) / FAIL / INFO (CTG-014).
-- Report διαφορών scripts: DC5\DC4_vs_DC5_MigrationScripts_CustomerCategories_Diff_Report.md
-- ====================================================================
WITH
-- --------------------------------------------------------------------
-- Κοινό prologue (ίδιο αυτούσιο στο Master και στο Detail, ώστε το
-- καθένα να τρέχει μόνο του από SSIS).
--   CAT_LIST = οι 9 κατηγορίες του 19000 -&gt; λίστα PROFITS (GENERIC_DETAIL
--              header) -&gt; CHECK_NAME. LOOKUP = 1: η λίστα / το mapping
--              χτίζεται από το 19000 με COALESCE(serial, 0) (0 = δεν βρέθηκε).
--   MCI      = MG_CUSTOMER_INTER loaded (ROW_STATUS = 1) - γέφυρα HUB -&gt; PRFT_CUST_ID
--   MPP      = MG_PARAM_PARAMETER (τελικό, μετά το 19000) ανά PARAMETER_TYPE / OLD_VALUE
--   GDL      = GENERIC_DETAIL των 9 λιστών (TRIM: SHORT_DESCRIPTION είναι CHAR)
--   R_*      = HUB_MT_* (DB link @Malta): ένα pull ανά πίνακα, μόνο οι στήλες
--              που χρειάζονται, TRIM(customer_code) = CC
--   M_*      = πίνακες της μετάπτωσης που διαβάζει το 19000 (CUSTOMER_SPECA /
--              CUSTOMER_CLOAN του 10101) - Migration table (not HUB)
--   EXP      = ό,τι στέλνει το 19000 (SENT) ανά πελάτη / κατηγορία + HUB τιμή
--              + αναμενόμενος κωδικός PROFITS από τα scripts
--   HK       = μία γραμμή ανά (CUST_ID, κατηγορία), μόνο loaded πελάτες
--   PRF      = PROFITS CUSTOMER_CATEGORY, 9 κατηγορίες, loaded πελάτες
--   CMP      = HK FULL OUTER JOIN PRF
-- --------------------------------------------------------------------
CAT_LIST AS (
    SELECT CAST('SPECATEG' AS VARCHAR2(10)) AS CAT, CAST('SPECA' AS VARCHAR2(10)) AS HDR,
           CAST('CTG-001_SPECATEG_MISMATCH' AS VARCHAR2(50)) AS CHECK_NAME, 1 AS LOOKUP FROM DUAL
    UNION ALL SELECT 'LCUSCAT',  'CLOAN', 'CTG-002_LCUSCAT_MISMATCH',  1 FROM DUAL
    UNION ALL SELECT 'AMLRICAT', 'AMLRI', 'CTG-003_AMLRICAT_MISMATCH', 1 FROM DUAL
    UNION ALL SELECT 'ACTIVITY', 'CCODE', 'CTG-004_ACTIVITY_MISMATCH', 1 FROM DUAL
    UNION ALL SELECT 'ACTIVIT1', 'CCOBK', 'CTG-005_ACTIVIT1_MISMATCH', 1 FROM DUAL
    UNION ALL SELECT 'ECONOMY',  'FINSC', 'CTG-006_ECONOMY_MISMATCH',  1 FROM DUAL
    UNION ALL SELECT 'ECONOM1',  'FINBK', 'CTG-007_ECONOM1_MISMATCH',  1 FROM DUAL
    UNION ALL SELECT 'INCLEVEL', 'INCLV', 'CTG-008_INCLEVEL_MISMATCH', 0 FROM DUAL
    UNION ALL SELECT 'LAWSHAPE', 'LEGAL', 'CTG-009_LAWSHAPE_MISMATCH', 0 FROM DUAL
),
MCI AS (
    SELECT /*+ MATERIALIZE */
        TRIM(CUSTOMER_CODE)             AS CC,
        MIN(PRFT_CUST_ID)               AS CUST_ID,
        MIN(TRIM(TO_CHAR(CUST_TYPE)))   AS CTYPE
      FROM MG_CUSTOMER_INTER
     WHERE ROW_STATUS = 1
       AND PRFT_CUST_ID &gt; 0
     GROUP BY TRIM(CUSTOMER_CODE)
),
MCI_ID AS (
    SELECT /*+ MATERIALIZE */ CUST_ID, MIN(CC) AS CC
      FROM MCI
     GROUP BY CUST_ID
),
-- τελικό mapping: 10010 στατικό + ό,τι πρόσθεσε / ξανάφτιαξε το 19000
-- (CLOAN προσθήκη, AMLRI / CCOBK / FINBK delete + insert, CCODE / FINSC insert).
-- MIN / MAX: όπου υπάρχουν δύο τιμές για τον ίδιο κωδικό, δεκτή και η μία και η άλλη.
MPP AS (
    SELECT /*+ MATERIALIZE */
        TRIM(PARAMETER_TYPE) AS PT, TRIM(OLD_VALUE) AS OV,
        MIN(NEW_VALUE) AS NV_MIN, MAX(NEW_VALUE) AS NV_MAX
      FROM MG_PARAM_PARAMETER
     WHERE TRIM(PARAMETER_TYPE) IN ('CLOAN','AMLRI','CCODE','CCOBK','FINSC','FINBK','INCLV','LEGAL')
     GROUP BY TRIM(PARAMETER_TYPE), TRIM(OLD_VALUE)
),
GDL AS (
    SELECT /*+ MATERIALIZE */
        TRIM(FK_GENERIC_HEADPAR) AS HP, SERIAL_NUM, TRIM(SHORT_DESCRIPTION) AS SD
      FROM GENERIC_DETAIL
     WHERE TRIM(FK_GENERIC_HEADPAR) IN ('SPECA','CLOAN','AMLRI','CCODE','CCOBK','FINSC','FINBK','INCLV','LEGAL')
),
-- SHORT_DESCRIPTION -&gt; serial: SPECA (DC5: κανένα script δεν γεμίζει το
-- MG_PARAM_PARAMETER 'SPECA' - συμφωνήθηκε lookup όπως το CM-033, to be
-- confirmed with NC) και CCODE (19000, για την παραγωγή του ECONOMY)
GD_SD AS (
    SELECT /*+ MATERIALIZE */ HP, SD, MIN(SERIAL_NUM) AS SERIAL_NUM
      FROM GDL
     WHERE HP IN ('SPECA','CCODE')
       AND SD IS NOT NULL
     GROUP BY HP, SD
),
GD_KEY AS (
    SELECT /*+ MATERIALIZE */ DISTINCT HP, SERIAL_NUM FROM GDL
),
-- --------------------------------------------------------------------
-- R_* = HUB πίνακες (synonyms πάνω σε DB link @Malta, 10098): κάθε πίνακας
-- διαβάζεται ΜΙΑ φορά, μόνο με τις στήλες που χρειάζονται. Όλα τα joins
-- γίνονται μετά τοπικά. customer_code = στήλη του 10090
-- (branch || LPAD(serial, 6, '0')), όπως τη χρησιμοποιεί το 19000.
-- --------------------------------------------------------------------
R_CUSTP AS (
    SELECT /*+ MATERIALIZE */
        TRIM(customer_code) AS CC, TRIM(ZGGHCL) AS GHCL, ZGINDY, ZGLGTP
      FROM HUB_MT_SSCUSTP
),
R_GHCLP AS (
    -- 19000 ACTIVITY: SSGHCLP.VQCSTY IN ('I','N')
    SELECT /*+ MATERIALIZE */ DISTINCT TRIM(VQGHCL) AS GHCL
      FROM HUB_MT_SSGHCLP
     WHERE VQCSTY IN ('I','N')
),
R_SCCIP AS (
    SELECT /*+ MATERIALIZE */ TRIM(customer_code) AS CC, TRIM(SCSCCF) AS SCCF
      FROM HUB_MT_SSSCCIP
),
R_INCIP AS (
    SELECT /*+ MATERIALIZE */ TRIM(customer_code) AS CC, TRIM(ZKICPS) AS ICPS
      FROM HUB_MT_SSINCIP
     WHERE ZKICPS IS NOT NULL
),
CUST_G AS (
    -- GHO ανά πελάτη, μόνο για εμφάνιση στο HUB_VALUE (SPECATEG / LCUSCAT)
    SELECT /*+ MATERIALIZE */ CC, MIN(GHCL) AS GHCL FROM R_CUSTP GROUP BY CC
),
-- --------------------------------------------------------------------
-- M_* = πίνακες της μετάπτωσης που διαβάζει το 19000 (κανόνες 10101)
-- --------------------------------------------------------------------
M_SPECA AS (
    -- 19000: DISTINCT CUSTOMER_CODE, SPECA ... WHERE SPECA IS NOT NULL (το ' ' περνά)
    SELECT /*+ MATERIALIZE */ DISTINCT TRIM(CUSTOMER_CODE) AS CC, SPECA
      FROM CUSTOMER_SPECA
     WHERE SPECA IS NOT NULL
),
M_CLOAN AS (
    -- 19000: DISTINCT CUSTOMER_CODE, GD_CODE ... WHERE GD_CODE IS NOT NULL
    SELECT /*+ MATERIALIZE */ DISTINCT TRIM(CUSTOMER_CODE) AS CC, TRIM(GD_CODE) AS GD_CODE
      FROM CUSTOMER_CLOAN
     WHERE GD_CODE IS NOT NULL
),
-- --------------------------------------------------------------------
-- 19000 ACTIVITY / ACTIVIT1: SSCUSTP, VQCSTY I / N, MG_CUSTOMER_INTER CUST_TYPE 1,
-- ZGINDY 3 ψηφία -&gt; NN.N, 4 ψηφία -&gt; NN.NN, αλλιώς ως έχει
-- --------------------------------------------------------------------
ACT AS (
    SELECT /*+ MATERIALIZE */
        C.CC,
        TO_CHAR(C.ZGINDY) AS INDY,
        CASE WHEN LENGTH(TO_CHAR(C.ZGINDY)) = 3
                  THEN SUBSTR(TO_CHAR(C.ZGINDY), 1, 2) || '.' || SUBSTR(TO_CHAR(C.ZGINDY), 3, 1)
             WHEN LENGTH(TO_CHAR(C.ZGINDY)) = 4
                  THEN SUBSTR(TO_CHAR(C.ZGINDY), 1, 2) || '.' || SUBSTR(TO_CHAR(C.ZGINDY), 3, 2)
             ELSE TO_CHAR(C.ZGINDY) END AS ACT_VAL
      FROM R_CUSTP C
      JOIN R_GHCLP G ON G.GHCL = C.GHCL
      JOIN MCI M     ON M.CC = C.CC AND M.CTYPE = '1'
),
-- 19000 ECONOMY / ECONOM1: GENERIC_DETAIL CCODE (SHORT_DESCRIPTION = τιμή ACTIVITY)
-- -&gt; CAST(NVL(serial, 0) / 10 AS INT) (η Oracle στρογγυλεύει) -&gt; GENERIC_DETAIL FINSC
-- serial. Χωρίς FINSC γραμμή -&gt; κενή τιμή.
ECON AS (
    SELECT /*+ MATERIALIZE */
        A.CC, A.INDY,
        CASE WHEN F.SERIAL_NUM IS NOT NULL THEN TO_CHAR(F.SERIAL_NUM) END AS FIN_VAL
      FROM ACT A
      LEFT JOIN GD_SD S  ON S.HP = 'CCODE' AND S.SD = TRIM(A.ACT_VAL)
      LEFT JOIN GD_KEY F ON F.HP = 'FINSC' AND F.SERIAL_NUM = ROUND(NVL(S.SERIAL_NUM, 0) / 10)
),
-- --------------------------------------------------------------------
-- EXP: μία γραμμή ανά τιμή που στέλνει το 19000.
--   HUB_VALUE = τιμή HUB (SPECATEG / LCUSCAT: GHO του HUB + κωδικός του 10101)
--   SENT      = CATEGORY_VALUE όπως στο MG_CUST_CATEGORIES
--   EXP_MIN / EXP_MAX = αναμενόμενος κωδικός PROFITS (NULL = χωρίς mapping)
-- --------------------------------------------------------------------
EXP_SRC AS (
    SELECT M.CC, 'SPECATEG' AS CAT,
           'GHO=' || G.GHCL || ' / CODE=' || NVL(TRIM(M.SPECA), '(blank)') AS HUB_VALUE,
           M.SPECA AS SENT
      FROM M_SPECA M
      LEFT JOIN CUST_G G ON G.CC = M.CC
    UNION ALL
    SELECT M.CC, 'LCUSCAT', 'GHO=' || G.GHCL || ' / CODE=' || M.GD_CODE, M.GD_CODE
      FROM M_CLOAN M
      LEFT JOIN CUST_G G ON G.CC = M.CC
    UNION ALL
    -- 19000 AMLRICAT: MG_CUSTOMER_INTER ROW_STATUS 1 x SSSCCIP
    SELECT S.CC, 'AMLRICAT', S.SCCF, S.SCCF
      FROM R_SCCIP S
      JOIN MCI M ON M.CC = S.CC
    UNION ALL
    SELECT A.CC, 'ACTIVITY', A.INDY, A.ACT_VAL FROM ACT A
    UNION ALL
    SELECT A.CC, 'ACTIVIT1', A.INDY, A.ACT_VAL FROM ACT A
    UNION ALL
    SELECT E.CC, 'ECONOMY',  E.INDY, E.FIN_VAL FROM ECON E
    UNION ALL
    SELECT E.CC, 'ECONOM1',  E.INDY, E.FIN_VAL FROM ECON E
    UNION ALL
    -- 19000 INCLEVEL: SSCUSTP x SSINCIP, ZKICPS not null
    SELECT C.CC, 'INCLEVEL', I.ICPS, I.ICPS
      FROM R_CUSTP C
      JOIN R_INCIP I ON I.CC = C.CC
    UNION ALL
    -- 19000 LAWSHAPE: SSCUSTP x MG_CUSTOMER_INTER ROW_STATUS 1, CUST_TYPE 2
    SELECT C.CC, 'LAWSHAPE', TO_CHAR(C.ZGLGTP), TRIM(TO_CHAR(C.ZGLGTP))
      FROM R_CUSTP C
      JOIN MCI M ON M.CC = C.CC AND M.CTYPE = '2'
),
-- μόνο loaded πελάτες (οι υπόλοιποι δεν υπάρχουν στο PROFITS)
EXPM AS (
    SELECT /*+ MATERIALIZE */ DISTINCT
        M.CUST_ID, E.CC, E.CAT, L.HDR, L.LOOKUP,
        CAST(E.HUB_VALUE AS VARCHAR2(200)) AS HUB_VALUE,
        CAST(E.SENT AS VARCHAR2(100))      AS SENT,
        CASE WHEN E.CAT = 'SPECATEG' THEN S.SERIAL_NUM ELSE P.NV_MIN END AS EXP_MIN,
        CASE WHEN E.CAT = 'SPECATEG' THEN S.SERIAL_NUM ELSE P.NV_MAX END AS EXP_MAX
      FROM EXP_SRC E
      JOIN MCI M      ON M.CC = E.CC
      JOIN CAT_LIST L ON L.CAT = E.CAT
      LEFT JOIN MPP P   ON E.CAT &lt;&gt; 'SPECATEG' AND P.PT = L.HDR AND P.OV = TRIM(E.SENT)
      LEFT JOIN GD_SD S ON E.CAT = 'SPECATEG' AND S.HP = 'SPECA' AND S.SD = TRIM(E.SENT)
),
HK AS (
    SELECT /*+ MATERIALIZE */
        E.CUST_ID, E.CAT,
        MIN(E.CC)                                                  AS CC,
        COUNT(DISTINCT NVL(TRIM(E.SENT), '(blank)'))               AS N_SENT,
        MIN(E.HUB_VALUE)                                           AS HUB_MIN,
        MAX(E.HUB_VALUE)                                           AS HUB_MAX,
        MIN(NVL(TRIM(E.SENT), '(blank)'))                          AS SENT_MIN,
        MAX(NVL(TRIM(E.SENT), '(blank)'))                          AS SENT_MAX,
        MIN(E.EXP_MIN)                                             AS EXP_MIN,
        MAX(E.EXP_MAX)                                             AS EXP_MAX,
        SUM(CASE WHEN TRIM(E.SENT) IS NULL THEN 1 ELSE 0 END)      AS N_BLANK
      FROM EXPM E
     GROUP BY E.CUST_ID, E.CAT
),
PRF AS (
    SELECT /*+ MATERIALIZE */
        K.FK_CUSTOMERCUST_ID         AS CUST_ID,
        TRIM(K.FK_CATEGORYCATEGOR)   AS CAT,
        TRIM(K.FK_GENERIC_DETAFK)    AS P_HDR,
        K.FK_GENERIC_DETASER         AS P_SER,
        I.CC
      FROM CUSTOMER_CATEGORY K
      JOIN MCI_ID I ON I.CUST_ID = K.FK_CUSTOMERCUST_ID
     WHERE TRIM(K.FK_CATEGORYCATEGOR) IN ('SPECATEG','LCUSCAT','AMLRICAT','ACTIVITY','ACTIVIT1',
                                          'ECONOMY','ECONOM1','INCLEVEL','LAWSHAPE')
),
-- PROFITS κρατά τουλάχιστον έναν από τους αναμενόμενους κωδικούς του πελάτη
KM AS (
    SELECT /*+ MATERIALIZE */
        E.CUST_ID, E.CAT,
        MAX(CASE WHEN P.P_SER IN (E.EXP_MIN, E.EXP_MAX) THEN 1 ELSE 0 END) AS ANY_MATCH
      FROM EXPM E
      JOIN PRF P ON P.CUST_ID = E.CUST_ID AND P.CAT = E.CAT
     GROUP BY E.CUST_ID, E.CAT
),
CMP AS (
    SELECT /*+ MATERIALIZE */
        NVL(H.CUST_ID, P.CUST_ID)   AS CUST_ID,
        NVL(H.CAT, P.CAT)           AS CAT,
        NVL(H.CC, P.CC)             AS CC,
        CASE WHEN P.CUST_ID IS NULL THEN 'MISSING'
             WHEN H.CUST_ID IS NULL THEN 'EXTRA'
             ELSE 'BOTH' END        AS KS,
        H.N_SENT, H.HUB_MIN, H.HUB_MAX, H.SENT_MIN, H.SENT_MAX, H.EXP_MIN, H.EXP_MAX, H.N_BLANK,
        CASE WHEN H.EXP_MIN IS NULL THEN NULL
             WHEN H.EXP_MIN = H.EXP_MAX THEN TO_CHAR(H.EXP_MIN)
             ELSE TO_CHAR(H.EXP_MIN) || '|' || TO_CHAR(H.EXP_MAX) END AS EXP_TXT,
        P.P_HDR, P.P_SER,
        NVL(K.ANY_MATCH, 0)         AS ANY_MATCH
      FROM HK H
      FULL OUTER JOIN PRF P ON P.CUST_ID = H.CUST_ID AND P.CAT = H.CAT
      LEFT JOIN KM K        ON K.CUST_ID = H.CUST_ID AND K.CAT = H.CAT
),
-- PROFITS ζεύγη ACTIVITY / ACTIVIT1 και ECONOMY / ECONOM1 (19000: CCOBK = CCODE,
-- FINBK = FINSC mapping)
PAIRS AS (
    SELECT P.CUST_ID, MIN(P.CC) AS CC, 'ACTIVITY' AS C1, 'ACTIVIT1' AS C2,
           MAX(CASE WHEN P.CAT = 'ACTIVITY' THEN P.P_SER END) AS S1,
           MAX(CASE WHEN P.CAT = 'ACTIVIT1' THEN P.P_SER END) AS S2
      FROM PRF P
     WHERE P.CAT IN ('ACTIVITY','ACTIVIT1')
     GROUP BY P.CUST_ID
    UNION ALL
    SELECT P.CUST_ID, MIN(P.CC), 'ECONOMY', 'ECONOM1',
           MAX(CASE WHEN P.CAT = 'ECONOMY' THEN P.P_SER END),
           MAX(CASE WHEN P.CAT = 'ECONOM1' THEN P.P_SER END)
      FROM PRF P
     WHERE P.CAT IN ('ECONOMY','ECONOM1')
     GROUP BY P.CUST_ID
),
-- --------------------------------------------------------------------
-- FINDINGS: μία γραμμή ανά εύρημα
--   CHECK_NAME | CUSTOMER_CODE | SERIAL_NO (PROFITS CUST_ID) | HUB_VALUE | NCIS_VALUE | ISSUE
-- --------------------------------------------------------------------
FINDINGS AS (
    --==============================================================
    --CTG-001..009. Μία κατηγορία ανά check. Αναμενόμενο = κωδικός που στέλνει το
    --        19000 μεταφρασμένος με το τελικό mapping. PASS όταν το PROFITS κρατά
    --        έναν από τους αναμενόμενους κωδικούς (πολλές τιμές -&gt; CTG-012).
    SELECT L.CHECK_NAME, X.CC AS CUSTOMER_CODE, TO_CHAR(X.CUST_ID) AS SERIAL_NO,
           CAST(X.HUB_MIN || CASE WHEN X.HUB_MAX &lt;&gt; X.HUB_MIN THEN ' | ' || X.HUB_MAX END AS VARCHAR2(400)) AS HUB_VALUE,
           CAST(TO_CHAR(X.P_SER) AS VARCHAR2(400)) AS NCIS_VALUE,
           CAST(CASE
                WHEN X.KS = 'EXTRA' THEN 'NOT_EXPECTED_FROM_HUB'
                WHEN X.KS = 'MISSING' AND X.EXP_MIN IS NULL AND X.N_BLANK &gt; 0 THEN 'MISSING_IN_PROFITS (BLANK_CODE_SENT)'
                WHEN X.KS = 'MISSING' AND X.EXP_MIN IS NULL THEN 'MISSING_IN_PROFITS (NO_MAPPING)'
                WHEN X.KS = 'MISSING' THEN 'MISSING_IN_PROFITS (EXPECTED ' || X.EXP_TXT || ')'
                WHEN X.EXP_MIN IS NULL AND X.N_BLANK &gt; 0 THEN 'BLANK_CODE_SENT'
                WHEN X.EXP_MIN IS NULL THEN 'NO_MAPPING (SENT ' || SUBSTR(X.SENT_MIN, 1, 30) || ')'
                ELSE 'MISMATCH (EXPECTED ' || X.EXP_TXT || ')' END AS VARCHAR2(100)) AS ISSUE
      FROM CMP X
      JOIN CAT_LIST L ON L.CAT = X.CAT
     WHERE X.KS &lt;&gt; 'BOTH'
        OR X.ANY_MATCH = 0
    UNION ALL
    --==============================================================
    --CTG-010. Η γραμμή PROFITS δείχνει σε άλλη λίστα (FK_GENERIC_DETAFK) από αυτή της κατηγορίας
    SELECT 'CTG-010_PARAMETER_LIST_MISMATCH', P.CC, TO_CHAR(P.CUST_ID),
           P.CAT || ': ' || L.HDR,
           NVL(P.P_HDR, '(empty)') || ' / ' || TO_CHAR(P.P_SER),
           'MISMATCH (EXPECTED ' || L.HDR || ')'
      FROM PRF P
      JOIN CAT_LIST L ON L.CAT = P.CAT
     WHERE NVL(P.P_HDR, '~') &lt;&gt; L.HDR
    UNION ALL
    --==============================================================
    --CTG-011. Τιμή HUB χωρίς εγγραφή στη λίστα PROFITS: χωρίς mapping, κενός κωδικός,
    --        placeholder 0 (λίστες που χτίζει το 19000 με COALESCE(serial, 0)) ή
    --        αναμενόμενος κωδικός που δεν υπάρχει στο GENERIC_DETAIL
    SELECT 'CTG-011_HUB_VALUE_LOST_NO_PROFITS_CODE', E.CC, TO_CHAR(E.CUST_ID),
           E.CAT || ': ' || E.HUB_VALUE,
           TO_CHAR(P.P_SER),
           CASE WHEN TRIM(E.SENT) IS NULL THEN 'BLANK_CODE_SENT'
                WHEN E.EXP_MIN IS NULL THEN 'NO_MAPPING (SENT ' || SUBSTR(TRIM(E.SENT), 1, 30) || ')'
                WHEN E.EXP_MIN = 0 AND E.LOOKUP = 1 THEN 'PLACEHOLDER_0 (SENT ' || SUBSTR(TRIM(E.SENT), 1, 28) || ')'
                ELSE 'CODE_NOT_IN_LIST (EXPECTED ' || TO_CHAR(E.EXP_MIN) || ')' END
      FROM EXPM E
      LEFT JOIN PRF P    ON P.CUST_ID = E.CUST_ID AND P.CAT = E.CAT
      LEFT JOIN GD_KEY G ON G.HP = E.HDR AND G.SERIAL_NUM = E.EXP_MIN
     WHERE E.EXP_MIN IS NULL
        OR (E.EXP_MIN = 0 AND E.LOOKUP = 1)
        OR G.HP IS NULL
    UNION ALL
    --==============================================================
    --CTG-012. Το 19000 στέλνει &gt;1 τιμή για τον ίδιο πελάτη / κατηγορία (PROFITS κρατά μία)
    SELECT 'CTG-012_ONLY_ONE_OF_SEVERAL_VALUES_KEPT', H.CC, TO_CHAR(H.CUST_ID),
           H.CAT || ': ' || TO_CHAR(H.N_SENT) || ' values: ' || H.SENT_MIN || ' | ' || H.SENT_MAX,
           TO_CHAR(P.P_SER),
           'MULTIPLE_VALUES_SENT (' || TO_CHAR(H.N_SENT) || ')'
      FROM HK H
      LEFT JOIN PRF P ON P.CUST_ID = H.CUST_ID AND P.CAT = H.CAT
     WHERE H.N_SENT &gt; 1
    UNION ALL
    --==============================================================
    --CTG-013. ACTIVITY &lt;&gt; ACTIVIT1 ή ECONOMY &lt;&gt; ECONOM1 στο PROFITS (το 19000 δίνει
    --        και στα δύο τον ίδιο κωδικό). HUB_VALUE NULL: έλεγχος μόνο στο PROFITS.
    SELECT 'CTG-013_PAIRED_CATEGORIES_DIFFER', X.CC, TO_CHAR(X.CUST_ID),
           CAST(NULL AS VARCHAR2(10)),
           X.C1 || ' ' || NVL(TO_CHAR(X.S1), '(none)') || ' / ' || X.C2 || ' ' || NVL(TO_CHAR(X.S2), '(none)'),
           X.C1 || '_' || X.C2 || '_DIFFER'
      FROM PAIRS X
     WHERE NVL(X.S1, -1) &lt;&gt; NVL(X.S2, -1)
)
,
POPULATIONS AS (
    SELECT 'K_' || CAT AS POP_TYPE, COUNT(*) AS CNT FROM CMP GROUP BY CAT
    UNION ALL SELECT 'PRF_ROWS',   COUNT(*) FROM PRF
    UNION ALL SELECT 'EXP_ROWS',   COUNT(*) FROM EXPM
    UNION ALL SELECT 'HUB_KEYS',   COUNT(*) FROM HK
    UNION ALL SELECT 'PAIRS',      COUNT(*) FROM PAIRS
    UNION ALL SELECT 'CATEGORIES', COUNT(*) FROM CAT_LIST
),
CHECK_META AS (
    -- CHECK_ID | CHECK_NAME | CATEGORY | DESCRIPTION | POPULATION_TYPE
    SELECT 'CTG-001' AS CHECK_ID, 'CTG-001_SPECATEG_MISMATCH' AS CHECK_NAME, 'CROSS_SYSTEM_MISMATCH' AS CATEGORY, 'Special agreements category in PROFITS differs from the code of the migration rule, is missing, or is not expected. How the code is translated is to be confirmed with NC.' AS DESCRIPTION, 'K_SPECATEG' AS POPULATION_TYPE FROM DUAL UNION ALL
    SELECT 'CTG-002', 'CTG-002_LCUSCAT_MISMATCH',               'CROSS_SYSTEM_MISMATCH', 'Loan customer category in PROFITS differs from the code of the migration rule translated with the migration mapping, is missing, or is not expected.', 'K_LCUSCAT' FROM DUAL UNION ALL
    SELECT 'CTG-003', 'CTG-003_AMLRICAT_MISMATCH',              'CROSS_SYSTEM_MISMATCH', 'AML risk category in PROFITS differs from the HUB special category code translated with the migration mapping, is missing, or is not expected.', 'K_AMLRICAT' FROM DUAL UNION ALL
    SELECT 'CTG-004', 'CTG-004_ACTIVITY_MISMATCH',              'CROSS_SYSTEM_MISMATCH', 'Activity category in PROFITS differs from the HUB industry code translated with the migration mapping (individuals), is missing, or is not expected.', 'K_ACTIVITY' FROM DUAL UNION ALL
    SELECT 'CTG-005', 'CTG-005_ACTIVIT1_MISMATCH',              'CROSS_SYSTEM_MISMATCH', 'Second activity category in PROFITS differs from the HUB industry code translated with the migration mapping (individuals), is missing, or is not expected.', 'K_ACTIVIT1' FROM DUAL UNION ALL
    SELECT 'CTG-006', 'CTG-006_ECONOMY_MISMATCH',               'CROSS_SYSTEM_MISMATCH', 'Economic sector in PROFITS differs from the sector the migration derives from the HUB industry code (individuals), is missing, or is not expected.', 'K_ECONOMY' FROM DUAL UNION ALL
    SELECT 'CTG-007', 'CTG-007_ECONOM1_MISMATCH',               'CROSS_SYSTEM_MISMATCH', 'Second economic sector in PROFITS differs from the sector the migration derives from the HUB industry code (individuals), is missing, or is not expected.', 'K_ECONOM1' FROM DUAL UNION ALL
    SELECT 'CTG-008', 'CTG-008_INCLEVEL_MISMATCH',              'CROSS_SYSTEM_MISMATCH', 'Income level in PROFITS differs from the HUB income level translated with the migration mapping, is missing, or is not expected.', 'K_INCLEVEL' FROM DUAL UNION ALL
    SELECT 'CTG-009', 'CTG-009_LAWSHAPE_MISMATCH',              'CROSS_SYSTEM_MISMATCH', 'Legal form in PROFITS differs from the HUB legal type translated with the migration mapping (companies), is missing, or is not expected.', 'K_LAWSHAPE' FROM DUAL UNION ALL
    SELECT 'CTG-010', 'CTG-010_PARAMETER_LIST_MISMATCH',        'INTEGRITY',             'Customer category in PROFITS points to a parameter list other than the list the category uses.', 'PRF_ROWS' FROM DUAL UNION ALL
    SELECT 'CTG-011', 'CTG-011_HUB_VALUE_LOST_NO_PROFITS_CODE',      'UNMAPPED',              'Customers whose HUB value has no matching code in PROFITS. The migration sends 0 or nothing, so the HUB value is lost even when the category check passes.', 'EXP_ROWS' FROM DUAL UNION ALL
    SELECT 'CTG-012', 'CTG-012_ONLY_ONE_OF_SEVERAL_VALUES_KEPT',   'DUPLICATE',             'Customers for whom the migration sends two or more values for the same category (e.g. two LCUSCAT codes). PROFITS keeps only one, so the others are lost.', 'HUB_KEYS' FROM DUAL UNION ALL
    SELECT 'CTG-013', 'CTG-013_PAIRED_CATEGORIES_DIFFER',       'INTEGRITY',             'Activity and second activity, or economic sector and second economic sector, differ in PROFITS although the migration gives both the same code.', 'PAIRS' FROM DUAL UNION ALL
    SELECT 'CTG-014', 'CTG-014_CATEGORY_COUNT_DIFFERENCE',      'INFO',                  'Information only: number of categories, out of 9, where the number of customers expected from HUB differs from the number held in PROFITS. No detail rows.', 'CATEGORIES' FROM DUAL
),
FINDINGS_COUNT AS (
    SELECT CHECK_ID, COUNT(*) AS INVALID_COUNT
    FROM (SELECT SUBSTR(CHECK_NAME, 1, INSTR(CHECK_NAME, '_') - 1) AS CHECK_ID FROM FINDINGS)
    GROUP BY CHECK_ID
    UNION ALL
    -- CTG-014 (INFO, μόνο Master): κατηγορίες με διαφορετικό πλήθος HUB / PROFITS
    SELECT 'CTG-014', COUNT(*)
    FROM CAT_LIST L
    LEFT JOIN (SELECT CAT, COUNT(*) AS N FROM HK  GROUP BY CAT) H ON H.CAT = L.CAT
    LEFT JOIN (SELECT CAT, COUNT(*) AS N FROM PRF GROUP BY CAT) P ON P.CAT = L.CAT
    WHERE NVL(H.N, 0) &lt;&gt; NVL(P.N, 0)
)
SELECT
    CAST(CM.CHECK_ID AS VARCHAR2(10)) AS CHECK_ID,
    CAST(CM.CHECK_NAME AS VARCHAR2(50)) AS CHECK_NAME,
    CAST(CM.CATEGORY AS VARCHAR2(30)) AS CATEGORY,
    CAST(CM.DESCRIPTION AS VARCHAR2(200)) AS DESCRIPTION,
    NVL(P.CNT, 0) AS TOTAL_RECORDS,
    NVL(P.CNT, 0) - NVL(FC.INVALID_COUNT, 0) AS VALID_COUNT,
    NVL(FC.INVALID_COUNT, 0) AS INVALID_COUNT,
    CASE WHEN CM.CATEGORY = 'INFO'           THEN 'INFO'
         WHEN NVL(FC.INVALID_COUNT, 0) = 0   THEN 'PASS'
         ELSE 'FAIL' END AS STATUS,
    'DC5' AS DC_VERSION,
    1 AS RUN_VERSION,  -- TESTING ONLY: στο SSIS αντικαθίσταται από @[User::RunVersion] μέσω Derived Column.
    SYSDATE AS RUN_TIMESTAMP
FROM CHECK_META CM
LEFT JOIN POPULATIONS P     ON P.POP_TYPE = CM.POPULATION_TYPE
LEFT JOIN FINDINGS_COUNT FC ON FC.CHECK_ID = CM.CHECK_ID
ORDER BY REGEXP_SUBSTR(CM.CHECK_ID, '[A-Z]+'), TO_NUMBER(REGEXP_SUBSTR(CM.CHECK_ID, '[0-9]+'));</property>
