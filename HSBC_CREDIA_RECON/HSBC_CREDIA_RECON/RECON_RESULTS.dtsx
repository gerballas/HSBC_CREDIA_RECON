                  endId="Package\Sequence Container\Customer_Groups_Detail\OLE DB Destination.Inputs[OLE DB Destination Input]"
                  name="Derived Column Output"
                  startId="Package\Sequence Container\Customer_Groups_Detail\Derived Column.Outputs[Derived Column Output]" />
                <path
                  refId="Package\Sequence Container\Customer_Groups_Detail.Paths[Oracle Source Output]"
                  endId="Package\Sequence Container\Customer_Groups_Detail\Derived Column.Inputs[Derived Column Input]"
                  name="Oracle Source Output"
                  startId="Package\Sequence Container\Customer_Groups_Detail\Customer_Groups_detail.Outputs[Oracle Source Output]" />
              </paths>
            </pipeline>
