        <DTS:Executable
          DTS:refId="Package\Sequence Container\Deposits_Master"
          DTS:CreationName="Microsoft.Pipeline"
          DTS:Description="Data Flow Task"
          DTS:DTSID="{078bbdd2-accb-448e-a5d1-65c21d4f010e}"
          DTS:ExecutableType="Microsoft.Pipeline"
          DTS:LocaleID="-1"
          DTS:ObjectName="Deposits_Master"
          DTS:TaskContact="Performs high-performance data extraction, transformation and loading;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1">
          <DTS:Variables />
          <DTS:ObjectData>
            <pipeline
              version="1">
              <components>
                <component
                  refId="Package\Sequence Container\Deposits_Master\Deposits_master"
                  componentClassID="Microsoft.SSISOracleSrc"
                  contactInfo="Oracle Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;1"
                  description="Oracle Source"
                  name="Deposits_master"
                  usesDispositions="true"
                  version="1">
                  <properties>
                    <property
                      dataType="System.String"
                      description="The name of the table to be fetched."
                      expressionType="Notify"
                      name="TableName"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      expressionType="Notify"
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">-- ====================================================================
-- DEP_RECON — MASTER DC5 v1
-- Τροφοδοτεί: RECON.DEP_RECON_MASTER
-- Μία γραμμή ΑΝΑ CHECK_ID — 26 γραμμές ανά run: DP-001 .. DP-026.
--
-- Deposits (ME01_HUB, EIM 240825): HUB DDACMSP (DD / OVD) + TDACMSP (TD) vs NCIS_Deposits
-- (03_DEPOSITS.sql, Migration Scripts\20261005\ReconciliationScripts, ίδιο με NCIS\NCIS).
-- Migration scripts DC5: DC5\20261116_MigrationScripts. Διαφορές DC4 -&gt; DC5:
-- DC5\DC4_vs_DC5_MigrationScripts_Deposits_Diff_Report.md.
-- Μορφή Master/Detail όπως το MasterCustomerAddresses_DC5_v3.sql:
--   - ένα αυτοτελές SELECT, χωρίς views. Το κοινό κομμάτι (CTEs) και το FINDINGS είναι ΙΔΙΑ
--     αυτούσια στο DetailDeposits_DC5_v1.sql -&gt; INVALID_COUNT = γραμμές του Detail ανά CHECK_ID.
--   - Παράγεται από τον generator (_generator): dep_master_head + dep_common + dep_master_tail.
--   - HUB από τα HUB_MT_* synonyms (DB link @Malta, 10098): κάθε πίνακας ΜΙΑ φορά σε δικό του CTE (R_*).
--
-- ΑΡΧΗ: αναμενόμενη τιμή ΜΟΝΟ από τα scripts της μετάπτωσης (καμία δική μας υπόθεση):
--   - Static (30001): MG_CUST_DPAC_INTER (branch, νόμισμα, πελάτης μετά τον joint redirect, opening
--     date, TD renewal, statement freq, OVD limit), MG_ACC_PARAMETERS ανά
--     MG_ACCOUNT_TYPE (product, debit / credit interest code).
--   - Financial (30200 + reruns 30205): MG_HGR_MG_DEP_TRN_INTER_KEEP (40500 κρατά εκεί τις γραμμές
--     financial): book / block balance, accruals, TD dates / rate / days base, INTER_PAY_OPTIONS.
--     Blocks: MG_DEP_TRN_INTER TRN_MIGRATED_TYPE = 4.
--   - Μετά τη φόρτωση (90000): status από DFRSTR / DFSTUS (99 και TD -&gt; 1), OVD debit spread
--     (CHS-441), credit spread (CHS-421), unauthorised interest (CHS-269) και accruals (ROUND(/ 100,
--     DISPLAYED_DECIMAL), DP-017 / 018 / 019). Όλα τα checks περιμένουν την ΤΕΛΙΚΗ κατάσταση μετά το 90000
--     (απόφαση χρήστη 2026-11-16): πριν τρέξει το 90000 τα DP-008 / 017 / 018 / 019 / 025 / 026 αποτυγχάνουν.
--     Opening date: δεκτή και η BANK_PARAMETERS.PREV_TRX_DATE (30205, ADATE_LESS_OPEN_DATE) - ο
--     MG_HGR_DEP_OPEN_DT_ADATE δεν διαβάζεται.
--   - Available balance (DP-016, 90000 CHS-431): BOOK - BLOCKED - UNCLEAR με τα ποσά του PROFITS (book /
--     blocked ελέγχονται vs HUB στα DP-014 / DP-015). Το 90000 το εφαρμόζει μόνο σε λογαριασμούς με holds G,
--     το ISSUE τους δείχνει ως 'MISMATCH G'. Ο κανόνας DC4 (DFVLBL) δεν υπάρχει σε κανένα DC5 script και
--     έμεινε μόνο ως πληροφορία στο HUB_VALUE (απόφαση χρήστη 2026-11-16).
--   - Blocked balance (DP-015): άθροισμα των block transactions του 30200 (TRN_MIGRATED_TYPE 4). Η γραμμή
--     financial (BLOCK_BALANCE = DFTTHD - holds G) δεν χρησιμοποιείται: στο run της 2026-11-16 το PROFITS
--     είχε πάντα το άθροισμα των block transactions (απόφαση χρήστη 2026-11-16).
--   - DP-020 / DP-021: το NCIS extract έχει τους debit / credit interest codes ανάποδα (Debit_Interest_Code =
--     DEPOSIT_ACCOUNT.FK0INTERESTID_INTE = credit κωδικός). Το CTE N τους διαβάζει ανάποδα (διαγνωστικό
--     2026-11-16, απόφαση χρήστη, to be confirmed with NC).
--   - Ποσά: ανοχή 0.005, επιτόκια / spreads: 0.00005.
--   - HUB_VALUE = τιμή HUB, NCIS_VALUE = τιμή NCIS, αναμενόμενη τιμή στο ISSUE. Όπου η αναμενόμενη τιμή
--     βγαίνει από mapping (DP-004 / 020 / 021), το HUB_VALUE δείχνει τα πεδία HUB από τα οποία προκύπτει
--     (DFAPTY / TDAPTY / DGCIRT / rate type OVD). Τιμές των migration tables (π.χ. MG_ACCOUNT_TYPE) δεν μπαίνουν
--     στο Detail (2026-11-16), η θέση τους είναι στο DIFF_QUERY (MIGRATION_FIELD / MIGRATION_VALUE).
--   - Detail: CUSTOMER_CODE = πελάτης HUB, SERIAL_NO = ACCOUNT_NO (ονόματα στηλών του template).
--
-- ΑΝΤΙΣΤΟΙΧΙΑ με το MasterDepositsDC4.sql (48 checks):
--   A1 -&gt; DP-001 (G2 / B3 ως αιτία στο ISSUE) | A2 -&gt; DP-002 | A13 -&gt; DP-003 | G3 -&gt; DP-004 | G4 -&gt; DP-005
--   G6 -&gt; DP-006 | B1 -&gt; DP-007 | E1 -&gt; DP-008 | E2 -&gt; DP-009 | E4 -&gt; DP-010 | E7 -&gt; DP-011 | E8 -&gt; DP-012
--   E9 -&gt; DP-013 | D1 -&gt; DP-014 | D2 -&gt; DP-015 | D3 -&gt; DP-016 (νέος κανόνας) | D8 -&gt; DP-017 (κανόνας 90000) | D12 -&gt; DP-018 | D13 -&gt; DP-019
--   Νέα: DP-020 debit interest code, DP-021 credit interest code, DP-022 OVD limit, DP-023 statement freq,
--        DP-024 TD interest rate, DP-025 OVD debit spread, DP-026 credit spread.
--   Αφαιρέθηκε 2026-11-16: customer category (πρώην DP-027). Η αναμενόμενη τιμή ερχόταν από το PROFITS
--        (CUSTOMER_CATEGORY LCUSCAT), όχι από το HUB (κανόνας playbook: check χωρίς πηγή στο HUB δεν μπαίνει).
--   Αφαιρέθηκαν (κοιτάνε μία πλευρά, χωρίς σύγκριση HUB vs NCIS): A3-A12, D4-D7, D9-D11, D14-D22.
--   B2 (beneficiaries): κατηγορία Beneficiaries.
--
-- STATUS: PASS (INVALID_COUNT = 0) / FAIL. DESCRIPTION: απλή περιγραφή χωρίς κωδικούς.
--
-- TOTAL_RECORDS ανά POPULATION_TYPE:
--   HUB_ACC       = λογαριασμοί HUB (DDACMSP + TDACMSP)
--   NCIS_ACC      = λογαριασμοί NCIS
--   MATCHED_ALL   = λογαριασμοί και στα δύο
--   MATCHED_DDOVD / MATCHED_OVD / MATCHED_TD = ίδιοι, ανά τύπο (FILE_NAME του MG_CUST_DPAC_INTER)
--   CRSPR         = λογαριασμοί και στα δύο για τους οποίους το 90000 ορίζει credit spread
-- ====================================================================
WITH
-- --------------------------------------------------------------------
-- Κοινό κομμάτι (ΙΔΙΟ αυτούσιο στο Master και στο Detail).
--   R_*  = HUB πίνακες (synonyms σε DB link @Malta): κάθε πίνακας ΜΙΑ φορά, μόνο οι στήλες
--          που χρειάζονται, μία γραμμή ανά λογαριασμό (RN = 1). Δίνουν το HUB_VALUE και τις
--          τιμές HUB που χρησιμοποιούν αυτούσιες τα scripts (status 90000, spreads 90000).
--   H    = λογαριασμοί HUB (DDACMSP = DD / OVD, TDACMSP = TD), ένας ανά ACCOUNT_NO
--   M    = MG_CUST_DPAC_INTER (30001): τελική τιμή ανά λογαριασμό (μετά τον joint redirect του 30001)
--   MDL  = MG_DPAC_LOAD (loader): status φόρτωσης, PRFT_DEP_ACC_NO
--   AP   = MG_ACC_PARAMETERS (30001): product / interest codes / statement freq ανά MG_ACCOUNT_TYPE
--   PM   = MG_HGR_DEPOSITS_PRODUCT_MAPPING (30001): HSBC product -&gt; DD / OVD / TD
--   CUS  = MG_CUSTOMER_INTER (πελάτες loaded) -&gt; PRFT_CUST_ID
--   FIN  = MG_HGR_MG_DEP_TRN_INTER_KEEP (40500): οι γραμμές financial του 30200, μετά τα
--          reruns του 30205 (book / block balance, accruals, TD dates / rate / days base,
--          INTER_PAY_OPTIONS)
--   BLK  = MG_DEP_TRN_INTER TRN_MIGRATED_TYPE = 4 (30200 / 40500): block transactions
--   ODT  = BANK_PARAMETERS.PREV_TRX_DATE: το 30205 βάζει αυτή την ημερομηνία ως opening date στους
--          λογαριασμούς με ADATE_LESS_OPEN_DATE. Ο MG_HGR_DEP_OPEN_DT_ADATE ΔΕΝ διαβάζεται: υπάρχει μόνο
--          αν έτρεξε το 30205, και το 30205 σβήνει τη σημαία στο MG_DEP_TRN_INTER, οπότε η λίστα
--          λογαριασμών δεν ξαναβγαίνει. Στο DP-009 η PREV_TRX_DATE γίνεται δεκτή ως 2η σωστή τιμή.
--   N    = NCIS_Deposits (03_DEPOSITS.sql, 20261005), ένας ανά Account_Number
--   B    = λογαριασμοί και στα δύο (H x N) + τιμή HUB + αναμενόμενη τιμή (X_*)
-- --------------------------------------------------------------------
R_DD AS (
    SELECT /*+ MATERIALIZE */ AN, CC, PRODUCT, BRANCH, CCY, STUS, RSTR, DFRLBL, DFVLBL, DFTTHD, DFDTAO
    FROM (
        SELECT TRIM(ACCOUNT_NO)           AS AN,
               TRIM(CUSTOMER_CODE)        AS CC,
               TRIM(DFAPTY)               AS PRODUCT,
               TRIM(TO_CHAR(DFACB))       AS BRANCH,
               TRIM(DFCYCD)               AS CCY,
               TRIM(TO_CHAR(DFSTUS))      AS STUS,
               TRIM(TO_CHAR(DFRSTR))      AS RSTR,
               DFRLBL, DFVLBL, DFTTHD, DFDTAO,
               ROW_NUMBER() OVER (PARTITION BY TRIM(ACCOUNT_NO) ORDER BY TRIM(CUSTOMER_CODE)) AS RN
          FROM HUB_MT_DDACMSP
    )
    WHERE RN = 1
),
R_TD AS (
    SELECT /*+ MATERIALIZE */ AN, CC, PRODUCT, BRANCH, CCY, TDRLBL, TDDUDT, TDSTDT, TDMTIN, TDCICM, TDCNTR, TDCRSP, TDDTAO
    FROM (
        SELECT TRIM(ACCOUNT_NO)           AS AN,
               TRIM(CUSTOMER_CODE)        AS CC,
               TRIM(TDAPTY)               AS PRODUCT,
               TRIM(TO_CHAR(TDACB))       AS BRANCH,
               TRIM(TDCYCD)               AS CCY,
               TDRLBL, TDDUDT, TDSTDT, TRIM(TDMTIN) AS TDMTIN, TRIM(TDCICM) AS TDCICM, TDCNTR, TDCRSP, TDDTAO,
               ROW_NUMBER() OVER (PARTITION BY TRIM(ACCOUNT_NO) ORDER BY TRIM(CUSTOMER_CODE)) AS RN
          FROM HUB_MT_TDACMSP
    )
    WHERE RN = 1
),
R_DC AS (
    SELECT /*+ MATERIALIZE */ AN, D1HOLM, D1LOLM, D1UOTH, D1LORS, D1HORS, D1UORS, D1ODIA, D1UOIA,
           D1LORT, D1HORT, D1UORT, D1UPRT
    FROM (
        SELECT TRIM(ACCOUNT_NO) AS AN, D1HOLM, D1LOLM, D1UOTH, D1LORS, D1HORS, D1UORS, D1ODIA, D1UOIA,
               TRIM(D1LORT) AS D1LORT, TRIM(D1HORT) AS D1HORT, TRIM(D1UORT) AS D1UORT, TRIM(D1UPRT) AS D1UPRT,
               ROW_NUMBER() OVER (PARTITION BY TRIM(ACCOUNT_NO) ORDER BY NULL) AS RN
          FROM HUB_MT_DCACMSP
    )
    WHERE RN = 1
),
R_CR AS (
    SELECT /*+ MATERIALIZE */ AN, DGCIRT, DGCIRS, DGCRIA
    FROM (
        SELECT TRIM(ACCOUNT_NO) AS AN, TRIM(DGCIRT) AS DGCIRT, DGCIRS, DGCRIA,
               ROW_NUMBER() OVER (PARTITION BY TRIM(ACCOUNT_NO) ORDER BY NULL) AS RN
          FROM HUB_MT_DDCRINP
    )
    WHERE RN = 1
),
R_ST AS (
    SELECT /*+ MATERIALIZE */ AN, DHSMCY
    FROM (
        SELECT TRIM(ACCOUNT_NO) AS AN, TRIM(DHSMCY) AS DHSMCY,
               ROW_NUMBER() OVER (PARTITION BY TRIM(ACCOUNT_NO) ORDER BY NULL) AS RN
          FROM HUB_MT_DDSTMTP
    )
    WHERE RN = 1
),
R_HO AS (
    SELECT /*+ MATERIALIZE */
        TRIM(ACCOUNT_NO)                                         AS AN,
        COUNT(*)                                                 AS N_HOLDS,
        SUM(ABS(X4HDAM))                                         AS HOLD_AMT,
        SUM(CASE WHEN TRIM(X4HDTY) = 'G' THEN ABS(X4HDAM) ELSE 0 END) AS G_AMT
    FROM HUB_MT_SSHOLDP
    GROUP BY TRIM(ACCOUNT_NO)
),
H AS (
    SELECT /*+ MATERIALIZE */ AN, CC, CAT, PRODUCT
    FROM (
        SELECT AN, CC, CAT, PRODUCT,
               ROW_NUMBER() OVER (PARTITION BY AN ORDER BY CAT) AS RN
          FROM (SELECT AN, CC, 'DD' AS CAT, PRODUCT FROM R_DD
                UNION ALL
                SELECT AN, CC, 'TD' AS CAT, PRODUCT FROM R_TD)
    )
    WHERE RN = 1
),
M AS (
    SELECT /*+ MATERIALIZE */
        AN, FILE_NAME, DTS, ERR, E_BRANCH, E_CCY, MTYPE, E_CC, E_OPEN, E_REN, E_STMT, E_LIMIT
    FROM (
        SELECT TRIM(ACCOUNT_NO)                     AS AN,
               TRIM(FILE_NAME)                      AS FILE_NAME,
               DEP_TRANS_STATUS                     AS DTS,
               TRIM(DEP_TRANS_ERR_DESC)             AS ERR,
               TRIM(TO_CHAR(ACC_UNIT_CODE))         AS E_BRANCH,
               TRIM(ACC_ID_CURRENCY)                AS E_CCY,
               TRIM(MG_ACCOUNT_TYPE)                AS MTYPE,
               TRIM(CUSTOMER_CODE)                  AS E_CC,
               OPENING_DATE                         AS E_OPEN,
               TRIM(TO_CHAR(TD_RENEWAL_FLG))        AS E_REN,
               TRIM(TO_CHAR(STATEMENT_ISS_FREQ))    AS E_STMT,
               ACC_LIMIT                            AS E_LIMIT,
               ROW_NUMBER() OVER (PARTITION BY TRIM(ACCOUNT_NO) ORDER BY DEP_TRANS_STATUS, SERIAL_NO) AS RN
          FROM MG_CUST_DPAC_INTER
    )
    WHERE RN = 1
),
MDL AS (
    SELECT /*+ MATERIALIZE */
        TRIM(ACCOUNT_NO)                      AS AN,
        MIN(TRIM(TO_CHAR(DEP_ACC_STATUS)))    AS DSTAT,
        MIN(TRIM(DEP_ERR_DESC))               AS DERR
    FROM MG_DPAC_LOAD
    GROUP BY TRIM(ACCOUNT_NO)
),
AP AS (
    SELECT /*+ MATERIALIZE */
        TRIM(MG_ACCOUNT_TYPE)                 AS MTYPE,
        MIN(TRIM(TO_CHAR(ACCNT_DEP_PROD)))    AS E_PROD,
        MIN(TRIM(TO_CHAR(DB_ID_INTEREST)))    AS E_DBI,
        MIN(TRIM(TO_CHAR(CR_ID_INTEREST)))    AS E_CRI,
        MIN(TRIM(TO_CHAR(STATEMENT_ISS_FREQ))) AS P_STMT
    FROM MG_ACC_PARAMETERS
    WHERE ACCNT_DEP_PROD IS NOT NULL
    GROUP BY TRIM(MG_ACCOUNT_TYPE)
),
PM AS (
    SELECT /*+ MATERIALIZE */ TRIM(HSBC_CODE) AS HSBC_CODE, MIN(TRIM(PRODUCT_TYPE)) AS PRODUCT_TYPE
    FROM MG_HGR_DEPOSITS_PRODUCT_MAPPING
    GROUP BY TRIM(HSBC_CODE)
),
CUS AS (
    SELECT /*+ MATERIALIZE */ TRIM(CUSTOMER_CODE) AS CC, MIN(PRFT_CUST_ID) AS PRFT
    FROM MG_CUSTOMER_INTER
    WHERE ROW_STATUS = 1
      AND PRFT_CUST_ID &gt; 0
    GROUP BY TRIM(CUSTOMER_CODE)
),
FIN AS (
    SELECT /*+ MATERIALIZE */
        AN, F_BOOK, F_BLOCK, F_DBACR, F_CRACR, F_DAYS, F_RATE, F_EXP, F_START, F_IPO
    FROM (
        SELECT TRIM(ACCOUNT_NO)                   AS AN,
               BOOK_BALANCE                       AS F_BOOK,
               BLOCK_BALANCE                      AS F_BLOCK,
               DB_TRANSITION_INTE                 AS F_DBACR,
               TRANSITION_INTER                   AS F_CRACR,
               TRIM(TO_CHAR(CR_DAYSBASE))         AS F_DAYS,
               CR_INTEREST_RATE                   AS F_RATE,
               EXPIRY_DATE                        AS F_EXP,
               START_DATE                         AS F_START,
               TRIM(TO_CHAR(INTER_PAY_OPTIONS))   AS F_IPO,
               ROW_NUMBER() OVER (PARTITION BY TRIM(ACCOUNT_NO) ORDER BY DEP_TRN_STATUS, SERIAL_NO) AS RN
          FROM MG_HGR_MG_DEP_TRN_INTER_KEEP
         WHERE TRN_MIGRATED_TYPE IN (1, 2)
    )
    WHERE RN = 1
),
BLK AS (
    SELECT /*+ MATERIALIZE */
        TRIM(ACCOUNT_NO)                                              AS AN,
        COUNT(*)                                                      AS N_TRX,
        SUM(I_AMOUNT)                                                 AS TRX_ALL,
        SUM(CASE WHEN DEP_TRN_STATUS = 0 THEN I_AMOUNT ELSE 0 END)    AS TRX_OK
    FROM MG_DEP_TRN_INTER
    WHERE TRN_MIGRATED_TYPE = 4
    GROUP BY TRIM(ACCOUNT_NO)
),
ODT AS (
    SELECT /*+ MATERIALIZE */ MIN(PREV_TRX_DATE) AS PREV_TRX_DATE
    FROM BANK_PARAMETERS
),
N AS (
    SELECT /*+ MATERIALIZE */ *
    FROM (
        SELECT TRIM(TO_CHAR(n.ACCOUNT_NUMBER))          AS AN,
               TRIM(TO_CHAR(n.ACCOUNT_TYPE))            AS N_PROD,
               TRIM(n.ACCOUNT_CURRENCY)                 AS N_CCY,
               TRIM(TO_CHAR(n.CUSTOMER_CODE))           AS N_CUST,
               TRIM(TO_CHAR(n.UNIT_CODE))               AS N_BRANCH,
               TRIM(TO_CHAR(n.EXTRAIT_ISSUE_FREQUENCY)) AS N_STMT,
               n.OPEN_DATE                              AS N_OPEN,
               n.OVERDRAFT_LIMIT_AMOUNT                 AS N_LIMIT,
               n.BOOK_BALANCE                           AS N_BOOK,
               TRIM(TO_CHAR(n.TD_RENEWAL_FLAG))         AS N_REN,
               n.BLOCKED_BALANCE                        AS N_BLOCK,
               TRIM(n.TD_MATURITY_INSTRUCTIONS)         AS N_MATI,
               n.AVAILABLE_BALANCE                      AS N_AVAIL,
               n.UNCLEAR_BALANCE                        AS N_UNCLEAR,
               n.CREDIT_INTEREST_ACCRUALS               AS N_CRACR,
               n.DEBIT_INTEREST_ACCRUALS                AS N_DBACR,
               n.OVD_DEBIT_INTEREST_SPREAD              AS N_DBSPR,
               TRIM(TO_CHAR(n.ACCOUNT_STATUS))          AS N_STAT,
               n.TD_INTEREST_RATE                       AS N_RATE,
               n.TD_EXPIRATION_DATE                     AS N_EXP,
               n.TD_START_DATE                          AS N_START,
               TRIM(TO_CHAR(n.DAYS_BASE))               AS N_DAYS,
               n.CREDIT_INTEREST_SPREAD                 AS N_CRSPR,
               -- Το 03_DEPOSITS.sql έχει debit / credit ανάποδα: Debit_Interest_Code = DEPOSIT_ACCOUNT.FK0INTERESTID_INTE,
               -- που κρατά τον CREDIT κωδικό (375xx / TD 320xx), και Credit_Interest_Code = FK1INTERESTID_INTE (debit).
               -- Διαγνωστικό 2026-11-16: σε όλους τους συνδυασμούς NCIS debit = CR_ID_INTEREST και NCIS credit =
               -- DB_ID_INTEREST του MG_ACC_PARAMETERS. Γι' αυτό διαβάζονται ανάποδα (to be confirmed with NC).
               TRIM(TO_CHAR(n.CREDIT_INTEREST_CODE))    AS N_DBI,   -- DEPOSIT_ACCOUNT.FK1INTERESTID_INTE
               TRIM(TO_CHAR(n.DEBIT_INTEREST_CODE))     AS N_CRI,   -- DEPOSIT_ACCOUNT.FK0INTERESTID_INTE
               n.UNAUTHORIZED_INTEREST_ACCRUED          AS N_UNAUTH,
               ROW_NUMBER() OVER (PARTITION BY TRIM(TO_CHAR(n.ACCOUNT_NUMBER)) ORDER BY n.CUSTOMER_CODE) AS RN
          FROM NCIS_Deposits n
    )
    WHERE RN = 1
),
CUR AS (
    -- Δεκαδικά νομίσματος όπως στα scripts: DIV = 100 όταν DISPLAYED_DECIMAL = 2 (30200 / CHS-269),
    -- CDEC = DISPLAYED_DECIMAL για το ROUND του 90000 (accruals). Join με το νόμισμα της μετάπτωσης
    -- (MG_CUST_DPAC_INTER.ACC_ID_CURRENCY, CNY -&gt; CNH), όπως το 90000 με το MG_DPAC_LOAD.ACC_ID_CURRENCY.
    SELECT /*+ MATERIALIZE */ TRIM(SHORT_DESCR) AS SHORT_DESCR,
           MIN(CASE WHEN DISPLAYED_DECIMAL = 2 THEN 100 ELSE 1 END) AS DIV,
           MIN(DISPLAYED_DECIMAL) AS CDEC
    FROM CURRENCY
    GROUP BY TRIM(SHORT_DESCR)
),
B AS (
    SELECT /*+ MATERIALIZE */
        h.AN, h.CC, h.CAT, h.PRODUCT,
        CASE m.FILE_NAME WHEN 'DemandDeposits'    THEN 'DD'
                         WHEN 'OverdraftDeposits' THEN 'OVD'
                         WHEN 'TermDeposits'      THEN 'TD'
                         ELSE h.CAT END                                   AS K,
        m.FILE_NAME, m.MTYPE,
        -- HUB
        COALESCE(dd.BRANCH, td.BRANCH)                                    AS H_BRANCH,
        COALESCE(dd.CCY, td.CCY)                                          AS H_CCY,
        dd.STUS, dd.RSTR, dd.DFRLBL, dd.DFVLBL, dd.DFTTHD, dd.DFDTAO,
        td.TDRLBL, td.TDDUDT, td.TDSTDT, td.TDMTIN, td.TDCICM, td.TDCNTR, td.TDCRSP, td.TDDTAO,
        dc.D1HOLM, dc.D1LOLM, dc.D1UOTH, dc.D1LORS, dc.D1HORS, dc.D1UORS, dc.D1ODIA, dc.D1UOIA,
        cr.DGCIRT, cr.DGCIRS, cr.DGCRIA, st.DHSMCY,
        ho.N_HOLDS, ho.HOLD_AMT, ho.G_AMT,
        cu.DIV, cu.CDEC,
        -- αναμενόμενες τιμές (μόνο από τα scripts)
        m.E_BRANCH, m.E_CCY, m.E_CC, m.E_REN, m.E_STMT, m.E_LIMIT,
        ap.E_PROD, ap.E_DBI, ap.E_CRI, ap.P_STMT,
        cs.PRFT                                                           AS E_PRFT,
        m.E_OPEN                                                          AS X_OPEN,
        od.PREV_TRX_DATE                                                  AS X_OPEN_30205,
        f.F_BOOK, f.F_BLOCK, f.F_DBACR, f.F_CRACR, f.F_DAYS, f.F_RATE, f.F_EXP, f.F_START, f.F_IPO,
        bk.N_TRX, bk.TRX_ALL, bk.TRX_OK,
        -- accruals μετά τη φόρτωση (90000, MG_HGR_TEMP_UPDATE_DEP_ACC_ACRUALS): ROUND(τιμή / 100, DISPLAYED_DECIMAL)
        -- πάνω στην τιμή που φόρτωσε το 30200 (DB_TRANSITION_INTE / TRANSITION_INTER)
        ROUND(f.F_DBACR / 100, cu.CDEC)                                    AS X_DBACR,
        ROUND(f.F_CRACR / 100, cu.CDEC)                                    AS X_CRACR,
        -- unauthorised interest (90000): CHS-269 TRANSITION_EXCESS = D1UOIA / δεκαδικά, μετά το βήμα των
        -- accruals ROUND(TRANSITION_EXCESS / 100, DISPLAYED_DECIMAL) * -1
        ROUND((NVL(TO_NUMBER(dc.D1UOIA), 0) / NVL(cu.DIV, 1)) / 100, cu.CDEC) * -1 AS X_UNAUTH,
        -- status (90000: DFRSTR / DFSTUS, 99 και TD -&gt; 1)
        CASE WHEN h.CAT = 'TD' THEN '1'
             ELSE CASE dd.RSTR || '/' || dd.STUS
                      WHEN '1/1' THEN '1' WHEN '2/1' THEN '1' WHEN '5/1' THEN '1'
                      WHEN '3/1' THEN '2' WHEN '3/2' THEN '2' WHEN '3/3' THEN '2'
                      WHEN '4/1' THEN '5' WHEN '4/2' THEN '5' WHEN '4/3' THEN '5'
                      WHEN '1/2' THEN '6' WHEN '2/2' THEN '6' WHEN '5/2' THEN '6'
                      WHEN '1/3' THEN '8' WHEN '2/3' THEN '8' WHEN '5/3' THEN '8'
                      ELSE '1' END END                                    AS X_STAT,
        -- OVD debit spread (90000 CHS-441)
        CASE WHEN TO_NUMBER(dd.DFRLBL) &gt;= 0 THEN dc.D1LORS
             WHEN TO_NUMBER(dd.DFRLBL) * -1 &lt;= TO_NUMBER(dc.D1LOLM) THEN dc.D1LORS
             WHEN TO_NUMBER(dd.DFRLBL) * -1 &gt;  TO_NUMBER(dc.D1LOLM)
              AND TO_NUMBER(dd.DFRLBL) * -1 &lt;= TO_NUMBER(dc.D1UOTH) THEN dc.D1HORS
             WHEN TO_NUMBER(dd.DFRLBL) * -1 &gt;  TO_NUMBER(dc.D1UOTH) THEN dc.D1UORS
             ELSE dc.D1LORS END                                           AS X_DBSPR,
        -- OVD rate type του HUB που διαλέγει το 30001 (MG_HGR_OVD_RATE_TYPE) με το tier του DFRLBL:
        -- D1LORT / D1HORT / D1UORT / D1UPRT. Μόνο για το HUB_VALUE του DP-020 (όνομα πεδίου = τιμή).
        CASE WHEN TO_NUMBER(dd.DFRLBL) &gt;= 0 THEN 'D1LORT=' || dc.D1LORT
             WHEN TO_NUMBER(dd.DFRLBL) * -1 &lt;= TO_NUMBER(dc.D1LOLM) THEN 'D1LORT=' || dc.D1LORT
             WHEN TO_NUMBER(dd.DFRLBL) * -1 &gt;  TO_NUMBER(dc.D1LOLM)
              AND TO_NUMBER(dd.DFRLBL) * -1 &lt;= TO_NUMBER(dc.D1UOTH) THEN 'D1HORT=' || dc.D1HORT
             WHEN TO_NUMBER(dd.DFRLBL) * -1 &gt;  TO_NUMBER(dc.D1UOTH)
              AND TO_NUMBER(dd.DFRLBL) * -1 &lt;= TO_NUMBER(dc.D1HOLM) THEN 'D1UORT=' || dc.D1UORT
             WHEN TO_NUMBER(dd.DFRLBL) * -1 &gt;  TO_NUMBER(dc.D1HOLM) THEN 'D1UPRT=' || dc.D1UPRT
             ELSE 'RATE_TYPE=' END                                        AS H_OVD_RT,
        -- credit spread (90000 CHS-421): DDCRINP.DGCIRS, αλλιώς TD TDCRSP
        CASE WHEN cr.AN IS NOT NULL THEN cr.DGCIRS
             WHEN td.AN IS NOT NULL THEN td.TDCRSP END                    AS X_CRSPR,
        CASE WHEN cr.AN IS NOT NULL THEN 'DGCIRS'
             WHEN td.AN IS NOT NULL THEN 'TDCRSP' END                     AS X_CRSPR_SRC,
        -- TD maturity instructions: INTER_PAY_OPTIONS (30200 / 30205) -&gt; κείμενο του NCIS extract
        CASE f.F_IPO WHEN '0' THEN 'Interest Capitalization'
                     WHEN '1' THEN 'Transfer to service account'
                     WHEN '2' THEN 'Cash'
                     WHEN '3' THEN 'Cheque'
                     WHEN '4' THEN 'SWIFT' END                            AS X_MATI,
        -- NCIS
        n.N_PROD, n.N_CCY, n.N_CUST, n.N_BRANCH, n.N_STMT, n.N_OPEN, n.N_LIMIT, n.N_BOOK, n.N_REN,
        n.N_BLOCK, n.N_MATI, n.N_AVAIL, n.N_UNCLEAR, n.N_CRACR, n.N_DBACR, n.N_DBSPR, n.N_STAT, n.N_RATE,
        n.N_EXP, n.N_START, n.N_DAYS, n.N_CRSPR, n.N_DBI, n.N_CRI, n.N_UNAUTH
    FROM H h
    JOIN N n          ON n.AN = h.AN
    LEFT JOIN R_DD dd ON dd.AN = h.AN AND h.CAT = 'DD'
    LEFT JOIN R_TD td ON td.AN = h.AN AND h.CAT = 'TD'
    LEFT JOIN R_DC dc ON dc.AN = h.AN
    LEFT JOIN R_CR cr ON cr.AN = h.AN
    LEFT JOIN R_ST st ON st.AN = h.AN
    LEFT JOIN R_HO ho ON ho.AN = h.AN
    LEFT JOIN M m     ON m.AN = h.AN
    LEFT JOIN CUR cu  ON cu.SHORT_DESCR = COALESCE(m.E_CCY, dd.CCY, td.CCY)
    LEFT JOIN AP ap   ON ap.MTYPE = m.MTYPE
    LEFT JOIN CUS cs  ON cs.CC = m.E_CC
    CROSS JOIN ODT od
    LEFT JOIN FIN f   ON f.AN = h.AN
    LEFT JOIN BLK bk  ON bk.AN = h.AN
),
FINDINGS AS (
    -- Μία γραμμή ανά εύρημα. CUSTOMER_CODE = πελάτης HUB (DDACMSP / TDACMSP.CUSTOMER_CODE),
    -- SERIAL_NO = αριθμός λογαριασμού (ACCOUNT_NO). HUB_VALUE = τιμή όπως είναι στον HUB πίνακα,
    -- NCIS_VALUE = τιμή του NCIS_Deposits. Η αναμενόμενη τιμή (μόνο από τα scripts) στο ISSUE.
    --==============================================================
    --DP-001. Λογαριασμός HUB (DD / OVD / TD) που δεν υπάρχει στο NCIS. ISSUE = αιτία από MG_CUST_DPAC_INTER / MG_DPAC_LOAD
    SELECT
      CAST('DP-001_ACCOUNT_MISSING_IN_NCIS' AS VARCHAR2(50)) AS CHECK_NAME,
      CAST(h.CC AS VARCHAR2(40)) AS CUSTOMER_CODE, CAST(h.AN AS VARCHAR2(40)) AS SERIAL_NO,
      CAST(h.CAT || '; PRODUCT=' || h.PRODUCT AS VARCHAR2(200)) AS HUB_VALUE,
      CAST(NULL AS VARCHAR2(200)) AS NCIS_VALUE,
      CAST(SUBSTR(
        CASE WHEN m.AN IS NULL THEN 'NOT_SENT_BY_MIGRATION'
             WHEN m.DTS = 2 AND m.ERR = 'UNMAPPED_PRODUCTS' AND pm.HSBC_CODE IS NOT NULL
                  THEN 'PRODUCT_MAPPED_' || pm.PRODUCT_TYPE || '_BUT_NOT_SENT'
             WHEN m.DTS = 2 AND m.ERR = 'UNMAPPED_PRODUCTS' THEN 'UNMAPPED_PRODUCT (' || h.PRODUCT || ')'
             WHEN NVL(m.DTS, 0) &lt;&gt; 0 THEN 'REJECTED: ' || NVL(m.ERR, 'STATUS ' || TO_CHAR(m.DTS))
             WHEN d.AN IS NULL THEN 'NOT_IN_MG_DPAC_LOAD'
             ELSE 'MG_DPAC_LOAD STATUS ' || d.DSTAT || ': ' || NVL(d.DERR, '-') END, 1, 50) AS VARCHAR2(50)) AS ISSUE
    FROM H h
    LEFT JOIN N n   ON n.AN = h.AN
    LEFT JOIN M m   ON m.AN = h.AN
    LEFT JOIN MDL d ON d.AN = h.AN
    LEFT JOIN PM pm ON pm.HSBC_CODE = h.PRODUCT
    WHERE n.AN IS NULL
    UNION ALL
    --==============================================================
    --DP-002. Λογαριασμός NCIS που δεν υπάρχει στο HUB (ούτε DDACMSP ούτε TDACMSP)
    SELECT 'DP-002_ACCOUNT_MISSING_IN_HUB', CAST(NULL AS VARCHAR2(40)), n.AN, CAST(NULL AS VARCHAR2(200)),
           'CUST_ID=' || n.N_CUST || '; TYPE=' || n.N_PROD, 'NOT_IN_HUB_DD_OR_TD'
    FROM N n
    LEFT JOIN H h ON h.AN = n.AN
    WHERE h.AN IS NULL
    UNION ALL
    --==============================================================
    --DP-003. Branch: MG_CUST_DPAC_INTER.ACC_UNIT_CODE (DFACB / TDACB) vs NCIS Unit_Code
    SELECT 'DP-003_BRANCH_MISMATCH', CC, AN, H_BRANCH, N_BRANCH,
           SUBSTR('MISMATCH (EXPECTED ' || NVL(E_BRANCH, 'EMPTY') || ')', 1, 50)
    FROM B
    WHERE NVL(N_BRANCH, 'X') &lt;&gt; NVL(E_BRANCH, 'X')
    UNION ALL
    --==============================================================
    --DP-004. Product: MG_ACC_PARAMETERS.ACCNT_DEP_PROD του MG_ACCOUNT_TYPE (30001) vs NCIS Account_Type.
    --        HUB_VALUE: το προϊόν του HUB από το οποίο προκύπτει (DFAPTY / TDAPTY, product mapping)
    SELECT 'DP-004_PRODUCT_MISMATCH', CC, AN,
           CASE WHEN CAT = 'TD' THEN 'TDAPTY=' ELSE 'DFAPTY=' END || PRODUCT, N_PROD,
           CASE WHEN E_PROD IS NULL THEN SUBSTR('NO_ACC_PARAMETERS (SENT ' || NVL(MTYPE, 'EMPTY') || ')', 1, 50)
                ELSE SUBSTR('MISMATCH (EXPECTED ' || E_PROD || ')', 1, 50) END
    FROM B
    WHERE NVL(N_PROD, 'X') &lt;&gt; NVL(E_PROD, 'X')
    UNION ALL
    --==============================================================
    --DP-005. Currency: MG_CUST_DPAC_INTER.ACC_ID_CURRENCY (DFCYCD / TDCYCD, CNY -&gt; CNH) vs NCIS Account_Currency
    SELECT 'DP-005_CURRENCY_MISMATCH', CC, AN, H_CCY, N_CCY,
           SUBSTR('MISMATCH (EXPECTED ' || NVL(E_CCY, 'EMPTY') || ')', 1, 50)
    FROM B
    WHERE NVL(N_CCY, 'X') &lt;&gt; NVL(E_CCY, 'X')
    UNION ALL
    --==============================================================
    --DP-006. TD days base: CR_DAYSBASE (30200, TDCICM A/B -&gt; 360, C-F -&gt; 365) vs NCIS Days_Base
    SELECT 'DP-006_TD_DAYS_BASE_MISMATCH', CC, AN, 'TDCICM=' || TDCICM, N_DAYS,
           SUBSTR('MISMATCH (EXPECTED ' || NVL(F_DAYS, 'EMPTY') || ')', 1, 50)
    FROM B
    WHERE K = 'TD'
      AND NVL(N_DAYS, 'X') &lt;&gt; NVL(F_DAYS, 'X')
    UNION ALL
    --==============================================================
    --DP-007. Customer: PRFT_CUST_ID του MG_CUST_DPAC_INTER.CUSTOMER_CODE (μετά τον joint redirect του 30001) vs NCIS Customer_Code
    SELECT 'DP-007_CUSTOMER_CODE_MISMATCH', CC, AN, CC, N_CUST,
           CASE WHEN E_PRFT IS NULL THEN SUBSTR('CUSTOMER_NOT_LOADED (SENT ' || NVL(E_CC, 'EMPTY') || ')', 1, 50)
                ELSE SUBSTR('MISMATCH (EXPECTED ' || TO_CHAR(E_PRFT) || ')', 1, 50) END
    FROM B
    WHERE NVL(N_CUST, 'X') &lt;&gt; NVL(TO_CHAR(E_PRFT), 'X')
    UNION ALL
    --==============================================================
    --DP-008. Status: DD από DFRSTR / DFSTUS (πίνακας του 90000, 99 -&gt; 1), TD -&gt; 1, vs NCIS Account_Status
    SELECT 'DP-008_STATUS_MISMATCH', CC, AN,
           CASE WHEN K = 'TD' THEN 'TD' ELSE 'DFRSTR=' || RSTR || '; DFSTUS=' || STUS END, N_STAT,
           'MISMATCH (EXPECTED ' || X_STAT || ')'
    FROM B
    WHERE NVL(N_STAT, 'X') &lt;&gt; X_STAT
    UNION ALL
    --==============================================================
    --DP-009. Opening date: MG_CUST_DPAC_INTER.OPENING_DATE (DFDTAO / TDDTAO), ή PREV_TRX_DATE
    --        (BANK_PARAMETERS) όπου το 30205 τη μετακίνησε για ADATE_LESS_OPEN_DATE - δεκτές και οι δύο.
    --        HUB_VALUE: DFDTAO / TDDTAO όπως είναι στο HUB (2026-11-16), η τιμή της μετάπτωσης στο ISSUE.
    SELECT 'DP-009_OPEN_DATE_MISMATCH', CC, AN,
           CASE WHEN CAT = 'TD' THEN 'TDDTAO=' || TRIM(TO_CHAR(TDDTAO)) ELSE 'DFDTAO=' || TRIM(TO_CHAR(DFDTAO)) END,
           TO_CHAR(N_OPEN, 'YYYY-MM-DD'),
           CASE WHEN X_OPEN IS NULL THEN 'MISMATCH (EXPECTED EMPTY)'
                ELSE 'MISMATCH (EXPECTED ' || TO_CHAR(X_OPEN, 'YYYY-MM-DD') || ')' END
    FROM B
    WHERE NVL(TRUNC(N_OPEN), DATE '1900-01-01') &lt;&gt; NVL(TRUNC(X_OPEN), DATE '1900-01-01')
      AND NVL(TRUNC(N_OPEN), DATE '1900-01-01') &lt;&gt; NVL(TRUNC(X_OPEN_30205), DATE '1900-01-02')
    UNION ALL
    --==============================================================
    --DP-010. TD expiration date: EXPIRY_DATE (30200, TDDUDT) vs NCIS TD_Expiration_Date
    SELECT 'DP-010_TD_EXPIRATION_DATE_MISMATCH', CC, AN, TRIM(TO_CHAR(TDDUDT)), TO_CHAR(N_EXP, 'YYYY-MM-DD'),
           'MISMATCH (EXPECTED ' || NVL(TO_CHAR(F_EXP, 'YYYY-MM-DD'), 'EMPTY') || ')'
    FROM B
    WHERE K = 'TD'
      AND NVL(TRUNC(N_EXP), DATE '1900-01-01') &lt;&gt; NVL(TRUNC(F_EXP), DATE '1900-01-01')
    UNION ALL
    --==============================================================
    --DP-011. TD start date: START_DATE (30200, TDSTDT) vs NCIS TD_Start_Date
    SELECT 'DP-011_TD_START_DATE_MISMATCH', CC, AN, TRIM(TO_CHAR(TDSTDT)), TO_CHAR(N_START, 'YYYY-MM-DD'),
           'MISMATCH (EXPECTED ' || NVL(TO_CHAR(F_START, 'YYYY-MM-DD'), 'EMPTY') || ')'
    FROM B
    WHERE K = 'TD'
      AND NVL(TRUNC(N_START), DATE '1900-01-01') &lt;&gt; NVL(TRUNC(F_START), DATE '1900-01-01')
    UNION ALL
    --==============================================================
    --DP-012. TD renewal flag: TD_RENEWAL_FLG (30001, TDMTIN 1/2 -&gt; 1, αλλιώς 0) vs NCIS TD_Renewal_Flag
    SELECT 'DP-012_TD_RENEWAL_FLAG_MISMATCH', CC, AN, 'TDMTIN=' || TDMTIN, N_REN,
           'MISMATCH (EXPECTED ' || NVL(E_REN, 'EMPTY') || ')'
    FROM B
    WHERE K = 'TD'
      AND NVL(N_REN, 'X') &lt;&gt; NVL(E_REN, 'X')
    UNION ALL
    --==============================================================
    --DP-013. TD maturity instructions: INTER_PAY_OPTIONS (30200 + διορθώσεις 30205) vs NCIS TD_Maturity_Instructions
    SELECT 'DP-013_TD_MATURITY_INSTR_MISMATCH', CC, AN, 'TDMTIN=' || TDMTIN, N_MATI,
           SUBSTR('MISMATCH (EXPECTED ' || CASE WHEN F_IPO IS NULL THEN 'EMPTY' ELSE F_IPO || '=' || NVL(X_MATI, '?') END || ')', 1, 50)
    FROM B
    WHERE K = 'TD'
      AND NVL(N_MATI, 'X') &lt;&gt; NVL(X_MATI, 'X')
    UNION ALL
    --==============================================================
    --DP-014. Book balance: BOOK_BALANCE (30200, DFRLBL / TDRLBL με δεκαδικά νομίσματος) vs NCIS BOOK_BALANCE
    SELECT 'DP-014_BOOK_BALANCE_MISMATCH', CC, AN, TRIM(TO_CHAR(COALESCE(DFRLBL, TDRLBL))), TO_CHAR(N_BOOK),
           SUBSTR('MISMATCH (EXPECTED ' || NVL(TO_CHAR(F_BOOK), 'EMPTY') || ')', 1, 50)
    FROM B
    WHERE ABS(NVL(N_BOOK, 0) - NVL(F_BOOK, 0)) &gt; 0.005
       OR (F_BOOK IS NULL AND N_BOOK IS NOT NULL AND N_BOOK &lt;&gt; 0)
    UNION ALL
    --==============================================================
    --DP-015. Blocked balance: άθροισμα των block transactions του 30200 (MG_DEP_TRN_INTER TRN_MIGRATED_TYPE 4,
    --        ένα ανά hold του SSHOLDP με X4HDAM &lt;&gt; 0, μαζί με τα G) vs NCIS BLOCKED_BALANCE.
    --        Το BLOCK_BALANCE της γραμμής financial (DFTTHD - holds G) δεν χρησιμοποιείται: στο run DC5 της
    --        2026-11-16 το PROFITS είχε σε όλους τους λογαριασμούς με διαφορά το άθροισμα των block transactions
    --        και σε κανέναν τη γραμμή financial (απόφαση χρήστη 2026-11-16, αντικαθιστά τις δύο αναμενόμενες τιμές).
    SELECT 'DP-015_BLOCKED_BALANCE_MISMATCH', CC, AN,
           SUBSTR('DFTTHD=' || TRIM(TO_CHAR(DFTTHD)) || '; HOLDS=' || TO_CHAR(NVL(HOLD_AMT, 0)) || '; G=' || TO_CHAR(NVL(G_AMT, 0)), 1, 200),
           TO_CHAR(N_BLOCK),
           SUBSTR('MISMATCH (EXPECTED ' || TO_CHAR(NVL(TRX_ALL, 0)) || ')', 1, 50)
    FROM B
    WHERE ABS(NVL(N_BLOCK, 0) - NVL(TRX_ALL, 0)) &gt; 0.005
    UNION ALL
    --==============================================================
    --DP-016. Available balance DD / OVD: κανόνας 90000 (UNCLEAR AMOUNTS, CHS-431)
    --        AVAILABLE_BALANCE = BOOK_BALANCE - BLOCKED_BALANCE - UNCLEAR_BALANCE, με τα ποσά του PROFITS
    --        (book / blocked ελέγχονται vs HUB στα DP-014 / DP-015). Το 90000 κάνει το update μόνο σε λογαριασμούς
    --        με holds τύπου G (SSHOLDP X4HDTY = 'G') -&gt; ISSUE 'MISMATCH G'. Στους υπόλοιπους το available το βάζει
    --        το loader: 'MISMATCH' = ο ίδιος κανόνας δεν ισχύει, to be confirmed with NC.
    --        HUB_VALUE: DFVLBL (κανόνας DC4, μόνο για πληροφορία) και holds G, όπως στο HUB (ελάχιστες μονάδες).
    SELECT 'DP-016_AVAILABLE_BALANCE_MISMATCH', CC, AN,
           SUBSTR('DFVLBL=' || TRIM(TO_CHAR(DFVLBL)) || '; G_HOLDS=' || TO_CHAR(NVL(G_AMT, 0)), 1, 200),
           SUBSTR(TO_CHAR(N_AVAIL) || '; BOOK=' || TO_CHAR(N_BOOK) || '; BLOCKED=' || TO_CHAR(N_BLOCK)
                  || '; UNCLEAR=' || TO_CHAR(N_UNCLEAR), 1, 200),
           SUBSTR(CASE WHEN NVL(G_AMT, 0) &lt;&gt; 0 THEN 'MISMATCH G (EXPECTED ' ELSE 'MISMATCH (EXPECTED ' END
                  || TO_CHAR(NVL(N_BOOK, 0) - NVL(N_BLOCK, 0) - NVL(N_UNCLEAR, 0)) || ')', 1, 50)
    FROM B
    WHERE K IN ('DD', 'OVD')
      AND ABS(NVL(N_AVAIL, 0) - (NVL(N_BOOK, 0) - NVL(N_BLOCK, 0) - NVL(N_UNCLEAR, 0))) &gt; 0.005
    UNION ALL
    --==============================================================
    --DP-017. OVD unauthorized interest: 90000 CHS-269 (TRANSITION_EXCESS = D1UOIA / δεκαδικά) και μετά το βήμα των
    --        accruals (ROUND(/ 100, DISPLAYED_DECIMAL) * -1) vs NCIS Unauthorized_Interest_Accrued. Τελική κατάσταση
    --        μετά το 90000 (απόφαση χρήστη 2026-11-16). Επιβεβαιώνεται από το DC4 (ROUND(ABS(D1UOIA)/100,0)/100).
    SELECT 'DP-017_OVD_UNAUTH_INTEREST_MISMATCH', CC, AN, TRIM(TO_CHAR(D1UOIA)), TO_CHAR(N_UNAUTH),
           SUBSTR('MISMATCH (EXPECTED ' || NVL(TO_CHAR(X_UNAUTH), 'EMPTY') || ')', 1, 50)
    FROM B
    WHERE K = 'OVD'
      AND ABS(NVL(N_UNAUTH, 0) - NVL(X_UNAUTH, 0)) &gt; 0.005
    UNION ALL
    --==============================================================
    --DP-018. Debit interest accruals DD / OVD: DB_TRANSITION_INTE (30200, D1ODIA + D1UOIA) και μετά 90000
    --        ROUND(/ 100, DISPLAYED_DECIMAL) vs NCIS Debit_Interest_Accruals. Τελική κατάσταση μετά το 90000.
    SELECT 'DP-018_DEBIT_INT_ACCRUALS_MISMATCH', CC, AN,
           SUBSTR('D1ODIA=' || TRIM(TO_CHAR(D1ODIA)) || '; D1UOIA=' || TRIM(TO_CHAR(D1UOIA)), 1, 200), TO_CHAR(N_DBACR),
           SUBSTR('MISMATCH (EXPECTED ' || NVL(TO_CHAR(X_DBACR), 'EMPTY') || ')', 1, 50)
    FROM B
    WHERE K IN ('DD', 'OVD')
      AND ABS(NVL(N_DBACR, 0) - NVL(X_DBACR, 0)) &gt; 0.005
    UNION ALL
    --==============================================================
    --DP-019. Credit interest accruals DD / OVD: TRANSITION_INTER (30200, DGCRIA) και μετά 90000
    --        ROUND(/ 100, DISPLAYED_DECIMAL) vs NCIS Credit_Interest_Accruals (ACCR_CR_INTEREST). Τελική κατάσταση
    --        μετά το 90000. Επιβεβαιώνεται από το DC4 (ROUND(ABS(DGCRIA)/100,0)/100).
    SELECT 'DP-019_CREDIT_INT_ACCRUALS_MISMATCH', CC, AN, TRIM(TO_CHAR(DGCRIA)), TO_CHAR(N_CRACR),
           SUBSTR('MISMATCH (EXPECTED ' || NVL(TO_CHAR(X_CRACR), 'EMPTY') || ')', 1, 50)
    FROM B
    WHERE K IN ('DD', 'OVD')
      AND ABS(NVL(N_CRACR, 0) - NVL(X_CRACR, 0)) &gt; 0.005
    UNION ALL
    --==============================================================
    --DP-020. Debit interest code: MG_ACC_PARAMETERS.DB_ID_INTEREST (30001) vs NCIS Credit_Interest_Code
    --        (= DEPOSIT_ACCOUNT.FK1INTERESTID_INTE, οι στήλες του NCIS extract είναι ανάποδα, βλ. CTE N)
    --        HUB_VALUE: DD -&gt; DFAPTY (default του προϊόντος), OVD -&gt; rate type του tier (MG_HGR_DEPOSITS_DR_ID_INTEREST)
    --        μαζί με το DFRLBL, TD -&gt; TDAPTY (default του προϊόντος)
    SELECT 'DP-020_DEBIT_INTEREST_CODE_MISMATCH', CC, AN,
           SUBSTR(CASE WHEN K = 'OVD' THEN H_OVD_RT || '; DFRLBL=' || TRIM(TO_CHAR(DFRLBL))
                       WHEN CAT = 'TD' THEN 'TDAPTY=' || PRODUCT
                       ELSE 'DFAPTY=' || PRODUCT END, 1, 200), N_DBI,
           SUBSTR('MISMATCH (EXPECTED ' || NVL(E_DBI, 'EMPTY') || ')', 1, 50)
    FROM B
    WHERE NVL(N_DBI, 'X') &lt;&gt; NVL(E_DBI, 'X')
    UNION ALL
    --==============================================================
    --DP-021. Credit interest code: MG_ACC_PARAMETERS.CR_ID_INTEREST (30001) vs NCIS Debit_Interest_Code
    --        (= DEPOSIT_ACCOUNT.FK0INTERESTID_INTE, οι στήλες του NCIS extract είναι ανάποδα, βλ. CTE N)
    --        HUB_VALUE: DD / OVD -&gt; DGCIRT (MG_HGR_DEPOSITS_CR_ID_INTEREST), TD -&gt; TDAPTY (default του προϊόντος)
    SELECT 'DP-021_CREDIT_INTEREST_CODE_MISMATCH', CC, AN,
           CASE WHEN CAT = 'TD' THEN 'TDAPTY=' || PRODUCT ELSE 'DGCIRT=' || DGCIRT END, N_CRI,
           SUBSTR('MISMATCH (EXPECTED ' || NVL(E_CRI, 'EMPTY') || ')', 1, 50)
    FROM B
    WHERE NVL(N_CRI, 'X') &lt;&gt; NVL(E_CRI, 'X')
    UNION ALL
    --==============================================================
    --DP-022. OVD limit: MG_CUST_DPAC_INTER.ACC_LIMIT (30001, D1HOLM με δεκαδικά νομίσματος) vs NCIS Overdraft_Limit_Amount
    SELECT 'DP-022_OVD_LIMIT_MISMATCH', CC, AN, TRIM(TO_CHAR(D1HOLM)), TO_CHAR(N_LIMIT),
           SUBSTR('MISMATCH (EXPECTED ' || NVL(TO_CHAR(E_LIMIT), 'EMPTY') || ')', 1, 50)
    FROM B
    WHERE K = 'OVD'
      AND ABS(NVL(N_LIMIT, 0) - NVL(E_LIMIT, 0)) &gt; 0.005
    UNION ALL
    --==============================================================
    --DP-023. Statement frequency DD / OVD: MG_CUST_DPAC_INTER.STATEMENT_ISS_FREQ (DHSMCY M/Q/H/Y -&gt; 10/12/13/14, αλλιώς 0)
    --        vs NCIS Extrait_Issue_Frequency. Το MG_ACC_PARAMETERS του προϊόντος έχει επίσης 13 (30001).
    SELECT 'DP-023_STATEMENT_FREQ_MISMATCH', CC, AN, 'DHSMCY=' || DHSMCY, N_STMT,
           SUBSTR(CASE WHEN NVL(N_STMT, 'X') = NVL(P_STMT, 'Y') THEN 'MATCHES_PRODUCT_PARAM (EXPECTED ' || NVL(E_STMT, 'EMPTY') || ')'
                       ELSE 'MISMATCH (EXPECTED ' || NVL(E_STMT, 'EMPTY') || ')' END, 1, 50)
    FROM B
    WHERE K IN ('DD', 'OVD')
      AND NVL(N_STMT, 'X') &lt;&gt; NVL(E_STMT, 'X')
    UNION ALL
    --==============================================================
    --DP-024. TD interest rate: CR_INTEREST_RATE (30200, TDCNTR) vs NCIS TD_Interest_Rate
    SELECT 'DP-024_TD_INTEREST_RATE_MISMATCH', CC, AN, TRIM(TO_CHAR(TDCNTR)), TO_CHAR(N_RATE),
           SUBSTR('MISMATCH (EXPECTED ' || NVL(TO_CHAR(F_RATE), 'EMPTY') || ')', 1, 50)
    FROM B
    WHERE K = 'TD'
      AND ABS(NVL(N_RATE, 0) - NVL(F_RATE, 0)) &gt; 0.00005
    UNION ALL
    --==============================================================
    --DP-025. OVD debit spread: tiering του 90000 CHS-441 (D1LORS / D1HORS / D1UORS) vs NCIS OVD_Debit_Interest_Spread
    SELECT 'DP-025_OVD_DEBIT_SPREAD_MISMATCH', CC, AN,
           SUBSTR('DFRLBL=' || TRIM(TO_CHAR(DFRLBL)) || '; D1LORS=' || TRIM(TO_CHAR(D1LORS)) || '; D1HORS=' || TRIM(TO_CHAR(D1HORS))
                  || '; D1UORS=' || TRIM(TO_CHAR(D1UORS)), 1, 200), TO_CHAR(N_DBSPR),
           SUBSTR('MISMATCH (EXPECTED ' || NVL(TRIM(TO_CHAR(X_DBSPR)), 'EMPTY') || ')', 1, 50)
    FROM B
    WHERE K = 'OVD'
      AND ABS(NVL(N_DBSPR, 0) - NVL(TO_NUMBER(X_DBSPR), 0)) &gt; 0.00005
    UNION ALL
    --==============================================================
    --DP-026. Credit spread: 90000 CHS-421 (DDCRINP.DGCIRS, αλλιώς TD TDCRSP) vs NCIS Credit_Interest_Spread.
    --        Μόνο λογαριασμοί για τους οποίους το script ορίζει τιμή.
    SELECT 'DP-026_CREDIT_SPREAD_MISMATCH', CC, AN, X_CRSPR_SRC || '=' || TRIM(TO_CHAR(X_CRSPR)), TO_CHAR(N_CRSPR),
           SUBSTR('MISMATCH (EXPECTED ' || TRIM(TO_CHAR(X_CRSPR)) || ')', 1, 50)
    FROM B
    WHERE X_CRSPR_SRC IS NOT NULL
      AND ABS(NVL(N_CRSPR, 0) - NVL(TO_NUMBER(X_CRSPR), 0)) &gt; 0.00005
)
,
POPULATIONS AS (
    SELECT
        (SELECT COUNT(*) FROM H)                                       AS HUB_ACC_COUNT,
        (SELECT COUNT(*) FROM N)                                       AS NCIS_ACC_COUNT,
        (SELECT COUNT(*) FROM B)                                       AS MATCHED_ALL_COUNT,
        (SELECT COUNT(*) FROM B WHERE K IN ('DD', 'OVD'))              AS MATCHED_DDOVD_COUNT,
        (SELECT COUNT(*) FROM B WHERE K = 'OVD')                       AS MATCHED_OVD_COUNT,
        (SELECT COUNT(*) FROM B WHERE K = 'TD')                        AS MATCHED_TD_COUNT,
        (SELECT COUNT(*) FROM B WHERE X_CRSPR_SRC IS NOT NULL)         AS CRSPR_COUNT
    FROM DUAL
),
CHECK_META AS (
    -- CHECK_ID | CHECK_NAME | CATEGORY | DESCRIPTION | POPULATION_TYPE
    SELECT 'DP-001' AS CHECK_ID, 'DP-001_ACCOUNT_MISSING_IN_NCIS' AS CHECK_NAME, 'EXISTENCE' AS CATEGORY, 'HUB demand, overdraft and term deposit accounts that are not in PROFITS. The detail rows give the reason from the migration tables.' AS DESCRIPTION, 'HUB_ACC' AS POPULATION_TYPE FROM DUAL UNION ALL
    SELECT 'DP-002', 'DP-002_ACCOUNT_MISSING_IN_HUB',            'EXISTENCE',             'Deposit accounts in PROFITS that are not demand, overdraft or term deposit accounts in HUB.', 'NCIS_ACC' FROM DUAL UNION ALL
    SELECT 'DP-003', 'DP-003_BRANCH_MISMATCH',                   'CROSS_SYSTEM_MISMATCH', 'The branch of the account in PROFITS differs from the HUB branch the migration sent.', 'MATCHED_ALL' FROM DUAL UNION ALL
    SELECT 'DP-004', 'DP-004_PRODUCT_MISMATCH',                  'CROSS_SYSTEM_MISMATCH', 'The PROFITS product of the account differs from the product the migration set for its HUB product, currency and interest type.', 'MATCHED_ALL' FROM DUAL UNION ALL
    SELECT 'DP-005', 'DP-005_CURRENCY_MISMATCH',                 'CROSS_SYSTEM_MISMATCH', 'The account currency in PROFITS differs from the HUB currency the migration sent (CNY sent as CNH).', 'MATCHED_ALL' FROM DUAL UNION ALL
    SELECT 'DP-006', 'DP-006_TD_DAYS_BASE_MISMATCH',             'CROSS_SYSTEM_MISMATCH', 'Term deposits: the interest days base in PROFITS differs from the 360 or 365 the migration set from the HUB interest method.', 'MATCHED_TD' FROM DUAL UNION ALL
    SELECT 'DP-007', 'DP-007_CUSTOMER_CODE_MISMATCH',            'CROSS_SYSTEM_MISMATCH', 'The account holder in PROFITS is not the migrated customer the migration linked to the account (joint accounts moved to their main holder).', 'MATCHED_ALL' FROM DUAL UNION ALL
    SELECT 'DP-008', 'DP-008_STATUS_MISMATCH',                   'CROSS_SYSTEM_MISMATCH', 'The account status in PROFITS differs from the status the migration set from the HUB restriction and status codes (term deposits: active).', 'MATCHED_ALL' FROM DUAL UNION ALL
    SELECT 'DP-009', 'DP-009_OPEN_DATE_MISMATCH',                'CROSS_SYSTEM_MISMATCH', 'The opening date in PROFITS differs from the HUB opening date the migration sent, or the previous business day where the migration moved it.', 'MATCHED_ALL' FROM DUAL UNION ALL
    SELECT 'DP-010', 'DP-010_TD_EXPIRATION_DATE_MISMATCH',       'CROSS_SYSTEM_MISMATCH', 'Term deposits: the maturity date in PROFITS differs from the HUB due date the migration sent.', 'MATCHED_TD' FROM DUAL UNION ALL
    SELECT 'DP-011', 'DP-011_TD_START_DATE_MISMATCH',            'CROSS_SYSTEM_MISMATCH', 'Term deposits: the start date in PROFITS differs from the HUB start date the migration sent.', 'MATCHED_TD' FROM DUAL UNION ALL
    SELECT 'DP-012', 'DP-012_TD_RENEWAL_FLAG_MISMATCH',          'CROSS_SYSTEM_MISMATCH', 'Term deposits: the renewal flag in PROFITS differs from the flag the migration set from the HUB maturity instruction.', 'MATCHED_TD' FROM DUAL UNION ALL
    SELECT 'DP-013', 'DP-013_TD_MATURITY_INSTR_MISMATCH',        'CROSS_SYSTEM_MISMATCH', 'Term deposits: the interest payment option in PROFITS differs from the option the migration set from the HUB maturity instruction.', 'MATCHED_TD' FROM DUAL UNION ALL
    SELECT 'DP-014', 'DP-014_BOOK_BALANCE_MISMATCH',             'CROSS_SYSTEM_MISMATCH', 'The book balance in PROFITS differs from the HUB ledger balance the migration sent, in currency units.', 'MATCHED_ALL' FROM DUAL UNION ALL
    SELECT 'DP-015', 'DP-015_BLOCKED_BALANCE_MISMATCH',          'CROSS_SYSTEM_MISMATCH', 'The blocked balance in PROFITS differs from the sum of the HUB hold records the migration sent as block transactions.', 'MATCHED_ALL' FROM DUAL UNION ALL
    SELECT 'DP-016', 'DP-016_AVAILABLE_BALANCE_MISMATCH',        'CROSS_SYSTEM_MISMATCH', 'Demand and overdraft accounts: available balance in PROFITS is not book balance minus blocked and uncleared amounts, the rule the migration applies after loading.', 'MATCHED_DDOVD' FROM DUAL UNION ALL
    SELECT 'DP-017', 'DP-017_OVD_UNAUTH_INTEREST_MISMATCH',      'CROSS_SYSTEM_MISMATCH', 'Overdrafts: unauthorised interest accrued in PROFITS differs from the HUB amount as the migration sets it after loading (divided by 100, sign reversed).', 'MATCHED_OVD' FROM DUAL UNION ALL
    SELECT 'DP-018', 'DP-018_DEBIT_INT_ACCRUALS_MISMATCH',       'CROSS_SYSTEM_MISMATCH', 'Demand and overdraft accounts: debit interest accrued in PROFITS differs from the HUB debit interest the migration sent, divided by 100 after loading.', 'MATCHED_DDOVD' FROM DUAL UNION ALL
    SELECT 'DP-019', 'DP-019_CREDIT_INT_ACCRUALS_MISMATCH',      'CROSS_SYSTEM_MISMATCH', 'Demand and overdraft accounts: credit interest accrued in PROFITS differs from the HUB credit interest the migration sent, divided by 100 after loading.', 'MATCHED_DDOVD' FROM DUAL UNION ALL
    SELECT 'DP-020', 'DP-020_DEBIT_INTEREST_CODE_MISMATCH',      'CROSS_SYSTEM_MISMATCH', 'The debit interest code in PROFITS differs from the code the migration set for the account product. NCIS extract has debit and credit codes swapped, to be confirmed with NC.', 'MATCHED_ALL' FROM DUAL UNION ALL
    SELECT 'DP-021', 'DP-021_CREDIT_INTEREST_CODE_MISMATCH',     'CROSS_SYSTEM_MISMATCH', 'The credit interest code in PROFITS differs from the code the migration set for the account product. NCIS extract has debit and credit codes swapped, to be confirmed with NC.', 'MATCHED_ALL' FROM DUAL UNION ALL
    SELECT 'DP-022', 'DP-022_OVD_LIMIT_MISMATCH',                'CROSS_SYSTEM_MISMATCH', 'Overdrafts: the overdraft limit in PROFITS differs from the HUB limit the migration sent, in currency units.', 'MATCHED_OVD' FROM DUAL UNION ALL
    SELECT 'DP-023', 'DP-023_STATEMENT_FREQ_MISMATCH',           'CROSS_SYSTEM_MISMATCH', 'Demand and overdraft accounts: the statement frequency in PROFITS differs from the frequency the migration set from the HUB statement cycle.', 'MATCHED_DDOVD' FROM DUAL UNION ALL
    SELECT 'DP-024', 'DP-024_TD_INTEREST_RATE_MISMATCH',         'CROSS_SYSTEM_MISMATCH', 'Term deposits: the interest rate in PROFITS differs from the HUB contract rate the migration sent.', 'MATCHED_TD' FROM DUAL UNION ALL
    SELECT 'DP-025', 'DP-025_OVD_DEBIT_SPREAD_MISMATCH',         'CROSS_SYSTEM_MISMATCH', 'Overdrafts: the debit interest spread in PROFITS differs from the HUB spread of the balance tier the migration chose.', 'MATCHED_OVD' FROM DUAL UNION ALL
    SELECT 'DP-026', 'DP-026_CREDIT_SPREAD_MISMATCH',            'CROSS_SYSTEM_MISMATCH', 'The credit interest spread in PROFITS differs from the HUB spread the migration set after loading.', 'CRSPR' FROM DUAL
),
FINDINGS_COUNT AS (
    SELECT CHECK_ID, COUNT(*) AS INVALID_COUNT
    FROM (SELECT SUBSTR(CHECK_NAME, 1, INSTR(CHECK_NAME, '_') - 1) AS CHECK_ID FROM FINDINGS)
    GROUP BY CHECK_ID
)
SELECT
    CAST(CM.CHECK_ID AS VARCHAR2(10)) AS CHECK_ID,
    CAST(CM.CHECK_NAME AS VARCHAR2(50)) AS CHECK_NAME,
    CAST(CM.CATEGORY AS VARCHAR2(30)) AS CATEGORY,
    CAST(CM.DESCRIPTION AS VARCHAR2(200)) AS DESCRIPTION,
    (CASE CM.POPULATION_TYPE
        WHEN 'HUB_ACC'       THEN P.HUB_ACC_COUNT
        WHEN 'NCIS_ACC'      THEN P.NCIS_ACC_COUNT
        WHEN 'MATCHED_ALL'   THEN P.MATCHED_ALL_COUNT
        WHEN 'MATCHED_DDOVD' THEN P.MATCHED_DDOVD_COUNT
        WHEN 'MATCHED_OVD'   THEN P.MATCHED_OVD_COUNT
        WHEN 'MATCHED_TD'    THEN P.MATCHED_TD_COUNT
        WHEN 'CRSPR'         THEN P.CRSPR_COUNT
     END) AS TOTAL_RECORDS,
    (CASE CM.POPULATION_TYPE
        WHEN 'HUB_ACC'       THEN P.HUB_ACC_COUNT
        WHEN 'NCIS_ACC'      THEN P.NCIS_ACC_COUNT
        WHEN 'MATCHED_ALL'   THEN P.MATCHED_ALL_COUNT
        WHEN 'MATCHED_DDOVD' THEN P.MATCHED_DDOVD_COUNT
        WHEN 'MATCHED_OVD'   THEN P.MATCHED_OVD_COUNT
        WHEN 'MATCHED_TD'    THEN P.MATCHED_TD_COUNT
        WHEN 'CRSPR'         THEN P.CRSPR_COUNT
     END) - NVL(FC.INVALID_COUNT, 0) AS VALID_COUNT,
    NVL(FC.INVALID_COUNT, 0) AS INVALID_COUNT,
    CASE WHEN CM.CATEGORY = 'INFO'           THEN 'INFO'
         WHEN NVL(FC.INVALID_COUNT, 0) = 0   THEN 'PASS'
         ELSE 'FAIL' END AS STATUS,
    'DC5' AS DC_VERSION,
    1 AS RUN_VERSION,  -- TESTING ONLY: στο SSIS αντικαθίσταται από @[User::RunVersion] μέσω Derived Column.
    SYSDATE AS RUN_TIMESTAMP
FROM CHECK_META CM
CROSS JOIN POPULATIONS P
LEFT JOIN FINDINGS_COUNT FC ON FC.CHECK_ID = CM.CHECK_ID
ORDER BY REGEXP_SUBSTR(CM.CHECK_ID, '[A-Z]+'), TO_NUMBER(REGEXP_SUBSTR(CM.CHECK_ID, '[0-9]+'));</property>
