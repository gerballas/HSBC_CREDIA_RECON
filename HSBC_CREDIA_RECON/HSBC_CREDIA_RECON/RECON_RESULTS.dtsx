                  version="1">
                  <properties>
                    <property
                      dataType="System.String"
                      description="The name of the table to be fetched."
                      expressionType="Notify"
                      name="TableName"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      expressionType="Notify"
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">-- ====================================================================
-- CUST_OTHER_ID_RECON — MASTER DC5
-- Τροφοδοτεί: RECON.CUST_OTHER_ID_MASTER
-- Μία γραμμή ΑΝΑ CHECK_ID — 10 γραμμές ανά run: OI-001 .. OI-010.
-- OI-010 (προσθήκη 2026-11-13): πλήθος δευτερευόντων εγγράφων ανά τύπο, αναμενόμενα από όλες τις
-- πηγές (17000, 19800 τύποι 13 / 999 / ID εταιρειών) vs OTHER_ID MAIN_FLAG 0.
--
-- Customer Other IDs (ME01_HUB, EIM 240825): HUB vs PROFITS OTHER_ID, όλα τα
-- δευτερεύοντα έγγραφα (το κύριο, MAIN_FLAG 1, το ελέγχουν οι Customers CM-008 / 009).
-- Μορφή Master/Detail όπως οι Customers / Customer Addresses:
--   - ένα αυτοτελές SELECT. Το κοινό κομμάτι (CTEs) και το FINDINGS είναι ΙΔΙΑ αυτούσια
--     στο DetailOtherIDs_DC5.sql -&gt; INVALID_COUNT = γραμμές Detail.
--   - Παράγεται από τον generator (_generator): oi_master_head + oi_common + oi_master_tail.
--   - HUB από τα HUB_MT_* synonyms (DB link @Malta): κάθε πίνακας ΜΙΑ φορά (R_*), μόνο για
--     το HUB_VALUE.
--   - Δεν υπάρχει NCIS extract για τα έγγραφα: πλευρά PROFITS = OTHER_ID.
--
-- ΠΗΓΕΣ (όλες, απόφαση 2026-11-12):
--   17000 'CUSTOMER_OTHER_IDS'           SSTXDPP (BIC / NID / FDL / FPP / S1, TDAIFL = Y), εκτός
--                                        του αριθμού που έχει ήδη ο πελάτης (MG_CUSTOMER_INTER.ID_NO)
--   17000 'CUSTOMER_IDS_FROM_LEGAL_TYPES' εταιρείες: SSCUSTP.ZGIDNO / ZGIDTY
--   19800 τύπος 13  'PREVIOUS SYSTEM CODE': ID_NO = κωδικός HUB, κάθε πελάτης loaded
--   19800 τύπος 999 'JOINT CUSTOMER CODE': δικαιούχοι HGR_MG_JOINT, ID_NO = CUSTOMER_BENEF_LIST
--   19800 εταιρείες: MG_CUSTOMER_INTER.ID_NO, όταν δεν υπάρχει ήδη στο OTHER_ID
--
-- ΑΡΧΗ: αναμενόμενη τιμή ΜΟΝΟ από τα scripts:
--   - Έγγραφα του 17000: MG_OTHER_ID (τύπος -&gt; OIDTP, χώρα -&gt; CNTRY, ημερομηνίες όπως τις
--     μετατρέπει το 17000). Το 19800 σβήνει τα 'IDENTIFICATION DATA Already Exist' (διπλά).
--   - Κλειδί: πελάτης + ID_NO + ημερομηνία έκδοσης + αντίγραφο (DC5: κάθε ανανέωση δικό της serial).
--     NULL-safe (διόρθωση 2026-11-13): κενός αριθμός -&gt; '#NOID#', κενή ημερομηνία -&gt; 0001-01-01,
--     όπως το DC4 (NVL(ID_NUM,'NOID')). Πριν, έγγραφο χωρίς αριθμό έβγαινε ΚΑΙ στο OI-001 ΚΑΙ στο OI-009.
--     Επίσης οι εξαιρέσεις του OI-009 (τύποι 13 / 999, ID εταιρείας) γράφονται με CASE, ώστε έγγραφο
--     χωρίς αριθμό να μην εξαιρείται σιωπηλά (NOT (... AND NULL) = NULL).
--   - HUB_VALUE = τιμή HUB, NCIS_VALUE = τιμή PROFITS (OTHER_ID), αναμενόμενη τιμή στο ISSUE.
--
-- ΑΝΤΙΣΤΟΙΧΙΑ με τα Other_IDs_recon.sql (OID-001..009) / Other_IDs_legal_recon.sql (OIL-001..006):
--   OID-003 / 009, OIL-002 / 003 -&gt; OI-001 | OID-005 -&gt; OI-002 | OID-006, OIL-005 -&gt; OI-003
--   OID-007, OIL-006 -&gt; OI-004 | OID-008 -&gt; OI-005 | OID-004, OIL-004 -&gt; OI-009
--   Νέα: OI-006 / 007 / 008 (πηγές του 19800).
--   Αφαιρέθηκαν: OID-001 / OIL-001 (μοναδικότητα στο HUB), OID-002 (σύνολα). Οι views
--   other_id_recon_view / other_id_legal_recon_view δεν χρειάζονται (MG_OTHER_ID).
--
-- DC4 -&gt; DC5: 17000 - κάθε έγγραφο παίρνει δικό του OTHER_ID_SN (όλο το ιστορικό ανανεώσεων),
-- κενή χώρα έκδοσης -&gt; MT. 10010 - OIDTP U / V / X: 99 -&gt; 8; CNTRY νέα OO / CT / EO -&gt; 0.
-- 19800 - τα INSERT στο OTHER_ID (τύπος 13 / 999 / ID εταιρειών) και το delete του MG_OTHER_ID
-- ίδια. Το αναμενόμενο διαβάζεται τη στιγμή του run (MG_OTHER_ID, MG_PARAM_PARAMETER), οπότε οι
-- αλλαγές περνούν χωρίς αλλαγή κώδικα.
--
-- STATUS: PASS (INVALID_COUNT = 0) / FAIL. DESCRIPTION: απλή περιγραφή χωρίς κωδικούς.
--
-- TOTAL_RECORDS ανά POPULATION_TYPE:
--   MG_DOCS     = έγγραφα MG_OTHER_ID πελατών loaded
--   MATCHED     = έγγραφα MG_OTHER_ID που βρέθηκαν στο OTHER_ID
--   CUSTOMERS   = πελάτες loaded
--   JOINT_BENEF = δικαιούχοι joint loaded
--   COMPANY_ID  = εταιρείες loaded με MG_CUSTOMER_INTER.ID_NO
--   PRF_SEC     = δευτερεύοντα έγγραφα (MAIN_FLAG 0) πελατών της μετάπτωσης στο OTHER_ID
--   TYPES       = τύποι εγγράφων (αναμενόμενοι ή στο PROFITS)
-- ====================================================================
WITH
-- --------------------------------------------------------------------
-- Κοινό κομμάτι (ΙΔΙΟ αυτούσιο στο Master και στο Detail).
--   MIG / MIGP = πελάτες που φορτώθηκαν (MG_CUSTOMER_INTER ROW_STATUS = 1, PRFT_CUST_ID &gt; 0)
--   OIDTP / CNM = MG_PARAM_PARAMETER OIDTP / CNTRY (de-dup MIN)
--   R_*        = HUB πίνακες (synonyms σε DB link @Malta), ΜΙΑ φορά ο καθένας - μόνο για HUB_VALUE
--   MGO        = MG_OTHER_ID (17000: έγγραφα SSTXDPP 'CUSTOMER_OTHER_IDS' και ID εταιρειών
--                'CUSTOMER_IDS_FROM_LEGAL_TYPES'; το 19800 σβήνει τα 'IDENTIFICATION DATA Already
--                Exist'), πελάτες loaded, με αναμενόμενο τύπο (OIDTP) και χώρα (CNTRY)
--   OID        = OTHER_ID των πελατών της μετάπτωσης (πλευρά PROFITS - δεν υπάρχει NCIS extract)
--   PAIRS      = MGO vs OID με κλειδί (πελάτης, ID_NO, ISSUE_DATE, αντίγραφο)
--   JB         = δικαιούχοι joint (HGR_MG_JOINT) που φορτώθηκαν (19800, τύπος 999)
-- Detail: CUSTOMER_CODE = κωδικός HUB του πελάτη, SERIAL_NO = αριθμός εγγράφου (ID_NO).
-- --------------------------------------------------------------------
MIG AS (
    SELECT /*+ MATERIALIZE */ CC, PRFT, CTYPE, ID_NO, ID_TYPE
    FROM (
        SELECT TRIM(CUSTOMER_CODE) AS CC, PRFT_CUST_ID AS PRFT,
               TRIM(TO_CHAR(CUST_TYPE)) AS CTYPE, TRIM(ID_NO) AS ID_NO, TRIM(ID_TYPE) AS ID_TYPE,
               ROW_NUMBER() OVER (PARTITION BY TRIM(CUSTOMER_CODE) ORDER BY PRFT_CUST_ID) AS RN
          FROM MG_CUSTOMER_INTER
         WHERE ROW_STATUS = 1
           AND PRFT_CUST_ID &gt; 0
    )
    WHERE RN = 1
),
MIGP AS (
    SELECT /*+ MATERIALIZE */ PRFT, MIN(CC) AS CC, MIN(CTYPE) AS CTYPE, MIN(ID_NO) AS ID_NO FROM MIG GROUP BY PRFT
),
OIDTP AS (
    SELECT /*+ MATERIALIZE */ TRIM(OLD_VALUE) AS OV, MIN(NEW_VALUE) AS NV
      FROM MG_PARAM_PARAMETER WHERE TRIM(PARAMETER_TYPE) = 'OIDTP' GROUP BY TRIM(OLD_VALUE)
),
CNM AS (
    SELECT /*+ MATERIALIZE */ TRIM(OLD_VALUE) AS OV, MIN(NEW_VALUE) AS NV
      FROM MG_PARAM_PARAMETER WHERE TRIM(PARAMETER_TYPE) = 'CNTRY' GROUP BY TRIM(OLD_VALUE)
),
R_TXDPP AS (
    -- έγγραφα που επιλέγει το 17000 (τιμές HUB όπως είναι)
    SELECT /*+ MATERIALIZE */
        TRIM(customer_code) AS CC,
        TRIM(TDTDTY) AS TDTDTY, TRIM(TDTXDX) AS TDTXDX, TRIM(TO_CHAR(TDTDTI)) AS TDTDTI,
        TRIM(TO_CHAR(TDTDDE)) AS TDTDDE, TRIM(TDTXDC) AS TDTXDC
    FROM HUB_MT_SSTXDPP
    WHERE TDTDTY IN ('BIC','NID','FDL','FPP','S1')
      AND TDAIFL = 'Y'
),
TXD AS (
    -- τύπος και ημερομηνία έκδοσης όπως τα γράφει το 17000 στο MG_OTHER_ID (μόνο για το join)
    SELECT /*+ MATERIALIZE */
        r.*,
        CASE WHEN r.TDTDTY = 'NID' AND r.TDTXDC = 'MT' THEN 'NID_MT' ELSE r.TDTDTY END AS MIG_TYPE,
        CASE WHEN LENGTH(r.TDTDTI) &lt;&gt; 8 OR r.TDTDTI IS NULL OR r.TDTDTI = '99999999' OR r.TDTDTI = '0'
             THEN DATE '0001-01-01'
             ELSE TO_DATE(r.TDTDTI DEFAULT NULL ON CONVERSION ERROR, 'YYYYMMDD') END AS MIG_ISSUE_DATE
    FROM R_TXDPP r
),
TXDR AS (
    -- ένα έγγραφο HUB ανά κλειδί του MG_OTHER_ID, για να μη διπλασιάζονται γραμμές στο join
    SELECT /*+ MATERIALIZE */ t.*,
           ROW_NUMBER() OVER (PARTITION BY t.CC, t.TDTXDX, t.MIG_TYPE, t.MIG_ISSUE_DATE ORDER BY t.TDTDDE) AS RN
    FROM TXD t
),
R_CUSTP AS (
    SELECT /*+ MATERIALIZE */ TRIM(customer_code) AS CC, TRIM(ZGIDTY) AS ZGIDTY, TRIM(ZGIDNO) AS ZGIDNO, TRIM(ZGCTRS) AS ZGCTRS
    FROM HUB_MT_SSCUSTP
),
MGO AS (
    SELECT /*+ MATERIALIZE */
        TRIM(o.FILE_NAME)              AS FILE_NAME,
        m.CC, m.PRFT,
        TRIM(o.ID_TYPE)                AS ID_TYPE,
        TRIM(o.ID_NUM)                 AS ID_NUM,
        TRUNC(o.ISSUE_DATE)            AS ISSUE_DATE,
        TRUNC(o.EXPIRY_DATE)           AS EXPIRY_DATE,
        TRIM(o.ISSUE_COUNTRY)          AS ISSUE_COUNTRY,
        TRIM(TO_CHAR(o.ROW_STATUS))    AS ROW_STATUS,
        TRIM(o.ROW_ERR_DESC)           AS ROW_ERR_DESC,
        t.NV                           AS E_TYPE,
        c.NV                           AS E_CNTRY,
        ROW_NUMBER() OVER (PARTITION BY m.PRFT, TRIM(o.ID_NUM), NVL(TRUNC(o.ISSUE_DATE), DATE '0001-01-01') ORDER BY o.SN) AS COPY_NO
    FROM MG_OTHER_ID o
    JOIN MIG m        ON m.CC = TRIM(o.CUSTOMER_CODE)
    LEFT JOIN OIDTP t ON t.OV = TRIM(o.ID_TYPE)
    LEFT JOIN CNM c   ON c.OV = TRIM(o.ISSUE_COUNTRY)
),
OID AS (
    SELECT /*+ MATERIALIZE */
        oi.FK_CUSTOMERCUST_ID              AS PRFT,
        mp.CC, mp.CTYPE, mp.ID_NO          AS M_ID_NO,
        oi.SERIAL_NO,
        TRIM(oi.ID_NO)                     AS ID_NO,
        TRUNC(oi.ISSUE_DATE)               AS ISSUE_DATE,
        TRUNC(oi.EXPIRY_DATE)              AS EXPIRY_DATE,
        oi.FKGD_HAS_TYPE                   AS P_TYPE,
        oi.FKGD_HAS_BEEN_ISSU              AS P_CNTRY,
        TRIM(TO_CHAR(oi.MAIN_FLAG))        AS MAIN_FLAG,
        ROW_NUMBER() OVER (PARTITION BY oi.FK_CUSTOMERCUST_ID, TRIM(oi.ID_NO), NVL(TRUNC(oi.ISSUE_DATE), DATE '0001-01-01') ORDER BY oi.SERIAL_NO) AS COPY_NO
    FROM OTHER_ID oi
    JOIN MIGP mp ON mp.PRFT = oi.FK_CUSTOMERCUST_ID
),
PAIRS AS (
    SELECT /*+ MATERIALIZE */
        g.FILE_NAME, g.CC, g.PRFT, g.ID_TYPE, g.ID_NUM, g.ISSUE_DATE, g.EXPIRY_DATE, g.ISSUE_COUNTRY,
        g.ROW_STATUS, g.ROW_ERR_DESC, g.E_TYPE, g.E_CNTRY, g.COPY_NO,
        p.SERIAL_NO AS P_SERIAL, p.P_TYPE, p.P_CNTRY, p.EXPIRY_DATE AS P_EXPIRY, p.MAIN_FLAG AS P_MAIN,
        CASE WHEN p.PRFT IS NULL THEN 0 ELSE 1 END AS MATCHED,
        x.TDTDTY, x.TDTXDX, x.TDTDTI, x.TDTDDE, x.TDTXDC,
        cu.ZGIDTY, cu.ZGIDNO, cu.ZGCTRS
    FROM MGO g
    LEFT JOIN OID p
           -- NULL-safe κλειδί: έγγραφο χωρίς αριθμό (TRIM(' ') = NULL) ή χωρίς ημερομηνία πρέπει να ταιριάζει
           ON p.PRFT = g.PRFT AND NVL(p.ID_NO, '#NOID#') = NVL(g.ID_NUM, '#NOID#')
          AND NVL(p.ISSUE_DATE, DATE '0001-01-01') = NVL(g.ISSUE_DATE, DATE '0001-01-01') AND p.COPY_NO = g.COPY_NO
    LEFT JOIN TXDR x
           ON g.FILE_NAME = 'CUSTOMER_OTHER_IDS'
          AND x.CC = g.CC AND NVL(x.TDTXDX, '#NOID#') = NVL(g.ID_NUM, '#NOID#') AND x.MIG_TYPE = g.ID_TYPE
          AND NVL(x.MIG_ISSUE_DATE, DATE '0001-01-01') = NVL(g.ISSUE_DATE, DATE '0001-01-01')
          AND x.RN = 1
    LEFT JOIN R_CUSTP cu
           ON g.FILE_NAME = 'CUSTOMER_IDS_FROM_LEGAL_TYPES' AND cu.CC = g.CC
),
JB AS (
    SELECT /*+ MATERIALIZE */ m.CC, m.PRFT, MIN(TRIM(j.CUSTOMER_1)) AS J_MIN, MAX(TRIM(j.CUSTOMER_1)) AS J_MAX
    FROM HGR_MG_JOINT j
    JOIN MIG m ON m.CC = TRIM(j.CUSTOMER_BENEF_LIST)
    GROUP BY m.CC, m.PRFT
),
EXP_TYPE AS (
    -- αναμενόμενα δευτερεύοντα έγγραφα ανά τύπο, από όλες τις πηγές:
    --   17000 (MG_OTHER_ID -&gt; OIDTP), 19800 τύπος 13 (κάθε πελάτης loaded), 19800 τύπος 999
    --   (δικαιούχοι joint), 19800 ID εταιρείας (MG_CUSTOMER_INTER.ID_TYPE -&gt; OIDTP) όταν ο αριθμός
    --   δεν έρχεται ήδη από το 17000
    SELECT /*+ MATERIALIZE */ T, COUNT(*) AS N
    FROM (
        SELECT TO_CHAR(E_TYPE) AS T FROM MGO
        UNION ALL
        SELECT '13' FROM MIG
        UNION ALL
        SELECT '999' FROM JB
        UNION ALL
        SELECT TO_CHAR(t.NV)
          FROM MIG m
          LEFT JOIN OIDTP t ON t.OV = m.ID_TYPE
          LEFT JOIN (SELECT DISTINCT PRFT, ID_NUM FROM MGO) g ON g.PRFT = m.PRFT AND g.ID_NUM = m.ID_NO
         WHERE m.CTYPE = '2' AND m.ID_NO IS NOT NULL AND g.PRFT IS NULL
    )
    GROUP BY T
),
CNT_TYPE AS (
    SELECT /*+ MATERIALIZE */ NVL(e.T, p.T) AS T, e.N AS HUB_N, p.N AS PRF_N
      FROM EXP_TYPE e
      FULL OUTER JOIN
           (SELECT TO_CHAR(P_TYPE) AS T, COUNT(*) AS N FROM OID WHERE NVL(MAIN_FLAG, 'X') = '0' GROUP BY TO_CHAR(P_TYPE)) p
        ON p.T = e.T
),
FINDINGS AS (
    --==============================================================
    --OI-001. Έγγραφο που στέλνει το 17000 (MG_OTHER_ID, πελάτης loaded) χωρίς γραμμή στο OTHER_ID
    --        (ίδιος αριθμός και ημερομηνία έκδοσης). ISSUE = αιτία
    SELECT
      CAST('OI-001_ID_DOCUMENT_MISSING_IN_PROFITS' AS VARCHAR2(50)) AS CHECK_NAME,
      CAST(CC AS VARCHAR2(40)) AS CUSTOMER_CODE, CAST(ID_NUM AS VARCHAR2(40)) AS SERIAL_NO,
      CAST(CASE WHEN FILE_NAME = 'CUSTOMER_OTHER_IDS'
                THEN 'TDTDTY=' || TDTDTY || '; TDTXDX=' || TDTXDX || '; TDTDTI=' || TDTDTI
                ELSE 'ZGIDTY=' || ZGIDTY || '; ZGIDNO=' || ZGIDNO END AS VARCHAR2(200)) AS HUB_VALUE,
      CAST(NULL AS VARCHAR2(200)) AS NCIS_VALUE,
      CAST(CASE WHEN E_TYPE IS NULL THEN 'NO_MAPPING (SENT ' || ID_TYPE || ')'
                WHEN NVL(ROW_STATUS, 'X') &lt;&gt; '1' THEN SUBSTR('NOT_LOADED (' || NVL(ROW_ERR_DESC, 'ROW_STATUS ' || NVL(ROW_STATUS, 'empty')) || ')', 1, 50)
                WHEN COPY_NO &gt; 1 THEN 'EXTRA_COPY_SAME_DOCUMENT'
                ELSE 'MISSING_IN_PROFITS' END AS VARCHAR2(50)) AS ISSUE
    FROM PAIRS
    WHERE MATCHED = 0
    UNION ALL
    --==============================================================
    --OI-002. Τύπος εγγράφου vs MG_OTHER_ID.ID_TYPE -&gt; OIDTP (17000: NID + MT -&gt; NID_MT, B + MT -&gt; B_MT)
    SELECT 'OI-002_ID_TYPE_MISMATCH', CC, ID_NUM,
           CASE WHEN FILE_NAME = 'CUSTOMER_OTHER_IDS' THEN 'TDTDTY=' || TDTDTY || '; TDTXDC=' || TDTXDC
                ELSE 'ZGIDTY=' || ZGIDTY || '; ZGCTRS=' || ZGCTRS END,
           TO_CHAR(P_TYPE),
           CASE WHEN E_TYPE IS NULL THEN 'NO_MAPPING (SENT ' || ID_TYPE || ')'
                ELSE 'MISMATCH (EXPECTED ' || TO_CHAR(E_TYPE) || ')' END
    FROM PAIRS
    WHERE MATCHED = 1
      AND NVL(TO_CHAR(P_TYPE), 'X') &lt;&gt; NVL(TO_CHAR(E_TYPE), 'X')
    UNION ALL
    --==============================================================
    --OI-003. Ημερομηνία λήξης vs MG_OTHER_ID.EXPIRY_DATE (17000: κενό / 0 / 99999999 -&gt; 0001-01-01)
    SELECT 'OI-003_EXPIRY_DATE_MISMATCH', CC, ID_NUM,
           CASE WHEN FILE_NAME = 'CUSTOMER_OTHER_IDS' THEN 'TDTDDE=' || NVL(TDTDDE, 'empty') ELSE 'no HUB field (0001-01-01)' END,
           TO_CHAR(P_EXPIRY, 'YYYYMMDD'),
           'MISMATCH (EXPECTED ' || NVL(TO_CHAR(EXPIRY_DATE, 'YYYYMMDD'), 'EMPTY') || ')'
    FROM PAIRS
    WHERE MATCHED = 1
      AND NVL(TO_CHAR(P_EXPIRY, 'YYYYMMDD'), 'X') &lt;&gt; NVL(TO_CHAR(EXPIRY_DATE, 'YYYYMMDD'), 'X')
    UNION ALL
    --==============================================================
    --OI-004. Χώρα έκδοσης vs MG_OTHER_ID.ISSUE_COUNTRY -&gt; CNTRY (17000: κενό -&gt; MT)
    SELECT 'OI-004_ISSUE_COUNTRY_MISMATCH', CC, ID_NUM,
           CASE WHEN FILE_NAME = 'CUSTOMER_OTHER_IDS' THEN 'TDTXDC=' || NVL(TDTXDC, 'empty') ELSE 'no HUB field (MT)' END,
           TO_CHAR(P_CNTRY),
           CASE WHEN E_CNTRY IS NULL THEN 'NO_MAPPING (SENT ' || NVL(ISSUE_COUNTRY, 'EMPTY') || ')'
                ELSE 'MISMATCH (EXPECTED ' || TO_CHAR(E_CNTRY) || ')' END
    FROM PAIRS
    WHERE MATCHED = 1
      AND NVL(TO_CHAR(P_CNTRY), 'X') &lt;&gt; NVL(TO_CHAR(E_CNTRY), 'X')
    UNION ALL
    --==============================================================
    --OI-005. MAIN_FLAG: τα έγγραφα του 17000 είναι δευτερεύοντα (αναμενόμενο 0)
    SELECT 'OI-005_MAIN_FLAG_MISMATCH', CC, ID_NUM, ID_TYPE, P_MAIN, 'MISMATCH (EXPECTED 0)'
    FROM PAIRS
    WHERE MATCHED = 1
      AND NVL(P_MAIN, 'X') &lt;&gt; '0'
    UNION ALL
    --==============================================================
    --OI-006. 19800: κάθε πελάτης loaded παίρνει τύπο 13 'PREVIOUS SYSTEM CODE' με ID_NO = κωδικός HUB
    SELECT 'OI-006_PREVIOUS_SYSTEM_CODE_MISSING', m.CC, m.CC, m.CC,
           p.ID_MIN || CASE WHEN p.ID_MAX &lt;&gt; p.ID_MIN THEN ' | ' || p.ID_MAX END,
           CASE WHEN p.PRFT IS NULL THEN 'MISSING_IN_PROFITS' ELSE SUBSTR('MISMATCH (EXPECTED ' || m.CC || ')', 1, 50) END
    FROM MIG m
    LEFT JOIN (SELECT PRFT, MIN(ID_NO) AS ID_MIN, MAX(ID_NO) AS ID_MAX,
                      MAX(CASE WHEN ID_NO = CC THEN 1 ELSE 0 END) AS HAS_OWN
                 FROM OID WHERE P_TYPE = 13 GROUP BY PRFT) p ON p.PRFT = m.PRFT
    WHERE NVL(p.HAS_OWN, 0) = 0
    UNION ALL
    --==============================================================
    --OI-007. 19800: δικαιούχος joint (HGR_MG_JOINT) loaded παίρνει τύπο 999 'JOINT CUSTOMER CODE'
    --        με ID_NO = CUSTOMER_BENEF_LIST (ο δικός του κωδικός, όπως γράφει το script)
    SELECT 'OI-007_JOINT_CUSTOMER_CODE_MISSING', j.CC, j.CC,
           'HGR_MG_JOINT ' || j.J_MIN || CASE WHEN j.J_MAX &lt;&gt; j.J_MIN THEN ' .. ' || j.J_MAX END || ' -&gt; ' || j.CC,
           p.ID_MIN,
           CASE WHEN p.PRFT IS NULL THEN 'MISSING_IN_PROFITS' ELSE SUBSTR('MISMATCH (EXPECTED ' || j.CC || ')', 1, 50) END
    FROM JB j
    LEFT JOIN (SELECT PRFT, MIN(ID_NO) AS ID_MIN,
                      MAX(CASE WHEN ID_NO = CC THEN 1 ELSE 0 END) AS HAS_OWN
                 FROM OID WHERE P_TYPE = 999 GROUP BY PRFT) p ON p.PRFT = j.PRFT
    WHERE NVL(p.HAS_OWN, 0) = 0
    UNION ALL
    --==============================================================
    --OI-008. 19800: εταιρεία loaded με MG_CUSTOMER_INTER.ID_NO -&gt; γραμμή OTHER_ID με αυτόν τον αριθμό
    SELECT 'OI-008_COMPANY_ID_MISSING', m.CC, m.ID_NO, 'ZGIDNO=' || cu.ZGIDNO, CAST(NULL AS VARCHAR2(200)),
           'MISSING_IN_PROFITS'
    FROM MIG m
    LEFT JOIN R_CUSTP cu ON cu.CC = m.CC
    LEFT JOIN (SELECT DISTINCT PRFT, ID_NO FROM OID) p ON p.PRFT = m.PRFT AND p.ID_NO = m.ID_NO
    WHERE m.CTYPE = '2'
      AND m.ID_NO IS NOT NULL
      AND p.PRFT IS NULL
    UNION ALL
    --==============================================================
    --OI-009. Δευτερεύον έγγραφο (MAIN_FLAG 0) πελάτη της μετάπτωσης που δεν εξηγείται από καμία πηγή:
    --        17000 (MG_OTHER_ID), 19800 τύπος 13 / 999 (ο κωδικός του πελάτη), 19800 ID εταιρείας
    SELECT 'OI-009_ID_DOCUMENT_MISSING_IN_HUB', o.CC, o.ID_NO, CAST(NULL AS VARCHAR2(200)),
           'TYPE ' || TO_CHAR(o.P_TYPE) || ', ISSUE ' || TO_CHAR(o.ISSUE_DATE, 'YYYYMMDD'),
           'NOT_SENT_BY_MIGRATION (TYPE ' || TO_CHAR(o.P_TYPE) || ')'
    FROM OID o
    LEFT JOIN (SELECT DISTINCT PRFT, ID_NUM, ISSUE_DATE FROM MGO) g
           ON g.PRFT = o.PRFT AND NVL(g.ID_NUM, '#NOID#') = NVL(o.ID_NO, '#NOID#')
          AND NVL(g.ISSUE_DATE, DATE '0001-01-01') = NVL(o.ISSUE_DATE, DATE '0001-01-01')
    WHERE NVL(o.MAIN_FLAG, 'X') = '0'
      AND g.PRFT IS NULL
      -- CASE αντί για NOT (...): με κενό ID_NO το NOT (... AND NULL) είναι NULL και η γραμμή χανόταν
      AND CASE WHEN o.P_TYPE IN (13, 999) AND o.ID_NO = o.CC THEN 1 ELSE 0 END = 0
      AND CASE WHEN o.CTYPE = '2' AND o.ID_NO = o.M_ID_NO THEN 1 ELSE 0 END = 0
    UNION ALL
    --==============================================================
    --OI-010. Πλήθος δευτερευόντων εγγράφων ανά τύπο: αναμενόμενα από όλες τις πηγές vs OTHER_ID
    --        (MAIN_FLAG 0) των πελατών της μετάπτωσης. Μία γραμμή ανά τύπο (CUSTOMER_CODE = τύπος)
    SELECT 'OI-010_ID_DOCUMENT_COUNT_PER_TYPE', 'TYPE ' || NVL(T, '(no mapping)'), CAST(NULL AS VARCHAR2(40)),
           TO_CHAR(NVL(HUB_N, 0)), TO_CHAR(NVL(PRF_N, 0)),
           'COUNT_DIFFERS (EXPECTED ' || TO_CHAR(NVL(HUB_N, 0)) || ')'
    FROM CNT_TYPE
    WHERE NVL(HUB_N, 0) &lt;&gt; NVL(PRF_N, 0)
)
,
POPULATIONS AS (
    SELECT
        (SELECT COUNT(*) FROM MGO)                                                    AS MG_DOCS_COUNT,
        (SELECT COUNT(*) FROM PAIRS WHERE MATCHED = 1)                                AS MATCHED_COUNT,
        (SELECT COUNT(*) FROM MIG)                                                    AS CUSTOMERS_COUNT,
        (SELECT COUNT(*) FROM JB)                                                     AS JOINT_BENEF_COUNT,
        (SELECT COUNT(*) FROM MIG WHERE CTYPE = '2' AND ID_NO IS NOT NULL)            AS COMPANY_ID_COUNT,
        (SELECT COUNT(*) FROM OID WHERE NVL(MAIN_FLAG, 'X') = '0')                    AS PRF_SEC_COUNT,
        (SELECT COUNT(*) FROM CNT_TYPE)                                               AS TYPES_COUNT
    FROM DUAL
),
CHECK_META AS (
    -- CHECK_ID | CHECK_NAME | CATEGORY | DESCRIPTION | POPULATION_TYPE
    SELECT 'OI-001' AS CHECK_ID, 'OI-001_ID_DOCUMENT_MISSING_IN_PROFITS' AS CHECK_NAME, 'EXISTENCE' AS CATEGORY, 'Identification documents the migration sent from HUB (other documents and company IDs) that are not in PROFITS. The detail rows give the likely reason.' AS DESCRIPTION, 'MG_DOCS' AS POPULATION_TYPE FROM DUAL UNION ALL
    SELECT 'OI-002', 'OI-002_ID_TYPE_MISMATCH',               'CROSS_SYSTEM_MISMATCH', 'Document type in PROFITS differs from the HUB document type translated to its PROFITS code.', 'MATCHED' FROM DUAL UNION ALL
    SELECT 'OI-003', 'OI-003_EXPIRY_DATE_MISMATCH',           'CROSS_SYSTEM_MISMATCH', 'Expiry date in PROFITS differs from the HUB expiry date as the migration sent it (empty or invalid dates as 01/01/0001).', 'MATCHED' FROM DUAL UNION ALL
    SELECT 'OI-004', 'OI-004_ISSUE_COUNTRY_MISMATCH',         'CROSS_SYSTEM_MISMATCH', 'Issue country in PROFITS differs from the HUB issue country translated to its PROFITS code (empty sent as Malta).', 'MATCHED' FROM DUAL UNION ALL
    SELECT 'OI-005', 'OI-005_MAIN_FLAG_MISMATCH',             'CROSS_SYSTEM_MISMATCH', 'Documents sent as additional documents that PROFITS holds as the main identification document.', 'MATCHED' FROM DUAL UNION ALL
    SELECT 'OI-006', 'OI-006_PREVIOUS_SYSTEM_CODE_MISSING',   'EXISTENCE',             'Migrated customers without the document that holds their HUB customer code (previous system code).', 'CUSTOMERS' FROM DUAL UNION ALL
    SELECT 'OI-007', 'OI-007_JOINT_CUSTOMER_CODE_MISSING',    'EXISTENCE',             'Migrated joint-account holders without the joint customer code document the migration creates.', 'JOINT_BENEF' FROM DUAL UNION ALL
    SELECT 'OI-008', 'OI-008_COMPANY_ID_MISSING',             'EXISTENCE',             'Migrated companies whose identification number is not held as a document in PROFITS.', 'COMPANY_ID' FROM DUAL UNION ALL
    SELECT 'OI-009', 'OI-009_ID_DOCUMENT_MISSING_IN_HUB',     'EXISTENCE',             'Additional documents in PROFITS for migrated customers that the migration did not send.', 'PRF_SEC' FROM DUAL UNION ALL
    SELECT 'OI-010', 'OI-010_ID_DOCUMENT_COUNT_PER_TYPE',     'CONTROL_TOTAL',         'Document types whose number of additional documents in PROFITS differs from the number the migration sends from all its sources. One row per type.', 'TYPES' FROM DUAL
),
FINDINGS_COUNT AS (
    SELECT CHECK_ID, COUNT(*) AS INVALID_COUNT
    FROM (SELECT SUBSTR(CHECK_NAME, 1, INSTR(CHECK_NAME, '_') - 1) AS CHECK_ID FROM FINDINGS)
    GROUP BY CHECK_ID
)
SELECT
    CAST(CM.CHECK_ID AS VARCHAR2(10)) AS CHECK_ID,
    CAST(CM.CHECK_NAME AS VARCHAR2(50)) AS CHECK_NAME,
    CAST(CM.CATEGORY AS VARCHAR2(30)) AS CATEGORY,
    CAST(CM.DESCRIPTION AS VARCHAR2(200)) AS DESCRIPTION,
    (CASE CM.POPULATION_TYPE
        WHEN 'MG_DOCS'     THEN P.MG_DOCS_COUNT
        WHEN 'MATCHED'     THEN P.MATCHED_COUNT
        WHEN 'CUSTOMERS'   THEN P.CUSTOMERS_COUNT
        WHEN 'JOINT_BENEF' THEN P.JOINT_BENEF_COUNT
        WHEN 'COMPANY_ID'  THEN P.COMPANY_ID_COUNT
        WHEN 'PRF_SEC'     THEN P.PRF_SEC_COUNT
        WHEN 'TYPES'       THEN P.TYPES_COUNT
     END) AS TOTAL_RECORDS,
    (CASE CM.POPULATION_TYPE
        WHEN 'MG_DOCS'     THEN P.MG_DOCS_COUNT
        WHEN 'MATCHED'     THEN P.MATCHED_COUNT
        WHEN 'CUSTOMERS'   THEN P.CUSTOMERS_COUNT
        WHEN 'JOINT_BENEF' THEN P.JOINT_BENEF_COUNT
        WHEN 'COMPANY_ID'  THEN P.COMPANY_ID_COUNT
        WHEN 'PRF_SEC'     THEN P.PRF_SEC_COUNT
        WHEN 'TYPES'       THEN P.TYPES_COUNT
     END) - NVL(FC.INVALID_COUNT, 0) AS VALID_COUNT,
    NVL(FC.INVALID_COUNT, 0) AS INVALID_COUNT,
    CASE WHEN CM.CATEGORY = 'INFO'           THEN 'INFO'
         WHEN NVL(FC.INVALID_COUNT, 0) = 0   THEN 'PASS'
         ELSE 'FAIL' END AS STATUS,
    'DC5' AS DC_VERSION,
    1 AS RUN_VERSION,  -- TESTING ONLY: στο SSIS αντικαθίσταται από @[User::RunVersion] μέσω Derived Column.
    SYSDATE AS RUN_TIMESTAMP
FROM CHECK_META CM
CROSS JOIN POPULATIONS P
LEFT JOIN FINDINGS_COUNT FC ON FC.CHECK_ID = CM.CHECK_ID
ORDER BY REGEXP_SUBSTR(CM.CHECK_ID, '[A-Z]+'), TO_NUMBER(REGEXP_SUBSTR(CM.CHECK_ID, '[0-9]+'));</property>
