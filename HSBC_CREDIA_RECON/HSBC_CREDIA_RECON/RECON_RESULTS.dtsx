                  <properties>
                    <property
                      dataType="System.String"
                      description="The name of the table to be fetched."
                      expressionType="Notify"
                      name="TableName"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      expressionType="Notify"
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">-- ====================================================================
-- GU_RECON — DETAIL DC5 v1 (Guarantors: loans, overdrafts, letters of guarantee)
-- Τροφοδοτεί: RECON.GU_RECON_DETAIL (όνομα πίνακα προς επιβεβαίωση: δεν υπάρχει ακόμη στο
-- SSIS scripts\Recon_tables.sql)
-- Μία γραμμή ανά εύρημα για GU-001 .. GU-005 (μόνο ό,τι αποτυγχάνει). Τα INFO GU-006 .. GU-010 υπάρχουν μόνο στο Master.
--
-- Ζευγάρι του MasterGuarantors_DC5_v1.sql: το κοινό κομμάτι και το FINDINGS είναι ΙΔΙΑ
-- αυτούσια και στα δύο αρχεία -&gt; INVALID_COUNT του Master = γραμμές εδώ ανά CHECK_ID.
-- Πηγές / κανόνες / αντιστοιχία με το DC4: βλ. header του Master.
--
--   - DETAIL_ID: '&lt;CHECK_ID&gt;_0000001', ...
--   - CUSTOMER_CODE: guarantor / μέλος HUB. NULL στα GU-002 / 005 (γραμμή PROFITS χωρίς ζευγάρι στο HUB).
--   - SERIAL_NO: agreement code (AGRLN..., OVD agreement, AGRLG...).
--   - HUB_VALUE = τιμή HUB, NCIS_VALUE = τιμή PROFITS (AGREEMENT_GUARANT), 100 χαρ.
--   - ISSUE: η αιτία για τα checks ύπαρξης ή 'NOT MIGRATED (...)'. Έως 50 χαρακτήρες.
-- ====================================================================
WITH
-- --------------------------------------------------------------------
-- Κοινό κομμάτι (ΙΔΙΟ αυτούσιο στο Master και στο Detail). Ανακατασκευή από το HUB των κανόνων του 55000 (απόφαση
-- χρήστη 2026-11-18), κάθε πίνακας HUB ΜΙΑ φορά σε δικό του CTE (R_*), μόνο οι στήλες που χρειάζονται.
--   R_SEC  = HUB_MT_SSSECHP: securities (owner Y2DCB / Y2DCS, serial Y2SCSR, guarantor slots A / C1..C3, τύπος, αξία).
--   R_SCR  = HUB_MT_SSSCRLP: security -&gt; limit (VYLMTY / VYLINE).   R_CLM = HUB_MT_SSCLMTP: limit -&gt; sub-limit (ZFCNLM / ZFCLIN).
--   R_LS / R_DC = HUB_MT_LSACMSP / DCACMSP: limit -&gt; λογαριασμός δανείου / OVD (δάνειο πρώτο: COALESCE(PO*, D1*)).
--   R_CP   = HUB_MT_SSCAIFP ZUCTCG = 'G': guarantors του company file (ZUHUBN, SERIAL_NUMBER του 10090).
--   R_JNT  = HUB_MT_SSPRJIP: joint profile -&gt; μέλη (CUSTOMER_CODE / CUSTOMER_CODE2 του 10090, όπως HGR_MG_JOINT).
--   GTR    = (owner, guarantor, security) από τα 4 slots, guarantor &lt;&gt; owner (55000 GUARANTORS).
--   CPG    = guarantors του company file που ΔΕΝ είναι ήδη στο GTR (55000 CP_GUARANTORS).
--   PATH   = owner -&gt; security -&gt; limit -&gt; λογαριασμός, με το ίδιο το limit ή με sub-limit (55000: δύο SELECT με UNION).
--   LNK    = (λογαριασμός, guarantor) σε επίπεδο owner (όπως το 55000: GTR / CPG join στο PATH μόνο με τον owner).
--   LKA    = LNK -&gt; PROFITS_ACCOUNT -&gt; agreement code (MG_DPAC_LOAD / MG_LNS_MNT_LOAD). Χωρίς agreement -&gt; INFO GU-006.
--   XG     = αναμενόμενοι guarantors ανά agreement: joint guarantor -&gt; κάθε μέλος (LEFT JOIN HGR_MG_JOINT χωρίς SERIAL_NO),
--            ZUHUBN 'N' -&gt; MG_CUSTOMER_INTER.SERIAL_NO (SSCAIFPCustomersNotInSSCUSTP). PID = PRFT_CUST_ID (NULL = δεν μεταφέρθηκε).
--   AGR    = MG_AGR_MNT_LOAD ανά agreement code (4-part key, πελάτης).   AG = AGREEMENT_GUARANT.
--   LGX    = LG guarantors (ΝΕΟ στο DC5): LG του HUB (HUB_MT_PLACMSP, φίλτρα 50000) με owner joint -&gt; κάθε μέλος. Το 50000
--            κάνει το μέλος 1 πελάτη της LG (LG_ACCOUNT.FKCUST_ISSUER) και το 55000 τα άλλα guarantors του AGRLG agreement.
-- --------------------------------------------------------------------
R_SEC AS (
    SELECT /*+ MATERIALIZE */
           Y2DCB AS OB, Y2DCS AS OS, Y2SCSR AS SR, TRIM(Y2SCCD) AS SCCD, Y2SCVR AS SCVR, Y2SPA AS SPA, TRIM(Y2MDFL) AS MDFL,
           Y2GAB, Y2GAS, Y2GCB1, Y2GCS1, Y2GCB2, Y2GCS2, Y2GCB3, Y2GCS3
      FROM HUB_MT_SSSECHP
),
R_SCR AS (
    SELECT /*+ MATERIALIZE */ VYDCB, VYDCS, VYSCSR, VYLMTY, VYLINE FROM HUB_MT_SSSCRLP
),
R_CLM AS (
    SELECT /*+ MATERIALIZE */ ZFDCB, ZFDCS, ZFLMTY, ZFLINE, ZFCNLM, ZFCLIN FROM HUB_MT_SSCLMTP
),
R_LS AS (
    SELECT /*+ MATERIALIZE */ PODCB, PODCS, POLMTY, POLINE, POACB, POACS, POACX FROM HUB_MT_LSACMSP
),
R_DC AS (
    SELECT /*+ MATERIALIZE */ D1DCB, D1DCS, D1LMTY, D1LINE, D1ACB, D1ACS, D1ACX FROM HUB_MT_DCACMSP
),
R_CP AS (
    SELECT /*+ MATERIALIZE */ DISTINCT ZUDCB, ZUDCS, ZUDCB2, ZUDCS2, TRIM(ZUHUBN) AS ZUHUBN, SERIAL_NUMBER
      FROM HUB_MT_SSCAIFP
     WHERE ZUCTCG = 'G' AND (ZUDCB &lt;&gt; ZUDCB2 OR ZUDCS &lt;&gt; ZUDCS2)
),
R_JNT AS (
    SELECT /*+ MATERIALIZE */ DISTINCT TRIM(CUSTOMER_CODE) AS JC, TRIM(CUSTOMER_CODE2) AS MC FROM HUB_MT_SSPRJIP
),
R_LG AS (
    SELECT /*+ MATERIALIZE */ TRIM(OLD_LNS_NO) AS LGN, TRIM(CUSTOMER_CODE) AS OWN
      FROM HUB_MT_PLACMSP
     WHERE PFAPTY NOT IN ('IRS', 'ZSC') AND PFRLBL &lt; 0 AND PFSTUS NOT IN ('5')
),
MCI AS (
    SELECT /*+ MATERIALIZE */ TRIM(CUSTOMER_CODE) AS CC, MIN(PRFT_CUST_ID) AS PID FROM MG_CUSTOMER_INTER GROUP BY TRIM(CUSTOMER_CODE)
),
MCIS AS (
    SELECT /*+ MATERIALIZE */ TRIM(TO_CHAR(SERIAL_NO)) AS SN, MIN(TRIM(CUSTOMER_CODE)) AS CC, MIN(PRFT_CUST_ID) AS PID
      FROM MG_CUSTOMER_INTER WHERE TRIM(FILE_NAME) = 'SSCAIFPCustomersNotInSSCUSTP' GROUP BY TRIM(TO_CHAR(SERIAL_NO))
),
GTR AS (
    SELECT /*+ MATERIALIZE */ DISTINCT x.OB, x.OS, x.GB, x.GS, x.SR, x.MDFL
      FROM (SELECT OB, OS, Y2GAB AS GB, Y2GAS AS GS, SR, MDFL FROM R_SEC WHERE Y2GAB &lt;&gt; 0 AND (OB &lt;&gt; Y2GAB OR OS &lt;&gt; Y2GAS)
            UNION ALL SELECT OB, OS, Y2GCB1, Y2GCS1, SR, MDFL FROM R_SEC WHERE Y2GCB1 &lt;&gt; 0 AND (OB &lt;&gt; Y2GCB1 OR OS &lt;&gt; Y2GCS1)
            UNION ALL SELECT OB, OS, Y2GCB2, Y2GCS2, SR, MDFL FROM R_SEC WHERE Y2GCB2 &lt;&gt; 0 AND (OB &lt;&gt; Y2GCB2 OR OS &lt;&gt; Y2GCS2)
            UNION ALL SELECT OB, OS, Y2GCB3, Y2GCS3, SR, MDFL FROM R_SEC WHERE Y2GCB3 &lt;&gt; 0 AND (OB &lt;&gt; Y2GCB3 OR OS &lt;&gt; Y2GCS3)) x
),
CPG AS (
    SELECT /*+ MATERIALIZE */ c.*
      FROM R_CP c
     WHERE NOT EXISTS (SELECT 1 FROM GTR g WHERE g.OB = c.ZUDCB AND g.OS = c.ZUDCS AND g.GB = c.ZUDCB2 AND g.GS = c.ZUDCS2)
),
PATH AS (
    SELECT /*+ MATERIALIZE */ DISTINCT x.OB, x.OS, x.SR,
           LPAD(TO_CHAR(x.ACB), 3, '0') || LPAD(TO_CHAR(x.ACS), 6, '0') || LPAD(TO_CHAR(x.ACX), 3, '0') AS ACC
      FROM (SELECT s.OB, s.OS, s.SR,
                   COALESCE(l.POACB, d.D1ACB) AS ACB, COALESCE(l.POACS, d.D1ACS) AS ACS, COALESCE(l.POACX, d.D1ACX) AS ACX
              FROM R_SEC s
              JOIN R_SCR r     ON r.VYDCB = s.OB AND r.VYDCS = s.OS AND r.VYSCSR = s.SR
              LEFT JOIN R_LS l ON l.PODCB = s.OB AND l.PODCS = s.OS AND l.POLMTY = r.VYLMTY AND l.POLINE = r.VYLINE
              LEFT JOIN R_DC d ON d.D1DCB = s.OB AND d.D1DCS = s.OS AND d.D1LMTY = r.VYLMTY AND d.D1LINE = r.VYLINE
             WHERE (l.POACB IS NOT NULL OR d.D1ACB IS NOT NULL)
               AND (EXISTS (SELECT 1 FROM GTR g WHERE g.OB = s.OB AND g.OS = s.OS)
                    OR EXISTS (SELECT 1 FROM CPG c WHERE c.ZUDCB = s.OB AND c.ZUDCS = s.OS))
            UNION
            SELECT s.OB, s.OS, s.SR,
                   COALESCE(l.POACB, d.D1ACB), COALESCE(l.POACS, d.D1ACS), COALESCE(l.POACX, d.D1ACX)
              FROM R_SEC s
              JOIN R_SCR r     ON r.VYDCB = s.OB AND r.VYDCS = s.OS AND r.VYSCSR = s.SR
              LEFT JOIN R_CLM c ON c.ZFDCB = s.OB AND c.ZFDCS = s.OS AND c.ZFCNLM = r.VYLMTY AND c.ZFCLIN = r.VYLINE
              LEFT JOIN R_LS l ON l.PODCB = s.OB AND l.PODCS = s.OS AND l.POLMTY = c.ZFLMTY AND l.POLINE = c.ZFLINE
              LEFT JOIN R_DC d ON d.D1DCB = s.OB AND d.D1DCS = s.OS AND d.D1LMTY = c.ZFLMTY AND d.D1LINE = c.ZFLINE
             WHERE (l.POACB IS NOT NULL OR d.D1ACB IS NOT NULL)
               AND (EXISTS (SELECT 1 FROM GTR g WHERE g.OB = s.OB AND g.OS = s.OS)
                    OR EXISTS (SELECT 1 FROM CPG c2 WHERE c2.ZUDCB = s.OB AND c2.ZUDCS = s.OS))) x
),
LNK AS (
    -- (λογαριασμός, guarantor HUB) σε επίπεδο owner. SRC: SEC (security slot) / CP (company file). SAME: ο guarantor είναι
    -- στο security από το οποίο περνά το path (μόνο για το INFO GU-007).
    SELECT /*+ MATERIALIZE */
           p.ACC, TO_CHAR(p.OB) || LPAD(TO_CHAR(p.OS), 6, '0') AS OWNER, 'SEC' AS SRC,
           TO_CHAR(g.GB) || LPAD(TO_CHAR(g.GS), 6, '0') AS GCODE, CAST(NULL AS NUMBER) AS GSER, CAST(NULL AS VARCHAR2(5)) AS ZUHUBN,
           MAX(CASE WHEN g.SR = p.SR THEN 'Y' ELSE 'N' END) AS SAME
      FROM PATH p JOIN GTR g ON g.OB = p.OB AND g.OS = p.OS
     GROUP BY p.ACC, TO_CHAR(p.OB) || LPAD(TO_CHAR(p.OS), 6, '0'), TO_CHAR(g.GB) || LPAD(TO_CHAR(g.GS), 6, '0')
    UNION ALL
    SELECT p.ACC, TO_CHAR(p.OB) || LPAD(TO_CHAR(p.OS), 6, '0'), 'CP',
           CASE WHEN c.ZUHUBN &lt;&gt; 'N'
                THEN (CASE WHEN c.ZUDCB2 &lt;&gt; 0 THEN TO_CHAR(c.ZUDCB2) END) || LPAD(CASE WHEN c.ZUDCS2 &lt;&gt; 0 THEN TO_CHAR(c.ZUDCS2) END, 6, '0') END,
           CASE WHEN c.ZUHUBN = 'N' THEN c.SERIAL_NUMBER END, MIN(c.ZUHUBN), 'n/a'
      FROM PATH p JOIN CPG c ON c.ZUDCB = p.OB AND c.ZUDCS = p.OS
     WHERE c.ZUHUBN IS NOT NULL
     GROUP BY p.ACC, TO_CHAR(p.OB) || LPAD(TO_CHAR(p.OS), 6, '0'),
              CASE WHEN c.ZUHUBN &lt;&gt; 'N'
                   THEN (CASE WHEN c.ZUDCB2 &lt;&gt; 0 THEN TO_CHAR(c.ZUDCB2) END) || LPAD(CASE WHEN c.ZUDCS2 &lt;&gt; 0 THEN TO_CHAR(c.ZUDCS2) END, 6, '0') END,
              CASE WHEN c.ZUHUBN = 'N' THEN c.SERIAL_NUMBER END
),
PA AS (
    SELECT /*+ MATERIALIZE */ DISTINCT TRIM(ACCOUNT_NUMBER) AS ACC FROM PROFITS_ACCOUNT
     WHERE TRIM(ACCOUNT_NUMBER) IN (SELECT ACC FROM LNK)
),
AC AS (
    -- 55000: COALESCE(MG_DPAC_LOAD.AGREEMENT_CODE, MG_LNS_MNT_LOAD.AGREEMENT_CODE) &lt;&gt; ' '
    SELECT /*+ MATERIALIZE */ p.ACC, MIN(TRIM(COALESCE(d.AGREEMENT_CODE, l.AGREEMENT_CODE))) AS AGR
      FROM PA p
      LEFT JOIN MG_DPAC_LOAD d    ON TRIM(d.ACCOUNT_NO) = p.ACC
      LEFT JOIN MG_LNS_MNT_LOAD l ON TRIM(l.OLD_LNS_NO) = p.ACC
     GROUP BY p.ACC
),
LKA AS (
    SELECT /*+ MATERIALIZE */ l.*,
           CASE WHEN p.ACC IS NOT NULL THEN 'Y' ELSE 'N' END AS IN_PA, a.AGR
      FROM LNK l
      LEFT JOIN PA p ON p.ACC = l.ACC
      LEFT JOIN AC a ON a.ACC = l.ACC
),
XG AS (
    -- αναμενόμενοι guarantors ανά agreement (μόνο links με agreement code, όπως το 55000)
    SELECT /*+ MATERIALIZE */ AGR, CC, MIN(PID) AS PID, MIN(SRC) AS SRC, MIN(OWNER) AS OWNER, MIN(GCODE) AS GCODE,
           MAX(SAME) AS SAME, MIN(ZUHUBN) AS ZUHUBN
      FROM (SELECT k.AGR, NVL(j.MC, k.GCODE) AS CC, m.PID, k.SRC, k.OWNER, k.GCODE, k.SAME, k.ZUHUBN
              FROM LKA k
              LEFT JOIN R_JNT j ON j.JC = k.GCODE
              LEFT JOIN MCI m   ON m.CC = NVL(j.MC, k.GCODE)
             WHERE k.AGR IS NOT NULL AND NVL(k.ZUHUBN, '#') &lt;&gt; 'N'
            UNION ALL
            SELECT k.AGR, NVL(s.CC, 'SSCAIFP SN ' || k.GSER), s.PID, k.SRC, k.OWNER, 'SSCAIFP SN ' || k.GSER, k.SAME, k.ZUHUBN
              FROM LKA k
              LEFT JOIN MCIS s ON s.SN = TRIM(TO_CHAR(k.GSER))
             WHERE k.AGR IS NOT NULL AND k.ZUHUBN = 'N')
     GROUP BY AGR, CC
),
AGR AS (
    SELECT /*+ MATERIALIZE */ TRIM(AGREEMENT_CODE) AS AGR, MIN(NEW_AGR_UNIT) AS AU, MIN(NEW_AGR_YEAR) AS AY, MIN(NEW_AGR_SN) AS AS_,
           MIN(NEW_AGR_MEM_SN) AS AM, MIN(TRIM(CUSTOMER_CODE)) AS ACC_CC
      FROM MG_AGR_MNT_LOAD GROUP BY TRIM(AGREEMENT_CODE)
),
AG AS (
    SELECT /*+ MATERIALIZE */
           FK_AGREEMENTFK_UNI AS AU, FK_AGREEMENTAGR_YE AS AY, FK_AGREEMENTAGR_SN AS AS_, FK_AGREEMENTAGR_ME AS AM,
           FK_CUSTOMERCUST_ID AS CID, COUNT(*) AS N, MAX(NVL(GUARANTEE_AMOUNT, 0)) AS AMT
      FROM AGREEMENT_GUARANT
     GROUP BY FK_AGREEMENTFK_UNI, FK_AGREEMENTAGR_YE, FK_AGREEMENTAGR_SN, FK_AGREEMENTAGR_ME, FK_CUSTOMERCUST_ID
),
AGK AS (
    -- γραμμές AGREEMENT_GUARANT + agreement code (μέσω MG_AGR_MNT_LOAD)
    SELECT /*+ MATERIALIZE */ g.*, a.AGR, a.ACC_CC
      FROM AG g
      JOIN (SELECT AU, AY, AS_, AM, MIN(AGR) AS AGR, MIN(ACC_CC) AS ACC_CC FROM AGR GROUP BY AU, AY, AS_, AM) a
        ON a.AU = g.AU AND a.AY = g.AY AND a.AS_ = g.AS_ AND a.AM = g.AM
),
STG AS (
    SELECT TRIM(FILE_NAME) AS FN, TRIM(ACCOUNT_NO) AS AGR, TRIM(CUSTOMER_CODE) AS CC,
           MAX(TRIM(TO_CHAR(ROW_STATUS))) AS RS, MIN(TRIM(ROW_ERR_DESC)) AS ERR
      FROM MG_BENEF_INTER WHERE TRIM(FILE_NAME) IN ('GUARANTORS', 'LGGUARANTORS')
     GROUP BY TRIM(FILE_NAME), TRIM(ACCOUNT_NO), TRIM(CUSTOMER_CODE)
),
GSV AS (
    -- αξία guarantee-type security (JSG / PGT / CGT / GPS / GDB / GGT, DC4 GU-010) ανά (owner, guarantor)
    SELECT TO_CHAR(g.OB) || LPAD(TO_CHAR(g.OS), 6, '0') AS OWNER, TO_CHAR(g.GB) || LPAD(TO_CHAR(g.GS), 6, '0') AS GCODE,
           MAX(GREATEST(NVL(s.SCVR, 0), NVL(s.SPA, 0)) / 100) AS VAL
      FROM GTR g
      JOIN R_SEC s ON s.OB = g.OB AND s.OS = g.OS AND s.SR = g.SR
     WHERE s.SCCD IN ('JSG', 'PGT', 'CGT', 'GPS', 'GDB', 'GGT')
     GROUP BY TO_CHAR(g.OB) || LPAD(TO_CHAR(g.OS), 6, '0'), TO_CHAR(g.GB) || LPAD(TO_CHAR(g.GS), 6, '0')
),
LGA AS (
    -- LG του HUB με owner joint, που υπάρχουν στο LG_ACCOUNT, + AGRLG agreement
    SELECT /*+ MATERIALIZE */ g.LGN, g.OWN, 'AGRLG' || g.LGN AS AGR, a.AU, a.AY, a.AS_, a.AM, la.ISSUER
      FROM R_LG g
      JOIN (SELECT TRIM(OLD_ACCOUNT) AS LGN, MIN(FKCUST_ISSUER) AS ISSUER FROM LG_ACCOUNT GROUP BY TRIM(OLD_ACCOUNT)) la ON la.LGN = g.LGN
      LEFT JOIN AGR a ON a.AGR = 'AGRLG' || g.LGN
     WHERE EXISTS (SELECT 1 FROM R_JNT j WHERE j.JC = g.OWN)
),
LGX AS (
    SELECT /*+ MATERIALIZE */ l.*, j.MC AS CC, m.PID
      FROM LGA l JOIN R_JNT j ON j.JC = l.OWN LEFT JOIN MCI m ON m.CC = j.MC
),
FINDINGS AS (
    -- Μία γραμμή ανά εύρημα. CUSTOMER_CODE = guarantor HUB (μετά το joint redirect), SERIAL_NO = agreement code.
    -- HUB_VALUE = τιμή HUB, NCIS_VALUE = τιμή PROFITS (AGREEMENT_GUARANT). Αναμενόμενη τιμή στο ISSUE.
    --==============================================================
    --GU-001. Αναμενόμενος guarantor δανείου / OVD (κανόνες 55000) χωρίς AGREEMENT_GUARANT στο agreement.
    SELECT
      CAST('GU-001_GUARANTOR_MISSING_IN_PROFITS' AS VARCHAR2(50)) AS CHECK_NAME,
      CAST(x.CC AS VARCHAR2(40)) AS CUSTOMER_CODE,
      CAST(x.AGR AS VARCHAR2(40)) AS SERIAL_NO,
      CAST(SUBSTR('OWNER ' || x.OWNER || '; HUB GUARANTOR ' || x.GCODE || '; SOURCE ' || x.SRC, 1, 200) AS VARCHAR2(200)) AS HUB_VALUE,
      CAST(SUBSTR((SELECT 'GUARANTORS=' || COUNT(*) FROM AG g WHERE g.AU = a.AU AND g.AY = a.AY AND g.AS_ = a.AS_ AND g.AM = a.AM), 1, 200) AS VARCHAR2(200)) AS NCIS_VALUE,
      CAST(SUBSTR(CASE WHEN x.PID IS NULL THEN 'GUARANTOR NOT IN MG_CUSTOMER_INTER'
                       WHEN a.AGR IS NULL THEN 'AGREEMENT NOT IN MG_AGR_MNT_LOAD'
                       WHEN (SELECT MAX(s.RS) FROM STG s WHERE s.FN = 'GUARANTORS' AND s.AGR = x.AGR AND s.CC = x.CC) = '2'
                            THEN 'REJECTED: ' || NVL((SELECT MIN(s.ERR) FROM STG s WHERE s.FN = 'GUARANTORS' AND s.AGR = x.AGR AND s.CC = x.CC), '-')
                       ELSE 'MISSING IN PROFITS' END, 1, 50) AS VARCHAR2(50)) AS ISSUE
    FROM XG x
    LEFT JOIN AGR a ON a.AGR = x.AGR
    WHERE x.PID IS NULL OR a.AGR IS NULL
       OR NOT EXISTS (SELECT 1 FROM AG g WHERE g.AU = a.AU AND g.AY = a.AY AND g.AS_ = a.AS_ AND g.AM = a.AM AND g.CID = x.PID)
    UNION ALL
    --==============================================================
    --GU-002. AGREEMENT_GUARANT agreement δανείου / OVD (όχι AGRLG) που δεν βγαίνει από τους κανόνες, ή διπλός.
    SELECT 'GU-002_GUARANTOR_NOT_EXPECTED', CAST(NULL AS VARCHAR2(40)), g.AGR,
           CAST(NULL AS VARCHAR2(200)),
           'CUSTOMER=' || g.CID || '; ROWS=' || g.N,
           CASE WHEN NOT EXISTS (SELECT 1 FROM XG x WHERE x.AGR = g.AGR AND x.PID = g.CID) THEN 'NOT A HUB GUARANTOR OF THE AGREEMENT'
                ELSE SUBSTR('DUPLICATE IN PROFITS (' || g.N || ' ROWS)', 1, 50) END
    FROM AGK g
    WHERE g.AGR NOT LIKE 'AGRLG%'
      AND (g.N &gt; 1 OR NOT EXISTS (SELECT 1 FROM XG x WHERE x.AGR = g.AGR AND x.PID = g.CID))
    UNION ALL
    --==============================================================
    --GU-003. Ποσό εγγύησης 0 ενώ ο guarantor έχει guarantee-type security με αξία στο HUB. Κανόνας του DC4 review (GU-010),
    --        όχι του 55000 (GUARANT_AMN 0).
    SELECT 'GU-003_GUARANTEE_AMOUNT_NOT_MIGRATED', x.CC, x.AGR,
           'GUARANTEE SECURITY VALUE ' || TO_CHAR(v.VAL), 'GUARANTEE_AMOUNT=' || g.AMT,
           SUBSTR('NOT MIGRATED (HUB ' || TO_CHAR(v.VAL) || ', DC4 REVIEW RULE)', 1, 50)
    FROM XG x
    JOIN AGR a ON a.AGR = x.AGR
    JOIN AG g  ON g.AU = a.AU AND g.AY = a.AY AND g.AS_ = a.AS_ AND g.AM = a.AM AND g.CID = x.PID
    JOIN GSV v ON v.OWNER = x.OWNER AND v.GCODE = x.GCODE
    WHERE x.SRC = 'SEC' AND v.VAL &gt; 0 AND NVL(g.AMT, 0) = 0
    UNION ALL
    --==============================================================
    --GU-004. Μέλος του joint owner LG που δεν είναι ούτε πελάτης της LG ούτε guarantor του AGRLG agreement (ΝΕΟ στο DC5).
    SELECT 'GU-004_LG_GUARANTOR_MISSING_IN_PROFITS', x.CC, x.AGR,
           SUBSTR('LG ' || x.LGN || '; JOINT OWNER ' || x.OWN, 1, 200),
           SUBSTR('LG CUSTOMER=' || x.ISSUER || '; GUARANTORS=' ||
                  (SELECT COUNT(*) FROM AG g WHERE g.AU = x.AU AND g.AY = x.AY AND g.AS_ = x.AS_ AND g.AM = x.AM), 1, 200),
           SUBSTR(CASE WHEN x.PID IS NULL THEN 'MEMBER NOT IN MG_CUSTOMER_INTER'
                       WHEN x.AU IS NULL THEN 'AGRLG AGREEMENT NOT IN MG_AGR_MNT_LOAD'
                       WHEN (SELECT MAX(s.RS) FROM STG s WHERE s.FN = 'LGGUARANTORS' AND s.AGR = x.AGR AND s.CC = x.CC) = '2'
                            THEN 'REJECTED: ' || NVL((SELECT MIN(s.ERR) FROM STG s WHERE s.FN = 'LGGUARANTORS' AND s.AGR = x.AGR AND s.CC = x.CC), '-')
                       ELSE 'MISSING IN PROFITS' END, 1, 50)
    FROM LGX x
    WHERE NVL(x.PID, -1) &lt;&gt; NVL(x.ISSUER, -2)
      AND NOT EXISTS (SELECT 1 FROM AG g WHERE g.AU = x.AU AND g.AY = x.AY AND g.AS_ = x.AS_ AND g.AM = x.AM AND g.CID = x.PID)
    UNION ALL
    --==============================================================
    --GU-005. AGREEMENT_GUARANT AGRLG agreement που δεν είναι μέλος του joint owner της LG, ή διπλός.
    SELECT 'GU-005_LG_GUARANTOR_NOT_EXPECTED', CAST(NULL AS VARCHAR2(40)), g.AGR,
           (SELECT 'JOINT OWNER ' || MIN(l.OWN) FROM LGA l WHERE l.AGR = g.AGR),
           'CUSTOMER=' || g.CID || '; ROWS=' || g.N,
           CASE WHEN NOT EXISTS (SELECT 1 FROM LGX x WHERE x.AGR = g.AGR AND x.PID = g.CID) THEN 'NOT A JOINT MEMBER OF THE HUB LG OWNER'
                ELSE SUBSTR('DUPLICATE IN PROFITS (' || g.N || ' ROWS)', 1, 50) END
    FROM AGK g
    WHERE g.AGR LIKE 'AGRLG%'
      AND (g.N &gt; 1 OR NOT EXISTS (SELECT 1 FROM LGX x WHERE x.AGR = g.AGR AND x.PID = g.CID))
)
SELECT
    CAST(CHECK_ID || '_' || TO_CHAR(ROW_NUMBER() OVER (PARTITION BY CHECK_ID ORDER BY CUSTOMER_CODE, SERIAL_NO), 'FM0000000') AS VARCHAR2(20)) AS DETAIL_ID,
    CAST(CHECK_ID AS VARCHAR2(10)) AS CHECK_ID,
    CAST(CHECK_NAME AS VARCHAR2(50)) AS CHECK_NAME,
    CAST(SUBSTR(CUSTOMER_CODE, 1, 30) AS VARCHAR2(30)) AS CUSTOMER_CODE,
    CAST(SUBSTR(SERIAL_NO, 1, 30) AS VARCHAR2(30)) AS SERIAL_NO,
    CAST(SUBSTR(HUB_VALUE, 1, 100) AS VARCHAR2(100)) AS HUB_VALUE,
    CAST(SUBSTR(NCIS_VALUE, 1, 100) AS VARCHAR2(100)) AS NCIS_VALUE,
    CAST(SUBSTR(ISSUE, 1, 50) AS VARCHAR2(50)) AS ISSUE,
    'DC5' AS DC_VERSION,
    1 AS RUN_VERSION,  -- TESTING ONLY: στο SSIS αντικαθίσταται από @[User::RunVersion] μέσω Derived Column.
    SYSDATE AS RUN_TIMESTAMP
FROM (
    SELECT
        F.*,
        CAST(SUBSTR(CHECK_NAME, 1, INSTR(CHECK_NAME, '_') - 1) AS VARCHAR2(10)) AS CHECK_ID
    FROM FINDINGS F
)
ORDER BY REGEXP_SUBSTR(CHECK_ID, '[A-Z]+'), TO_NUMBER(REGEXP_SUBSTR(CHECK_ID, '[0-9]+')), CUSTOMER_CODE, SERIAL_NO;</property>
                    <property
                      dataType="System.Int32"
                      description="Specify the number of rows fetched per batch."
                      expressionType="Notify"
                      name="BatchSize">1000</property>
                    <property
                      dataType="System.Int32"
                      description="Determines the chunk size allocation for LOB columns"
                      expressionType="Notify"
                      name="LobChunkSize">32768</property>
                    <property
                      dataType="System.Int32"
                      description="The code page to use when code page information is unavailable from the data source."
                      expressionType="Notify"
                      name="DefaultCodePage">1253</property>
                    <property
                      dataType="System.Int32"
                      description="Number of pre-fetched rows."
                      expressionType="Notify"
                      name="PrefetchCount">0</property>
                    <property
                      dataType="System.Int32"
                      description="The mode used to access the database."
                      name="AccessMode"
                      typeConverter="AccessMode">1</property>
                  </properties>
                  <connections>
                    <connection
                      refId="Package\Sequence Container\Guarantors_Detail\Guarantors_detail.Connections[ORACLEConnection]"
                      connectionManagerID="{ECA91632-834F-4B2F-85DF-6CA637347F58}:external"
                      connectionManagerRefId="Project.ConnectionManagers[PRE Connection Manager]"
                      description="The ORACLE runtime connection used to access the database."
                      name="ORACLEConnection" />
                  </connections>
                  <outputs>
                    <output
                      refId="Package\Sequence Container\Guarantors_Detail\Guarantors_detail.Outputs[Oracle Source Output]"
                      errorRowDisposition="FailComponent"
                      name="Oracle Source Output"
                      truncationRowDisposition="FailComponent">
