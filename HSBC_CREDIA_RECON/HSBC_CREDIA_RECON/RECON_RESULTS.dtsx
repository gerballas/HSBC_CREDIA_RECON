                          name="CHECK_NAME" />
                        <outputColumn
                          refId="Package\Sequence Container\Customer_Categories_Detail\Customer_Categories_detail.Outputs[Oracle Source Output].Columns[DETAIL_ID]"
                          codePage="1253"
                          dataType="str"
                          externalMetadataColumnId="Package\Sequence Container\Customer_Categories_Detail\Customer_Categories_detail.Outputs[Oracle Source Output].ExternalColumns[DETAIL_ID]"
                          length="20"
