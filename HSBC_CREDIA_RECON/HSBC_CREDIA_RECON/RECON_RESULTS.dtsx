        <DTS:Executable
          DTS:refId="Package\Sequence Container\Collaterals_Detail"
          DTS:CreationName="Microsoft.Pipeline"
          DTS:Description="Data Flow Task"
          DTS:DTSID="{3bf283c8-7d5c-4fb8-9305-fb73c6d648a3}"
          DTS:ExecutableType="Microsoft.Pipeline"
          DTS:LocaleID="-1"
          DTS:ObjectName="Collaterals_Detail"
          DTS:TaskContact="Performs high-performance data extraction, transformation and loading;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1">
          <DTS:Variables />
          <DTS:ObjectData>
            <pipeline
              version="1">
              <components>
                <component
                  refId="Package\Sequence Container\Collaterals_Detail\Collaterals_detail"
                  componentClassID="Microsoft.SSISOracleSrc"
                  contactInfo="Oracle Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;1"
                  description="Oracle Source"
                  name="Collaterals_detail"
                  usesDispositions="true"
                  version="1">
                  <properties>
                    <property
                      dataType="System.String"
                      description="The name of the table to be fetched."
                      expressionType="Notify"
                      name="TableName"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      expressionType="Notify"
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">-- ====================================================================
-- COL_RECON — DETAIL DC5 v1
-- Τροφοδοτεί: RECON.COL_RECON_DETAIL
-- Μία γραμμή ανά εύρημα για τα COL-001 .. COL-027 εκτός INFO (COL-018 .. 023): μόνο ό,τι αποτυγχάνει.
--
-- Ζευγάρι του MasterCollaterals_DC5_v1.sql: το κοινό κομμάτι και το FINDINGS είναι ΙΔΙΑ αυτούσια και
-- στα δύο αρχεία -&gt; INVALID_COUNT του Master = γραμμές εδώ ανά CHECK_ID.
-- Πηγές / κανόνες / κλειδί / αντιστοιχία με το DC4: βλ. header του Master.
--
--   - DETAIL_ID: '&lt;CHECK_ID&gt;_0000001', ...
--   - CUSTOMER_CODE: owner HUB (SSSECHP.CUSTOMER_CODE). NULL στα COL-002, 014 .. 017.
--   - SERIAL_NO: SSSECHP.SERIAL_NUMBER (COL-004 / 024: serial / agreement, COL-014 .. 017: stream / νόμισμα).
--   - HUB_VALUE = τιμή που συγκρίνεται (ποσά σε ευρώ), NCIS_VALUE = τιμή PROFITS, 100 χαρ.
--   - ISSUE: 'MISMATCH (EXPECTED &lt;τιμή&gt;)' ή η αιτία. Έως 50 χαρακτήρες, ποτέ κενό.
-- ====================================================================
WITH
-- --------------------------------------------------------------------
-- Κοινό κομμάτι (ΙΔΙΟ αυτούσιο στο Master και στο Detail).
--   R_*   = HUB πίνακες (synonyms HUB_MT_*): κάθε πίνακας ΜΙΑ φορά, μόνο οι στήλες που χρειάζονται.
--   H     = P1: αναμενόμενα collaterals με τον κανόνα του 80100 (γρ. 106-260), χτισμένα από το HUB,
--           με την αναμενόμενη τιμή κάθε πεδίου (X_*).
--   LNK   = P2: αναμενόμενα links collateral x agreement (κανόνας MG_COLL_ACCOUNT, 80100 γρ. 265-300).
--   M1    = MG_COLL_INTER_NEW (3 streams του 80100), ένα ανά SERIAL_NO (run 2026-11-19: K02).
--   P     = PROFITS COLLATERAL x COLLATERAL_TABLE x CURRENCY ανά τριάδα (SN, τύπος, μονάδα).
--   P3    = scope του NCIS_COLLATERALS (07_COLLATERALS.sql): P με COLLATERAL_TABLE, CURRENCY και ACCOUNT_COLLATERAL.
--   B     = P4: H x M1 (ROW_STATUS 1) x P3 στην τριάδα. Πάνω του τα checks πεδίων.
-- Joins με TRIM και στις δύο πλευρές (το 80100 20261118 δεν έχει TRIM, βλ. Report1 §2.3).
-- --------------------------------------------------------------------
BP AS (
    SELECT /*+ MATERIALIZE */ MAX(CURR_TRX_DATE) AS BP_DT, MAX(BANK_CODE) AS BP_BANK FROM BANK_PARAMETERS
),
R_SEC AS (
    SELECT /*+ MATERIALIZE */
           TRIM(TO_CHAR(SERIAL_NUMBER))             AS S_SNO,
           TRIM(CUSTOMER_CODE)                      AS S_CC,
           TRIM(TO_CHAR(Y2SCSR))                    AS S_SCSR,
           TRIM(Y2SCCD)                             AS S_CODE,
           TRIM(Y2CYCD)                             AS S_CCY,
           Y2SCVR                                   AS S_VAL,
           TRIM(TO_CHAR(Y2SCEX))                    AS S_EX,
           NVL(TO_CHAR(TO_NUMBER(TRIM(TO_CHAR(Y2DCB)) DEFAULT NULL ON CONVERSION ERROR)), TRIM(TO_CHAR(Y2DCB))) AS S_DCB,
           TRIM(CASH_COLLATERAL_ACCOUNT)            AS S_CASH,
           TRIM(SUBSTR(TRIM(COLLATERAL_DESC), 1, 240)) AS S_DESC
      FROM HUB_MT_SSSECHP
),
R_REL AS (
    SELECT /*+ MATERIALIZE */ DISTINCT
           TRIM(CUSTOMER_CODE) AS R_CC, TRIM(TO_CHAR(VYSCSR)) AS R_SCSR,
           TRIM(TO_CHAR(VYLMTY)) AS R_LMTY, TRIM(TO_CHAR(VYLINE)) AS R_LINE
      FROM HUB_MT_SSSCRLP
),
R_STD AS (
    SELECT /*+ MATERIALIZE */ TRIM(YHTBID) AS T_ID, TRIM(YHCODE) AS T_CODE, YHDS50 AS T_DS
      FROM HUB_MT_SSSTDPP
     WHERE TRIM(YHTBID) IN ('SC', 'Y1')
),
STD_SC AS (
    SELECT T_CODE AS SC_CODE, MAX(SUBSTR(TRIM(T_DS), 1, 80)) AS SC_TEXT FROM R_STD WHERE T_ID = 'SC' GROUP BY T_CODE
),
STD_Y1 AS (
    -- 80100: SC1 = Y1 με τελευταίο χαρακτήρα D / E (PROPERTIES), SC2 = Y1 με F (CASH), όπως είναι το YHDS50 (χωρίς TRIM)
    SELECT T_CODE AS Y1_CODE,
           MAX(CASE WHEN SUBSTR(T_DS, -1, 1) IN ('D', 'E') THEN 1 ELSE 0 END) AS Y1_PROP,
           MAX(CASE WHEN SUBSTR(T_DS, -1, 1) = 'F' THEN 1 ELSE 0 END)         AS Y1_CASH
      FROM R_STD WHERE T_ID = 'Y1' GROUP BY T_CODE
),
R_LS AS (
    SELECT /*+ MATERIALIZE */ TRIM(CUSTOMER_CODE) AS L_CC, TRIM(TO_CHAR(POLMTY)) AS L_LMTY,
           TRIM(TO_CHAR(POLINE)) AS L_LINE, TRIM(OLD_LNS_NO) AS L_AN
      FROM HUB_MT_LSACMSP
),
R_TD AS (
    SELECT /*+ MATERIALIZE */ TRIM(CUSTOMER_CODE) AS D_CC, TRIM(TO_CHAR(D1LMTY)) AS D_LMTY,
           TRIM(TO_CHAR(D1LINE)) AS D_LINE, TRIM(ACCOUNT_NO) AS D_AN
      FROM HUB_MT_DCACMSP
),
R_PL AS (
    -- LG: το 80100 συνδέει με το controlling limit (PFCNLM / PFCLIN), βλ. Report1 C-04
    SELECT /*+ MATERIALIZE */ TRIM(CUSTOMER_CODE) AS G_CC, TRIM(TO_CHAR(PFCNLM)) AS G_LMTY,
           TRIM(TO_CHAR(PFCLIN)) AS G_LINE, TRIM(OLD_LNS_NO) AS G_AN
      FROM HUB_MT_PLACMSP
),
R_JNT AS (
    SELECT /*+ MATERIALIZE */ DISTINCT TRIM(CUSTOMER_CODE) AS J_CC, TRIM(CUSTOMER_CODE2) AS J_CC2
      FROM HUB_MT_SSPRJIP
),
MGL AS (SELECT /*+ MATERIALIZE */ TRIM(OLD_LNS_NO) AS MGL_AN, MAX(TRIM(AGREEMENT_CODE)) AS MGL_AGR FROM MG_LNS_MNT_LOAD GROUP BY TRIM(OLD_LNS_NO)),
MGD AS (SELECT /*+ MATERIALIZE */ TRIM(ACCOUNT_NO) AS MGD_AN, MAX(TRIM(AGREEMENT_CODE)) AS MGD_AGR FROM MG_DPAC_LOAD GROUP BY TRIM(ACCOUNT_NO)),
MGG AS (SELECT /*+ MATERIALIZE */ TRIM(LG_ACC_NUMBER) AS MGG_AN, MAX(TRIM(AGREEMENT_CODE)) AS MGG_AGR FROM MG_LG_LOAD GROUP BY TRIM(LG_ACC_NUMBER)),
PA19 AS (SELECT /*+ MATERIALIZE */ DISTINCT TRIM(ACCOUNT_NUMBER) AS PA_AGR FROM PROFITS_ACCOUNT WHERE PRFT_SYSTEM = 19),
MAP AS (
    SELECT /*+ MATERIALIZE */ TRIM(HSBC_CODE) AS MP_HSBC, MAX(TRIM(PROFITS_CODE)) AS MP_PRFT
      FROM MG_HGR_COLLATERALS_PRODUCT_MAPPING GROUP BY TRIM(HSBC_CODE)
),
CUR AS (
    SELECT /*+ MATERIALIZE */ TRIM(SHORT_DESCR) AS CU_ISO, MAX(DISPLAYED_DECIMAL) AS CU_DEC
      FROM CURRENCY GROUP BY TRIM(SHORT_DESCR)
),
CURID AS (SELECT /*+ MATERIALIZE */ ID_CURRENCY AS CI_ID, MAX(TRIM(SHORT_DESCR)) AS CI_ISO FROM CURRENCY GROUP BY ID_CURRENCY),
CTY AS (
    -- τελική τιμή μετά το UPDATE COL_MECHANISM 10 -&gt; 11 του 80100
    SELECT /*+ MATERIALIZE */ TRIM(TO_CHAR(FK_PRODUCTID_PRODU)) AS CT_TYPE, MAX(COL_MECHANISM) AS CT_MECH
      FROM COLLATERAL_TYPE GROUP BY TRIM(TO_CHAR(FK_PRODUCTID_PRODU))
),
MCI AS (SELECT /*+ MATERIALIZE */ DISTINCT TRIM(CUSTOMER_CODE) AS MC_CC, TO_CHAR(PRFT_CUST_ID) AS MC_ID FROM MG_CUSTOMER_INTER),
MRE AS (
    SELECT /*+ MATERIALIZE */ TRIM(TO_CHAR(SERIAL_NO)) AS RE_SNO, MAX(PRFT_ID) AS RE_ID
      FROM MG_REAL_ESTATE WHERE TRIM(FILE_NAME) = 'CollateralsRealEstate' GROUP BY TRIM(TO_CHAR(SERIAL_NO))
),
DPL AS (SELECT /*+ MATERIALIZE */ DISTINCT TRIM(ACCOUNT_NO) AS DP_AN FROM MG_DPAC_LOAD),
FAC AS (
    -- Κάθε γραμμή SSSCRLP x loans x TDs x LGs της ίδιας γραμμής limit, όπως τα LEFT JOIN του 80100 (γρ. 293-299)
    SELECT /*+ MATERIALIZE */ r.R_CC, r.R_SCSR, l.MGL_AGR AS F_LAGR, d.MGD_AGR AS F_DAGR, g.MGG_AGR AS F_GAGR
      FROM R_REL r
      LEFT JOIN (SELECT L_CC, L_LMTY, L_LINE, MGL_AGR FROM R_LS LEFT JOIN MGL ON MGL_AN = L_AN) l
             ON l.L_CC = r.R_CC AND l.L_LMTY = r.R_LMTY AND l.L_LINE = r.R_LINE
      LEFT JOIN (SELECT D_CC, D_LMTY, D_LINE, MGD_AGR FROM R_TD LEFT JOIN MGD ON MGD_AN = D_AN) d
             ON d.D_CC = r.R_CC AND d.D_LMTY = r.R_LMTY AND d.D_LINE = r.R_LINE
      LEFT JOIN (SELECT G_CC, G_LMTY, G_LINE, MGG_AGR FROM R_PL LEFT JOIN MGG ON MGG_AN = G_AN) g
             ON g.G_CC = r.R_CC AND g.G_LMTY = r.R_LMTY AND g.G_LINE = r.R_LINE
),
REL_OK AS (
    -- EXISTS του 80100 (γρ. 232-259): ένα τουλάχιστον facility με agreement στο PROFITS_ACCOUNT system 19
    SELECT /*+ MATERIALIZE */ DISTINCT f.R_CC, f.R_SCSR
      FROM FAC f
      LEFT JOIN PA19 a1 ON a1.PA_AGR = f.F_LAGR
      LEFT JOIN PA19 a2 ON a2.PA_AGR = f.F_DAGR
      LEFT JOIN PA19 a3 ON a3.PA_AGR = f.F_GAGR
     WHERE a1.PA_AGR IS NOT NULL OR a2.PA_AGR IS NOT NULL OR a3.PA_AGR IS NOT NULL
),
LINKS_ALL AS (
    -- MG_COLL_ACCOUNT: COALESCE(loan, TD, LG agreement) που υπάρχει στο PROFITS_ACCOUNT system 19
    SELECT /*+ MATERIALIZE */ DISTINCT f.R_CC, f.R_SCSR, a.PA_AGR AS LA_AGR
      FROM FAC f JOIN PA19 a ON a.PA_AGR = COALESCE(f.F_LAGR, f.F_DAGR, f.F_GAGR)
),
H0 AS (
    SELECT /*+ MATERIALIZE */ s.*, sc.SC_TEXT AS X_TEXT1,
           CASE WHEN y.Y1_PROP = 1 THEN 'COLLATERALS_PROPERTIES'
                WHEN y.Y1_CASH = 1 THEN 'CASH_COLLATERALS'
                ELSE 'COLLATERALS_NON_PROPERTIES' END                  AS X_STREAM,
           COALESCE(mp.MP_PRFT, mp.MP_HSBC)                            AS X_TYPE,
           cu.CU_ISO                                                   AS X_CU_ISO,
           CASE WHEN cu.CU_DEC = 2 THEN 100 ELSE 1 END                 AS X_DIV,
           CASE WHEN s.S_EX IN ('0', '99999999') THEN DATE '9999-12-31'
                ELSE TO_DATE(SUBSTR(REGEXP_REPLACE(s.S_EX, '[^0-9]', ''), 1, 8) DEFAULT NULL ON CONVERSION ERROR, 'YYYYMMDD') END AS X_EXD,
           re.RE_ID                                                    AS X_RE
      FROM R_SEC s
      JOIN STD_SC sc      ON sc.SC_CODE = s.S_CODE
      LEFT JOIN STD_Y1 y  ON y.Y1_CODE = s.S_CODE
      LEFT JOIN MAP mp    ON mp.MP_HSBC = s.S_CODE
      LEFT JOIN CUR cu    ON cu.CU_ISO = s.S_CCY
      LEFT JOIN MRE re    ON re.RE_SNO = s.S_SNO
     WHERE EXISTS (SELECT 1 FROM REL_OK r WHERE r.R_CC = s.S_CC AND r.R_SCSR = s.S_SCSR)
),
LNK AS (
    SELECT /*+ MATERIALIZE */ DISTINCT h.S_SNO AS K_SNO, la.LA_AGR AS K_AGR
      FROM H0 h JOIN LINKS_ALL la ON la.R_CC = h.S_CC AND la.R_SCSR = h.S_SCSR
),
LNK_MAX AS (SELECT K_SNO AS KM_SNO, MAX(K_AGR) AS KM_AGR, COUNT(*) AS KM_CNT FROM LNK GROUP BY K_SNO),
H AS (
    SELECT /*+ MATERIALIZE */ h.*,
           ct.CT_MECH AS X_MECH,
           CASE WHEN ct.CT_MECH = 4 AND h.S_VAL / h.X_DIV = 0 THEN 1 ELSE h.S_VAL / h.X_DIV END AS X_VAL,
           h.S_VAL / h.X_DIV                                                AS X_INS,
           CASE WHEN h.X_EXD &lt; bp.BP_DT THEN DATE '9999-12-31' ELSE h.X_EXD END AS X_D2,
           CASE WHEN ct.CT_MECH IN (3, 4) THEN km.KM_AGR END                AS X_ACC1,
           NVL(km.KM_CNT, 0)                                                AS X_NLNK,
           CASE WHEN h.S_CCY = 'CNH' THEN 'CNY' ELSE h.S_CCY END            AS X_CCY,
           CASE WHEN h.X_STREAM = 'CASH_COLLATERALS' THEN NVL(h.S_CASH, 'TEST') END AS X_ACC2,
           CASE WHEN h.X_STREAM = 'CASH_COLLATERALS' AND h.S_CASH IS NULL THEN '3' END AS X_SYS2,
           CASE WHEN h.X_STREAM = 'CASH_COLLATERALS' AND dp.DP_AN IS NULL
                THEN '0' ELSE TO_CHAR(bp.BP_BANK) END                      AS X_COOP
      FROM H0 h
      CROSS JOIN BP bp
      LEFT JOIN CTY ct     ON ct.CT_TYPE = h.X_TYPE
      LEFT JOIN LNK_MAX km ON km.KM_SNO = h.S_SNO
      LEFT JOIN DPL dp     ON dp.DP_AN = h.S_CASH
),
CAND AS (
    -- Connected customer: owner, ή (αν ο owner είναι joint στο SSPRJIP) οποιοσδήποτε CUSTOMER_CODE2:
    -- το 80100 κρατά SERIAL_NO = 1 με ORDER BY την ίδια τη στήλη του partition (τυχαία επιλογή)
    SELECT /*+ MATERIALIZE */ h.S_SNO AS CD_SNO, NVL(j.J_CC2, h.S_CC) AS CD_CC, m.MC_ID AS CD_ID
      FROM H h
      LEFT JOIN R_JNT j ON j.J_CC = h.S_CC
      LEFT JOIN MCI m   ON m.MC_CC = NVL(j.J_CC2, h.S_CC)
),
CANDA AS (
    SELECT CD_SNO AS CA_SNO, COUNT(DISTINCT CD_CC) AS CA_N, MIN(CD_ID) AS CA_ID, MIN(NVL(CD_ID, CD_CC)) AS CA_SHOW
      FROM CAND GROUP BY CD_SNO
),
M1 AS (
    SELECT /*+ MATERIALIZE */
           TRIM(TO_CHAR(SERIAL_NO))       AS M_SNO,
           PRFT_COLLATERAL_SN             AS M_PSN,
           TRIM(TO_CHAR(COLLATERAL_TYPE)) AS M_TYPE,
           TRIM(TO_CHAR(ENTRY_UNIT))      AS M_UNIT,
           TRIM(TO_CHAR(ROW_STATUS))      AS M_RS,
           TRIM(COLL_ERR_DESC)            AS M_ERR,
           TRIM(FILE_NAME)                AS M_FN,
           TRIM(TO_CHAR(REAL_ESTATE_ID))  AS M_RE
      FROM MG_COLL_INTER_NEW
     WHERE TRIM(FILE_NAME) IN ('COLLATERALS_PROPERTIES', 'COLLATERALS_NON_PROPERTIES', 'CASH_COLLATERALS')
),
MT AS (
    SELECT M_PSN AS MT_PSN, M_TYPE AS MT_TYPE, M_UNIT AS MT_UNIT, COUNT(*) AS MT_N,
           SUM(CASE WHEN M_RS = '1' THEN 1 ELSE 0 END) AS MT_N1,
           MAX(CASE WHEN M_RS = '1' THEN M_SNO END)    AS MT_SNO,
           MAX(CASE WHEN M_RS = '1' THEN M_FN END)     AS MT_FN
      FROM M1 GROUP BY M_PSN, M_TYPE, M_UNIT
),
C1 AS (
    SELECT /*+ MATERIALIZE */
           c.COLLATERAL_SN                    AS C_SN,
           TRIM(TO_CHAR(c.FK_COLLATERAL_TFK)) AS C_TYPE,
           TRIM(TO_CHAR(c.FK_UNITCODE))       AS C_UNIT,
           c.COL_EST_VALUE_AMN                AS C_VAL,
           c.COL_EST_INSURANCE                AS C_INS,
           c.CB_INSURANCE_AMN                 AS C_CB,
           TO_CHAR(c.COLLTBL_CUST_ID)         AS C_CUST,
           c.INIT_ESTIMATION_DT               AS C_INIT,
           c.FREQ_ESTIMATION                  AS C_FREQ,
           c.NEXT_ESTIMATION_DT               AS C_NEXT,
           TRIM(c.COLLATERAL_DESC)            AS C_DESC,
           c.COLLTBL_INTERNAL_SN              AS C_TSN,
           c.COLLTBL_RECORD_TYPE              AS C_TRT,
           c.FK_CURRENCYID_CURR               AS C_CURID
      FROM COLLATERAL c
     WHERE c.COLLATERAL_SN IN (SELECT M_PSN FROM M1)
),
CT1 AS (
    SELECT /*+ MATERIALIZE */
           INTERNAL_SN AS T_SN, RECORD_TYPE AS T_RT, TRUNC(DATE_2) AS T_D2,
           TRIM(PROFITS_ACCOUNT_1) AS T_ACC1, TRIM(PROFITS_ACCOUNT_2) AS T_ACC2, TO_CHAR(PRFT_SYSTEM_2) AS T_SYS2,
           TO_CHAR(COLLABORATION_BANK) AS T_BANK, REAL_ESTATE_ID AS T_RE,
           TRIM(LARGE_DESCR_1) AS T_TX1, TRIM(LAGRE_DESCR_2) AS T_TX2, TRIM(LARGE_DESCR_3) AS T_TX3
      FROM COLLATERAL_TABLE
     WHERE INTERNAL_SN IN (SELECT C_TSN FROM C1)
),
AC1 AS (
    SELECT /*+ MATERIALIZE */
           FK_COLLATERALCOLLA AS A_SN, TRIM(TO_CHAR(FK_COLLATERALFK_CO)) AS A_TYPE,
           TRIM(TO_CHAR(FK_COLLATERALFK_UN)) AS A_UNIT, TRIM(PRFT_ACCOUNT) AS A_ACC, EST_VALUE_AMN AS A_VAL
      FROM ACCOUNT_COLLATERAL
     WHERE FK_COLLATERALCOLLA IN (SELECT M_PSN FROM M1)
),
ACN AS (SELECT A_SN AS AN_SN, A_TYPE AS AN_TYPE, A_UNIT AS AN_UNIT, COUNT(*) AS AN_N FROM AC1 GROUP BY A_SN, A_TYPE, A_UNIT),
P AS (
    SELECT /*+ MATERIALIZE */ c.*, t.*, ci.CI_ISO AS P_CCY, NVL(an.AN_N, 0) AS P_NAC
      FROM C1 c
      LEFT JOIN CT1 t   ON t.T_SN = c.C_TSN AND t.T_RT = c.C_TRT
      LEFT JOIN CURID ci ON ci.CI_ID = c.C_CURID
      LEFT JOIN ACN an  ON an.AN_SN = c.C_SN AND an.AN_TYPE = c.C_TYPE AND an.AN_UNIT = c.C_UNIT
),
P3 AS (
    SELECT /*+ MATERIALIZE */ p.*, mt.MT_N, mt.MT_N1, mt.MT_SNO, NVL(mt.MT_FN, 'UNMATCHED') AS P_STREAM
      FROM P p
      LEFT JOIN MT mt ON mt.MT_PSN = p.C_SN AND mt.MT_TYPE = p.C_TYPE AND mt.MT_UNIT = p.C_UNIT
     WHERE p.T_SN IS NOT NULL AND p.P_CCY IS NOT NULL AND p.P_NAC &gt; 0
),
B AS (
    SELECT /*+ MATERIALIZE */ h.*, m.*, p.*
      FROM H h
      JOIN M1 m ON m.M_SNO = h.S_SNO AND m.M_RS = '1'
      JOIN P3 p ON p.C_SN = m.M_PSN AND p.C_TYPE = m.M_TYPE AND p.C_UNIT = m.M_UNIT
),
EL AS (SELECT /*+ MATERIALIZE */ K_SNO AS EL_SNO, K_AGR AS EL_AGR FROM LNK WHERE K_SNO IN (SELECT S_SNO FROM B)),
BL AS (
    SELECT /*+ MATERIALIZE */ b.S_SNO AS BL_SNO, a.A_ACC AS BL_AGR, MAX(a.A_VAL) AS BL_VAL, COUNT(*) AS BL_N
      FROM B b JOIN AC1 a ON a.A_SN = b.C_SN AND a.A_TYPE = b.C_TYPE AND a.A_UNIT = b.C_UNIT
     GROUP BY b.S_SNO, a.A_ACC
),
CMATCH AS (
    SELECT /*+ MATERIALIZE */ DISTINCT b.S_SNO AS CM_SNO
      FROM B b JOIN CAND k ON k.CD_SNO = b.S_SNO
     WHERE k.CD_ID = b.C_CUST OR k.CD_CC = b.C_CUST
),
HS AS (SELECT /*+ MATERIALIZE */ DISTINCT S_SNO AS HS_SNO FROM H),
LJ AS (
    SELECT /*+ MATERIALIZE */ NVL(e.EL_SNO, l.BL_SNO) AS LJ_SNO, NVL(e.EL_AGR, l.BL_AGR) AS LJ_AGR,
           e.EL_AGR, l.BL_AGR, l.BL_VAL, l.BL_N
      FROM EL e FULL OUTER JOIN BL l ON l.BL_SNO = e.EL_SNO AND l.BL_AGR = e.EL_AGR
),
-- Ομαδικά (counts / totals): HUB P1 έναντι PROFITS P3
G_STREAM AS (
    SELECT NVL(hs.G_ST, ps.G_ST) AS GS_ST, NVL(hs.G_N, 0) AS GS_HN, NVL(ps.G_N, 0) AS GS_PN,
           NVL(hs.G_V, 0) AS GS_HV, NVL(ps.G_V, 0) AS GS_PV
      FROM (SELECT X_STREAM AS G_ST, COUNT(*) AS G_N, SUM(X_VAL) AS G_V FROM H GROUP BY X_STREAM) hs
      FULL OUTER JOIN (SELECT P_STREAM AS G_ST, COUNT(*) AS G_N, SUM(C_VAL) AS G_V FROM P3 GROUP BY P_STREAM) ps
        ON ps.G_ST = hs.G_ST
),
G_CCY AS (
    SELECT NVL(hc.G_CY, pc.G_CY) AS GC_CY, NVL(hc.G_N, 0) AS GC_HN, NVL(pc.G_N, 0) AS GC_PN,
           NVL(hc.G_V, 0) AS GC_HV, NVL(pc.G_V, 0) AS GC_PV
      FROM (SELECT NVL(X_CCY, '(EMPTY)') AS G_CY, COUNT(*) AS G_N, SUM(X_VAL) AS G_V FROM H GROUP BY NVL(X_CCY, '(EMPTY)')) hc
      FULL OUTER JOIN (SELECT P_CCY AS G_CY, COUNT(*) AS G_N, SUM(C_VAL) AS G_V FROM P3 GROUP BY P_CCY) pc
        ON pc.G_CY = hc.G_CY
),
G_AGR AS (
    SELECT (SELECT COUNT(DISTINCT K_AGR) FROM LNK) AS GA_HN,
           (SELECT COUNT(DISTINCT a.A_ACC) FROM AC1 a
              JOIN P3 p ON p.C_SN = a.A_SN AND p.C_TYPE = a.A_TYPE AND p.C_UNIT = a.A_UNIT) AS GA_PN
      FROM DUAL
),
FINDINGS AS (
    -- Μία γραμμή ανά εύρημα. CUSTOMER_CODE = owner HUB (SSSECHP.CUSTOMER_CODE), SERIAL_NO = SSSECHP.SERIAL_NUMBER
    -- (για COL-004 / 024: serial / agreement, για COL-014..017: stream / νόμισμα). HUB_VALUE = η τιμή που
    -- συγκρίνεται (ποσά σε ευρώ με /DIV όπως το migration), NCIS_VALUE = η τιμή του PROFITS, αναμενόμενη τιμή στο ISSUE.
    -- Τα INFO checks (COL-018..023) δεν έχουν γραμμές εδώ: μετρώνται μόνο στο Master.
    --==============================================================
    --COL-001. Collateral HUB (P1) που δεν είναι στο PROFITS (scope NCIS). ISSUE = αιτία από MG / PROFITS
    SELECT
      CAST('COL-001_COLLATERAL_MISSING_IN_PROFITS' AS VARCHAR2(50)) AS CHECK_NAME,
      CAST(h.S_CC AS VARCHAR2(40)) AS CUSTOMER_CODE, CAST(h.S_SNO AS VARCHAR2(40)) AS SERIAL_NO,
      CAST('CODE=' || h.S_CODE || '; STREAM=' || SUBSTR(h.X_STREAM, 1, 20) || '; LINKS=' || h.X_NLNK AS VARCHAR2(200)) AS HUB_VALUE,
      CAST(CASE WHEN m.M_SNO IS NOT NULL THEN 'MG ROW_STATUS=' || m.M_RS || '; PRFT_SN=' || m.M_PSN END AS VARCHAR2(200)) AS NCIS_VALUE,
      CAST(SUBSTR(
        CASE WHEN m.M_SNO IS NULL THEN 'NOT_STAGED_IN_MG_COLL_INTER_NEW'
             WHEN m.M_RS = '2' THEN 'REJECTED: ' || m.M_ERR
             WHEN m.M_RS &lt;&gt; '1' OR m.M_RS IS NULL THEN 'NOT_LOADED (ROW_STATUS ' || NVL(m.M_RS, '-') || ')'
             WHEN p.C_SN IS NULL THEN 'NOT_IN_COLLATERAL (SN+TYPE+UNIT)'
             WHEN p.T_SN IS NULL THEN 'NO_COLLATERAL_TABLE_ROW'
             WHEN p.P_NAC = 0 THEN 'NO_ACCOUNT_COLLATERAL_ROW'
             ELSE 'NO_CURRENCY' END, 1, 50) AS VARCHAR2(50)) AS ISSUE
    FROM H h
    LEFT JOIN M1 m ON m.M_SNO = h.S_SNO
    LEFT JOIN P p  ON p.C_SN = m.M_PSN AND p.C_TYPE = m.M_TYPE AND p.C_UNIT = m.M_UNIT AND m.M_RS = '1'
    WHERE NOT EXISTS (SELECT 1 FROM B b WHERE b.S_SNO = h.S_SNO)
    UNION ALL
    --==============================================================
    --COL-002. Collateral PROFITS (P3) που δεν αντιστοιχεί σε ένα collateral HUB (P1) μέσω μίας φορτωμένης γραμμής MG
    SELECT 'COL-002_EXTRA_COLLATERAL_IN_PROFITS', CAST(NULL AS VARCHAR2(40)),
           p.MT_SNO, CAST(NULL AS VARCHAR2(200)),
           'SN=' || p.C_SN || '; TYPE=' || p.C_TYPE || '; UNIT=' || p.C_UNIT,
           CASE WHEN p.MT_N IS NULL THEN 'NO_MG_ROW_SAME_SN_TYPE_UNIT'
                WHEN NVL(p.MT_N1, 0) = 0 THEN 'MATCHED_ONLY_BY_REJECTED_MG_ROW'
                WHEN p.MT_N1 &gt; 1 THEN 'MULTIPLE_LOADED_MG_ROWS (' || p.MT_N1 || ')'
                ELSE 'SERIAL_NOT_IN_HUB_SCOPE' END
    FROM P3 p
    LEFT JOIN HS hs ON hs.HS_SNO = p.MT_SNO
    WHERE p.MT_N IS NULL OR NVL(p.MT_N1, 0) &lt;&gt; 1 OR hs.HS_SNO IS NULL
    UNION ALL
    --==============================================================
    --COL-003. Collateral_Mechanism: COALESCE(mapping PROFITS_CODE, HSBC_CODE) του Y2SCCD vs FK_COLLATERAL_TFK
    SELECT 'COL-003_COLLATERAL_MECHANISM_MISMATCH', S_CC, S_SNO, S_CODE, C_TYPE,
           CASE WHEN X_TYPE IS NULL THEN 'UNMAPPED (Y2SCCD ' || S_CODE || ')'
                WHEN X_TYPE = 'xxxxx' THEN 'PLACEHOLDER xxxxx (MTI)'
                ELSE 'MISMATCH (EXPECTED ' || X_TYPE || ')' END
    FROM B
    WHERE NVL(X_TYPE, '-') &lt;&gt; NVL(C_TYPE, '-')
    UNION ALL
    --==============================================================
    --COL-004. Links collateral x agreement (MG_COLL_ACCOUNT) vs ACCOUNT_COLLATERAL.PRFT_ACCOUNT, για collaterals του B
    SELECT 'COL-004_COVERED_AGREEMENT_LINK', b.S_CC, j.LJ_SNO || ' / ' || j.LJ_AGR, j.EL_AGR, j.BL_AGR,
           CASE WHEN j.BL_AGR IS NULL THEN 'MISSING_LINK_IN_PROFITS' ELSE 'EXTRA_LINK_IN_PROFITS' END
    FROM LJ j
    LEFT JOIN (SELECT DISTINCT S_SNO, S_CC FROM B) b ON b.S_SNO = j.LJ_SNO
    WHERE j.EL_AGR IS NULL OR j.BL_AGR IS NULL
    UNION ALL
    --==============================================================
    --COL-005. Collateral_Value: Y2SCVR / DIV, 0 -&gt; 1 για COL_MECHANISM 4 vs COL_EST_VALUE_AMN
    SELECT 'COL-005_COLLATERAL_VALUE_MISMATCH', S_CC, S_SNO,
           TO_CHAR(X_VAL, 'FM999999999999990.00'), TO_CHAR(C_VAL, 'FM999999999999990.00'),
           CASE WHEN X_CU_ISO IS NULL THEN 'CCY_NOT_IN_CURRENCY (EXPECTED ' || TO_CHAR(X_VAL, 'FM999999999999990.00') || ')'
                WHEN ABS(NVL(C_VAL, 0) - NVL(X_VAL, 0) * 100) &lt;= 0.005 OR ABS(NVL(C_VAL, 0) * 100 - NVL(X_VAL, 0)) &lt;= 0.005
                     THEN 'X100 (EXPECTED ' || TO_CHAR(X_VAL, 'FM999999999999990.00') || ')'
                ELSE 'MISMATCH (EXPECTED ' || TO_CHAR(X_VAL, 'FM999999999999990.00') || ')' END
    FROM B
    WHERE ABS(NVL(C_VAL, 0) - NVL(X_VAL, 0)) &gt; 0.005
    UNION ALL
    --==============================================================
    --COL-006. Estimated_Security_Value_Amount: Y2SCVR / DIV vs COL_EST_INSURANCE
    SELECT 'COL-006_EST_SECURITY_VALUE_MISMATCH', S_CC, S_SNO,
           TO_CHAR(X_INS, 'FM999999999999990.00'), TO_CHAR(C_INS, 'FM999999999999990.00'),
           CASE WHEN X_CU_ISO IS NULL THEN 'CCY_NOT_IN_CURRENCY (EXPECTED ' || TO_CHAR(X_INS, 'FM999999999999990.00') || ')'
                WHEN ABS(NVL(C_INS, 0) - NVL(X_INS, 0) * 100) &lt;= 0.005 OR ABS(NVL(C_INS, 0) * 100 - NVL(X_INS, 0)) &lt;= 0.005
                     THEN 'X100 (EXPECTED ' || TO_CHAR(X_INS, 'FM999999999999990.00') || ')'
                ELSE 'MISMATCH (EXPECTED ' || TO_CHAR(X_INS, 'FM999999999999990.00') || ')' END
    FROM B
    WHERE ABS(NVL(C_INS, 0) - NVL(X_INS, 0)) &gt; 0.005
    UNION ALL
    --==============================================================
    --COL-007. Central_Bank_Security_Value: Y2SCVR / DIV vs CB_INSURANCE_AMN
    SELECT 'COL-007_CB_SECURITY_VALUE_MISMATCH', S_CC, S_SNO,
           TO_CHAR(X_INS, 'FM999999999999990.00'), TO_CHAR(C_CB, 'FM999999999999990.00'),
           CASE WHEN X_CU_ISO IS NULL THEN 'CCY_NOT_IN_CURRENCY (EXPECTED ' || TO_CHAR(X_INS, 'FM999999999999990.00') || ')'
                WHEN ABS(NVL(C_CB, 0) - NVL(X_INS, 0) * 100) &lt;= 0.005 OR ABS(NVL(C_CB, 0) * 100 - NVL(X_INS, 0)) &lt;= 0.005
                     THEN 'X100 (EXPECTED ' || TO_CHAR(X_INS, 'FM999999999999990.00') || ')'
                ELSE 'MISMATCH (EXPECTED ' || TO_CHAR(X_INS, 'FM999999999999990.00') || ')' END
    FROM B
    WHERE ABS(NVL(C_CB, 0) - NVL(X_INS, 0)) &gt; 0.005
    UNION ALL
    --==============================================================
    --COL-008. Account_number_1: MAX(agreement) για COL_MECHANISM 3 / 4 (MERGE 80100), αλλιώς κενό vs PROFITS_ACCOUNT_1
    SELECT 'COL-008_ACCOUNT_NUMBER_1_MISMATCH', S_CC, S_SNO, X_ACC1, T_ACC1,
           CASE WHEN X_ACC1 IS NULL THEN 'EXPECTED_EMPTY (MECHANISM ' || NVL(TO_CHAR(X_MECH), '-') || ')'
                ELSE 'MISMATCH (EXPECTED ' || X_ACC1 || ')' END
    FROM B
    WHERE NVL(X_ACC1, '-') &lt;&gt; NVL(T_ACC1, '-')
    UNION ALL
    --==============================================================
    --COL-009. Connected_Customer_1: owner (ή joint του SSPRJIP) -&gt; MG_CUSTOMER_INTER.PRFT_CUST_ID vs COLLTBL_CUST_ID.
    --         Παραδοχή DC4: δεκτό και ο κωδικός HUB. Joint: δεκτός οποιοσδήποτε CUSTOMER_CODE2.
    SELECT 'COL-009_CONNECTED_CUSTOMER_MISMATCH', b.S_CC, b.S_SNO, ca.CA_SHOW, b.C_CUST,
           CASE WHEN ca.CA_N &gt; 1 THEN 'JOINT_CUSTOMER (' || ca.CA_N || ' CANDIDATES)'
                WHEN ca.CA_ID IS NULL THEN 'CUSTOMER_NOT_IN_MG_CUSTOMER_INTER'
                ELSE 'MISMATCH (EXPECTED ' || ca.CA_ID || ')' END
    FROM B b
    LEFT JOIN CANDA ca  ON ca.CA_SNO = b.S_SNO
    LEFT JOIN CMATCH cm ON cm.CM_SNO = b.S_SNO
    WHERE cm.CM_SNO IS NULL
    UNION ALL
    --==============================================================
    --COL-010. Currency_format_ISO: Y2CYCD (CNH -&gt; CNY, παραδοχή DC4) vs CURRENCY.SHORT_DESCR
    SELECT 'COL-010_CURRENCY_MISMATCH', S_CC, S_SNO, S_CCY, P_CCY, 'MISMATCH (EXPECTED ' || X_CCY || ')'
    FROM B
    WHERE NVL(X_CCY, '-') &lt;&gt; NVL(P_CCY, '-')
    UNION ALL
    --==============================================================
    --COL-011. Date_2: Y2SCEX (0 / 99999999 -&gt; 9999-12-31, λήξη πριν από CURR_TRX_DATE -&gt; 9999-12-31) vs COLLATERAL_TABLE.DATE_2
    SELECT 'COL-011_DATE_2_MISMATCH', S_CC, S_SNO, S_EX, TO_CHAR(T_D2, 'YYYYMMDD'),
           CASE WHEN X_EXD IS NULL AND S_EX IS NOT NULL THEN 'INVALID_HUB_DATE'
                WHEN X_D2 = DATE '9999-12-31' AND X_EXD &lt;&gt; X_D2 THEN 'EXPIRED_TO_9999 (EXPECTED 99991231)'
                ELSE 'MISMATCH (EXPECTED ' || NVL(TO_CHAR(X_D2, 'YYYYMMDD'), 'EMPTY') || ')' END
    FROM B
    WHERE NVL(X_D2, DATE '0001-01-01') &lt;&gt; NVL(T_D2, DATE '0001-01-01')
    UNION ALL
    --==============================================================
    --COL-012. Import branch: Y2DCB (80100 ENTRY_UNIT) vs COLLATERAL.FK_UNITCODE
    SELECT 'COL-012_IMPORT_BRANCH_MISMATCH', S_CC, S_SNO, S_DCB, C_UNIT, 'MISMATCH (EXPECTED ' || S_DCB || ')'
    FROM B
    WHERE NVL(S_DCB, '-') &lt;&gt; NVL(C_UNIT, '-')
    UNION ALL
    --==============================================================
    --COL-013. TEXT_1: SUBSTR(TRIM(SSSTDPP SC.YHDS50),1,80) vs COLLATERAL_TABLE.LARGE_DESCR_1
    SELECT 'COL-013_TEXT_1_MISMATCH', S_CC, S_SNO, X_TEXT1, SUBSTR(T_TX1, 1, 100),
           CASE WHEN T_TX1 IS NULL THEN 'EMPTY_IN_PROFITS' ELSE 'MISMATCH' END
    FROM B
    WHERE NVL(X_TEXT1, '-') &lt;&gt; NVL(T_TX1, '-')
    UNION ALL
    --==============================================================
    --COL-014. Πλήθος ανά stream: P1 (κανόνας 80100) vs P3 (stream της φορτωμένης γραμμής MG)
    SELECT 'COL-014_COUNT_PER_STREAM', CAST(NULL AS VARCHAR2(40)), GS_ST, TO_CHAR(GS_HN), TO_CHAR(GS_PN),
           'DIFF ' || TO_CHAR(GS_PN - GS_HN)
    FROM G_STREAM
    WHERE GS_HN &lt;&gt; GS_PN
    UNION ALL
    --==============================================================
    --COL-015. Σύνολο τιμής ανά stream: Σ COL-005 HUB vs Σ COL_EST_VALUE_AMN PROFITS
    SELECT 'COL-015_VALUE_TOTAL_PER_STREAM', CAST(NULL AS VARCHAR2(40)), GS_ST,
           TO_CHAR(GS_HV, 'FM999999999999990.00'), TO_CHAR(GS_PV, 'FM999999999999990.00'),
           'DIFF ' || TO_CHAR(GS_PV - GS_HV, 'FM999999999999990.00')
    FROM G_STREAM
    WHERE ABS(GS_HV - GS_PV) &gt; 0.005
    UNION ALL
    --==============================================================
    --COL-016. Πλήθος και σύνολο τιμής ανά νόμισμα (CNH ως CNY)
    SELECT 'COL-016_COUNT_VALUE_PER_CURRENCY', CAST(NULL AS VARCHAR2(40)), GC_CY,
           'N=' || GC_HN || '; SUM=' || TO_CHAR(GC_HV, 'FM999999999999990.00'),
           'N=' || GC_PN || '; SUM=' || TO_CHAR(GC_PV, 'FM999999999999990.00'),
           CASE WHEN GC_HN &lt;&gt; GC_PN THEN 'COUNT_DIFF ' || TO_CHAR(GC_PN - GC_HN)
                ELSE 'VALUE_DIFF ' || TO_CHAR(GC_PV - GC_HV, 'FM999999999999990.00') END
    FROM G_CCY
    WHERE GC_HN &lt;&gt; GC_PN OR ABS(GC_HV - GC_PV) &gt; 0.005
    UNION ALL
    --==============================================================
    --COL-017. Distinct agreements που καλύπτονται: P2 vs ACCOUNT_COLLATERAL των P3
    SELECT 'COL-017_DISTINCT_COVERED_AGREEMENTS', CAST(NULL AS VARCHAR2(40)), 'ALL', TO_CHAR(GA_HN), TO_CHAR(GA_PN),
           'DIFF ' || TO_CHAR(GA_PN - GA_HN)
    FROM G_AGR
    WHERE GA_HN &lt;&gt; GA_PN
    UNION ALL
    --==============================================================
    --COL-024. Allocated value ανά link: MG_COLL_ACCOUNT.COL_EST_VALUE_AMN = Y2SCVR ΧΩΡΙΣ /DIV (80100 γρ. 272) vs ACCOUNT_COLLATERAL.EST_VALUE_AMN
    SELECT 'COL-024_ALLOCATED_VALUE_MISMATCH', b.S_CC, j.LJ_SNO || ' / ' || j.LJ_AGR,
           TO_CHAR(b.S_VAL, 'FM999999999999990.00'), TO_CHAR(j.BL_VAL, 'FM999999999999990.00'),
           CASE WHEN ABS(NVL(j.BL_VAL, 0) - NVL(b.S_VAL, 0) / b.X_DIV) &lt;= 0.005 AND b.X_DIV &lt;&gt; 1
                THEN 'SCALED_BY_DIV (SCRIPT SENDS ' || TO_CHAR(b.S_VAL, 'FM999999999999990.00') || ')'
                ELSE 'MISMATCH (EXPECTED ' || TO_CHAR(b.S_VAL, 'FM999999999999990.00') || ')' END
    FROM LJ j
    JOIN (SELECT DISTINCT S_SNO, S_CC, S_VAL, X_DIV FROM B) b ON b.S_SNO = j.LJ_SNO
    WHERE j.EL_AGR IS NOT NULL AND j.BL_AGR IS NOT NULL
      AND ABS(NVL(j.BL_VAL, 0) - NVL(b.S_VAL, 0)) &gt; 0.005
    UNION ALL
    --==============================================================
    --COL-025. Cash collaterals: ACCOUNT2 (CASH_COLLATERAL_ACCOUNT, κενό -&gt; 'TEST'), ACCOUNT2_SYSTEM (3 μόνο όταν κενό),
    --         COOP_BANK_CODE (0 όταν ο λογαριασμός δεν είναι στο MG_DPAC_LOAD) vs PROFITS_ACCOUNT_2 / PRFT_SYSTEM_2 / COLLABORATION_BANK
    SELECT 'COL-025_CASH_ACCOUNT_MISMATCH', S_CC, S_SNO,
           'ACC2=' || X_ACC2 || '; SYS2=' || NVL(X_SYS2, '-') || '; BANK=' || NVL(X_COOP, '-'),
           'ACC2=' || NVL(T_ACC2, '-') || '; SYS2=' || NVL(T_SYS2, '-') || '; BANK=' || NVL(T_BANK, '-'),
           CASE WHEN NVL(X_ACC2, '-') &lt;&gt; NVL(T_ACC2, '-') THEN 'ACCOUNT2 (EXPECTED ' || X_ACC2 || ')'
                WHEN NVL(X_SYS2, '-') &lt;&gt; NVL(T_SYS2, '-') AND NOT (X_SYS2 IS NULL AND T_SYS2 = '0')
                     THEN 'ACCOUNT2_SYSTEM (EXPECTED ' || NVL(X_SYS2, 'EMPTY') || ')'
                ELSE 'COOP_BANK_CODE (EXPECTED ' || NVL(X_COOP, '-') || ')' END
    FROM B
    WHERE X_STREAM = 'CASH_COLLATERALS'
      AND (NVL(X_ACC2, '-') &lt;&gt; NVL(T_ACC2, '-')
           OR (NVL(X_SYS2, '-') &lt;&gt; NVL(T_SYS2, '-') AND NOT (X_SYS2 IS NULL AND T_SYS2 = '0'))
           OR NVL(X_COOP, '-') &lt;&gt; NVL(T_BANK, '-'))
    UNION ALL
    --==============================================================
    --COL-026. COLLATERAL_DESC (90000 CHS-347): περιγραφή της ίδιας της εξασφάλισης (SSSECHP.COLLATERAL_DESC, 10090)
    --         vs COLLATERAL.COLLATERAL_DESC. ISSUE: αν ταιριάζει με την περιγραφή του serial = REAL_ESTATE_ID (join του 90000)
    SELECT 'COL-026_COLLATERAL_DESC_MISMATCH', b.S_CC, b.S_SNO, SUBSTR(b.S_DESC, 1, 100), SUBSTR(b.C_DESC, 1, 100),
           CASE WHEN b.C_DESC IS NULL THEN 'EMPTY_IN_PROFITS'
                WHEN o.S_DESC IS NOT NULL AND o.S_DESC = b.C_DESC THEN 'DESC_OF_SERIAL ' || o.S_SNO || ' (90000 JOIN ON RE_ID)'
                ELSE 'MISMATCH' END
    FROM B b
    LEFT JOIN R_SEC o ON o.S_SNO = b.M_RE
    WHERE NVL(b.S_DESC, '-') &lt;&gt; NVL(b.C_DESC, '-')
    UNION ALL
    --==============================================================
    --COL-027. Real estate: MG_REAL_ESTATE.PRFT_ID (CollateralsRealEstate, SERIAL_NO = SERIAL_NUMBER) vs COLLATERAL_TABLE.REAL_ESTATE_ID
    SELECT 'COL-027_REAL_ESTATE_LINK_MISMATCH', S_CC, S_SNO, TO_CHAR(X_RE), TO_CHAR(T_RE),
           CASE WHEN NVL(T_RE, 0) = 0 THEN 'EMPTY_IN_PROFITS (EXPECTED ' || TO_CHAR(X_RE) || ')'
                WHEN X_RE IS NULL THEN 'NOT_EXPECTED (NO MG_REAL_ESTATE ROW)'
                ELSE 'MISMATCH (EXPECTED ' || TO_CHAR(X_RE) || ')' END
    FROM B
    WHERE NVL(X_RE, 0) &lt;&gt; NVL(T_RE, 0)
)
SELECT
    CAST(CHECK_ID || '_' || TO_CHAR(ROW_NUMBER() OVER (PARTITION BY CHECK_ID ORDER BY CUSTOMER_CODE, SERIAL_NO), 'FM0000000') AS VARCHAR2(20)) AS DETAIL_ID,
    CAST(CHECK_ID AS VARCHAR2(10)) AS CHECK_ID,
    CAST(CHECK_NAME AS VARCHAR2(50)) AS CHECK_NAME,
    CAST(SUBSTR(CUSTOMER_CODE, 1, 30) AS VARCHAR2(30)) AS CUSTOMER_CODE,
    CAST(SUBSTR(SERIAL_NO, 1, 60) AS VARCHAR2(60)) AS SERIAL_NO,
    CAST(SUBSTR(HUB_VALUE, 1, 100) AS VARCHAR2(100)) AS HUB_VALUE,
    CAST(SUBSTR(NCIS_VALUE, 1, 100) AS VARCHAR2(100)) AS NCIS_VALUE,
    CAST(SUBSTR(ISSUE, 1, 50) AS VARCHAR2(50)) AS ISSUE,
    'DC5' AS DC_VERSION,
    1 AS RUN_VERSION,  -- TESTING ONLY: στο SSIS αντικαθίσταται από @[User::RunVersion] μέσω Derived Column.
    SYSDATE AS RUN_TIMESTAMP
FROM (
    SELECT
        F.*,
        CAST(SUBSTR(CHECK_NAME, 1, INSTR(CHECK_NAME, '_') - 1) AS VARCHAR2(10)) AS CHECK_ID
    FROM FINDINGS F
)
ORDER BY REGEXP_SUBSTR(CHECK_ID, '[A-Z]+'), TO_NUMBER(REGEXP_SUBSTR(CHECK_ID, '[0-9]+')), CUSTOMER_CODE, SERIAL_NO;</property>
