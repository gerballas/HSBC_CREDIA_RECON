                <component
                  refId="Package\Sequence Container\SEPA_Master\SEPA_master"
                  componentClassID="Microsoft.SSISOracleSrc"
                  contactInfo="Oracle Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;1"
                  description="Oracle Source"
                  name="SEPA_master"
                  usesDispositions="true"
                  version="1">
                  <properties>
                    <property
                      dataType="System.String"
                      description="The name of the table to be fetched."
                      expressionType="Notify"
                      name="TableName"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      expressionType="Notify"
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">-- ====================================================================
-- SEPA_RECON — MASTER DC5 v1
-- Τροφοδοτεί: RECON.SEPA_RECON_MASTER
-- Μία γραμμή ΑΝΑ CHECK_ID — 21 γραμμές ανά run: SEPA-001 .. SEPA-021 (SEPA-017, 020, 021 = INFO).
--
-- v1 update 2026-11-18 (μετά το run 1, απόφαση χρήστη). Backup: Scripts\Archived\SEPA_before_detail_excel_20261118\
--   - Detail ΧΩΡΙΣ SEPA-018 / 019 (όλες οι γραμμές FAIL, 1.053.680 γραμμές δεν χωρούν στο Excel). Το Master
--     δεν αλλάζει: INVALID_COUNT = γραμμές Detail ισχύει για όλα τα checks ΕΚΤΟΣ από SEPA-018 / 019.
--   - SEPA-015 / 017: μένει το κλειδί mandate του DC4 (K1 = SDMREF + CREDITOR_ACCOUNT + DEBITOR_ACCOUNT).
--     Run χρήστη: K1 137.991 / K2 (SDMREF + SDCRAC + SDDRAC) 138.113 mandates, 121 κλειδιά K1 με &gt; 1 IBAN creditor.
--
-- SEPA Direct Debits (ME01_HUB, EIM 240825): HUB_MT_EUDTSDDP (synonym @Malta, όπως το αφήνει το 10090
-- L643-655) vs PROFITS SDD_MANDATES (απευθείας: δεν υπάρχει NCIS extract για SDD, όπως στο DC4) και
-- PROFITS_ACCOUNT (CUST_ID).
-- Migration scripts: Recon Material Final\Scripts\Migration Scripts\20261116_MigrationScripts (72000, 10090).
-- Διαφορές 20261109 -&gt; 20261116: SDD Mandates\DC5_Report1_SEPA_MigrationScripts_Differences_20261109_vs_20261116.md.
-- Πλάνο (εγκρίθηκε 2026-11-18): SDD Mandates\DC5_Step4_SEPA_Check_Plan.md.
-- Παράγεται από τον generator (_generator\build.ps1): sepa_master_head + sepa_common + sepa_master_tail.
-- Το κοινό κομμάτι (CTEs) και το FINDINGS είναι ΙΔΙΑ αυτούσια στο DetailSEPA_DC5_v1.sql
--   -&gt; INVALID_COUNT = γραμμές του Detail ανά CHECK_ID.
--
-- ΦΙΛΤΡΟ PROFITS: SDD_MANDATES.ENTRY_TYPE = 'PAPER' (72000 L12, από την έκδοση 20261109· στο DC4 'MIGR').
--   Run χρήστη 2026-11-18: μόνο τιμή PAPER, 346.393 γραμμές, όλες με τις σταθερές του 72000,
--   MANDATE_SN 1..346.393, DATE_OF_SIGNATURE 2026-07-29 .. 2026-09-30.
-- ΚΛΕΙΔΙ: SDD_MANDATES.MANDATE_SN = HUB_MT_EUDTSDDP.SERIAL_NO (10090 L655, ROWNUM).
--   Run χρήστη 2026-11-18: 346.393 / 346.393 ίδια SDMREF + SDDRAC + SDTRDT, 0 μόνο στη μία πλευρά.
--
-- ΑΡΧΗ: αναμενόμενη τιμή ΜΟΝΟ από το 72000 / 10090:
--   - MANDATE_ID = SDMREF, DEBTOR_IBAN_ACCOUNT = ACCOUNT_NUMBER = SDDRAC, DATE_OF_SIGNATURE = LAST_TRX_DATE =
--     SDTRDT, DEBTOR_NAME = SUBSTR(TRIM(SDDRNM),1,70), DEBTOR_ADDRESS_1/2 = SDDAD1/2, DEBTOR_COUNTRY = SDDCTC,
--     DEBTOR_BIC = SDDBIC.
--   - CUST_ID = PROFITS_ACCOUNT.CUST_ID όπου TRIM(ACCOUNT_NUMBER) = TRIM(DEBITOR_ACCOUNT), LEFT JOIN.
--   - Σταθερές (SEPA-020, INFO): PRODUCT_TYPE 'CORE', SEQUENCE_TYPE 'RCUR', FLOW_TYPE 'CMF', STATUS '1',
--     MAX_AMOUNT 0, RECALL_DATE / INACT_* / DEBTOR_ID_* NULL, DEBTOR_BRANCH_ID / ULT_DEBTOR_* /
--     CANCEL_NEXT_PAYMENT_FLG / MANDATE_CONFIRMED ' ', SUSPENSION_* 0001-01-01.
--   - CREDITOR_CODE (L5) / CREDITOR_NAME (L37): σε σχόλιο στο 72000 -&gt; checks κενού (SEPA-018 / 019), όπως DC4.
-- ΠΑΡΑΔΟΧΕΣ DC4 (μένουν): σύγκριση κειμένων με TRIM και στις δύο πλευρές, κενό = κενό (NVL '#').
--   SEPA-015: κλειδί mandate = SDMREF + CREDITOR_ACCOUNT + DEBITOR_ACCOUNT. SEPA-018: ένας CREDITOR_CODE
--   ανά HUB CREDITOR_ACCOUNT (οι εξωτερικοί creditors είναι όλοι '000000000000'). Κατεύθυνση (SEPA-016 /
--   021): debtor HSBC = SDDACS &lt;&gt; 0, creditor HSBC = CREDITOR_ACCOUNT &lt;&gt; '000000000000'.
-- Detail: CUSTOMER_CODE = CUST_ID του SDD_MANDATES, SERIAL_NO = MANDATE_SN (= HUB SERIAL_NO).
--   HUB_VALUE = τιμή HUB, NCIS_VALUE = τιμή SDD_MANDATES, αναμενόμενη τιμή στο ISSUE.
--
-- ΑΝΤΙΣΤΟΙΧΙΑ DC4 (SDD_Mandates_recon.sql, SDD-001..022) -&gt; DC5:
--   SDD-001 -&gt; SEPA-002 (ISSUE DUPLICATE_SERIAL_NO) | SDD-002 -&gt; SEPA-001 | SDD-003 -&gt; SEPA-002
--   SDD-004 -&gt; SEPA-003 | SDD-005..015 -&gt; SEPA-004..014 | SDD-016 -&gt; SEPA-015 | SDD-017 -&gt; SEPA-016
--   SDD-018 -&gt; SEPA-017 (INFO) | SDD-019 -&gt; SEPA-018 | SDD-020 -&gt; SEPA-019 | SDD-021 + SDD-022 -&gt; SEPA-021 (INFO)
--   Νέο: SEPA-020 (σταθερές του 72000, INFO).
--
-- STATUS: PASS (INVALID_COUNT = 0) / FAIL / INFO. INFO: μόνο Master, χωρίς Detail.
--
-- TOTAL_RECORDS ανά POPULATION_TYPE:
--   COUNT     = 1 (ο έλεγχος πλήθους είναι ένας)
--   HUB_SDD   = γραμμές HUB_MT_EUDTSDDP
--   PRF_SDD   = γραμμές SDD_MANDATES PAPER
--   MATCHED   = γραμμές και στα δύο (MANDATE_SN = SERIAL_NO)
--   MANDATES  = διακριτά κλειδιά mandate (SDMREF + CREDITOR_ACCOUNT + DEBITOR_ACCOUNT) στις MATCHED
-- ====================================================================
WITH
-- --------------------------------------------------------------------
-- Κοινό κομμάτι (ΙΔΙΟ αυτούσιο στο Master και στο Detail).
--   R_SDD = HUB_MT_EUDTSDDP (synonym @Malta), όπως το αφήνει το 10090 (SERIAL_NO, DEBITOR_ACCOUNT,
--           CREDITOR_ACCOUNT). ΜΙΑ φορά, μόνο οι στήλες που χρειάζονται. Ημερομηνία SDTRDT: κείμενο
--           YYYYMMDD -&gt; DATE ('99999999' / λάθος -&gt; NULL). H_SN_RN / H_SN_ROWS: μοναδικότητα του κλειδιού.
--           H_DIRECTION: ποια πλευρά έχει λογαριασμό HSBC (όπως DC4 SDD-022).
--   R_PA  = PROFITS_ACCOUNT ανά TRIM(ACCOUNT_NUMBER) (μόνο οι λογαριασμοί debtor / creditor του R_SDD):
--           MIN / MAX CUST_ID και πλήθος γραμμών, ώστε διπλός αριθμός λογαριασμού να μη πολλαπλασιάζει γραμμές.
--   R_SM  = SDD_MANDATES με ENTRY_TYPE = 'PAPER' (72000 L12· στο DC4 ήταν 'MIGR'). P_CONST_DIFF = λίστα
--           των πεδίων με σταθερή τιμή στο 72000 που ΔΕΝ έχουν αυτή την τιμή (SEPA-020).
--   B     = γραμμές και στα δύο (MANDATE_SN = SERIAL_NO, 1:1 επιβεβαιωμένο 2026-11-18) + αναμενόμενη
--           τιμή CUST_ID (R_PA του debtor) + κλειδί mandate (K_*) + μέτρηση CREDITOR_CODE (CR_*).
-- --------------------------------------------------------------------
R_SDD AS (
    SELECT /*+ MATERIALIZE */
           SERIAL_NO                                             AS H_SN,
           TRIM(SDMREF)                                          AS H_REF,
           TRIM(SDDRAC)                                          AS H_IBAN,
           TRIM(DEBITOR_ACCOUNT)                                 AS H_DACC,
           NVL(TRIM(CREDITOR_ACCOUNT), '000000000000')           AS H_CACC,
           TRIM(TO_CHAR(SDTRDT))                                 AS H_TRDT_TXT,
           TO_DATE(SUBSTR(REGEXP_REPLACE(TO_CHAR(SDTRDT), '[^0-9]', ''), 1, 8) DEFAULT NULL ON CONVERSION ERROR, 'YYYYMMDD') AS H_TRDT,
           SUBSTR(TRIM(SDDRNM), 1, 70)                           AS H_DNAME,
           TRIM(SDDAD1)                                          AS H_DAD1,
           TRIM(SDDAD2)                                          AS H_DAD2,
           TRIM(SDDCTC)                                          AS H_DCTC,
           TRIM(SDDBIC)                                          AS H_DBIC,
           TRIM(SDCRNM)                                          AS H_CRNAME,
           CASE WHEN NVL(SDDACS, 0) = 0 AND NVL(TRIM(CREDITOR_ACCOUNT), '000000000000') &lt;&gt; '000000000000' THEN 'OUTGOING'
                WHEN NVL(SDDACS, 0) = 0                                                                   THEN 'NEITHER'
                WHEN NVL(TRIM(CREDITOR_ACCOUNT), '000000000000') = '000000000000'                         THEN 'INCOMING'
                ELSE 'ON_US' END                                 AS H_DIRECTION,
           COUNT(*) OVER (PARTITION BY SERIAL_NO)                AS H_SN_ROWS,
           ROW_NUMBER() OVER (PARTITION BY SERIAL_NO ORDER BY TRIM(SDTRNO)) AS H_SN_RN
      FROM HUB_MT_EUDTSDDP
),
R_PA AS (
    SELECT /*+ MATERIALIZE */
           TRIM(ACCOUNT_NUMBER) AS PA_ACC,
           MIN(CUST_ID)         AS PA_CUST_MIN,
           MAX(CUST_ID)         AS PA_CUST_MAX,
           COUNT(*)             AS PA_ROWS
      FROM PROFITS_ACCOUNT
     WHERE TRIM(ACCOUNT_NUMBER) IN (SELECT H_DACC FROM R_SDD UNION SELECT H_CACC FROM R_SDD)
     GROUP BY TRIM(ACCOUNT_NUMBER)
),
R_SM AS (
    SELECT /*+ MATERIALIZE */
           MANDATE_SN                                   AS P_SN,
           TRIM(MANDATE_ID)                             AS P_REF,
           TRIM(DEBTOR_IBAN_ACCOUNT)                    AS P_IBAN,
           TRIM(ACCOUNT_NUMBER)                         AS P_ACCNO,
           CUST_ID                                      AS P_CUST,
           TRUNC(DATE_OF_SIGNATURE)                     AS P_DOS,
           TRUNC(LAST_TRX_DATE)                         AS P_LTD,
           TRIM(DEBTOR_NAME)                            AS P_DNAME,
           TRIM(DEBTOR_ADDRESS_1)                       AS P_DAD1,
           TRIM(DEBTOR_ADDRESS_2)                       AS P_DAD2,
           TRIM(DEBTOR_COUNTRY)                         AS P_DCTC,
           TRIM(DEBTOR_BIC)                             AS P_DBIC,
           TRIM(TO_CHAR(CREDITOR_CODE))                 AS P_CRCODE,
           TRIM(CREDITOR_NAME)                          AS P_CRNAME,
           -- 72000 L9-L38: σταθερές τιμές. NULL και ' ' θεωρούνται ίδια (κενό).
           RTRIM(
               CASE WHEN NVL(TRIM(PRODUCT_TYPE), '#')  &lt;&gt; 'CORE' THEN 'PRODUCT_TYPE,' END ||
               CASE WHEN NVL(TRIM(SEQUENCE_TYPE), '#') &lt;&gt; 'RCUR' THEN 'SEQUENCE_TYPE,' END ||
               CASE WHEN NVL(TRIM(FLOW_TYPE), '#')     &lt;&gt; 'CMF'  THEN 'FLOW_TYPE,' END ||
               CASE WHEN NVL(TRIM(TO_CHAR(STATUS)), '#') &lt;&gt; '1'  THEN 'STATUS,' END ||
               CASE WHEN TRIM(TO_CHAR(INACT_REASON_FLG)) IS NOT NULL OR TRIM(TO_CHAR(INACT_REASON_CODE)) IS NOT NULL THEN 'INACT_REASON_*,' END ||
               CASE WHEN RECALL_DATE IS NOT NULL THEN 'RECALL_DATE,' END ||
               CASE WHEN NVL(MAX_AMOUNT, -1) &lt;&gt; 0 THEN 'MAX_AMOUNT,' END ||
               CASE WHEN TRIM(TO_CHAR(DEBTOR_ID_TYPE)) IS NOT NULL OR TRIM(DEBTOR_ID_NUMBER) IS NOT NULL THEN 'DEBTOR_ID_*,' END ||
               CASE WHEN TRIM(DEBTOR_BRANCH_ID) IS NOT NULL THEN 'DEBTOR_BRANCH_ID,' END ||
               CASE WHEN TRIM(ULT_DEBTOR_NAME) IS NOT NULL OR TRIM(ULT_DEBTOR_ADDRESS_1) IS NOT NULL
                      OR TRIM(ULT_DEBTOR_ADDRESS_2) IS NOT NULL OR TRIM(ULT_DEBTOR_COUNTRY) IS NOT NULL
                      OR TRIM(TO_CHAR(ULT_DEBTOR_ID_TYPE)) IS NOT NULL OR TRIM(ULT_DEBTOR_ID_NUMBER) IS NOT NULL THEN 'ULT_DEBTOR_*,' END ||
               CASE WHEN NVL(TRUNC(SUSPENSION_START_DATE), DATE '1900-01-01') &lt;&gt; DATE '0001-01-01'
                      OR NVL(TRUNC(SUSPENSION_END_DATE), DATE '1900-01-01')   &lt;&gt; DATE '0001-01-01' THEN 'SUSPENSION_*,' END ||
               CASE WHEN TRIM(CANCEL_NEXT_PAYMENT_FLG) IS NOT NULL THEN 'CANCEL_NEXT_PAYMENT_FLG,' END ||
               CASE WHEN TRIM(MANDATE_CONFIRMED) IS NOT NULL THEN 'MANDATE_CONFIRMED,' END
           , ',')                                       AS P_CONST_DIFF,
           COUNT(*) OVER (PARTITION BY MANDATE_SN)      AS P_SN_ROWS,
           ROW_NUMBER() OVER (PARTITION BY MANDATE_SN ORDER BY TRIM(MANDATE_ID)) AS P_SN_RN
      FROM SDD_MANDATES
     WHERE ENTRY_TYPE = 'PAPER'
),
B AS (
    SELECT /*+ MATERIALIZE */
           h.*, p.*,
           pd.PA_ACC      AS PD_ACC,
           pd.PA_CUST_MIN AS PD_CUST_MIN,
           pd.PA_CUST_MAX AS PD_CUST_MAX,
           pd.PA_ROWS     AS PD_ROWS,
           h.H_REF || '|' || h.H_CACC || '|' || h.H_DACC AS K_MANDATE,
           COUNT(*) OVER (PARTITION BY h.H_REF, h.H_CACC, h.H_DACC) AS K_ROWS,
           ROW_NUMBER() OVER (PARTITION BY h.H_REF, h.H_CACC, h.H_DACC ORDER BY h.H_TRDT DESC, h.H_SN DESC) AS K_RANK,
           FIRST_VALUE(h.H_SN) OVER (PARTITION BY h.H_REF, h.H_CACC, h.H_DACC ORDER BY h.H_TRDT DESC, h.H_SN DESC) AS K_LATEST_SN,
           COUNT(DISTINCT p.P_CRCODE) OVER (PARTITION BY h.H_CACC)   AS CR_CODES_PER_CRED,
           COUNT(DISTINCT h.H_CACC)   OVER (PARTITION BY p.P_CRCODE) AS CR_CREDS_PER_CODE
      FROM R_SDD h
      JOIN R_SM p ON p.P_SN = h.H_SN AND p.P_SN_RN = 1
      LEFT JOIN R_PA pd ON pd.PA_ACC = h.H_DACC
     WHERE h.H_SN_RN = 1
),
FINDINGS AS (
    -- Μία γραμμή ανά εύρημα. CUSTOMER_CODE = CUST_ID του PROFITS (SDD_MANDATES), SERIAL_NO = MANDATE_SN
    -- (= HUB SERIAL_NO). HUB_VALUE = τιμή HUB που συγκρίνεται, NCIS_VALUE = τιμή SDD_MANDATES.
    -- Αναμενόμενη τιμή (72000 / 10090) στο ISSUE. Τα INFO (SEPA-017, 020, 021) μόνο στο Master.
    --==============================================================
    --SEPA-001. Πλήθος γραμμών HUB_MT_EUDTSDDP vs SDD_MANDATES PAPER (DC4 SDD-002). Μία γραμμή αν διαφέρουν.
    SELECT
      CAST('SEPA-001_ROW_COUNT_DIFFERENCE' AS VARCHAR2(50)) AS CHECK_NAME,
      CAST(NULL AS VARCHAR2(40)) AS CUSTOMER_CODE, CAST(NULL AS VARCHAR2(40)) AS SERIAL_NO,
      CAST(TO_CHAR(c.HC) AS VARCHAR2(200)) AS HUB_VALUE,
      CAST(TO_CHAR(c.PC) AS VARCHAR2(200)) AS NCIS_VALUE,
      CAST(SUBSTR('COUNT_DIFFERENCE (PROFITS - HUB = ' || TO_CHAR(c.PC - c.HC) || ')', 1, 50) AS VARCHAR2(50)) AS ISSUE
    FROM (SELECT (SELECT COUNT(*) FROM R_SDD) AS HC, (SELECT COUNT(*) FROM R_SM) AS PC FROM DUAL) c
    WHERE c.HC &lt;&gt; c.PC
    UNION ALL
    --==============================================================
    --SEPA-002. Γραμμή HUB (SERIAL_NO) που δεν φορτώθηκε (DC4 SDD-003), ή διπλό SERIAL_NO (DC4 SDD-001)
    SELECT 'SEPA-002_HUB_ROW_NOT_IN_PROFITS', CAST(NULL AS VARCHAR2(40)), TO_CHAR(h.H_SN),
           'SDMREF=' || h.H_REF || '; SDTRDT=' || h.H_TRDT_TXT, CAST(NULL AS VARCHAR2(200)),
           CASE WHEN h.H_SN_RN &gt; 1   THEN SUBSTR('DUPLICATE_SERIAL_NO (' || h.H_SN_ROWS || ' ROWS)', 1, 50)
                WHEN h.H_SN IS NULL THEN 'HUB_SERIAL_NO_EMPTY'
                ELSE 'NOT_IN_SDD_MANDATES_PAPER' END
    FROM R_SDD h
    LEFT JOIN R_SM p ON p.P_SN = h.H_SN AND p.P_SN_RN = 1
    WHERE p.P_SN IS NULL OR h.H_SN_RN &gt; 1
    UNION ALL
    --==============================================================
    --SEPA-003. Γραμμή SDD_MANDATES PAPER χωρίς γραμμή HUB (DC4 SDD-004), ή διπλό MANDATE_SN
    SELECT 'SEPA-003_PROFITS_ROW_NOT_IN_HUB', TO_CHAR(p.P_CUST), TO_CHAR(p.P_SN), CAST(NULL AS VARCHAR2(200)),
           'MANDATE_ID=' || p.P_REF || '; DATE_OF_SIGNATURE=' || TO_CHAR(p.P_DOS, 'YYYYMMDD'),
           CASE WHEN p.P_SN_RN &gt; 1 THEN SUBSTR('DUPLICATE_MANDATE_SN (' || p.P_SN_ROWS || ' ROWS)', 1, 50)
                ELSE 'NO_HUB_ROW_WITH_THIS_SERIAL_NO' END
    FROM R_SM p
    LEFT JOIN R_SDD h ON h.H_SN = p.P_SN AND h.H_SN_RN = 1
    WHERE h.H_SN IS NULL OR p.P_SN_RN &gt; 1
    UNION ALL
    --==============================================================
    --SEPA-004. MANDATE_ID vs SDMREF (72000 L4)
    SELECT 'SEPA-004_MANDATE_ID_MISMATCH', TO_CHAR(P_CUST), TO_CHAR(P_SN), H_REF, P_REF,
           SUBSTR('MISMATCH (EXPECTED ' || NVL(H_REF, 'EMPTY') || ')', 1, 50)
    FROM B
    WHERE NVL(P_REF, '#') &lt;&gt; NVL(H_REF, '#')
    UNION ALL
    --==============================================================
    --SEPA-005. DEBTOR_IBAN_ACCOUNT vs SDDRAC (72000 L6)
    SELECT 'SEPA-005_DEBTOR_IBAN_MISMATCH', TO_CHAR(P_CUST), TO_CHAR(P_SN), H_IBAN, P_IBAN,
           SUBSTR('MISMATCH (EXPECTED ' || NVL(H_IBAN, 'EMPTY') || ')', 1, 50)
    FROM B
    WHERE NVL(P_IBAN, '#') &lt;&gt; NVL(H_IBAN, '#')
    UNION ALL
    --==============================================================
    --SEPA-006. ACCOUNT_NUMBER vs SDDRAC (72000 L7: το IBAN του debtor, όχι λογαριασμός PROFITS - σημείωση DC4)
    SELECT 'SEPA-006_ACCOUNT_NUMBER_MISMATCH', TO_CHAR(P_CUST), TO_CHAR(P_SN), H_IBAN, P_ACCNO,
           SUBSTR('MISMATCH (EXPECTED ' || NVL(H_IBAN, 'EMPTY') || ')', 1, 50)
    FROM B
    WHERE NVL(P_ACCNO, '#') &lt;&gt; NVL(H_IBAN, '#')
    UNION ALL
    --==============================================================
    --SEPA-007. CUST_ID vs PROFITS_ACCOUNT.CUST_ID του DEBITOR_ACCOUNT (72000 L8 / L41, LEFT JOIN).
    --          Και τα δύο κενά = ίδια (τα κενά μετρά το SEPA-016). Διπλός λογαριασμός: δεκτό MIN ή MAX.
    SELECT 'SEPA-007_CUST_ID_MISMATCH', TO_CHAR(P_CUST), TO_CHAR(P_SN),
           'DEBITOR_ACCOUNT=' || H_DACC || '; CUST_ID=' || NVL(TO_CHAR(PD_CUST_MIN), 'EMPTY'),
           TO_CHAR(P_CUST),
           CASE WHEN NVL(PD_ROWS, 0) &gt; 1 THEN SUBSTR('DUPLICATE_ACCOUNT_IN_PROFITS_ACCOUNT (' || PD_ROWS || ')', 1, 50)
                WHEN P_CUST IS NULL      THEN SUBSTR('PROFITS_EMPTY (EXPECTED ' || TO_CHAR(PD_CUST_MIN) || ')', 1, 50)
                ELSE SUBSTR('MISMATCH (EXPECTED ' || NVL(TO_CHAR(PD_CUST_MIN), 'EMPTY') || ')', 1, 50) END
    FROM B
    WHERE NVL(P_CUST, -1) &lt;&gt; NVL(PD_CUST_MIN, -1)
      AND NVL(P_CUST, -1) &lt;&gt; NVL(PD_CUST_MAX, -1)
    UNION ALL
    --==============================================================
    --SEPA-008. DATE_OF_SIGNATURE vs SDTRDT (72000 L16: ημερομηνία συναλλαγής - σημείωση DC4)
    SELECT 'SEPA-008_DATE_OF_SIGNATURE_MISMATCH', TO_CHAR(P_CUST), TO_CHAR(P_SN), H_TRDT_TXT, TO_CHAR(P_DOS, 'YYYYMMDD'),
           SUBSTR('MISMATCH (EXPECTED ' || NVL(TO_CHAR(H_TRDT, 'YYYYMMDD'), 'EMPTY') || ')', 1, 50)
    FROM B
    WHERE NVL(P_DOS, DATE '0001-01-01') &lt;&gt; NVL(H_TRDT, DATE '0001-01-01')
    UNION ALL
    --==============================================================
    --SEPA-009. LAST_TRX_DATE vs SDTRDT (72000 L17)
    SELECT 'SEPA-009_LAST_TRX_DATE_MISMATCH', TO_CHAR(P_CUST), TO_CHAR(P_SN), H_TRDT_TXT, TO_CHAR(P_LTD, 'YYYYMMDD'),
           SUBSTR('MISMATCH (EXPECTED ' || NVL(TO_CHAR(H_TRDT, 'YYYYMMDD'), 'EMPTY') || ')', 1, 50)
    FROM B
    WHERE NVL(P_LTD, DATE '0001-01-01') &lt;&gt; NVL(H_TRDT, DATE '0001-01-01')
    UNION ALL
    --==============================================================
    --SEPA-010. DEBTOR_NAME vs SUBSTR(TRIM(SDDRNM), 1, 70) (72000 L20)
    SELECT 'SEPA-010_DEBTOR_NAME_MISMATCH', TO_CHAR(P_CUST), TO_CHAR(P_SN), H_DNAME, P_DNAME,
           CASE WHEN P_DNAME IS NULL THEN 'PROFITS_EMPTY' WHEN H_DNAME IS NULL THEN 'HUB_EMPTY' ELSE 'MISMATCH' END
    FROM B
    WHERE NVL(P_DNAME, '#') &lt;&gt; NVL(TRIM(H_DNAME), '#')
    UNION ALL
    --==============================================================
    --SEPA-011. DEBTOR_ADDRESS_1 vs SDDAD1 (72000 L21)
    SELECT 'SEPA-011_DEBTOR_ADDRESS_1_MISMATCH', TO_CHAR(P_CUST), TO_CHAR(P_SN), H_DAD1, P_DAD1,
           CASE WHEN P_DAD1 IS NULL THEN 'PROFITS_EMPTY' WHEN H_DAD1 IS NULL THEN 'HUB_EMPTY' ELSE 'MISMATCH' END
    FROM B
    WHERE NVL(P_DAD1, '#') &lt;&gt; NVL(H_DAD1, '#')
    UNION ALL
    --==============================================================
    --SEPA-012. DEBTOR_ADDRESS_2 vs SDDAD2 (72000 L22)
    SELECT 'SEPA-012_DEBTOR_ADDRESS_2_MISMATCH', TO_CHAR(P_CUST), TO_CHAR(P_SN), H_DAD2, P_DAD2,
           CASE WHEN P_DAD2 IS NULL THEN 'PROFITS_EMPTY' WHEN H_DAD2 IS NULL THEN 'HUB_EMPTY' ELSE 'MISMATCH' END
    FROM B
    WHERE NVL(P_DAD2, '#') &lt;&gt; NVL(H_DAD2, '#')
    UNION ALL
    --==============================================================
    --SEPA-013. DEBTOR_COUNTRY vs SDDCTC (72000 L23)
    SELECT 'SEPA-013_DEBTOR_COUNTRY_MISMATCH', TO_CHAR(P_CUST), TO_CHAR(P_SN), H_DCTC, P_DCTC,
           SUBSTR('MISMATCH (EXPECTED ' || NVL(H_DCTC, 'EMPTY') || ')', 1, 50)
    FROM B
    WHERE NVL(P_DCTC, '#') &lt;&gt; NVL(H_DCTC, '#')
    UNION ALL
    --==============================================================
    --SEPA-014. DEBTOR_BIC vs SDDBIC (72000 L26)
    SELECT 'SEPA-014_DEBTOR_BIC_MISMATCH', TO_CHAR(P_CUST), TO_CHAR(P_SN), H_DBIC, P_DBIC,
           SUBSTR('MISMATCH (EXPECTED ' || NVL(H_DBIC, 'EMPTY') || ')', 1, 50)
    FROM B
    WHERE NVL(P_DBIC, '#') &lt;&gt; NVL(H_DBIC, '#')
    UNION ALL
    --==============================================================
    --SEPA-015. Διπλά mandates (DC4 SDD-016): κάθε γραμμή μετά την τελευταία συναλλαγή ανά κλειδί mandate
    --          του HUB (SDMREF + CREDITOR_ACCOUNT + DEBITOR_ACCOUNT). Το 72000 φορτώνει κάθε συναλλαγή.
    SELECT 'SEPA-015_DUPLICATE_MANDATE', TO_CHAR(P_CUST), TO_CHAR(P_SN),
           'SDMREF=' || H_REF || '; SDTRDT=' || H_TRDT_TXT, P_REF,
           SUBSTR('DUPLICATE (' || K_ROWS || ' ROWS, LATEST SN ' || K_LATEST_SN || ')', 1, 50)
    FROM B
    WHERE K_RANK &gt; 1
    UNION ALL
    --==============================================================
    --SEPA-016. CUST_ID κενό (DC4 SDD-017): το 72000 βρίσκει πελάτη μόνο από τον debtor. ISSUE = αιτία από το HUB.
    SELECT 'SEPA-016_MANDATE_WITHOUT_CUSTOMER', CAST(NULL AS VARCHAR2(40)), TO_CHAR(P_SN),
           'DEBITOR_ACCOUNT=' || H_DACC || '; CREDITOR_ACCOUNT=' || H_CACC, CAST(NULL AS VARCHAR2(200)),
           CASE WHEN H_DIRECTION = 'OUTGOING' THEN SUBSTR('OUTGOING_HSBC_CREDITOR (' || H_CACC || ')', 1, 50)
                WHEN H_DIRECTION = 'NEITHER'  THEN 'NO_HSBC_ACCOUNT_EITHER_SIDE'
                WHEN PD_ACC IS NULL           THEN 'DEBTOR_ACC_NOT_IN_PROFITS_ACCOUNT'
                WHEN PD_CUST_MIN IS NULL      THEN 'PROFITS_ACCOUNT_CUST_ID_EMPTY'
                ELSE SUBSTR('DEBTOR_ACC_FOUND_NOW (CUST_ID ' || TO_CHAR(PD_CUST_MIN) || ')', 1, 50) END
    FROM B
    WHERE P_CUST IS NULL
    UNION ALL
    --==============================================================
    --SEPA-018. CREDITOR_CODE (DC4 SDD-019): σε σχόλιο στο 72000 L5 (σημείωση: από SDD_CREDITORS). Πρέπει να
    --          αναγνωρίζει τον creditor: ένας κωδικός ανά HUB CREDITOR_ACCOUNT (παραδοχή DC4). To be confirmed with NC.
    SELECT 'SEPA-018_CREDITOR_CODE_NOT_PER_CREDITOR', TO_CHAR(P_CUST), TO_CHAR(P_SN), H_CACC, P_CRCODE,
           CASE WHEN P_CRCODE IS NULL         THEN 'NOT_LOADED (72000 L5 COMMENTED OUT)'
                WHEN CR_CODES_PER_CRED &gt; 1    THEN SUBSTR('CREDITOR HAS ' || CR_CODES_PER_CRED || ' CODES', 1, 50)
                ELSE SUBSTR('CODE USED BY ' || CR_CREDS_PER_CODE || ' CREDITORS', 1, 50) END
    FROM B
    WHERE P_CRCODE IS NULL OR CR_CODES_PER_CRED &gt; 1 OR CR_CREDS_PER_CODE &gt; 1
    UNION ALL
    --==============================================================
    --SEPA-019. CREDITOR_NAME vs SDCRNM (DC4 SDD-020): σε σχόλιο στο 72000 L37, το HUB έχει το όνομα.
    SELECT 'SEPA-019_CREDITOR_NAME_NOT_LOADED', TO_CHAR(P_CUST), TO_CHAR(P_SN), H_CRNAME, P_CRNAME,
           CASE WHEN P_CRNAME IS NULL THEN 'NOT_LOADED (72000 L37 COMMENTED OUT)'
                WHEN H_CRNAME IS NULL THEN 'HUB_EMPTY'
                ELSE 'MISMATCH' END
    FROM B
    WHERE NVL(P_CRNAME, '#') &lt;&gt; NVL(H_CRNAME, '#')
)
,
POPULATIONS AS (
    SELECT
        1                                                AS ONE_COUNT,
        (SELECT COUNT(*) FROM R_SDD)                     AS HUB_SDD_COUNT,
        (SELECT COUNT(*) FROM R_SM)                      AS PRF_SDD_COUNT,
        (SELECT COUNT(*) FROM B)                         AS MATCHED_COUNT,
        (SELECT COUNT(DISTINCT K_MANDATE) FROM B)        AS MANDATES_COUNT
    FROM DUAL
),
CHECK_META AS (
    -- CHECK_ID | CHECK_NAME | CATEGORY | DESCRIPTION | POPULATION_TYPE
    SELECT 'SEPA-001' AS CHECK_ID, 'SEPA-001_ROW_COUNT_DIFFERENCE' AS CHECK_NAME, 'CONTROL_TOTAL' AS CATEGORY, 'The number of migrated mandates in PROFITS (ENTRY_TYPE PAPER) differs from the number of HUB direct debit rows.' AS DESCRIPTION, 'COUNT' AS POPULATION_TYPE FROM DUAL UNION ALL
    SELECT 'SEPA-002', 'SEPA-002_HUB_ROW_NOT_IN_PROFITS',            'EXISTENCE',             'HUB direct debit rows not loaded in PROFITS, or a HUB serial number used twice (the matching key).', 'HUB_SDD' FROM DUAL UNION ALL
    SELECT 'SEPA-003', 'SEPA-003_PROFITS_ROW_NOT_IN_HUB',            'EXISTENCE',             'Migrated mandates in PROFITS with no HUB row, or a mandate serial number used twice.', 'PRF_SDD' FROM DUAL UNION ALL
    SELECT 'SEPA-004', 'SEPA-004_MANDATE_ID_MISMATCH',               'CROSS_SYSTEM_MISMATCH', 'The mandate reference in PROFITS differs from the HUB mandate reference the migration sent.', 'MATCHED' FROM DUAL UNION ALL
    SELECT 'SEPA-005', 'SEPA-005_DEBTOR_IBAN_MISMATCH',              'CROSS_SYSTEM_MISMATCH', 'The debtor IBAN in PROFITS differs from the HUB debtor account number the migration sent.', 'MATCHED' FROM DUAL UNION ALL
    SELECT 'SEPA-006', 'SEPA-006_ACCOUNT_NUMBER_MISMATCH',           'CROSS_SYSTEM_MISMATCH', 'The account number in PROFITS differs from the HUB debtor IBAN, which the migration loads here. DC4 note: an IBAN, not a PROFITS account.', 'MATCHED' FROM DUAL UNION ALL
    SELECT 'SEPA-007', 'SEPA-007_CUST_ID_MISMATCH',                  'CROSS_SYSTEM_MISMATCH', 'The customer in PROFITS differs from the customer of the HUB debtor account in PROFITS, as the migration derives it.', 'MATCHED' FROM DUAL UNION ALL
    SELECT 'SEPA-008', 'SEPA-008_DATE_OF_SIGNATURE_MISMATCH',        'CROSS_SYSTEM_MISMATCH', 'The signature date in PROFITS differs from the HUB transaction date the migration sent. DC4 note: HUB has no signature date.', 'MATCHED' FROM DUAL UNION ALL
    SELECT 'SEPA-009', 'SEPA-009_LAST_TRX_DATE_MISMATCH',            'CROSS_SYSTEM_MISMATCH', 'The last transaction date in PROFITS differs from the HUB transaction date the migration sent.', 'MATCHED' FROM DUAL UNION ALL
    SELECT 'SEPA-010', 'SEPA-010_DEBTOR_NAME_MISMATCH',              'CROSS_SYSTEM_MISMATCH', 'The debtor name in PROFITS differs from the first 70 characters of the HUB payer name the migration sent.', 'MATCHED' FROM DUAL UNION ALL
    SELECT 'SEPA-011', 'SEPA-011_DEBTOR_ADDRESS_1_MISMATCH',         'CROSS_SYSTEM_MISMATCH', 'The first debtor address line in PROFITS differs from the HUB debtor address line 1 the migration sent.', 'MATCHED' FROM DUAL UNION ALL
    SELECT 'SEPA-012', 'SEPA-012_DEBTOR_ADDRESS_2_MISMATCH',         'CROSS_SYSTEM_MISMATCH', 'The second debtor address line in PROFITS differs from the HUB debtor address line 2 the migration sent.', 'MATCHED' FROM DUAL UNION ALL
    SELECT 'SEPA-013', 'SEPA-013_DEBTOR_COUNTRY_MISMATCH',           'CROSS_SYSTEM_MISMATCH', 'The debtor country in PROFITS differs from the HUB debtor country the migration sent.', 'MATCHED' FROM DUAL UNION ALL
    SELECT 'SEPA-014', 'SEPA-014_DEBTOR_BIC_MISMATCH',               'CROSS_SYSTEM_MISMATCH', 'The debtor BIC in PROFITS differs from the HUB debtor BIC the migration sent.', 'MATCHED' FROM DUAL UNION ALL
    SELECT 'SEPA-015', 'SEPA-015_DUPLICATE_MANDATE',                 'DUPLICATE',             'Extra mandate rows in PROFITS: the migration loads every HUB collection as a mandate. Counted beyond the latest collection per HUB mandate.', 'MATCHED' FROM DUAL UNION ALL
    SELECT 'SEPA-016', 'SEPA-016_MANDATE_WITHOUT_CUSTOMER',          'INTEGRITY',             'Migrated mandates with no customer. The migration takes the customer only from the debtor account; the detail gives the reason from HUB.', 'MATCHED' FROM DUAL UNION ALL
    SELECT 'SEPA-017', 'SEPA-017_MANDATES_WITHOUT_CUSTOMER_DISTINCT','INFO',                  'Information only: distinct HUB mandates whose migrated rows have no customer (same finding as SEPA-016, per mandate).', 'MANDATES' FROM DUAL UNION ALL
    SELECT 'SEPA-018', 'SEPA-018_CREDITOR_CODE_NOT_PER_CREDITOR',    'CROSS_SYSTEM_MISMATCH', 'The creditor code in PROFITS does not identify the HUB creditor account (empty, several codes per creditor, or shared). To be confirmed with NC.', 'MATCHED' FROM DUAL UNION ALL
    SELECT 'SEPA-019', 'SEPA-019_CREDITOR_NAME_NOT_LOADED',          'CROSS_SYSTEM_MISMATCH', 'The creditor name in PROFITS differs from the HUB beneficiary name. The migration does not load it (commented out).', 'MATCHED' FROM DUAL UNION ALL
    SELECT 'SEPA-020', 'SEPA-020_HARDCODED_FIELDS_CHECK',            'INFO',                  'Information only: migrated mandates where a field the migration sets to a fixed value has another value.', 'PRF_SDD' FROM DUAL UNION ALL
    SELECT 'SEPA-021', 'SEPA-021_COLLECTIONS_WITHOUT_HSBC_DEBTOR',   'INFO',                  'Information only: HUB collections with no HSBC debtor account (outgoing or no HSBC account at all), so no customer can be derived.', 'HUB_SDD' FROM DUAL
),
FINDINGS_COUNT AS (
    SELECT CHECK_ID, COUNT(*) AS INVALID_COUNT
    FROM (SELECT SUBSTR(CHECK_NAME, 1, INSTR(CHECK_NAME, '_') - 1) AS CHECK_ID FROM FINDINGS)
    GROUP BY CHECK_ID
    UNION ALL
    -- INFO checks (μόνο Master, χωρίς Detail)
    SELECT 'SEPA-017', COUNT(DISTINCT K_MANDATE) FROM B WHERE P_CUST IS NULL
    UNION ALL
    SELECT 'SEPA-020', COUNT(*) FROM R_SM WHERE P_CONST_DIFF IS NOT NULL
    UNION ALL
    SELECT 'SEPA-021', COUNT(*) FROM R_SDD WHERE H_DIRECTION IN ('OUTGOING', 'NEITHER')
)
SELECT
    CAST(CM.CHECK_ID AS VARCHAR2(10)) AS CHECK_ID,
    CAST(CM.CHECK_NAME AS VARCHAR2(50)) AS CHECK_NAME,
    CAST(CM.CATEGORY AS VARCHAR2(30)) AS CATEGORY,
    CAST(CM.DESCRIPTION AS VARCHAR2(200)) AS DESCRIPTION,
    (CASE CM.POPULATION_TYPE
        WHEN 'COUNT'    THEN P.ONE_COUNT
        WHEN 'HUB_SDD'  THEN P.HUB_SDD_COUNT
        WHEN 'PRF_SDD'  THEN P.PRF_SDD_COUNT
        WHEN 'MATCHED'  THEN P.MATCHED_COUNT
        WHEN 'MANDATES' THEN P.MANDATES_COUNT
     END) AS TOTAL_RECORDS,
    (CASE CM.POPULATION_TYPE
        WHEN 'COUNT'    THEN P.ONE_COUNT
        WHEN 'HUB_SDD'  THEN P.HUB_SDD_COUNT
        WHEN 'PRF_SDD'  THEN P.PRF_SDD_COUNT
        WHEN 'MATCHED'  THEN P.MATCHED_COUNT
        WHEN 'MANDATES' THEN P.MANDATES_COUNT
     END) - NVL(FC.INVALID_COUNT, 0) AS VALID_COUNT,
    NVL(FC.INVALID_COUNT, 0) AS INVALID_COUNT,
    CASE WHEN CM.CATEGORY = 'INFO'           THEN 'INFO'
         WHEN NVL(FC.INVALID_COUNT, 0) = 0   THEN 'PASS'
         ELSE 'FAIL' END AS STATUS,
    'DC5' AS DC_VERSION,
    1 AS RUN_VERSION,  -- TESTING ONLY: στο SSIS αντικαθίσταται από @[User::RunVersion] μέσω Derived Column.
    SYSDATE AS RUN_TIMESTAMP
FROM CHECK_META CM
CROSS JOIN POPULATIONS P
LEFT JOIN FINDINGS_COUNT FC ON FC.CHECK_ID = CM.CHECK_ID
ORDER BY REGEXP_SUBSTR(CM.CHECK_ID, '[A-Z]+'), TO_NUMBER(REGEXP_SUBSTR(CM.CHECK_ID, '[0-9]+'));</property>
