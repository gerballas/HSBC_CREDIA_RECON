                  version="1">
                  <properties>
                    <property
                      dataType="System.String"
                      description="The name of the table to be fetched."
                      expressionType="Notify"
                      name="TableName"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      expressionType="Notify"
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">-- ====================================================================
-- SWEEP_RECON — MASTER DC5 v1
-- Τροφοδοτεί: RECON.SWEEP_RECON_MASTER
-- Μία γραμμή ΑΝΑ CHECK_ID — 5 γραμμές ανά run: SWP-001 .. SWP-005 (SWP-005 = INFO, μόνο Master).
--
-- Sweep Agreements (ME01_HUB, EIM 240825): HUB_MT_AFSIMSP + HUB_MT_AFSIRAP vs SWEEP_AGREEMENT.
-- ΔΕΝ υπάρχει NCIS extract για τα sweeps (κανένα 0x_*.sql στο 20261005 / NCIS\NCIS):
-- η πλευρά PROFITS διαβάζεται απευθείας από το SWEEP_AGREEMENT (απόφαση χρήστη 2026-11-18).
-- Οι στήλες κρατούν τα ονόματα του template (NCIS_VALUE = τιμή SWEEP_AGREEMENT).
-- Migration scripts DC5: Recon Material Final\Scripts\Migration Scripts\20261116_MigrationScripts.
-- Διαφορές DC4 -&gt; DC5: DC5\DC4_vs_DC5_MigrationScripts_SweepAgreements_Diff_Report.md
-- (60100: μόνο CR / DR justification 33018 / 34003 -&gt; 33041 / 34041).
-- Μορφή Master/Detail όπως το MasterCustomerAddresses_DC5_v3.sql:
--   - ένα αυτοτελές SELECT, χωρίς views και χωρίς HGR_* πίνακες. Το κοινό κομμάτι (CTEs) και το
--     FINDINGS είναι ΙΔΙΑ αυτούσια στο DetailSweepAgreements_DC5_v1.sql -&gt; INVALID_COUNT = γραμμές
--     του Detail ανά CHECK_ID.
--   - Παράγεται από τον generator (_generator): swp_master_head + swp_common + swp_master_tail.
--   - HUB από τα synonyms HUB_MT_AFSIMSP / HUB_MT_AFSIRAP (DB link @Malta, 10098), ΜΙΑ φορά το καθένα.
--
-- ΚΛΕΙΔΙ: ζεύγος λογαριασμών PROFITS (χρέωση, πίστωση), όπως το GROUP BY του 60100. Το SWEEP_AGREEMENT
--   δεν έχει OTHER_SYS_IDENTIFIER ή άλλο πεδίο που να δείχνει την εντολή του HUB.
--   Λογαριασμός HUB -&gt; PROFITS μέσω PROFITS_ACCOUNT (ACCOUNT_NUMBER -&gt; DEP_ACC_NUMBER), όπως στα
--   TPSO / Debit Cards recon. Έλεγχος 2026-11-18: και οι 725 γραμμές SWEEP_AGREEMENT βρίσκουν χρέωση και
--   πίστωση στο DEP_ACC_NUMBER. Το MG_DPAC_LOAD (ενδιάμεσος πίνακας) δεν χρησιμοποιείται.
--   Λάθος λογαριασμός στο PROFITS φαίνεται ως SWP-001 + SWP-002, όχι ως mismatch.
--
-- ΑΡΧΗ: αναμενόμενη τιμή ΜΟΝΟ από το 60100_SWEEP_AGREEMENT.sql (καμία δική μας υπόθεση):
--   - Πληθυσμός HUB: FNAPTY = 'BSI' AND FNISTY &lt;&gt; '1' AND FNTGAM &lt;&gt; 0 AND FNTGAM &lt; 99999999.
--   - MIN_MAX_BAL_LIMIT = MAX(FNTGAM), MIN_SWEEP_AMOUNT = MAX(FTAMT1) ανά ζεύγος λογαριασμών,
--     όπως τα στέλνει το script (χωρίς /100, AFSIRAP χωρίς φίλτρο FTRCTP). Ανοχή 0.005.
--   - Shadow records (FNMDFL / FTMDFL = 'S'): το 60100 δεν τα φιλτράρει, άρα ούτε τα checks.
--   - HUB_VALUE = πεδία HUB, NCIS_VALUE = τιμή SWEEP_AGREEMENT, αναμενόμενη τιμή στο ISSUE.
--   - Detail: CUSTOMER_CODE = λογαριασμός χρέωσης HUB (ACCOUNT_NO), SERIAL_NO = SERIAL_NUMBER
--     (απόφαση χρήστη 2026-11-18). SERIAL_NUMBER = ROWNUM του 10090: ισχύει μόνο μέσα στο ίδιο data cut.
--   - Δεν ελέγχονται (χωρίς πηγή HUB, κανόνας του playbook): SWEEP_TYPE '2', CR / DR_JUSTIFICATION
--     33041 / 34041, LOANS_SCHEME '0', SWEEP_AGR_DATE 0001-01-01, TIMESTMP.
--   - Ανοιχτά προς NC (report §4, δεν αλλάζουν την αναμενόμενη τιμή): S4 διπλή μετάπτωση με το
--     TP_SO_COMMITMENT (μετριέται στο SWP-005, INFO - απόφαση χρήστη 2026-11-18), S5 ποσά χωρίς /100,
--     S6 σημασία FNTGAM / FTAMT1 (L ή R), S8 τύποι εντολής 3 / 5, S13 λήξη / αδράνεια (χωρίς check).
--   - SWP-005 (INFO): μόνο στο Master, μετριέται στο FINDINGS_COUNT, χωρίς γραμμές στο Detail.
--     Κλειδί TP_SO_COMMITMENT.OTHER_SYS_IDENTIFIER = AFSIMSP.SERIAL_NUMBER (60000), όπως στο TPSO recon.
--
-- ΑΝΤΙΣΤΟΙΧΙΑ με το DC4: κανένα - δεν υπήρχε recon για τα sweeps στο DC4. Νέα checks.
--
-- STATUS: PASS (INVALID_COUNT = 0) / FAIL / INFO (SWP-005). DESCRIPTION: απλή περιγραφή χωρίς κωδικούς.
--
-- TOTAL_RECORDS ανά POPULATION_TYPE:
--   HUB_SWEEP = εντολές HUB που επιλέγει το 60100 (μία ανά SERIAL_NUMBER)
--   SA_ROWS   = γραμμές SWEEP_AGREEMENT (μία ανά ζεύγος λογαριασμών)
--   MATCHED   = εντολές HUB που βρίσκονται στο SWEEP_AGREEMENT
-- ====================================================================
WITH
-- --------------------------------------------------------------------
-- Κοινό κομμάτι (ΙΔΙΟ αυτούσιο στο Master και στο Detail).
--   R_SI = HUB_MT_AFSIMSP (synonym σε DB link @Malta, 10098): ΜΙΑ φορά, μόνο οι στήλες που
--          χρειάζονται, μόνο οι εντολές που επιλέγει το 60100 (φίλτρο σε πεδία HUB:
--          FNAPTY = 'BSI', FNISTY &lt;&gt; '1', 0 &lt; FNTGAM &lt; 99999999), μία γραμμή ανά SERIAL_NUMBER.
--          ACCOUNT_NO / CREDIT_ACCOUNT_NO / SERIAL_NUMBER τα προσθέτει το 10090 (γρ. 181-187, 452-454):
--          CREDIT_ACCOUNT_NO = FNAPAC χαρ. 7-9 / 10-15 / 16-18, ΜΟΝΟ όταν FNPYMD = 'T'.
--   R_RA = HUB_MT_AFSIRAP: ΜΙΑ φορά, μία γραμμή ανά λογαριασμό (κλειδί του LEFT JOIN του 60100,
--          FTCTCD / FTGMAB / FTPPAB / FTPPAS / FTPPAX). AMT_MAX = MAX(FTAMT1) όπως το 60100.
--          AMT_L / AMT_R (FTRCTP 'L' low level balance / 'R' retention amount) μόνο για το HUB_VALUE.
--   PA   = PROFITS_ACCOUNT: λογαριασμός HUB (ACCOUNT_NUMBER) -&gt; λογαριασμός PROFITS (DEP_ACC_NUMBER),
--          μία γραμμή ανά λογαριασμό HUB. ΠΟΤΕ αντίστροφα: ένα DEP_ACC_NUMBER έχει 2-5 ACCOUNT_NUMBER
--          (έλεγχος 2026-11-18). Το MG_DPAC_LOAD (ενδιάμεσος πίνακας) ΔΕΝ χρησιμοποιείται.
--   SA   = SWEEP_AGREEMENT (πλευρά PROFITS - δεν υπάρχει NCIS extract, απόφαση χρήστη 2026-11-18:
--          NCIS_VALUE = τιμή του SWEEP_AGREEMENT). Μία γραμμή ανά ζεύγος (FK0DEPOSIT_ACCOACC = χρέωση,
--          FK_DEPOSIT_ACCOACC = πίστωση), όπως το GROUP BY του 60100.
--   H    = εντολή HUB + λογαριασμοί PROFITS + αναμενόμενη τιμή ανά ζεύγος λογαριασμών (60100):
--          E_LIMIT = MAX(FNTGAM), E_MINAMT = MAX(FTAMT1), χωρίς /100 (όπως το στέλνει το script).
--   B    = εντολές HUB που βρίσκονται στο SWEEP_AGREEMENT (ζεύγος λογαριασμών PROFITS)
-- --------------------------------------------------------------------
R_SI AS (
    SELECT /*+ MATERIALIZE */ SN, AN, CAN, APAC, ISTY, TGAM, CTCD, GMAB, PPAB, PPAS, PPAX
    FROM (
        SELECT SERIAL_NUMBER                       AS SN,
               TRIM(ACCOUNT_NO)                    AS AN,
               TRIM(CREDIT_ACCOUNT_NO)             AS CAN,
               TRIM(FNAPAC)                        AS APAC,
               TRIM(TO_CHAR(FNISTY))               AS ISTY,
               FNTGAM                              AS TGAM,
               FNCTCD AS CTCD, FNGMAB AS GMAB, FNPPAB AS PPAB, FNPPAS AS PPAS, FNPPAX AS PPAX,
               ROW_NUMBER() OVER (PARTITION BY SERIAL_NUMBER ORDER BY NULL) AS RN
          FROM HUB_MT_AFSIMSP
         WHERE TRIM(FNAPTY) = 'BSI'
           AND FNISTY &lt;&gt; '1'
           AND FNTGAM &lt;&gt; 0
           AND FNTGAM &lt; 99999999
    )
    WHERE RN = 1
),
R_RA AS (
    SELECT /*+ MATERIALIZE */
           FTCTCD AS CTCD, FTGMAB AS GMAB, FTPPAB AS PPAB, FTPPAS AS PPAS, FTPPAX AS PPAX,
           MAX(FTAMT1)                                       AS AMT_MAX,
           MAX(CASE WHEN TRIM(FTRCTP) = 'L' THEN FTAMT1 END) AS AMT_L,
           MAX(CASE WHEN TRIM(FTRCTP) = 'R' THEN FTAMT1 END) AS AMT_R
      FROM HUB_MT_AFSIRAP
     GROUP BY FTCTCD, FTGMAB, FTPPAB, FTPPAS, FTPPAX
),
PA AS (
    SELECT /*+ MATERIALIZE */ TRIM(ACCOUNT_NUMBER) AS ACC, MIN(TRIM(TO_CHAR(DEP_ACC_NUMBER))) AS DEP
      FROM PROFITS_ACCOUNT
     WHERE DEP_ACC_NUMBER IS NOT NULL
     GROUP BY TRIM(ACCOUNT_NUMBER)
),
SA AS (
    SELECT /*+ MATERIALIZE */ D, C, T_LIMIT, T_MINAMT
    FROM (
        SELECT TRIM(TO_CHAR(FK0DEPOSIT_ACCOACC)) AS D,
               TRIM(TO_CHAR(FK_DEPOSIT_ACCOACC)) AS C,
               MIN_MAX_BAL_LIMIT                 AS T_LIMIT,
               MIN_SWEEP_AMOUNT                  AS T_MINAMT,
               ROW_NUMBER() OVER (PARTITION BY FK0DEPOSIT_ACCOACC, FK_DEPOSIT_ACCOACC ORDER BY NULL) AS RN
          FROM SWEEP_AGREEMENT
    )
    WHERE RN = 1
),
H AS (
    SELECT /*+ MATERIALIZE */
           s.SN, s.AN, s.CAN, s.APAC, s.ISTY, s.TGAM,
           r.AMT_L, r.AMT_R,
           pd.DEP AS D_DEP,
           pc.DEP AS C_DEP,
           MAX(s.TGAM)    OVER (PARTITION BY pd.DEP, pc.DEP) AS E_LIMIT,
           MAX(r.AMT_MAX) OVER (PARTITION BY pd.DEP, pc.DEP) AS E_MINAMT
      FROM R_SI s
      LEFT JOIN R_RA r
        ON r.CTCD = s.CTCD AND r.GMAB = s.GMAB
       AND r.PPAB = s.PPAB AND r.PPAS = s.PPAS AND r.PPAX = s.PPAX
      LEFT JOIN PA pd ON pd.ACC = s.AN
      LEFT JOIN PA pc ON pc.ACC = s.CAN
),
B AS (
    SELECT /*+ MATERIALIZE */ h.*, a.T_LIMIT, a.T_MINAMT
      FROM H h
      JOIN SA a ON a.D = h.D_DEP AND a.C = h.C_DEP
),
FINDINGS AS (
    -- Μία γραμμή ανά εύρημα. CUSTOMER_CODE = λογαριασμός χρέωσης HUB (AFSIMSP.ACCOUNT_NO),
    -- SERIAL_NO = AFSIMSP.SERIAL_NUMBER. Στο SWP-002 (χωρίς εντολή HUB): CUSTOMER_CODE = λογαριασμός
    -- χρέωσης PROFITS (FK0DEPOSIT_ACCOACC), SERIAL_NO κενό. HUB_VALUE = τιμή HUB, NCIS_VALUE = τιμή
    -- SWEEP_AGREEMENT, αναμενόμενη τιμή (μόνο από το 60100) στο ISSUE.
    --==============================================================
    --SWP-001. Εντολή HUB που επιλέγει το 60100 και δεν υπάρχει στο SWEEP_AGREEMENT
    --         (ζεύγος λογαριασμών PROFITS μέσω PROFITS_ACCOUNT). ISSUE = αιτία από την πλευρά PROFITS.
    SELECT
      CAST('SWP-001_SWEEP_MISSING_IN_PROFITS' AS VARCHAR2(50)) AS CHECK_NAME,
      CAST(h.AN AS VARCHAR2(40)) AS CUSTOMER_CODE,
      CAST(TO_CHAR(h.SN) AS VARCHAR2(40)) AS SERIAL_NO,
      CAST(SUBSTR('DEBIT=' || h.AN || '; FNAPAC=' || h.APAC || '; FNISTY=' || h.ISTY
                  || '; FNTGAM=' || TO_CHAR(h.TGAM), 1, 200) AS VARCHAR2(200)) AS HUB_VALUE,
      CAST(NULL AS VARCHAR2(200)) AS NCIS_VALUE,
      CAST(CASE WHEN h.D_DEP IS NULL THEN 'DEBIT_ACC_NOT_IN_PROFITS'
                WHEN h.CAN   IS NULL THEN 'CREDIT_ACC_NOT_IN_PROFITS (FNPYMD NOT T)'
                WHEN h.C_DEP IS NULL THEN 'CREDIT_ACC_NOT_IN_PROFITS'
                ELSE 'MISSING_IN_PROFITS' END AS VARCHAR2(50)) AS ISSUE
    FROM H h
    WHERE NOT EXISTS (SELECT 1 FROM SA a WHERE a.D = h.D_DEP AND a.C = h.C_DEP)
    UNION ALL
    --==============================================================
    --SWP-002. Γραμμή SWEEP_AGREEMENT χωρίς εντολή HUB με το ίδιο ζεύγος λογαριασμών
    SELECT 'SWP-002_SWEEP_MISSING_IN_HUB', a.D, CAST(NULL AS VARCHAR2(40)), CAST(NULL AS VARCHAR2(200)),
           SUBSTR('FK0DEPOSIT_ACCOACC=' || a.D || '; FK_DEPOSIT_ACCOACC=' || a.C
                  || '; MIN_MAX_BAL_LIMIT=' || TO_CHAR(a.T_LIMIT) || '; MIN_SWEEP_AMOUNT=' || TO_CHAR(a.T_MINAMT), 1, 200),
           'EXTRA_IN_PROFITS'
    FROM SA a
    WHERE NOT EXISTS (SELECT 1 FROM H h WHERE h.D_DEP = a.D AND h.C_DEP = a.C)
    UNION ALL
    --==============================================================
    --SWP-003. MIN_MAX_BAL_LIMIT vs MAX(FNTGAM) του ζεύγους λογαριασμών (60100, χωρίς /100). Ανοχή 0.005.
    SELECT 'SWP-003_BALANCE_LIMIT_MISMATCH', b.AN, TO_CHAR(b.SN),
           'FNTGAM=' || TO_CHAR(b.TGAM), TO_CHAR(b.T_LIMIT),
           'MISMATCH (EXPECTED ' || NVL(TO_CHAR(b.E_LIMIT), 'EMPTY') || ')'
    FROM B b
    WHERE NOT (b.T_LIMIT IS NULL AND b.E_LIMIT IS NULL)
      AND (b.T_LIMIT IS NULL OR b.E_LIMIT IS NULL OR ABS(b.T_LIMIT - b.E_LIMIT) &gt;= 0.005)
    UNION ALL
    --==============================================================
    --SWP-004. MIN_SWEEP_AMOUNT vs MAX(FTAMT1) του ζεύγους λογαριασμών (60100: LEFT JOIN AFSIRAP,
    --         χωρίς φίλτρο FTRCTP, χωρίς /100). HUB_VALUE: τα ποσά L και R. Ανοχή 0.005.
    SELECT 'SWP-004_MIN_SWEEP_AMOUNT_MISMATCH', b.AN, TO_CHAR(b.SN),
           'FTAMT1 L=' || NVL(TO_CHAR(b.AMT_L), '-') || '; R=' || NVL(TO_CHAR(b.AMT_R), '-'),
           TO_CHAR(b.T_MINAMT),
           'MISMATCH (EXPECTED ' || NVL(TO_CHAR(b.E_MINAMT), 'EMPTY') || ')'
    FROM B b
    WHERE NOT (b.T_MINAMT IS NULL AND b.E_MINAMT IS NULL)
      AND (b.T_MINAMT IS NULL OR b.E_MINAMT IS NULL OR ABS(b.T_MINAMT - b.E_MINAMT) &gt;= 0.005)
    -- SWP-005 (INFO): μόνο Master, μετριέται στο FINDINGS_COUNT του Master - χωρίς γραμμές στο Detail
)
,
TPS AS (
    -- Μόνο για το SWP-005 (INFO, μόνο Master): εντολές HUB που είναι και στο TP_SO_COMMITMENT.
    -- OTHER_SYS_IDENTIFIER = AFSIMSP.SERIAL_NUMBER (60000 γρ. 149), όπως στο TPSO recon.
    SELECT /*+ MATERIALIZE */ DISTINCT
           TO_NUMBER(TRIM(TO_CHAR(OTHER_SYS_IDENTIFIER)) DEFAULT NULL ON CONVERSION ERROR) AS OSI
      FROM TP_SO_COMMITMENT
),
POPULATIONS AS (
    SELECT
        (SELECT COUNT(*) FROM H)  AS HUB_SWEEP_COUNT,
        (SELECT COUNT(*) FROM SA) AS SA_ROWS_COUNT,
        (SELECT COUNT(*) FROM B)  AS MATCHED_COUNT
    FROM DUAL
),
CHECK_META AS (
    -- CHECK_ID | CHECK_NAME | CATEGORY | DESCRIPTION | POPULATION_TYPE
    SELECT 'SWP-001' AS CHECK_ID, 'SWP-001_SWEEP_MISSING_IN_PROFITS' AS CHECK_NAME, 'EXISTENCE' AS CATEGORY, 'HUB balance sweep instructions that the migration selects but that are not in the PROFITS sweep agreements. The detail rows say if the debit or credit account is missing in PROFITS.' AS DESCRIPTION, 'HUB_SWEEP' AS POPULATION_TYPE FROM DUAL UNION ALL
    SELECT 'SWP-002', 'SWP-002_SWEEP_MISSING_IN_HUB',      'EXISTENCE',             'Sweep agreements in PROFITS that do not match any HUB sweep instruction with the same debit and credit account.', 'SA_ROWS' FROM DUAL UNION ALL
    SELECT 'SWP-003', 'SWP-003_BALANCE_LIMIT_MISMATCH',    'CROSS_SYSTEM_MISMATCH', 'The balance limit in PROFITS differs from the HUB trigger amount the migration sends: the highest per debit and credit account, as stored in HUB.', 'MATCHED' FROM DUAL UNION ALL
    SELECT 'SWP-004', 'SWP-004_MIN_SWEEP_AMOUNT_MISMATCH', 'CROSS_SYSTEM_MISMATCH', 'The minimum sweep amount in PROFITS differs from the HUB amount the migration sends: the highest balance level amount of the debit account, as stored in HUB.', 'MATCHED' FROM DUAL UNION ALL
    SELECT 'SWP-005', 'SWP-005_SWEEP_ALSO_IN_STANDING_ORDERS', 'INFO',                  'Information only: HUB sweep instructions in the PROFITS sweep agreements that are also migrated as standing orders (same HUB instruction in both tables).', 'MATCHED' FROM DUAL
),
FINDINGS_COUNT AS (
    SELECT CHECK_ID, COUNT(*) AS INVALID_COUNT
    FROM (SELECT SUBSTR(CHECK_NAME, 1, INSTR(CHECK_NAME, '_') - 1) AS CHECK_ID FROM FINDINGS)
    GROUP BY CHECK_ID
    UNION ALL
    -- SWP-005 (INFO, μόνο Master): εντολή HUB στο SWEEP_AGREEMENT που είναι και στο TP_SO_COMMITMENT
    -- (report S4, διπλή μετάπτωση 60000 + 60100)
    SELECT 'SWP-005', COUNT(*) FROM B b WHERE EXISTS (SELECT 1 FROM TPS t WHERE t.OSI = b.SN)
)
SELECT
    CAST(CM.CHECK_ID AS VARCHAR2(10)) AS CHECK_ID,
    CAST(CM.CHECK_NAME AS VARCHAR2(50)) AS CHECK_NAME,
    CAST(CM.CATEGORY AS VARCHAR2(30)) AS CATEGORY,
    CAST(CM.DESCRIPTION AS VARCHAR2(200)) AS DESCRIPTION,
    (CASE CM.POPULATION_TYPE
        WHEN 'HUB_SWEEP' THEN P.HUB_SWEEP_COUNT
        WHEN 'SA_ROWS'   THEN P.SA_ROWS_COUNT
        WHEN 'MATCHED'   THEN P.MATCHED_COUNT
     END) AS TOTAL_RECORDS,
    (CASE CM.POPULATION_TYPE
        WHEN 'HUB_SWEEP' THEN P.HUB_SWEEP_COUNT
        WHEN 'SA_ROWS'   THEN P.SA_ROWS_COUNT
        WHEN 'MATCHED'   THEN P.MATCHED_COUNT
     END) - NVL(FC.INVALID_COUNT, 0) AS VALID_COUNT,
    NVL(FC.INVALID_COUNT, 0) AS INVALID_COUNT,
    CASE WHEN CM.CATEGORY = 'INFO'           THEN 'INFO'
         WHEN NVL(FC.INVALID_COUNT, 0) = 0   THEN 'PASS'
         ELSE 'FAIL' END AS STATUS,
    'DC5' AS DC_VERSION,
    1 AS RUN_VERSION,  -- TESTING ONLY: στο SSIS αντικαθίσταται από @[User::RunVersion] μέσω Derived Column.
    SYSDATE AS RUN_TIMESTAMP
FROM CHECK_META CM
CROSS JOIN POPULATIONS P
LEFT JOIN FINDINGS_COUNT FC ON FC.CHECK_ID = CM.CHECK_ID
ORDER BY REGEXP_SUBSTR(CM.CHECK_ID, '[A-Z]+'), TO_NUMBER(REGEXP_SUBSTR(CM.CHECK_ID, '[0-9]+'));</property>
