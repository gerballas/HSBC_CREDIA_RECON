-- SSIS scripts\Recon_tables.sql)
-- Μία γραμμή ΑΝΑ CHECK_ID — 7 γραμμές ανά run: WRN-001 .. WRN-007 (2026-11-18: το παλιό WRN-006
-- «διπλά μηνύματα» αφαιρέθηκε και η ημερομηνία λήξης έγινε WRN-006· την ίδια μέρα τα διπλά ξαναμπήκαν, απόφαση
-- χρήστη, ως WRN-007 με HUB_VALUE = πλήθος cautions στο HUB και NCIS_VALUE = πλήθος μηνυμάτων στο PROFITS).
--
-- Warnings (ME12 Warnings Database Malta, EIM 237014, DD v1.4): HUB CAUTION vs PROFITS PROFITS_MESSAGE.
-- Migration scripts: ΜΟΝΟ Migration Scripts\20261116_MigrationScripts (82000_WarningDatabase, απόφαση χρήστη).
-- Στο DC5 το 82000 γράφει τα ενεργά cautions ως μήνυμα πελάτη στο PROFITS_MESSAGE (MSGAC 99), όχι πια στο
-- SUSPECT_CUST. Το 70000 (account messages από HUB_MT_SSSPINP) είναι εκτός κατηγορίας (απόφαση χρήστη).
-- ΔΕΝ υπάρχει NCIS extract: οι τιμές PROFITS διαβάζονται απευθείας από το PROFITS_MESSAGE. Οι στήλες λέγονται
-- NCIS_VALUE για συμβατότητα με το template.
-- Διαφορές DC4 -&gt; DC5: DC5\DC4_vs_DC5_MigrationScripts_Warnings_Diff_Report.md.
-- Μορφή Master/Detail όπως το MasterCustomerAddresses_DC5_v3.sql:
--   - ένα αυτοτελές SELECT, χωρίς views / πίνακες HGR_*. Το κοινό κομμάτι (CTEs) και το FINDINGS είναι ΙΔΙΑ
--     αυτούσια στο DetailWarnings_DC5_v1.sql -&gt; INVALID_COUNT = γραμμές του Detail ανά CHECK_ID.
--   - Παράγεται από τον generator (_generator\build.sh): wrn_master_head + wrn_common + wrn_master_tail.
--   - HUB: CAUTION = synonym του 10099 για DATACUT5.CAUTION@DATACUT5_MALTA (remote): ΜΙΑ ανάγνωση σε R_CAU.
--
-- ΑΡΧΗ: αναμενόμενη τιμή ΜΟΝΟ από το 82000_WarningDatabase (20261116):
--   - Πληθυσμός: CAUTION με ACTIVE = 1.
--   - Πελάτης: TRIM(OTHER_ID.ID_NO) = TRIM(CAUTION.IDNO) -&gt; MG_CUSTOMER_INTER.PRFT_CUST_ID -&gt; CUSTOMER.CUST_ID
--     (ένα μήνυμα ανά πελάτη που έχει τον αριθμό· LEFT JOIN OTHER_AFM / CUST_ADDRESS όπως στο script).
--     Cautions χωρίς τέτοιο πελάτη (ή με IDNO NULL) δεν μεταφέρονται (στο DC4 πήγαιναν στο SUSPECT_CUST).
--   - ACTUAL_MESSAGE = SUBSTR(TRIM(CAUTION_NO) || ' // ' || TRIM(DESCRIPTION), 1, 150).
--   - CREATE_DATE = ENTRY_DATE αν VALIDATE_CONVERSION(ENTRY_DATE AS DATE,'YYYY-MM-DD') = 1, αλλιώς
--     BANK_PARAMETERS.SCHEDULED_DATE. Το ENTRY_DATE είναι κείμενο 'YYYY-MM-DD HH:MI:SS.0' (D2/D3), άρα
--     η ημερομηνία HUB χάνεται: WRN-005 με ISSUE 'MATCH SCRIPT - HUB DATE LOST' (απόφαση χρήστη, επιλογή Α).
--   - Γραμμές PROFITS του 82000: ACCOUNT_NUMBER κενό, PRFT_SYSTEM 0, FK_GH_MSG_TYPE 'MSGAC',
--     FK_GD_MSG_TYPE 99, CREATE_USER 'GLADM' (το 70000 γράφει πάντα λογαριασμό).
--   - Κλειδί: πελάτης PROFITS + CAUTION_NO (από το κείμενο, πριν το ' // ') + COPY_NO, όπως Other IDs /
--     Addresses. D4: IDNO + CAUTION_NO μοναδικό στα 28.976 ενεργά, CAUTION_NO μόνο του όχι.
--   - EXPIRATION_DATE = σταθερά 20991231, ενώ το HUB έχει EXPIRY_DATE (DD v1.4, VARCHAR2(100)
--     'YYYY-MM-DD HH:MI:SS.0'· DG5: 2.388 από τα 28.976 ενεργά έχουν τιμή). WRN-006 με ISSUE
--     'EXPIRY LOST - ALREADY EXPIRED' (λήξη HUB πριν το SCHEDULED_DATE) ή 'MATCH SCRIPT - HUB EXPIRY LOST'
--     (απόφαση χρήστη 2026-11-18, ίδια λογική με το WRN-005).
--   - Διπλά: όταν ο πελάτης έχει το ίδιο ID_NO σε &gt;1 γραμμές OTHER_ID (DG2), το join του 82000 βγάζει το ίδιο
--     caution δύο φορές. WRN-007, μία γραμμή ανά (πελάτης, CAUTION_NO): HUB_VALUE = cautions στο HUB,
--     NCIS_VALUE = μηνύματα στο PROFITS, ISSUE 'MATCH SCRIPT - DUPLICATE MESSAGE (EXPECTED n)' όταν το PROFITS
--     έχει όσα βγάζει το script (απόφαση χρήστη 2026-11-18, ίδια λογική με τα WRN-005 / WRN-006).
--   - Σταθερά πεδία χωρίς πηγή HUB (MSG_STATUS, CREATE_USER κ.λπ.) και CREATE_UNIT (migration table)
--     δεν είναι checks (κανόνας playbook).
--   - HUB_VALUE = τιμή HUB, NCIS_VALUE = τιμή PROFITS, αναμενόμενη τιμή στο ISSUE.
--   - Detail: CUSTOMER_CODE = κωδικός HUB του πελάτη (MG_CUSTOMER_INTER), SERIAL_NO = CAUTION_NO.
--
-- ΑΝΤΙΣΤΟΙΧΙΑ με το DC4 Cautions_recon.sql (CAU-001..018 πάνω στο SUSPECT_CUST, archive
-- Scripts\Archived\Warnings_20261117):
--   CAU-003 -&gt; WRN-002 | CAU-004 -&gt; WRN-003 | CAU-007 (DATE_FROM) -&gt; WRN-005
--   Νέα: WRN-001 (caution που δεν μεταφέρεται), WRN-004 (κείμενο), WRN-006 (ημερομηνία λήξης· στο DC4 δεν
--   υπήρχε check για το DATE_TO), WRN-007 (διπλά μηνύματα στον ίδιο πελάτη).
--   Αφαιρέθηκαν: CAU-001 (μοναδικότητα κλειδιού: τώρα COPY_NO), CAU-002 (σύνολο: φαίνεται στα TOTAL_RECORDS),
--   CAU-005 (CUST_ID: μέρος του κλειδιού), CAU-006 / CAU-008..018 (ID_NUM, όνομα, ΑΦΜ, διεύθυνση κ.λπ.:
--   δεν υπάρχουν στο PROFITS_MESSAGE).
--
-- STATUS: PASS (INVALID_COUNT = 0) / FAIL. DESCRIPTION: απλή περιγραφή χωρίς κωδικούς.
--
-- TOTAL_RECORDS ανά POPULATION_TYPE:
--   ACT       = ενεργά cautions HUB
--   EXP       = αναμενόμενα μηνύματα (caution x πελάτης) κατά το 82000
--   PROF      = μηνύματα του 82000 στο PROFITS_MESSAGE
--   MATCHED   = ζευγάρια αναμενόμενο - PROFITS με ίδιο κλειδί
--   PROF_KEYS = κλειδιά (πελάτης, CAUTION_NO) στο PROFITS_MESSAGE του 82000
-- ====================================================================
WITH
-- --------------------------------------------------------------------
-- Κοινό κομμάτι (ΙΔΙΟ αυτούσιο στο Master και στο Detail).
--   R_CAU = CAUTION (synonym του 10099 -&gt; DATACUT5.CAUTION@DATACUT5_MALTA): ΜΙΑ ανάγνωση, μόνο τα ενεργά
--           (82000: cc.ACTIVE = '1'), μόνο οι στήλες που χρειάζονται. CID = αύξων αριθμός (εσωτερικό κλειδί).
--   BP    = BANK_PARAMETERS.SCHEDULED_DATE (fallback του 82000 για το CREATE_DATE).
--   CAU   = R_CAU + υπολογισμοί ΤΟΠΙΚΑ:
--           MSG      = SUBSTR((TRIM(CAUTION_NO) || ' // ' || TRIM(DESCRIPTION)), 1, 150)  (82000 ACTUAL_MESSAGE)
--           FULLTXT  = το ίδιο χωρίς περικοπή (για το HUB_VALUE)
--           KCNO     = CAUTION_NO όπως διαβάζεται από το κείμενο (πριν το ' // '), ίδια συνάρτηση και στο PRF
--           E_CREATE = 82000: ENTRY_DATE αν VALIDATE_CONVERSION(ENTRY_DATE AS DATE,'YYYY-MM-DD') = 1,
--                      αλλιώς SCHEDULED_DATE (NULL ENTRY_DATE -&gt; VALIDATE_CONVERSION = 1 -&gt; NULL)
--           H_DATE   = η ημερομηνία του HUB ENTRY_DATE (πρώτοι 10 χαρακτήρες), ΜΟΝΟ για το ISSUE του WRN-005
--           EXPIRY_DATE / H_EXP = HUB EXPIRY_DATE (VARCHAR2(100), 'YYYY-MM-DD HH:MI:SS.0') ως κείμενο / ως
--                      ημερομηνία (πρώτοι 10 χαρακτήρες), ΜΟΝΟ για το WRN-006. Το 82000 στέλνει πάντα
--                      EXPIRATION_DATE 20991231. SD = SCHEDULED_DATE (όριο για το 'ALREADY EXPIRED').
--   OI   = OTHER_ID με αριθμό που υπάρχει σε ενεργό caution (82000: TRIM(oi.ID_NO) = TRIM(cc.IDNO)).
--   EXP   = αναμενόμενα μηνύματα: ίδια joins με το 82000 (OTHER_ID -&gt; MG_CUSTOMER_INTER -&gt; CUSTOMER,
--           LEFT JOIN OTHER_AFM MAIN_FLAG '1' / CUST_ADDRESS SERIAL_NUM 1, που μπορεί να πολλαπλασιάσουν).
--           COPY_NO = αντίγραφο ανά (πελάτης, KCNO).
--   PRF   = PROFITS_MESSAGE του 82000: ACCOUNT_NUMBER κενό, PRFT_SYSTEM 0, MSGAC / 99, GLADM (το 70000
--           γράφει λογαριασμό). COPY_NO / N_COPIES ανά (πελάτης, KCNO).
--   EXPK  = EXP ανά (πελάτης, KCNO): N_HUB = πόσα διαφορετικά cautions HUB (CID) δίνουν αυτό το κλειδί,
--           N_EXP = πόσα μηνύματα βγάζει το 82000 (μαζί με τα αντίγραφα του join). ΜΟΝΟ για το WRN-007.
--   DUPS  = κλειδιά PROFITS (πελάτης, KCNO) με περισσότερα μηνύματα από τα cautions του HUB (WRN-007).
--   MCIR  = MG_CUSTOMER_INTER: PRFT_CUST_ID -&gt; κωδικός HUB (για τις γραμμές PROFITS).
--   PAIRS = EXP vs PRF, FULL OUTER JOIN με κλειδί (πελάτης, KCNO, COPY_NO), NULL-safe.
-- --------------------------------------------------------------------
R_CAU AS (
    SELECT /*+ MATERIALIZE */
           ROWNUM                AS CID,
           IDNO,
           CAUTION_NO,
           DESCRIPTION,
           ENTRY_DATE,
           EXPIRY_DATE
      FROM CAUTION
     WHERE ACTIVE = 1
),
BP AS (
    SELECT MAX(SCHEDULED_DATE) AS SD FROM BANK_PARAMETERS
),
CAU AS (
    SELECT /*+ MATERIALIZE */
           r.CID,
           TRIM(r.IDNO)                                                         AS IDN,
           TRIM(r.CAUTION_NO)                                                   AS CNO,
           TRIM(r.ENTRY_DATE)                                                   AS ENTRY_DATE,
           SUBSTR((TRIM(r.CAUTION_NO) || ' // ' || TRIM(r.DESCRIPTION)), 1, 150) AS MSG,
           TRIM(r.CAUTION_NO) || ' // ' || TRIM(r.DESCRIPTION)                  AS FULLTXT,
           TRIM(SUBSTR(RTRIM(SUBSTR((TRIM(r.CAUTION_NO) || ' // ' || TRIM(r.DESCRIPTION)), 1, 150)) || ' ', 1,
                       INSTR(RTRIM(SUBSTR((TRIM(r.CAUTION_NO) || ' // ' || TRIM(r.DESCRIPTION)), 1, 150)) || ' ', ' // ') - 1)) AS KCNO,
           CASE WHEN VALIDATE_CONVERSION(r.ENTRY_DATE AS DATE, 'YYYY-MM-DD') = 1
                THEN TO_DATE(r.ENTRY_DATE, 'YYYY-MM-DD')
                ELSE bp.SD END                                                  AS E_CREATE,
           CASE WHEN TRIM(r.ENTRY_DATE) IS NOT NULL
                 AND VALIDATE_CONVERSION(SUBSTR(TRIM(r.ENTRY_DATE), 1, 10) AS DATE, 'YYYY-MM-DD') = 1
                THEN TO_DATE(SUBSTR(TRIM(r.ENTRY_DATE), 1, 10), 'YYYY-MM-DD') END AS H_DATE,
           TRIM(r.EXPIRY_DATE)                                                  AS EXPIRY_DATE,
           CASE WHEN TRIM(r.EXPIRY_DATE) IS NOT NULL
                 AND VALIDATE_CONVERSION(SUBSTR(TRIM(r.EXPIRY_DATE), 1, 10) AS DATE, 'YYYY-MM-DD') = 1
                THEN TO_DATE(SUBSTR(TRIM(r.EXPIRY_DATE), 1, 10), 'YYYY-MM-DD') END AS H_EXP,
           bp.SD
      FROM R_CAU r
     CROSS JOIN BP bp
),
OI AS (
    SELECT /*+ MATERIALIZE */
           TRIM(o.ID_NO)          AS IDN,
           o.FK_CUSTOMERCUST_ID   AS PRFT,
           o.SERIAL_NO
      FROM OTHER_ID o
     WHERE TRIM(o.ID_NO) IN (SELECT IDN FROM CAU WHERE IDN IS NOT NULL)
),
EXP AS (
    SELECT /*+ MATERIALIZE */
           c.CID, c.IDN, c.CNO, c.KCNO, c.MSG, c.FULLTXT, c.ENTRY_DATE, c.E_CREATE, c.H_DATE,
           c.EXPIRY_DATE, c.H_EXP, c.SD,
           cu.CUST_ID                      AS PRFT,
           TRIM(mci.CUSTOMER_CODE)         AS CC,
           ROW_NUMBER() OVER (PARTITION BY cu.CUST_ID, NVL(c.KCNO, '#NOCNO#')
                              ORDER BY c.MSG, c.IDN, oi.SERIAL_NO) AS COPY_NO
      FROM CAU c
      JOIN OI oi                 ON oi.IDN = c.IDN
      JOIN MG_CUSTOMER_INTER mci ON mci.PRFT_CUST_ID = oi.PRFT
      JOIN CUSTOMER cu           ON cu.CUST_ID = mci.PRFT_CUST_ID
      LEFT JOIN OTHER_AFM oa     ON oa.FK_CUSTOMERCUST_ID = cu.CUST_ID AND oa.MAIN_FLAG = '1'
      LEFT JOIN CUST_ADDRESS ca  ON ca.FK_CUSTOMERCUST_ID = cu.CUST_ID AND ca.SERIAL_NUM = 1
),
PRF AS (
    SELECT /*+ MATERIALIZE */
           q.SN, q.PRFT, q.MSG, q.CREATE_DATE, q.EXPIRATION_DATE, q.KCNO,
           ROW_NUMBER() OVER (PARTITION BY q.PRFT, NVL(q.KCNO, '#NOCNO#') ORDER BY q.MSG, q.SN) AS COPY_NO,
           COUNT(*)     OVER (PARTITION BY q.PRFT, NVL(q.KCNO, '#NOCNO#'))                    AS N_COPIES
      FROM (
            SELECT pm.SN,
                   pm.CUST_ID                AS PRFT,
                   RTRIM(pm.ACTUAL_MESSAGE)  AS MSG,
                   pm.CREATE_DATE,
                   pm.EXPIRATION_DATE,
                   TRIM(SUBSTR(RTRIM(pm.ACTUAL_MESSAGE) || ' ', 1,
                               INSTR(RTRIM(pm.ACTUAL_MESSAGE) || ' ', ' // ') - 1)) AS KCNO
              FROM PROFITS_MESSAGE pm
             WHERE TRIM(pm.ACCOUNT_NUMBER) IS NULL
               AND pm.PRFT_SYSTEM = 0
               AND TRIM(pm.FK_GH_MSG_TYPE) = 'MSGAC'
               AND pm.FK_GD_MSG_TYPE = 99
               AND TRIM(pm.CREATE_USER) = 'GLADM'
           ) q
),
MCIR AS (
    SELECT /*+ MATERIALIZE */ PRFT_CUST_ID AS PRFT, MIN(TRIM(CUSTOMER_CODE)) AS CC
      FROM MG_CUSTOMER_INTER
     WHERE PRFT_CUST_ID IN (SELECT PRFT FROM PRF)
     GROUP BY PRFT_CUST_ID
),
PAIRS AS (
    SELECT /*+ MATERIALIZE */
           e.CID, e.CC, e.CNO, e.KCNO AS E_KCNO, e.MSG AS E_MSG, e.FULLTXT, e.ENTRY_DATE, e.E_CREATE, e.H_DATE,
           e.EXPIRY_DATE AS H_EXP_TXT, e.H_EXP, e.SD,
           e.PRFT AS E_PRFT, e.COPY_NO AS E_COPY,
           p.SN, p.PRFT AS P_PRFT, p.KCNO AS P_KCNO, p.MSG AS P_MSG, p.CREATE_DATE AS P_CREATE,
           p.EXPIRATION_DATE AS P_EXP, p.COPY_NO AS P_COPY
      FROM EXP e
      FULL OUTER JOIN PRF p
        ON p.PRFT = e.PRFT
       AND NVL(p.KCNO, '#NOCNO#') = NVL(e.KCNO, '#NOCNO#')
       AND p.COPY_NO = e.COPY_NO
),
W5 AS (
    -- WRN-005: ημερομηνία δημιουργίας στα ζευγάρια. Απόφαση χρήστη 2026-11-17 (επιλογή Α):
    --   αναμενόμενη = κανόνας του 82000 (E_CREATE). Αν το PROFITS συμφωνεί με το script αλλά η ημερομηνία
    --   του HUB ENTRY_DATE είναι άλλη, η γραμμή βγαίνει κι αυτή, με ISSUE 'MATCH SCRIPT - HUB DATE LOST'.
    SELECT x.*,
           CASE WHEN NVL(TRUNC(x.P_CREATE), DATE '0001-01-01') &lt;&gt; NVL(TRUNC(x.E_CREATE), DATE '0001-01-01')
                THEN 'MISMATCH (EXPECTED ' || NVL(TO_CHAR(x.E_CREATE, 'YYYY-MM-DD'), 'NULL') || ')'
                WHEN x.H_DATE IS NOT NULL AND x.H_DATE &lt;&gt; NVL(TRUNC(x.P_CREATE), DATE '0001-01-01')
                THEN 'MATCH SCRIPT - HUB DATE LOST (EXPECTED ' || TO_CHAR(x.E_CREATE, 'YYYY-MM-DD') || ')'
           END AS ISS
      FROM PAIRS x
     WHERE x.E_PRFT IS NOT NULL AND x.P_PRFT IS NOT NULL
),
W6 AS (
    -- WRN-006: ημερομηνία λήξης στα ζευγάρια. Απόφαση χρήστη 2026-11-18 (ίδια λογική με το WRN-005):
    --   αναμενόμενη = κανόνας του 82000 (EXPIRATION_DATE 20991231). Αν το PROFITS συμφωνεί με το script αλλά
    --   το HUB EXPIRY_DATE έχει τιμή άλλη από 2099-12-31, η γραμμή βγαίνει κι αυτή: 'ALREADY EXPIRED' όταν η
    --   λήξη HUB είναι πριν το SCHEDULED_DATE, αλλιώς 'HUB EXPIRY LOST' (και για τιμή που δεν είναι ημερομηνία).
    SELECT x.*,
           CASE WHEN NVL(TRUNC(x.P_EXP), DATE '0001-01-01') &lt;&gt; DATE '2099-12-31'
                THEN 'MISMATCH (EXPECTED 2099-12-31)'
                WHEN x.H_EXP IS NOT NULL AND x.H_EXP &lt; TRUNC(x.SD)
                THEN 'EXPIRY LOST - ALREADY EXPIRED (HUB ' || TO_CHAR(x.H_EXP, 'YYYY-MM-DD') || ')'
                WHEN x.H_EXP_TXT IS NOT NULL AND NVL(x.H_EXP, DATE '0001-01-01') &lt;&gt; DATE '2099-12-31'
                THEN 'MATCH SCRIPT - HUB EXPIRY LOST (HUB ' || SUBSTR(x.H_EXP_TXT, 1, 10) || ')'
           END AS ISS
      FROM PAIRS x
     WHERE x.E_PRFT IS NOT NULL AND x.P_PRFT IS NOT NULL
),
EXPK AS (
    SELECT e.PRFT, NVL(e.KCNO, '#NOCNO#') AS K,
           COUNT(DISTINCT e.CID) AS N_HUB,
           COUNT(*)              AS N_EXP
      FROM EXP e
     GROUP BY e.PRFT, NVL(e.KCNO, '#NOCNO#')
),
DUPS AS (
    -- WRN-007 (απόφαση χρήστη 2026-11-18): ίδιο caution πάνω από μία φορά στον ίδιο πελάτη στο PROFITS.
    --   Σύγκριση HUB vs PROFITS: N_HUB = cautions του HUB (μοναδικά IDNO + CAUTION_NO, D4) για το κλειδί,
    --   N_COPIES = μηνύματα στο PROFITS. Αναμενόμενη τιμή (82000) = N_EXP, μόνο στο ISSUE.
    SELECT p.PRFT, p.KCNO, p.N_COPIES, NVL(k.N_HUB, 0) AS N_HUB, NVL(k.N_EXP, 0) AS N_EXP
      FROM PRF p
      LEFT JOIN EXPK k ON k.PRFT = p.PRFT AND k.K = NVL(p.KCNO, '#NOCNO#')
     WHERE p.COPY_NO = 1
       AND p.N_COPIES &gt; 1
       AND p.N_COPIES &gt; NVL(k.N_HUB, 0)
),
FINDINGS AS (
    -- Μία γραμμή ανά εύρημα. CUSTOMER_CODE = κωδικός HUB του πελάτη (MG_CUSTOMER_INTER), SERIAL_NO = CAUTION_NO.
    -- HUB_VALUE = τιμή όπως είναι στο HUB (CAUTION), NCIS_VALUE = τιμή όπως είναι στο PROFITS (PROFITS_MESSAGE,
    -- δεν υπάρχει NCIS extract). Η αναμενόμενη τιμή (μόνο από το 82000) στο ISSUE.
    --==============================================================
    --WRN-001. Ενεργό caution που δεν βγάζει κανένα μήνυμα: το 82000 (DC5) φορτώνει μόνο cautions με αριθμό
    --         που υπάρχει στο OTHER_ID μεταφερμένου πελάτη. HUB_VALUE = IDNO, CUSTOMER_CODE κενό.
    SELECT
      CAST('WRN-001_CAUTION_NOT_MIGRATED' AS VARCHAR2(50)) AS CHECK_NAME,
      CAST(NULL AS VARCHAR2(40)) AS CUSTOMER_CODE,
      CAST(c.CNO AS VARCHAR2(40)) AS SERIAL_NO,
      CAST(c.IDN AS VARCHAR2(200)) AS HUB_VALUE,
      CAST(NULL AS VARCHAR2(200)) AS NCIS_VALUE,
      CAST(CASE WHEN c.IDN IS NULL THEN 'NOT MIGRATED (IDNO NULL)'
                WHEN NOT EXISTS (SELECT 1 FROM OI o WHERE o.IDN = c.IDN) THEN 'NOT MIGRATED (IDNO NOT IN OTHER_ID)'
                ELSE 'NOT MIGRATED (CUSTOMER NOT MIGRATED)' END AS VARCHAR2(50)) AS ISSUE
    FROM CAU c
    WHERE NOT EXISTS (SELECT 1 FROM EXP e WHERE e.CID = c.CID)
    UNION ALL
    --==============================================================
    --WRN-002. Αναμενόμενο μήνυμα (caution x πελάτης, κατά το 82000) που δεν βρέθηκε στο PROFITS_MESSAGE.
    SELECT 'WRN-002_MESSAGE_MISSING_IN_PROFITS', x.CC, x.CNO,
           SUBSTR(x.FULLTXT, 1, 200), CAST(NULL AS VARCHAR2(200)),
           'MISSING IN PROFITS'
    FROM PAIRS x
    WHERE x.E_PRFT IS NOT NULL AND x.P_PRFT IS NULL
    UNION ALL
    --==============================================================
    --WRN-003. Μήνυμα του 82000 στο PROFITS που δεν αντιστοιχεί σε ενεργό caution του ίδιου πελάτη.
    SELECT 'WRN-003_MESSAGE_EXTRA_IN_PROFITS', m.CC, x.P_KCNO,
           CAST(NULL AS VARCHAR2(200)), SUBSTR(x.P_MSG, 1, 200),
           CASE WHEN x.P_COPY &gt; 1 THEN 'EXTRA IN PROFITS (COPY ' || x.P_COPY || ')' ELSE 'EXTRA IN PROFITS' END
    FROM PAIRS x
    LEFT JOIN MCIR m ON m.PRFT = x.P_PRFT
    WHERE x.P_PRFT IS NOT NULL AND x.E_PRFT IS NULL
    UNION ALL
    --==============================================================
    --WRN-004. Κείμενο μηνύματος: PROFITS ACTUAL_MESSAGE vs SUBSTR(CAUTION_NO || ' // ' || DESCRIPTION, 1, 150).
    --         HUB_VALUE = CAUTION_NO // DESCRIPTION χωρίς περικοπή.
    SELECT 'WRN-004_MESSAGE_TEXT_MISMATCH', x.CC, x.CNO,
           SUBSTR(x.FULLTXT, 1, 200), SUBSTR(x.P_MSG, 1, 200),
           'MISMATCH'
    FROM PAIRS x
    WHERE x.E_PRFT IS NOT NULL AND x.P_PRFT IS NOT NULL
      AND NVL(RTRIM(x.P_MSG), '#') &lt;&gt; NVL(RTRIM(x.E_MSG), '#')
    UNION ALL
    --==============================================================
    --WRN-005. Ημερομηνία δημιουργίας (CREATE_DATE) vs κανόνας του 82000, και απώλεια της ημερομηνίας HUB (W5).
    SELECT 'WRN-005_CREATE_DATE_MISMATCH', w.CC, w.CNO,
           w.ENTRY_DATE, TO_CHAR(w.P_CREATE, 'YYYY-MM-DD'),
           w.ISS
    FROM W5 w
    WHERE w.ISS IS NOT NULL
    UNION ALL
    --==============================================================
    --WRN-006. Ημερομηνία λήξης (EXPIRATION_DATE) vs κανόνας του 82000 (20991231), και απώλεια της λήξης HUB (W6).
    --         HUB_VALUE = EXPIRY_DATE όπως είναι στο HUB, NCIS_VALUE = EXPIRATION_DATE του PROFITS.
    --         (Ήταν WRN-007· το παλιό WRN-006 «διπλά μηνύματα» αφαιρέθηκε 2026-11-18 και ξαναμπήκε ως WRN-007.)
    SELECT 'WRN-006_EXPIRY_DATE_MISMATCH', w.CC, w.CNO,
           w.H_EXP_TXT, TO_CHAR(w.P_EXP, 'YYYY-MM-DD'),
           w.ISS
    FROM W6 w
    WHERE w.ISS IS NOT NULL
    UNION ALL
    --==============================================================
    --WRN-007. Ίδιο caution πάνω από μία φορά στον ίδιο πελάτη στο PROFITS (DUPS), μία γραμμή ανά κλειδί.
    --         HUB_VALUE = πόσα cautions έχει το HUB για το κλειδί, NCIS_VALUE = πόσα μηνύματα έχει το PROFITS.
    --         SERIAL_NO = CAUTION_NO όπως διαβάζεται από το κείμενο του μηνύματος PROFITS.
    --         'MATCH SCRIPT - ...' όταν το PROFITS έχει όσα μηνύματα βγάζει το 82000 (αντίγραφα του join).
    SELECT 'WRN-007_DUPLICATE_MESSAGE_IN_PROFITS', m.CC, d.KCNO,
           TO_CHAR(d.N_HUB), TO_CHAR(d.N_COPIES),
           CASE WHEN d.N_COPIES = d.N_EXP
                THEN 'MATCH SCRIPT - DUPLICATE MESSAGE (EXPECTED ' || d.N_EXP || ')'
                ELSE 'DUPLICATE MESSAGE (EXPECTED ' || d.N_EXP || ')' END
    FROM DUPS d
    LEFT JOIN MCIR m ON m.PRFT = d.PRFT
)
,
POPULATIONS AS (
    SELECT
        (SELECT COUNT(*) FROM CAU)                                                 AS ACT_COUNT,
        (SELECT COUNT(*) FROM EXP)                                                 AS EXP_COUNT,
        (SELECT COUNT(*) FROM PRF)                                                 AS PROF_COUNT,
        (SELECT COUNT(*) FROM PAIRS WHERE E_PRFT IS NOT NULL AND P_PRFT IS NOT NULL) AS MATCHED_COUNT,
        (SELECT COUNT(*) FROM PRF WHERE COPY_NO = 1)                               AS PROF_KEYS_COUNT
    FROM DUAL
),
CHECK_META AS (
    -- CHECK_ID | CHECK_NAME | CATEGORY | DESCRIPTION | POPULATION_TYPE
    SELECT 'WRN-001' AS CHECK_ID, 'WRN-001_CAUTION_NOT_MIGRATED' AS CHECK_NAME, 'EXISTENCE' AS CATEGORY, 'Active HUB cautions that the migration does not load: the ID number is empty, is not held by any customer in PROFITS, or its customer was not migrated.' AS DESCRIPTION, 'ACT' AS POPULATION_TYPE FROM DUAL UNION ALL
    SELECT 'WRN-002', 'WRN-002_MESSAGE_MISSING_IN_PROFITS',   'EXISTENCE',             'Active HUB cautions linked to a migrated customer, for which the expected customer warning message is not in PROFITS.', 'EXP' FROM DUAL UNION ALL
    SELECT 'WRN-003', 'WRN-003_MESSAGE_EXTRA_IN_PROFITS',     'EXISTENCE',             'Migrated caution warning messages in PROFITS that do not match any active HUB caution of the same customer.', 'PROF' FROM DUAL UNION ALL
    SELECT 'WRN-004', 'WRN-004_MESSAGE_TEXT_MISMATCH',        'CROSS_SYSTEM_MISMATCH', 'The warning message text in PROFITS differs from the HUB caution number and description the migration sends (first 150 characters).', 'MATCHED' FROM DUAL UNION ALL
    SELECT 'WRN-005', 'WRN-005_CREATE_DATE_MISMATCH',         'CROSS_SYSTEM_MISMATCH', 'The message creation date in PROFITS differs from the date the migration sends, or matches it while the HUB caution entry date is lost.', 'MATCHED' FROM DUAL UNION ALL
    SELECT 'WRN-006', 'WRN-006_EXPIRY_DATE_MISMATCH',         'CROSS_SYSTEM_MISMATCH', 'The message expiry date in PROFITS differs from the date the migration sends, or matches it while the HUB caution expiry date is lost.', 'MATCHED' FROM DUAL UNION ALL
    SELECT 'WRN-007', 'WRN-007_DUPLICATE_MESSAGE_IN_PROFITS', 'CROSS_SYSTEM_MISMATCH', 'A caution held once in HUB appears more than once as a warning message on the same customer in PROFITS.', 'PROF_KEYS' FROM DUAL
),
FINDINGS_COUNT AS (
    SELECT CHECK_ID, COUNT(*) AS INVALID_COUNT
    FROM (SELECT SUBSTR(CHECK_NAME, 1, INSTR(CHECK_NAME, '_') - 1) AS CHECK_ID FROM FINDINGS)
    GROUP BY CHECK_ID
)
SELECT
    CAST(CM.CHECK_ID AS VARCHAR2(10)) AS CHECK_ID,
    CAST(CM.CHECK_NAME AS VARCHAR2(50)) AS CHECK_NAME,
    CAST(CM.CATEGORY AS VARCHAR2(30)) AS CATEGORY,
    CAST(CM.DESCRIPTION AS VARCHAR2(200)) AS DESCRIPTION,
    (CASE CM.POPULATION_TYPE
        WHEN 'ACT'       THEN P.ACT_COUNT
        WHEN 'EXP'       THEN P.EXP_COUNT
        WHEN 'PROF'      THEN P.PROF_COUNT
        WHEN 'MATCHED'   THEN P.MATCHED_COUNT
        WHEN 'PROF_KEYS' THEN P.PROF_KEYS_COUNT
     END) AS TOTAL_RECORDS,
    (CASE CM.POPULATION_TYPE
        WHEN 'ACT'       THEN P.ACT_COUNT
        WHEN 'EXP'       THEN P.EXP_COUNT
        WHEN 'PROF'      THEN P.PROF_COUNT
        WHEN 'MATCHED'   THEN P.MATCHED_COUNT
        WHEN 'PROF_KEYS' THEN P.PROF_KEYS_COUNT
     END) - NVL(FC.INVALID_COUNT, 0) AS VALID_COUNT,
    NVL(FC.INVALID_COUNT, 0) AS INVALID_COUNT,
    CASE WHEN CM.CATEGORY = 'INFO'           THEN 'INFO'
         WHEN NVL(FC.INVALID_COUNT, 0) = 0   THEN 'PASS'
         ELSE 'FAIL' END AS STATUS,
    'DC5' AS DC_VERSION,
    1 AS RUN_VERSION,  -- TESTING ONLY: στο SSIS αντικαθίσταται από @[User::RunVersion] μέσω Derived Column.
    SYSDATE AS RUN_TIMESTAMP
FROM CHECK_META CM
CROSS JOIN POPULATIONS P
LEFT JOIN FINDINGS_COUNT FC ON FC.CHECK_ID = CM.CHECK_ID
ORDER BY REGEXP_SUBSTR(CM.CHECK_ID, '[A-Z]+'), TO_NUMBER(REGEXP_SUBSTR(CM.CHECK_ID, '[0-9]+'));</property>
