                          length="6"
                          lineageId="Package\Sequence Container\Customer_Relations_Master\Customer_Relations_master.Outputs[Oracle Source Output].Columns[STATUS]"
                          name="STATUS" />
                        <outputColumn
                          refId="Package\Sequence Container\Customer_Relations_Master\Customer_Relations_master.Outputs[Oracle Source Output].Columns[DESCRIPTION]"
                          codePage="1253"
                          dataType="str"
                          externalMetadataColumnId="Package\Sequence Container\Customer_Relations_Master\Customer_Relations_master.Outputs[Oracle Source Output].ExternalColumns[DESCRIPTION]"
                          length="200"
                          lineageId="Package\Sequence Container\Customer_Relations_Master\Customer_Relations_master.Outputs[Oracle Source Output].Columns[DESCRIPTION]"
                          name="DESCRIPTION" />
                        <outputColumn
                          refId="Package\Sequence Container\Customer_Relations_Master\Customer_Relations_master.Outputs[Oracle Source Output].Columns[TOTAL_RECORDS]"
                          dataType="r8"
                          externalMetadataColumnId="Package\Sequence Container\Customer_Relations_Master\Customer_Relations_master.Outputs[Oracle Source Output].ExternalColumns[TOTAL_RECORDS]"
                          lineageId="Package\Sequence Container\Customer_Relations_Master\Customer_Relations_master.Outputs[Oracle Source Output].Columns[TOTAL_RECORDS]"
                          name="TOTAL_RECORDS" />
                        <outputColumn
