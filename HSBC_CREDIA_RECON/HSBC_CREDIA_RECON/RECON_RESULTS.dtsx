        <DTS:Executable
          DTS:refId="Package\Sequence Container\Customer_Addresses_Master"
          DTS:CreationName="Microsoft.Pipeline"
          DTS:Description="Data Flow Task"
          DTS:DTSID="{a2de87e3-020e-4657-9de8-7e79b6d2a2b0}"
          DTS:ExecutableType="Microsoft.Pipeline"
          DTS:LocaleID="-1"
          DTS:ObjectName="Customer_Addresses_Master"
          DTS:TaskContact="Performs high-performance data extraction, transformation and loading;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1">
          <DTS:Variables />
          <DTS:ObjectData>
            <pipeline
              version="1">
              <components>
                <component
                  refId="Package\Sequence Container\Customer_Addresses_Master\Customer_Addresses_master"
                  componentClassID="Microsoft.SSISOracleSrc"
                  contactInfo="Oracle Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;1"
                  description="Oracle Source"
                  name="Customer_Addresses_master"
                  usesDispositions="true"
                  version="1">
                  <properties>
                    <property
                      dataType="System.String"
                      description="The name of the table to be fetched."
                      expressionType="Notify"
                      name="TableName"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      expressionType="Notify"
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">-- ====================================================================
-- CUST_ADDRESS_RECON — MASTER DC5 v3
-- Τροφοδοτεί: RECON.CUST_ADDRESS_MASTER
-- Μία γραμμή ΑΝΑ CHECK_ID — 18 γραμμές ανά run: CA-001 .. CA-018.
--
-- Customer Addresses (ME01_HUB, EIM 240825): HUB SSADDRP vs PROFITS CUST_ADDRESS
-- (= NCIS_Customer_addresses, 02_CUSTOMER_ADDRESSES.sql, scope CUST_TYPE &lt;&gt; 3).
-- Μορφή Master/Detail όπως οι Customers (MasterCustomers_DC5_v2.sql):
--   - ένα αυτοτελές SELECT, χωρίς views και χωρίς HGR_* πίνακες. Το κοινό κομμάτι
--     (CTEs) και το FINDINGS είναι ΙΔΙΑ αυτούσια στο DetailCustomerAddresses_DC5_v3.sql
--     -&gt; INVALID_COUNT = γραμμές του Detail ανά CHECK_ID.
--   - Παράγεται από τον generator (_generator): ca_master_head + ca_common + ca_master_tail.
--   - HUB από τα HUB_MT_* synonyms (DB link @Malta, 10098): κάθε πίνακας ΜΙΑ φορά σε
--     δικό του CTE (R_*), μόνο για την τιμή HUB του Detail.
--
-- ΑΡΧΗ: αναμενόμενη τιμή ΜΟΝΟ από τα scripts της μετάπτωσης (καμία δική μας υπόθεση):
--   - Δευτερεύουσες διευθύνσεις (ADDR_SN &gt; 1): MG_CUST_ADDR_INTER, που τις γράφει το 16000
--     στο CUST_ADDRESS (τύπος, γραμμές 1-4, ZIP, τηλέφωνο, fax, χώρα, flag επικοινωνίας).
--   - Κύρια διεύθυνση (ADDR_SN = 1): τη φτιάχνει ο loader του PROFITS από το
--     MG_CUSTOMER_INTER (τελικές τιμές 12000 + 12010: ADDRESS_TYPE, ADDRESS, ZIP_CODE,
--     TELEPHONE, FAX_NO, ADDRESS_COUNTRY). Γραμμή 2 και κλειδί από το update του 16000
--     (MG_CUST_ADDR_INTER.ADDRESS_2 / ENTRY_COMMENTS). Το flag επικοινωνίας της κύριας
--     δεν το ορίζει κανένα script -&gt; δεν ελέγχεται.
--   - Τηλέφωνο κύριας (CA-014): MG_CUSTOMER_INTER.TELEPHONE_COMMUN (ZBTENO). Επιβεβαιώθηκε
--     2026-11-12: ταιριάζει 100% με το CUST_ADDRESS.TELEPHONE (TELEPHONE: 45%). Οι
--     δευτερεύουσες παίρνουν ZBTEN2 (16000).
--   - Κληρονομημένος κανόνας του DC4 (όχι κανόνας script, σημειώνεται και στο DESCRIPTION):
--     CA-012 - η διεύθυνση 'Company Seat' που φτιάχνει ο loader για κάθε εταιρεία
--     (CUST_TYPE 2, SERIAL_NUM 2, ADDRESS_TYPE 1, χωρίς κλειδί, ίδια γραμμή 1 με την κύρια)
--     είναι αποδεκτή. Το CA-013 (κύρια εταιρειών τύπου 5 αντί 1) μένει εύρημα προς NC.
--   - Χώρα: CNTRY (MG_PARAM_PARAMETER) -&gt; GENERIC_DETAIL, όπως το NCIS extract.
--   - Synthetic πελάτες (SSCAIFP / SS@NCUSP, 12000): MG_CUSTOMER_INTER.
--   - Πληθυσμός: πελάτες loaded (MG_CUSTOMER_INTER ROW_STATUS = 1, PRFT_CUST_ID &gt; 0,
--     CUST_TYPE &lt;&gt; 3). Διευθύνσεις που η μετάπτωση δεν στέλνει (πελάτης που δεν
--     φορτώθηκε, CUST_TYPE 3) δεν είναι εύρημα.
--   - Προεπιλογές του PROFITS που δεν είναι στα scripts (π.χ. 'UNKNOWN' για κενή
--     γραμμή 1) μένουν ως ευρήματα (to be confirmed with NC).
--   - HUB_VALUE = τιμή HUB, NCIS_VALUE = τιμή PROFITS, αναμενόμενη τιμή στο ISSUE.
--
-- ΑΝΤΙΣΤΟΙΧΙΑ με το MasterCustomerAddresses_DC5_v2.sql (CMA-001..021):
--   CMA-001..012 -&gt; CA-001..012 | CMA-015 -&gt; CA-013 | CMA-017 -&gt; CA-014 | CMA-018 -&gt; CA-015
--   CMA-019 -&gt; CA-016 | CMA-020 -&gt; CA-017 | CMA-021 -&gt; CA-018
--   Αφαιρέθηκαν: CMA-013 (INFO, κύριες με κλειδί) και CMA-014 (INFO, PROFITS χωρίς κλειδί):
--   μετρούν μόνο PROFITS, χωρίς πηγή HUB. Οι δευτερεύουσες χωρίς κλειδί είναι πλέον στο
--   CA-012 (NO_RECON_KEY). CMA-016 (γραμμές 3-4 κύριας): η μετάπτωση δεν τις μεταφέρει.
--   Ο ξαναϋπολογισμός joint (10200) / ADDR_SN (10900) του v2 αντικαταστάθηκε από το
--   MG_CUST_ADDR_INTER (καμία δική μας ταξινόμηση).
--
-- STATUS: PASS (INVALID_COUNT = 0) / FAIL. DESCRIPTION: απλή περιγραφή χωρίς κωδικούς.
--
-- TOTAL_RECORDS ανά POPULATION_TYPE:
--   MATCHED_ALL / _PRI / _SEC = διευθύνσεις και στα δύο συστήματα (όλες / κύρια / δευτερεύουσες)
--   CUSTOMERS  = πελάτες με διευθύνσεις στη μετάπτωση ή στο PROFITS (CA-010)
--   MG_ADDR    = διευθύνσεις που στέλνει η μετάπτωση για πελάτες loaded
--   PRF_ROWS   = διευθύνσεις PROFITS με κλειδί, και δευτερεύουσες χωρίς κλειδί
--   SYN_LOADED = synthetic πελάτες loaded
-- ====================================================================
WITH
-- --------------------------------------------------------------------
-- Κοινό κομμάτι (ΙΔΙΟ αυτούσιο στο Master και στο Detail).
--   MCI     = πελάτες που φορτώθηκαν (MG_CUSTOMER_INTER ROW_STATUS = 1, PRFT_CUST_ID &gt; 0),
--             scope NCIS (CUST_TYPE &lt;&gt; 3). Μία γραμμή ανά HUB πελάτη. Τελικές τιμές
--             της κύριας διεύθυνσης όπως τις στέλνει το 12000 (+ 12010).
--   MCIP    = μία γραμμή ανά PRFT_CUST_ID
--   CNM/GDC = MG_PARAM_PARAMETER CNTRY / GENERIC_DETAIL CNTRY (de-dup MIN)
--   R_*     = HUB πίνακες (synonyms σε DB link @Malta): κάθε πίνακας ΜΙΑ φορά,
--             μόνο οι στήλες που χρειάζονται. Χρησιμοποιούνται μόνο για το HUB_VALUE.
--   MGA     = MG_CUST_ADDR_INTER (16000): η τελική τιμή που διάλεξε η μετάπτωση για
--             κάθε διεύθυνση (ADDR_SN 1 = κύρια, &gt;1 = δευτερεύουσες), πελάτες MCI.
--             COPY_NO = αντίγραφο του ίδιου κλειδιού στον ίδιο πελάτη (joint 10200).
--   PRF     = CUST_ADDRESS (πλευρά PROFITS, ίδιες στήλες με το NCIS_Customer_addresses,
--             μαζί με SERIAL_NUM / COMMUNICATION_ADDR που δεν έχει το extract)
--   PAIRS   = MGA vs PRF με κλειδί (PRFT_CUST_ID, ENTRY_COMMENTS 'owner-serial', COPY_NO)
--   B       = matched ζεύγη + τιμή HUB + αναμενόμενη τιμή:
--             κύρια (ADDR_SN = 1): τύπος / γραμμή 1 / ZIP / τηλέφωνο / fax / χώρα από
--             MG_CUSTOMER_INTER, γραμμή 2 από MG_CUST_ADDR_INTER (update του 16000).
--             δευτερεύουσες: όλα από MG_CUST_ADDR_INTER (insert του 16000).
--             flag επικοινωνίας δευτερεύουσας: COMM_ADDR_FLG, και 0 όταν ο πελάτης
--             έχει περισσότερες από μία διευθύνσεις επικοινωνίας (reset του 16000).
--   CN      = πλήθος διευθύνσεων ανά πελάτη, MGA vs PRF με κλειδί
--   SY      = synthetic πελάτες (SSCAIFP / SS@NCUSP) + κύρια διεύθυνση PROFITS
-- --------------------------------------------------------------------
MCI AS (
    SELECT /*+ MATERIALIZE */
        CC, PRFT, CTYPE, FILE_NAME, M_ATYPE, M_ADDR, M_ZIP, M_TELC, M_FAX, M_CNTRY
    FROM (
        SELECT TRIM(CUSTOMER_CODE)                AS CC,
               PRFT_CUST_ID                       AS PRFT,
               TRIM(TO_CHAR(CUST_TYPE))           AS CTYPE,
               TRIM(FILE_NAME)                    AS FILE_NAME,
               TRIM(TO_CHAR(ADDRESS_TYPE))        AS M_ATYPE,
               TRIM(ADDRESS)                      AS M_ADDR,
               TRIM(ZIP_CODE)                     AS M_ZIP,
               -- τηλέφωνο κύριας: ο loader παίρνει το TELEPHONE_COMMUN (ZBTENO, 12000) - ταιριάζει
               -- 100% με το CUST_ADDRESS.TELEPHONE (επιβεβαίωση 2026-11-12, 208.671 / 208.671)
               TRIM(TELEPHONE_COMMUN)             AS M_TELC,
               TRIM(FAX_NO)                       AS M_FAX,
               TRIM(ADDRESS_COUNTRY)              AS M_CNTRY,
               ROW_NUMBER() OVER (PARTITION BY TRIM(CUSTOMER_CODE) ORDER BY PRFT_CUST_ID) AS RN
          FROM MG_CUSTOMER_INTER
         WHERE ROW_STATUS = 1
           AND PRFT_CUST_ID &gt; 0
           AND TRIM(TO_CHAR(CUST_TYPE)) &lt;&gt; '3'
    )
    WHERE RN = 1
),
MCIP AS (
    SELECT /*+ MATERIALIZE */ PRFT, MIN(CC) AS CC, MIN(CTYPE) AS CTYPE FROM MCI GROUP BY PRFT
),
CNM AS (
    SELECT /*+ MATERIALIZE */ TRIM(OLD_VALUE) AS OLD_VALUE, MIN(NEW_VALUE) AS NEW_VALUE
      FROM MG_PARAM_PARAMETER
     WHERE PARAMETER_TYPE = 'CNTRY'
     GROUP BY TRIM(OLD_VALUE)
),
GDC AS (
    SELECT /*+ MATERIALIZE */ SERIAL_NUM, MIN(TRIM(DESCRIPTION)) AS DESCRIPTION
      FROM GENERIC_DETAIL
     WHERE FK_GENERIC_HEADPAR = 'CNTRY'
     GROUP BY SERIAL_NUM
),
R_ADDRP AS (
    -- κλειδί όπως το ENTRY_COMMENTS του 10900: customer_code || '-' || SERIAL_NO
    SELECT /*+ MATERIALIZE */
        TRIM(customer_code || '-' || TRIM(CAST(SERIAL_NO AS CHAR(50)))) AS AKEY,
        ZBADID, ZBNAD2, ZBNAD3, ZBNAD4, ZBNAD5, ZBPSCD, ZBADCE, ZBTENO, ZBTEN2, ZBFAXN
    FROM HUB_MT_SSADDRP
),
R_CUSTP AS (
    SELECT /*+ MATERIALIZE */ TRIM(customer_code) AS CC, ZGGHCL
    FROM HUB_MT_SSCUSTP
),
R_GHCLP AS (
    SELECT /*+ MATERIALIZE */ TRIM(VQGHCL) AS VQGHCL, VQCSTY
    FROM HUB_MT_SSGHCLP
),
R_ICADP AS (
    SELECT /*+ MATERIALIZE */ TRIM(customer_code) AS CC, ZYADR1, ZYADR2
    FROM HUB_MT_SSICADP
),
R_CAIFP AS (
    SELECT /*+ MATERIALIZE */ SERIAL_NUMBER, ZUCSTY, ZUN2D2, ZUN2D3, ZUADCE
    FROM HUB_MT_SSCAIFP
    WHERE customer_code2 = '0000000'
),
R_NCUSP AS (
    SELECT /*+ MATERIALIZE */ TRIM(customer_code) AS CC, ZWPFCM, ZWN2D2, ZWN2D3, ZWCTRS
    FROM HUB_MT_SSNCUSP
),
MGA AS (
    SELECT /*+ MATERIALIZE */
        m.CC, m.PRFT, a.ADDR_SN,
        TRIM(a.ENTRY_COMMENTS)                  AS AKEY,
        TRIM(TO_CHAR(a.ADDRESS_TYPE))           AS E_ATYPE,
        TRIM(TO_CHAR(a.COMM_ADDR_FLG))          AS E_COMM,
        TRIM(a.ADDRESS_1)                       AS E_L1,
        TRIM(a.ADDRESS_2)                       AS E_L2,
        TRIM(a.ADDRESS_3)                       AS E_L3,
        TRIM(a.ADDRESS_4)                       AS E_L4,
        TRIM(a.ZIP_CODE)                        AS E_ZIP,
        TRIM(a.TELEPHONE)                       AS E_TEL,
        TRIM(a.FAX_NO)                          AS E_FAX,
        TRIM(a.COUNTRY)                         AS E_CNTRY,
        ROW_NUMBER() OVER (PARTITION BY m.PRFT, TRIM(a.ENTRY_COMMENTS) ORDER BY a.ADDR_SN) AS COPY_NO
    FROM MG_CUST_ADDR_INTER a
    JOIN MCI m ON m.CC = TRIM(a.CUSTOMER_CODE)
),
PRF AS (
    SELECT /*+ MATERIALIZE */
        ca.FK_CUSTOMERCUST_ID                   AS PRFT,
        mp.CC                                   AS CC,
        mp.CTYPE                                AS CTYPE,
        ca.SERIAL_NUM,
        TRIM(ca.ENTRY_COMMENTS)                 AS AKEY,
        TRIM(TO_CHAR(ca.ADDRESS_TYPE))          AS P_ATYPE,
        TRIM(ca.ADDRESS_1)                      AS P_L1,
        TRIM(ca.ADDRESS_2)                      AS P_L2,
        TRIM(ca.ADDRESS_3)                      AS P_L3,
        TRIM(ca.ADDRESS_4)                      AS P_L4,
        TRIM(ca.ZIP_CODE)                       AS P_ZIP,
        gd.DESCRIPTION                          AS P_CNTRY,
        TRIM(ca.TELEPHONE)                      AS P_TEL,
        TRIM(ca.FAX_NO)                         AS P_FAX,
        TRIM(TO_CHAR(ca.COMMUNICATION_ADDR))    AS P_COMM,
        ROW_NUMBER() OVER (PARTITION BY ca.FK_CUSTOMERCUST_ID, TRIM(ca.ENTRY_COMMENTS) ORDER BY ca.SERIAL_NUM) AS COPY_NO
    FROM CUST_ADDRESS ca
    JOIN MCIP mp ON mp.PRFT = ca.FK_CUSTOMERCUST_ID
    LEFT JOIN GDC gd ON TRIM(ca.FKGH_HAS_COUNTRY) = 'CNTRY' AND gd.SERIAL_NUM = ca.FKGD_HAS_COUNTRY
),
PRI_COMM AS (
    SELECT /*+ MATERIALIZE */ PRFT, MAX(P_COMM) AS P_COMM FROM PRF WHERE SERIAL_NUM = 1 GROUP BY PRFT
),
SEC_COMM AS (
    SELECT /*+ MATERIALIZE */ PRFT, SUM(CASE WHEN E_COMM = '1' THEN 1 ELSE 0 END) AS N_COMM
    FROM MGA WHERE ADDR_SN &gt; 1 GROUP BY PRFT
),
PAIRS AS (
    SELECT /*+ MATERIALIZE */
        CASE WHEN g.AKEY IS NOT NULL AND p.AKEY IS NOT NULL THEN 'MATCHED'
             WHEN p.AKEY IS NULL THEN 'MISSING_IN_PROFITS'
             ELSE 'MISSING_IN_HUB' END                          AS MS,
        g.CC AS G_CC, g.PRFT AS G_PRFT, g.ADDR_SN, g.AKEY AS G_AKEY, g.COPY_NO AS G_COPY,
        g.E_ATYPE, g.E_COMM, g.E_L1, g.E_L2, g.E_L3, g.E_L4, g.E_ZIP, g.E_TEL, g.E_FAX, g.E_CNTRY,
        p.CC AS P_CC, p.PRFT AS P_PRFT, p.SERIAL_NUM, p.AKEY AS P_AKEY, p.COPY_NO AS P_COPY,
        p.P_ATYPE, p.P_L1, p.P_L2, p.P_L3, p.P_L4, p.P_ZIP, p.P_CNTRY, p.P_TEL, p.P_FAX, p.P_COMM
    FROM MGA g
    FULL OUTER JOIN (SELECT * FROM PRF WHERE AKEY IS NOT NULL) p
      ON p.PRFT    = g.PRFT
     AND p.AKEY    = g.AKEY
     AND p.COPY_NO = g.COPY_NO
),
B AS (
    SELECT /*+ MATERIALIZE */
        x.*,
        CASE WHEN x.ADDR_SN = 1 THEN 1 ELSE 0 END                AS IS_PRI,
        a.ZBADID, a.ZBNAD2, a.ZBNAD3, a.ZBNAD4, a.ZBNAD5, a.ZBPSCD, a.ZBADCE, a.ZBTENO, a.ZBTEN2, a.ZBFAXN,
        gh.VQCSTY, ic.ZYADR1, ic.ZYADR2,
        m.M_ATYPE, m.M_TELC, m.M_FAX,
        CASE WHEN x.ADDR_SN = 1 THEN m.M_ADDR  ELSE x.E_L1    END AS X_L1,
        CASE WHEN x.ADDR_SN = 1 THEN m.M_ZIP   ELSE x.E_ZIP   END AS X_ZIP,
        CASE WHEN x.ADDR_SN = 1 THEN m.M_CNTRY ELSE x.E_CNTRY END AS X_CNTRY,
        gd.DESCRIPTION                                            AS X_CNTRY_DESC,
        CASE WHEN x.E_COMM = '1' AND (NVL(pc.P_COMM, '0') = '1' OR NVL(sc.N_COMM, 0) &gt; 1) THEN '0'
             ELSE x.E_COMM END                                    AS X_COMM
    FROM PAIRS x
    LEFT JOIN R_ADDRP a   ON a.AKEY = x.G_AKEY
    LEFT JOIN MCI m       ON m.CC = x.G_CC
    LEFT JOIN R_CUSTP c   ON c.CC = x.G_CC
    LEFT JOIN R_GHCLP gh  ON gh.VQGHCL = TRIM(c.ZGGHCL)
    LEFT JOIN R_ICADP ic  ON ic.CC = x.G_CC
    LEFT JOIN CNM cn      ON cn.OLD_VALUE = CASE WHEN x.ADDR_SN = 1 THEN m.M_CNTRY ELSE x.E_CNTRY END
    LEFT JOIN GDC gd      ON gd.SERIAL_NUM = cn.NEW_VALUE
    LEFT JOIN PRI_COMM pc ON pc.PRFT = x.G_PRFT
    LEFT JOIN SEC_COMM sc ON sc.PRFT = x.G_PRFT
    WHERE x.MS = 'MATCHED'
),
CN AS (
    SELECT /*+ MATERIALIZE */ NVL(h.PRFT, p.PRFT) AS PRFT, NVL(h.CC, p.CC) AS CC, h.C AS HUB_C, p.C AS PRF_C
      FROM (SELECT PRFT, MIN(CC) AS CC, COUNT(*) AS C FROM MGA GROUP BY PRFT) h
      FULL OUTER JOIN
           (SELECT PRFT, MIN(CC) AS CC, COUNT(*) AS C FROM PRF WHERE AKEY IS NOT NULL GROUP BY PRFT) p
        ON p.PRFT = h.PRFT
),
SY AS (
    SELECT /*+ MATERIALIZE */
        m.CC, m.PRFT, m.FILE_NAME, m.M_ATYPE, m.M_ADDR, m.M_CNTRY,
        gd.DESCRIPTION                                            AS X_CNTRY_DESC,
        CASE WHEN m.FILE_NAME = 'SSCAIFPCustomersNotInSSCUSTP'
             THEN 'ZUCSTY=' || TRIM(s.ZUCSTY) || '; ZUADCE=' || TRIM(s.ZUADCE)
             ELSE 'ZWPFCM=' || TRIM(n.ZWPFCM) || '; ZWCTRS=' || TRIM(n.ZWCTRS) END AS H_TYPE_CNTRY,
        CASE WHEN m.FILE_NAME = 'SSCAIFPCustomersNotInSSCUSTP'
             THEN TRIM(s.ZUN2D2) || TRIM(s.ZUN2D3)
             ELSE TRIM(n.ZWN2D2) || TRIM(n.ZWN2D3) END            AS H_LINE1,
        -- ένα πεδίο HUB ανά τιμή (για το DIFF_QUERY): τύπος πελάτη και χώρα
        CASE WHEN m.FILE_NAME = 'SSCAIFPCustomersNotInSSCUSTP' THEN TRIM(s.ZUCSTY) ELSE TRIM(n.ZWPFCM) END AS H_TYPE,
        CASE WHEN m.FILE_NAME = 'SSCAIFPCustomersNotInSSCUSTP' THEN TRIM(s.ZUADCE) ELSE TRIM(n.ZWCTRS) END AS H_CNTRY,
        p.SERIAL_NUM AS P_SN, p.P_ATYPE, p.P_L1, p.P_CNTRY
    FROM MCI m
    LEFT JOIN R_CAIFP s ON m.FILE_NAME = 'SSCAIFPCustomersNotInSSCUSTP'
                       AND m.CC = 'SSCAIFP-' || TO_CHAR(TRIM(s.SERIAL_NUMBER))
    LEFT JOIN R_NCUSP n ON m.FILE_NAME = 'SS@NCUSPCustomersNotInSSCUSTP'
                       AND n.CC = m.CC
    LEFT JOIN (SELECT * FROM PRF WHERE SERIAL_NUM = 1) p ON p.PRFT = m.PRFT
    LEFT JOIN CNM cn ON cn.OLD_VALUE = m.M_CNTRY
    LEFT JOIN GDC gd ON gd.SERIAL_NUM = cn.NEW_VALUE
    WHERE m.FILE_NAME IN ('SSCAIFPCustomersNotInSSCUSTP', 'SS@NCUSPCustomersNotInSSCUSTP')
),
FINDINGS AS (
    -- Μία γραμμή ανά εύρημα. CUSTOMER_CODE = HUB πελάτης (μετά το joint redirect, synthetic
    -- 'SSCAIFP-&lt;serial&gt;'), SERIAL_NO = κλειδί διεύθυνσης (ENTRY_COMMENTS 'owner-serial').
    -- HUB_VALUE = τιμή όπως είναι στον HUB πίνακα, NCIS_VALUE = τιμή του CUST_ADDRESS
    -- (= NCIS_Customer_addresses). Η αναμενόμενη τιμή (μόνο από τα scripts) στο ISSUE.
    --==============================================================
    --CA-001. Τύπος δευτερεύουσας διεύθυνσης vs MG_CUST_ADDR_INTER.ADDRESS_TYPE (10900 / 16000)
    SELECT
      CAST('CA-001_SEC_ADDRESS_TYPE_MISMATCH' AS VARCHAR2(50)) AS CHECK_NAME,
      CAST(G_CC AS VARCHAR2(40)) AS CUSTOMER_CODE, CAST(G_AKEY AS VARCHAR2(40)) AS SERIAL_NO,
      CAST('VQCSTY=' || TRIM(VQCSTY) || '; ZBADID=' || TRIM(ZBADID) || '; ZYADR1=' || TRIM(ZYADR1) || '; ZYADR2=' || TRIM(ZYADR2) AS VARCHAR2(200)) AS HUB_VALUE,
      CAST(P_ATYPE AS VARCHAR2(200)) AS NCIS_VALUE,
      CAST('MISMATCH (EXPECTED ' || NVL(E_ATYPE, 'EMPTY') || ')' AS VARCHAR2(50)) AS ISSUE
    FROM B
    WHERE IS_PRI = 0
      AND NVL(P_ATYPE, 'X') &lt;&gt; NVL(E_ATYPE, 'X')
    UNION ALL
    --==============================================================
    --CA-002. Γραμμή 1 (CUST_ADDRESS.ADDRESS_1 = NCIS Address_2) vs ZBNAD2.
    --        Αναμενόμενο: κύρια MG_CUSTOMER_INTER.ADDRESS, δευτερεύουσα MG_CUST_ADDR_INTER.ADDRESS_1
    SELECT 'CA-002_ADDRESS_LINE1_MISMATCH', G_CC, G_AKEY, TRIM(ZBNAD2), P_L1,
           CASE WHEN X_L1 IS NULL THEN 'MISMATCH (EXPECTED EMPTY)' ELSE 'MISMATCH' END
    FROM B
    WHERE NVL(P_L1, 'X') &lt;&gt; NVL(X_L1, 'X')
    UNION ALL
    --==============================================================
    --CA-003. Γραμμή 2 (ADDRESS_2 = NCIS Address_3) vs ZBNAD3. Αναμενόμενο MG_CUST_ADDR_INTER.ADDRESS_2
    --        (κύρια: update του 16000, δευτερεύουσα: insert του 16000)
    SELECT 'CA-003_ADDRESS_LINE2_MISMATCH', G_CC, G_AKEY, TRIM(ZBNAD3), P_L2,
           CASE WHEN E_L2 IS NULL THEN 'MISMATCH (EXPECTED EMPTY)' ELSE 'MISMATCH' END
    FROM B
    WHERE NVL(P_L2, 'X') &lt;&gt; NVL(E_L2, 'X')
    UNION ALL
    --==============================================================
    --CA-004. Γραμμή 3 δευτερεύουσας (ADDRESS_3 = NCIS Address_4) vs ZBNAD4. Αναμενόμενο ADDRESS_3 (16000)
    SELECT 'CA-004_SEC_ADDRESS_LINE3_MISMATCH', G_CC, G_AKEY, TRIM(ZBNAD4), P_L3,
           CASE WHEN E_L3 IS NULL THEN 'MISMATCH (EXPECTED EMPTY)' ELSE 'MISMATCH' END
    FROM B
    WHERE IS_PRI = 0
      AND NVL(P_L3, 'X') &lt;&gt; NVL(E_L3, 'X')
    UNION ALL
    --==============================================================
    --CA-005. Γραμμή 4 δευτερεύουσας (ADDRESS_4 = NCIS Address_5) vs ZBNAD5. Αναμενόμενο ADDRESS_4 (16000)
    SELECT 'CA-005_SEC_ADDRESS_LINE4_MISMATCH', G_CC, G_AKEY, TRIM(ZBNAD5), P_L4,
           CASE WHEN E_L4 IS NULL THEN 'MISMATCH (EXPECTED EMPTY)' ELSE 'MISMATCH' END
    FROM B
    WHERE IS_PRI = 0
      AND NVL(P_L4, 'X') &lt;&gt; NVL(E_L4, 'X')
    UNION ALL
    --==============================================================
    --CA-006. ZIP vs ZBPSCD. Αναμενόμενο: κύρια MG_CUSTOMER_INTER.ZIP_CODE, δευτερεύουσα MG_CUST_ADDR_INTER.ZIP_CODE
    SELECT 'CA-006_ZIP_CODE_MISMATCH', G_CC, G_AKEY, TRIM(ZBPSCD), P_ZIP,
           CASE WHEN X_ZIP IS NULL THEN 'MISMATCH (EXPECTED EMPTY)' ELSE SUBSTR('MISMATCH (EXPECTED ' || X_ZIP || ')', 1, 50) END
    FROM B
    WHERE NVL(P_ZIP, 'X') &lt;&gt; NVL(X_ZIP, 'X')
    UNION ALL
    --==============================================================
    --CA-007. Χώρα vs ZBADCE. Αναμενόμενο: κύρια MG_CUSTOMER_INTER.ADDRESS_COUNTRY, δευτερεύουσα
    --        MG_CUST_ADDR_INTER.COUNTRY (ZZ για κενό 10900, MT χωρίς mapping 16000), CNTRY -&gt; GENERIC_DETAIL
    SELECT 'CA-007_COUNTRY_MISMATCH', G_CC, G_AKEY, TRIM(ZBADCE), TRIM(P_CNTRY),
           CASE WHEN X_CNTRY IS NOT NULL AND X_CNTRY_DESC IS NULL THEN 'NO_MAPPING (SENT ' || X_CNTRY || ')'
                WHEN X_CNTRY_DESC IS NULL THEN 'MISMATCH (EXPECTED EMPTY)'
                ELSE SUBSTR('MISMATCH (EXPECTED ' || X_CNTRY_DESC || ')', 1, 50) END
    FROM B
    WHERE NVL(TRIM(P_CNTRY), 'X') &lt;&gt; NVL(X_CNTRY_DESC, 'X')
    UNION ALL
    --==============================================================
    --CA-008. Τηλέφωνο δευτερεύουσας vs ZBTEN2. Αναμενόμενο MG_CUST_ADDR_INTER.TELEPHONE (15 χαρ., 16000)
    SELECT 'CA-008_SEC_TELEPHONE_MISMATCH', G_CC, G_AKEY, TRIM(ZBTEN2), P_TEL,
           CASE WHEN E_TEL IS NULL THEN 'MISMATCH (EXPECTED EMPTY)' ELSE SUBSTR('MISMATCH (EXPECTED ' || E_TEL || ')', 1, 50) END
    FROM B
    WHERE IS_PRI = 0
      AND NVL(P_TEL, 'X') &lt;&gt; NVL(E_TEL, 'X')
    UNION ALL
    --==============================================================
    --CA-009. Fax δευτερεύουσας vs ZBFAXN. Αναμενόμενο MG_CUST_ADDR_INTER.FAX_NO (15 χαρ., 16000)
    SELECT 'CA-009_SEC_FAX_NUMBER_MISMATCH', G_CC, G_AKEY, TRIM(ZBFAXN), P_FAX,
           CASE WHEN E_FAX IS NULL THEN 'MISMATCH (EXPECTED EMPTY)' ELSE SUBSTR('MISMATCH (EXPECTED ' || E_FAX || ')', 1, 50) END
    FROM B
    WHERE IS_PRI = 0
      AND NVL(P_FAX, 'X') &lt;&gt; NVL(E_FAX, 'X')
    UNION ALL
    --==============================================================
    --CA-010. Πλήθος διευθύνσεων ανά πελάτη: MG_CUST_ADDR_INTER (= γραμμές SSADDRP του πελάτη μετά το
    --        joint redirect) vs CUST_ADDRESS με κλειδί. Μία γραμμή ανά πελάτη
    SELECT 'CA-010_ADDRESS_COUNT_PER_CUSTOMER_MISMATCH', CC, CAST(NULL AS VARCHAR2(40)),
           TO_CHAR(NVL(HUB_C, 0)), TO_CHAR(NVL(PRF_C, 0)),
           CASE WHEN PRF_C IS NULL THEN 'ADDRESSES_IN_HUB_ONLY'
                WHEN HUB_C IS NULL THEN 'ADDRESSES_IN_PROFITS_ONLY'
                ELSE 'COUNT_DIFFERS (EXPECTED ' || TO_CHAR(HUB_C) || ')' END
    FROM CN
    WHERE NVL(HUB_C, 0) &lt;&gt; NVL(PRF_C, 0)
    UNION ALL
    --==============================================================
    --CA-011. Διεύθυνση που στέλνει η μετάπτωση (MG_CUST_ADDR_INTER, πελάτης loaded) χωρίς γραμμή στο CUST_ADDRESS
    SELECT 'CA-011_ADDRESS_MISSING_IN_PROFITS', x.G_CC, x.G_AKEY, TRIM(a.ZBNAD2), CAST(NULL AS VARCHAR2(200)),
           CASE WHEN x.ADDR_SN = 1 THEN 'PRIMARY_NOT_KEYED_BY_16000'
                WHEN x.G_COPY &gt; 1  THEN 'EXTRA_COPY_SAME_CUSTOMER (ADDR_SN ' || TO_CHAR(x.ADDR_SN) || ')'
                ELSE 'SECONDARY_NOT_INSERTED (ADDR_SN ' || TO_CHAR(x.ADDR_SN) || ')' END
    FROM PAIRS x
    LEFT JOIN R_ADDRP a ON a.AKEY = x.G_AKEY
    WHERE x.MS = 'MISSING_IN_PROFITS'
    UNION ALL
    --==============================================================
    --CA-012. Διεύθυνση στο CUST_ADDRESS που δεν τη στέλνει η μετάπτωση: κλειδί που δεν υπάρχει στο
    --        MG_CUST_ADDR_INTER, ή δευτερεύουσα (SERIAL_NUM &gt; 1) χωρίς κλειδί.
    --        Αποδεκτή (εξηγήθηκε στο DC4, όχι κανόνας script): η διεύθυνση 'Company Seat' που φτιάχνει
    --        ο loader για κάθε εταιρεία (CUST_TYPE 2, SERIAL_NUM 2, ADDRESS_TYPE 1, χωρίς κλειδί)
    SELECT 'CA-012_ADDRESS_MISSING_IN_HUB', P_CC, P_AKEY, CAST(NULL AS VARCHAR2(200)), P_L1,
           CASE WHEN P_COPY &gt; 1 THEN 'EXTRA_COPY_SAME_CUSTOMER (SERIAL_NUM ' || TO_CHAR(SERIAL_NUM) || ')'
                ELSE 'KEY_NOT_IN_MIGRATION (SERIAL_NUM ' || TO_CHAR(SERIAL_NUM) || ')' END
    FROM PAIRS
    WHERE MS = 'MISSING_IN_HUB'
    UNION ALL
    SELECT 'CA-012_ADDRESS_MISSING_IN_HUB', CC, CAST(NULL AS VARCHAR2(40)), CAST(NULL AS VARCHAR2(200)), P_L1,
           'NO_RECON_KEY (SERIAL_NUM ' || TO_CHAR(SERIAL_NUM) || ')'
    FROM PRF
    WHERE AKEY IS NULL
      AND SERIAL_NUM &gt; 1
      AND NOT (CTYPE = '2' AND SERIAL_NUM = 2 AND NVL(P_ATYPE, 'X') = '1')
    UNION ALL
    --==============================================================
    --CA-013. Τύπος κύριας διεύθυνσης vs MG_CUSTOMER_INTER.ADDRESS_TYPE (12000: I -&gt; 2, N -&gt; 1)
    SELECT 'CA-013_PRI_ADDRESS_TYPE_MISMATCH', G_CC, G_AKEY, 'VQCSTY=' || TRIM(VQCSTY), P_ATYPE,
           'MISMATCH (EXPECTED ' || NVL(M_ATYPE, 'EMPTY') || ')'
    FROM B
    WHERE IS_PRI = 1
      AND NVL(P_ATYPE, 'X') &lt;&gt; NVL(M_ATYPE, 'X')
    UNION ALL
    --==============================================================
    --CA-014. Τηλέφωνο κύριας vs ZBTENO. Αναμενόμενο MG_CUSTOMER_INTER.TELEPHONE_COMMUN (12000: 15 χαρ.,
    --        JH / J/H -&gt; κενό). Οι δευτερεύουσες παίρνουν ZBTEN2 (16000, CA-008)
    SELECT 'CA-014_PRI_TELEPHONE_MISMATCH', G_CC, G_AKEY, TRIM(ZBTENO), P_TEL,
           CASE WHEN M_TELC IS NULL THEN 'MISMATCH (EXPECTED EMPTY)' ELSE SUBSTR('MISMATCH (EXPECTED ' || M_TELC || ')', 1, 50) END
    FROM B
    WHERE IS_PRI = 1
      AND NVL(P_TEL, 'X') &lt;&gt; NVL(M_TELC, 'X')
    UNION ALL
    --==============================================================
    --CA-015. Fax κύριας vs ZBFAXN. Αναμενόμενο MG_CUSTOMER_INTER.FAX_NO (12000: + αφαιρείται, JH / J/H / - -&gt; κενό)
    SELECT 'CA-015_PRI_FAX_NUMBER_MISMATCH', G_CC, G_AKEY, TRIM(ZBFAXN), P_FAX,
           CASE WHEN M_FAX IS NULL THEN 'MISMATCH (EXPECTED EMPTY)' ELSE SUBSTR('MISMATCH (EXPECTED ' || M_FAX || ')', 1, 50) END
    FROM B
    WHERE IS_PRI = 1
      AND NVL(P_FAX, 'X') &lt;&gt; NVL(M_FAX, 'X')
    UNION ALL
    --==============================================================
    --CA-016. Flag επικοινωνίας δευτερεύουσας vs MG_CUST_ADDR_INTER.COMM_ADDR_FLG (10900), 0 όταν ο πελάτης
    --        έχει περισσότερες από μία διευθύνσεις επικοινωνίας (reset του 16000). Η κύρια δεν ελέγχεται:
    --        κανένα script δεν ορίζει το flag της.
    SELECT 'CA-016_COMMUNICATION_ADDR_MISMATCH', G_CC, G_AKEY, 'ZBADID=' || TRIM(ZBADID), P_COMM,
           'MISMATCH (EXPECTED ' || NVL(X_COMM, 'EMPTY') || ')'
    FROM B
    WHERE IS_PRI = 0
      AND NVL(P_COMM, '0') &lt;&gt; NVL(X_COMM, '0')
    UNION ALL
    --==============================================================
    --CA-017. Synthetic πελάτης (SSCAIFP / SS@NCUSP): κύρια διεύθυνση vs MG_CUSTOMER_INTER (12000):
    --        τύπος (ADDRESS_TYPE), γραμμή 1 (ADDRESS), χώρα (ADDRESS_COUNTRY -&gt; CNTRY). Μία γραμμή ανά πελάτη
    SELECT 'CA-017_SYNTHETIC_CUST_ADDRESS_MISMATCH', CC, CAST(NULL AS VARCHAR2(40)),
           SUBSTR(H_TYPE_CNTRY || '; LINE1=' || H_LINE1, 1, 200),
           SUBSTR('TYPE=' || P_ATYPE || '; LINE1=' || P_L1 || '; COUNTRY=' || TRIM(P_CNTRY), 1, 200),
           'MISMATCH:' || RTRIM(
               CASE WHEN NVL(P_ATYPE, 'X') &lt;&gt; NVL(M_ATYPE, 'X') THEN 'TYPE,' END
            || CASE WHEN NVL(P_L1, 'X') &lt;&gt; NVL(M_ADDR, 'X') THEN 'LINE1,' END
            || CASE WHEN NVL(TRIM(P_CNTRY), 'X') &lt;&gt; NVL(X_CNTRY_DESC, 'X') THEN 'COUNTRY,' END, ',')
    FROM SY
    WHERE P_SN IS NOT NULL
      AND (NVL(P_ATYPE, 'X') &lt;&gt; NVL(M_ATYPE, 'X')
        OR NVL(P_L1, 'X') &lt;&gt; NVL(M_ADDR, 'X')
        OR NVL(TRIM(P_CNTRY), 'X') &lt;&gt; NVL(X_CNTRY_DESC, 'X'))
    UNION ALL
    --==============================================================
    --CA-018. Synthetic πελάτης που φορτώθηκε χωρίς κύρια διεύθυνση (SERIAL_NUM = 1) στο CUST_ADDRESS
    SELECT 'CA-018_SYNTHETIC_CUST_NO_PRIMARY_ADDRESS', CC, CAST(NULL AS VARCHAR2(40)),
           SUBSTR(H_TYPE_CNTRY || '; LINE1=' || H_LINE1, 1, 200), CAST(NULL AS VARCHAR2(200)),
           'MISSING_PRIMARY_IN_PROFITS (PRFT_CUST_ID ' || TO_CHAR(PRFT) || ')'
    FROM SY
    WHERE P_SN IS NULL
)
,
POPULATIONS AS (
    SELECT
        (SELECT COUNT(*) FROM B)                                                   AS MATCHED_ALL_COUNT,
        (SELECT COUNT(*) FROM B WHERE IS_PRI = 1)                                  AS MATCHED_PRI_COUNT,
        (SELECT COUNT(*) FROM B WHERE IS_PRI = 0)                                  AS MATCHED_SEC_COUNT,
        (SELECT COUNT(*) FROM CN)                                                  AS CUSTOMERS_COUNT,
        (SELECT COUNT(*) FROM MGA)                                                 AS MG_ADDR_COUNT,
        (SELECT COUNT(*) FROM PRF
          WHERE AKEY IS NOT NULL
             OR (SERIAL_NUM &gt; 1 AND NOT (CTYPE = '2' AND SERIAL_NUM = 2 AND NVL(P_ATYPE, 'X') = '1'))) AS PRF_ROWS_COUNT,
        (SELECT COUNT(*) FROM SY)                                                  AS SYN_LOADED_COUNT
    FROM DUAL
),
CHECK_META AS (
    -- CHECK_ID | CHECK_NAME | CATEGORY | DESCRIPTION | POPULATION_TYPE
    SELECT 'CA-001' AS CHECK_ID, 'CA-001_SEC_ADDRESS_TYPE_MISMATCH' AS CHECK_NAME, 'CROSS_SYSTEM_MISMATCH' AS CATEGORY, 'Other (non-main) addresses: the address type in PROFITS is not the type the migration set from the HUB customer type and address labels.' AS DESCRIPTION, 'MATCHED_SEC' AS POPULATION_TYPE FROM DUAL UNION ALL
    SELECT 'CA-002', 'CA-002_ADDRESS_LINE1_MISMATCH',               'CROSS_SYSTEM_MISMATCH', 'Address line 1 in PROFITS differs from the line the migration sent from HUB (extra spaces removed). Checked on every address found in both systems.', 'MATCHED_ALL' FROM DUAL UNION ALL
    SELECT 'CA-003', 'CA-003_ADDRESS_LINE2_MISMATCH',               'CROSS_SYSTEM_MISMATCH', 'Address line 2 in PROFITS differs from the line the migration sent from HUB. Checked on every address found in both systems.', 'MATCHED_ALL' FROM DUAL UNION ALL
    SELECT 'CA-004', 'CA-004_SEC_ADDRESS_LINE3_MISMATCH',           'CROSS_SYSTEM_MISMATCH', 'Other (non-main) addresses: address line 3 in PROFITS differs from the line the migration sent from HUB.', 'MATCHED_SEC' FROM DUAL UNION ALL
    SELECT 'CA-005', 'CA-005_SEC_ADDRESS_LINE4_MISMATCH',           'CROSS_SYSTEM_MISMATCH', 'Other (non-main) addresses: address line 4 in PROFITS differs from the line the migration sent from HUB.', 'MATCHED_SEC' FROM DUAL UNION ALL
    SELECT 'CA-006', 'CA-006_ZIP_CODE_MISMATCH',                    'CROSS_SYSTEM_MISMATCH', 'Postal code in PROFITS differs from the postal code the migration sent from HUB. Checked on every address found in both systems.', 'MATCHED_ALL' FROM DUAL UNION ALL
    SELECT 'CA-007', 'CA-007_COUNTRY_MISMATCH',                     'CROSS_SYSTEM_MISMATCH', 'Country in PROFITS differs from the country the migration sent from HUB, translated to its PROFITS name.', 'MATCHED_ALL' FROM DUAL UNION ALL
    SELECT 'CA-008', 'CA-008_SEC_TELEPHONE_MISMATCH',               'CROSS_SYSTEM_MISMATCH', 'Other (non-main) addresses: the telephone in PROFITS differs from the telephone the migration sent from HUB (first 15 characters).', 'MATCHED_SEC' FROM DUAL UNION ALL
    SELECT 'CA-009', 'CA-009_SEC_FAX_NUMBER_MISMATCH',              'CROSS_SYSTEM_MISMATCH', 'Other (non-main) addresses: the fax number in PROFITS differs from the fax the migration sent from HUB (first 15 characters).', 'MATCHED_SEC' FROM DUAL UNION ALL
    SELECT 'CA-010', 'CA-010_ADDRESS_COUNT_PER_CUSTOMER_MISMATCH',  'CROSS_SYSTEM_MISMATCH', 'Customers whose number of addresses in PROFITS differs from the number of HUB addresses the migration sent. Joint-account addresses count under each holder.', 'CUSTOMERS' FROM DUAL UNION ALL
    SELECT 'CA-011', 'CA-011_ADDRESS_MISSING_IN_PROFITS',           'EXISTENCE',             'HUB addresses that the migration sent for a migrated customer but that are not in PROFITS. The detail rows say if it is the main or another address.', 'MG_ADDR' FROM DUAL UNION ALL
    SELECT 'CA-012', 'CA-012_ADDRESS_MISSING_IN_HUB',               'EXISTENCE',             'Addresses in PROFITS the migration did not send. The extra Company Seat address of each company is accepted (explained in the DC4 review, not a migration script rule).', 'PRF_ROWS' FROM DUAL UNION ALL
    SELECT 'CA-013', 'CA-013_PRI_ADDRESS_TYPE_MISMATCH',            'CROSS_SYSTEM_MISMATCH', 'Main address: the address type in PROFITS is not the type the migration set (individuals 2, companies 1).', 'MATCHED_PRI' FROM DUAL UNION ALL
    SELECT 'CA-014', 'CA-014_PRI_TELEPHONE_MISMATCH',               'CROSS_SYSTEM_MISMATCH', 'Main address: the telephone in PROFITS differs from telephone 1 of the main HUB address as the migration sent it (first 15 characters, JH or J/H sent as blank).', 'MATCHED_PRI' FROM DUAL UNION ALL
    SELECT 'CA-015', 'CA-015_PRI_FAX_NUMBER_MISMATCH',              'CROSS_SYSTEM_MISMATCH', 'Main address: the fax number in PROFITS differs from the fax the migration sent (first 15 characters, + removed, JH, J/H or - sent as blank).', 'MATCHED_PRI' FROM DUAL UNION ALL
    SELECT 'CA-016', 'CA-016_COMMUNICATION_ADDR_MISMATCH',          'CROSS_SYSTEM_MISMATCH', 'Other (non-main) addresses: the correspondence flag in PROFITS is not the one the migration set. The flag of the main address is not set by any script.', 'MATCHED_SEC' FROM DUAL UNION ALL
    SELECT 'CA-017', 'CA-017_SYNTHETIC_CUST_ADDRESS_MISMATCH',      'CROSS_SYSTEM_MISMATCH', 'Customers held only in HUB side lists: the main address in PROFITS differs from what the migration sent in type, line 1 or country.', 'SYN_LOADED' FROM DUAL UNION ALL
    SELECT 'CA-018', 'CA-018_SYNTHETIC_CUST_NO_PRIMARY_ADDRESS',    'EXISTENCE',             'Customers held only in HUB side lists, migrated to PROFITS, that have no main address in PROFITS.', 'SYN_LOADED' FROM DUAL
),
FINDINGS_COUNT AS (
    SELECT CHECK_ID, COUNT(*) AS INVALID_COUNT
    FROM (SELECT SUBSTR(CHECK_NAME, 1, INSTR(CHECK_NAME, '_') - 1) AS CHECK_ID FROM FINDINGS)
    GROUP BY CHECK_ID
)
SELECT
    CAST(CM.CHECK_ID AS VARCHAR2(10)) AS CHECK_ID,
    CAST(CM.CHECK_NAME AS VARCHAR2(50)) AS CHECK_NAME,
    CAST(CM.CATEGORY AS VARCHAR2(30)) AS CATEGORY,
    CAST(CM.DESCRIPTION AS VARCHAR2(200)) AS DESCRIPTION,
    (CASE CM.POPULATION_TYPE
        WHEN 'MATCHED_ALL' THEN P.MATCHED_ALL_COUNT
        WHEN 'MATCHED_PRI' THEN P.MATCHED_PRI_COUNT
        WHEN 'MATCHED_SEC' THEN P.MATCHED_SEC_COUNT
        WHEN 'CUSTOMERS'   THEN P.CUSTOMERS_COUNT
        WHEN 'MG_ADDR'     THEN P.MG_ADDR_COUNT
        WHEN 'PRF_ROWS'    THEN P.PRF_ROWS_COUNT
        WHEN 'SYN_LOADED'  THEN P.SYN_LOADED_COUNT
     END) AS TOTAL_RECORDS,
    (CASE CM.POPULATION_TYPE
        WHEN 'MATCHED_ALL' THEN P.MATCHED_ALL_COUNT
        WHEN 'MATCHED_PRI' THEN P.MATCHED_PRI_COUNT
        WHEN 'MATCHED_SEC' THEN P.MATCHED_SEC_COUNT
        WHEN 'CUSTOMERS'   THEN P.CUSTOMERS_COUNT
        WHEN 'MG_ADDR'     THEN P.MG_ADDR_COUNT
        WHEN 'PRF_ROWS'    THEN P.PRF_ROWS_COUNT
        WHEN 'SYN_LOADED'  THEN P.SYN_LOADED_COUNT
     END) - NVL(FC.INVALID_COUNT, 0) AS VALID_COUNT,
    NVL(FC.INVALID_COUNT, 0) AS INVALID_COUNT,
    CASE WHEN CM.CATEGORY = 'INFO'           THEN 'INFO'
         WHEN NVL(FC.INVALID_COUNT, 0) = 0   THEN 'PASS'
         ELSE 'FAIL' END AS STATUS,
    'DC5' AS DC_VERSION,
    1 AS RUN_VERSION,  -- TESTING ONLY: στο SSIS αντικαθίσταται από @[User::RunVersion] μέσω Derived Column.
    SYSDATE AS RUN_TIMESTAMP
FROM CHECK_META CM
CROSS JOIN POPULATIONS P
LEFT JOIN FINDINGS_COUNT FC ON FC.CHECK_ID = CM.CHECK_ID
ORDER BY REGEXP_SUBSTR(CM.CHECK_ID, '[A-Z]+'), TO_NUMBER(REGEXP_SUBSTR(CM.CHECK_ID, '[0-9]+'));</property>
                    <property
