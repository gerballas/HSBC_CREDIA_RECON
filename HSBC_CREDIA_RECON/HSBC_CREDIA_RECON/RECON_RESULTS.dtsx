                          name="CHECK_ID" />
                        <externalMetadataColumn
                          refId="Package\Sequence Container\Sweep_Agreements_Master\Sweep_Agreements_master.Outputs[Oracle Source Output].ExternalColumns[CHECK_NAME]"
