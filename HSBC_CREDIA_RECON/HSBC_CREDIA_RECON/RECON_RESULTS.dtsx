-- Τροφοδοτεί: RECON.LNS_RECON_DETAIL
-- Μία γραμμή ανά εύρημα για τα LNS-001 .. LNS-031 εκτός INFO (μόνο ό,τι αποτυγχάνει).
-- v2: αλλαγές (πρόσημο LNS-022/023/025/027, NEXT_PERIOD): βλ. header του Master. LNS-017 (description) αφαιρέθηκε, αναρίθμηση: βλ. header του Master.
-- v2 update: LNS-017 / LNS-026 NCIS_VALUE από πίνακες PROFITS (λάθος φίλτρα στο 04_LOANS.sql), βλ. header του Master.
--
-- Ζευγάρι του MasterLoans_DC5_v2.sql: το κοινό κομμάτι και το FINDINGS είναι ΙΔΙΑ
-- αυτούσια και στα δύο αρχεία -&gt; INVALID_COUNT του Master = γραμμές εδώ ανά CHECK_ID.
-- Τα INFO checks (LNS-003, 021, 032-036) υπάρχουν μόνο στο Master.
-- Πηγές / κανόνες / αντιστοιχία με το DC4: βλ. header του Master.
--
--   - DETAIL_ID: '&lt;CHECK_ID&gt;_0000001', ...
--   - CUSTOMER_CODE: πελάτης HUB (LSACMSP.CUSTOMER_CODE). NULL στο LNS-002.
--   - SERIAL_NO: OLD_LNS_NO (= NCIS Loan_Account_Number).
--   - HUB_VALUE = τιμή HUB, NCIS_VALUE = τιμή NCIS_Loans, 100 χαρ.
--   - ISSUE: 'MISMATCH (EXPECTED &lt;τιμή&gt;)', 'NO_MAPPING (SENT &lt;τιμή&gt;)', 'NCIS_NULL (...)', ή η αιτία για τα
--     checks ύπαρξης. Έως 50 χαρακτήρες, ποτέ κενό.
-- ====================================================================
WITH
-- --------------------------------------------------------------------
-- Κοινό κομμάτι (ΙΔΙΟ αυτούσιο στο Master και στο Detail).
--   R_*  = HUB πίνακες (synonyms σε DB link @Malta): κάθε πίνακας ΜΙΑ φορά, μόνο οι στήλες
--          που χρειάζονται. Δίνουν το HUB_VALUE (τιμή όπως είναι στο HUB).
--          Ημερομηνίες HUB: κείμενο YYYYMMDD, όπως τις διαβάζουν τα 40001 / 40200 ('99999999' -&gt; NULL).
--   SD   = NCIS_HGR_LOAN_STATIC_DATA (40001): product μετά το CASE CNM, FIX / FLOAT, ZFGAVP που κράτησε
--   M    = MG_LNS_MNT_LOAD (40001 / 40050 / 40055): τελική τιμή static ανά loan (μετά τον joint redirect)
--   T    = MG_LNS_TRN_INTER (40200 / 40300): γραμμές financial, χωρίς LNS_TRN_STATUS 9 (δεν φορτώθηκαν)
--   PP   = MG_PARAM_PARAMETER: LPURP / FINSC / CCODE / CLOAN / INLNS (OLD_VALUE -&gt; NEW_VALUE)
--   MCI  = MG_CUSTOMER_INTER (πελάτες loaded) -&gt; PRFT_CUST_ID
--   PA   = PROFITS_ACCOUNT (PRFT_SYSTEM 4) + LOAN_ACCOUNT: ύπαρξη στο PROFITS, NRM_RL_INT_BAL (LNS-036)
--   N    = NCIS_Loans (04_LOANS.sql, 20261005), ένας ανά Loan_Account_Number (N_ROWS = γραμμές, LNS-003)
--   B    = loans και στα δύο (R_LS x N) + τιμή HUB + αναμενόμενη τιμή (X_*)
-- --------------------------------------------------------------------
R_LS AS (
    SELECT /*+ MATERIALIZE */ AN, CC, POAPTY, POGAT1, POGAT2, POCYCD, POACB, POACLT, POOLLT,
           PODTAO, PODUDT, POTERM, POROPR, POCUR1, POLMTY, POLINE
    FROM (
        SELECT TRIM(OLD_LNS_NO)          AS AN,
               TRIM(CUSTOMER_CODE)       AS CC,
               TRIM(POAPTY)              AS POAPTY,
               TRIM(POGAT1)              AS POGAT1,
               TRIM(POGAT2)              AS POGAT2,
               TRIM(POCYCD)              AS POCYCD,
               POACB, POACLT, POOLLT,
               TRIM(TO_CHAR(PODTAO))     AS PODTAO,
               TRIM(TO_CHAR(PODUDT))     AS PODUDT,
               TRIM(POTERM)              AS POTERM,
               POROPR,
               TRIM(POCUR1)              AS POCUR1,
               TRIM(POLMTY)              AS POLMTY,
               TRIM(POLINE)              AS POLINE,
               ROW_NUMBER() OVER (PARTITION BY TRIM(OLD_LNS_NO) ORDER BY TRIM(CUSTOMER_CODE)) AS RN
          FROM HUB_MT_LSACMSP
    )
    WHERE RN = 1
),
R_CL AS (
    -- SSCLMTP ανά πελάτη + limit type + facility line (το join του 40001 για το ZFGAVP)
    SELECT /*+ MATERIALIZE */
        TRIM(CUSTOMER_CODE) AS CL_CC, TRIM(ZFLMTY) AS CL_LMTY, TRIM(ZFLINE) AS CL_LINE,
        COUNT(*) AS CL_N, MIN(TRIM(ZFGAVP)) AS CL_GAVP
    FROM HUB_MT_SSCLMTP
    GROUP BY TRIM(CUSTOMER_CODE), TRIM(ZFLMTY), TRIM(ZFLINE)
),
R_RP AS (
    -- LSRPSLP: τελευταία γραμμή (MAX RNSQNO), όπως το NCIS_HGR_LSRPSLP του 40001
    SELECT /*+ MATERIALIZE */ RP_AN, RNISFQ, RNNISD, RNINAT
    FROM (
        SELECT TRIM(OLD_LNS_NO) AS RP_AN, TRIM(RNISFQ) AS RNISFQ, TRIM(TO_CHAR(RNNISD)) AS RNNISD, RNINAT,
               ROW_NUMBER() OVER (PARTITION BY TRIM(OLD_LNS_NO) ORDER BY RNSQNO DESC) AS RN
          FROM HUB_MT_LSRPSLP
    )
    WHERE RN = 1
),
R_RH AS (
    -- LSRHSLP: ληξιπρόθεσμες δόσεις (CFINOP 'O') και δόσεις που έχουν δημιουργηθεί ('P', 'O')
    SELECT /*+ MATERIALIZE */
        TRIM(OLD_LNS_NO)                                                                         AS RH_AN,
        SUM(CASE WHEN CFINOP = 'O' THEN 1 ELSE 0 END)                                            AS RH_N_OV,
        SUM(CASE WHEN CFINOP IN ('P', 'O') THEN 1 ELSE 0 END)                                    AS RH_N_GEN,
        SUM(CASE WHEN CFINOP = 'O' THEN NVL(CFPRIP, 0) - NVL(CFPRPD, 0) ELSE 0 END)              AS RH_OV_PRIN,
        SUM(CASE WHEN CFINOP = 'O' THEN NVL(CFINTP, 0) - (NVL(CFINPD, 0) - NVL(CFPRPD, 0)) ELSE 0 END) AS RH_OV_INT,
        MIN(CASE WHEN CFINOP = 'O' THEN TRIM(TO_CHAR(CFINDD)) END)                               AS RH_OV_FIRST
    FROM HUB_MT_LSRHSLP
    GROUP BY TRIM(OLD_LNS_NO)
),
R_INS AS (
    -- LSINSLP: τελευταία γραμμή (MAX RVSQNO), όπως το NCIS_HGR_LSINSLP του 40001
    SELECT /*+ MATERIALIZE */ INS_AN, RVINCP, RVDRTY, RVDRSP, RVIRRC
    FROM (
        SELECT TRIM(OLD_LNS_NO) AS INS_AN, TRIM(TO_CHAR(RVINCP)) AS RVINCP, TRIM(RVDRTY) AS RVDRTY,
               RVDRSP, TRIM(RVIRRC) AS RVIRRC,
               ROW_NUMBER() OVER (PARTITION BY TRIM(OLD_LNS_NO) ORDER BY RVSQNO DESC) AS RN
          FROM HUB_MT_LSINSLP
    )
    WHERE RN = 1
),
R_RT AS (
    -- SSINRTP: ισχύουσα γραμμή επιτοκίου (X5ENDT = 99999999) ανά νόμισμα + rate type
    SELECT /*+ MATERIALIZE */
        TRIM(X5CYCD) AS RT_CCY, TRIM(X5RTTY) AS RT_RTTY, MIN(TRIM(TO_CHAR(X5INR1))) AS X5INR1
    FROM HUB_MT_SSINRTP
    WHERE TRIM(TO_CHAR(X5ENDT)) = '99999999'
    GROUP BY TRIM(X5CYCD), TRIM(X5RTTY)
),
R_IA AS (
    SELECT /*+ MATERIALIZE */ TRIM(OLD_LNS_NO) AS IA_AN, SUM(EQDRIA) AS EQDRIA, SUM(EQDRIC) AS EQDRIC
    FROM HUB_MT_LSINACP
    WHERE TRIM(TO_CHAR(EQENDT)) = '99999999'
    GROUP BY TRIM(OLD_LNS_NO)
),
R_OI AS (
    SELECT /*+ MATERIALIZE */ TRIM(OLD_LNS_NO) AS OI_AN,
           SUM(EIOIIL) AS EIOIIL, SUM(EIOCIL) AS EIOCIL, SUM(EIOIIN) AS EIOIIN, SUM(EIOCIN) AS EIOCIN
    FROM HUB_MT_LSOIACP
    WHERE TRIM(TO_CHAR(EIENDT)) = '99999999'
    GROUP BY TRIM(OLD_LNS_NO)
),
R_RA AS (
    SELECT /*+ MATERIALIZE */ TRIM(OLD_LNS_NO) AS RA_AN,
           MAX(CASE WHEN TRIM(PQCOPI) = 'P' THEN TRIM(LOAN_SERVICE_ACCOUNT) END) AS RA_P,
           MAX(CASE WHEN TRIM(PQCOPI) = 'I' THEN TRIM(LOAN_SERVICE_ACCOUNT) END) AS RA_I
    FROM HUB_MT_LSRPACP
    WHERE TRIM(PQCOPI) IN ('P', 'I')
    GROUP BY TRIM(OLD_LNS_NO)
),
R_PD AS (
    SELECT /*+ MATERIALIZE */ TRIM(QCAPTY) AS PD_PRODUCT, MIN(TRIM(QCSMCY)) AS QCSMCY
    FROM HUB_MT_LSPDCPP
    GROUP BY TRIM(QCAPTY)
),
R_CU AS (
    SELECT /*+ MATERIALIZE */ TRIM(CUSTOMER_CODE) AS CU_CC, MIN(ZGMKS1) AS ZGMKS1
    FROM HUB_MT_SSCUSTP
    GROUP BY TRIM(CUSTOMER_CODE)
),
CUR AS (
    -- Δεκαδικά νομίσματος όπως στα scripts: DIV = 100 όταν DISPLAYED_DECIMAL = 2
    SELECT TRIM(SHORT_DESCR) AS CUR_CCY, MIN(CASE WHEN DISPLAYED_DECIMAL = 2 THEN 100 ELSE 1 END) AS DIV
    FROM CURRENCY
    GROUP BY TRIM(SHORT_DESCR)
),
SD AS (
    SELECT /*+ MATERIALIZE */ SD_AN, SD_PROD, SD_FIXFLOAT, SD_GAVP
    FROM (
        SELECT TRIM(OLD_LNS_NO) AS SD_AN, TRIM(ACCOUNT_PRODUCT_TYPE) AS SD_PROD,
               TRIM(FIX_FLOAT) AS SD_FIXFLOAT, TRIM(ACCOUNT_PURPOSE_CODE) AS SD_GAVP,
               ROW_NUMBER() OVER (PARTITION BY TRIM(OLD_LNS_NO) ORDER BY SERIAL_NO) AS RN
          FROM NCIS_HGR_LOAN_STATIC_DATA
    )
    WHERE RN = 1
),
PM AS (
    SELECT DISTINCT TRIM(HSBC_CODE) AS HSBC_CODE FROM MG_HGR_LOANS_PRODUCT_MAPPING
),
M AS (
    SELECT /*+ MATERIALIZE */
        M_AN, M_ROWSTATUS, M_ERR, M_FILETYPE, M_PROD, M_CC, M_UNIT, M_CCY, M_LIMIT, M_OPEN, M_ICNT, M_IFREQ,
        M_STMT, M_CLOAN, M_FINSC, M_CCODE, M_LPURP, M_DESC, M_DEP, M_FIXCODE, M_FLTCODE, M_FIXPERC, M_FLTPERC
    FROM (
        SELECT TRIM(OLD_LNS_NO)                 AS M_AN,
               TRIM(TO_CHAR(ROW_STATUS))        AS M_ROWSTATUS,
               TRIM(ROW_ERR_DESC)               AS M_ERR,
               TRIM(FILE_TYPE)                  AS M_FILETYPE,
               TRIM(TO_CHAR(MG_ACCOUNT_TYPE))   AS M_PROD,
               TRIM(CUSTOMER_CODE)              AS M_CC,
               TRIM(TO_CHAR(ACC_UNIT))          AS M_UNIT,
               TRIM(MOVE_CURRENCY)              AS M_CCY,
               ACC_LIMIT_AMN                    AS M_LIMIT,
               ACC_OPEN_DT                      AS M_OPEN,
               TRIM(TO_CHAR(INSTALL_COUNT))     AS M_ICNT,
               TRIM(TO_CHAR(INSTALL_FREQ))      AS M_IFREQ,
               TRIM(TO_CHAR(STATEMENT_FREQ))    AS M_STMT,
               TRIM(CLOAN)                      AS M_CLOAN,
               TRIM(TO_CHAR(FINSC))             AS M_FINSC,
               TRIM(TO_CHAR(CCODE))             AS M_CCODE,
               TRIM(TO_CHAR(LPURP))             AS M_LPURP,
               TRIM(ACC_DESCRIPTION)            AS M_DESC,
               TRIM(DEP_ACCOUNT_NO)             AS M_DEP,
               TRIM(CUR_FX_INTER_CODE)          AS M_FIXCODE,
               TRIM(FLOATING_INT_CODE)          AS M_FLTCODE,
               CUR_FX_INT_PERC                  AS M_FIXPERC,
               FLOATING_INT_PERC                AS M_FLTPERC,
               ROW_NUMBER() OVER (PARTITION BY TRIM(OLD_LNS_NO)
                                  ORDER BY CASE WHEN TRIM(TO_CHAR(ROW_STATUS)) = '1' THEN 0 ELSE 1 END, SERIAL_NO) AS RN
          FROM MG_LNS_MNT_LOAD
    )
    WHERE RN = 1
),
T AS (
    -- MG_LNS_TRN_INTER (40200 / 40300). Overdue installments = FILE_NAME ...OverdueInstallments (request 1, sts 2).
    -- Κύρια γραμμή (REQ_TYPE_PRIORITY 1): εκταμίευση, δόσεις που απομένουν, ποσό δόσης (043).
    SELECT /*+ MATERIALIZE */
        TRIM(OLD_LNS_NO)                                                                              AS T_AN,
        SUM(NVL(RQ_CAPITAL_BAL, 0))                                                                   AS T_CAP_ALL,
        SUM(CASE WHEN UPPER(FILE_NAME) LIKE '%OVERDUEINSTALLMENTS%' THEN NVL(RQ_CAPITAL_BAL, 0) ELSE 0 END) AS T_OV_CAP,
        MIN(CASE WHEN UPPER(FILE_NAME) LIKE '%OVERDUEINSTALLMENTS%' THEN RQ_EXPIRE_DT END)            AS T_OV_SINCE,
        SUM(CASE WHEN TRIM(TO_CHAR(REQUEST_LOAN_STS)) = '2'
                 THEN NVL(RQ_RL_NRM_INT_BAL, 0) + NVL(RQ_URL_NRM_INT_BAL, 0) ELSE 0 END)              AS T_OV_INT,
        SUM(NVL(RQ_ACR_NRM_INT_BAL, 0))                                                               AS T_ACR,
        SUM(NVL(RQ_ACR_PNL_INT_BAL, 0) + NVL(RQ_URL_PNL_INT_BAL, 0))                                  AS T_PNL,
        MAX(CASE WHEN TRIM(TO_CHAR(REQ_TYPE_PRIORITY)) = '1' THEN TOT_DRAWDOWN_AMN END)               AS T_DRAW,
        MAX(CASE WHEN TRIM(TO_CHAR(REQ_TYPE_PRIORITY)) = '1' THEN REMAIN_INST_CNT END)                AS T_REMAIN,
        MAX(CASE WHEN TRIM(TO_CHAR(REQ_TYPE_PRIORITY)) = '1' THEN INSTALLFIXED_AMN END)               AS T_INSTAMT
    FROM MG_LNS_TRN_INTER
    WHERE NVL(TRIM(TO_CHAR(LNS_TRN_STATUS)), '0') &lt;&gt; '9'
    GROUP BY TRIM(OLD_LNS_NO)
),
PP AS (
    SELECT /*+ MATERIALIZE */ TRIM(PARAMETER_TYPE) AS PT, TRIM(TO_CHAR(OLD_VALUE)) AS OV, MIN(NEW_VALUE) AS NV
    FROM MG_PARAM_PARAMETER
    WHERE TRIM(PARAMETER_TYPE) IN ('LPURP', 'FINSC', 'CCODE', 'CLOAN', 'INLNS')
    GROUP BY TRIM(PARAMETER_TYPE), TRIM(TO_CHAR(OLD_VALUE))
),
MCI AS (
    SELECT /*+ MATERIALIZE */ TRIM(CUSTOMER_CODE) AS MCI_CC, MIN(PRFT_CUST_ID) AS MCI_PRFT
    FROM MG_CUSTOMER_INTER
    WHERE ROW_STATUS = 1
      AND PRFT_CUST_ID &gt; 0
    GROUP BY TRIM(CUSTOMER_CODE)
),
PA AS (
    -- v2 update (2026-11-18): το NCIS extract έχει λάθος φίλτρα, άρα LNS-017 / LNS-026 διαβάζουν από τους πίνακες του PROFITS:
    --   PA_DEP = deposit (PRFT_SYSTEM 3) με ίδιο DEP_ACC_NUMBER, ΧΩΡΙΣ SECONDARY_ACC = '1' (κανένα loan δεν το έχει)
    --   PA_ACR = Σ ONL_NRM_ACCR_BAL.VALEUR_BALANCE με ENTRY_COMMENTS 'FROM MIGRATION' (το extract ψάχνει 'ΑΠΟ ΜΕΤΑΠΤΩΣΗ I')
    SELECT /*+ MATERIALIZE */ TRIM(A.ACCOUNT_NUMBER) AS PA_AN, MAX(L.NRM_RL_INT_BAL) AS PA_NRM_RL_INT,
           MAX(TRIM(TO_CHAR(C.ACCOUNT_NUMBER))) AS PA_DEP, COUNT(DISTINCT C.ACCOUNT_NUMBER) AS PA_NDEP,
           MAX(O.ACR) AS PA_ACR
    FROM PROFITS_ACCOUNT A
    LEFT JOIN LOAN_ACCOUNT L
           ON L.FK_UNITCODE = A.LNS_OPEN_UNIT AND L.ACC_TYPE = A.LNS_TYPE AND L.ACC_SN = A.LNS_SN
    LEFT JOIN PROFITS_ACCOUNT C
           ON C.DEP_ACC_NUMBER = A.DEP_ACC_NUMBER AND C.PRFT_SYSTEM = 3
    LEFT JOIN (SELECT ACC_UNIT, ACC_TYPE, ACC_SN, SUM(VALEUR_BALANCE) AS ACR
                 FROM ONL_NRM_ACCR_BAL
                WHERE TRIM(ENTRY_COMMENTS) = 'FROM MIGRATION'
                GROUP BY ACC_UNIT, ACC_TYPE, ACC_SN) O
           ON O.ACC_UNIT = A.LNS_OPEN_UNIT AND O.ACC_TYPE = A.LNS_TYPE AND O.ACC_SN = A.LNS_SN
    WHERE A.PRFT_SYSTEM = 4
      AND A.LNS_TYPE &lt;&gt; 14
    GROUP BY TRIM(A.ACCOUNT_NUMBER)
),
N AS (
    SELECT /*+ MATERIALIZE */
        N_AN, N_ROWS, N_PROD, N_CUST, N_AGR, N_UNIT, N_CCY, N_LIMIT, N_OPEN, N_EXP, N_ICNT, N_IFREQ, N_STMT,
        N_CAT, N_FINSC, N_CCODE, N_LPURP, N_LPUCB, N_DESC, N_DEP, N_FIXCODE, N_FIXRATE, N_SPREAD, N_FLTCODE,
        N_FLTRATE, N_STATUS, N_DRAW, N_REMAIN, N_CAP, N_ACR, N_PNL, N_INSTAMT, N_NEXTDT, N_OVCAP, N_OVSINCE, N_OVINT
    FROM (
        SELECT TRIM(TO_CHAR(n.LOAN_ACCOUNT_NUMBER))                                  AS N_AN,
               COUNT(*) OVER (PARTITION BY TRIM(TO_CHAR(n.LOAN_ACCOUNT_NUMBER)))      AS N_ROWS,
               TRIM(TO_CHAR(n.ACCOUNT_TYPE))                                          AS N_PROD,
               TRIM(TO_CHAR(n.CUSTOMER_CODE))                                         AS N_CUST,
               TRIM(TO_CHAR(n.AGREEMENT_CODE))                                        AS N_AGR,
               TRIM(TO_CHAR(n.UNIT_CODE))                                             AS N_UNIT,
               TRIM(n.LOAN_ACCOUNT_CURRENCY)                                          AS N_CCY,
               n.ACCOUNT_LIMIT_AMOUNT                                                 AS N_LIMIT,
               n.ACCOUNT_OPENING_DATE                                                 AS N_OPEN,
               n.LOAN_EXPIRY_DATE                                                     AS N_EXP,
               TRIM(TO_CHAR(n.NUMBER_OF_INSTALLMENTS))                                AS N_ICNT,
               TRIM(TO_CHAR(n.INSTALLMENT_FREQUENCY_IN_MONTHS))                       AS N_IFREQ,
               TRIM(TO_CHAR(n.EXTRAIT_ISSUE_FREQUENCY))                               AS N_STMT,
               TRIM(TO_CHAR(n.CUSTOMER_CATEGORY))                                     AS N_CAT,
               TRIM(TO_CHAR(n.FINANCIAL_SECTOR))                                      AS N_FINSC,
               TRIM(TO_CHAR(n.ACTIVITY_SECTOR))                                       AS N_CCODE,
               TRIM(TO_CHAR(n.LOAN_PURPOSE))                                          AS N_LPURP,
               TRIM(TO_CHAR(n.LOAN_PURPOSE_FOR_CENTRAL_BANK))                         AS N_LPUCB,
               TRIM(n.ACCOUNT_DESCRIPTION)                                            AS N_DESC,
               TRIM(TO_CHAR(n.DEPOSIT_ACCOUNT))                                       AS N_DEP,
               TRIM(TO_CHAR(n.CURRENT_FIXED_INTEREST_CODE))                           AS N_FIXCODE,
               n.CURRENT_FIXED_INTEREST_RATE                                          AS N_FIXRATE,
               n.CURRENT_SPREAD                                                       AS N_SPREAD,
               TRIM(TO_CHAR(n.FLOATING_INTEREST_CODE))                                AS N_FLTCODE,
               n.FLOATING_INTEREST_RATE                                               AS N_FLTRATE,
               TRIM(n.LOAN_STATUS)                                                    AS N_STATUS,
               n.DISBURSEMENT_TOTAL_AMOUNT                                            AS N_DRAW,
               TRIM(TO_CHAR(n.NUMBER_OF_REMAINING_INSTALMENTS))                       AS N_REMAIN,
               n.OUTSATNDING_CAPITAL_AMOUNT                                           AS N_CAP,
               n.ACCRUED_INTERESTS_AMOUNT                                             AS N_ACR,
               n.PENALTY_ACCRUALS_AMOUNT                                              AS N_PNL,
               n.NEXT_INSTALLMENT_AMOUNT                                              AS N_INSTAMT,
               n.NEXT_INSTALLMENT_DATE                                                AS N_NEXTDT,
               n.OVERDUE_PRINCIPAL                                                    AS N_OVCAP,
               n.OVERDUE_SINCE                                                        AS N_OVSINCE,
               n.TOTAL_OVERDUE_INTEREST                                               AS N_OVINT,
               ROW_NUMBER() OVER (PARTITION BY TRIM(TO_CHAR(n.LOAN_ACCOUNT_NUMBER)) ORDER BY NULL) AS RN
          FROM NCIS_Loans n
    )
    WHERE RN = 1
),
B AS (
    SELECT /*+ MATERIALIZE */
        h.*,
        n.*,
        m.*,
        sd.SD_FIXFLOAT, sd.SD_GAVP,
        cl.CL_N, cl.CL_GAVP,
        rp.RNISFQ, rp.RNNISD, rp.RNINAT,
        rh.RH_N_OV, rh.RH_N_GEN, rh.RH_OV_PRIN, rh.RH_OV_INT, rh.RH_OV_FIRST,
        ins.INS_AN, ins.RVINCP, ins.RVDRTY, ins.RVDRSP, ins.RVIRRC,
        rt.RT_CCY, rt.X5INR1,
        ia.EQDRIA, ia.EQDRIC,
        oi.EIOIIL, oi.EIOCIL, oi.EIOIIN, oi.EIOCIN,
        ra.RA_P, ra.RA_I,
        pd.QCSMCY,
        cu.ZGMKS1,
        mci.MCI_PRFT,
        t.T_CAP_ALL, t.T_OV_CAP, t.T_OV_SINCE, t.T_OV_INT, t.T_ACR, t.T_PNL, t.T_DRAW, t.T_REMAIN, t.T_INSTAMT,
        pa.PA_NRM_RL_INT, pa.PA_DEP, pa.PA_NDEP, pa.PA_ACR,
        cur.DIV,
        ppf.NV AS X_FINSC,
        ppc.NV AS X_CCODE,
        ppl.NV AS X_LPURP,
        ppk.NV AS X_CLOAN,
        ppx.NV AS X_FIXMAP,
        ppy.NV AS X_FLTMAP,
        -- Account limit (CHS-525): POOLLT, ή POACLT όταν POOLLT = 0, / 100. Κανόνας DC4: από το HUB,
        -- γιατί το 40055 βάζει το sentinel 987654321 στο MG_LNS_MNT_LOAD.ACC_LIMIT_AMN
        (CASE WHEN NVL(h.POOLLT, 0) = 0 THEN h.POACLT ELSE h.POOLLT END) / cur.DIV AS X_LIMIT,
        -- Συνολικό κεφάλαιο: -POROPR / 100 (043: TKXR + overdue, 046: TCACRSP + overdue + CHS-466 του 40200)
        -1 * h.POROPR / cur.DIV AS X_CAP,
        TO_DATE(SUBSTR(REGEXP_REPLACE(h.PODUDT, '[^0-9]', ''), 1, 8) DEFAULT NULL ON CONVERSION ERROR, 'YYYYMMDD') AS X_EXP,
        TO_DATE(SUBSTR(REGEXP_REPLACE(rp.RNNISD, '[^0-9]', ''), 1, 8) DEFAULT NULL ON CONVERSION ERROR, 'YYYYMMDD') AS X_NEXTDT,
        -- Κωδικοί επιτοκίου (40001 / 40050): FIX -&gt; CUR_FX_INTER_CODE (review code) -&gt; INLNS, FLOAT -&gt;
        -- FLOATING_INT_CODE -&gt; INLNS. Το '40000' (μη FLOAT) στέλνεται ως ID επιτοκίου χωρίς INLNS.
        CASE WHEN m.M_FIXCODE IS NULL THEN '0' ELSE TO_CHAR(ppx.NV) END AS X_FIX,
        CASE WHEN m.M_FLTCODE IS NULL THEN '0'
             WHEN ppy.NV IS NOT NULL THEN TO_CHAR(ppy.NV)
             WHEN m.M_FLTCODE = '40000' THEN '40000' END AS X_FLT,
        CASE WHEN m.M_DEP IS NULL OR m.M_DEP = '0-0-0' THEN NULL ELSE m.M_DEP END AS X_DEP
    FROM R_LS h
    JOIN N n            ON n.N_AN = h.AN
    LEFT JOIN M m       ON m.M_AN = h.AN
    LEFT JOIN SD sd     ON sd.SD_AN = h.AN
    LEFT JOIN R_CL cl   ON cl.CL_CC = h.CC AND cl.CL_LMTY = h.POLMTY AND cl.CL_LINE = h.POLINE
    LEFT JOIN R_RP rp   ON rp.RP_AN = h.AN
    LEFT JOIN R_RH rh   ON rh.RH_AN = h.AN
    LEFT JOIN R_INS ins ON ins.INS_AN = h.AN
    LEFT JOIN R_RT rt   ON rt.RT_CCY = h.POCYCD AND rt.RT_RTTY = ins.RVDRTY
    LEFT JOIN R_IA ia   ON ia.IA_AN = h.AN
    LEFT JOIN R_OI oi   ON oi.OI_AN = h.AN
    LEFT JOIN R_RA ra   ON ra.RA_AN = h.AN
    LEFT JOIN R_PD pd   ON pd.PD_PRODUCT = h.POAPTY
    LEFT JOIN R_CU cu   ON cu.CU_CC = h.CC
    LEFT JOIN MCI mci   ON mci.MCI_CC = m.M_CC
    LEFT JOIN T t       ON t.T_AN = h.AN
    LEFT JOIN PA pa     ON pa.PA_AN = h.AN
    LEFT JOIN CUR cur   ON cur.CUR_CCY = h.POCYCD
    LEFT JOIN PP ppf    ON ppf.PT = 'FINSC' AND ppf.OV = m.M_FINSC
    LEFT JOIN PP ppc    ON ppc.PT = 'CCODE' AND ppc.OV = m.M_CCODE
    LEFT JOIN PP ppl    ON ppl.PT = 'LPURP' AND ppl.OV = m.M_LPURP
    LEFT JOIN PP ppk    ON ppk.PT = 'CLOAN' AND ppk.OV = m.M_CLOAN
    LEFT JOIN PP ppx    ON ppx.PT = 'INLNS' AND ppx.OV = m.M_FIXCODE
    LEFT JOIN PP ppy    ON ppy.PT = 'INLNS' AND ppy.OV = m.M_FLTCODE
),
FINDINGS AS (
    -- Μία γραμμή ανά εύρημα. CUSTOMER_CODE = πελάτης HUB (LSACMSP.CUSTOMER_CODE), SERIAL_NO = OLD_LNS_NO
    -- (= NCIS Loan_Account_Number). HUB_VALUE = τιμή όπως είναι στον HUB πίνακα, NCIS_VALUE = τιμή του
    -- NCIS_Loans. Η αναμενόμενη τιμή (μόνο από τα scripts) στο ISSUE. Τα INFO checks (LNS-003, 021,
    -- 033-037) δεν έχουν γραμμές εδώ: μετρώνται μόνο στο Master (FINDINGS_COUNT).
    --==============================================================
    --LNS-001. Loan HUB (LSACMSP) που δεν υπάρχει στο NCIS. ISSUE = αιτία από SSCLMTP / static data / MG / PROFITS
    SELECT
      CAST('LNS-001_LOAN_MISSING_IN_NCIS' AS VARCHAR2(50)) AS CHECK_NAME,
      CAST(h.CC AS VARCHAR2(40)) AS CUSTOMER_CODE, CAST(h.AN AS VARCHAR2(40)) AS SERIAL_NO,
      -- v2 update: και PODTAO / PODUDT (το MG_ERROR του loader αφορά την ημερομηνία λήξης)
      CAST('POAPTY=' || h.POAPTY || '; LIMIT=' || h.POLMTY || '/' || h.POLINE ||
           '; PODTAO=' || h.PODTAO || '; PODUDT=' || h.PODUDT AS VARCHAR2(200)) AS HUB_VALUE,
      CAST(NULL AS VARCHAR2(200)) AS NCIS_VALUE,
      CAST(SUBSTR(
        CASE WHEN cl.CL_CC IS NULL THEN 'NO_SSCLMTP_LIMIT (40001 INNER JOIN)'
             WHEN sd.SD_AN IS NULL THEN 'NOT_IN_LOAN_STATIC_DATA'
             WHEN pm.HSBC_CODE IS NULL THEN 'UNMAPPED_PRODUCT (' || sd.SD_PROD || ')'
             WHEN m.M_AN IS NULL THEN 'NOT_IN_MG_LNS_MNT_LOAD'
             WHEN m.M_ERR IS NOT NULL THEN 'MG_ERROR: ' || m.M_ERR
             WHEN pa.PA_AN IS NULL THEN 'NOT_IN_PROFITS (MG ROW_STATUS ' || NVL(m.M_ROWSTATUS, '-') || ')'
             ELSE 'IN_PROFITS_NOT_IN_NCIS_EXTRACT' END, 1, 50) AS VARCHAR2(50)) AS ISSUE
    FROM R_LS h
    LEFT JOIN N n     ON n.N_AN = h.AN
    LEFT JOIN R_CL cl ON cl.CL_CC = h.CC AND cl.CL_LMTY = h.POLMTY AND cl.CL_LINE = h.POLINE
    LEFT JOIN SD sd   ON sd.SD_AN = h.AN
    LEFT JOIN PM pm   ON pm.HSBC_CODE = sd.SD_PROD
    LEFT JOIN M m     ON m.M_AN = h.AN
    LEFT JOIN PA pa   ON pa.PA_AN = h.AN
    WHERE n.N_AN IS NULL
    UNION ALL
    --==============================================================
    --LNS-002. Loan NCIS που δεν υπάρχει στο HUB (LSACMSP)
    SELECT 'LNS-002_LOAN_MISSING_IN_HUB', CAST(NULL AS VARCHAR2(40)), n.N_AN, CAST(NULL AS VARCHAR2(200)),
           'CUST_ID=' || n.N_CUST || '; TYPE=' || n.N_PROD, 'NOT_IN_HUB_LSACMSP'
    FROM N n
    LEFT JOIN R_LS h ON h.AN = n.N_AN
    WHERE h.AN IS NULL
    UNION ALL
    --==============================================================
    --LNS-004. Product: MG_LNS_MNT_LOAD.MG_ACCOUNT_TYPE (mapping + CASE CNM του 40001) vs NCIS Account_Type
    SELECT 'LNS-004_PRODUCT_MISMATCH', CC, AN,
           'POAPTY=' || POAPTY ||
           CASE WHEN POAPTY = 'CNM' THEN '; POGAT1/2=' || POGAT1 || '/' || POGAT2 || '; ZFGAVP=' || SD_GAVP END,
           N_PROD,
           CASE WHEN M_PROD IS NULL THEN 'NOT_IN_MG_LNS_MNT_LOAD'
                ELSE SUBSTR('MISMATCH (EXPECTED ' || M_PROD || ')', 1, 50) END
    FROM B
    WHERE NVL(N_PROD, 'X') &lt;&gt; NVL(M_PROD, 'X')
    UNION ALL
    --==============================================================
    --LNS-005. Customer: PRFT_CUST_ID του MG_LNS_MNT_LOAD.CUSTOMER_CODE (μετά τον joint redirect) vs NCIS Customer_Code
    SELECT 'LNS-005_CUSTOMER_CODE_MISMATCH', CC, AN, CC, N_CUST,
           CASE WHEN MCI_PRFT IS NULL THEN SUBSTR('CUSTOMER_NOT_LOADED (SENT ' || NVL(M_CC, 'EMPTY') || ')', 1, 50)
                ELSE SUBSTR('MISMATCH (EXPECTED ' || TO_CHAR(MCI_PRFT) || ')', 1, 50) END
    FROM B
    WHERE NVL(N_CUST, 'X') &lt;&gt; NVL(TO_CHAR(MCI_PRFT), 'X')
    UNION ALL
    --==============================================================
    --LNS-006. Currency: MG_LNS_MNT_LOAD.MOVE_CURRENCY (POCYCD) vs NCIS Loan_Account_Currency
    SELECT 'LNS-006_CURRENCY_MISMATCH', CC, AN, POCYCD, N_CCY,
           SUBSTR('MISMATCH (EXPECTED ' || NVL(M_CCY, 'EMPTY') || ')', 1, 50)
    FROM B
    WHERE NVL(N_CCY, 'X') &lt;&gt; NVL(M_CCY, 'X')
    UNION ALL
    --==============================================================
    --LNS-007. Unit: MG_LNS_MNT_LOAD.ACC_UNIT (POACB) vs NCIS Unit_Code
    SELECT 'LNS-007_UNIT_MISMATCH', CC, AN, TRIM(TO_CHAR(POACB)), N_UNIT,
           SUBSTR('MISMATCH (EXPECTED ' || NVL(M_UNIT, 'EMPTY') || ')', 1, 50)
    FROM B
    WHERE NVL(N_UNIT, 'X') &lt;&gt; NVL(M_UNIT, 'X')
    UNION ALL
    --==============================================================
    --LNS-008. Account limit: POOLLT ή POACLT / 100 (CHS-525, κανόνας DC4 από HUB) vs NCIS Account_Limit_Amount
    SELECT 'LNS-008_LIMIT_AMOUNT_MISMATCH', CC, AN,
           TO_CHAR(ROUND(X_LIMIT, 2)), TO_CHAR(N_LIMIT),  -- HUB: το ποσό που διαλέγει το 40001, σε ευρώ
           SUBSTR('MISMATCH (EXPECTED ' || NVL(TO_CHAR(ROUND(X_LIMIT, 2)), 'EMPTY') ||
                  CASE WHEN M_LIMIT = 987654321 THEN '; MG SENTINEL' END || ')', 1, 50)
    FROM B
    WHERE N_LIMIT IS NULL OR X_LIMIT IS NULL OR ABS(N_LIMIT - X_LIMIT) &gt; 0.005
    UNION ALL
    --==============================================================
    --LNS-009. Opening date: MG_LNS_MNT_LOAD.ACC_OPEN_DT (PODTAO, 40055 reruns) vs NCIS Account_Opening_Date
    SELECT 'LNS-009_OPEN_DATE_MISMATCH', CC, AN, 'PODTAO=' || PODTAO, TO_CHAR(N_OPEN, 'YYYY-MM-DD'),
           SUBSTR('MISMATCH (EXPECTED ' || NVL(TO_CHAR(M_OPEN, 'YYYY-MM-DD'), 'EMPTY') || ')', 1, 50)
    FROM B
    WHERE NVL(TRUNC(N_OPEN), DATE '0001-01-01') &lt;&gt; NVL(TRUNC(M_OPEN), DATE '0001-01-01')
    UNION ALL
    --==============================================================
    --LNS-010. Expiry date: PODUDT όπως είναι στο HUB (απόφαση χρήστη) vs NCIS Loan_Expiry_Date
    SELECT 'LNS-010_EXPIRY_DATE_MISMATCH', CC, AN, 'PODUDT=' || PODUDT, TO_CHAR(N_EXP, 'YYYY-MM-DD'),
           SUBSTR('MISMATCH (EXPECTED ' || NVL(TO_CHAR(X_EXP, 'YYYY-MM-DD'), 'EMPTY') || ')', 1, 50)
    FROM B
    WHERE NVL(TRUNC(N_EXP), DATE '0001-01-01') &lt;&gt; NVL(X_EXP, DATE '0001-01-01')
    UNION ALL
    --==============================================================
    --LNS-011. Number of installments: MG_LNS_MNT_LOAD.INSTALL_COUNT (POTERM Y x 12 / M, 0 -&gt; 1) vs NCIS
    SELECT 'LNS-011_INSTALLMENT_COUNT_MISMATCH', CC, AN, 'POTERM=' || POTERM, N_ICNT,
           SUBSTR('MISMATCH (EXPECTED ' || NVL(M_ICNT, 'EMPTY') || ')', 1, 50)
    FROM B
    WHERE NVL(N_ICNT, 'X') &lt;&gt; NVL(M_ICNT, 'X')
    UNION ALL
    --==============================================================
    --LNS-012. Installment frequency: MG_LNS_MNT_LOAD.INSTALL_FREQ (RNISFQ M1 Q3 H6 Y12, άλλο 0, 0 -&gt; 1) vs NCIS
    SELECT 'LNS-012_INSTALLMENT_FREQ_MISMATCH', CC, AN, 'RNISFQ=' || RNISFQ, N_IFREQ,
           SUBSTR('MISMATCH (EXPECTED ' || NVL(M_IFREQ, 'EMPTY') || ')', 1, 50)
    FROM B
    WHERE NVL(N_IFREQ, 'X') &lt;&gt; NVL(M_IFREQ, 'X')
    UNION ALL
    --==============================================================
    --LNS-013. Statement frequency: MG_LNS_MNT_LOAD.STATEMENT_FREQ (LSPDCPP.QCSMCY M1 Q2 άλλο 4, CHS-406) vs NCIS
    SELECT 'LNS-013_STATEMENT_FREQ_MISMATCH', CC, AN, 'QCSMCY=' || QCSMCY, N_STMT,
           SUBSTR('MISMATCH (EXPECTED ' || NVL(M_STMT, 'EMPTY') || ')', 1, 50)
    FROM B
    WHERE NVL(N_STMT, 'X') &lt;&gt; NVL(M_STMT, 'X')
    UNION ALL
    --==============================================================
    --LNS-014. Financial sector: MG_LNS_MNT_LOAD.FINSC (ZGMKS1) -&gt; MG_PARAM_PARAMETER FINSC vs NCIS Financial_Sector
    SELECT 'LNS-014_FINANCIAL_SECTOR_MISMATCH', CC, AN, 'ZGMKS1=' || TO_CHAR(ZGMKS1), N_FINSC,
           CASE WHEN X_FINSC IS NULL THEN SUBSTR('NO_MAPPING (SENT ' || NVL(M_FINSC, 'EMPTY') || ')', 1, 50)
                ELSE SUBSTR('MISMATCH (EXPECTED ' || TO_CHAR(X_FINSC) || ')', 1, 50) END
    FROM B
    WHERE NVL(N_FINSC, 'X') &lt;&gt; NVL(TO_CHAR(X_FINSC), 'X')
    UNION ALL
    --==============================================================
    --LNS-015. Activity sector: MG_LNS_MNT_LOAD.CCODE (ZGMKS1) -&gt; MG_PARAM_PARAMETER CCODE vs NCIS Activity_Sector
    SELECT 'LNS-015_ACTIVITY_SECTOR_MISMATCH', CC, AN, 'ZGMKS1=' || TO_CHAR(ZGMKS1), N_CCODE,
           CASE WHEN X_CCODE IS NULL THEN SUBSTR('NO_MAPPING (SENT ' || NVL(M_CCODE, 'EMPTY') || ')', 1, 50)
                ELSE SUBSTR('MISMATCH (EXPECTED ' || TO_CHAR(X_CCODE) || ')', 1, 50) END
    FROM B
    WHERE NVL(N_CCODE, 'X') &lt;&gt; NVL(TO_CHAR(X_CCODE), 'X')
    UNION ALL
    --==============================================================
    --LNS-016. Loan purpose: MG_LNS_MNT_LOAD.LPURP (NVL(ZFGAVP, 0)) -&gt; MG_PARAM_PARAMETER LPURP (10010: από GENERIC_DETAIL)
    SELECT 'LNS-016_LOAN_PURPOSE_MISMATCH', CC, AN,
           'ZFGAVP=' || CL_GAVP || CASE WHEN CL_N &gt; 1 THEN '; SSCLMTP ROWS=' || TO_CHAR(CL_N) END, N_LPURP,
           CASE WHEN X_LPURP IS NULL THEN SUBSTR('NO_MAPPING (SENT ' || NVL(M_LPURP, 'EMPTY') || ')', 1, 50)
                ELSE SUBSTR('MISMATCH (EXPECTED ' || TO_CHAR(X_LPURP) || ')', 1, 50) END
    FROM B
    WHERE NVL(N_LPURP, 'X') &lt;&gt; NVL(TO_CHAR(X_LPURP), 'X')
    UNION ALL
    --==============================================================
    --LNS-017. Service account: MG_LNS_MNT_LOAD.DEP_ACCOUNT_NO (LSRPACP P, μετά I, '0-0-0' / κενό = κανένας) vs NCIS Deposit_Account
    --         v2 update: τιμή PROFITS από PROFITS_ACCOUNT (PA_DEP), όχι από το NCIS_Loans.Deposit_Account
    --         (το 04_LOANS.sql φιλτράρει SECONDARY_ACC = '1', που δεν έχει κανένα loan: run 2026-11-18 3.320 + 27.209)
    --         HUB_VALUE: μόνο ο λογαριασμός που διαλέγει το 40001 (P, αλλιώς I· '0-0-0' = κανένας), απόφαση χρήστη 2026-11-18
    SELECT 'LNS-017_SERVICE_ACCOUNT_MISMATCH', CC, AN,
           COALESCE(NULLIF(RA_P, '0-0-0'), NULLIF(RA_I, '0-0-0')), PA_DEP,
           CASE WHEN PA_NDEP &gt; 1 THEN SUBSTR('MULTIPLE_DEPOSITS (' || TO_CHAR(PA_NDEP) || ')', 1, 50)
                ELSE SUBSTR('MISMATCH (EXPECTED ' || NVL(X_DEP, 'EMPTY') || ')', 1, 50) END
    FROM B
    WHERE NVL(PA_DEP, 'X') &lt;&gt; NVL(X_DEP, 'X')
       OR PA_NDEP &gt; 1
    UNION ALL
    --==============================================================
    --LNS-018. Interest codes: fixed / floating code (40001 / 40050, INLNS) vs NCIS Current_Fixed_Interest_Code /
    --         Floating_Interest_Code. Και NO_RATE_ROW: loan με LSINSLP χωρίς ισχύουσα γραμμή SSINRTP (INNER JOIN 40001)
    SELECT 'LNS-018_INTEREST_CODE_MISMATCH', CC, AN,
           'RVINCP=' || RVINCP || '; RVDRTY=' || RVDRTY || '; RVIRRC=' || RVIRRC,
           'FIX=' || N_FIXCODE || '; FLOAT=' || N_FLTCODE,
           CASE WHEN INS_AN IS NOT NULL AND RT_CCY IS NULL
                     THEN SUBSTR('NO_RATE_ROW (SSINRTP ' || POCYCD || '/' || RVDRTY || ')', 1, 50)
                WHEN M_FIXCODE IS NOT NULL AND X_FIXMAP IS NULL
                     THEN SUBSTR('NO_MAPPING (SENT ' || M_FIXCODE || ')', 1, 50)
                WHEN X_FLT IS NULL
                     THEN SUBSTR('NO_MAPPING (SENT ' || M_FLTCODE || ')', 1, 50)
                ELSE SUBSTR('MISMATCH (EXPECTED FIX ' || X_FIX || ', FLOAT ' || X_FLT || ')', 1, 50) END
    FROM B
    WHERE NVL(N_FIXCODE, '0') &lt;&gt; NVL(X_FIX, '?')
       OR NVL(N_FLTCODE, '0') &lt;&gt; NVL(X_FLT, '?')
       OR (INS_AN IS NOT NULL AND RT_CCY IS NULL)
    UNION ALL
    --==============================================================
    --LNS-019. Fixed rate (FIX): MG_LNS_MNT_LOAD.CUR_FX_INT_PERC (SSINRTP.X5INR1) vs NCIS Current_Fixed_Interest_Rate
    SELECT 'LNS-019_FIXED_RATE_MISMATCH', CC, AN, 'X5INR1=' || X5INR1, TO_CHAR(N_FIXRATE),
           SUBSTR('MISMATCH (EXPECTED ' || NVL(TO_CHAR(M_FIXPERC), 'EMPTY') || ')', 1, 50)
    FROM B
    WHERE SD_FIXFLOAT = 'FIX'
      AND (N_FIXRATE IS NULL OR M_FIXPERC IS NULL OR ABS(N_FIXRATE - M_FIXPERC) &gt; 0.00005)
    UNION ALL
    --==============================================================
    --LNS-020. Floating rate: FLOAT -&gt; MG_LNS_MNT_LOAD.FLOATING_INT_PERC (X5INR1), αλλιώς 0 (40001) vs NCIS Floating_Interest_Rate
    SELECT 'LNS-020_FLOATING_RATE_MISMATCH', CC, AN,
           'RVINCP=' || RVINCP || '; X5INR1=' || X5INR1, TO_CHAR(N_FLTRATE),
           SUBSTR('MISMATCH (EXPECTED ' || TO_CHAR(NVL(M_FLTPERC, 0)) || ', ' || NVL(SD_FIXFLOAT, 'NO LSINSLP') || ')', 1, 50)
    FROM B
    WHERE ABS(NVL(N_FLTRATE, 0) - NVL(M_FLTPERC, 0)) &gt; 0.00005
    UNION ALL
    --==============================================================
    --LNS-022. Total capital: -POROPR / 100 vs NCIS Outsatnding_Capital_Amount + Overdue_Principal (κανόνας DC4 #3).
    --         ISSUE: και το άθροισμα RQ_CAPITAL_BAL του MG_LNS_TRN_INTER (διάγνωση, π.χ. CHS-466 στα CNM)
    --         v2: το PROFITS κρατά τα χρεωστικά ποσά αρνητικά -&gt; σύγκριση με -NCIS (run 2026-11-18).
    --             HUB_VALUE με POAPTY / FILE_TYPE για να φαίνονται τα CNM / 046.
    --         HUB_VALUE: μόνο το POROPR όπως είναι στο HUB (απόφαση χρήστη 2026-11-18· το CNM / 046 εξηγείται στο FINDING)
    SELECT 'LNS-022_CAPITAL_MISMATCH', CC, AN,
           TO_CHAR(ROUND(POROPR / DIV, 2)),  -- HUB: POROPR σε ευρώ (πρόσημο HUB)
           TO_CHAR(N_CAP + NVL(N_OVCAP, 0)),  -- NCIS: κεφάλαιο + ληξιπρόθεσμο (το άθροισμα που συγκρίνεται)
           CASE WHEN N_CAP IS NULL THEN SUBSTR('NCIS_NULL (EXPECTED ' || TO_CHAR(ROUND(X_CAP, 2)) || ')', 1, 50)
                ELSE SUBSTR('MISMATCH (EXPECTED ' || NVL(TO_CHAR(ROUND(X_CAP, 2)), 'EMPTY') ||
                            '; MG ' || NVL(TO_CHAR(ROUND(T_CAP_ALL, 2)), '-') || ')', 1, 50) END
    FROM B
    WHERE N_CAP IS NULL OR X_CAP IS NULL OR ABS(-1 * (N_CAP + NVL(N_OVCAP, 0)) - X_CAP) &gt; 0.005
    UNION ALL
    --==============================================================
    --LNS-023. Overdue principal: Σ RQ_CAPITAL_BAL των overdue installments (40200: Σ (CFPRIP - CFPRPD) / 100) vs NCIS
    SELECT 'LNS-023_OVERDUE_PRINCIPAL_MISMATCH', CC, AN,
           TO_CHAR(ROUND(RH_OV_PRIN / DIV, 2)), TO_CHAR(N_OVCAP),  -- HUB: Σ (CFPRIP - CFPRPD) των O σε ευρώ
           SUBSTR('MISMATCH (EXPECTED ' || TO_CHAR(ROUND(NVL(T_OV_CAP, 0), 2)) || ')', 1, 50)
    FROM B
    WHERE ABS(-1 * NVL(N_OVCAP, 0) - NVL(T_OV_CAP, 0)) &gt; 0.005  -- v2: -NCIS (χρεωστικά αρνητικά στο PROFITS)
    UNION ALL
    --==============================================================
    --LNS-024. Overdue since: MIN RQ_EXPIRE_DT των overdue installments (CFINDD) vs NCIS Overdue_since. Loans με ληξιπρόθεσμα στο HUB
    SELECT 'LNS-024_OVERDUE_SINCE_MISMATCH', CC, AN, 'CFINDD=' || RH_OV_FIRST, TO_CHAR(N_OVSINCE, 'YYYY-MM-DD'),
           SUBSTR('MISMATCH (EXPECTED ' || NVL(TO_CHAR(T_OV_SINCE, 'YYYY-MM-DD'), 'EMPTY') || ')', 1, 50)
    FROM B
    WHERE NVL(RH_N_OV, 0) &gt; 0
      AND NVL(TRUNC(N_OVSINCE), DATE '0001-01-01') &lt;&gt; NVL(TRUNC(T_OV_SINCE), DATE '0001-01-01')
    UNION ALL
    --==============================================================
    --LNS-025. Overdue interest: Σ RQ_RL + RQ_URL_NRM_INT_BAL (REQUEST_LOAN_STS 2, 40200 / CHS-648) vs NCIS Total_Overdue_Interest
    SELECT 'LNS-025_OVERDUE_INTEREST_MISMATCH', CC, AN, TO_CHAR(ROUND(RH_OV_INT / DIV, 2)), TO_CHAR(N_OVINT),  -- HUB: Σ (CFINTP - (CFINPD - CFPRPD)) των O σε ευρώ
           SUBSTR('MISMATCH (EXPECTED ' || TO_CHAR(ROUND(NVL(T_OV_INT, 0), 2)) || ')', 1, 50)
    FROM B
    WHERE ABS(-1 * NVL(N_OVINT, 0) - NVL(T_OV_INT, 0)) &gt; 0.005  -- v2: -NCIS (χρεωστικά αρνητικά στο PROFITS)
    UNION ALL
    --==============================================================
    --LNS-026. Accrued interest: Σ RQ_ACR_NRM_INT_BAL (40200: EQDRIA / 10000 - EQDRIC / 100, αρνητικό -&gt; 0) vs NCIS
    --         v2 update: τιμή PROFITS από ONL_NRM_ACCR_BAL 'FROM MIGRATION' (PA_ACR), όχι από το NCIS_Loans (το
    --         04_LOANS.sql ψάχνει 'ΑΠΟ ΜΕΤΑΠΤΩΣΗ I': run 2026-11-18 26.314 εγγραφές 'FROM MIGRATION').
    --         Σύγκριση σε απόλυτη τιμή: το πρόσημο της VALEUR_BALANCE δεν έχει επιβεβαιωθεί (NCIS_VALUE το δείχνει όπως είναι)
    SELECT 'LNS-026_ACCRUED_INTEREST_MISMATCH', CC, AN, TO_CHAR(GREATEST(ROUND(ABS(EQDRIA / 10000) - ABS(EQDRIC / DIV), 2), 0)),  -- HUB: αποτέλεσμα του τύπου 40200
           TO_CHAR(PA_ACR),
           SUBSTR('MISMATCH (EXPECTED ' || TO_CHAR(ROUND(NVL(T_ACR, 0), 2)) || ')', 1, 50)
    FROM B
    WHERE ABS(ABS(NVL(PA_ACR, 0)) - NVL(T_ACR, 0)) &gt; 0.005
    UNION ALL
    --==============================================================
    --LNS-027. Penalty accruals: Σ RQ_ACR_PNL_INT_BAL (40200 γρ. 320, LSOIACP, αρνητικό -&gt; status 9) vs NCIS Penalty_Accruals_Amount
    SELECT 'LNS-027_PENALTY_ACCRUALS_MISMATCH', CC, AN,
           TO_CHAR((ABS(ROUND(EIOIIL / (DIV * 100), 2)) - ABS(ROUND(EIOCIL / DIV, 2))) + (ABS(ROUND(EIOIIN / (DIV * 100), 2)) - ABS(ROUND(EIOCIN / DIV, 2)))),  -- HUB: αποτέλεσμα του τύπου 40200 γρ. 320
           TO_CHAR(N_PNL),
           SUBSTR('MISMATCH (EXPECTED ' || TO_CHAR(ROUND(NVL(T_PNL, 0), 2)) || ')', 1, 50)
    FROM B
    WHERE ABS(-1 * NVL(N_PNL, 0) - NVL(T_PNL, 0)) &gt; 0.005  -- v2: -NCIS (χρεωστικά αρνητικά στο PROFITS)
    UNION ALL
    --==============================================================
    --LNS-028. Disbursement: ίδιο με το limit (90000 CHS-476: TOT_DRAWDOWN_AMN = ACC_LIMIT_AMN) vs NCIS Disbursement_Total_Amount
    SELECT 'LNS-028_DISBURSEMENT_MISMATCH', CC, AN,
           TO_CHAR(ROUND(X_LIMIT, 2)), TO_CHAR(N_DRAW),  -- HUB: το ποσό που διαλέγει το 40001, σε ευρώ
           SUBSTR('MISMATCH (EXPECTED ' || NVL(TO_CHAR(ROUND(X_LIMIT, 2)), 'EMPTY') || ')', 1, 50)
    FROM B
    WHERE N_DRAW IS NULL OR X_LIMIT IS NULL OR ABS(N_DRAW - X_LIMIT) &gt; 0.005
    UNION ALL
    --==============================================================
    --LNS-029. Remaining installments (043): REMAIN_INST_CNT (40200: INSTALL_COUNT - δόσεις P / O) vs NCIS
    SELECT 'LNS-029_REMAINING_INSTALLMENTS_MISMATCH', CC, AN,
           TO_CHAR(CASE WHEN POTERM LIKE '%Y%' THEN TO_NUMBER(REPLACE(POTERM, 'Y', '') DEFAULT NULL ON CONVERSION ERROR) * 12 WHEN POTERM LIKE '%M%' THEN TO_NUMBER(REPLACE(POTERM, 'M', '') DEFAULT NULL ON CONVERSION ERROR) END - NVL(RH_N_GEN, 0)), N_REMAIN,  -- HUB: δόσεις POTERM - δόσεις που δημιουργήθηκαν
           SUBSTR('MISMATCH (EXPECTED ' || NVL(TO_CHAR(T_REMAIN), 'EMPTY') || ')', 1, 50)
    FROM B
    WHERE M_FILETYPE = '043'
      AND NVL(N_REMAIN, 'X') &lt;&gt; NVL(TO_CHAR(T_REMAIN), 'X')
    UNION ALL
    --==============================================================
    --LNS-030. Next installment date: RNNISD (LSRPSLP, '99999999' -&gt; κενό) vs NCIS Next_Installment_Date
    --         v2: NEXT_PERIOD = το NCIS είναι ακριβώς μία περίοδο (INSTALL_FREQ μήνες) μετά το HUB: η δόση του HUB
    --             είχε ήδη περάσει όταν τρέξαμε στο PROFITS. Παραμένει FAIL, ξεχωρίζει από τις υπόλοιπες διαφορές
    SELECT 'LNS-030_NEXT_INSTALLMENT_DATE_MISMATCH', CC, AN, 'RNNISD=' || RNNISD, TO_CHAR(N_NEXTDT, 'YYYY-MM-DD'),
           CASE WHEN N_NEXTDT IS NULL THEN SUBSTR('NCIS_NULL (EXPECTED ' || TO_CHAR(X_NEXTDT, 'YYYY-MM-DD') || ')', 1, 50)
                WHEN X_NEXTDT IS NOT NULL
                 AND TRUNC(N_NEXTDT) = ADD_MONTHS(X_NEXTDT, NVL(TO_NUMBER(M_IFREQ DEFAULT NULL ON CONVERSION ERROR), 1))
                     THEN SUBSTR('NEXT_PERIOD (HUB ' || TO_CHAR(X_NEXTDT, 'YYYY-MM-DD') || ')', 1, 50)
                ELSE SUBSTR('MISMATCH (EXPECTED ' || NVL(TO_CHAR(X_NEXTDT, 'YYYY-MM-DD'), 'EMPTY') || ')', 1, 50) END
    FROM B
    WHERE NVL(TRUNC(N_NEXTDT), DATE '0001-01-01') &lt;&gt; NVL(X_NEXTDT, DATE '0001-01-01')
    UNION ALL
    --==============================================================
    --LNS-031. Next installment amount (043): INSTALLFIXED_AMN (40200: RNINAT / 100) vs NCIS Next_Installment_Amount
    SELECT 'LNS-031_NEXT_INSTALLMENT_AMOUNT_MISMATCH', CC, AN, 'RNINAT=' || TO_CHAR(RNINAT), TO_CHAR(N_INSTAMT),
           CASE WHEN N_INSTAMT IS NULL THEN SUBSTR('NCIS_NULL (EXPECTED ' || NVL(TO_CHAR(ROUND(T_INSTAMT, 2)), 'EMPTY') || ')', 1, 50)
                ELSE SUBSTR('MISMATCH (EXPECTED ' || NVL(TO_CHAR(ROUND(T_INSTAMT, 2)), 'EMPTY') || ')', 1, 50) END
    FROM B
    WHERE M_FILETYPE = '043'
      AND (N_INSTAMT IS NULL OR T_INSTAMT IS NULL OR ABS(N_INSTAMT - T_INSTAMT) &gt; 0.005)
)
SELECT
    CAST(CHECK_ID || '_' || TO_CHAR(ROW_NUMBER() OVER (PARTITION BY CHECK_ID ORDER BY CUSTOMER_CODE, SERIAL_NO), 'FM0000000') AS VARCHAR2(20)) AS DETAIL_ID,
    CAST(CHECK_ID AS VARCHAR2(10)) AS CHECK_ID,
    CAST(CHECK_NAME AS VARCHAR2(50)) AS CHECK_NAME,
    CAST(SUBSTR(CUSTOMER_CODE, 1, 30) AS VARCHAR2(30)) AS CUSTOMER_CODE,
    CAST(SUBSTR(SERIAL_NO, 1, 30) AS VARCHAR2(30)) AS SERIAL_NO,
    CAST(SUBSTR(HUB_VALUE, 1, 100) AS VARCHAR2(100)) AS HUB_VALUE,
    CAST(SUBSTR(NCIS_VALUE, 1, 100) AS VARCHAR2(100)) AS NCIS_VALUE,
    CAST(SUBSTR(ISSUE, 1, 50) AS VARCHAR2(50)) AS ISSUE,
    'DC5' AS DC_VERSION,
    1 AS RUN_VERSION,  -- TESTING ONLY: στο SSIS αντικαθίσταται από @[User::RunVersion] μέσω Derived Column.
    SYSDATE AS RUN_TIMESTAMP
FROM (
    SELECT
        F.*,
        CAST(SUBSTR(CHECK_NAME, 1, INSTR(CHECK_NAME, '_') - 1) AS VARCHAR2(10)) AS CHECK_ID
    FROM FINDINGS F
)
ORDER BY REGEXP_SUBSTR(CHECK_ID, '[A-Z]+'), TO_NUMBER(REGEXP_SUBSTR(CHECK_ID, '[0-9]+')), CUSTOMER_CODE, SERIAL_NO;</property>
