                      expressionType="Notify"
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">-- ====================================================================
-- GOV_RECON — MASTER DC5 v1 (Government Payments)
-- Τροφοδοτεί: RECON.GOV_RECON_MASTER (όνομα πίνακα προς επιβεβαίωση: δεν υπάρχει ακόμη στο
-- SSIS scripts\Recon_tables.sql)
-- Μία γραμμή ΑΝΑ CHECK_ID — 28 γραμμές ανά run: GOV-001 .. GOV-028.
--
-- Government Payments (ME01 HUB, EIM 240825, DD v1.24): HUB SS@HCLP / SS@HMTP / SS@HUSP / SS@HAPP vs
-- PROFITS CP_AGREEMENT / PROFITS_PARAM / CP_COMMITMENT / CP_PAYMENT_USERS.
-- ΔΕΝ υπάρχει NCIS extract: οι τιμές PROFITS διαβάζονται απευθείας από τους πίνακες (όπως τα Debit Cards).
-- Οι στήλες λέγονται NCIS_VALUE για συμβατότητα με το template.
-- Migration scripts: ΜΟΝΟ Migration Scripts\20261116_MigrationScripts (63000_GovPayments = DC5 "(2)", 10090, 10098)
-- (απόφαση χρήστη 2026-11-17).
-- Διαφορές DC4 -&gt; DC5: DC5\DC4_vs_DC5_MigrationScripts_GovPayments_Diff_Report.md.
-- Μορφή Master/Detail όπως το MasterDebitCards_DC5_v1.sql:
--   - ένα αυτοτελές SELECT, χωρίς views / πίνακες HGR_*. Το κοινό κομμάτι (CTEs) και το FINDINGS είναι ΙΔΙΑ
--     αυτούσια στο DetailGovPayments_DC5_v1.sql -&gt; INVALID_COUNT = γραμμές του Detail ανά CHECK_ID.
--     Τα INFO checks (GOV-022 .. GOV-028) υπολογίζονται μόνο εδώ, στο FINDINGS_COUNT.
--   - Παράγεται από τον generator (_generator\build.sh): gp_master_head + gp_common + gp_master_tail.
--   - HUB από synonyms σε DB link @Malta (10098): HUB_MT_SSHCLP, HUB_MT_SSHMTP, HUB_MT_SSHUSP, HUB_MT_SSHAPP,
--     HUB_MT_SSPMTP, HUB_MT_SSOTPP (αντίγραφα του 10090 με τις staged στήλες). Κάθε πίνακας ΜΙΑ φορά σε δικό
--     του CTE (R_*), μόνο οι στήλες που χρειάζονται.
--
-- ΑΡΧΗ: αναμενόμενη τιμή ΜΟΝΟ από τα scripts της μετάπτωσης (10090 + 63000 20261116):
--   - Scope: 10090 CP_AGREEMENT_NO = 82 για client IZLWU, 83 για OUFIMJ, NULL για τους υπόλοιπους.
--   - CP_AGREEMENT (UPDATE μόνο, οι γραμμές 82 / 83 είναι παραμετροποίηση): FK_ORGANIZ_CUSTOM = PRFT_CUST_ID του
--     owner (MG_CUSTOMER_INTER, χωρίς ROW_STATUS), TP_DEP_ACCOUNT_NO = staged HUB_MT_SSHCLP.DEPOSIT_ACCOUNT,
--     CP_AGREEMENT_DESCR = CLMNMC, LAST_COMMITMENT_NO = MAX(CP_COMMITMENT.TP_IDENTIFIER) (0 αν δεν υπάρχει).
--   - Λογαριασμός: το update του DEPOSIT_ACCOUNT στο 63000 είναι ημιτελές. Σύγκριση με την staged τιμή
--     (migration table, not HUB). Κενή -&gt; FAIL 'NO RULE' (απόφαση χρήστη 2026-11-17).
--   - PROFITS_PARAM 'GOVERMENT CHANNEL' (UPDATE μόνο): STRING_50 = CLAPIK. Οι τιμές ΔΕΝ εμφανίζονται (API key),
--     μόνο το μήκος τους.
--   - CP_COMMITMENT: ένα ανά mandate (SSHMTP.MTCLID = SSHCLP.CLCLID), κλειδί agreement + TP_IDENTIFIER (MERGE του
--     63000). INNER JOIN MG_CUSTOMER_INTER / CP_AGREEMENT / DEPOSIT_ACCOUNT -&gt; η αιτία στο ISSUE του GOV-010.
--     ACC_CUSTOMER_ID = PRFT_CUST_ID του πελάτη του mandate, FK_MAIN_DEP_ACC = λογαριασμός του agreement.
--   - CP_PAYMENT_USERS: approvers SS@HAPP (APPROVER_FLG 1, USER_LIMIT = APAPPL, MOBILE_PHONE = APMOBN) και users
--     SS@HUSP (APPROVER_FLG 0, USER_LIMIT = USPLMT). INNER JOIN mandate + MG_CUSTOMER_INTER. Όπως το 63000,
--     users ΟΛΩΝ των clients (εκτός scope -&gt; CP_AGREEMENT_NO NULL). Κλειδί agreement + TP_IDENTIFIER + USER_ID
--     + APPROVER_FLG. Αναμενόμενες γραμμές ανά κλειδί = γραμμές HUB x γραμμές MCI του πελάτη: περισσότερες στο
--     PROFITS -&gt; DUPLICATE (GOV-011 / 015 / 019).
--   - Πελάτης που δεν μεταφέρθηκε: ο κανόνας είναι του script, αλλά η εγγραφή λείπει από το PROFITS -&gt; FAIL με
--     γραμμές στο Detail (όπως DC-004 των Debit Cards).
--   - HUB_VALUE = τιμή HUB, NCIS_VALUE = τιμή PROFITS, αναμενόμενη τιμή στο ISSUE.
--   - Detail: CUSTOMER_CODE = πελάτης HUB, SERIAL_NO = agreement | agreement-TP | agreement-TP-USER_ID[-A]
--     (πραγματικό USER_ID, απόφαση χρήστη 2026-11-17).
--   - Μόνο checks HUB vs PROFITS (απόφαση χρήστη 2026-11-17).
--
-- ΑΝΤΙΣΤΟΙΧΙΑ με το DC4 Gov_Payments_recon_v2.sql (GOV-001..086, archive Scripts\Archived\GovPayments_20261117):
--   001 -&gt; 001 | 002 -&gt; 002 | 003 -&gt; 003 | 004 -&gt; 004 | 005 -&gt; 005 | 006 -&gt; 007 | 007 -&gt; 008 | 008 -&gt; 009
--   009 + 030 / 031 / 032 -&gt; 010 | 010 + 033 -&gt; 011 | 016 -&gt; 012 | 017 -&gt; 013 | 018 + 077 / 078 / 079 -&gt; 014
--   019 + 045 -&gt; 015 | 020 -&gt; 016 | 021 -&gt; 017 | 052 -&gt; 022 (INFO) | 055 -&gt; 023 (INFO) | 056 -&gt; 024 (INFO)
--   085 -&gt; 025 (INFO) | 086 -&gt; 026 (INFO) | 053 -&gt; 027 (INFO) | 046 -&gt; 028 (INFO)
--   Νέα (63000 20261116): 006 (LAST_COMMITMENT_NO), 018 / 019 / 020 / 021 (approvers, αντί για το INFO 057).
--   Αφαιρέθηκαν (όχι HUB vs PROFITS): 011-015 (τιμές μόνο από PROFITS: νόμισμα / μονάδα λογαριασμού, debit
--   justification), 022-029 (προϋποθέσεις), 034-044 (σταθερές τιμές, integrity), 047, 058-071 (data quality),
--   072-076 (totals / counts, καλύπτονται από τα παραπάνω), 080-083 (cross checks), 084 (όχι κανόνας του script).
--
-- STATUS: PASS (INVALID_COUNT = 0) / FAIL / INFO. DESCRIPTION: απλή περιγραφή χωρίς κωδικούς.
--
-- TOTAL_RECORDS ανά POPULATION_TYPE:
--   HUB_AGR      = in-scope clients (82 / 83) στο SSHCLP       CP_AGR       = CP_AGREEMENT 82 / 83
--   AGR_MATCHED  = in-scope clients με CP_AGREEMENT             PARAM_ROWS   = PROFITS_PARAM GOVERMENT CHANNEL 82 / 83
--   PARAM_MATCHED= in-scope clients με PROFITS_PARAM           HUB_MANDATES = mandates in-scope (agreement + TP)
--   CPC          = CP_COMMITMENT 82 / 83 (agreement + TP)       CMT_MATCHED  = mandates με CP_COMMITMENT
--   HUB_USERS / HUB_APPR = users / approvers HUB με mandate (κλειδιά)
--   CPU_USERS / CPU_APPR = CP_PAYMENT_USERS 82 / 83 / NULL, flag 0 / 1 (κλειδιά)
--   USR_MATCHED / APPR_MATCHED / ALL_MATCHED = κλειδιά HUB που υπάρχουν στο PROFITS
--   SSHCLP_ALL   = όλοι οι clients του SSHCLP                   HUB_USR_ALL  = γραμμές SSHUSP + SSHAPP
--   PMTP / OTPP  = γραμμές HUB_MT_SSPMTP / HUB_MT_SSOTPP          CPU_ALL      = όλες οι γραμμές CP_PAYMENT_USERS
-- ====================================================================
WITH
-- --------------------------------------------------------------------
-- Κοινό κομμάτι (ΙΔΙΟ αυτούσιο στο Master και στο Detail).
--   R_CLP  = HUB_MT_SSHCLP (synonym @Malta, 10098 / αντίγραφο του SS@HCLP από το 10090): clients.
--            AGR = CP_AGREEMENT_NO (10090: IZLWU -&gt; 82, OUFIMJ -&gt; 83, αλλιώς NULL), CC = CLDCB || LPAD(CLDCS,6,'0'),
--            STG_ACC = DEPOSIT_ACCOUNT (staged στήλη, migration table - το update του 63000 είναι ημιτελές).
--   R_MTP  = HUB_MT_SSHMTP (@Malta): mandates. TP = TP_IDENTIFIER (63000 MERGE: ROW_NUMBER ανά agreement).
--   R_USP  = HUB_MT_SSHUSP (@Malta): users.  R_APP = HUB_MT_SSHAPP (@Malta): approvers.
--   Κάθε πίνακας HUB διαβάζεται ΜΙΑ φορά, μόνο οι στήλες που χρειάζονται.
--   MCI    = MG_CUSTOMER_INTER ανά κωδικό πελάτη (63000: INNER JOIN χωρίς ROW_STATUS) -&gt; PRFT_CUST_ID, N γραμμές.
--   DAX    = DEPOSIT_ACCOUNT, μόνο οι staged λογαριασμοί των clients (63000: INNER JOIN DEPOSIT_ACCOUNT).
--   CPA    = CP_AGREEMENT 82 / 83.  GPP = PROFITS_PARAM 'GOVERMENT CHANNEL' 82 / 83.
--   AG     = in-scope clients (82 / 83) + αναμενόμενες τιμές + η γραμμή του CP_AGREEMENT.
--   CE     = mandates των in-scope clients (63000: SSHMTP.MTCLID = SSHCLP.CLCLID).
--   CEK    = ανά agreement + TP_IDENTIFIER (κλειδί του CP_COMMITMENT). X_N = γραμμές που αναμένονται στο
--            PROFITS (mandates που περνούν τα INNER JOIN του 63000 x γραμμές MCI του πελάτη).
--   XL     = ανά agreement: αναμενόμενο LAST_COMMITMENT_NO = MAX TP_IDENTIFIER των mandates που μεταφέρονται.
--   CPK    = CP_COMMITMENT 82 / 83 ανά agreement + TP_IDENTIFIER.  CMX = CEK που υπάρχουν στο CPK.
--   HUR    = users (APPROVER_FLG 0) και approvers (APPROVER_FLG 1) του HUB.
--   HU     = HUR + mandate (63000: INNER JOIN SSHMTP) + MCI. ΟΛΟΙ οι clients, όπως το 63000 (εκτός 82 / 83 -&gt;
--            CP_AGREEMENT_NO NULL στο PROFITS).
--   HUK    = ανά agreement + TP_IDENTIFIER + USER_ID + APPROVER_FLG (κλειδί του CP_PAYMENT_USERS).
--   CPUA   = CP_PAYMENT_USERS με CP_AGREEMENT_NO 82 / 83 ή NULL, ανά ίδιο κλειδί.  UM = HUK που υπάρχουν στο CPUA.
--   Κενό agreement / TP_IDENTIFIER = -1 και στις δύο πλευρές (εμφανίζεται 'NA' στο SERIAL_NO).
-- --------------------------------------------------------------------
R_CLP AS (
    SELECT /*+ MATERIALIZE */
           TRIM(TO_CHAR(CLCLID))            AS CLID,
           TO_NUMBER(TRIM(CP_AGREEMENT_NO)) AS AGR,
           TRIM(CUSTOMER_CODE)              AS CC,
           DEPOSIT_ACCOUNT                  AS STG_ACC,
           TRIM(CLMNMC)                     AS MNMC,
           TRIM(CLAPIK)                     AS APIK,
           CASE WHEN TRIM(CLIBAN) IS NOT NULL
                  OR NVL(TRIM(TO_CHAR(CLDAUT)), 'N') NOT IN ('N', '0')
                  OR NVL(TRIM(TO_CHAR(CLCOM)), '0')  &lt;&gt; '0'
                  OR NVL(TRIM(TO_CHAR(CLMINC)), '0') &lt;&gt; '0'
                  OR NVL(TRIM(TO_CHAR(CLMAXC)), '0') &lt;&gt; '0'
                THEN 1 ELSE 0 END           AS NOT_MIG
      FROM HUB_MT_SSHCLP
),
R_MTP AS (
    SELECT /*+ MATERIALIZE */
           TRIM(TO_CHAR(MTCLID))            AS CLID,
           TRIM(TO_CHAR(MTMTID))            AS MTID,
           TO_NUMBER(TRIM(CP_AGREEMENT_NO)) AS AGR,
           TRIM(CUSTOMER_CODE)              AS CC,
           TP_IDENTIFIER                    AS TP,
           CASE WHEN NVL(TRIM(TO_CHAR(MTDLMT)), '0') &lt;&gt; '0'
                  OR NVL(TRIM(TO_CHAR(MTALMT)), '0') &lt;&gt; '0'
                THEN 1 ELSE 0 END           AS LIM
      FROM HUB_MT_SSHMTP
),
R_USP AS (
    SELECT /*+ MATERIALIZE */
           TRIM(TO_CHAR(USCLID)) AS CLID,
           TRIM(TO_CHAR(USMTID)) AS MTID,
           TRIM(USUSID)          AS USR,
           TO_NUMBER(USPLMT)     AS LIM
      FROM HUB_MT_SSHUSP
),
R_APP AS (
    SELECT /*+ MATERIALIZE */
           TRIM(TO_CHAR(APCLID)) AS CLID,
           TRIM(TO_CHAR(APMTID)) AS MTID,
           TRIM(APUSID)          AS USR,
           TO_NUMBER(APAPPL)     AS LIM,
           TRIM(TO_CHAR(APMOBN)) AS MOB
      FROM HUB_MT_SSHAPP
),
MCI AS (
    SELECT /*+ MATERIALIZE */ TRIM(CUSTOMER_CODE) AS CC, MAX(PRFT_CUST_ID) AS PID, COUNT(*) AS N
      FROM MG_CUSTOMER_INTER
     GROUP BY TRIM(CUSTOMER_CODE)
),
DAX AS (
    SELECT DISTINCT d.ACCOUNT_NUMBER AS ACC
      FROM DEPOSIT_ACCOUNT d
     WHERE d.ACCOUNT_NUMBER IN (SELECT STG_ACC FROM R_CLP WHERE STG_ACC IS NOT NULL)
),
CPA AS (
    SELECT CP_AGREEMENT_NO           AS AGR,
           FK_ORGANIZ_CUSTOM         AS OWN,
           TP_DEP_ACCOUNT_NO         AS ACC,
           TRIM(CP_AGREEMENT_DESCR)  AS DESCR,
           LAST_COMMITMENT_NO        AS LCN
      FROM CP_AGREEMENT
     WHERE CP_AGREEMENT_NO IN (82, 83)
),
GPP AS (
    SELECT TRANSACT_ID AS AGR, TRIM(STRING_50) AS APIK
      FROM PROFITS_PARAM
     WHERE PARAM_NAME = 'GOVERMENT CHANNEL'
       AND TRANSACT_ID IN (82, 83)
),
AG AS (
    SELECT /*+ MATERIALIZE */
           c.CLID, c.AGR, c.CC, c.STG_ACC, c.MNMC, c.APIK, c.NOT_MIG,
           m.PID,
           CASE WHEN m.CC  IS NOT NULL THEN 'Y' ELSE 'N' END AS CUST_OK,
           CASE WHEN d.ACC IS NOT NULL THEN 'Y' ELSE 'N' END AS ACC_OK,
           CASE WHEN p.AGR IS NOT NULL THEN 'Y' ELSE 'N' END AS IN_CPA,
           p.OWN, p.ACC AS P_ACC, p.DESCR, p.LCN
      FROM R_CLP c
      LEFT JOIN MCI m ON m.CC  = c.CC
      LEFT JOIN DAX d ON d.ACC = c.STG_ACC
      LEFT JOIN CPA p ON p.AGR = c.AGR
     WHERE c.AGR IN (82, 83)
),
CE AS (
    SELECT a.AGR, NVL(m.TP, -1) AS TP, m.CC, m.LIM, mc.PID, mc.N AS MCI_N,
           a.STG_ACC, a.ACC_OK, a.IN_CPA
      FROM R_MTP m
      JOIN AG a        ON a.CLID = m.CLID
      LEFT JOIN MCI mc ON mc.CC  = m.CC
),
CEK AS (
    SELECT /*+ MATERIALIZE */
           AGR, TP,
           TO_CHAR(AGR) || '-' || CASE WHEN TP = -1 THEN 'NA' ELSE TO_CHAR(TP) END AS SKEY,
           COUNT(*)                                               AS NH,
           MIN(CC)                                                AS CC,
           MAX(PID)                                               AS PID,
           MAX(CASE WHEN MCI_N IS NOT NULL THEN 'Y' ELSE 'N' END) AS CUST_OK,
           MIN(STG_ACC)                                           AS ACC,
           MAX(ACC_OK)                                            AS ACC_OK,
           MAX(IN_CPA)                                            AS IN_CPA,
           MAX(LIM)                                               AS LIM,
           SUM(CASE WHEN MCI_N IS NOT NULL AND ACC_OK = 'Y' AND IN_CPA = 'Y' THEN MCI_N ELSE 0 END) AS X_N
      FROM CE
     GROUP BY AGR, TP
),
XL AS (
    SELECT AGR,
           COUNT(*)                                                  AS NK,
           SUM(CASE WHEN X_N &gt; 0 THEN 1 ELSE 0 END)                  AS NOK,
           NVL(MAX(CASE WHEN X_N &gt; 0 AND TP &lt;&gt; -1 THEN TP END), 0)   AS X_LCN
      FROM CEK
     GROUP BY AGR
),
CPK AS (
    SELECT /*+ MATERIALIZE */
           FK_REFER_CP_AGREEM          AS AGR,
           NVL(TP_IDENTIFIER, -1)      AS TP,
           COUNT(*)                    AS N,
           MIN(ACC_CUSTOMER_ID)        AS CID,
           MIN(FK_MAIN_DEP_ACC)        AS ACC
      FROM CP_COMMITMENT
     WHERE FK_REFER_CP_AGREEM IN (82, 83)
     GROUP BY FK_REFER_CP_AGREEM, NVL(TP_IDENTIFIER, -1)
),
CMX AS (
    SELECT e.AGR, e.TP, e.SKEY, e.CC, e.PID, e.ACC AS X_ACC, e.X_N,
           p.N, p.CID, p.ACC
      FROM CEK e
      JOIN CPK p ON p.AGR = e.AGR AND p.TP = e.TP
),
HUR AS (
    SELECT '0' AS FLG, u.CLID, u.MTID, u.USR, u.LIM, CAST(NULL AS VARCHAR2(40)) AS MOB FROM R_USP u
    UNION ALL
    SELECT '1', a.CLID, a.MTID, a.USR, a.LIM, a.MOB FROM R_APP a
),
HU AS (
    SELECT h.FLG, h.USR, h.LIM, h.MOB,
           NVL(m.AGR, -1) AS AGR, NVL(m.TP, -1) AS TP, m.CC,
           mc.PID, mc.N AS MCI_N
      FROM HUR h
      JOIN R_MTP m     ON m.CLID = h.CLID AND m.MTID = h.MTID
      LEFT JOIN MCI mc ON mc.CC  = m.CC
),
HUK AS (
    SELECT /*+ MATERIALIZE */
           FLG, AGR, TP, USR,
           CASE WHEN AGR = -1 THEN 'NA' ELSE TO_CHAR(AGR) END || '-'
             || CASE WHEN TP = -1 THEN 'NA' ELSE TO_CHAR(TP) END || '-' || USR
             || CASE WHEN FLG = '1' THEN '-A' END                    AS SKEY,
           COUNT(*)                                                  AS NH,
           MIN(CC)                                                   AS CC,
           MAX(PID)                                                  AS PID,
           MAX(CASE WHEN MCI_N IS NOT NULL THEN 'Y' ELSE 'N' END)    AS CUST_OK,
           MIN(LIM)                                                  AS LIM,
           MIN(MOB)                                                  AS MOB,
           SUM(NVL(MCI_N, 0))                                        AS X_N
      FROM HU
     GROUP BY FLG, AGR, TP, USR
),
CPUA AS (
    SELECT /*+ MATERIALIZE */
           NVL(CP_AGREEMENT_NO, -1)         AS AGR,
           NVL(TP_IDENTIFIER, -1)           AS TP,
           TRIM(USER_ID)                    AS USR,
           NVL(TRIM(APPROVER_FLG), '0')     AS FLG,
           CASE WHEN CP_AGREEMENT_NO IS NULL THEN 'NA' ELSE TO_CHAR(CP_AGREEMENT_NO) END || '-'
             || CASE WHEN TP_IDENTIFIER IS NULL THEN 'NA' ELSE TO_CHAR(TP_IDENTIFIER) END || '-' || TRIM(USER_ID)
             || CASE WHEN NVL(TRIM(APPROVER_FLG), '0') = '1' THEN '-A' END AS SKEY,
           COUNT(*)                         AS N,
           MIN(CUSTOMER_ID)                 AS CID,
           MIN(USER_LIMIT)                  AS LIM,
           MIN(TRIM(MOBILE_PHONE))          AS MOB
      FROM CP_PAYMENT_USERS
     WHERE CP_AGREEMENT_NO IS NULL OR CP_AGREEMENT_NO IN (82, 83)
     GROUP BY NVL(CP_AGREEMENT_NO, -1), NVL(TP_IDENTIFIER, -1), TRIM(USER_ID), NVL(TRIM(APPROVER_FLG), '0'),
              CASE WHEN CP_AGREEMENT_NO IS NULL THEN 'NA' ELSE TO_CHAR(CP_AGREEMENT_NO) END || '-'
                || CASE WHEN TP_IDENTIFIER IS NULL THEN 'NA' ELSE TO_CHAR(TP_IDENTIFIER) END || '-' || TRIM(USER_ID)
                || CASE WHEN NVL(TRIM(APPROVER_FLG), '0') = '1' THEN '-A' END
),
UM AS (
    SELECT h.FLG, h.SKEY, h.CC, h.PID, h.LIM AS X_LIM, h.MOB AS X_MOB,
           p.CID, p.LIM, p.MOB
      FROM HUK h
      JOIN CPUA p ON p.AGR = h.AGR AND p.TP = h.TP AND p.USR = h.USR AND p.FLG = h.FLG
),
FINDINGS AS (
    -- Μία γραμμή ανά εύρημα. CUSTOMER_CODE = πελάτης HUB (owner του client στα agreement checks, πελάτης του
    -- mandate στα commitment / user checks). SERIAL_NO = agreement | agreement-TP_IDENTIFIER |
    -- agreement-TP_IDENTIFIER-USER_ID (-A για approver). HUB_VALUE = τιμή HUB, NCIS_VALUE = τιμή PROFITS
    -- (δεν υπάρχει NCIS extract). Αναμενόμενη τιμή (μόνο από τα scripts) στο ISSUE.
    -- API key (CLAPIK / STRING_50): μόνο το μήκος, ποτέ η τιμή.
    --==============================================================
    --GOV-001. In-scope client του HUB (82 / 83) χωρίς γραμμή CP_AGREEMENT (το 63000 κάνει μόνο UPDATE).
    SELECT
      CAST('GOV-001_AGREEMENT_MISSING_IN_PROFITS' AS VARCHAR2(50)) AS CHECK_NAME,
      CAST(a.CC AS VARCHAR2(40)) AS CUSTOMER_CODE,
      CAST(TO_CHAR(a.AGR) AS VARCHAR2(40)) AS SERIAL_NO,
      CAST(SUBSTR('CLCLID=' || a.CLID || '; CLMNMC=' || a.MNMC, 1, 200) AS VARCHAR2(200)) AS HUB_VALUE,
      CAST(NULL AS VARCHAR2(200)) AS NCIS_VALUE,
      CAST('CP_AGREEMENT ROW NOT SET UP' AS VARCHAR2(50)) AS ISSUE
    FROM AG a
    WHERE a.IN_CPA = 'N'
    UNION ALL
    --==============================================================
    --GOV-002. CP_AGREEMENT 82 / 83 χωρίς in-scope client στο HUB_MT_SSHCLP.
    SELECT 'GOV-002_AGREEMENT_MISSING_IN_HUB', CAST(NULL AS VARCHAR2(40)), TO_CHAR(p.AGR),
           CAST(NULL AS VARCHAR2(200)),
           SUBSTR('OWNER=' || p.OWN || '; DESCR=' || p.DESCR, 1, 200),
           'NOT IN HUB SSHCLP'
    FROM CPA p
    WHERE NOT EXISTS (SELECT 1 FROM AG a WHERE a.AGR = p.AGR)
    UNION ALL
    --==============================================================
    --GOV-003. CP_AGREEMENT.FK_ORGANIZ_CUSTOM vs PRFT_CUST_ID του owner (63000: SSHCLP.PROFITS_CUST_ID από
    --         MG_CUSTOMER_INTER). Κενό owner = FAIL (ο πελάτης δεν μεταφέρθηκε).
    SELECT 'GOV-003_AGREEMENT_OWNER_MISMATCH', a.CC, TO_CHAR(a.AGR),
           a.CC, TO_CHAR(a.OWN),
           SUBSTR(CASE WHEN a.CUST_OK = 'N' THEN 'CUSTOMER NOT IN MG_CUSTOMER_INTER'
                       WHEN a.PID IS NULL   THEN 'CUSTOMER HAS NO PRFT_CUST_ID'
                       ELSE 'MISMATCH (EXPECTED ' || a.PID || ')' END, 1, 50)
    FROM AG a
    WHERE a.IN_CPA = 'Y'
      AND (a.OWN IS NULL OR a.PID IS NULL OR a.OWN &lt;&gt; a.PID)
    UNION ALL
    --==============================================================
    --GOV-004. CP_AGREEMENT.TP_DEP_ACCOUNT_NO vs HUB_MT_SSHCLP.DEPOSIT_ACCOUNT (staged, migration table:
    --         το update του 63000 είναι ημιτελές -&gt; απόφαση χρήστη 2026-11-17: σύγκριση με το staged).
    SELECT 'GOV-004_AGREEMENT_ACCOUNT_MISMATCH', a.CC, TO_CHAR(a.AGR),
           'STAGED DEPOSIT_ACCOUNT=' || a.STG_ACC, TO_CHAR(a.P_ACC),
           SUBSTR(CASE WHEN a.STG_ACC IS NULL THEN 'NO RULE: ACCOUNT NOT STAGED IN SSHCLP'
                       WHEN a.P_ACC IS NULL   THEN 'MISSING IN PROFITS (EXPECTED ' || a.STG_ACC || ')'
                       ELSE 'MISMATCH (EXPECTED ' || a.STG_ACC || ')' END, 1, 50)
    FROM AG a
    WHERE a.IN_CPA = 'Y'
      AND (a.STG_ACC IS NULL OR a.P_ACC IS NULL OR a.P_ACC &lt;&gt; a.STG_ACC)
    UNION ALL
    --==============================================================
    --GOV-005. CP_AGREEMENT.CP_AGREEMENT_DESCR vs CLMNMC.
    SELECT 'GOV-005_AGREEMENT_DESCR_MISMATCH', a.CC, TO_CHAR(a.AGR),
           a.MNMC, a.DESCR,
           SUBSTR('MISMATCH (EXPECTED ' || NVL(a.MNMC, 'EMPTY') || ')', 1, 50)
    FROM AG a
    WHERE a.IN_CPA = 'Y'
      AND NVL(a.DESCR, '~') &lt;&gt; NVL(a.MNMC, '~')
    UNION ALL
    --==============================================================
    --GOV-006. CP_AGREEMENT.LAST_COMMITMENT_NO vs MAX TP_IDENTIFIER των mandates που μεταφέρονται
    --         (63000 20261116: MAX(CP_COMMITMENT.TP_IDENTIFIER), 0 αν δεν υπάρχει).
    SELECT 'GOV-006_LAST_COMMITMENT_NO_MISMATCH', a.CC, TO_CHAR(a.AGR),
           'MANDATES=' || NVL(x.NK, 0) || '; MIGRATABLE=' || NVL(x.NOK, 0), TO_CHAR(a.LCN),
           'MISMATCH (EXPECTED ' || NVL(x.X_LCN, 0) || ')'
    FROM AG a
    LEFT JOIN XL x ON x.AGR = a.AGR
    WHERE a.IN_CPA = 'Y'
      AND NVL(a.LCN, -1) &lt;&gt; NVL(x.X_LCN, 0)
    UNION ALL
    --==============================================================
    --GOV-007. In-scope client χωρίς PROFITS_PARAM 'GOVERMENT CHANNEL' (το 63000 κάνει μόνο UPDATE).
    SELECT 'GOV-007_API_KEY_MISSING_IN_PROFITS', a.CC, TO_CHAR(a.AGR),
           CASE WHEN a.APIK IS NOT NULL THEN '*** (LEN ' || LENGTH(a.APIK) || ')' END,
           CAST(NULL AS VARCHAR2(200)),
           'GOVERMENT CHANNEL ROW NOT SET UP'
    FROM AG a
    WHERE NOT EXISTS (SELECT 1 FROM GPP g WHERE g.AGR = a.AGR)
    UNION ALL
    --==============================================================
    --GOV-008. PROFITS_PARAM 'GOVERMENT CHANNEL' 82 / 83 χωρίς in-scope client στο HUB.
    SELECT 'GOV-008_API_KEY_MISSING_IN_HUB', CAST(NULL AS VARCHAR2(40)), TO_CHAR(g.AGR),
           CAST(NULL AS VARCHAR2(200)),
           CASE WHEN g.APIK IS NOT NULL THEN '*** (LEN ' || LENGTH(g.APIK) || ')' END,
           'NOT IN HUB SSHCLP'
    FROM GPP g
    WHERE NOT EXISTS (SELECT 1 FROM AG a WHERE a.AGR = g.AGR)
    UNION ALL
    --==============================================================
    --GOV-009. PROFITS_PARAM.STRING_50 vs CLAPIK (τιμές masked).
    SELECT 'GOV-009_API_KEY_MISMATCH', a.CC, TO_CHAR(a.AGR),
           CASE WHEN a.APIK IS NOT NULL THEN '*** (LEN ' || LENGTH(a.APIK) || ')' END,
           CASE WHEN g.APIK IS NOT NULL THEN '*** (LEN ' || LENGTH(g.APIK) || ')' END,
           'MISMATCH (VALUES MASKED)'
    FROM AG a
    JOIN GPP g ON g.AGR = a.AGR
    WHERE NVL(g.APIK, '~') &lt;&gt; NVL(a.APIK, '~')
    UNION ALL
    --==============================================================
    --GOV-010. Mandate in-scope client χωρίς CP_COMMITMENT (agreement + TP_IDENTIFIER). ISSUE = αιτία από τα
    --         INNER JOIN του 63000 (CP_AGREEMENT, MG_CUSTOMER_INTER, DEPOSIT_ACCOUNT).
    SELECT 'GOV-010_COMMITMENT_MISSING_IN_PROFITS', e.CC, e.SKEY,
           SUBSTR('CUSTOMER ' || e.CC || '; STAGED ACCOUNT ' || NVL(TO_CHAR(e.ACC), 'EMPTY')
                  || CASE WHEN e.NH &gt; 1 THEN '; HUB ROWS ' || e.NH END, 1, 200),
           CAST(NULL AS VARCHAR2(200)),
           CASE WHEN e.IN_CPA  = 'N' THEN 'CP_AGREEMENT ROW NOT SET UP'
                WHEN e.CUST_OK = 'N' THEN 'CUSTOMER NOT IN MG_CUSTOMER_INTER'
                WHEN e.ACC IS NULL   THEN 'AGREEMENT ACCOUNT NOT STAGED'
                WHEN e.ACC_OK  = 'N' THEN 'ACCOUNT NOT IN DEPOSIT_ACCOUNT'
                WHEN e.TP = -1       THEN 'NO TP_IDENTIFIER, NOT IN PROFITS'
                ELSE 'MISSING IN PROFITS' END
    FROM CEK e
    WHERE NOT EXISTS (SELECT 1 FROM CPK p WHERE p.AGR = e.AGR AND p.TP = e.TP)
    UNION ALL
    --==============================================================
    --GOV-011. CP_COMMITMENT 82 / 83 χωρίς mandate στο HUB, ή με περισσότερες γραμμές από όσες βγάζει το 63000.
    SELECT 'GOV-011_COMMITMENT_MISSING_IN_HUB', e.CC,
           TO_CHAR(p.AGR) || '-' || CASE WHEN p.TP = -1 THEN 'NA' ELSE TO_CHAR(p.TP) END,
           CASE WHEN e.AGR IS NOT NULL THEN 'EXPECTED ROWS ' || e.X_N END,
           SUBSTR('ROWS=' || p.N || '; CUSTOMER=' || p.CID || '; ACCOUNT=' || p.ACC, 1, 200),
           SUBSTR(CASE WHEN e.AGR IS NULL THEN 'NOT IN HUB SSHMTP'
                       WHEN e.X_N = 0     THEN 'NOT EXPECTED: FAILS MIGRATION RULES'
                       ELSE 'DUPLICATE IN PROFITS (' || p.N || ' ROWS)' END, 1, 50)
    FROM CPK p
    LEFT JOIN CEK e ON e.AGR = p.AGR AND e.TP = p.TP
    WHERE e.AGR IS NULL OR p.N &gt; e.X_N
    UNION ALL
    --==============================================================
    --GOV-012. CP_COMMITMENT.ACC_CUSTOMER_ID vs PRFT_CUST_ID του πελάτη του mandate.
    SELECT 'GOV-012_COMMITMENT_CUSTOMER_MISMATCH', m.CC, m.SKEY,
           m.CC, TO_CHAR(m.CID),
           SUBSTR(CASE WHEN m.PID IS NULL THEN 'CUSTOMER HAS NO PRFT_CUST_ID'
                       ELSE 'MISMATCH (EXPECTED ' || m.PID || ')' END, 1, 50)
    FROM CMX m
    WHERE m.CID IS NULL OR m.PID IS NULL OR m.CID &lt;&gt; m.PID
    UNION ALL
    --==============================================================
    --GOV-013. CP_COMMITMENT.FK_MAIN_DEP_ACC vs λογαριασμός του agreement (staged DEPOSIT_ACCOUNT).
    SELECT 'GOV-013_COMMITMENT_ACCOUNT_MISMATCH', m.CC, m.SKEY,
           'STAGED DEPOSIT_ACCOUNT=' || m.X_ACC, TO_CHAR(m.ACC),
           SUBSTR(CASE WHEN m.X_ACC IS NULL THEN 'NO RULE: ACCOUNT NOT STAGED IN SSHCLP'
                       ELSE 'MISMATCH (EXPECTED ' || m.X_ACC || ')' END, 1, 50)
    FROM CMX m
    WHERE m.X_ACC IS NULL OR m.ACC IS NULL OR m.ACC &lt;&gt; m.X_ACC
    UNION ALL
    --==============================================================
    --GOV-014. User του HUB (SS@HUSP με mandate) χωρίς CP_PAYMENT_USERS με APPROVER_FLG 0.
    SELECT 'GOV-014_USER_MISSING_IN_PROFITS', h.CC, h.SKEY,
           'USPLMT=' || h.LIM || CASE WHEN h.NH &gt; 1 THEN '; HUB ROWS ' || h.NH END,
           CAST(NULL AS VARCHAR2(200)),
           CASE WHEN h.CUST_OK = 'N' THEN 'CUSTOMER NOT IN MG_CUSTOMER_INTER'
                WHEN h.TP = -1       THEN 'NO TP_IDENTIFIER, NOT IN PROFITS'
                ELSE 'MISSING IN PROFITS' END
    FROM HUK h
    WHERE h.FLG = '0'
      AND NOT EXISTS (SELECT 1 FROM CPUA p
                       WHERE p.AGR = h.AGR AND p.TP = h.TP AND p.USR = h.USR AND p.FLG = h.FLG)
    UNION ALL
    --==============================================================
    --GOV-015. CP_PAYMENT_USERS (APPROVER_FLG 0) χωρίς user στο HUB, ή με περισσότερες γραμμές από όσες βγάζει
    --         το 63000 (π.χ. rerun του 2ου insert, που δεν έχει NOT EXISTS).
    SELECT 'GOV-015_USER_MISSING_IN_HUB', h.CC, p.SKEY,
           CASE WHEN h.USR IS NOT NULL THEN 'EXPECTED ROWS ' || h.X_N END,
           SUBSTR('ROWS=' || p.N || '; CUSTOMER=' || p.CID || '; LIMIT=' || p.LIM, 1, 200),
           SUBSTR(CASE WHEN h.USR IS NULL THEN 'NOT IN HUB SSHUSP'
                       WHEN h.X_N = 0     THEN 'NOT EXPECTED: FAILS MIGRATION RULES'
                       ELSE 'DUPLICATE IN PROFITS (' || p.N || ' ROWS)' END, 1, 50)
    FROM CPUA p
    LEFT JOIN HUK h ON h.AGR = p.AGR AND h.TP = p.TP AND h.USR = p.USR AND h.FLG = p.FLG
    WHERE p.FLG = '0'
      AND (h.USR IS NULL OR p.N &gt; h.X_N)
    UNION ALL
    --==============================================================
    --GOV-016. CP_PAYMENT_USERS.CUSTOMER_ID vs PRFT_CUST_ID του πελάτη του mandate (users και approvers).
    SELECT 'GOV-016_USER_CUSTOMER_MISMATCH', m.CC, m.SKEY,
           m.CC, TO_CHAR(m.CID),
           SUBSTR(CASE WHEN m.PID IS NULL THEN 'CUSTOMER HAS NO PRFT_CUST_ID'
                       ELSE 'MISMATCH (EXPECTED ' || m.PID || ')' END, 1, 50)
    FROM UM m
    WHERE m.CID IS NULL OR m.PID IS NULL OR m.CID &lt;&gt; m.PID
    UNION ALL
    --==============================================================
    --GOV-017. CP_PAYMENT_USERS.USER_LIMIT (APPROVER_FLG 0) vs USPLMT.
    SELECT 'GOV-017_USER_LIMIT_MISMATCH', m.CC, m.SKEY,
           TO_CHAR(m.X_LIM), TO_CHAR(m.LIM),
           SUBSTR('MISMATCH (EXPECTED ' || NVL(TO_CHAR(m.X_LIM), 'EMPTY') || ')', 1, 50)
    FROM UM m
    WHERE m.FLG = '0'
      AND NVL(m.LIM, -1) &lt;&gt; NVL(m.X_LIM, -1)
    UNION ALL
    --==============================================================
    --GOV-018. Approver του HUB (SS@HAPP με mandate) χωρίς CP_PAYMENT_USERS με APPROVER_FLG 1 (νέο στο 63000).
    SELECT 'GOV-018_APPROVER_MISSING_IN_PROFITS', h.CC, h.SKEY,
           SUBSTR('APAPPL=' || h.LIM || '; APMOBN=' || h.MOB || CASE WHEN h.NH &gt; 1 THEN '; HUB ROWS ' || h.NH END, 1, 200),
           CAST(NULL AS VARCHAR2(200)),
           CASE WHEN h.CUST_OK = 'N' THEN 'CUSTOMER NOT IN MG_CUSTOMER_INTER'
                WHEN h.TP = -1       THEN 'NO TP_IDENTIFIER, NOT IN PROFITS'
                ELSE 'MISSING IN PROFITS' END
    FROM HUK h
    WHERE h.FLG = '1'
      AND NOT EXISTS (SELECT 1 FROM CPUA p
                       WHERE p.AGR = h.AGR AND p.TP = h.TP AND p.USR = h.USR AND p.FLG = h.FLG)
    UNION ALL
    --==============================================================
    --GOV-019. CP_PAYMENT_USERS (APPROVER_FLG 1) χωρίς approver στο HUB, ή διπλές γραμμές.
    SELECT 'GOV-019_APPROVER_MISSING_IN_HUB', h.CC, p.SKEY,
           CASE WHEN h.USR IS NOT NULL THEN 'EXPECTED ROWS ' || h.X_N END,
           SUBSTR('ROWS=' || p.N || '; CUSTOMER=' || p.CID || '; LIMIT=' || p.LIM, 1, 200),
           SUBSTR(CASE WHEN h.USR IS NULL THEN 'NOT IN HUB SSHAPP'
                       WHEN h.X_N = 0     THEN 'NOT EXPECTED: FAILS MIGRATION RULES'
                       ELSE 'DUPLICATE IN PROFITS (' || p.N || ' ROWS)' END, 1, 50)
    FROM CPUA p
    LEFT JOIN HUK h ON h.AGR = p.AGR AND h.TP = p.TP AND h.USR = p.USR AND h.FLG = p.FLG
    WHERE p.FLG = '1'
      AND (h.USR IS NULL OR p.N &gt; h.X_N)
    UNION ALL
    --==============================================================
    --GOV-020. CP_PAYMENT_USERS.USER_LIMIT (APPROVER_FLG 1) vs APAPPL.
    SELECT 'GOV-020_APPROVER_LIMIT_MISMATCH', m.CC, m.SKEY,
           TO_CHAR(m.X_LIM), TO_CHAR(m.LIM),
           SUBSTR('MISMATCH (EXPECTED ' || NVL(TO_CHAR(m.X_LIM), 'EMPTY') || ')', 1, 50)
    FROM UM m
    WHERE m.FLG = '1'
      AND NVL(m.LIM, -1) &lt;&gt; NVL(m.X_LIM, -1)
    UNION ALL
    --==============================================================
    --GOV-021. CP_PAYMENT_USERS.MOBILE_PHONE (APPROVER_FLG 1) vs APMOBN.
    SELECT 'GOV-021_APPROVER_MOBILE_MISMATCH', m.CC, m.SKEY,
           m.X_MOB, m.MOB,
           SUBSTR('MISMATCH (EXPECTED ' || NVL(m.X_MOB, 'EMPTY') || ')', 1, 50)
    FROM UM m
    WHERE m.FLG = '1'
      AND NVL(m.MOB, '~') &lt;&gt; NVL(m.X_MOB, '~')
)
,
POPULATIONS AS (
    SELECT
        (SELECT COUNT(*) FROM AG)                                    AS HUB_AGR_COUNT,
        (SELECT COUNT(*) FROM CPA)                                   AS CP_AGR_COUNT,
        (SELECT COUNT(*) FROM AG WHERE IN_CPA = 'Y')                 AS AGR_MATCHED_COUNT,
        (SELECT COUNT(*) FROM GPP)                                   AS PARAM_ROWS_COUNT,
        (SELECT COUNT(*) FROM AG a JOIN GPP g ON g.AGR = a.AGR)      AS PARAM_MATCHED_COUNT,
        (SELECT COUNT(*) FROM CEK)                                   AS HUB_MANDATES_COUNT,
        (SELECT COUNT(*) FROM CPK)                                   AS CPC_COUNT,
        (SELECT COUNT(*) FROM CMX)                                   AS CMT_MATCHED_COUNT,
        (SELECT COUNT(*) FROM HUK WHERE FLG = '0')                   AS HUB_USERS_COUNT,
        (SELECT COUNT(*) FROM CPUA WHERE FLG = '0')                  AS CPU_USERS_COUNT,
        (SELECT COUNT(*) FROM UM WHERE FLG = '0')                    AS USR_MATCHED_COUNT,
        (SELECT COUNT(*) FROM HUK WHERE FLG = '1')                   AS HUB_APPR_COUNT,
        (SELECT COUNT(*) FROM CPUA WHERE FLG = '1')                  AS CPU_APPR_COUNT,
        (SELECT COUNT(*) FROM UM WHERE FLG = '1')                    AS APPR_MATCHED_COUNT,
        (SELECT COUNT(*) FROM UM)                                    AS ALL_MATCHED_COUNT,
        (SELECT COUNT(*) FROM R_CLP)                                 AS SSHCLP_ALL_COUNT,
        (SELECT COUNT(*) FROM HUR)                                   AS HUB_USR_ALL_COUNT,
        (SELECT COUNT(*) FROM HUB_MT_SSPMTP)                         AS PMTP_COUNT,
        (SELECT COUNT(*) FROM HUB_MT_SSOTPP)                         AS OTPP_COUNT,
        (SELECT COUNT(*) FROM CP_PAYMENT_USERS)                      AS CPU_ALL_COUNT
    FROM DUAL
),
CHECK_META AS (
    -- CHECK_ID | CHECK_NAME | CATEGORY | DESCRIPTION | POPULATION_TYPE
    SELECT 'GOV-001' AS CHECK_ID, 'GOV-001_AGREEMENT_MISSING_IN_PROFITS' AS CHECK_NAME, 'EXISTENCE' AS CATEGORY, 'HUB government payment clients that the migration maps to an agreement but that have no agreement row in PROFITS.' AS DESCRIPTION, 'HUB_AGR' AS POPULATION_TYPE FROM DUAL UNION ALL
    SELECT 'GOV-002', 'GOV-002_AGREEMENT_MISSING_IN_HUB',          'EXISTENCE',             'Government payment agreements in PROFITS with no HUB client mapped to them.', 'CP_AGR' FROM DUAL UNION ALL
    SELECT 'GOV-003', 'GOV-003_AGREEMENT_OWNER_MISMATCH',          'CROSS_SYSTEM_MISMATCH', 'The agreement owner in PROFITS is empty or is not the migrated HUB client customer.', 'AGR_MATCHED' FROM DUAL UNION ALL
    SELECT 'GOV-004', 'GOV-004_AGREEMENT_ACCOUNT_MISMATCH',        'CROSS_SYSTEM_MISMATCH', 'The agreement account in PROFITS differs from the account staged for the HUB client. The migration rule for this account is incomplete.', 'AGR_MATCHED' FROM DUAL UNION ALL
    SELECT 'GOV-005', 'GOV-005_AGREEMENT_DESCR_MISMATCH',          'CROSS_SYSTEM_MISMATCH', 'The agreement description in PROFITS differs from the HUB client mnemonic.', 'AGR_MATCHED' FROM DUAL UNION ALL
    SELECT 'GOV-006', 'GOV-006_LAST_COMMITMENT_NO_MISMATCH',       'CROSS_SYSTEM_MISMATCH', 'The last commitment number of the agreement in PROFITS differs from the highest number of the HUB mandates that the migration loads.', 'AGR_MATCHED' FROM DUAL UNION ALL
    SELECT 'GOV-007', 'GOV-007_API_KEY_MISSING_IN_PROFITS',        'EXISTENCE',             'HUB government payment clients with no government channel parameter row in PROFITS to hold the API key.', 'HUB_AGR' FROM DUAL UNION ALL
    SELECT 'GOV-008', 'GOV-008_API_KEY_MISSING_IN_HUB',            'EXISTENCE',             'Government channel parameter rows in PROFITS with no HUB client mapped to the agreement.', 'PARAM_ROWS' FROM DUAL UNION ALL
    SELECT 'GOV-009', 'GOV-009_API_KEY_MISMATCH',                  'CROSS_SYSTEM_MISMATCH', 'The API key in PROFITS differs from the HUB client API key. Values are not shown, only their length.', 'PARAM_MATCHED' FROM DUAL UNION ALL
    SELECT 'GOV-010', 'GOV-010_COMMITMENT_MISSING_IN_PROFITS',     'EXISTENCE',             'HUB mandates of the migrated clients with no commitment in PROFITS. The detail rows give the reason from the migration rules.', 'HUB_MANDATES' FROM DUAL UNION ALL
    SELECT 'GOV-011', 'GOV-011_COMMITMENT_MISSING_IN_HUB',         'EXISTENCE',             'Commitments in PROFITS with no HUB mandate, or held more times than the migration loads them.', 'CPC' FROM DUAL UNION ALL
    SELECT 'GOV-012', 'GOV-012_COMMITMENT_CUSTOMER_MISMATCH',      'CROSS_SYSTEM_MISMATCH', 'The commitment customer in PROFITS is empty or is not the migrated HUB mandate customer.', 'CMT_MATCHED' FROM DUAL UNION ALL
    SELECT 'GOV-013', 'GOV-013_COMMITMENT_ACCOUNT_MISMATCH',       'CROSS_SYSTEM_MISMATCH', 'The commitment account in PROFITS differs from the account staged for the HUB client of the mandate.', 'CMT_MATCHED' FROM DUAL UNION ALL
    SELECT 'GOV-014', 'GOV-014_USER_MISSING_IN_PROFITS',           'EXISTENCE',             'HUB payment users linked to a mandate with no payment user row in PROFITS. The detail rows give the reason from the migration rules.', 'HUB_USERS' FROM DUAL UNION ALL
    SELECT 'GOV-015', 'GOV-015_USER_MISSING_IN_HUB',               'EXISTENCE',             'Payment users in PROFITS with no HUB user, or held more times than the migration loads them.', 'CPU_USERS' FROM DUAL UNION ALL
    SELECT 'GOV-016', 'GOV-016_USER_CUSTOMER_MISMATCH',            'CROSS_SYSTEM_MISMATCH', 'The customer of a payment user or approver in PROFITS is empty or is not the migrated HUB mandate customer.', 'ALL_MATCHED' FROM DUAL UNION ALL
    SELECT 'GOV-017', 'GOV-017_USER_LIMIT_MISMATCH',               'CROSS_SYSTEM_MISMATCH', 'The payment user limit in PROFITS differs from the HUB user limit.', 'USR_MATCHED' FROM DUAL UNION ALL
    SELECT 'GOV-018', 'GOV-018_APPROVER_MISSING_IN_PROFITS',       'EXISTENCE',             'HUB payment approvers linked to a mandate with no approver row in PROFITS. The detail rows give the reason from the migration rules.', 'HUB_APPR' FROM DUAL UNION ALL
    SELECT 'GOV-019', 'GOV-019_APPROVER_MISSING_IN_HUB',           'EXISTENCE',             'Approver rows in PROFITS with no HUB approver, or held more times than the migration loads them.', 'CPU_APPR' FROM DUAL UNION ALL
    SELECT 'GOV-020', 'GOV-020_APPROVER_LIMIT_MISMATCH',           'CROSS_SYSTEM_MISMATCH', 'The approver limit in PROFITS differs from the HUB approver limit.', 'APPR_MATCHED' FROM DUAL UNION ALL
    SELECT 'GOV-021', 'GOV-021_APPROVER_MOBILE_MISMATCH',          'CROSS_SYSTEM_MISMATCH', 'The approver mobile number in PROFITS differs from the HUB approver mobile number.', 'APPR_MATCHED' FROM DUAL UNION ALL
    SELECT 'GOV-022', 'GOV-022_CLIENTS_OUT_OF_SCOPE',              'INFO',                  'Information only: HUB government payment clients that the migration does not map to an agreement. No detail rows.', 'SSHCLP_ALL' FROM DUAL UNION ALL
    SELECT 'GOV-023', 'GOV-023_CLIENT_VALUES_NOT_MIGRATED',        'INFO',                  'Information only: migrated HUB clients with an IBAN, dual authorisation or commission values, which the migration does not load. No detail rows.', 'HUB_AGR' FROM DUAL UNION ALL
    SELECT 'GOV-024', 'GOV-024_MANDATE_LIMITS_NOT_MIGRATED',       'INFO',                  'Information only: HUB mandates with daily or available limits, which the migration does not load (commitment limit set to 0). No detail rows.', 'HUB_MANDATES' FROM DUAL UNION ALL
    SELECT 'GOV-025', 'GOV-025_HUB_PAYMENT_FILE_NOT_MIGRATED',     'INFO',                  'Information only: rows in the HUB government payments file, which no migration script loads. No detail rows.', 'PMTP' FROM DUAL UNION ALL
    SELECT 'GOV-026', 'GOV-026_HUB_OTP_FILE_NOT_MIGRATED',         'INFO',                  'Information only: rows in the HUB one-time password file, which no migration script loads. No detail rows.', 'OTPP' FROM DUAL UNION ALL
    SELECT 'GOV-027', 'GOV-027_HUB_USERS_WITHOUT_MANDATE',         'INFO',                  'Information only: HUB payment users and approvers with no HUB mandate, which the migration does not load. No detail rows.', 'HUB_USR_ALL' FROM DUAL UNION ALL
    SELECT 'GOV-028', 'GOV-028_PROFITS_USERS_OUTSIDE_AGREEMENTS',  'INFO',                  'Information only: payment user rows in PROFITS outside the two migrated agreements. The migration loads users of every HUB client. No detail rows.', 'CPU_ALL' FROM DUAL
),
FINDINGS_COUNT AS (
    SELECT CHECK_ID, COUNT(*) AS INVALID_COUNT
    FROM (SELECT SUBSTR(CHECK_NAME, 1, INSTR(CHECK_NAME, '_') - 1) AS CHECK_ID FROM FINDINGS)
    GROUP BY CHECK_ID
    UNION ALL
    -- INFO, μόνο Master (χωρίς γραμμές στο Detail)
    SELECT 'GOV-022', COUNT(*) FROM R_CLP WHERE AGR IS NULL OR AGR NOT IN (82, 83) -- INFO
    UNION ALL
    SELECT 'GOV-023', COUNT(*) FROM AG WHERE NOT_MIG = 1 -- INFO
    UNION ALL
    SELECT 'GOV-024', COUNT(*) FROM CEK WHERE LIM = 1 -- INFO
    UNION ALL
    SELECT 'GOV-025', P.PMTP_COUNT FROM POPULATIONS P -- INFO
    UNION ALL
    SELECT 'GOV-026', P.OTPP_COUNT FROM POPULATIONS P -- INFO
    UNION ALL
    SELECT 'GOV-027', COUNT(*) FROM HUR h WHERE NOT EXISTS (SELECT 1 FROM R_MTP m WHERE m.CLID = h.CLID AND m.MTID = h.MTID) -- INFO
    UNION ALL
    SELECT 'GOV-028', COUNT(*) FROM CP_PAYMENT_USERS WHERE CP_AGREEMENT_NO IS NULL OR CP_AGREEMENT_NO NOT IN (82, 83) -- INFO
)
SELECT
    CAST(CM.CHECK_ID AS VARCHAR2(10)) AS CHECK_ID,
    CAST(CM.CHECK_NAME AS VARCHAR2(50)) AS CHECK_NAME,
    CAST(CM.CATEGORY AS VARCHAR2(30)) AS CATEGORY,
    CAST(CM.DESCRIPTION AS VARCHAR2(200)) AS DESCRIPTION,
    (CASE CM.POPULATION_TYPE
        WHEN 'HUB_AGR'       THEN P.HUB_AGR_COUNT
        WHEN 'CP_AGR'        THEN P.CP_AGR_COUNT
        WHEN 'AGR_MATCHED'   THEN P.AGR_MATCHED_COUNT
        WHEN 'PARAM_ROWS'    THEN P.PARAM_ROWS_COUNT
        WHEN 'PARAM_MATCHED' THEN P.PARAM_MATCHED_COUNT
        WHEN 'HUB_MANDATES'  THEN P.HUB_MANDATES_COUNT
        WHEN 'CPC'           THEN P.CPC_COUNT
        WHEN 'CMT_MATCHED'   THEN P.CMT_MATCHED_COUNT
        WHEN 'HUB_USERS'     THEN P.HUB_USERS_COUNT
        WHEN 'CPU_USERS'     THEN P.CPU_USERS_COUNT
        WHEN 'USR_MATCHED'   THEN P.USR_MATCHED_COUNT
        WHEN 'HUB_APPR'      THEN P.HUB_APPR_COUNT
        WHEN 'CPU_APPR'      THEN P.CPU_APPR_COUNT
        WHEN 'APPR_MATCHED'  THEN P.APPR_MATCHED_COUNT
        WHEN 'ALL_MATCHED'   THEN P.ALL_MATCHED_COUNT
        WHEN 'SSHCLP_ALL'    THEN P.SSHCLP_ALL_COUNT
        WHEN 'HUB_USR_ALL'   THEN P.HUB_USR_ALL_COUNT
        WHEN 'PMTP'          THEN P.PMTP_COUNT
        WHEN 'OTPP'          THEN P.OTPP_COUNT
        WHEN 'CPU_ALL'       THEN P.CPU_ALL_COUNT
     END) AS TOTAL_RECORDS,
    (CASE CM.POPULATION_TYPE
        WHEN 'HUB_AGR'       THEN P.HUB_AGR_COUNT
        WHEN 'CP_AGR'        THEN P.CP_AGR_COUNT
        WHEN 'AGR_MATCHED'   THEN P.AGR_MATCHED_COUNT
        WHEN 'PARAM_ROWS'    THEN P.PARAM_ROWS_COUNT
        WHEN 'PARAM_MATCHED' THEN P.PARAM_MATCHED_COUNT
        WHEN 'HUB_MANDATES'  THEN P.HUB_MANDATES_COUNT
        WHEN 'CPC'           THEN P.CPC_COUNT
        WHEN 'CMT_MATCHED'   THEN P.CMT_MATCHED_COUNT
        WHEN 'HUB_USERS'     THEN P.HUB_USERS_COUNT
        WHEN 'CPU_USERS'     THEN P.CPU_USERS_COUNT
        WHEN 'USR_MATCHED'   THEN P.USR_MATCHED_COUNT
        WHEN 'HUB_APPR'      THEN P.HUB_APPR_COUNT
        WHEN 'CPU_APPR'      THEN P.CPU_APPR_COUNT
        WHEN 'APPR_MATCHED'  THEN P.APPR_MATCHED_COUNT
        WHEN 'ALL_MATCHED'   THEN P.ALL_MATCHED_COUNT
        WHEN 'SSHCLP_ALL'    THEN P.SSHCLP_ALL_COUNT
        WHEN 'HUB_USR_ALL'   THEN P.HUB_USR_ALL_COUNT
        WHEN 'PMTP'          THEN P.PMTP_COUNT
        WHEN 'OTPP'          THEN P.OTPP_COUNT
        WHEN 'CPU_ALL'       THEN P.CPU_ALL_COUNT
     END) - NVL(FC.INVALID_COUNT, 0) AS VALID_COUNT,
    NVL(FC.INVALID_COUNT, 0) AS INVALID_COUNT,
    CASE WHEN CM.CATEGORY = 'INFO'           THEN 'INFO'
         WHEN NVL(FC.INVALID_COUNT, 0) = 0   THEN 'PASS'
         ELSE 'FAIL' END AS STATUS,
    'DC5' AS DC_VERSION,
    1 AS RUN_VERSION,  -- TESTING ONLY: στο SSIS αντικαθίσταται από @[User::RunVersion] μέσω Derived Column.
    SYSDATE AS RUN_TIMESTAMP
FROM CHECK_META CM
CROSS JOIN POPULATIONS P
LEFT JOIN FINDINGS_COUNT FC ON FC.CHECK_ID = CM.CHECK_ID
ORDER BY REGEXP_SUBSTR(CM.CHECK_ID, '[A-Z]+'), TO_NUMBER(REGEXP_SUBSTR(CM.CHECK_ID, '[0-9]+'));</property>
