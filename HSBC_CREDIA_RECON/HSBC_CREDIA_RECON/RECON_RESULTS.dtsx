                          name="CHECK_ID" />
                        <outputColumn
                          refId="Package\Sequence Container\SEPA_Detail\SEPA_detail.Outputs[Oracle Source Output].Columns[CHECK_NAME]"
                          codePage="1253"
                          dataType="str"
                          externalMetadataColumnId="Package\Sequence Container\SEPA_Detail\SEPA_detail.Outputs[Oracle Source Output].ExternalColumns[CHECK_NAME]"
                          length="50"
