                          name="RUN_VERSION" />
                        <externalMetadataColumn
                          refId="Package\Sequence Container\Customers_Detail\OLE DB Destination.Inputs[OLE DB Destination Input].ExternalColumns[RUN_TIMESTAMP]"
                          dataType="wstr"
                          length="27"
                          name="RUN_TIMESTAMP" />
                      </externalMetadataColumns>
                    </input>
                  </inputs>
                  <outputs>
                    <output
                      refId="Package\Sequence Container\Customers_Detail\OLE DB Destination.Outputs[OLE DB Destination Error Output]"
                      exclusionGroup="1"
                      isErrorOut="true"
                      name="OLE DB Destination Error Output"
                      synchronousInputId="Package\Sequence Container\Customers_Detail\OLE DB Destination.Inputs[OLE DB Destination Input]">
                      <outputColumns>
                        <outputColumn
                          refId="Package\Sequence Container\Customers_Detail\OLE DB Destination.Outputs[OLE DB Destination Error Output].Columns[ErrorCode]"
                          dataType="i4"
                          lineageId="Package\Sequence Container\Customers_Detail\OLE DB Destination.Outputs[OLE DB Destination Error Output].Columns[ErrorCode]"
                          name="ErrorCode"
                          specialFlags="1" />
                        <outputColumn
                          refId="Package\Sequence Container\Customers_Detail\OLE DB Destination.Outputs[OLE DB Destination Error Output].Columns[ErrorColumn]"
                          dataType="i4"
                          lineageId="Package\Sequence Container\Customers_Detail\OLE DB Destination.Outputs[OLE DB Destination Error Output].Columns[ErrorColumn]"
                          name="ErrorColumn"
                          specialFlags="2" />
                      </outputColumns>
                      <externalMetadataColumns />
                    </output>
                  </outputs>
                </component>
              </components>
              <paths>
                <path
                  refId="Package\Sequence Container\Customers_Detail.Paths[Derived Column Output]"
                  endId="Package\Sequence Container\Customers_Detail\OLE DB Destination.Inputs[OLE DB Destination Input]"
                  name="Derived Column Output"
                  startId="Package\Sequence Container\Customers_Detail\Derived Column.Outputs[Derived Column Output]" />
                <path
                  refId="Package\Sequence Container\Customers_Detail.Paths[Oracle Source Output]"
                  endId="Package\Sequence Container\Customers_Detail\Derived Column.Inputs[Derived Column Input]"
                  name="Oracle Source Output"
