                          length="30"
                          lineageId="Package\Sequence Container\SEPA_Detail\SEPA_detail.Outputs[Oracle Source Output].Columns[CUSTOMER_CODE]"
                          name="CUSTOMER_CODE" />
                        <outputColumn
                          refId="Package\Sequence Container\SEPA_Detail\SEPA_detail.Outputs[Oracle Source Output].Columns[SERIAL_NO]"
                          codePage="1253"
                          dataType="str"
                          externalMetadataColumnId="Package\Sequence Container\SEPA_Detail\SEPA_detail.Outputs[Oracle Source Output].ExternalColumns[SERIAL_NO]"
                          length="30"
                          lineageId="Package\Sequence Container\SEPA_Detail\SEPA_detail.Outputs[Oracle Source Output].Columns[SERIAL_NO]"
                          name="SERIAL_NO" />
                        <outputColumn
                          refId="Package\Sequence Container\SEPA_Detail\SEPA_detail.Outputs[Oracle Source Output].Columns[HUB_VALUE]"
                          codePage="1253"
                          dataType="str"
                          externalMetadataColumnId="Package\Sequence Container\SEPA_Detail\SEPA_detail.Outputs[Oracle Source Output].ExternalColumns[HUB_VALUE]"
                          length="100"
