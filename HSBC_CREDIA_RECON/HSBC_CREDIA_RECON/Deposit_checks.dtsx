                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  expressionType="Notify"
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">-- ====================================================================
-- DEP_RECON — DETAIL v3
-- Τροφοδοτεί: RECON.DEP_RECON_DETAIL
-- Πηγή λογικής: ενημερωμένο result set (33 έλεγχοι: A1-A13, G2-G4,
-- B1-B3, E1-E2, E4, D1-D7, D10-D12, D14), αυτούσια business logic.
-- Προστέθηκαν μόνο (ίδιο pattern με V2):
--   - CHECK_ID: εξάγεται αυτόματα από το CHECK_NAME (πριν την 1η underscore)
--   - DETAIL_ID: '&lt;CHECK_ID&gt;_00001', ...
--   - DC_VERSION, RUN_VERSION (placeholder=1 standalone test, στο SSIS
--     αντικαθίσταται μέσω Derived Column), RUN_TIMESTAMP
--
-- ΣΗΜΕΙΩΣΗ (να ελεγχθεί με τον senior): οι ελέγχοι D10, D11, D12, D14
-- έχουν στα σχόλια πηγής numbering D8, D9, D10, D11 αντίστοιχα, αλλά
-- το πραγματικό CHECK_NAME literal (άρα και το CHECK_ID που παράγεται
-- εδώ) είναι D10/D11/D12/D14 -- δηλαδή λείπουν D8, D9, D13. Δεν το άλλαξα,
-- κράτησα ό,τι δόθηκε αυτούσιο. Αν είναι λάθος αρίθμησης, πες μου να
-- διορθώσω τα CHECK_NAME literals.
-- ====================================================================
SELECT
    CAST(CHECK_ID || '_' || TO_CHAR(ROW_NUMBER() OVER (PARTITION BY CHECK_ID ORDER BY ACCOUNT_NO), 'FM0000000') AS VARCHAR2(20)) AS DETAIL_ID,
    CAST(CHECK_ID AS VARCHAR2(10)) AS CHECK_ID,
    CAST(CHECK_NAME AS VARCHAR2(50)) AS CHECK_NAME,
    CAST(ACCOUNT_NO AS VARCHAR2(30)) AS ACCOUNT_NO,
    CAST(CUSTOMER_CODE AS VARCHAR2(30)) AS CUSTOMER_CODE,
    CAST(DEPOSIT_ACCOUNT_CATEGORY AS VARCHAR2(10)) AS DEPOSIT_ACCOUNT_CATEGORY,
    CAST(HUB_VALUE AS VARCHAR2(100)) AS HUB_VALUE,
    CAST(NCIS_VALUE AS VARCHAR2(100)) AS NCIS_VALUE,
    CAST(ISSUE AS VARCHAR2(50)) AS ISSUE,
    'DC3' AS DC_VERSION,
    1 AS RUN_VERSION,  -- TESTING ONLY: στο SSIS αντικαθίσταται από @[User::RunVersion] μέσω Derived Column.
    SYSDATE AS RUN_TIMESTAMP
FROM (
    SELECT
        F.*,
        CAST(SUBSTR(CHECK_NAME, 1, INSTR(CHECK_NAME, '_') - 1) AS VARCHAR2(10)) AS CHECK_ID
    FROM (

        --==============================================================
        --A1. Accounts στο HUB (DD) που δεν υπάρχουν στο NCIS
        SELECT
          'A1_ACCOUNT_MISSING_IN_NCIS' AS CHECK_NAME,
          H.ACCOUNT_NO, H.CUSTOMER_CODE, 'DD' AS DEPOSIT_ACCOUNT_CATEGORY,
          CAST(NULL AS VARCHAR2(100)) AS HUB_VALUE, CAST(NULL AS VARCHAR2(100)) AS NCIS_VALUE,
          'MISSING_IN_PROFITS' AS ISSUE
        FROM (
          SELECT TRIM(H.CUSTOMER_CODE) AS CUSTOMER_CODE, TRIM(H.ACCOUNT_NO) AS ACCOUNT_NO FROM HUB_MT_DDACMSP H
        ) H
        LEFT JOIN (
          SELECT TRIM(N.Account_Number) AS ACCOUNT_NUMBER FROM NCIS_Deposits N
        ) P ON P.ACCOUNT_NUMBER = H.ACCOUNT_NO
        WHERE P.ACCOUNT_NUMBER IS NULL

        UNION ALL
        --==============================================================
        --A2. Accounts στο NCIS που δεν υπάρχουν καθόλου στο HUB (ούτε DD, ούτε TD)
        SELECT
          'A2_ACCOUNT_MISSING_IN_HUB' AS CHECK_NAME,
          P.ACCOUNT_NUMBER, P.CUSTOMER_CODE, COALESCE(H.DEPOSIT_ACCOUNT_CATEGORY, T.DEPOSIT_ACCOUNT_CATEGORY, 'NOT_FOUND'),
          CAST(NULL AS VARCHAR2(100)), CAST(NULL AS VARCHAR2(100)),
          'MISSING_IN_HUB' AS ISSUE
        FROM (
          SELECT TRIM(N.Account_Number) AS ACCOUNT_NUMBER, TRIM(N.Customer_Code) AS CUSTOMER_CODE FROM NCIS_Deposits N
        ) P
        LEFT JOIN (SELECT TRIM(ACCOUNT_NO) AS ACCOUNT_NO, 'TD' AS DEPOSIT_ACCOUNT_CATEGORY FROM HUB_MT_TDACMSP) T ON T.ACCOUNT_NO = P.ACCOUNT_NUMBER
        LEFT JOIN (SELECT TRIM(ACCOUNT_NO) AS ACCOUNT_NO, 'DD' AS DEPOSIT_ACCOUNT_CATEGORY FROM HUB_MT_DDACMSP) H ON H.ACCOUNT_NO = P.ACCOUNT_NUMBER
        WHERE H.ACCOUNT_NO IS NULL AND T.ACCOUNT_NO IS NULL

        UNION ALL
        --==============================================================
        --A3. Duplicate account numbers μέσα στο HUB (DD + TD)
        SELECT
          'A3_DUPLICATE_ACCOUNT_HUB' AS CHECK_NAME,
          ACCOUNT_NO, CAST(NULL AS VARCHAR2(30)), DEPOSIT_ACCOUNT_CATEGORY,
          TO_CHAR(OCCURRENCES), CAST(NULL AS VARCHAR2(100)),
          'DUPLICATE_ACCOUNT_NO' AS ISSUE
        FROM (
          SELECT ACCOUNT_NO, DEPOSIT_ACCOUNT_CATEGORY, COUNT(*) AS OCCURRENCES
          FROM (
            SELECT TRIM(ACCOUNT_NO) AS ACCOUNT_NO, 'DD' AS DEPOSIT_ACCOUNT_CATEGORY FROM HUB_MT_DDACMSP
            UNION ALL
            SELECT TRIM(ACCOUNT_NO) AS ACCOUNT_NO, 'TD' AS DEPOSIT_ACCOUNT_CATEGORY FROM HUB_MT_TDACMSP
          )
          GROUP BY ACCOUNT_NO, DEPOSIT_ACCOUNT_CATEGORY
          HAVING COUNT(*) &gt; 1
        )

        UNION ALL
        --==============================================================
        --A4. NULL/κενό account number - HUB (DD + TD)
        SELECT
          'A4_NULL_ACCOUNT_NO_HUB' AS CHECK_NAME,
          ACCOUNT_NO, CUSTOMER_CODE, DEPOSIT_ACCOUNT_CATEGORY,
          CAST(NULL AS VARCHAR2(100)), CAST(NULL AS VARCHAR2(100)),
          'NULL_OR_EMPTY_ACCOUNT_NO' AS ISSUE
        FROM (
          SELECT TRIM(CUSTOMER_CODE) AS CUSTOMER_CODE, TRIM(TO_CHAR(ACCOUNT_NO)) AS ACCOUNT_NO, 'DD' AS DEPOSIT_ACCOUNT_CATEGORY FROM HUB_MT_DDACMSP
          UNION ALL
          SELECT TRIM(CUSTOMER_CODE) AS CUSTOMER_CODE, TRIM(TO_CHAR(ACCOUNT_NO)) AS ACCOUNT_NO, 'TD' AS DEPOSIT_ACCOUNT_CATEGORY FROM HUB_MT_TDACMSP
        )
        WHERE ACCOUNT_NO IS NULL OR TRIM(ACCOUNT_NO) = ''

        UNION ALL
        --==============================================================
        --A5. NULL/κενό account number - NCIS
        SELECT
          'A5_NULL_ACCOUNT_NO_NCIS' AS CHECK_NAME,
          TO_CHAR(Account_Number), TRIM(TO_CHAR(Customer_Code)), CAST(NULL AS VARCHAR2(10)),
          CAST(NULL AS VARCHAR2(100)), CAST(NULL AS VARCHAR2(100)),
          'NULL_OR_EMPTY_ACCOUNT_NUMBER' AS ISSUE
        FROM NCIS_Deposits
        WHERE Account_Number IS NULL OR TRIM(TO_CHAR(Account_Number)) = ''

        UNION ALL
        --==============================================================
        --A6. Duplicate account numbers μέσα στο NCIS
        SELECT
          'A6_DUPLICATE_ACCOUNT_NCIS' AS CHECK_NAME,
          ACCOUNT_NUMBER, CAST(NULL AS VARCHAR2(30)), CAST(NULL AS VARCHAR2(10)),
          CAST(NULL AS VARCHAR2(100)), TO_CHAR(OCCURRENCES),
          'DUPLICATE_ACCOUNT_NUMBER' AS ISSUE
        FROM (
          SELECT TRIM(Account_Number) AS ACCOUNT_NUMBER, COUNT(*) AS OCCURRENCES
          FROM NCIS_Deposits
          GROUP BY TRIM(Account_Number)
          HAVING COUNT(*) &gt; 1
        )

        UNION ALL
        --==============================================================
        --A7. NULL/κενό customer_code - HUB (DD + TD)
        SELECT
          'A7_NULL_CUSTOMER_CODE_HUB' AS CHECK_NAME,
          ACCOUNT_NO, CUSTOMER_CODE, DEPOSIT_ACCOUNT_CATEGORY,
          CAST(NULL AS VARCHAR2(100)), CAST(NULL AS VARCHAR2(100)),
          'NULL_OR_EMPTY_CUSTOMER_CODE' AS ISSUE
        FROM (
          SELECT TRIM(ACCOUNT_NO) AS ACCOUNT_NO, TO_CHAR(CUSTOMER_CODE) AS CUSTOMER_CODE, 'DD' AS DEPOSIT_ACCOUNT_CATEGORY FROM HUB_MT_DDACMSP
          UNION ALL
          SELECT TRIM(ACCOUNT_NO) AS ACCOUNT_NO, TO_CHAR(CUSTOMER_CODE) AS CUSTOMER_CODE, 'TD' AS DEPOSIT_ACCOUNT_CATEGORY FROM HUB_MT_TDACMSP
        )
        WHERE CUSTOMER_CODE IS NULL OR TRIM(CUSTOMER_CODE) = ''

        UNION ALL
        --==============================================================
        --A8. NULL/κενό customer_code - NCIS
        SELECT
          'A8_NULL_CUSTOMER_CODE_NCIS' AS CHECK_NAME,
          TO_CHAR(Account_Number), TO_CHAR(Customer_Code), CAST(NULL AS VARCHAR2(10)),
          CAST(NULL AS VARCHAR2(100)), CAST(NULL AS VARCHAR2(100)),
          'NULL_OR_EMPTY_CUSTOMER_CODE' AS ISSUE
        FROM NCIS_Deposits
        WHERE Customer_Code IS NULL OR TRIM(TO_CHAR(Customer_Code)) = ''

        UNION ALL
        --==============================================================
        --A9. Λογαριασμός που υπάρχει ΚΑΙ στο DD ΚΑΙ στο TD ταυτόχρονα
        SELECT
          'A9_ACCOUNT_IN_BOTH_DD_TD' AS CHECK_NAME,
          DF_ACCOUNT_NO, DD_CUSTOMER_CODE, CAST(NULL AS VARCHAR2(10)),
          TD_CUSTOMER_CODE, CAST(NULL AS VARCHAR2(100)),
          'ACCOUNT_IN_BOTH_DD_AND_TD' AS ISSUE
        FROM (
          SELECT TRIM(DF.ACCOUNT_NO) AS DF_ACCOUNT_NO, TRIM(DF.CUSTOMER_CODE) AS DD_CUSTOMER_CODE, TRIM(TD.CUSTOMER_CODE) AS TD_CUSTOMER_CODE
          FROM HUB_MT_DDACMSP DF
          JOIN HUB_MT_TDACMSP TD ON TRIM(TD.ACCOUNT_NO) = TRIM(DF.ACCOUNT_NO)
        )

        UNION ALL
        --==============================================================
        --A10. NULL/κενό product code - HUB (DD + TD)
        SELECT
          'A10_NULL_PRODUCT_CODE_HUB' AS CHECK_NAME,
          ACCOUNT_NO, CUSTOMER_CODE, DEPOSIT_ACCOUNT_CATEGORY,
          CAST(NULL AS VARCHAR2(100)), CAST(NULL AS VARCHAR2(100)),
          'NULL_OR_EMPTY_PRODUCT_CODE' AS ISSUE
        FROM (
          SELECT TRIM(ACCOUNT_NO) AS ACCOUNT_NO, TRIM(CUSTOMER_CODE) AS CUSTOMER_CODE, DFAPTY AS PRODUCT_CODE, 'DD/OVD' AS DEPOSIT_ACCOUNT_CATEGORY FROM HUB_MT_DDACMSP
          UNION ALL
          SELECT TRIM(ACCOUNT_NO) AS ACCOUNT_NO, TRIM(CUSTOMER_CODE) AS CUSTOMER_CODE, TDAPTY AS PRODUCT_CODE, 'TD' AS DEPOSIT_ACCOUNT_CATEGORY FROM HUB_MT_TDACMSP
        )
        WHERE PRODUCT_CODE IS NULL OR TRIM(PRODUCT_CODE) = ''

        UNION ALL
        --==============================================================
        --A11. NULL account type - NCIS
        SELECT
          'A11_NULL_ACCOUNT_TYPE_NCIS' AS CHECK_NAME,
          TO_CHAR(Account_Number), TO_CHAR(Customer_Code), CAST(NULL AS VARCHAR2(10)),
          CAST(NULL AS VARCHAR2(100)), CAST(NULL AS VARCHAR2(100)),
          'NULL_OR_EMPTY_ACCOUNT_TYPE' AS ISSUE
        FROM NCIS_Deposits
        WHERE Account_Type IS NULL

        UNION ALL
        --==============================================================
        --A12. NULL/κενό branch code - HUB (DD + TD)
        SELECT
          'A12_NULL_BRANCH_CODE_HUB' AS CHECK_NAME,
          ACCOUNT_NO, CUSTOMER_CODE, DEPOSIT_ACCOUNT_CATEGORY,
          CAST(NULL AS VARCHAR2(100)), CAST(NULL AS VARCHAR2(100)),
          'NULL_OR_EMPTY_BRANCH_CODE' AS ISSUE
        FROM (
          SELECT TRIM(ACCOUNT_NO) AS ACCOUNT_NO, TRIM(CUSTOMER_CODE) AS CUSTOMER_CODE, DFACB AS BRANCH_CODE, 'DD' AS DEPOSIT_ACCOUNT_CATEGORY FROM HUB_MT_DDACMSP
          UNION ALL
          SELECT TRIM(ACCOUNT_NO) AS ACCOUNT_NO, TRIM(CUSTOMER_CODE) AS CUSTOMER_CODE, TDACB AS BRANCH_CODE, 'TD' AS DEPOSIT_ACCOUNT_CATEGORY FROM HUB_MT_TDACMSP
        )
        WHERE BRANCH_CODE IS NULL

        UNION ALL
        --==============================================================
        --A13. Branch code - HUB vs NCIS - μόνο MISMATCH
        SELECT
          'A13_BRANCH_MISMATCH' AS CHECK_NAME,
          H.ACCOUNT_NO, CAST(NULL AS VARCHAR2(30)), H.DEPOSIT_ACCOUNT_CATEGORY,
          H.HUB_BRANCH, P.PROFITS_UNIT_CODE,
          'BRANCH_MISMATCH' AS ISSUE
        FROM (
          SELECT TRIM(ACCOUNT_NO) AS ACCOUNT_NO, TRIM(TO_CHAR(DFACB)) AS HUB_BRANCH, 'DD' AS DEPOSIT_ACCOUNT_CATEGORY FROM HUB_MT_DDACMSP
          UNION ALL
          SELECT TRIM(ACCOUNT_NO) AS ACCOUNT_NO, TRIM(TO_CHAR(TDACB)) AS HUB_BRANCH, 'TD' AS DEPOSIT_ACCOUNT_CATEGORY FROM HUB_MT_TDACMSP
        ) H
        JOIN (
          SELECT TRIM(Account_Number) AS ACCOUNT_NUMBER, TRIM(TO_CHAR(Unit_Code)) AS PROFITS_UNIT_CODE FROM NCIS_Deposits
        ) P ON P.ACCOUNT_NUMBER = H.ACCOUNT_NO
        WHERE NVL(H.HUB_BRANCH,'x') &lt;&gt; NVL(P.PROFITS_UNIT_CODE,'x')

        UNION ALL
        --==============================================================
        --G2. UNMAPPED product code - HUB (DD + TD)
        SELECT
          'G2_UNMAPPED_PRODUCT_CODE' AS CHECK_NAME,
          ACCOUNT_NO, CUSTOMER_CODE, SOURCE_TABLE,
          HUB_RAW_PRODUCT_CODE, CAST(NULL AS VARCHAR2(100)),
          'UNMAPPED' AS ISSUE
        FROM (
          SELECT TRIM(DF.ACCOUNT_NO) AS ACCOUNT_NO, TRIM(DF.CUSTOMER_CODE) AS CUSTOMER_CODE,
            TRIM(DF.DFAPTY) AS HUB_RAW_PRODUCT_CODE, 'DD' AS SOURCE_TABLE,
            TRIM(DF.DFSTUS) AS STATUS, NVL(MAP.PRODUCT_TYPE, 'UNMAPPED') AS HUB_PRODUCT_TYPE
          FROM HUB_MT_DDACMSP DF
          LEFT JOIN MG_HGR_DEPOSITS_PRODUCT_MAPPING MAP ON MAP.HSBC_CODE = TRIM(DF.DFAPTY)
          UNION ALL
          SELECT TRIM(TD.ACCOUNT_NO) AS ACCOUNT_NO, TRIM(TD.CUSTOMER_CODE) AS CUSTOMER_CODE,
            TRIM(TD.TDFAPT) AS HUB_RAW_PRODUCT_CODE, 'TD' AS SOURCE_TABLE,
            TRIM(TD.TDSTUS) AS STATUS, NVL(MAP.PRODUCT_TYPE, 'UNMAPPED') AS HUB_PRODUCT_TYPE
          FROM HUB_MT_TDACMSP TD
          LEFT JOIN MG_HGR_DEPOSITS_PRODUCT_MAPPING MAP ON MAP.HSBC_CODE = TRIM(TD.TDAPTY)
        )
        WHERE HUB_PRODUCT_TYPE = 'UNMAPPED'
          AND STATUS = 1

        UNION ALL
        --==============================================================
        --G3. Product type MISMATCH
        SELECT
          'G3_PRODUCT_TYPE_MISMATCH' AS CHECK_NAME,
          H.ACCOUNT_NO, H.CUSTOMER_CODE, H.DEPOSIT_ACCOUNT_CATEGORY,
          H.HUB_PRODUCT_TYPE, P.PROFITS_PRODUCT_TYPE,
          'MISMATCH' AS ISSUE
        FROM (
          SELECT TRIM(DF.ACCOUNT_NO) AS ACCOUNT_NO, TRIM(DF.CUSTOMER_CODE) AS CUSTOMER_CODE,
            NVL(MAP.PRODUCT_TYPE, 'UNMAPPED') AS HUB_PRODUCT_TYPE, 'DD' AS DEPOSIT_ACCOUNT_CATEGORY
          FROM HUB_MT_DDACMSP DF
          LEFT JOIN MG_HGR_DEPOSITS_PRODUCT_MAPPING MAP ON MAP.HSBC_CODE = TRIM(DF.DFAPTY)
          UNION ALL
          SELECT TRIM(TD.ACCOUNT_NO) AS ACCOUNT_NO, TRIM(TD.CUSTOMER_CODE) AS CUSTOMER_CODE,
            NVL(MAP.PRODUCT_TYPE, 'UNMAPPED') AS HUB_PRODUCT_TYPE, 'TD' AS DEPOSIT_ACCOUNT_CATEGORY
          FROM HUB_MT_TDACMSP TD
          LEFT JOIN MG_HGR_DEPOSITS_PRODUCT_MAPPING MAP ON MAP.HSBC_CODE = TRIM(TD.TDAPTY)
        ) H
        JOIN (
          SELECT TRIM(N.Account_Number) AS ACCOUNT_NUMBER, TRIM(N.Customer_Code) AS CUSTOMER_CODE,
            NVL(MAP.PRODUCT_TYPE, 'OTHER') AS PROFITS_PRODUCT_TYPE
          FROM NCIS_Deposits N
          LEFT JOIN (SELECT DISTINCT PROFITS_CODE, PRODUCT_TYPE FROM MG_HGR_DEPOSITS_PRODUCT_MAPPING) MAP
            ON MAP.PROFITS_CODE = TO_CHAR(N.Account_Type)
        ) P ON P.ACCOUNT_NUMBER = H.ACCOUNT_NO
        WHERE NVL(H.HUB_PRODUCT_TYPE, CHR(1)) &lt;&gt; NVL(P.PROFITS_PRODUCT_TYPE, CHR(1))

        UNION ALL
        --==============================================================
        --G4. Account Currency mismatch
        SELECT
          'G4_CURRENCY_MISMATCH' AS CHECK_NAME,
          H.ACCOUNT_NO, CAST(NULL AS VARCHAR2(30)), H.DEPOSIT_ACCOUNT_CATEGORY,
          H.HUB_CURRENCY, P.PROFITS_CURRENCY,
          'MISMATCH' AS ISSUE
        FROM (
          SELECT TRIM(ACCOUNT_NO) AS ACCOUNT_NO, TRIM(DFCYCD) AS HUB_CURRENCY, 'DD' AS DEPOSIT_ACCOUNT_CATEGORY FROM HUB_MT_DDACMSP
          UNION ALL
          SELECT TRIM(ACCOUNT_NO) AS ACCOUNT_NO, TRIM(TDCYCD) AS HUB_CURRENCY, 'TD' AS DEPOSIT_ACCOUNT_CATEGORY FROM HUB_MT_TDACMSP
        ) H
        JOIN (
          SELECT TRIM(Account_Number) AS ACCOUNT_NUMBER, TRIM(Account_Currency) AS PROFITS_CURRENCY FROM NCIS_Deposits
        ) P ON P.ACCOUNT_NUMBER = H.ACCOUNT_NO
        WHERE NVL(H.HUB_CURRENCY,'x') &lt;&gt; NVL(P.PROFITS_CURRENCY,'x')

        UNION ALL
        --==============================================================
        --B1. Customer_Code consistency (DD + TD, με joint resolution)
        SELECT
          'B1_CUSTOMER_CODE_MISMATCH' AS CHECK_NAME,
          M.ACCOUNT_NO, M.HUB_CUSTOMER_CODE, M.DEPOSIT_ACCOUNT_CATEGORY,
          TO_CHAR(M.PRFT_CUST_ID), TO_CHAR(N.Customer_Code),
          'MISMATCH' AS ISSUE
        FROM (
          SELECT
            JR.ACCOUNT_NO, JR.DEPOSIT_ACCOUNT_CATEGORY, JR.HUB_CUSTOMER_CODE, JR.EFFECTIVE_CUSTOMER_CODE, MCI.PRFT_CUST_ID
          FROM (
            SELECT
              A.ACCOUNT_NO, A.DEPOSIT_ACCOUNT_CATEGORY, A.HUB_CUSTOMER_CODE,
              CASE WHEN J.CUSTOMER_1 IS NOT NULL THEN TRIM(J.CUSTOMER_BENEF_LIST) ELSE A.HUB_CUSTOMER_CODE END AS EFFECTIVE_CUSTOMER_CODE
            FROM (
              SELECT TRIM(ACCOUNT_NO) AS ACCOUNT_NO, TRIM(CUSTOMER_CODE) AS HUB_CUSTOMER_CODE, 'DD' AS DEPOSIT_ACCOUNT_CATEGORY FROM HUB_MT_DDACMSP
              UNION ALL
              SELECT TRIM(ACCOUNT_NO) AS ACCOUNT_NO, TRIM(CUSTOMER_CODE) AS HUB_CUSTOMER_CODE, 'TD' AS DEPOSIT_ACCOUNT_CATEGORY FROM HUB_MT_TDACMSP
            ) A
            LEFT JOIN HGR_MG_JOINT J ON J.CUSTOMER_1 = A.HUB_CUSTOMER_CODE AND J.SERIAL_NO = 1
          ) JR
          LEFT JOIN MG_CUSTOMER_INTER MCI ON TRIM(TO_CHAR(MCI.CUSTOMER_CODE)) = TRIM(TO_CHAR(JR.EFFECTIVE_CUSTOMER_CODE))
        ) M
        LEFT JOIN NCIS_Deposits N ON TRIM(TO_CHAR(N.Account_Number)) = TO_CHAR(M.ACCOUNT_NO)
        WHERE TRIM(TO_CHAR(M.PRFT_CUST_ID)) &lt;&gt; TRIM(TO_CHAR(N.Customer_Code))

        UNION ALL
        --==============================================================
        --B3. Orphan accounts - EFFECTIVE_CUSTOMER_CODE (μετά joint) χωρίς
        -- αντιστοίχιση στο MG_CUSTOMER_INTER (DD + TD)
        SELECT
          'B3_ORPHAN_NO_MAPPING' AS CHECK_NAME,
          JR.ACCOUNT_NO, JR.HUB_CUSTOMER_CODE, JR.DEPOSIT_ACCOUNT_CATEGORY,
          JR.EFFECTIVE_CUSTOMER_CODE, CAST(NULL AS VARCHAR2(30)),
          'NO_MAPPING_FOUND_IN_MG_CUSTOMER_INTER' AS ISSUE
        FROM (
          SELECT
            A.ACCOUNT_NO, A.DEPOSIT_ACCOUNT_CATEGORY, A.HUB_CUSTOMER_CODE,
            CASE WHEN J.CUSTOMER_1 IS NOT NULL THEN TRIM(J.CUSTOMER_BENEF_LIST) ELSE A.HUB_CUSTOMER_CODE END AS EFFECTIVE_CUSTOMER_CODE
          FROM (
            SELECT TRIM(ACCOUNT_NO) AS ACCOUNT_NO, TRIM(CUSTOMER_CODE) AS HUB_CUSTOMER_CODE, 'DD' AS DEPOSIT_ACCOUNT_CATEGORY FROM HUB_MT_DDACMSP
            UNION ALL
            SELECT TRIM(ACCOUNT_NO) AS ACCOUNT_NO, TRIM(CUSTOMER_CODE) AS HUB_CUSTOMER_CODE, 'TD' AS DEPOSIT_ACCOUNT_CATEGORY FROM HUB_MT_TDACMSP
          ) A
          LEFT JOIN HGR_MG_JOINT J ON J.CUSTOMER_1 = A.HUB_CUSTOMER_CODE AND J.SERIAL_NO = 1
        ) JR
        WHERE NOT EXISTS (
          SELECT 1 FROM MG_CUSTOMER_INTER MCI
          WHERE TRIM(TO_CHAR(MCI.CUSTOMER_CODE)) = TRIM(TO_CHAR(JR.EFFECTIVE_CUSTOMER_CODE))
        )

        UNION ALL
        --==============================================================
        --B2. Αριθμός beneficiaries - HUB vs NCIS (0 joint = 1 δικαιούχος, όχι mismatch)
        SELECT
          'B2_BENEFICIARIES_MISMATCH' AS CHECK_NAME,
          H.ACCOUNT_NO, H.HUB_CUSTOMER_CODE, H.DEPOSIT_ACCOUNT_CATEGORY,
          TO_CHAR(NVL(B.HUB_BENEF_CNT, 0)), TO_CHAR(NVL(P.PROFITS_BENEF_CNT, 0)),
          'MISMATCH' AS ISSUE
        FROM (
          SELECT TRIM(ACCOUNT_NO) AS ACCOUNT_NO, TRIM(CUSTOMER_CODE) AS HUB_CUSTOMER_CODE, 'DD' AS DEPOSIT_ACCOUNT_CATEGORY FROM HUB_MT_DDACMSP
          UNION ALL
          SELECT TRIM(ACCOUNT_NO) AS ACCOUNT_NO, TRIM(CUSTOMER_CODE) AS HUB_CUSTOMER_CODE, 'TD' AS DEPOSIT_ACCOUNT_CATEGORY FROM HUB_MT_TDACMSP
        ) H
        LEFT JOIN (
          SELECT TRIM(CUSTOMER_1) AS CUSTOMER_1, COUNT(*) AS HUB_BENEF_CNT FROM HGR_MG_JOINT GROUP BY TRIM(CUSTOMER_1)
        ) B ON B.CUSTOMER_1 = H.HUB_CUSTOMER_CODE
        JOIN (
          SELECT TRIM(Account_Number) AS ACCOUNT_NUMBER, Number_Of_Beneficiaries AS PROFITS_BENEF_CNT FROM NCIS_Deposits
        ) P ON P.ACCOUNT_NUMBER = H.ACCOUNT_NO
        WHERE CASE WHEN NVL(B.HUB_BENEF_CNT, 0) = 0 THEN 1 ELSE NVL(B.HUB_BENEF_CNT, 0) END &lt;&gt; NVL(P.PROFITS_BENEF_CNT, 0)

        UNION ALL
        --==============================================================
        --E1. Account Status - HUB (DFSTUS/TDSTUS) vs NCIS (Account_Status)
        SELECT
          'E1_STATUS_MISMATCH' AS CHECK_NAME,
          H.ACCOUNT_NO, CAST(NULL AS VARCHAR2(30)), H.DEPOSIT_ACCOUNT_CATEGORY,
          H.HUB_STATUS, P.PROFITS_STATUS,
          'MISMATCH' AS ISSUE
        FROM (
          SELECT TRIM(ACCOUNT_NO) AS ACCOUNT_NO, TRIM(DFSTUS) AS HUB_STATUS, 'DD' AS DEPOSIT_ACCOUNT_CATEGORY FROM HUB_MT_DDACMSP
          UNION ALL
          SELECT TRIM(ACCOUNT_NO) AS ACCOUNT_NO, TRIM(TDSTUS) AS HUB_STATUS, 'TD' AS DEPOSIT_ACCOUNT_CATEGORY FROM HUB_MT_TDACMSP
        ) H
        JOIN (
          SELECT TRIM(Account_Number) AS ACCOUNT_NUMBER, TRIM(Account_Status) AS PROFITS_STATUS FROM NCIS_Deposits
        ) P ON P.ACCOUNT_NUMBER = H.ACCOUNT_NO
        WHERE NVL(H.HUB_STATUS,'x') &lt;&gt; NVL(P.PROFITS_STATUS,'x')

        UNION ALL
        --==============================================================
        --E2. Ημερομηνία ανοίγματος - HUB (DFDTAO/TDDTAO) vs NCIS (Open_Date)
        SELECT
          'E2_OPEN_DATE_MISMATCH' AS CHECK_NAME,
          H.ACCOUNT_NO, CAST(NULL AS VARCHAR2(30)), H.DEPOSIT_ACCOUNT_CATEGORY,
          TO_CHAR(TO_DATE(TRIM(TO_CHAR(H.HUB_OPEN_DATE)), 'YYYYMMDD'), 'YYYY-MM-DD'), TO_CHAR(P.PROFITS_OPEN_DATE, 'YYYY-MM-DD'),
          'MISMATCH' AS ISSUE
        FROM (
          SELECT TRIM(ACCOUNT_NO) AS ACCOUNT_NO, DFDTAO AS HUB_OPEN_DATE, 'DD' AS DEPOSIT_ACCOUNT_CATEGORY FROM HUB_MT_DDACMSP
          UNION ALL
          SELECT TRIM(ACCOUNT_NO) AS ACCOUNT_NO, TDDTAO AS HUB_OPEN_DATE, 'TD' AS DEPOSIT_ACCOUNT_CATEGORY FROM HUB_MT_TDACMSP
        ) H
        JOIN (
          SELECT TRIM(Account_Number) AS ACCOUNT_NUMBER, Open_Date AS PROFITS_OPEN_DATE FROM NCIS_Deposits
        ) P ON P.ACCOUNT_NUMBER = H.ACCOUNT_NO
        WHERE TO_DATE(TRIM(TO_CHAR(H.HUB_OPEN_DATE)), 'YYYYMMDD') &lt;&gt; TRUNC(P.PROFITS_OPEN_DATE)

        UNION ALL
        --==============================================================
        --E4. TD Due/Expiration Date - HUB (TDDUDT) vs NCIS (TD_Expiration_Date) - μόνο TD
        SELECT
          'E4_TD_EXPIRATION_DATE_MISMATCH' AS CHECK_NAME,
          H.ACCOUNT_NO, CAST(NULL AS VARCHAR2(30)), 'TD',
          TO_CHAR(TO_DATE(TRIM(TO_CHAR(H.HUB_DUE_DATE)), 'YYYYMMDD'), 'YYYY-MM-DD'), TO_CHAR(P.PROFITS_EXPIRATION_DATE, 'YYYY-MM-DD'),
          'MISMATCH' AS ISSUE
        FROM (
          SELECT TRIM(ACCOUNT_NO) AS ACCOUNT_NO, TDDUDT AS HUB_DUE_DATE FROM HUB_MT_TDACMSP
        ) H
        JOIN (
          SELECT TRIM(Account_Number) AS ACCOUNT_NUMBER, TD_Expiration_Date AS PROFITS_EXPIRATION_DATE
          FROM NCIS_Deposits WHERE TD_Expiration_Date IS NOT NULL
        ) P ON P.ACCOUNT_NUMBER = H.ACCOUNT_NO
        WHERE TO_DATE(TRIM(TO_CHAR(H.HUB_DUE_DATE)), 'YYYYMMDD') &lt;&gt; TRUNC(P.PROFITS_EXPIRATION_DATE)

        UNION ALL
        --==============================================================
        --D1. Ledger/Book Balance - HUB (DFRLBL/TDRLBL) vs NCIS (Book_Balance), tolerance 0.01
        SELECT
          'D1_BOOK_BALANCE_MISMATCH' AS CHECK_NAME,
          H.ACCOUNT_NO, CAST(NULL AS VARCHAR2(30)), H.DEPOSIT_ACCOUNT_CATEGORY,
          TO_CHAR(H.HUB_LEDGER_BALANCE), TO_CHAR(P.PROFITS_BOOK_BALANCE),
          'MISMATCH' AS ISSUE
        FROM (
          SELECT TRIM(ACCOUNT_NO) AS ACCOUNT_NO, DFRLBL AS HUB_LEDGER_BALANCE, 'DD' AS DEPOSIT_ACCOUNT_CATEGORY FROM HUB_MT_DDACMSP
          UNION ALL
          SELECT TRIM(ACCOUNT_NO) AS ACCOUNT_NO, TDRLBL AS HUB_LEDGER_BALANCE, 'TD' AS DEPOSIT_ACCOUNT_CATEGORY FROM HUB_MT_TDACMSP
        ) H
        JOIN (
          SELECT TRIM(Account_Number) AS ACCOUNT_NUMBER, Book_Balance AS PROFITS_BOOK_BALANCE FROM NCIS_Deposits
        ) P ON P.ACCOUNT_NUMBER = H.ACCOUNT_NO
        WHERE ABS(NVL(H.HUB_LEDGER_BALANCE,0) - NVL(P.PROFITS_BOOK_BALANCE,0)) &gt; 0.01

        UNION ALL
        --==============================================================
        --D2. Blocked Balance / Total Holds - HUB (DFTTHD/TDTTHD) vs NCIS (Blocked_Balance), tolerance 0.01
        SELECT
          'D2_BLOCKED_BALANCE_MISMATCH' AS CHECK_NAME,
          H.ACCOUNT_NO, CAST(NULL AS VARCHAR2(30)), H.DEPOSIT_ACCOUNT_CATEGORY,
          TO_CHAR(H.HUB_TOTAL_HOLDS), TO_CHAR(P.PROFITS_BLOCKED_BALANCE),
          'MISMATCH' AS ISSUE
        FROM (
          SELECT TRIM(ACCOUNT_NO) AS ACCOUNT_NO, DFTTHD AS HUB_TOTAL_HOLDS, 'DD' AS DEPOSIT_ACCOUNT_CATEGORY FROM HUB_MT_DDACMSP
          UNION ALL
          SELECT TRIM(ACCOUNT_NO) AS ACCOUNT_NO, TDTTHD AS HUB_TOTAL_HOLDS, 'TD' AS DEPOSIT_ACCOUNT_CATEGORY FROM HUB_MT_TDACMSP
        ) H
        JOIN (
          SELECT TRIM(Account_Number) AS ACCOUNT_NUMBER, Blocked_Balance AS PROFITS_BLOCKED_BALANCE FROM NCIS_Deposits
        ) P ON P.ACCOUNT_NUMBER = H.ACCOUNT_NO
        WHERE ABS(NVL(H.HUB_TOTAL_HOLDS,0) - NVL(P.PROFITS_BLOCKED_BALANCE,0)) &gt; 0.01

        UNION ALL
        --==============================================================
        --D3. Available Balance - HUB (DFVLBL) vs NCIS (Available_Balance) - μόνο DD
        -- ⚠️ Mapping DFVLBL &lt;-&gt; Available_Balance δεν έχει πλήρως επιβεβαιωθεί
        SELECT
          'D3_AVAILABLE_BALANCE_MISMATCH' AS CHECK_NAME,
          H.ACCOUNT_NO, CAST(NULL AS VARCHAR2(30)), 'DD',
          TO_CHAR(H.HUB_VALUE_BALANCE), TO_CHAR(P.PROFITS_AVAILABLE_BALANCE),
          'MISMATCH' AS ISSUE
        FROM (
          SELECT TRIM(ACCOUNT_NO) AS ACCOUNT_NO, DFVLBL AS HUB_VALUE_BALANCE FROM HUB_MT_DDACMSP
        ) H
        JOIN (
          SELECT TRIM(Account_Number) AS ACCOUNT_NUMBER, Available_Balance AS PROFITS_AVAILABLE_BALANCE FROM NCIS_Deposits
        ) P ON P.ACCOUNT_NUMBER = H.ACCOUNT_NO
        WHERE ABS(NVL(H.HUB_VALUE_BALANCE,0) - NVL(P.PROFITS_AVAILABLE_BALANCE,0)) &gt; 0.01

        UNION ALL
        --==============================================================
        --D4. Λογαριασμοί HUB με αρνητικό Value Balance (DFVLBL) σε μη-overdraft προϊόν
        SELECT
          'D4_NEGATIVE_BALANCE_NO_OVERDRAFT_HUB' AS CHECK_NAME,
          TRIM(ACCOUNT_NO), TRIM(CUSTOMER_CODE), 'DD',
          TO_CHAR(DFVLBL), CAST(NULL AS VARCHAR2(30)),
          'NEGATIVE_BALANCE_WITHOUT_OVERDRAFT' AS ISSUE
        FROM HUB_MT_DDACMSP
        WHERE DFAPTY NOT IN ('CA1','CA3','CA7','CA4','C10','CA2','CA8')
          AND DFVLBL &lt; 0

        UNION ALL
        --==============================================================
        --D5. Αρνητικό balance στο NCIS (μη-overdraft) που ΔΕΝ εμφανίζεται αρνητικό στο HUB
        SELECT
          'D5_NEGATIVE_BALANCE_NCIS_NOT_IN_HUB' AS CHECK_NAME,
          P.ACCOUNT_NUMBER, P.CUSTOMER_CODE, 'DD',
          TO_CHAR(H.HUB_VALUE_BALANCE), TO_CHAR(P.Available_Balance),
          'NEGATIVE_IN_NCIS_NOT_IN_HUB' AS ISSUE
        FROM (
          SELECT TRIM(N.Account_Number) AS ACCOUNT_NUMBER, TRIM(N.Customer_Code) AS CUSTOMER_CODE,
            N.Available_Balance, NVL(MAP.PRODUCT_TYPE, 'OTHER') AS PROFITS_PRODUCT_TYPE
          FROM NCIS_Deposits N
          LEFT JOIN (SELECT DISTINCT PROFITS_CODE, PRODUCT_TYPE FROM MG_HGR_DEPOSITS_PRODUCT_MAPPING) MAP
            ON MAP.PROFITS_CODE = TO_CHAR(N.Account_Type)
          WHERE N.Available_Balance &lt; 0
        ) P
        JOIN (
          SELECT TRIM(ACCOUNT_NO) AS ACCOUNT_NO, DFVLBL AS HUB_VALUE_BALANCE FROM HUB_MT_DDACMSP
        ) H ON H.ACCOUNT_NO = P.ACCOUNT_NUMBER
        WHERE P.PROFITS_PRODUCT_TYPE NOT IN (
            SELECT DISTINCT PRODUCT_TYPE FROM MG_HGR_DEPOSITS_PRODUCT_MAPPING WHERE HSBC_CODE IN ('CA1','CA3','CA7','CA4','C10','CA2','CA8')
          )
          AND NVL(H.HUB_VALUE_BALANCE, 0) &gt;= 0

        UNION ALL
        --==============================================================
        --D6. OVD λογαριασμοί με ΥΠΕΡΒΑΣΗ ορίου (unauthorized excess) - μόνο NCIS
        SELECT
          'D6_OVD_UNAUTHORIZED_EXCESS' AS CHECK_NAME,
          TO_CHAR(N.Account_Number), TO_CHAR(N.Customer_Code), 'OVD',
          TO_CHAR(N.Available_Balance), TO_CHAR(N.Overdraft_Limit_Amount),
          'BALANCE_EXCEEDS_OVERDRAFT_LIMIT' AS ISSUE
        FROM NCIS_Deposits N
        LEFT JOIN (SELECT DISTINCT PROFITS_CODE, PRODUCT_TYPE FROM MG_HGR_DEPOSITS_PRODUCT_MAPPING) MAP
          ON MAP.PROFITS_CODE = TO_CHAR(N.Account_Type)
        WHERE MAP.PRODUCT_TYPE = 'OVD'
          AND N.Available_Balance &lt; 0
          AND ABS(N.Available_Balance) &gt; NVL(N.Overdraft_Limit_Amount, 0)

        UNION ALL
        --==============================================================
        --D7. OVD λογαριασμοί ΧΩΡΙΣ τεκμηριωμένο όριο - μόνο NCIS
        SELECT
          'D7_OVD_MISSING_LIMIT' AS CHECK_NAME,
          TO_CHAR(N.Account_Number), TO_CHAR(N.Customer_Code), 'OVD',
          TO_CHAR(N.Overdraft_Limit_Amount), CAST(NULL AS VARCHAR2(30)),
          'OVD_WITHOUT_DOCUMENTED_LIMIT' AS ISSUE
        FROM NCIS_Deposits N
        LEFT JOIN (SELECT DISTINCT PROFITS_CODE, PRODUCT_TYPE FROM MG_HGR_DEPOSITS_PRODUCT_MAPPING) MAP
          ON MAP.PROFITS_CODE = TO_CHAR(N.Account_Type)
        WHERE MAP.PRODUCT_TYPE = 'OVD'
          AND NVL(N.Overdraft_Limit_Amount, 0) = 0

        UNION ALL
        --==============================================================
        --D10. Unauthorized interest flag - OVD με Unauthorized_Interest_Accrued &lt;&gt; 0 - μόνο NCIS
        SELECT
          'D10_OVD_UNAUTHORIZED_INTEREST' AS CHECK_NAME,
          TO_CHAR(N.Account_Number), TO_CHAR(N.Customer_Code), 'OVD',
          TO_CHAR(N.Unauthorized_Interest_Accrued), CAST(NULL AS VARCHAR2(30)),
          'UNAUTHORIZED_INTEREST_ACCRUED' AS ISSUE
        FROM NCIS_Deposits N
        LEFT JOIN (SELECT DISTINCT PROFITS_CODE, PRODUCT_TYPE FROM MG_HGR_DEPOSITS_PRODUCT_MAPPING) MAP
          ON MAP.PROFITS_CODE = TO_CHAR(N.Account_Type)
        WHERE MAP.PRODUCT_TYPE = 'OVD'
          AND NVL(N.Unauthorized_Interest_Accrued, 0) &lt;&gt; 0

        UNION ALL
        --==============================================================
        --D11. Αρνητικό balance χωρίς spread - OVD με Available_Balance&lt;0 αλλά OVD_Debit_Interest_Spread NULL
        SELECT
          'D11_OVD_NEGATIVE_BALANCE_NO_SPREAD' AS CHECK_NAME,
          TO_CHAR(N.Account_Number), TO_CHAR(N.Customer_Code), 'OVD',
          TO_CHAR(N.Available_Balance), CAST(NULL AS VARCHAR2(30)),
          'NEGATIVE_BALANCE_MISSING_INTEREST_SPREAD' AS ISSUE
        FROM NCIS_Deposits N
        LEFT JOIN (SELECT DISTINCT PROFITS_CODE, PRODUCT_TYPE FROM MG_HGR_DEPOSITS_PRODUCT_MAPPING) MAP
          ON MAP.PROFITS_CODE = TO_CHAR(N.Account_Type)
        WHERE MAP.PRODUCT_TYPE = 'OVD'
          AND N.Available_Balance &lt; 0
          AND N.OVD_Debit_Interest_Spread IS NULL

        UNION ALL
        --==============================================================
        --D12. Αρνητικό balance χωρίς δεδουλευμένους τόκους - OVD με Available_Balance&lt;0 αλλά Debit_Interest_Accruals=0
        SELECT
          'D12_OVD_NEGATIVE_BALANCE_NO_ACCRUALS' AS CHECK_NAME,
          TO_CHAR(N.Account_Number), TO_CHAR(N.Customer_Code), 'OVD',
          TO_CHAR(N.Available_Balance), TO_CHAR(N.Debit_Interest_Accruals),
          'NEGATIVE_BALANCE_NO_INTEREST_ACCRUED' AS ISSUE
        FROM NCIS_Deposits N
        LEFT JOIN (SELECT DISTINCT PROFITS_CODE, PRODUCT_TYPE FROM MG_HGR_DEPOSITS_PRODUCT_MAPPING) MAP
          ON MAP.PROFITS_CODE = TO_CHAR(N.Account_Type)
        WHERE MAP.PRODUCT_TYPE = 'OVD'
          AND N.Available_Balance &lt; 0
          AND NVL(N.Debit_Interest_Accruals, 0) = 0

        UNION ALL
        --==============================================================
        --D14. Missing Debit_Interest_Code - OVD αρνητικό balance χωρίς κωδικό επιτοκίου χρέωσης
        SELECT
          'D14_OVD_NEGATIVE_BALANCE_NO_INTEREST_CODE' AS CHECK_NAME,
          TO_CHAR(N.Account_Number), TO_CHAR(N.Customer_Code), 'OVD',
          TO_CHAR(N.Available_Balance), CAST(NULL AS VARCHAR2(30)),
          'NEGATIVE_BALANCE_MISSING_DEBIT_INTEREST_CODE' AS ISSUE
        FROM NCIS_Deposits N
        LEFT JOIN (SELECT DISTINCT PROFITS_CODE, PRODUCT_TYPE FROM MG_HGR_DEPOSITS_PRODUCT_MAPPING) MAP
          ON MAP.PROFITS_CODE = TO_CHAR(N.Account_Type)
        WHERE MAP.PRODUCT_TYPE = 'OVD'
          AND N.Available_Balance &lt; 0
          AND N.Debit_Interest_Code IS NULL

    ) F
)
ORDER BY REGEXP_SUBSTR(CHECK_ID, '[A-Z]+'), TO_NUMBER(REGEXP_SUBSTR(CHECK_ID, '[0-9]+')), ACCOUNT_NO;</property>
