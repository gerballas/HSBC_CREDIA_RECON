        <SQLTask:SqlTaskData
          SQLTask:Connection="{6821A5EC-D23A-4EAE-A8D7-C1BFCD7DE798}"
          SQLTask:SqlStatementSource="SELECT ISNULL(MAX(RUN_VERSION), 0) + 1 AS NewRunVersion &#xA;FROM RECON.DEP_RECON_MASTER &#xA;WHERE DC_VERSION = ?;"
