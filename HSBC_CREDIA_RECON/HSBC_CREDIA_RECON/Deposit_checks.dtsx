            <component
              refId="Package\DFT_Master\Oracle Source 1"
              componentClassID="Microsoft.SSISOracleSrc"
              contactInfo="Oracle Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;1"
              description="Oracle Source"
              name="Oracle Source 1"
              usesDispositions="true"
              version="1">
              <properties>
                <property
                  dataType="System.String"
                  description="The name of the table to be fetched."
                  expressionType="Notify"
                  name="TableName"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  expressionType="Notify"
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">-- ====================================================================
-- DEP_RECON — MASTER v3
-- Τροφοδοτεί: RECON.DEP_RECON_MASTER
-- Μία γραμμή ΑΝΑ CHECK_ID — 33 γραμμές ανά run:
-- A1-A13, G2-G4, B1-B3, E1-E2, E4, D1-D7, D10-D12, D14.
--
-- ΝΕΑ POPULATION_TYPE σε σχέση με v2: 'TD' (μόνο TD πληθυσμός, για E4)
-- και 'OVD' (NCIS λογαριασμοί με product_type=OVD μέσω mapping, για
-- D6/D7/D10/D11/D12/D14).
--
-- ΝΕΑ CATEGORY σε σχέση με v2: 'MAPPING_GAP' αντί για το απορριφθέν
-- 'REFERENCE_DATA', για ελέγχους όπου δεν βρίσκεται αντιστοίχιση σε
-- mapping/reference table (G2, B3). Είναι placeholder -- πες μου αν
-- θες διαφορετικό όνομα (π.χ. UNMAPPED_CODE, LOOKUP_FAILURE) και το
-- αλλάζω παντού.
--
-- ΣΗΜΕΙΩΣΗ: D10/D11/D12/D14 -- λείπουν D8, D9, D13 στην αρίθμηση (βλ.
-- σχόλιο στο DEP_RECON_DETAIL_V3.sql). Κράτησα τα CHECK_NAME literals
-- όπως δόθηκαν.
-- ====================================================================
WITH POPULATIONS AS (
    SELECT
        (SELECT COUNT(*) FROM HUB_MT_DDACMSP) AS DD_COUNT,
        (SELECT COUNT(*) FROM HUB_MT_TDACMSP) AS TD_COUNT,
        (SELECT COUNT(*) FROM NCIS_Deposits) AS NCIS_COUNT,
        (SELECT COUNT(*) FROM (
            SELECT ACCOUNT_NO FROM HUB_MT_DDACMSP
            UNION ALL
            SELECT ACCOUNT_NO FROM HUB_MT_TDACMSP
        )) AS HUB_DDTD_COUNT,
        (SELECT COUNT(*) FROM (
            SELECT ACCOUNT_NO FROM HUB_MT_DDACMSP WHERE DFSTUS = 1
            UNION ALL
            SELECT ACCOUNT_NO FROM HUB_MT_TDACMSP WHERE TDSTUS = 1
        )) AS HUB_DDTD_ACTIVE_COUNT,
        (SELECT COUNT(*)
           FROM (
                SELECT TRIM(ACCOUNT_NO) AS ACCOUNT_NO FROM HUB_MT_DDACMSP
                UNION ALL
                SELECT TRIM(ACCOUNT_NO) AS ACCOUNT_NO FROM HUB_MT_TDACMSP
           ) H
           JOIN (SELECT TRIM(Account_Number) AS ACCOUNT_NUMBER FROM NCIS_Deposits) N
             ON N.ACCOUNT_NUMBER = H.ACCOUNT_NO
        ) AS MATCHED_COUNT,
        (SELECT COUNT(*)
           FROM NCIS_Deposits N
           LEFT JOIN (SELECT DISTINCT PROFITS_CODE, PRODUCT_TYPE FROM MG_HGR_DEPOSITS_PRODUCT_MAPPING) MAP
             ON MAP.PROFITS_CODE = TO_CHAR(N.Account_Type)
           WHERE MAP.PRODUCT_TYPE = 'OVD'
        ) AS OVD_COUNT
    FROM DUAL
),
CHECK_META AS (
    -- CHECK_ID | CHECK_NAME | CATEGORY | DESCRIPTION | POPULATION_TYPE
    SELECT 'A1'  AS CHECK_ID, 'A1_ACCOUNT_MISSING_IN_NCIS'   AS CHECK_NAME, 'EXISTENCE'             AS CATEGORY, 'HUB (DD) accounts missing from NCIS'                        AS DESCRIPTION, 'DD'   AS POPULATION_TYPE FROM DUAL UNION ALL
    SELECT 'A2',  'A2_ACCOUNT_MISSING_IN_HUB',    'EXISTENCE',              'NCIS accounts missing from HUB (neither DD nor TD)',        'NCIS' FROM DUAL UNION ALL
    SELECT 'A3',  'A3_DUPLICATE_ACCOUNT_HUB',     'UNIQUENESS',             'Duplicate account numbers within HUB (DD+TD)',              'HUB_DDTD' FROM DUAL UNION ALL
    SELECT 'A4',  'A4_NULL_ACCOUNT_NO_HUB',       'COMPLETENESS',           'NULL/empty account number in HUB (DD+TD)',                  'HUB_DDTD' FROM DUAL UNION ALL
    SELECT 'A5',  'A5_NULL_ACCOUNT_NO_NCIS',      'COMPLETENESS',           'NULL/empty account number in NCIS',                         'NCIS' FROM DUAL UNION ALL
    SELECT 'A6',  'A6_DUPLICATE_ACCOUNT_NCIS',    'UNIQUENESS',             'Duplicate account numbers within NCIS',                     'NCIS' FROM DUAL UNION ALL
    SELECT 'A7',  'A7_NULL_CUSTOMER_CODE_HUB',    'COMPLETENESS',           'NULL/empty customer code in HUB (DD+TD)',                   'HUB_DDTD' FROM DUAL UNION ALL
    SELECT 'A8',  'A8_NULL_CUSTOMER_CODE_NCIS',   'COMPLETENESS',           'NULL/empty customer code in NCIS',                          'NCIS' FROM DUAL UNION ALL
    SELECT 'A9',  'A9_ACCOUNT_IN_BOTH_DD_TD',     'BUSINESS_RULE',          'Account exists in both DD and TD simultaneously',           'DD' FROM DUAL UNION ALL
    SELECT 'A10', 'A10_NULL_PRODUCT_CODE_HUB',    'COMPLETENESS',           'NULL/empty product code in HUB (DD+TD)',                    'HUB_DDTD' FROM DUAL UNION ALL
    SELECT 'A11', 'A11_NULL_ACCOUNT_TYPE_NCIS',   'COMPLETENESS',           'NULL account type in NCIS',                                 'NCIS' FROM DUAL UNION ALL
    SELECT 'A12', 'A12_NULL_BRANCH_CODE_HUB',     'COMPLETENESS',           'NULL/empty branch code in HUB (DD+TD)',                     'HUB_DDTD' FROM DUAL UNION ALL
    SELECT 'A13', 'A13_BRANCH_MISMATCH',          'CROSS_SYSTEM_MISMATCH', 'Branch code mismatch, HUB vs NCIS (matched accounts)',      'MATCHED' FROM DUAL UNION ALL
    SELECT 'G2',  'G2_UNMAPPED_PRODUCT_CODE',     'MAPPING_GAP',            'Unmapped product code, active HUB accounts (DD+TD)',        'HUB_DDTD_ACTIVE' FROM DUAL UNION ALL
    SELECT 'G3',  'G3_PRODUCT_TYPE_MISMATCH',     'CROSS_SYSTEM_MISMATCH', 'Product type mismatch, HUB vs NCIS (matched accounts)',     'MATCHED' FROM DUAL UNION ALL
    SELECT 'G4',  'G4_CURRENCY_MISMATCH',         'CROSS_SYSTEM_MISMATCH', 'Currency mismatch, HUB vs NCIS (matched accounts)',         'MATCHED' FROM DUAL UNION ALL
    SELECT 'B1',  'B1_CUSTOMER_CODE_MISMATCH',    'CROSS_SYSTEM_MISMATCH', 'Customer code mismatch, HUB (DD+TD, joint-resolved) vs NCIS','HUB_DDTD' FROM DUAL UNION ALL
    SELECT 'B3',  'B3_ORPHAN_NO_MAPPING',         'MAPPING_GAP',            'Effective customer code with no match in MG_CUSTOMER_INTER', 'HUB_DDTD' FROM DUAL UNION ALL
    SELECT 'B2',  'B2_BENEFICIARIES_MISMATCH',    'CROSS_SYSTEM_MISMATCH', 'Number of beneficiaries mismatch, HUB vs NCIS',             'MATCHED' FROM DUAL UNION ALL
    SELECT 'E1',  'E1_STATUS_MISMATCH',           'CROSS_SYSTEM_MISMATCH', 'Account status mismatch, HUB vs NCIS',                      'MATCHED' FROM DUAL UNION ALL
    SELECT 'E2',  'E2_OPEN_DATE_MISMATCH',        'CROSS_SYSTEM_MISMATCH', 'Account open date mismatch, HUB vs NCIS',                   'MATCHED' FROM DUAL UNION ALL
    SELECT 'E4',  'E4_TD_EXPIRATION_DATE_MISMATCH','CROSS_SYSTEM_MISMATCH','TD expiration date mismatch, HUB vs NCIS (TD only)',        'TD' FROM DUAL UNION ALL
    SELECT 'D1',  'D1_BOOK_BALANCE_MISMATCH',     'CROSS_SYSTEM_MISMATCH', 'Book/ledger balance mismatch, HUB vs NCIS (tolerance 0.01)','MATCHED' FROM DUAL UNION ALL
    SELECT 'D2',  'D2_BLOCKED_BALANCE_MISMATCH',  'CROSS_SYSTEM_MISMATCH', 'Blocked balance mismatch, HUB vs NCIS (tolerance 0.01)',    'MATCHED' FROM DUAL UNION ALL
    SELECT 'D3',  'D3_AVAILABLE_BALANCE_MISMATCH','CROSS_SYSTEM_MISMATCH', 'Available balance mismatch, HUB vs NCIS (DD only, unconfirmed mapping)', 'DD' FROM DUAL UNION ALL
    SELECT 'D4',  'D4_NEGATIVE_BALANCE_NO_OVERDRAFT_HUB', 'BUSINESS_RULE', 'Negative value balance in HUB on a non-overdraft product',   'DD' FROM DUAL UNION ALL
    SELECT 'D5',  'D5_NEGATIVE_BALANCE_NCIS_NOT_IN_HUB',  'BUSINESS_RULE', 'Negative balance in NCIS (non-overdraft) not reflected in HUB', 'NCIS' FROM DUAL UNION ALL
    SELECT 'D6',  'D6_OVD_UNAUTHORIZED_EXCESS',   'BUSINESS_RULE',         'OVD balance exceeds approved overdraft limit',              'OVD' FROM DUAL UNION ALL
    SELECT 'D7',  'D7_OVD_MISSING_LIMIT',         'COMPLETENESS',          'OVD account without a documented overdraft limit',          'OVD' FROM DUAL UNION ALL
    SELECT 'D10', 'D10_OVD_UNAUTHORIZED_INTEREST','BUSINESS_RULE',         'OVD account with unauthorized interest accrued',            'OVD' FROM DUAL UNION ALL
    SELECT 'D11', 'D11_OVD_NEGATIVE_BALANCE_NO_SPREAD',   'COMPLETENESS',  'OVD negative balance missing interest spread',              'OVD' FROM DUAL UNION ALL
    SELECT 'D12', 'D12_OVD_NEGATIVE_BALANCE_NO_ACCRUALS', 'BUSINESS_RULE', 'OVD negative balance with no interest accrued',             'OVD' FROM DUAL UNION ALL
    SELECT 'D14', 'D14_OVD_NEGATIVE_BALANCE_NO_INTEREST_CODE', 'COMPLETENESS', 'OVD negative balance missing debit interest code',      'OVD' FROM DUAL
),
FINDINGS_COUNT AS (
    -- Πλήθος ευρημάτων ανά CHECK_ID -- ΙΔΙΑ business logic με το DETAIL script,
    -- εδώ μόνο το CHECK_NAME χρειάζεται (για GROUP BY).
    SELECT SUBSTR(CHECK_NAME, 1, INSTR(CHECK_NAME, '_') - 1) AS CHECK_ID, COUNT(*) AS INVALID_COUNT
    FROM (
        SELECT 'A1_ACCOUNT_MISSING_IN_NCIS' AS CHECK_NAME FROM (
            SELECT TRIM(H.ACCOUNT_NO) AS ACCOUNT_NO FROM HUB_MT_DDACMSP H
        ) H
        LEFT JOIN (SELECT TRIM(N.Account_Number) AS ACCOUNT_NUMBER FROM NCIS_Deposits N) P ON P.ACCOUNT_NUMBER = H.ACCOUNT_NO
        WHERE P.ACCOUNT_NUMBER IS NULL

        UNION ALL
        SELECT 'A2_ACCOUNT_MISSING_IN_HUB' FROM (
            SELECT TRIM(N.Account_Number) AS ACCOUNT_NUMBER FROM NCIS_Deposits N
        ) P
        LEFT JOIN (SELECT TRIM(ACCOUNT_NO) AS ACCOUNT_NO FROM HUB_MT_TDACMSP) T ON T.ACCOUNT_NO = P.ACCOUNT_NUMBER
        LEFT JOIN (SELECT TRIM(ACCOUNT_NO) AS ACCOUNT_NO FROM HUB_MT_DDACMSP) H ON H.ACCOUNT_NO = P.ACCOUNT_NUMBER
        WHERE H.ACCOUNT_NO IS NULL AND T.ACCOUNT_NO IS NULL

        UNION ALL
        SELECT 'A3_DUPLICATE_ACCOUNT_HUB' FROM (
            SELECT ACCOUNT_NO, DEPOSIT_ACCOUNT_CATEGORY
            FROM (
                SELECT TRIM(ACCOUNT_NO) AS ACCOUNT_NO, 'DD' AS DEPOSIT_ACCOUNT_CATEGORY FROM HUB_MT_DDACMSP
                UNION ALL
                SELECT TRIM(ACCOUNT_NO) AS ACCOUNT_NO, 'TD' AS DEPOSIT_ACCOUNT_CATEGORY FROM HUB_MT_TDACMSP
            )
            GROUP BY ACCOUNT_NO, DEPOSIT_ACCOUNT_CATEGORY
            HAVING COUNT(*) &gt; 1
        )

        UNION ALL
        SELECT 'A4_NULL_ACCOUNT_NO_HUB' FROM (
            SELECT TRIM(TO_CHAR(ACCOUNT_NO)) AS ACCOUNT_NO FROM HUB_MT_DDACMSP
            UNION ALL
            SELECT TRIM(TO_CHAR(ACCOUNT_NO)) AS ACCOUNT_NO FROM HUB_MT_TDACMSP
        )
        WHERE ACCOUNT_NO IS NULL OR TRIM(ACCOUNT_NO) = ''

        UNION ALL
        SELECT 'A5_NULL_ACCOUNT_NO_NCIS' FROM NCIS_Deposits
        WHERE Account_Number IS NULL OR TRIM(TO_CHAR(Account_Number)) = ''

        UNION ALL
        SELECT 'A6_DUPLICATE_ACCOUNT_NCIS' FROM (
            SELECT TRIM(Account_Number) AS ACCOUNT_NUMBER
            FROM NCIS_Deposits
            GROUP BY TRIM(Account_Number)
            HAVING COUNT(*) &gt; 1
        )

        UNION ALL
        SELECT 'A7_NULL_CUSTOMER_CODE_HUB' FROM (
            SELECT TO_CHAR(CUSTOMER_CODE) AS CUSTOMER_CODE FROM HUB_MT_DDACMSP
            UNION ALL
            SELECT TO_CHAR(CUSTOMER_CODE) AS CUSTOMER_CODE FROM HUB_MT_TDACMSP
        )
        WHERE CUSTOMER_CODE IS NULL OR TRIM(CUSTOMER_CODE) = ''

        UNION ALL
        SELECT 'A8_NULL_CUSTOMER_CODE_NCIS' FROM NCIS_Deposits
        WHERE Customer_Code IS NULL OR TRIM(TO_CHAR(Customer_Code)) = ''

        UNION ALL
        SELECT 'A9_ACCOUNT_IN_BOTH_DD_TD' FROM HUB_MT_DDACMSP DF
        JOIN HUB_MT_TDACMSP TD ON TRIM(TD.ACCOUNT_NO) = TRIM(DF.ACCOUNT_NO)

        UNION ALL
        SELECT 'A10_NULL_PRODUCT_CODE_HUB' FROM (
            SELECT DFAPTY AS PRODUCT_CODE FROM HUB_MT_DDACMSP
            UNION ALL
            SELECT TDAPTY AS PRODUCT_CODE FROM HUB_MT_TDACMSP
        )
        WHERE PRODUCT_CODE IS NULL OR TRIM(PRODUCT_CODE) = ''

        UNION ALL
        SELECT 'A11_NULL_ACCOUNT_TYPE_NCIS' FROM NCIS_Deposits
        WHERE Account_Type IS NULL

        UNION ALL
        SELECT 'A12_NULL_BRANCH_CODE_HUB' FROM (
            SELECT DFACB AS BRANCH_CODE FROM HUB_MT_DDACMSP
            UNION ALL
            SELECT TDACB AS BRANCH_CODE FROM HUB_MT_TDACMSP
        )
        WHERE BRANCH_CODE IS NULL

        UNION ALL
        SELECT 'A13_BRANCH_MISMATCH' FROM (
            SELECT TRIM(ACCOUNT_NO) AS ACCOUNT_NO, TRIM(TO_CHAR(DFACB)) AS HUB_BRANCH FROM HUB_MT_DDACMSP
            UNION ALL
            SELECT TRIM(ACCOUNT_NO) AS ACCOUNT_NO, TRIM(TO_CHAR(TDACB)) AS HUB_BRANCH FROM HUB_MT_TDACMSP
        ) H
        JOIN (SELECT TRIM(Account_Number) AS ACCOUNT_NUMBER, TRIM(TO_CHAR(Unit_Code)) AS PROFITS_UNIT_CODE FROM NCIS_Deposits) P
            ON P.ACCOUNT_NUMBER = H.ACCOUNT_NO
        WHERE NVL(H.HUB_BRANCH,'x') &lt;&gt; NVL(P.PROFITS_UNIT_CODE,'x')

        UNION ALL
        SELECT 'G2_UNMAPPED_PRODUCT_CODE' FROM (
            SELECT NVL(MAP.PRODUCT_TYPE, 'UNMAPPED') AS HUB_PRODUCT_TYPE, TRIM(DF.DFSTUS) AS STATUS
            FROM HUB_MT_DDACMSP DF
            LEFT JOIN MG_HGR_DEPOSITS_PRODUCT_MAPPING MAP ON MAP.HSBC_CODE = TRIM(DF.DFAPTY)
            UNION ALL
            SELECT NVL(MAP.PRODUCT_TYPE, 'UNMAPPED') AS HUB_PRODUCT_TYPE, TRIM(TD.TDSTUS) AS STATUS
            FROM HUB_MT_TDACMSP TD
            LEFT JOIN MG_HGR_DEPOSITS_PRODUCT_MAPPING MAP ON MAP.HSBC_CODE = TRIM(TD.TDAPTY)
        )
        WHERE HUB_PRODUCT_TYPE = 'UNMAPPED' AND STATUS = 1

        UNION ALL
        SELECT 'G3_PRODUCT_TYPE_MISMATCH' FROM (
            SELECT TRIM(DF.ACCOUNT_NO) AS ACCOUNT_NO, NVL(MAP.PRODUCT_TYPE, 'UNMAPPED') AS HUB_PRODUCT_TYPE
            FROM HUB_MT_DDACMSP DF
            LEFT JOIN MG_HGR_DEPOSITS_PRODUCT_MAPPING MAP ON MAP.HSBC_CODE = TRIM(DF.DFAPTY)
            UNION ALL
            SELECT TRIM(TD.ACCOUNT_NO) AS ACCOUNT_NO, NVL(MAP.PRODUCT_TYPE, 'UNMAPPED') AS HUB_PRODUCT_TYPE
            FROM HUB_MT_TDACMSP TD
            LEFT JOIN MG_HGR_DEPOSITS_PRODUCT_MAPPING MAP ON MAP.HSBC_CODE = TRIM(TD.TDAPTY)
        ) H
        JOIN (
            SELECT TRIM(N.Account_Number) AS ACCOUNT_NUMBER, NVL(MAP.PRODUCT_TYPE, 'OTHER') AS PROFITS_PRODUCT_TYPE
            FROM NCIS_Deposits N
            LEFT JOIN (SELECT DISTINCT PROFITS_CODE, PRODUCT_TYPE FROM MG_HGR_DEPOSITS_PRODUCT_MAPPING) MAP
                ON MAP.PROFITS_CODE = TO_CHAR(N.Account_Type)
        ) P ON P.ACCOUNT_NUMBER = H.ACCOUNT_NO
        WHERE NVL(H.HUB_PRODUCT_TYPE, CHR(1)) &lt;&gt; NVL(P.PROFITS_PRODUCT_TYPE, CHR(1))

        UNION ALL
        SELECT 'G4_CURRENCY_MISMATCH' FROM (
            SELECT TRIM(ACCOUNT_NO) AS ACCOUNT_NO, TRIM(DFCYCD) AS HUB_CURRENCY FROM HUB_MT_DDACMSP
            UNION ALL
            SELECT TRIM(ACCOUNT_NO) AS ACCOUNT_NO, TRIM(TDCYCD) AS HUB_CURRENCY FROM HUB_MT_TDACMSP
        ) H
        JOIN (SELECT TRIM(Account_Number) AS ACCOUNT_NUMBER, TRIM(Account_Currency) AS PROFITS_CURRENCY FROM NCIS_Deposits) P
            ON P.ACCOUNT_NUMBER = H.ACCOUNT_NO
        WHERE NVL(H.HUB_CURRENCY,'x') &lt;&gt; NVL(P.PROFITS_CURRENCY,'x')

        UNION ALL
        SELECT 'B1_CUSTOMER_CODE_MISMATCH' FROM (
            SELECT
                JR.ACCOUNT_NO, MCI.PRFT_CUST_ID
            FROM (
                SELECT
                    A.ACCOUNT_NO,
                    CASE WHEN J.CUSTOMER_1 IS NOT NULL THEN TRIM(J.CUSTOMER_BENEF_LIST) ELSE A.HUB_CUSTOMER_CODE END AS EFFECTIVE_CUSTOMER_CODE
                FROM (
                    SELECT TRIM(ACCOUNT_NO) AS ACCOUNT_NO, TRIM(CUSTOMER_CODE) AS HUB_CUSTOMER_CODE FROM HUB_MT_DDACMSP
                    UNION ALL
                    SELECT TRIM(ACCOUNT_NO) AS ACCOUNT_NO, TRIM(CUSTOMER_CODE) AS HUB_CUSTOMER_CODE FROM HUB_MT_TDACMSP
                ) A
                LEFT JOIN HGR_MG_JOINT J ON J.CUSTOMER_1 = A.HUB_CUSTOMER_CODE AND J.SERIAL_NO = 1
            ) JR
            LEFT JOIN MG_CUSTOMER_INTER MCI ON TRIM(TO_CHAR(MCI.CUSTOMER_CODE)) = TRIM(TO_CHAR(JR.EFFECTIVE_CUSTOMER_CODE))
        ) M
        LEFT JOIN NCIS_Deposits N ON TRIM(TO_CHAR(N.Account_Number)) = TO_CHAR(M.ACCOUNT_NO)
        WHERE TRIM(TO_CHAR(M.PRFT_CUST_ID)) &lt;&gt; TRIM(TO_CHAR(N.Customer_Code))

        UNION ALL
        SELECT 'B3_ORPHAN_NO_MAPPING' FROM (
            SELECT
                A.ACCOUNT_NO,
                CASE WHEN J.CUSTOMER_1 IS NOT NULL THEN TRIM(J.CUSTOMER_BENEF_LIST) ELSE A.HUB_CUSTOMER_CODE END AS EFFECTIVE_CUSTOMER_CODE
            FROM (
                SELECT TRIM(ACCOUNT_NO) AS ACCOUNT_NO, TRIM(CUSTOMER_CODE) AS HUB_CUSTOMER_CODE FROM HUB_MT_DDACMSP
                UNION ALL
                SELECT TRIM(ACCOUNT_NO) AS ACCOUNT_NO, TRIM(CUSTOMER_CODE) AS HUB_CUSTOMER_CODE FROM HUB_MT_TDACMSP
            ) A
            LEFT JOIN HGR_MG_JOINT J ON J.CUSTOMER_1 = A.HUB_CUSTOMER_CODE AND J.SERIAL_NO = 1
        ) JR
        WHERE NOT EXISTS (
            SELECT 1 FROM MG_CUSTOMER_INTER MCI
            WHERE TRIM(TO_CHAR(MCI.CUSTOMER_CODE)) = TRIM(TO_CHAR(JR.EFFECTIVE_CUSTOMER_CODE))
        )

        UNION ALL
        SELECT 'B2_BENEFICIARIES_MISMATCH' FROM (
            SELECT TRIM(ACCOUNT_NO) AS ACCOUNT_NO, TRIM(CUSTOMER_CODE) AS HUB_CUSTOMER_CODE FROM HUB_MT_DDACMSP
            UNION ALL
            SELECT TRIM(ACCOUNT_NO) AS ACCOUNT_NO, TRIM(CUSTOMER_CODE) AS HUB_CUSTOMER_CODE FROM HUB_MT_TDACMSP
        ) H
        LEFT JOIN (
            SELECT TRIM(CUSTOMER_1) AS CUSTOMER_1, COUNT(*) AS HUB_BENEF_CNT FROM HGR_MG_JOINT GROUP BY TRIM(CUSTOMER_1)
        ) B ON B.CUSTOMER_1 = H.HUB_CUSTOMER_CODE
        JOIN (
            SELECT TRIM(Account_Number) AS ACCOUNT_NUMBER, Number_Of_Beneficiaries AS PROFITS_BENEF_CNT FROM NCIS_Deposits
        ) P ON P.ACCOUNT_NUMBER = H.ACCOUNT_NO
        WHERE CASE WHEN NVL(B.HUB_BENEF_CNT, 0) = 0 THEN 1 ELSE NVL(B.HUB_BENEF_CNT, 0) END &lt;&gt; NVL(P.PROFITS_BENEF_CNT, 0)

        UNION ALL
        SELECT 'E1_STATUS_MISMATCH' FROM (
            SELECT TRIM(ACCOUNT_NO) AS ACCOUNT_NO, TRIM(DFSTUS) AS HUB_STATUS FROM HUB_MT_DDACMSP
            UNION ALL
            SELECT TRIM(ACCOUNT_NO) AS ACCOUNT_NO, TRIM(TDSTUS) AS HUB_STATUS FROM HUB_MT_TDACMSP
        ) H
        JOIN (
            SELECT TRIM(Account_Number) AS ACCOUNT_NUMBER, TRIM(Account_Status) AS PROFITS_STATUS FROM NCIS_Deposits
        ) P ON P.ACCOUNT_NUMBER = H.ACCOUNT_NO
        WHERE NVL(H.HUB_STATUS,'x') &lt;&gt; NVL(P.PROFITS_STATUS,'x')

        UNION ALL
        SELECT 'E2_OPEN_DATE_MISMATCH' FROM (
            SELECT TRIM(ACCOUNT_NO) AS ACCOUNT_NO, DFDTAO AS HUB_OPEN_DATE FROM HUB_MT_DDACMSP
            UNION ALL
            SELECT TRIM(ACCOUNT_NO) AS ACCOUNT_NO, TDDTAO AS HUB_OPEN_DATE FROM HUB_MT_TDACMSP
        ) H
        JOIN (
            SELECT TRIM(Account_Number) AS ACCOUNT_NUMBER, Open_Date AS PROFITS_OPEN_DATE FROM NCIS_Deposits
        ) P ON P.ACCOUNT_NUMBER = H.ACCOUNT_NO
        WHERE TO_DATE(TRIM(TO_CHAR(H.HUB_OPEN_DATE)), 'YYYYMMDD') &lt;&gt; TRUNC(P.PROFITS_OPEN_DATE)

        UNION ALL
        SELECT 'E4_TD_EXPIRATION_DATE_MISMATCH' FROM (
            SELECT TRIM(ACCOUNT_NO) AS ACCOUNT_NO, TDDUDT AS HUB_DUE_DATE FROM HUB_MT_TDACMSP
        ) H
        JOIN (
            SELECT TRIM(Account_Number) AS ACCOUNT_NUMBER, TD_Expiration_Date AS PROFITS_EXPIRATION_DATE
            FROM NCIS_Deposits WHERE TD_Expiration_Date IS NOT NULL
        ) P ON P.ACCOUNT_NUMBER = H.ACCOUNT_NO
        WHERE TO_DATE(TRIM(TO_CHAR(H.HUB_DUE_DATE)), 'YYYYMMDD') &lt;&gt; TRUNC(P.PROFITS_EXPIRATION_DATE)

        UNION ALL
        SELECT 'D1_BOOK_BALANCE_MISMATCH' FROM (
            SELECT TRIM(ACCOUNT_NO) AS ACCOUNT_NO, DFRLBL AS HUB_LEDGER_BALANCE FROM HUB_MT_DDACMSP
            UNION ALL
            SELECT TRIM(ACCOUNT_NO) AS ACCOUNT_NO, TDRLBL AS HUB_LEDGER_BALANCE FROM HUB_MT_TDACMSP
        ) H
        JOIN (
            SELECT TRIM(Account_Number) AS ACCOUNT_NUMBER, Book_Balance AS PROFITS_BOOK_BALANCE FROM NCIS_Deposits
        ) P ON P.ACCOUNT_NUMBER = H.ACCOUNT_NO
        WHERE ABS(NVL(H.HUB_LEDGER_BALANCE,0) - NVL(P.PROFITS_BOOK_BALANCE,0)) &gt; 0.01

        UNION ALL
        SELECT 'D2_BLOCKED_BALANCE_MISMATCH' FROM (
            SELECT TRIM(ACCOUNT_NO) AS ACCOUNT_NO, DFTTHD AS HUB_TOTAL_HOLDS FROM HUB_MT_DDACMSP
            UNION ALL
            SELECT TRIM(ACCOUNT_NO) AS ACCOUNT_NO, TDTTHD AS HUB_TOTAL_HOLDS FROM HUB_MT_TDACMSP
        ) H
        JOIN (
            SELECT TRIM(Account_Number) AS ACCOUNT_NUMBER, Blocked_Balance AS PROFITS_BLOCKED_BALANCE FROM NCIS_Deposits
        ) P ON P.ACCOUNT_NUMBER = H.ACCOUNT_NO
        WHERE ABS(NVL(H.HUB_TOTAL_HOLDS,0) - NVL(P.PROFITS_BLOCKED_BALANCE,0)) &gt; 0.01

        UNION ALL
        SELECT 'D3_AVAILABLE_BALANCE_MISMATCH' FROM (
            SELECT TRIM(ACCOUNT_NO) AS ACCOUNT_NO, DFVLBL AS HUB_VALUE_BALANCE FROM HUB_MT_DDACMSP
        ) H
        JOIN (
            SELECT TRIM(Account_Number) AS ACCOUNT_NUMBER, Available_Balance AS PROFITS_AVAILABLE_BALANCE FROM NCIS_Deposits
        ) P ON P.ACCOUNT_NUMBER = H.ACCOUNT_NO
        WHERE ABS(NVL(H.HUB_VALUE_BALANCE,0) - NVL(P.PROFITS_AVAILABLE_BALANCE,0)) &gt; 0.01

        UNION ALL
        SELECT 'D4_NEGATIVE_BALANCE_NO_OVERDRAFT_HUB' FROM HUB_MT_DDACMSP
        WHERE DFAPTY NOT IN ('CA1','CA3','CA7','CA4','C10','CA2','CA8')
          AND DFVLBL &lt; 0

        UNION ALL
        SELECT 'D5_NEGATIVE_BALANCE_NCIS_NOT_IN_HUB' FROM (
            SELECT TRIM(N.Account_Number) AS ACCOUNT_NUMBER, N.Available_Balance,
                NVL(MAP.PRODUCT_TYPE, 'OTHER') AS PROFITS_PRODUCT_TYPE
            FROM NCIS_Deposits N
            LEFT JOIN (SELECT DISTINCT PROFITS_CODE, PRODUCT_TYPE FROM MG_HGR_DEPOSITS_PRODUCT_MAPPING) MAP
                ON MAP.PROFITS_CODE = TO_CHAR(N.Account_Type)
            WHERE N.Available_Balance &lt; 0
        ) P
        JOIN (
            SELECT TRIM(ACCOUNT_NO) AS ACCOUNT_NO, DFVLBL AS HUB_VALUE_BALANCE FROM HUB_MT_DDACMSP
        ) H ON H.ACCOUNT_NO = P.ACCOUNT_NUMBER
        WHERE P.PROFITS_PRODUCT_TYPE NOT IN (
            SELECT DISTINCT PRODUCT_TYPE FROM MG_HGR_DEPOSITS_PRODUCT_MAPPING WHERE HSBC_CODE IN ('CA1','CA3','CA7','CA4','C10','CA2','CA8')
          )
          AND NVL(H.HUB_VALUE_BALANCE, 0) &gt;= 0

        UNION ALL
        SELECT 'D6_OVD_UNAUTHORIZED_EXCESS' FROM NCIS_Deposits N
        LEFT JOIN (SELECT DISTINCT PROFITS_CODE, PRODUCT_TYPE FROM MG_HGR_DEPOSITS_PRODUCT_MAPPING) MAP
          ON MAP.PROFITS_CODE = TO_CHAR(N.Account_Type)
        WHERE MAP.PRODUCT_TYPE = 'OVD'
          AND N.Available_Balance &lt; 0
          AND ABS(N.Available_Balance) &gt; NVL(N.Overdraft_Limit_Amount, 0)

        UNION ALL
        SELECT 'D7_OVD_MISSING_LIMIT' FROM NCIS_Deposits N
        LEFT JOIN (SELECT DISTINCT PROFITS_CODE, PRODUCT_TYPE FROM MG_HGR_DEPOSITS_PRODUCT_MAPPING) MAP
          ON MAP.PROFITS_CODE = TO_CHAR(N.Account_Type)
        WHERE MAP.PRODUCT_TYPE = 'OVD'
          AND NVL(N.Overdraft_Limit_Amount, 0) = 0

        UNION ALL
        SELECT 'D10_OVD_UNAUTHORIZED_INTEREST' FROM NCIS_Deposits N
        LEFT JOIN (SELECT DISTINCT PROFITS_CODE, PRODUCT_TYPE FROM MG_HGR_DEPOSITS_PRODUCT_MAPPING) MAP
          ON MAP.PROFITS_CODE = TO_CHAR(N.Account_Type)
        WHERE MAP.PRODUCT_TYPE = 'OVD'
          AND NVL(N.Unauthorized_Interest_Accrued, 0) &lt;&gt; 0

        UNION ALL
        SELECT 'D11_OVD_NEGATIVE_BALANCE_NO_SPREAD' FROM NCIS_Deposits N
        LEFT JOIN (SELECT DISTINCT PROFITS_CODE, PRODUCT_TYPE FROM MG_HGR_DEPOSITS_PRODUCT_MAPPING) MAP
          ON MAP.PROFITS_CODE = TO_CHAR(N.Account_Type)
        WHERE MAP.PRODUCT_TYPE = 'OVD'
          AND N.Available_Balance &lt; 0
          AND N.OVD_Debit_Interest_Spread IS NULL

        UNION ALL
        SELECT 'D12_OVD_NEGATIVE_BALANCE_NO_ACCRUALS' FROM NCIS_Deposits N
        LEFT JOIN (SELECT DISTINCT PROFITS_CODE, PRODUCT_TYPE FROM MG_HGR_DEPOSITS_PRODUCT_MAPPING) MAP
          ON MAP.PROFITS_CODE = TO_CHAR(N.Account_Type)
        WHERE MAP.PRODUCT_TYPE = 'OVD'
          AND N.Available_Balance &lt; 0
          AND NVL(N.Debit_Interest_Accruals, 0) = 0

        UNION ALL
        SELECT 'D14_OVD_NEGATIVE_BALANCE_NO_INTEREST_CODE' FROM NCIS_Deposits N
        LEFT JOIN (SELECT DISTINCT PROFITS_CODE, PRODUCT_TYPE FROM MG_HGR_DEPOSITS_PRODUCT_MAPPING) MAP
          ON MAP.PROFITS_CODE = TO_CHAR(N.Account_Type)
        WHERE MAP.PRODUCT_TYPE = 'OVD'
          AND N.Available_Balance &lt; 0
          AND N.Debit_Interest_Code IS NULL
    )
    GROUP BY SUBSTR(CHECK_NAME, 1, INSTR(CHECK_NAME, '_') - 1)
)
SELECT
    CAST(CM.CHECK_ID AS VARCHAR2(10)) AS CHECK_ID,
    CAST(CM.CHECK_NAME AS VARCHAR2(50)) AS CHECK_NAME,
    CAST(CM.CATEGORY AS VARCHAR2(30)) AS CATEGORY,
    CAST(CM.DESCRIPTION AS VARCHAR2(200)) AS DESCRIPTION,
    (CASE CM.POPULATION_TYPE
        WHEN 'DD'               THEN P.DD_COUNT
        WHEN 'TD'                THEN P.TD_COUNT
        WHEN 'NCIS'             THEN P.NCIS_COUNT
        WHEN 'HUB_DDTD'         THEN P.HUB_DDTD_COUNT
        WHEN 'HUB_DDTD_ACTIVE'  THEN P.HUB_DDTD_ACTIVE_COUNT
        WHEN 'MATCHED'          THEN P.MATCHED_COUNT
        WHEN 'OVD'              THEN P.OVD_COUNT
     END) AS TOTAL_RECORDS,
    (CASE CM.POPULATION_TYPE
        WHEN 'DD'               THEN P.DD_COUNT
        WHEN 'TD'                THEN P.TD_COUNT
        WHEN 'NCIS'             THEN P.NCIS_COUNT
        WHEN 'HUB_DDTD'         THEN P.HUB_DDTD_COUNT
        WHEN 'HUB_DDTD_ACTIVE'  THEN P.HUB_DDTD_ACTIVE_COUNT
        WHEN 'MATCHED'          THEN P.MATCHED_COUNT
        WHEN 'OVD'              THEN P.OVD_COUNT
     END) - NVL(FC.INVALID_COUNT, 0) AS VALID_COUNT,
    NVL(FC.INVALID_COUNT, 0) AS INVALID_COUNT,
    CASE WHEN NVL(FC.INVALID_COUNT, 0) = 0 THEN 'PASS' ELSE 'FAIL' END AS STATUS,
    'DC3' AS DC_VERSION,
    1 AS RUN_VERSION,  -- TESTING ONLY: στο SSIS αντικαθίσταται από @[User::RunVersion] μέσω Derived Column.
    SYSDATE AS RUN_TIMESTAMP
FROM CHECK_META CM
CROSS JOIN POPULATIONS P
LEFT JOIN FINDINGS_COUNT FC ON FC.CHECK_ID = CM.CHECK_ID
ORDER BY REGEXP_SUBSTR(CM.CHECK_ID, '[A-Z]+'), TO_NUMBER(REGEXP_SUBSTR(CM.CHECK_ID, '[0-9]+'));</property>
                <property
                  dataType="System.Int32"
                  description="Specify the number of rows fetched per batch."
                  expressionType="Notify"
                  name="BatchSize">1000</property>
                <property
                  dataType="System.Int32"
                  description="Determines the chunk size allocation for LOB columns"
                  expressionType="Notify"
                  name="LobChunkSize">32768</property>
                <property
                  dataType="System.Int32"
                  description="The code page to use when code page information is unavailable from the data source."
                  expressionType="Notify"
                  name="DefaultCodePage">1253</property>
                <property
                  dataType="System.Int32"
                  description="Number of pre-fetched rows."
                  expressionType="Notify"
                  name="PrefetchCount">0</property>
                <property
                  dataType="System.Int32"
                  description="The mode used to access the database."
                  name="AccessMode"
                  typeConverter="AccessMode">1</property>
              </properties>
              <connections>
                <connection
                  refId="Package\DFT_Master\Oracle Source 1.Connections[ORACLEConnection]"
                  connectionManagerID="{ECA91632-834F-4B2F-85DF-6CA637347F58}:external"
                  connectionManagerRefId="Project.ConnectionManagers[PRE Connection Manager]"
                  description="The ORACLE runtime connection used to access the database."
                  name="ORACLEConnection" />
              </connections>
              <outputs>
                <output
                  refId="Package\DFT_Master\Oracle Source 1.Outputs[Oracle Source Output]"
                  errorRowDisposition="FailComponent"
                  name="Oracle Source Output"
                  truncationRowDisposition="FailComponent">
                  <outputColumns>
                    <outputColumn
                      refId="Package\DFT_Master\Oracle Source 1.Outputs[Oracle Source Output].Columns[CHECK_ID]"
                      codePage="1253"
                      dataType="str"
                      externalMetadataColumnId="Package\DFT_Master\Oracle Source 1.Outputs[Oracle Source Output].ExternalColumns[CHECK_ID]"
                      length="10"
                      lineageId="Package\DFT_Master\Oracle Source 1.Outputs[Oracle Source Output].Columns[CHECK_ID]"
                      name="CHECK_ID" />
                    <outputColumn
