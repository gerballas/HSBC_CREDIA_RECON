    <DTS:Executable
      DTS:refId="Package\Create Tables"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{59EA03EB-A408-4365-B515-EF032CDDA4D1}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Create Tables"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2022; © 2022 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{6821A5EC-D23A-4EAE-A8D7-C1BFCD7DE798}"
          SQLTask:SqlStatementSource="IF NOT EXISTS (&#xA;    SELECT 1 FROM sys.tables t JOIN sys.schemas s ON t.schema_id = s.schema_id&#xA;    WHERE s.name = 'RECON' AND t.name = 'DEP_RECON_MASTER'&#xA;)&#xA;BEGIN&#xA;    CREATE TABLE RECON.DEP_RECON_MASTER (&#xA;        CHECK_ID        VARCHAR(10)     NOT NULL,&#xA;        CHECK_NAME      VARCHAR(50)     NOT NULL,&#xA;        CATEGORY        VARCHAR(30)     NOT NULL,&#xA;        DESCRIPTION     VARCHAR(200)    NULL,&#xA;        TOTAL_RECORDS   INT             NOT NULL,&#xA;        VALID_COUNT     INT             NOT NULL,&#xA;        INVALID_COUNT   INT             NOT NULL,&#xA;        STATUS          VARCHAR(4)      NOT NULL,&#xA;        DC_VERSION      VARCHAR(5)      NOT NULL,&#xA;        RUN_VERSION     INT             NOT NULL,&#xA;        RUN_TIMESTAMP   DATETIME2(7)    NOT NULL,&#xA;        CONSTRAINT PK_DEP_RECON_MASTER PRIMARY KEY (CHECK_ID, DC_VERSION, RUN_VERSION)&#xA;    );&#xA;END&#xA;&#xA;IF NOT EXISTS (&#xA;    SELECT 1 FROM sys.tables t JOIN sys.schemas s ON t.schema_id = s.schema_id&#xA;    WHERE s.name = 'RECON' AND t.name = 'DEP_RECON_DETAIL'&#xA;)&#xA;BEGIN&#xA;    CREATE TABLE RECON.DEP_RECON_DETAIL (&#xA;        DETAIL_ID                  VARCHAR(20)     NOT NULL,&#xA;        CHECK_ID                   VARCHAR(10)     NOT NULL,&#xA;        CHECK_NAME                 VARCHAR(50)     NOT NULL,&#xA;        ACCOUNT_NO                 VARCHAR(30)     NULL,&#xA;        CUSTOMER_CODE              VARCHAR(30)     NULL,&#xA;        DEPOSIT_ACCOUNT_CATEGORY   VARCHAR(10)     NULL,&#xA;        HUB_VALUE                  VARCHAR(100)    NULL,&#xA;        NCIS_VALUE                 VARCHAR(100)    NULL,&#xA;        ISSUE                      VARCHAR(50)     NOT NULL,&#xA;        DC_VERSION                 VARCHAR(5)      NOT NULL,&#xA;        RUN_VERSION                INT             NOT NULL,&#xA;        RUN_TIMESTAMP              DATETIME2(7)    NOT NULL,&#xA;        CONSTRAINT PK_DEP_RECON_DETAIL PRIMARY KEY (DETAIL_ID, DC_VERSION, RUN_VERSION),&#xA;        CONSTRAINT FK_DEP_RECON_DETAIL_MASTER FOREIGN KEY (CHECK_ID, DC_VERSION, RUN_VERSION)&#xA;            REFERENCES RECON.DEP_RECON_MASTER (CHECK_ID, DC_VERSION, RUN_VERSION)&#xA;    );&#xA;&#xA;    CREATE INDEX IX_DEP_RECON_DETAIL_CHECK ON RECON.DEP_RECON_DETAIL (CHECK_ID, DC_VERSION, RUN_VERSION);&#xA;END" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
