                      name="DEPOSIT_ACCOUNT_CATEGORY" />
                    <outputColumn
                      refId="Package\DFT_Detail\Oracle Source 1.Outputs[Oracle Source Error Output].Columns[HUB_VALUE]"
                      codePage="1253"
                      dataType="str"
                      externalMetadataColumnId="Package\DFT_Detail\Oracle Source 1.Outputs[Oracle Source Output].ExternalColumns[HUB_VALUE]"
                      length="100"
                      lineageId="Package\DFT_Detail\Oracle Source 1.Outputs[Oracle Source Error Output].Columns[HUB_VALUE]"
                      name="HUB_VALUE" />
                    <outputColumn
                      refId="Package\DFT_Detail\Oracle Source 1.Outputs[Oracle Source Error Output].Columns[NCIS_VALUE]"
