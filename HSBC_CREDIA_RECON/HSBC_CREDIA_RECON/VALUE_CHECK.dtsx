    UNION ALL
    SELECT 'HUB_MT_EBCUSTP' AS table_name, 'PCIDAV' AS field_name, 'HIB Doubtful Advice print flag' AS description, 'Length check (String &lt;=1)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(PCIDAV) &gt; 1 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_EBCUSTP
    UNION ALL
    SELECT 'HUB_MT_EBCUSTP' AS table_name, 'PCILAL' AS field_name, 'HUB Internet Banking Linked Account Transfer' AS description, 'Range check (Integer &lt;=15d)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ABS(PCILAL) &gt; 999999999999999 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_EBCUSTP
    UNION ALL
    SELECT 'HUB_MT_EBCUSTP' AS table_name, 'PCILAD' AS field_name, 'HIB Date last linked A/C transfer' AS description, 'Date check - format (YYYYMMDD) + future date' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN (PCILAD NOT IN ('0', '99999999') AND VALIDATE_CONVERSION(PCILAD AS DATE,'YYYYMMDD') = 0) OR (PCILAD NOT IN ('0', '99999999') AND TO_DATE(PCILAD,'YYYYMMDD') &gt; (SELECT cut_off FROM migration_date)) THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_EBCUSTP
