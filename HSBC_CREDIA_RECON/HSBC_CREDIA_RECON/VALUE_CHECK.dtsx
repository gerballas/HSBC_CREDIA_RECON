      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{6821A5EC-D23A-4EAE-A8D7-C1BFCD7DE798}"
          SQLTask:SqlStatementSource="SET ANSI_NULLS ON;&#xA;GO&#xA;&#xA;SET QUOTED_IDENTIFIER ON;&#xA;GO&#xA;&#xA;IF NOT EXISTS (&#xA;    SELECT 1&#xA;    FROM sys.tables&#xA;    WHERE name = 'HUB_TO_DD_VALIDATION'&#xA;      AND schema_id = SCHEMA_ID('RECON')&#xA;)&#xA;BEGIN&#xA;    CREATE TABLE RECON.HUB_TO_DD_VALIDATION&#xA;    (&#xA;    CHECK_ID        NVARCHAR(30)    NOT NULL,&#xA;    TABLE_NAME      NVARCHAR(30)    NOT NULL,&#xA;    FIELD_NAME      NVARCHAR(30)    NOT NULL,&#xA;    DESCRIPTION     NVARCHAR(200)   NULL,&#xA;    CHECK_TYPE      NVARCHAR(100)   NOT NULL,&#xA;    TOTAL_RECORDS   INTEGER          NOT NULL,&#xA;    VALID_COUNT     INTEGER          NOT NULL,&#xA;    INVALID_COUNT   INTEGER          NOT NULL,&#xA;    DC_VERSION      NVARCHAR(5)    NOT NULL,&#xA;&#x9;RUN_VERSION     INTEGER         NOT NULL,&#xA;    RUN_TIMESTAMP   DATETIME2       NOT NULL,&#xA;&#xA;        CONSTRAINT PK_HUB_TO_DD_VALIDATION&#xA;            PRIMARY KEY CLUSTERED&#xA;            (&#xA;                CHECK_ID ASC,&#xA;&#x9;&#x9;&#x9;&#x9;DC_VERSION ASC,&#xA;&#x9;&#x9;&#x9;&#x9;RUN_VERSION ASC&#xA;&#x9;&#x9;&#x9;&#x9;&#xA;            )&#xA;            WITH&#xA;            (&#xA;                PAD_INDEX = OFF,&#xA;                STATISTICS_NORECOMPUTE = OFF,&#xA;                IGNORE_DUP_KEY = OFF,&#xA;                ALLOW_ROW_LOCKS = ON,&#xA;                ALLOW_PAGE_LOCKS = ON,&#xA;                OPTIMIZE_FOR_SEQUENTIAL_KEY = OFF&#xA;            ) ON [PRIMARY]&#xA;    ) ON [PRIMARY];&#xA;END;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
