                      dataType="System.String"
                      description="The name of the table to be fetched."
                      expressionType="Notify"
                      name="TableName"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      expressionType="Notify"
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">-- ====================================================================
-- Field Validation: ME13_VAL_DECEASED
-- Scope: ME13 Deceased Customer Files — Oracle table DECEASED
-- Schema: DATACUT35
-- Based on DD v2.8 + DC35 Oracle Metadata
-- Date formats per DD:
--   SDate:           DD/MM/YYYY | DD.MM.YYYY | MM/DD/YYYY
--   createdon:       DD/MM/YYYY HH:MM:SS
--   Datesettled:     DD/MM/YYYY | DD/MM/YYYY HH:MM
--   ChaserDate:      DD/MM/YYYY
--   ChaserReviewDate:DD/MM/YYYY (next review - no future check)
--   DODmm/dobmm:     Mmm (3-char month name e.g. Jan)
--   DODdd/Dobdd:     DD (numeric day)
--   DODyy/dobyy:     YYYY (4-digit year)
-- NULL values treated as acceptable
-- Only rows with invalid_count &gt; 0 are returned
-- ====================================================================
-- ** SET MIGRATION CUT-OFF DATE HERE (YYYYMMDD) **
WITH migration_date AS (
    SELECT 
        TO_DATE('20260615', 'YYYYMMDD') AS cut_off,
        TO_DATE('20260615', 'YYYYMMDD') AS cut_off_iso
    FROM DUAL
)
SELECT CAST('ME13_VAL_DECEASED_' || TO_CHAR(ROW_NUMBER() OVER (ORDER BY table_name, field_name, check_type), 'FM0000') AS VARCHAR2(50)) AS check_id,
    table_name, field_name, description, check_type,
    total_records, total_records - invalid_count AS valid_count, invalid_count,
    'DC3' AS DC_Version,
    SYSDATE AS Run_Timestamp
FROM (
    SELECT 'DECEASED' AS table_name, 'SNo' AS field_name, 'Deceased Customer File Ref Number' AS description, 'Length check (String &lt;=7)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(SNo) &gt; 7 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.DECEASED
    UNION ALL
    SELECT 'DECEASED' AS table_name, 'STATUS' AS field_name, 'Document Status' AS description, 'Length check (String &lt;=6)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(STATUS) &gt; 6 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.DECEASED
    UNION ALL
    SELECT 'DECEASED' AS table_name, 'PURGE_STATUS' AS field_name, 'Purging Status' AS description, 'Length check (String &lt;=50)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(PURGE_STATUS) &gt; 50 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.DECEASED
    UNION ALL
    SELECT 'DECEASED' AS table_name, 'Firstname' AS field_name, 'Deceased Customer First Name' AS description, 'Length check (String &lt;=100)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(Firstname) &gt; 100 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.DECEASED
    UNION ALL
    SELECT 'DECEASED' AS table_name, 'Surname' AS field_name, 'Deceased Customer Surname' AS description, 'Length check (String &lt;=100)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(Surname) &gt; 100 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.DECEASED
    UNION ALL
    SELECT 'DECEASED' AS table_name, 'maidsurname' AS field_name, 'Maiden surname' AS description, 'Length check (String &lt;=100)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(maidsurname) &gt; 100 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.DECEASED
    UNION ALL
    SELECT 'DECEASED' AS table_name, 'CustNo' AS field_name, 'HUB Customer No' AS description, 'Length check (String &lt;=11)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(CustNo) &gt; 11 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.DECEASED
    UNION ALL
    SELECT 'DECEASED' AS table_name, 'IdNo' AS field_name, 'ID Card/Passport No' AS description, 'Length check (String &lt;=50)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(IdNo) &gt; 50 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.DECEASED
    UNION ALL
    SELECT 'DECEASED' AS table_name, 'Dobdd' AS field_name, 'Date of Birth - Day' AS description, 'Length check (String &lt;=2)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(Dobdd) &gt; 2 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.DECEASED
    UNION ALL
    SELECT 'DECEASED' AS table_name, 'dobmm' AS field_name, 'Date of Birth - Month (Mmm)' AS description, 'Length check (String &lt;=3)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(dobmm) &gt; 3 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.DECEASED
    UNION ALL
    SELECT 'DECEASED' AS table_name, 'dobyy' AS field_name, 'Date of Birth - Year' AS description, 'Length check (String &lt;=4)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(dobyy) &gt; 4 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.DECEASED
    UNION ALL
    SELECT 'DECEASED' AS table_name, 'DODdd' AS field_name, 'Date of Death - Day' AS description, 'Length check (String &lt;=2)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(DODdd) &gt; 2 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.DECEASED
    UNION ALL
    SELECT 'DECEASED' AS table_name, 'DODmm' AS field_name, 'Date of Death - Month (Mmm)' AS description, 'Length check (String &lt;=3)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(DODmm) &gt; 3 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.DECEASED
    UNION ALL
    SELECT 'DECEASED' AS table_name, 'DODyy' AS field_name, 'Date of Death - Year' AS description, 'Length check (String &lt;=4)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(DODyy) &gt; 4 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.DECEASED
    UNION ALL
    SELECT 'DECEASED' AS table_name, 'Address' AS field_name, 'Address House Name/Number' AS description, 'Length check (String &lt;=200)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(Address) &gt; 200 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.DECEASED
    UNION ALL
    SELECT 'DECEASED' AS table_name, 'Address_1' AS field_name, 'Address Street Name' AS description, 'Length check (String &lt;=200)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(Address_1) &gt; 200 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.DECEASED
    UNION ALL
    SELECT 'DECEASED' AS table_name, 'Address_2' AS field_name, 'Address Town' AS description, 'Length check (String &lt;=200)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(Address_2) &gt; 200 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.DECEASED
    UNION ALL
    SELECT 'DECEASED' AS table_name, 'Testate' AS field_name, 'Testate flag' AS description, 'Length check (String &lt;=9)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(Testate) &gt; 9 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.DECEASED
    UNION ALL
    SELECT 'DECEASED' AS table_name, 'LAdvisor' AS field_name, 'Legal Advisor Name' AS description, 'Length check (String &lt;=200)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(LAdvisor) &gt; 200 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.DECEASED
    UNION ALL
    SELECT 'DECEASED' AS table_name, 'LATelNo' AS field_name, 'Legal Advisor Tel No' AS description, 'Length check (String &lt;=30)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(LATelNo) &gt; 30 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.DECEASED
    UNION ALL
    SELECT 'DECEASED' AS table_name, 'LAAddr' AS field_name, 'Legal Advisor Address' AS description, 'Length check (String &lt;=500)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(LAAddr) &gt; 500 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.DECEASED
    UNION ALL
    SELECT 'DECEASED' AS table_name, 'deathcert' AS field_name, 'Death Certificate availability' AS description, 'Length check (String &lt;=17)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(deathcert) &gt; 17 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.DECEASED
    UNION ALL
    SELECT 'DECEASED' AS table_name, 'HasChaser' AS field_name, 'Has Chaser flag' AS description, 'Length check (String &lt;=3)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(HasChaser) &gt; 3 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.DECEASED
    UNION ALL
    SELECT 'DECEASED' AS table_name, 'Settledby' AS field_name, 'Settled by' AS description, 'Length check (String &lt;=200)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(Settledby) &gt; 200 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.DECEASED
    UNION ALL
    SELECT 'DECEASED' AS table_name, 'Heirs' AS field_name, 'Number of Heirs' AS description, 'Range check (Integer &lt;=99)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ABS(HEIRS) &gt; 99 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.DECEASED
    UNION ALL
    SELECT 'DECEASED' AS table_name, 'NOPDEC' AS field_name, 'Number of Declarants' AS description, 'Range check (Integer &lt;=99)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ABS(NOPDEC) &gt; 99 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.DECEASED
    UNION ALL
    SELECT 'DECEASED' AS table_name, 'DODdd' AS field_name, 'Date of Death - Day (DD)' AS description, 'Date check - DOD day component (01-31)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN DODDD IS NOT NULL AND DODDD &lt;&gt; '' AND (NOT REGEXP_LIKE(DODDD,'^[0-9]{1,2}$') OR TO_NUMBER(REGEXP_SUBSTR(DODDD,'^[0-9]+$')) NOT BETWEEN 1 AND 31) THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.DECEASED
    UNION ALL
    SELECT 'DECEASED' AS table_name, 'DODmm' AS field_name, 'Date of Death - Month (Mmm)' AS description, 'Date check - DOD month format (Mmm e.g. Jan)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN DODMM IS NOT NULL AND DODMM &lt;&gt; '' AND NOT REGEXP_LIKE(DODMM,'^[A-Za-z]{3}$') THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.DECEASED
    UNION ALL
    SELECT 'DECEASED' AS table_name, 'DODyy' AS field_name, 'Date of Death - Year (YYYY)' AS description, 'Date check - DOD year (1900-2026)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN DODYY IS NOT NULL AND DODYY &lt;&gt; '' AND (NOT REGEXP_LIKE(DODYY,'^[0-9]{4}$') OR TO_NUMBER(DODYY) NOT BETWEEN 1900 AND 2026) THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.DECEASED
    UNION ALL
    SELECT 'DECEASED' AS table_name, 'DODyy' AS field_name, 'Date of Death - Year (future check)' AS description, 'Date check - DOD future date (assembled DD/Mon/YYYY)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN DODDD IS NOT NULL AND DODMM IS NOT NULL AND DODYY IS NOT NULL AND REGEXP_LIKE(DODDD,'^[0-9]{1,2}$') AND REGEXP_LIKE(DODMM,'^[A-Za-z]{3}$') AND REGEXP_LIKE(DODYY,'^[0-9]{4}$') AND VALIDATE_CONVERSION(LPAD(DODDD,2,'0')||'/'||DODMM||'/'||DODYY AS DATE,'DD/Mon/YYYY') = 1 AND TO_DATE(LPAD(DODDD,2,'0')||'/'||DODMM||'/'||DODYY,'DD/Mon/YYYY') &gt; (SELECT cut_off FROM migration_date) THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.DECEASED
    UNION ALL
    SELECT 'DECEASED' AS table_name, 'Dobdd' AS field_name, 'Date of Birth - Day (DD)' AS description, 'Date check - DOB day component (01-31)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN DOBDD IS NOT NULL AND DOBDD &lt;&gt; '' AND (NOT REGEXP_LIKE(DOBDD,'^[0-9]{1,2}$') OR TO_NUMBER(REGEXP_SUBSTR(DOBDD,'^[0-9]+$')) NOT BETWEEN 1 AND 31) THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.DECEASED
    UNION ALL
    SELECT 'DECEASED' AS table_name, 'dobmm' AS field_name, 'Date of Birth - Month (Mmm)' AS description, 'Date check - DOB month format (Mmm e.g. Jan)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN DOBMM IS NOT NULL AND DOBMM &lt;&gt; '' AND NOT REGEXP_LIKE(DOBMM,'^[A-Za-z]{3}$') THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.DECEASED
    UNION ALL
    SELECT 'DECEASED' AS table_name, 'dobyy' AS field_name, 'Date of Birth - Year (YYYY)' AS description, 'Date check - DOB year (1900-2026)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN DOBYY IS NOT NULL AND DOBYY &lt;&gt; '' AND (NOT REGEXP_LIKE(DOBYY,'^[0-9]{4}$') OR TO_NUMBER(DOBYY) NOT BETWEEN 1900 AND 2026) THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.DECEASED
    UNION ALL
    SELECT 'DECEASED' AS table_name, 'SDate' AS field_name, 'Date when Deceased Customer File was created' AS description, 'Date check - format (DD/MM/YYYY | DD.MM.YYYY | MM/DD/YYYY)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN SDATE IS NOT NULL AND SDATE &lt;&gt; '' AND NOT (REGEXP_LIKE(SDATE, '^[0-9]{2}/[0-9]{2}/[0-9]{4}$') OR REGEXP_LIKE(SDATE, '^[0-9]{2}\.[0-9]{2}\.[0-9]{4}$')) THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.DECEASED
    UNION ALL
    SELECT 'DECEASED' AS table_name, 'SDate' AS field_name, 'Date when Deceased Customer File was created' AS description, 'Date check - future date (DD/MM/YYYY format only)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN SDATE IS NOT NULL AND SDATE &lt;&gt; '' AND REGEXP_LIKE(SDATE,'^[0-9]{2}/[0-9]{2}/[0-9]{4}$') AND VALIDATE_CONVERSION(SDATE AS DATE,'DD/MM/YYYY') = 1 AND TO_DATE(SDATE,'DD/MM/YYYY') &gt; (SELECT cut_off FROM migration_date) THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.DECEASED
    UNION ALL
    SELECT 'DECEASED' AS table_name, 'createdon' AS field_name, 'Date when document was created' AS description, 'Date check - format (DD/MM/YYYY HH:MM:SS)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN CREATEDON IS NOT NULL AND CREATEDON &lt;&gt; '' AND NOT (REGEXP_LIKE(CREATEDON, '^[0-9]{2}/[0-9]{2}/[0-9]{4} [0-9]{2}:[0-9]{2}:[0-9]{2}$')) THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.DECEASED
    UNION ALL
    SELECT 'DECEASED' AS table_name, 'createdon' AS field_name, 'Date when document was created' AS description, 'Date check - future date (date part of DD/MM/YYYY HH:MM:SS)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN CREATEDON IS NOT NULL AND CREATEDON &lt;&gt; '' AND REGEXP_LIKE(CREATEDON,'^[0-9]{2}/[0-9]{2}/[0-9]{4}') AND VALIDATE_CONVERSION(SUBSTR(CREATEDON,1,10) AS DATE,'DD/MM/YYYY') = 1 AND TO_DATE(SUBSTR(CREATEDON,1,10),'DD/MM/YYYY') &gt; (SELECT cut_off FROM migration_date) THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.DECEASED
    UNION ALL
    SELECT 'DECEASED' AS table_name, 'Datesettled' AS field_name, 'Date when Deceased file was settled' AS description, 'Date check - format (DD/MM/YYYY or DD/MM/YYYY HH:MM)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN DATESETTLED IS NOT NULL AND DATESETTLED &lt;&gt; '' AND NOT (REGEXP_LIKE(DATESETTLED, '^[0-9]{2}/[0-9]{2}/[0-9]{4}$') OR REGEXP_LIKE(DATESETTLED, '^[0-9]{2}/[0-9]{2}/[0-9]{4} [0-9]{2}:[0-9]{2}$')) THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.DECEASED
    UNION ALL
    SELECT 'DECEASED' AS table_name, 'Datesettled' AS field_name, 'Date when Deceased file was settled' AS description, 'Date check - future date (date part of DD/MM/YYYY)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN DATESETTLED IS NOT NULL AND DATESETTLED &lt;&gt; '' AND REGEXP_LIKE(DATESETTLED,'^[0-9]{2}/[0-9]{2}/[0-9]{4}') AND VALIDATE_CONVERSION(SUBSTR(DATESETTLED,1,10) AS DATE,'DD/MM/YYYY') = 1 AND TO_DATE(SUBSTR(DATESETTLED,1,10),'DD/MM/YYYY') &gt; (SELECT cut_off FROM migration_date) THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.DECEASED
    UNION ALL
    SELECT 'DECEASED' AS table_name, 'ChaserDate' AS field_name, 'Last chaser date (DD/MM/YYYY)' AS description, 'Date check - format (DD/MM/YYYY)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN CHASERDATE IS NOT NULL AND CHASERDATE &lt;&gt; '' AND NOT REGEXP_LIKE(CHASERDATE,'^[0-9]{2}/[0-9]{2}/[0-9]{4}$') THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.DECEASED
    UNION ALL
    SELECT 'DECEASED' AS table_name, 'ChaserDate' AS field_name, 'Last chaser date (DD/MM/YYYY)' AS description, 'Date check - future date (DD/MM/YYYY)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN CHASERDATE IS NOT NULL AND CHASERDATE &lt;&gt; '' AND REGEXP_LIKE(CHASERDATE,'^[0-9]{2}/[0-9]{2}/[0-9]{4}$') AND VALIDATE_CONVERSION(CHASERDATE AS DATE,'DD/MM/YYYY') = 1 AND TO_DATE(CHASERDATE,'DD/MM/YYYY') &gt; (SELECT cut_off FROM migration_date) THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.DECEASED
    UNION ALL
    SELECT 'DECEASED' AS table_name, 'ChaserReviewDate' AS field_name, 'Date of next Chaser Review (DD/MM/YYYY)' AS description, 'Date check - format (DD/MM/YYYY)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN CHASERREVIEWDATE IS NOT NULL AND CHASERREVIEWDATE &lt;&gt; '' AND NOT REGEXP_LIKE(CHASERREVIEWDATE,'^[0-9]{2}/[0-9]{2}/[0-9]{4}$') THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.DECEASED
)
WHERE invalid_count &gt; 0
ORDER BY table_name, field_name, check_type;</property>
