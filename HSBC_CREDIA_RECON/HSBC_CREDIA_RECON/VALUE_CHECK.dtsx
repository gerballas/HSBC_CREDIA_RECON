    SELECT 'HUB_MT_SSHCDMP' AS table_name, 'ZEDLUP' AS field_name, 'DATE LAST UPDATED' AS description, 'Date check - format (YYYYMMDD) + future date' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN (ZEDLUP NOT IN ('0', '99999999') AND VALIDATE_CONVERSION(ZEDLUP AS DATE,'YYYYMMDD') = 0) OR (ZEDLUP NOT IN ('0', '99999999') AND TO_DATE(ZEDLUP,'YYYYMMDD') &gt; (SELECT cut_off FROM migration_date)) THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_SSHCDMP
    UNION ALL
    SELECT 'HUB_MT_SSHCDMP' AS table_name, 'ZETLUP' AS field_name, 'TIME LAST UPDATED' AS description, 'Range check (Integer &lt;=6d)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ABS(ZETLUP) &gt; 999999 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_SSHCDMP
    UNION ALL
    SELECT 'HUB_MT_SSBKLSP' AS table_name, 'V7MDFL' AS field_name, 'Mode Flag' AS description, 'Length check (String &lt;=1)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(V7MDFL) &gt; 1 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_SSBKLSP
    UNION ALL
    SELECT 'HUB_MT_SSBKLSP' AS table_name, 'V7RRN#' AS field_name, 'Relative Record Number' AS description, 'Range check (Integer &lt;=13d)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ABS("V7RRN#") &gt; 9999999999999 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_SSBKLSP
    UNION ALL
    SELECT 'HUB_MT_SSBKLSP' AS table_name, 'V7IDTY' AS field_name, 'Identity Document Type' AS description, 'Length check (String &lt;=1)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(V7IDTY) &gt; 1 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_SSBKLSP
    UNION ALL
    SELECT 'HUB_MT_SSBKLSP' AS table_name, 'V7IDNO' AS field_name, 'Identity Document Number' AS description, 'Length check (String &lt;=20)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(V7IDNO) &gt; 20 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_SSBKLSP
    UNION ALL
    SELECT 'HUB_MT_SSBKLSP' AS table_name, 'V7CSFN' AS field_name, 'Customer Full Name' AS description, 'Length check (String &lt;=70)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(V7CSFN) &gt; 70 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_SSBKLSP
    UNION ALL
    SELECT 'HUB_MT_SSBKLSP' AS table_name, 'V7C2FN' AS field_name, 'Customer Full Name in 2nd Language' AS description, 'Length check (String &lt;=70)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(V7C2FN) &gt; 70 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_SSBKLSP
    UNION ALL
    SELECT 'HUB_MT_SSBKLSP' AS table_name, 'V7CSSN' AS field_name, 'Customer Short Name' AS description, 'Length check (String &lt;=28)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(V7CSSN) &gt; 28 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_SSBKLSP
    UNION ALL
    SELECT 'HUB_MT_SSBKLSP' AS table_name, 'V7C2SN' AS field_name, '2nd Language Customer Short Name' AS description, 'Length check (String &lt;=28)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(V7C2SN) &gt; 28 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_SSBKLSP
    UNION ALL
    SELECT 'HUB_MT_SSBKLSP' AS table_name, 'V7DTAD' AS field_name, 'Date Request added' AS description, 'Date check - format (YYYYMMDD) + future date' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN (V7DTAD NOT IN ('0', '99999999') AND VALIDATE_CONVERSION(V7DTAD AS DATE,'YYYYMMDD') = 0) OR (V7DTAD NOT IN ('0', '99999999') AND TO_DATE(V7DTAD,'YYYYMMDD') &gt; (SELECT cut_off FROM migration_date)) THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_SSBKLSP
    UNION ALL
    SELECT 'HUB_MT_SSBKLSP' AS table_name, 'V7BLEX' AS field_name, 'Blacklist Expiry Date' AS description, 'Date check - format (YYYYMMDD)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN V7BLEX NOT IN ('0', '99999999') AND VALIDATE_CONVERSION(V7BLEX AS DATE,'YYYYMMDD') = 0 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_SSBKLSP
    UNION ALL
    SELECT 'HUB_MT_SSBKLSP' AS table_name, 'V7NAR1' AS field_name, 'Narrative 1' AS description, 'Length check (String &lt;=24)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(V7NAR1) &gt; 24 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_SSBKLSP
    UNION ALL
    SELECT 'HUB_MT_SSBKLSP' AS table_name, 'V7NAR2' AS field_name, 'Narrative 2' AS description, 'Length check (String &lt;=24)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(V7NAR2) &gt; 24 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_SSBKLSP
    UNION ALL
    SELECT 'HUB_MT_SSBKLSP' AS table_name, 'V7DLUP' AS field_name, 'Last Update Date' AS description, 'Date check - format (YYYYMMDD) + future date' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN (V7DLUP NOT IN ('0', '99999999') AND VALIDATE_CONVERSION(V7DLUP AS DATE,'YYYYMMDD') = 0) OR (V7DLUP NOT IN ('0', '99999999') AND TO_DATE(V7DLUP,'YYYYMMDD') &gt; (SELECT cut_off FROM migration_date)) THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_SSBKLSP
    UNION ALL
    SELECT 'HUB_MT_SSBKLSP' AS table_name, 'V7TLUP' AS field_name, 'Time Last Updated' AS description, 'Range check (Integer &lt;=6d)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ABS(V7TLUP) &gt; 999999 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_SSBKLSP
)
WHERE invalid_count &gt; 0
ORDER BY table_name, field_name, check_type;</property>
