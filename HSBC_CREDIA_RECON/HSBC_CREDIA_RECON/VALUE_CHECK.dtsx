                  version="1">
                  <properties>
                    <property
                      dataType="System.String"
                      description="The name of the table to be fetched."
                      expressionType="Notify"
                      name="TableName"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      expressionType="Notify"
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">-- ====================================================================
-- Field Validation: ME36_VAL_DEALS
-- Scope: ME36 TREATS Treasury — Deal tables
-- Schema: DATACUT35
-- Based on DD + DC35 Oracle Metadata
-- Date format: len=8/9 -&gt; YYYYMMDD | len=10 -&gt; YYYY-MM-DD
-- Sentinel values '0' and '99999999' treated as valid
-- NULL values treated as acceptable
-- Only rows with invalid_count &gt; 0 are returned
-- ====================================================================
WITH migration_date AS (
    SELECT 
        TO_DATE('20260615', 'YYYYMMDD') AS cut_off,
        TO_DATE('20260615', 'YYYYMMDD') AS cut_off_iso
    FROM DUAL
)
SELECT CAST('ME36_VAL_DEALS_' || TO_CHAR(ROW_NUMBER() OVER (ORDER BY table_name, field_name, check_type), 'FM0000') AS VARCHAR2(50)) AS check_id,
    table_name, field_name, description, check_type,
    total_records, total_records - invalid_count AS valid_count, invalid_count,
    'DC3' AS DC_Version,
    SYSDATE AS Run_Timestamp
FROM (
    SELECT 'TREATS_MPESPTP' AS table_name, 'TACTYC' AS field_name, 'CTY' AS description, 'Length check (String &lt;=2)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(TACTYC) &gt; 2 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.TREATS_MPESPTP
    UNION ALL
    SELECT 'TREATS_MPESPTP' AS table_name, 'TAGMAB' AS field_name, 'GP MBR' AS description, 'Length check (String &lt;=4)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(TAGMAB) &gt; 4 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.TREATS_MPESPTP
    UNION ALL
    SELECT 'TREATS_MPESPTP' AS table_name, 'TABRNO' AS field_name, 'BR NO' AS description, 'Range check (Integer &lt;=3d)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ABS(TABRNO) &gt; 999 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.TREATS_MPESPTP
    UNION ALL
    SELECT 'TREATS_MPESPTP' AS table_name, 'TADLNO' AS field_name, 'DEAL NUMBER' AS description, 'Length check (String &lt;=12)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(TADLNO) &gt; 12 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.TREATS_MPESPTP
    UNION ALL
