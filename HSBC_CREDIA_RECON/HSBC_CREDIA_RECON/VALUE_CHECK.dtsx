-- Field Validation: ME01_VAL_SS_CUST
-- Scope: ME01 HUB Core Banking — Customer &amp; Standing Data
-- Schema: DATACUT35
-- Based on DD v1.17 + DC35 Oracle Metadata
-- Date format: len=8/9 -&gt; YYYYMMDD | len=10 -&gt; YYYY-MM-DD
-- Sentinel values '0' and '99999999' treated as valid
-- NULL values treated as acceptable
-- Only rows with invalid_count &gt; 0 are returned
-- ====================================================================
-- ** SET MIGRATION CUT-OFF DATE HERE **
WITH migration_date AS (
    SELECT 
        TO_DATE('20260615', 'YYYYMMDD') AS cut_off,
        TO_DATE('20260615', 'YYYYMMDD') AS cut_off_iso
    FROM DUAL
)
SELECT CAST('ME01_VAL_SS_CUST_' || TO_CHAR(ROW_NUMBER() OVER (ORDER BY table_name, field_name, check_type), 'FM0000') AS VARCHAR2(50)) AS check_id,
    table_name, field_name, description, check_type,
    total_records, total_records - invalid_count AS valid_count, invalid_count,
    'DC3' AS DC_Version,
    SYSDATE AS Run_Timestamp
FROM (
    SELECT 'HUB_MT_SSCUSTP' AS table_name, 'ZGMDFL' AS field_name, 'Mode Flag' AS description, 'Length check (String &lt;=1)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(ZGMDFL) &gt; 1 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_SSCUSTP
    UNION ALL
    SELECT 'HUB_MT_SSCUSTP' AS table_name, 'ZGRRN#' AS field_name, 'Relative Record Number' AS description, 'Range check (Integer &lt;=13d)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ABS("ZGRRN#") &gt; 9999999999999 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_SSCUSTP
    UNION ALL
    SELECT 'HUB_MT_SSCUSTP' AS table_name, 'ZGCTCD' AS field_name, 'Country Code' AS description, 'Length check (String &lt;=2)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(ZGCTCD) &gt; 2 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_SSCUSTP
    UNION ALL
    SELECT 'HUB_MT_SSCUSTP' AS table_name, 'ZGDCG' AS field_name, 'Domestic Customer Group Member' AS description, 'Length check (String &lt;=4)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(ZGDCG) &gt; 4 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_SSCUSTP
    UNION ALL
    SELECT 'HUB_MT_SSCUSTP' AS table_name, 'ZGDCB' AS field_name, 'Customer Branch Number' AS description, 'Range check (Integer &lt;=3d)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ABS(ZGDCB) &gt; 999 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_SSCUSTP
    UNION ALL
    SELECT 'HUB_MT_SSCUSTP' AS table_name, 'ZGDCS' AS field_name, 'Customer Serial Number' AS description, 'Range check (Integer &lt;=6d)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ABS(ZGDCS) &gt; 999999 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_SSCUSTP
    UNION ALL
