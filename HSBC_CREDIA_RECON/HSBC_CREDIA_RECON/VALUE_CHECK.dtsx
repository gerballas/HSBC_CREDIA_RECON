                      description="The SQL command to be executed."
                      expressionType="Notify"
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">-- ====================================================================
-- Field Validation: ME01_VAL_SS_CDD
-- Scope: ME01 HUB Core Banking — CDD / AML / Tax
-- Schema: DATACUT35
-- Based on DD v1.17 + DC35 Oracle Metadata
-- Date format: len=9 -&gt; YYYYMMDD | len=10 -&gt; YYYY-MM-DD
--   unless long description explicitly states YYYYMMDD
-- Sentinel values '0' and '99999999' treated as valid
-- NULL values treated as acceptable
-- Only rows with invalid_count &gt; 0 are returned
-- ====================================================================
-- ** SET MIGRATION CUT-OFF DATE HERE **
WITH migration_date AS (
    SELECT 
        TO_DATE('20260615', 'YYYYMMDD') AS cut_off,
        TO_DATE('20260615', 'YYYYMMDD') AS cut_off_iso
    FROM DUAL
)
SELECT CAST('ME01_VAL_SS_CDD_' || TO_CHAR(ROW_NUMBER() OVER (ORDER BY table_name, field_name, check_type), 'FM0000') AS VARCHAR2(50)) AS check_id,
    table_name, field_name, description, check_type,
    total_records, total_records - invalid_count AS valid_count, invalid_count,
    'DC3' AS DC_Version,
    SYSDATE AS Run_Timestamp
FROM (
    SELECT 'HUB_MT_SSCDDMP' AS table_name, 'CMCTCD' AS field_name, 'COUNTRY CODE' AS description, 'Length check (String &lt;=2)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(CMCTCD) &gt; 2 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_SSCDDMP
    UNION ALL
    SELECT 'HUB_MT_SSCDDMP' AS table_name, 'CMDCG' AS field_name, 'DOMESTIC CUSTOMER GROUP MEMBER' AS description, 'Length check (String &lt;=4)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(CMDCG) &gt; 4 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_SSCDDMP
    UNION ALL
    SELECT 'HUB_MT_SSCDDMP' AS table_name, 'CMDCB' AS field_name, 'CUSTOMER BRANCH NUMBER' AS description, 'Range check (Integer &lt;=3d)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ABS(CMDCB) &gt; 999 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_SSCDDMP
    UNION ALL
    SELECT 'HUB_MT_SSCDDMP' AS table_name, 'CMDCS' AS field_name, 'CUSTOMER SERIAL NUMBER' AS description, 'Range check (Integer &lt;=6d)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ABS(CMDCS) &gt; 999999 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_SSCDDMP
    UNION ALL
    SELECT 'HUB_MT_SSCDDMP' AS table_name, 'CMRSKC' AS field_name, 'CDD RISK RATING' AS description, 'Length check (String &lt;=1)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(CMRSKC) &gt; 1 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_SSCDDMP
    UNION ALL
    SELECT 'HUB_MT_SSCDDMP' AS table_name, 'CMLRTC' AS field_name, 'LAST REVIEW TYPE' AS description, 'Length check (String &lt;=6)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(CMLRTC) &gt; 6 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_SSCDDMP
    UNION ALL
    SELECT 'HUB_MT_SSCDDMP' AS table_name, 'CMKYCS' AS field_name, 'KYC STANDARD' AS description, 'Length check (String &lt;=1)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(CMKYCS) &gt; 1 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_SSCDDMP
    UNION ALL
    SELECT 'HUB_MT_SSCDDMP' AS table_name, 'CMCLDR' AS field_name, 'LAST CDD REVIEW DATE' AS description, 'Date check - format (YYYYMMDD)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN CMCLDR NOT IN ('0', '99999999') AND VALIDATE_CONVERSION(CMCLDR AS DATE,'YYYYMMDD') = 0 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_SSCDDMP
    UNION ALL
    SELECT 'HUB_MT_SSCDDMP' AS table_name, 'CMCEYD' AS field_name, 'EXPECTED CDD EXPIRY DATE' AS description, 'Date check - format (YYYYMMDD)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN CMCEYD NOT IN ('0', '99999999') AND VALIDATE_CONVERSION(CMCEYD AS DATE,'YYYYMMDD') = 0 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_SSCDDMP
    UNION ALL
    SELECT 'HUB_MT_SSCDDMP' AS table_name, 'CMPUPC' AS field_name, 'NEW TO USD PAYMENT' AS description, 'Length check (String &lt;=1)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(CMPUPC) &gt; 1 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_SSCDDMP
    UNION ALL
    SELECT 'HUB_MT_SSCDDMP' AS table_name, 'CMNDUP' AS field_name, 'TEMP ALLOW DATE' AS description, 'Date check - format (YYYYMMDD)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN CMNDUP NOT IN ('0', '99999999') AND VALIDATE_CONVERSION(CMNDUP AS DATE,'YYYYMMDD') = 0 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_SSCDDMP
    UNION ALL
    SELECT 'HUB_MT_SSCDDMP' AS table_name, 'CMBKLI' AS field_name, 'BLACKLIST INDICATOR' AS description, 'Length check (String &lt;=1)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(CMBKLI) &gt; 1 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_SSCDDMP
    UNION ALL
    SELECT 'HUB_MT_SSCDDMP' AS table_name, 'CMREM1' AS field_name, 'REMARKS 1' AS description, 'Length check (String &lt;=50)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(CMREM1) &gt; 50 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_SSCDDMP
    UNION ALL
    SELECT 'HUB_MT_SSCDDMP' AS table_name, 'CMREM2' AS field_name, 'REMARKS 2' AS description, 'Length check (String &lt;=50)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(CMREM2) &gt; 50 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_SSCDDMP
    UNION ALL
    SELECT 'HUB_MT_SSCDDMP' AS table_name, 'CMREM3' AS field_name, 'REMARKS 3' AS description, 'Length check (String &lt;=50)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(CMREM3) &gt; 50 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_SSCDDMP
    UNION ALL
    SELECT 'HUB_MT_SSCDDMP' AS table_name, 'CMREM4' AS field_name, 'REMARKS 4' AS description, 'Length check (String &lt;=50)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(CMREM4) &gt; 50 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_SSCDDMP
    UNION ALL
    SELECT 'HUB_MT_SSCDDMP' AS table_name, 'CMREM5' AS field_name, 'REMARKS 5' AS description, 'Length check (String &lt;=50)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(CMREM5) &gt; 50 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_SSCDDMP
    UNION ALL
    SELECT 'HUB_MT_SSCDDMP' AS table_name, 'CMDLUP' AS field_name, 'LAST UPDATE DATE' AS description, 'Date check - format (YYYYMMDD) + future date' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN (CMDLUP NOT IN ('0', '99999999') AND VALIDATE_CONVERSION(CMDLUP AS DATE,'YYYYMMDD') = 0) OR (CMDLUP NOT IN ('0', '99999999') AND TO_DATE(CMDLUP,'YYYYMMDD') &gt; (SELECT cut_off FROM migration_date)) THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_SSCDDMP
    UNION ALL
    SELECT 'HUB_MT_SSCDDMP' AS table_name, 'CMTLUP' AS field_name, 'TIME LAST UPDATED' AS description, 'Range check (Integer &lt;=6d)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ABS(CMTLUP) &gt; 999999 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_SSCDDMP
    UNION ALL
    SELECT 'HUB_MT_SSCTXPP' AS table_name, 'CTCTCD' AS field_name, 'Country Code' AS description, 'Length check (String &lt;=2)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(CTCTCD) &gt; 2 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_SSCTXPP
    UNION ALL
    SELECT 'HUB_MT_SSCTXPP' AS table_name, 'CTDCG' AS field_name, 'Domestic Customer Group Member' AS description, 'Length check (String &lt;=4)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(CTDCG) &gt; 4 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_SSCTXPP
    UNION ALL
    SELECT 'HUB_MT_SSCTXPP' AS table_name, 'CTDCB' AS field_name, 'Customer Branch Number' AS description, 'Range check (Integer &lt;=3d)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ABS(CTDCB) &gt; 999 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_SSCTXPP
    UNION ALL
    SELECT 'HUB_MT_SSCTXPP' AS table_name, 'CTDCS' AS field_name, 'Customer Serial Number' AS description, 'Range check (Integer &lt;=6d)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ABS(CTDCS) &gt; 999999 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_SSCTXPP
    UNION ALL
    SELECT 'HUB_MT_SSCTXPP' AS table_name, 'CTTCCO' AS field_name, 'Customer Tax Classification Country' AS description, 'Length check (String &lt;=2)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(CTTCCO) &gt; 2 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_SSCTXPP
    UNION ALL
    SELECT 'HUB_MT_SSCTXPP' AS table_name, 'CTTXRG' AS field_name, 'Customer Tax Classification  Regime' AS description, 'Length check (String &lt;=10)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(CTTXRG) &gt; 10 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_SSCTXPP
    UNION ALL
