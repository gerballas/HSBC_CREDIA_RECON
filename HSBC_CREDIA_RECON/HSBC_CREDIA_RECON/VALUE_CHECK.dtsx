                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">-- ====================================================================
-- Field Validation: ME01_VAL_OR
-- Scope: ME01 HUB Core Banking — Cashier Orders
-- Schema: DATACUT35
-- Based on DD v1.17 + DC35 Oracle Metadata
-- Date format: len=8/9 -&gt; YYYYMMDD | len=10 -&gt; YYYY-MM-DD
-- Sentinel values '0' and '99999999' treated as valid
-- NULL values treated as acceptable
-- Only rows with invalid_count &gt; 0 are returned
-- ====================================================================
-- ** SET MIGRATION CUT-OFF DATE HERE **
WITH migration_date AS (
    SELECT TO_DATE('20260615', 'YYYYMMDD') AS cut_off FROM DUAL
)
SELECT CAST('ME01_VAL_OR_' || TO_CHAR(ROW_NUMBER() OVER (ORDER BY table_name, field_name, check_type), 'FM0000') AS VARCHAR2(50)) AS check_id,
    table_name, field_name, description, check_type,
    total_records, total_records - invalid_count AS valid_count, invalid_count,
    'DC3' AS DC_Version,
    SYSDATE AS Run_Timestamp
FROM (
    SELECT 'HUB_MT_ORCOMSP' AS table_name, 'ORMDFL' AS field_name, 'Mode Flag' AS description, 'Length check (String &lt;=1)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(ORMDFL) &gt; 1 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_ORCOMSP
    UNION ALL
    SELECT 'HUB_MT_ORCOMSP' AS table_name, 'ORRRN#' AS field_name, 'Relative Record Number' AS description, 'Range check (Integer &lt;=13d)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ABS("ORRRN#") &gt; 9999999999999 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_ORCOMSP
    UNION ALL
    SELECT 'HUB_MT_ORCOMSP' AS table_name, 'ORCTCD' AS field_name, 'Country Code' AS description, 'Length check (String &lt;=2)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(ORCTCD) &gt; 2 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_ORCOMSP
    UNION ALL
    SELECT 'HUB_MT_ORCOMSP' AS table_name, 'ORGMAB' AS field_name, 'Group Member Abbreviation' AS description, 'Length check (String &lt;=4)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(ORGMAB) &gt; 4 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_ORCOMSP
    UNION ALL
    SELECT 'HUB_MT_ORCOMSP' AS table_name, 'ORBRNO' AS field_name, 'Branch Number' AS description, 'Range check (Integer &lt;=3d)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ABS(ORBRNO) &gt; 999 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_ORCOMSP
    UNION ALL
    SELECT 'HUB_MT_ORCOMSP' AS table_name, 'ORTRNO' AS field_name, 'Transaction Reference No' AS description, 'Length check (String &lt;=16)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(ORTRNO) &gt; 16 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_ORCOMSP
    UNION ALL
    SELECT 'HUB_MT_ORCOMSP' AS table_name, 'ORCOCY' AS field_name, 'Cashier Order Currency' AS description, 'Length check (String &lt;=3)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(ORCOCY) &gt; 3 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_ORCOMSP
    UNION ALL
    SELECT 'HUB_MT_ORCOMSP' AS table_name, 'ORCOAM' AS field_name, 'Cashier Order Amount' AS description, 'Range check (Integer &lt;=13d)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ABS(ORCOAM) &gt; 9999999999999 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_ORCOMSP
    UNION ALL
    SELECT 'HUB_MT_ORCOMSP' AS table_name, 'ORBEA1' AS field_name, 'Beneficiary Name and Address Line 1' AS description, 'Length check (String &lt;=35)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(ORBEA1) &gt; 35 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_ORCOMSP
    UNION ALL
    SELECT 'HUB_MT_ORCOMSP' AS table_name, 'ORBEA2' AS field_name, 'Beneficiary Name and Address Line 2' AS description, 'Length check (String &lt;=35)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(ORBEA2) &gt; 35 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_ORCOMSP
    UNION ALL
    SELECT 'HUB_MT_ORCOMSP' AS table_name, 'ORBEA3' AS field_name, 'Beneficiary Name and Address Line 3' AS description, 'Length check (String &lt;=35)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(ORBEA3) &gt; 35 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_ORCOMSP
    UNION ALL
    SELECT 'HUB_MT_ORCOMSP' AS table_name, 'ORBEA4' AS field_name, 'Beneficiary name and address line 4' AS description, 'Length check (String &lt;=35)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(ORBEA4) &gt; 35 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_ORCOMSP
    UNION ALL
    SELECT 'HUB_MT_ORCOMSP' AS table_name, 'ORDSTS' AS field_name, 'Document Status' AS description, 'Length check (String &lt;=1)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(ORDSTS) &gt; 1 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_ORCOMSP
    UNION ALL
    SELECT 'HUB_MT_ORCOMSP' AS table_name, 'ORRVCD' AS field_name, 'Reversal Code' AS description, 'Length check (String &lt;=1)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(ORRVCD) &gt; 1 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_ORCOMSP
    UNION ALL
    SELECT 'HUB_MT_ORCOMSP' AS table_name, 'ORCPWS' AS field_name, 'Capture Terminal ID' AS description, 'Length check (String &lt;=4)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(ORCPWS) &gt; 4 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_ORCOMSP
    UNION ALL
    SELECT 'HUB_MT_ORCOMSP' AS table_name, 'ORDLNO' AS field_name, 'Deal Number' AS description, 'Range check (Integer &lt;=5d)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ABS(ORDLNO) &gt; 99999 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_ORCOMSP
    UNION ALL
    SELECT 'HUB_MT_ORCOMSP' AS table_name, 'ORCPDT' AS field_name, 'Capture Date' AS description, 'Date check - format (YYYYMMDD) + future date' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN (ORCPDT NOT IN ('0', '99999999') AND VALIDATE_CONVERSION(ORCPDT AS DATE,'YYYYMMDD') = 0) OR (ORCPDT NOT IN ('0', '99999999') AND TO_DATE(ORCPDT,'YYYYMMDD') &gt; (SELECT cut_off FROM migration_date)) THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_ORCOMSP
    UNION ALL
    SELECT 'HUB_MT_ORCOMSP' AS table_name, 'ORPCNM' AS field_name, 'Name of Purchaser' AS description, 'Length check (String &lt;=35)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(ORPCNM) &gt; 35 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_ORCOMSP
    UNION ALL
    SELECT 'HUB_MT_ORCOMSP' AS table_name, 'ORDLUP' AS field_name, 'Last Update Date' AS description, 'Date check - format (YYYYMMDD) + future date' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN (ORDLUP NOT IN ('0', '99999999') AND VALIDATE_CONVERSION(ORDLUP AS DATE,'YYYYMMDD') = 0) OR (ORDLUP NOT IN ('0', '99999999') AND TO_DATE(ORDLUP,'YYYYMMDD') &gt; (SELECT cut_off FROM migration_date)) THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_ORCOMSP
    UNION ALL
    SELECT 'HUB_MT_ORCOMSP' AS table_name, 'ORTLUP' AS field_name, 'Time Last Updated' AS description, 'Range check (Integer &lt;=6d)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ABS(ORTLUP) &gt; 999999 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_ORCOMSP
    UNION ALL
    SELECT 'HUB_MT_OR@CORP' AS table_name, 'RNCQTP' AS field_name, 'CO Cheque Type' AS description, 'Length check (String &lt;=3)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(RNCQTP) &gt; 3 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35."HUB_MT_OR@CORP"
    UNION ALL
    SELECT 'HUB_MT_OR@CORP' AS table_name, 'RNSERL' AS field_name, 'CO Serial Number' AS description, 'Length check (String &lt;=6)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(RNSERL) &gt; 6 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35."HUB_MT_OR@CORP"
    UNION ALL
    SELECT 'HUB_MT_OR@CORP' AS table_name, 'RNORCS' AS field_name, 'Orderning Customer' AS description, 'Length check (String &lt;=18)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(RNORCS) &gt; 18 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35."HUB_MT_OR@CORP"
    UNION ALL
    SELECT 'HUB_MT_OR@CORP' AS table_name, 'RNXCCY' AS field_name, 'Transaction Currency' AS description, 'Length check (String &lt;=3)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(RNXCCY) &gt; 3 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35."HUB_MT_OR@CORP"
    UNION ALL
    SELECT 'HUB_MT_OR@CORP' AS table_name, 'RNXTRA' AS field_name, 'CO Amount' AS description, 'Range check (Integer &lt;=13d)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ABS(RNXTRA) &gt; 9999999999999 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35."HUB_MT_OR@CORP"
    UNION ALL
    SELECT 'HUB_MT_OR@CORP' AS table_name, 'RNBEAN' AS field_name, 'Beneficiary Name' AS description, 'Length check (String &lt;=28)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(RNBEAN) &gt; 28 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35."HUB_MT_OR@CORP"
    UNION ALL
    SELECT 'HUB_MT_OR@CORP' AS table_name, 'RNCPDT' AS field_name, 'Date Issued' AS description, 'Date check - format (YYYYMMDD) + future date' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN (RNCPDT NOT IN ('0', '99999999') AND VALIDATE_CONVERSION(RNCPDT AS DATE,'YYYYMMDD') = 0) OR (RNCPDT NOT IN ('0', '99999999') AND TO_DATE(RNCPDT,'YYYYMMDD') &gt; (SELECT cut_off FROM migration_date)) THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35."HUB_MT_OR@CORP"
    UNION ALL
    SELECT 'HUB_MT_OR@CORP' AS table_name, 'RNCPWS' AS field_name, 'Issue Workstation No.' AS description, 'Length check (String &lt;=4)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(RNCPWS) &gt; 4 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35."HUB_MT_OR@CORP"
    UNION ALL
    SELECT 'HUB_MT_OR@CORP' AS table_name, 'RNDLNO' AS field_name, 'Issue Deal Number' AS description, 'Range check (Integer &lt;=5d)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ABS(RNDLNO) &gt; 99999 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35."HUB_MT_OR@CORP"
    UNION ALL
    SELECT 'HUB_MT_OR@CORP' AS table_name, 'RNNAR1' AS field_name, 'Issue Narrative' AS description, 'Length check (String &lt;=24)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(RNNAR1) &gt; 24 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35."HUB_MT_OR@CORP"
    UNION ALL
    SELECT 'HUB_MT_OR@CORP' AS table_name, 'RNECDA' AS field_name, 'Date Encashed' AS description, 'Date check - format (YYYYMMDD) + future date' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN (RNECDA NOT IN ('0', '99999999') AND VALIDATE_CONVERSION(RNECDA AS DATE,'YYYYMMDD') = 0) OR (RNECDA NOT IN ('0', '99999999') AND TO_DATE(RNECDA,'YYYYMMDD') &gt; (SELECT cut_off FROM migration_date)) THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35."HUB_MT_OR@CORP"
    UNION ALL
    SELECT 'HUB_MT_OR@CORP' AS table_name, 'RNECWS' AS field_name, 'Encash Workstation No.' AS description, 'Length check (String &lt;=4)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(RNECWS) &gt; 4 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35."HUB_MT_OR@CORP"
    UNION ALL
    SELECT 'HUB_MT_OR@CORP' AS table_name, 'RNECDL' AS field_name, 'Encash Deal Number' AS description, 'Range check (Integer &lt;=5d)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ABS(RNECDL) &gt; 99999 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35."HUB_MT_OR@CORP"
    UNION ALL
    SELECT 'HUB_MT_OR@CORP' AS table_name, 'RNNAR2' AS field_name, 'Encash Narrative' AS description, 'Length check (String &lt;=24)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(RNNAR2) &gt; 24 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35."HUB_MT_OR@CORP"
    UNION ALL
    SELECT 'HUB_MT_OR@CORP' AS table_name, 'RNSTUS' AS field_name, 'Status' AS description, 'Length check (String &lt;=1)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(RNSTUS) &gt; 1 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35."HUB_MT_OR@CORP"
    UNION ALL
    SELECT 'HUB_MT_OR@CORP' AS table_name, 'RNDBAC' AS field_name, 'Deal Balancing Account Number' AS description, 'Length check (String &lt;=18)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(RNDBAC) &gt; 18 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35."HUB_MT_OR@CORP"
)
WHERE invalid_count &gt; 0
ORDER BY table_name, field_name, check_type;</property>
