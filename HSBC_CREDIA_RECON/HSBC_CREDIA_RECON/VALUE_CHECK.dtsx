    UNION ALL
    SELECT 'HUB_MT_AFSIMSP' AS table_name, 'FNAFPY' AS field_name, 'Priority' AS description, 'Range check (Integer &lt;=2d)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ABS(FNAFPY) &gt; 99 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_AFSIMSP
    UNION ALL
    SELECT 'HUB_MT_AFSIMSP' AS table_name, 'FNCOMM' AS field_name, 'Commission Charge' AS description, 'Range check (Integer &lt;=11d)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ABS(FNCOMM) &gt; 99999999999 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_AFSIMSP
    UNION ALL
    SELECT 'HUB_MT_AFSIMSP' AS table_name, 'FNPOST' AS field_name, 'Postage' AS description, 'Range check (Integer &lt;=7d)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ABS(FNPOST) &gt; 9999999 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_AFSIMSP
    UNION ALL
    SELECT 'HUB_MT_AFSIMSP' AS table_name, 'FNSTDU' AS field_name, 'Stamp Duty' AS description, 'Range check (Integer &lt;=11d)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ABS(FNSTDU) &gt; 99999999999 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_AFSIMSP
    UNION ALL
    SELECT 'HUB_MT_AFSIMSP' AS table_name, 'FNCHTP' AS field_name, 'Charge Type' AS description, 'Length check (String &lt;=1)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(FNCHTP) &gt; 1 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_AFSIMSP
    UNION ALL
    SELECT 'HUB_MT_AFSIMSP' AS table_name, 'FNNMIA' AS field_name, 'No of Months for Inactivity' AS description, 'Range check (Integer &lt;=3d)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ABS(FNNMIA) &gt; 999 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_AFSIMSP
    UNION ALL
    SELECT 'HUB_MT_AFSIMSP' AS table_name, 'FNTMCR' AS field_name, 'Times for Continuous Rejection' AS description, 'Range check (Integer &lt;=3d)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ABS(FNTMCR) &gt; 999 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_AFSIMSP
    UNION ALL
    SELECT 'HUB_MT_AFSIMSP' AS table_name, 'FNSLDP' AS field_name, 'Salary/Deposit Triggered Indicator' AS description, 'Length check (String &lt;=1)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(FNSLDP) &gt; 1 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_AFSIMSP
    UNION ALL
    SELECT 'HUB_MT_AFSIMSP' AS table_name, 'FNFIAM' AS field_name, 'First Standing Instruction Amount' AS description, 'Range check (Integer &lt;=13d)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ABS(FNFIAM) &gt; 9999999999999 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_AFSIMSP
    UNION ALL
    SELECT 'HUB_MT_AFSIMSP' AS table_name, 'FNSIAM' AS field_name, 'Standing Instruction Amount' AS description, 'Range check (Integer &lt;=13d)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ABS(FNSIAM) &gt; 9999999999999 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_AFSIMSP
    UNION ALL
    SELECT 'HUB_MT_AFSIMSP' AS table_name, 'FNLIAM' AS field_name, 'Last Standing Instruction Amount' AS description, 'Range check (Integer &lt;=13d)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ABS(FNLIAM) &gt; 9999999999999 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_AFSIMSP
    UNION ALL
