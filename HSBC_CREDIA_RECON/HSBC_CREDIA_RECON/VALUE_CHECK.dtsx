                  name="ME04_VAL_ATAPTYP"
                  usesDispositions="true"
                  version="1">
                  <properties>
                    <property
                      dataType="System.String"
                      description="The name of the table to be fetched."
                      expressionType="Notify"
                      name="TableName"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      expressionType="Notify"
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">-- ====================================================================
-- Field Validation: ME04_VAL_ATAPTYP
-- Scope: ME04 ATM — ATM Product Type Control (ATAPTYP only)
-- Schema: DATACUT35
-- Based on DD + DC35 Oracle Metadata
-- Date format: len=8/9 -&gt; YYYYMMDD | len=10 -&gt; YYYY-MM-DD
-- Sentinel values '0' and '99999999' treated as valid
-- NULL values treated as acceptable
-- Only rows with invalid_count &gt; 0 are returned
-- ====================================================================
-- ** SET MIGRATION CUT-OFF DATE HERE **
WITH migration_date AS (
    SELECT 
        TO_DATE('20260615', 'YYYYMMDD') AS cut_off,
        TO_DATE('20260615', 'YYYYMMDD') AS cut_off_iso
    FROM DUAL
)
SELECT CAST('ME04_VAL_ATAPTYP_' || TO_CHAR(ROW_NUMBER() OVER (ORDER BY table_name, field_name, check_type), 'FM0000') AS VARCHAR2(50)) AS check_id,
    table_name, field_name, description, check_type,
    total_records, total_records - invalid_count AS valid_count, invalid_count,
    'DC3' AS DC_Version,
    SYSDATE AS Run_Timestamp
FROM (
    SELECT 'ATM_MT_ATAPTYP' AS table_name, 'BUCTCD' AS field_name, 'Country Code' AS description, 'Length check (String &lt;=2)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(BUCTCD) &gt; 2 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.ATM_MT_ATAPTYP
    UNION ALL
    SELECT 'ATM_MT_ATAPTYP' AS table_name, 'BUGMAB' AS field_name, 'Group Member' AS description, 'Length check (String &lt;=4)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(BUGMAB) &gt; 4 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.ATM_MT_ATAPTYP
    UNION ALL
    SELECT 'ATM_MT_ATAPTYP' AS table_name, 'BUAPTY' AS field_name, 'Account/Product Type' AS description, 'Length check (String &lt;=3)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(BUAPTY) &gt; 3 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.ATM_MT_ATAPTYP
    UNION ALL
    SELECT 'ATM_MT_ATAPTYP' AS table_name, 'BUCYCD' AS field_name, 'Account Currency' AS description, 'Length check (String &lt;=3)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(BUCYCD) &gt; 3 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.ATM_MT_ATAPTYP
    UNION ALL
    SELECT 'ATM_MT_ATAPTYP' AS table_name, 'BUDS50' AS field_name, 'Description of 50 Characters Long' AS description, 'Length check (String &lt;=50)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(BUDS50) &gt; 50 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.ATM_MT_ATAPTYP
    UNION ALL
    SELECT 'ATM_MT_ATAPTYP' AS table_name, 'BUABLL' AS field_name, 'Account Balance Lower Limit' AS description, 'Range check (Integer &lt;=16d)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ABS(BUABLL) &gt; 9999999999999999 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.ATM_MT_ATAPTYP
    UNION ALL
    SELECT 'ATM_MT_ATAPTYP' AS table_name, 'BUPDTY' AS field_name, 'ATMP product type of the card' AS description, 'Length check (String &lt;=4)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(BUPDTY) &gt; 4 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.ATM_MT_ATAPTYP
    UNION ALL
    SELECT 'ATM_MT_ATAPTYP' AS table_name, 'BUDLUP' AS field_name, 'Date Last Update in format YYYYMMDD' AS description, 'Date check - format (YYYYMMDD) + future date' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN (BUDLUP NOT IN ('0', '99999999') AND VALIDATE_CONVERSION(BUDLUP AS DATE,'YYYYMMDD') = 0) OR (BUDLUP NOT IN ('0', '99999999') AND TO_DATE(BUDLUP,'YYYYMMDD') &gt; (SELECT cut_off FROM migration_date)) THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.ATM_MT_ATAPTYP
    UNION ALL
    SELECT 'ATM_MT_ATAPTYP' AS table_name, 'BUTLUP' AS field_name, 'Time Last Updated' AS description, 'Range check (Integer &lt;=6d)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ABS(BUTLUP) &gt; 999999 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.ATM_MT_ATAPTYP
)
WHERE invalid_count &gt; 0
ORDER BY table_name, field_name, check_type;</property>
