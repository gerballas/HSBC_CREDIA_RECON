    SELECT 'HUB_MT_EWSTDPP' AS table_name, 'YHGMAB' AS field_name, 'Group Member Abbreviation' AS description, 'Length check (String &lt;=4)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(YHGMAB) &gt; 4 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_EWSTDPP
    UNION ALL
    SELECT 'HUB_MT_EWSTDPP' AS table_name, 'YHCODE' AS field_name, 'Schedule Reference Code' AS description, 'Length check (String &lt;=10)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(YHCODE) &gt; 10 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_EWSTDPP
    UNION ALL
    SELECT 'HUB_MT_EWSTDPP' AS table_name, 'YHDS50' AS field_name, 'Description of 50 Characters Long' AS description, 'Length check (String &lt;=50)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(YHDS50) &gt; 50 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_EWSTDPP
    UNION ALL
    SELECT 'HUB_MT_EWSTDPP' AS table_name, 'YHSS50' AS field_name, '2nd Language Description of 50 Characters Long' AS description, 'Length check (String &lt;=50)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(YHSS50) &gt; 50 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_EWSTDPP
    UNION ALL
    SELECT 'HUB_MT_EWSTDPP' AS table_name, 'YHDLUP' AS field_name, 'Last Update Date' AS description, 'Date check - format (YYYYMMDD) + future date' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN (YHDLUP NOT IN ('0', '99999999') AND VALIDATE_CONVERSION(YHDLUP AS DATE,'YYYYMMDD') = 0) OR (YHDLUP NOT IN ('0', '99999999') AND TO_DATE(YHDLUP,'YYYYMMDD') &gt; (SELECT cut_off FROM migration_date)) THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_EWSTDPP
    UNION ALL
    SELECT 'HUB_MT_EWSTDPP' AS table_name, 'YHTLUP' AS field_name, 'Time Last Updated' AS description, 'Range check (Integer &lt;=6d)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ABS(YHTLUP) &gt; 999999 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_EWSTDPP
)
WHERE invalid_count &gt; 0
ORDER BY table_name, field_name, check_type;</property>
