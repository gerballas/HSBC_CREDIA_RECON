    SELECT 'TREATS_MPRKSFP' AS table_name, 'RMVALU' AS field_name, 'Reg Key Value' AS description, 'Length check (String &lt;=32)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(RMVALU) &gt; 32 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.TREATS_MPRKSFP
)
WHERE invalid_count &gt; 0
ORDER BY table_name, field_name, check_type;</property>
