    UNION ALL
    SELECT 'HUB_MT_SSCLMTP' AS table_name, 'ZFCOSF' AS field_name, 'Customer Outstanding' AS description, 'Range check (Integer &lt;=13d)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ABS(ZFCOSF) &gt; 9999999999999 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_SSCLMTP
    UNION ALL
