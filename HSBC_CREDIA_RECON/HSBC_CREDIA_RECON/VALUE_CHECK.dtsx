                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">-- ====================================================================
-- Field Validation: ME36_VAL_LIMITS_SEC
-- Scope: ME36 TREATS Treasury — Credit Limits, Securities, Settlement, Counterparty
-- Schema: DATACUT35
-- Based on DD + DC35 Oracle Metadata
-- Date format: len=8/9 -&gt; YYYYMMDD | len=10 -&gt; YYYY-MM-DD
-- Sentinel values '0' and '99999999' treated as valid
-- NULL values treated as acceptable
-- Only rows with invalid_count &gt; 0 are returned
-- ====================================================================
WITH migration_date AS (
    SELECT 
        TO_DATE('20260615', 'YYYYMMDD') AS cut_off,
        TO_DATE('20260615', 'YYYYMMDD') AS cut_off_iso
    FROM DUAL
)
SELECT CAST('ME36_VAL_LIMITS_SEC_' || TO_CHAR(ROW_NUMBER() OVER (ORDER BY table_name, field_name, check_type), 'FM0000') AS VARCHAR2(50)) AS check_id,
    table_name, field_name, description, check_type,
    total_records, total_records - invalid_count AS valid_count, invalid_count,
    'DC3' AS DC_Version,
    SYSDATE AS Run_Timestamp
FROM (
    SELECT 'TREATS_CKOVLMP' AS table_name, 'CICTYC' AS field_name, 'Country Code' AS description, 'Length check (String &lt;=2)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(CICTYC) &gt; 2 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.TREATS_CKOVLMP
    UNION ALL
    SELECT 'TREATS_CKOVLMP' AS table_name, 'CIGMAB' AS field_name, 'Group Member Abbreviation' AS description, 'Length check (String &lt;=4)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(CIGMAB) &gt; 4 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.TREATS_CKOVLMP
    UNION ALL
    SELECT 'TREATS_CKOVLMP' AS table_name, 'CIBRNO' AS field_name, 'Branch Number' AS description, 'Range check (Integer &lt;=3d)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ABS(CIBRNO) &gt; 999 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.TREATS_CKOVLMP
    UNION ALL
    SELECT 'TREATS_CKOVLMP' AS table_name, 'CICPTY' AS field_name, 'Counterparty Acronym/Country Code' AS description, 'Length check (String &lt;=7)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(CICPTY) &gt; 7 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.TREATS_CKOVLMP
    UNION ALL
    SELECT 'TREATS_CKOVLMP' AS table_name, 'CICWGP' AS field_name, 'Cash Weighting Group' AS description, 'Length check (String &lt;=3)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(CICWGP) &gt; 3 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.TREATS_CKOVLMP
    UNION ALL
    SELECT 'TREATS_CKOVLMP' AS table_name, 'CINLMT' AS field_name, 'No Limit indicator' AS description, 'Length check (String &lt;=1)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(CINLMT) &gt; 1 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.TREATS_CKOVLMP
    UNION ALL
    SELECT 'TREATS_CKOVLMP' AS table_name, 'CIBLKG' AS field_name, 'Blocking Indicator' AS description, 'Length check (String &lt;=1)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(CIBLKG) &gt; 1 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.TREATS_CKOVLMP
    UNION ALL
    SELECT 'TREATS_CKOVLMP' AS table_name, 'CILCAT' AS field_name, 'Limit Category' AS description, 'Length check (String &lt;=1)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(CILCAT) &gt; 1 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.TREATS_CKOVLMP
    UNION ALL
    SELECT 'TREATS_CKOVLMP' AS table_name, 'CILCCY' AS field_name, 'Limit Currency' AS description, 'Length check (String &lt;=3)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(CILCCY) &gt; 3 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.TREATS_CKOVLMP
    UNION ALL
    SELECT 'TREATS_CKOVLMP' AS table_name, 'CISLCY' AS field_name, 'Settlement Limit Currency' AS description, 'Length check (String &lt;=3)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(CISLCY) &gt; 3 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.TREATS_CKOVLMP
    UNION ALL
    SELECT 'TREATS_CKOVLMP' AS table_name, 'CIMITT' AS field_name, 'Minimum Total Limit' AS description, 'Range check (Integer &lt;=9d)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ABS(CIMITT) &gt; 999999999 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.TREATS_CKOVLMP
    UNION ALL
    SELECT 'TREATS_CKOVLMP' AS table_name, 'CIMATT' AS field_name, 'Maximum Total Limit' AS description, 'Range check (Integer &lt;=9d)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ABS(CIMATT) &gt; 999999999 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.TREATS_CKOVLMP
    UNION ALL
    SELECT 'TREATS_CKOVLMP' AS table_name, 'CIRSTT' AS field_name, 'Reserved Total Limit' AS description, 'Range check (Integer &lt;=9d)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ABS(CIRSTT) &gt; 999999999 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.TREATS_CKOVLMP
    UNION ALL
    SELECT 'TREATS_CKOVLMP' AS table_name, 'CIDSLM' AS field_name, 'Daily Settlement Limit' AS description, 'Range check (Integer &lt;=9d)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ABS(CIDSLM) &gt; 999999999 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.TREATS_CKOVLMP
    UNION ALL
    SELECT 'TREATS_CKOVLMP' AS table_name, 'CIDSOS' AS field_name, 'Maximum Daily Settlement Outstanding' AS description, 'Range check (Integer &lt;=9d)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ABS(CIDSOS) &gt; 999999999 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.TREATS_CKOVLMP
    UNION ALL
    SELECT 'TREATS_CKOVLMP' AS table_name, 'CIDAOS' AS field_name, 'Date of Maximum Daily Settlement o/s' AS description, 'Range check (Integer &lt;=8d)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ABS(CIDAOS) &gt; 99999999 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.TREATS_CKOVLMP
    UNION ALL
    SELECT 'TREATS_CKOVLMP' AS table_name, 'CIMI01' AS field_name, 'Minimum Limit - Period 1' AS description, 'Range check (Integer &lt;=9d)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ABS(CIMI01) &gt; 999999999 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.TREATS_CKOVLMP
