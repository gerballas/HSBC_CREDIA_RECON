                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">-- ====================================================================
-- Field Validation: ME01_VAL_BA
-- Scope: ME01 HUB Core Banking — SWIFT / Banking Messages
-- Schema: DATACUT35
-- Based on DD v1.17 + DC35 Oracle Metadata
-- Date format: len=8/9 -&gt; YYYYMMDD | len=10 -&gt; YYYY-MM-DD
-- Sentinel values '0' and '99999999' treated as valid
-- NULL values treated as acceptable
-- Only rows with invalid_count &gt; 0 are returned
-- ====================================================================
-- ** SET MIGRATION CUT-OFF DATE HERE **
WITH migration_date AS (
    SELECT
        TO_DATE('20260615', 'YYYYMMDD')    AS cut_off,
        TO_DATE('2026-06-15', 'YYYY-MM-DD')      AS cut_off_iso
    FROM DUAL
)
SELECT table_name, field_name, description, check_type,
    total_records, total_records - invalid_count AS valid_count, invalid_count, dc_version, run_timestmp
FROM (
    SELECT 'HUB_MT_BAIMGCP' AS table_name, 'BHMDFL' AS field_name, 'Mode Flag' AS description, 'Length check (String &lt;=1)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(BHMDFL) &gt; 1 THEN 1 ELSE 0 END) AS invalid_count, 'DC3' AS dc_version,CAST(SYSTIMESTAMP AS TIMESTAMP) AS run_timestmp FROM DATACUT35.HUB_MT_BAIMGCP
    UNION ALL
    SELECT 'HUB_MT_BAIMGCP' AS table_name, 'BHRRN#' AS field_name, 'Relative Record Number' AS description, 'Range check (Integer &lt;=13d)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ABS("BHRRN#") &gt; 9999999999999 THEN 1 ELSE 0 END) AS invalid_count, 'DC3' AS dc_version,CAST(SYSTIMESTAMP AS TIMESTAMP) AS run_timestmp FROM DATACUT35.HUB_MT_BAIMGCP
    UNION ALL
    SELECT 'HUB_MT_BAIMGCP' AS table_name, 'BHMGID' AS field_name, 'Message ID' AS description, 'Length check (String &lt;=16)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(BHMGID) &gt; 16 THEN 1 ELSE 0 END) AS invalid_count, 'DC3' AS dc_version,CAST(SYSTIMESTAMP AS TIMESTAMP) AS run_timestmp FROM DATACUT35.HUB_MT_BAIMGCP
    UNION ALL
    SELECT 'HUB_MT_BAIMGCP' AS table_name, 'BHTRNO' AS field_name, 'Transaction Reference No' AS description, 'Length check (String &lt;=16)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(BHTRNO) &gt; 16 THEN 1 ELSE 0 END) AS invalid_count, 'DC3' AS dc_version,CAST(SYSTIMESTAMP AS TIMESTAMP) AS run_timestmp FROM DATACUT35.HUB_MT_BAIMGCP
    UNION ALL
