                  version="1">
                  <properties>
                    <property
                      dataType="System.String"
                      description="The name of the table to be fetched."
                      expressionType="Notify"
                      name="TableName"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      expressionType="Notify"
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">-- ====================================================================
-- Field Validation: ME20_VAL_EXP_DC
-- Scope: ME20 HIE Import/Export — Export Documentary Credits
-- Schema: DATACUT35
-- Based on DD + DC35 Oracle Metadata
-- Date format: len=8/9 -&gt; YYYYMMDD | len=10 -&gt; YYYY-MM-DD
-- Sentinel values '0' and '99999999' treated as valid
-- NULL values treated as acceptable
-- Only rows with invalid_count &gt; 0 are returned
-- ====================================================================
-- ** SET MIGRATION CUT-OFF DATE HERE **
WITH migration_date AS (
    SELECT 
        TO_DATE('20260615', 'YYYYMMDD') AS cut_off,
        TO_DATE('20260615', 'YYYYMMDD') AS cut_off_iso
    FROM DUAL
)
SELECT CAST('ME20_VAL_EXP_DC_' || TO_CHAR(ROW_NUMBER() OVER (ORDER BY table_name, field_name, check_type), 'FM0000') AS VARCHAR2(50)) AS check_id,
    table_name, field_name, description, check_type,
    total_records, total_records - invalid_count AS valid_count, invalid_count,
    'DC3' AS DC_Version,
    SYSDATE AS Run_Timestamp
FROM (
    SELECT 'HIE_EPDCMSP' AS table_name, 'BCMDFL' AS field_name, 'Mode Flag' AS description, 'Length check (String &lt;=1)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(BCMDFL) &gt; 1 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HIE_EPDCMSP
    UNION ALL
    SELECT 'HIE_EPDCMSP' AS table_name, 'BCRRN#' AS field_name, 'Relative Record Number' AS description, 'Range check (Integer &lt;=13d)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ABS("BCRRN#") &gt; 9999999999999 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HIE_EPDCMSP
    UNION ALL
    SELECT 'HIE_EPDCMSP' AS table_name, 'BCCTCD' AS field_name, 'Country Code' AS description, 'Length check (String &lt;=2)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(BCCTCD) &gt; 2 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HIE_EPDCMSP
    UNION ALL
    SELECT 'HIE_EPDCMSP' AS table_name, 'BCGMAB' AS field_name, 'Group Member Abbreviation' AS description, 'Length check (String &lt;=4)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(BCGMAB) &gt; 4 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HIE_EPDCMSP
    UNION ALL
    SELECT 'HIE_EPDCMSP' AS table_name, 'BCDCNR' AS field_name, 'Exports DC Number' AS description, 'Length check (String &lt;=16)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(BCDCNR) &gt; 16 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HIE_EPDCMSP
    UNION ALL
    SELECT 'HIE_EPDCMSP' AS table_name, 'BCDCSR' AS field_name, 'Exports DC Serial Number' AS description, 'Range check (Integer &lt;=2d)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ABS(BCDCSR) &gt; 99 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HIE_EPDCMSP
    UNION ALL
    SELECT 'HIE_EPDCMSP' AS table_name, 'BCCMSN' AS field_name, 'Cable Message Number for Documentary Credit' AS description, 'Length check (String &lt;=6)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(BCCMSN) &gt; 6 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HIE_EPDCMSP
    UNION ALL
    SELECT 'HIE_EPDCMSP' AS table_name, 'BCDVNO' AS field_name, 'DC Version Number' AS description, 'Range check (Decimal &lt;=5d)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ABS(BCDVNO) &gt; 99999 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HIE_EPDCMSP
    UNION ALL
    SELECT 'HIE_EPDCMSP' AS table_name, 'BCACB' AS field_name, 'Account Number' AS description, 'Range check (Integer &lt;=3d)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ABS(BCACB) &gt; 999 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HIE_EPDCMSP
    UNION ALL
    SELECT 'HIE_EPDCMSP' AS table_name, 'BCACS' AS field_name, 'Account Number' AS description, 'Range check (Integer &lt;=6d)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ABS(BCACS) &gt; 999999 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HIE_EPDCMSP
    UNION ALL
    SELECT 'HIE_EPDCMSP' AS table_name, 'BCACX' AS field_name, 'Account Number ***' AS description, 'Range check (Integer &lt;=3d)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ABS(BCACX) &gt; 999 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HIE_EPDCMSP
    UNION ALL
    SELECT 'HIE_EPDCMSP' AS table_name, 'BCDCPT' AS field_name, 'DC product type' AS description, 'Length check (String &lt;=3)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(BCDCPT) &gt; 3 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HIE_EPDCMSP
    UNION ALL
    SELECT 'HIE_EPDCMSP' AS table_name, 'BCPRCY' AS field_name, 'Product Currency' AS description, 'Length check (String &lt;=3)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(BCPRCY) &gt; 3 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HIE_EPDCMSP
    UNION ALL
    SELECT 'HIE_EPDCMSP' AS table_name, 'BCDCAA' AS field_name, 'DC amount applied' AS description, 'Range check (Integer &lt;=13d)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ABS(BCDCAA) &gt; 9999999999999 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HIE_EPDCMSP
    UNION ALL
    SELECT 'HIE_EPDCMSP' AS table_name, 'BCDCAU' AS field_name, 'DC amount utilised' AS description, 'Range check (Integer &lt;=13d)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ABS(BCDCAU) &gt; 9999999999999 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HIE_EPDCMSP
    UNION ALL
    SELECT 'HIE_EPDCMSP' AS table_name, 'BCDCAR' AS field_name, 'DC amount transferred' AS description, 'Range check (Integer &lt;=13d)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ABS(BCDCAR) &gt; 9999999999999 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HIE_EPDCMSP
    UNION ALL
