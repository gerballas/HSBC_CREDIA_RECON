    UNION ALL
    SELECT 'HUB_MT_DDACMSP' AS table_name, 'DFCBST' AS field_name, 'Statutory A/C Status' AS description, 'Length check (String &lt;=1)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(DFCBST) &gt; 1 THEN 1 ELSE 0 END) AS invalid_count, 'DC3' AS dc_version,CAST(SYSTIMESTAMP AS TIMESTAMP) AS run_timestmp FROM DATACUT35.HUB_MT_DDACMSP
    UNION ALL
    SELECT 'HUB_MT_DDACMSP' AS table_name, 'DFDTAO' AS field_name, 'Date A/C Opened ***' AS description, 'Date check - format (YYYYMMDD) + future date' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN (DFDTAO NOT IN ('0', '99999999') AND VALIDATE_CONVERSION(DFDTAO AS DATE,'YYYYMMDD') = 0) OR (DFDTAO NOT IN ('0', '99999999') AND TO_DATE(DFDTAO,'YYYYMMDD') &gt; (SELECT cut_off FROM migration_date)) THEN 1 ELSE 0 END) AS invalid_count, 'DC3' AS dc_version,CAST(SYSTIMESTAMP AS TIMESTAMP) AS run_timestmp FROM DATACUT35.HUB_MT_DDACMSP
    UNION ALL
    SELECT 'HUB_MT_DDACMSP' AS table_name, 'DFCBCL' AS field_name, 'Central Bank A/C Classification' AS description, 'Length check (String &lt;=3)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(DFCBCL) &gt; 3 THEN 1 ELSE 0 END) AS invalid_count, 'DC3' AS dc_version,CAST(SYSTIMESTAMP AS TIMESTAMP) AS run_timestmp FROM DATACUT35.HUB_MT_DDACMSP
    UNION ALL
    SELECT 'HUB_MT_DDACMSP' AS table_name, 'DFMKS1' AS field_name, 'Market Sector 1' AS description, 'Range check (Integer &lt;=5d)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ABS(DFMKS1) &gt; 99999 THEN 1 ELSE 0 END) AS invalid_count, 'DC3' AS dc_version,CAST(SYSTIMESTAMP AS TIMESTAMP) AS run_timestmp FROM DATACUT35.HUB_MT_DDACMSP
