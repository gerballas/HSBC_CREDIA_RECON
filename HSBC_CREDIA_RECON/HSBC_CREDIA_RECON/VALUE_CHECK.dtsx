    UNION ALL
    SELECT 'HUB_MT_FN@DDCP' AS table_name, 'FDDESC' AS field_name, 'DESCRIPTION' AS description, 'Length check (String &lt;=150)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(FDDESC) &gt; 150 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35."HUB_MT_FN@DDCP"
    UNION ALL
    SELECT 'HUB_MT_FN@DDCP' AS table_name, 'FDBNC' AS field_name, 'BROAD NACE' AS description, 'Length check (String &lt;=1)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(FDBNC) &gt; 1 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35."HUB_MT_FN@DDCP"
    UNION ALL
    SELECT 'HUB_MT_FN@GSGP' AS table_name, 'FRDENT' AS field_name, 'BR_As_at_2025.07' AS description, 'Range check (Integer &lt;=7d)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ABS(FRDENT) &gt; 9999999 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35."HUB_MT_FN@GSGP"
    UNION ALL
    SELECT 'HUB_MT_FN@GSGP' AS table_name, 'FRIPID' AS field_name, 'Resident_Immediate_Parent' AS description, 'Range check (Integer &lt;=7d)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ABS(FRIPID) &gt; 9999999 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35."HUB_MT_FN@GSGP"
    UNION ALL
    SELECT 'HUB_MT_FN@GSGP' AS table_name, 'FRUPID' AS field_name, 'Resident_Ultimate_Parent' AS description, 'Range check (Integer &lt;=7d)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ABS(FRUPID) &gt; 9999999 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35."HUB_MT_FN@GSGP"
    UNION ALL
    SELECT 'HUB_MT_FN@GSGP' AS table_name, 'FRNRIP' AS field_name, 'Non_Resident_Immediate_Parent' AS description, 'Length check (String &lt;=70)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(FRNRIP) &gt; 70 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35."HUB_MT_FN@GSGP"
    UNION ALL
    SELECT 'HUB_MT_FN@GSGP' AS table_name, 'FRNRIC' AS field_name, 'Country' AS description, 'Length check (String &lt;=2)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(FRNRIC) &gt; 2 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35."HUB_MT_FN@GSGP"
