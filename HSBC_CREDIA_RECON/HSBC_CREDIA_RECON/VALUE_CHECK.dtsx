                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">-- ====================================================================
-- Field Validation: ME01_VAL_AF
-- Scope: ME01 HUB Core Banking — Standing Instructions
-- Schema: DATACUT35
-- Based on DD v1.17 + DC35 Oracle Metadata
-- Date format: len=8/9 -&gt; YYYYMMDD | len=10 -&gt; YYYY-MM-DD
-- Sentinel values '0' and '99999999' treated as valid
-- NULL values treated as acceptable
-- Only rows with invalid_count &gt; 0 are returned
-- ====================================================================
-- ** SET MIGRATION CUT-OFF DATE HERE **
WITH migration_date AS (
    SELECT TO_DATE('20260615', 'YYYYMMDD') AS cut_off FROM DUAL
)
SELECT CAST('ME01_VAL_AF_' || TO_CHAR(ROW_NUMBER() OVER (ORDER BY table_name, field_name, check_type), 'FM0000') AS VARCHAR2(50)) AS check_id,
    table_name, field_name, description, check_type,
    total_records, total_records - invalid_count AS valid_count, invalid_count,
    'DC3' AS DC_Version,
    SYSDATE AS Run_Timestamp
FROM (
    SELECT 'HUB_MT_AFSIMSP' AS table_name, 'FNMDFL' AS field_name, 'Mode Flag' AS description, 'Length check (String &lt;=1)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(FNMDFL) &gt; 1 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_AFSIMSP
    UNION ALL
    SELECT 'HUB_MT_AFSIMSP' AS table_name, 'FNRRN#' AS field_name, 'Relative Record Number' AS description, 'Range check (Integer &lt;=13d)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ABS("FNRRN#") &gt; 9999999999999 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_AFSIMSP
    UNION ALL
    SELECT 'HUB_MT_AFSIMSP' AS table_name, 'FNCTCD' AS field_name, 'Country Code' AS description, 'Length check (String &lt;=2)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(FNCTCD) &gt; 2 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_AFSIMSP
    UNION ALL
    SELECT 'HUB_MT_AFSIMSP' AS table_name, 'FNGMAB' AS field_name, 'Group Member Abbreviation' AS description, 'Length check (String &lt;=4)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(FNGMAB) &gt; 4 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_AFSIMSP
    UNION ALL
    SELECT 'HUB_MT_AFSIMSP' AS table_name, 'FNAPTY' AS field_name, 'Account/Product Type' AS description, 'Length check (String &lt;=3)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(FNAPTY) &gt; 3 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_AFSIMSP
    UNION ALL
    SELECT 'HUB_MT_AFSIMSP' AS table_name, 'FNPPAB' AS field_name, 'Primary Party A/C Branch No' AS description, 'Range check (Integer &lt;=3d)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ABS(FNPPAB) &gt; 999 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_AFSIMSP
    UNION ALL
    SELECT 'HUB_MT_AFSIMSP' AS table_name, 'FNPPAS' AS field_name, 'Primary Party A/C Full Serial No' AS description, 'Range check (Integer &lt;=6d)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ABS(FNPPAS) &gt; 999999 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_AFSIMSP
    UNION ALL
    SELECT 'HUB_MT_AFSIMSP' AS table_name, 'FNPPAX' AS field_name, 'Primary Party A/C Suffix' AS description, 'Range check (Integer &lt;=3d)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ABS(FNPPAX) &gt; 999 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_AFSIMSP
    UNION ALL
    SELECT 'HUB_MT_AFSIMSP' AS table_name, 'FNPCCB' AS field_name, 'Prime Branch' AS description, 'Range check (Integer &lt;=3d)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ABS(FNPCCB) &gt; 999 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_AFSIMSP
    UNION ALL
    SELECT 'HUB_MT_AFSIMSP' AS table_name, 'FNPPDP' AS field_name, 'Prim Party Department Code' AS description, 'Range check (Integer &lt;=3d)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ABS(FNPPDP) &gt; 999 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_AFSIMSP
    UNION ALL
    SELECT 'HUB_MT_AFSIMSP' AS table_name, 'FNPCCS' AS field_name, 'Prim Party Section Code' AS description, 'Range check (Integer &lt;=2d)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ABS(FNPCCS) &gt; 99 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_AFSIMSP
    UNION ALL
    SELECT 'HUB_MT_AFSIMSP' AS table_name, 'FNPPSC' AS field_name, 'Prim Party System Code' AS description, 'Length check (String &lt;=2)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(FNPPSC) &gt; 2 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_AFSIMSP
    UNION ALL
    SELECT 'HUB_MT_AFSIMSP' AS table_name, 'FNPRIE' AS field_name, 'Product/I/E type' AS description, 'Length check (String &lt;=3)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(FNPRIE) &gt; 3 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_AFSIMSP
    UNION ALL
    SELECT 'HUB_MT_AFSIMSP' AS table_name, 'FNCYCD' AS field_name, 'Currency' AS description, 'Length check (String &lt;=3)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(FNCYCD) &gt; 3 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_AFSIMSP
    UNION ALL
