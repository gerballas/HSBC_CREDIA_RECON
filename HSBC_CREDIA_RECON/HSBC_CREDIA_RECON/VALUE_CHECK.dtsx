    UNION ALL
    SELECT 'HUB_MT_PLACMSP' AS table_name, 'PFCMCC' AS field_name, 'Commission Charge Code' AS description, 'Length check (String &lt;=3)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(PFCMCC) &gt; 3 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_PLACMSP
    UNION ALL
    SELECT 'HUB_MT_PLACMSP' AS table_name, 'PFCCAC' AS field_name, 'Commission Calculated at A/C Open - LCY Minor' AS description, 'Range check (Integer &lt;=11d)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ABS(PFCCAC) &gt; 99999999999 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_PLACMSP
    UNION ALL
