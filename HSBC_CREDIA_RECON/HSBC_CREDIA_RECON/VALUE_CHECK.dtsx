    SELECT 'HIE_IPACMSP' AS table_name, 'IGACX' AS field_name, 'Account Suffix' AS description, 'Range check (Integer &lt;=3d)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ABS(IGACX) &gt; 999 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HIE_IPACMSP
