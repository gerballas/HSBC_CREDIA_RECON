                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">-- ====================================================================
-- Field Validation: ME01_VAL_EB
-- Scope: ME01 HUB Core Banking — E-Banking / Internet Banking
-- Schema: DATACUT35
-- Based on DD v1.17 + DC35 Oracle Metadata
-- Date format: len=8/9 -&gt; YYYYMMDD | len=10 -&gt; YYYY-MM-DD
-- Sentinel values '0' and '99999999' treated as valid
-- NULL values treated as acceptable
-- Only rows with invalid_count &gt; 0 are returned
-- ====================================================================
-- ** SET MIGRATION CUT-OFF DATE HERE **
WITH migration_date AS (
    SELECT
        TO_DATE('20260615', 'YYYYMMDD')    AS cut_off,
        TO_DATE('2026-06-15', 'YYYY-MM-DD')      AS cut_off_iso
    FROM DUAL
)
SELECT table_name, field_name, description, check_type,
    total_records, total_records - invalid_count AS valid_count, invalid_count, dc_version, run_timestmp
FROM (
    SELECT 'HUB_MT_EBCUSTP' AS table_name, 'PCMDFL' AS field_name, 'Mode Flag' AS description, 'Length check (String &lt;=1)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(PCMDFL) &gt; 1 THEN 1 ELSE 0 END) AS invalid_count, 'DC3' AS dc_version,CAST(SYSTIMESTAMP AS TIMESTAMP) AS run_timestmp FROM DATACUT35.HUB_MT_EBCUSTP
    UNION ALL
    SELECT 'HUB_MT_EBCUSTP' AS table_name, 'PCRRN#' AS field_name, 'Relative Record Number' AS description, 'Range check (Integer &lt;=13d)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ABS("PCRRN#") &gt; 9999999999999 THEN 1 ELSE 0 END) AS invalid_count, 'DC3' AS dc_version,CAST(SYSTIMESTAMP AS TIMESTAMP) AS run_timestmp FROM DATACUT35.HUB_MT_EBCUSTP
    UNION ALL
    SELECT 'HUB_MT_EBCUSTP' AS table_name, 'PCPBN' AS field_name, 'Phone Banking Number assigned to each customer' AS description, 'Range check (Integer &lt;=10d)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ABS(PCPBN) &gt; 9999999999 THEN 1 ELSE 0 END) AS invalid_count, 'DC3' AS dc_version,CAST(SYSTIMESTAMP AS TIMESTAMP) AS run_timestmp FROM DATACUT35.HUB_MT_EBCUSTP
    UNION ALL
    SELECT 'HUB_MT_EBCUSTP' AS table_name, 'PCIBID' AS field_name, 'Internet Banking ID' AS description, 'Length check (String &lt;=20)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(PCIBID) &gt; 20 THEN 1 ELSE 0 END) AS invalid_count, 'DC3' AS dc_version,CAST(SYSTIMESTAMP AS TIMESTAMP) AS run_timestmp FROM DATACUT35.HUB_MT_EBCUSTP
    UNION ALL
    SELECT 'HUB_MT_EBCUSTP' AS table_name, 'PCCSCL' AS field_name, 'Class of HPB Customers' AS description, 'Length check (String &lt;=1)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(PCCSCL) &gt; 1 THEN 1 ELSE 0 END) AS invalid_count, 'DC3' AS dc_version,CAST(SYSTIMESTAMP AS TIMESTAMP) AS run_timestmp FROM DATACUT35.HUB_MT_EBCUSTP
    UNION ALL
    SELECT 'HUB_MT_EBCUSTP' AS table_name, 'PCCTCD' AS field_name, 'Country Code' AS description, 'Length check (String &lt;=2)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(PCCTCD) &gt; 2 THEN 1 ELSE 0 END) AS invalid_count, 'DC3' AS dc_version,CAST(SYSTIMESTAMP AS TIMESTAMP) AS run_timestmp FROM DATACUT35.HUB_MT_EBCUSTP
    UNION ALL
    SELECT 'HUB_MT_EBCUSTP' AS table_name, 'PCGMAB' AS field_name, 'Group Member Abbreviation' AS description, 'Length check (String &lt;=4)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(PCGMAB) &gt; 4 THEN 1 ELSE 0 END) AS invalid_count, 'DC3' AS dc_version,CAST(SYSTIMESTAMP AS TIMESTAMP) AS run_timestmp FROM DATACUT35.HUB_MT_EBCUSTP
    UNION ALL
    SELECT 'HUB_MT_EBCUSTP' AS table_name, 'PCDCB' AS field_name, 'Customer Branch Number' AS description, 'Range check (Integer &lt;=3d)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ABS(PCDCB) &gt; 999 THEN 1 ELSE 0 END) AS invalid_count, 'DC3' AS dc_version,CAST(SYSTIMESTAMP AS TIMESTAMP) AS run_timestmp FROM DATACUT35.HUB_MT_EBCUSTP
    UNION ALL
    SELECT 'HUB_MT_EBCUSTP' AS table_name, 'PCDCS' AS field_name, 'Customer Serial Number' AS description, 'Range check (Integer &lt;=6d)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ABS(PCDCS) &gt; 999999 THEN 1 ELSE 0 END) AS invalid_count, 'DC3' AS dc_version,CAST(SYSTIMESTAMP AS TIMESTAMP) AS run_timestmp FROM DATACUT35.HUB_MT_EBCUSTP
    UNION ALL
    SELECT 'HUB_MT_EBCUSTP' AS table_name, 'PCSVCL' AS field_name, 'Service charge class' AS description, 'Range check (Integer &lt;=2d)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ABS(PCSVCL) &gt; 99 THEN 1 ELSE 0 END) AS invalid_count, 'DC3' AS dc_version,CAST(SYSTIMESTAMP AS TIMESTAMP) AS run_timestmp FROM DATACUT35.HUB_MT_EBCUSTP
    UNION ALL
    SELECT 'HUB_MT_EBCUSTP' AS table_name, 'PCPPBI' AS field_name, 'To indicate if the customer can use PPB services' AS description, 'Length check (String &lt;=1)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(PCPPBI) &gt; 1 THEN 1 ELSE 0 END) AS invalid_count, 'DC3' AS dc_version,CAST(SYSTIMESTAMP AS TIMESTAMP) AS run_timestmp FROM DATACUT35.HUB_MT_EBCUSTP
    UNION ALL
    SELECT 'HUB_MT_EBCUSTP' AS table_name, 'PCNDPI' AS field_name, 'Non-predesignated 3rd Party Payment Indicator.' AS description, 'Length check (String &lt;=1)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(PCNDPI) &gt; 1 THEN 1 ELSE 0 END) AS invalid_count, 'DC3' AS dc_version,CAST(SYSTIMESTAMP AS TIMESTAMP) AS run_timestmp FROM DATACUT35.HUB_MT_EBCUSTP
    UNION ALL
    SELECT 'HUB_MT_EBCUSTP' AS table_name, 'PCDFAM' AS field_name, 'Accumulated amount in LCY of fund transfer' AS description, 'Range check (Integer &lt;=15d)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ABS(PCDFAM) &gt; 999999999999999 THEN 1 ELSE 0 END) AS invalid_count, 'DC3' AS dc_version,CAST(SYSTIMESTAMP AS TIMESTAMP) AS run_timestmp FROM DATACUT35.HUB_MT_EBCUSTP
    UNION ALL
    SELECT 'HUB_MT_EBCUSTP' AS table_name, 'PCDLFT' AS field_name, 'Date Last Fund Transfer' AS description, 'Date check - format (YYYYMMDD) + future date' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN (PCDLFT NOT IN ('0', '99999999') AND VALIDATE_CONVERSION(PCDLFT AS DATE,'YYYYMMDD') = 0) OR (PCDLFT NOT IN ('0', '99999999') AND TO_DATE(PCDLFT,'YYYYMMDD') &gt; (SELECT cut_off FROM migration_date)) THEN 1 ELSE 0 END) AS invalid_count, 'DC3' AS dc_version,CAST(SYSTIMESTAMP AS TIMESTAMP) AS run_timestmp FROM DATACUT35.HUB_MT_EBCUSTP
    UNION ALL
    SELECT 'HUB_MT_EBCUSTP' AS table_name, 'PCDTAM' AS field_name, 'Accumulated amount in LCY of term deposit' AS description, 'Range check (Integer &lt;=15d)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ABS(PCDTAM) &gt; 999999999999999 THEN 1 ELSE 0 END) AS invalid_count, 'DC3' AS dc_version,CAST(SYSTIMESTAMP AS TIMESTAMP) AS run_timestmp FROM DATACUT35.HUB_MT_EBCUSTP
    UNION ALL
    SELECT 'HUB_MT_EBCUSTP' AS table_name, 'PCDLTD' AS field_name, 'Date Last Term Deposit Placement' AS description, 'Date check - format (YYYYMMDD) + future date' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN (PCDLTD NOT IN ('0', '99999999') AND VALIDATE_CONVERSION(PCDLTD AS DATE,'YYYYMMDD') = 0) OR (PCDLTD NOT IN ('0', '99999999') AND TO_DATE(PCDLTD,'YYYYMMDD') &gt; (SELECT cut_off FROM migration_date)) THEN 1 ELSE 0 END) AS invalid_count, 'DC3' AS dc_version,CAST(SYSTIMESTAMP AS TIMESTAMP) AS run_timestmp FROM DATACUT35.HUB_MT_EBCUSTP
    UNION ALL
    SELECT 'HUB_MT_EBCUSTP' AS table_name, 'PCDMAM' AS field_name, 'Accumulated amount in LCY of 3rd party payment' AS description, 'Range check (Integer &lt;=15d)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ABS(PCDMAM) &gt; 999999999999999 THEN 1 ELSE 0 END) AS invalid_count, 'DC3' AS dc_version,CAST(SYSTIMESTAMP AS TIMESTAMP) AS run_timestmp FROM DATACUT35.HUB_MT_EBCUSTP
    UNION ALL
    SELECT 'HUB_MT_EBCUSTP' AS table_name, 'PCDLPM' AS field_name, 'Date Last 3rd Party Payment' AS description, 'Date check - format (YYYYMMDD) + future date' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN (PCDLPM NOT IN ('0', '99999999') AND VALIDATE_CONVERSION(PCDLPM AS DATE,'YYYYMMDD') = 0) OR (PCDLPM NOT IN ('0', '99999999') AND TO_DATE(PCDLPM,'YYYYMMDD') &gt; (SELECT cut_off FROM migration_date)) THEN 1 ELSE 0 END) AS invalid_count, 'DC3' AS dc_version,CAST(SYSTIMESTAMP AS TIMESTAMP) AS run_timestmp FROM DATACUT35.HUB_MT_EBCUSTP
    UNION ALL
    SELECT 'HUB_MT_EBCUSTP' AS table_name, 'PCIVIC' AS field_name, 'Number of times customer has input invalid PIN' AS description, 'Range check (Integer &lt;=1d)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ABS(PCIVIC) &gt; 9 THEN 1 ELSE 0 END) AS invalid_count, 'DC3' AS dc_version,CAST(SYSTIMESTAMP AS TIMESTAMP) AS run_timestmp FROM DATACUT35.HUB_MT_EBCUSTP
    UNION ALL
    SELECT 'HUB_MT_EBCUSTP' AS table_name, 'PCPBNS' AS field_name, 'Status of PBN or HPB customer' AS description, 'Length check (String &lt;=1)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(PCPBNS) &gt; 1 THEN 1 ELSE 0 END) AS invalid_count, 'DC3' AS dc_version,CAST(SYSTIMESTAMP AS TIMESTAMP) AS run_timestmp FROM DATACUT35.HUB_MT_EBCUSTP
    UNION ALL
    SELECT 'HUB_MT_EBCUSTP' AS table_name, 'PCWSTC' AS field_name, 'Way of PBN status changed' AS description, 'Length check (String &lt;=1)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(PCWSTC) &gt; 1 THEN 1 ELSE 0 END) AS invalid_count, 'DC3' AS dc_version,CAST(SYSTIMESTAMP AS TIMESTAMP) AS run_timestmp FROM DATACUT35.HUB_MT_EBCUSTP
    UNION ALL
    SELECT 'HUB_MT_EBCUSTP' AS table_name, 'PCDSTC' AS field_name, 'Date on which the PBN status is changed.' AS description, 'Date check - format (YYYYMMDD) + future date' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN (PCDSTC NOT IN ('0', '99999999') AND VALIDATE_CONVERSION(PCDSTC AS DATE,'YYYYMMDD') = 0) OR (PCDSTC NOT IN ('0', '99999999') AND TO_DATE(PCDSTC,'YYYYMMDD') &gt; (SELECT cut_off FROM migration_date)) THEN 1 ELSE 0 END) AS invalid_count, 'DC3' AS dc_version,CAST(SYSTIMESTAMP AS TIMESTAMP) AS run_timestmp FROM DATACUT35.HUB_MT_EBCUSTP
    UNION ALL
    SELECT 'HUB_MT_EBCUSTP' AS table_name, 'PCDSCR' AS field_name, 'Date on which customer first subscribes to ATB' AS description, 'Date check - format (YYYYMMDD) + future date' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN (PCDSCR NOT IN ('0', '99999999') AND VALIDATE_CONVERSION(PCDSCR AS DATE,'YYYYMMDD') = 0) OR (PCDSCR NOT IN ('0', '99999999') AND TO_DATE(PCDSCR,'YYYYMMDD') &gt; (SELECT cut_off FROM migration_date)) THEN 1 ELSE 0 END) AS invalid_count, 'DC3' AS dc_version,CAST(SYSTIMESTAMP AS TIMESTAMP) AS run_timestmp FROM DATACUT35.HUB_MT_EBCUSTP
    UNION ALL
    SELECT 'HUB_MT_EBCUSTP' AS table_name, 'PCDLAV' AS field_name, 'Last date on which customer accesses HPB' AS description, 'Date check - format (YYYYMMDD) + future date' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN (PCDLAV NOT IN ('0', '99999999') AND VALIDATE_CONVERSION(PCDLAV AS DATE,'YYYYMMDD') = 0) OR (PCDLAV NOT IN ('0', '99999999') AND TO_DATE(PCDLAV,'YYYYMMDD') &gt; (SELECT cut_off FROM migration_date)) THEN 1 ELSE 0 END) AS invalid_count, 'DC3' AS dc_version,CAST(SYSTIMESTAMP AS TIMESTAMP) AS run_timestmp FROM DATACUT35.HUB_MT_EBCUSTP
    UNION ALL
