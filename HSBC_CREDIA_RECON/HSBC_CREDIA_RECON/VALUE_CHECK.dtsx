    SELECT 'HUB_MT_AFSITJP' AS table_name, 'F0BBI5' AS field_name, 'Bank to Bank Information Narrative Line 5' AS description, 'Length check (String &lt;=35)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(F0BBI5) &gt; 35 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_AFSITJP
    UNION ALL
    SELECT 'HUB_MT_AFSITJP' AS table_name, 'F0MAR1' AS field_name, 'Mailing Address 1' AS description, 'Length check (String &lt;=35)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(F0MAR1) &gt; 35 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_AFSITJP
    UNION ALL
    SELECT 'HUB_MT_AFSITJP' AS table_name, 'F0MAR2' AS field_name, 'Mailing Address 2' AS description, 'Length check (String &lt;=35)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(F0MAR2) &gt; 35 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_AFSITJP
    UNION ALL
    SELECT 'HUB_MT_AFSITJP' AS table_name, 'F0MAR3' AS field_name, 'Mailing Address 3' AS description, 'Length check (String &lt;=35)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(F0MAR3) &gt; 35 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_AFSITJP
    UNION ALL
    SELECT 'HUB_MT_AFSITJP' AS table_name, 'F0CVAD' AS field_name, 'Requesting Covering Advice Indicator in Issuing' AS description, 'Length check (String &lt;=1)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(F0CVAD) &gt; 1 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_AFSITJP
    UNION ALL
    SELECT 'HUB_MT_AFSITJP' AS table_name, 'F0RBCY' AS field_name, 'Reimbursement Currency' AS description, 'Length check (String &lt;=3)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(F0RBCY) &gt; 3 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_AFSITJP
    UNION ALL
    SELECT 'HUB_MT_AFSITJP' AS table_name, 'F0RSCH' AS field_name, 'Receiver Charge Amount' AS description, 'Range check (Integer &lt;=13d)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ABS(F0RSCH) &gt; 9999999999999 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_AFSITJP
    UNION ALL
    SELECT 'HUB_MT_AFSITJP' AS table_name, 'F0RCHC' AS field_name, 'Receiver Charge Currency' AS description, 'Length check (String &lt;=3)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(F0RCHC) &gt; 3 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_AFSITJP
    UNION ALL
    SELECT 'HUB_MT_AFSITJP' AS table_name, 'F0GRLE' AS field_name, 'General Recovery Charge        Amount in LCY' AS description, 'Range check (Integer &lt;=11d)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ABS(F0GRLE) &gt; 99999999999 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_AFSITJP
    UNION ALL
    SELECT 'HUB_MT_AFSITJP' AS table_name, 'F0GRCA' AS field_name, 'General Recovery Charge       Amount' AS description, 'Range check (Integer &lt;=11d)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ABS(F0GRCA) &gt; 99999999999 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_AFSITJP
    UNION ALL
    SELECT 'HUB_MT_AFSITJP' AS table_name, 'F0RGIT' AS field_name, 'General Recovery Charge       IE item code / GL en' AS description, 'Length check (String &lt;=6)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(F0RGIT) &gt; 6 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_AFSITJP
    UNION ALL
    SELECT 'HUB_MT_AFSITJP' AS table_name, 'F0GIIN' AS field_name, 'GL or IE Indicator' AS description, 'Length check (String &lt;=1)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(F0GIIN) &gt; 1 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_AFSITJP
    UNION ALL
    SELECT 'HUB_MT_AFSITJP' AS table_name, 'F0OGO' AS field_name, 'Online Generation Option' AS description, 'Length check (String &lt;=1)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(F0OGO) &gt; 1 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_AFSITJP
    UNION ALL
    SELECT 'HUB_MT_AFSITJP' AS table_name, 'F0VLOC' AS field_name, '**VLOC - MUST BE PUT AT THE END OF RECORD FORMAT**' AS description, 'Length check (String &lt;=200)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(F0VLOC) &gt; 200 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_AFSITJP
)
WHERE invalid_count &gt; 0
ORDER BY table_name, field_name, check_type;</property>
