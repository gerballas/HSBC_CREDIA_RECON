    UNION ALL
    SELECT 'HUB_MT_PLACMSP' AS table_name, 'PFCMAL' AS field_name, 'Commission Accrued LPD - LCY Minor' AS description, 'Range check (Integer &lt;=11d)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ABS(PFCMAL) &gt; 99999999999 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_PLACMSP
    UNION ALL
