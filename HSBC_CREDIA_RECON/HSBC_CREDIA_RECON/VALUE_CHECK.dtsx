    SELECT 'HUB_MT_SS@ACPP' AS table_name, 'ACDTCL' AS field_name, 'Account Closing Date' AS description, 'Date check - format (YYYY-MM-DD) + future date' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN (ACDTCL NOT IN ('0', '99999999') AND VALIDATE_CONVERSION(ACDTCL AS DATE,'YYYY-MM-DD') = 0) OR (ACDTCL NOT IN ('0', '99999999') AND TO_DATE(ACDTCL,'YYYY-MM-DD') &gt; (SELECT cut_off_iso FROM migration_date)) THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35."HUB_MT_SS@ACPP"
    UNION ALL
    SELECT 'HUB_MT_SS@ACPP' AS table_name, 'ACUQID' AS field_name, 'Unique ID' AS description, 'Length check (String &lt;=50)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(ACUQID) &gt; 50 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35."HUB_MT_SS@ACPP"
    UNION ALL
    SELECT 'HUB_MT_SS@ACPP' AS table_name, 'ACSTRT' AS field_name, 'Relationship Start Date' AS description, 'Date check - format (YYYY-MM-DD) + future date' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN (ACSTRT NOT IN ('0', '99999999') AND VALIDATE_CONVERSION(ACSTRT AS DATE,'YYYY-MM-DD') = 0) OR (ACSTRT NOT IN ('0', '99999999') AND TO_DATE(ACSTRT,'YYYY-MM-DD') &gt; (SELECT cut_off_iso FROM migration_date)) THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35."HUB_MT_SS@ACPP"
    UNION ALL
    SELECT 'HUB_MT_SS@ACPP' AS table_name, 'ACENDT' AS field_name, 'Relationship End Date' AS description, 'Date check - format (YYYY-MM-DD)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ACENDT NOT IN ('0', '99999999') AND VALIDATE_CONVERSION(ACENDT AS DATE,'YYYY-MM-DD') = 0 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35."HUB_MT_SS@ACPP"
    UNION ALL
    SELECT 'HUB_MT_SS@ACPP' AS table_name, 'ACCTCG' AS field_name, 'Relationship Type' AS description, 'Length check (String &lt;=2)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(ACCTCG) &gt; 2 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35."HUB_MT_SS@ACPP"
    UNION ALL
    SELECT 'HUB_MT_SS@ACPP' AS table_name, 'ACCSTY' AS field_name, 'Party Type' AS description, 'Length check (String &lt;=1)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(ACCSTY) &gt; 1 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35."HUB_MT_SS@ACPP"
)
WHERE invalid_count &gt; 0
ORDER BY table_name, field_name, check_type;</property>
