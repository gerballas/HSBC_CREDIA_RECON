                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">-- ====================================================================
-- Field Validation: ME01_VAL_SS_CREDIT
-- Scope: ME01 HUB Core Banking — Credit &amp; Security
-- Schema: DATACUT35
-- Based on DD v1.17 + DC35 Oracle Metadata
-- Date format: len=8/9 -&gt; YYYYMMDD | len=10 -&gt; YYYY-MM-DD
-- Sentinel values '0' and '99999999' treated as valid
-- NULL values treated as acceptable
-- Only rows with invalid_count &gt; 0 are returned
-- ====================================================================
-- ** SET MIGRATION CUT-OFF DATE HERE **
WITH migration_date AS (
    SELECT 
        TO_DATE('20260615', 'YYYYMMDD') AS cut_off,
        TO_DATE('20260615', 'YYYYMMDD') AS cut_off_iso
    FROM DUAL
)
SELECT CAST('ME01_VAL_SS_CDD_' || TO_CHAR(ROW_NUMBER() OVER (ORDER BY table_name, field_name, check_type), 'FM0000') AS VARCHAR2(50)) AS check_id,
    table_name, field_name, description, check_type,
    total_records, total_records - invalid_count AS valid_count, invalid_count,
    'DC3' AS DC_Version,
    SYSDATE AS Run_Timestamp
FROM (
    SELECT 'HUB_MT_SSCLMTP' AS table_name, 'ZFMDFL' AS field_name, 'Mode Flag' AS description, 'Length check (String &lt;=1)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(ZFMDFL) &gt; 1 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_SSCLMTP
    UNION ALL
    SELECT 'HUB_MT_SSCLMTP' AS table_name, 'ZFRRN#' AS field_name, 'Relative Record Number' AS description, 'Range check (Integer &lt;=13d)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ABS("ZFRRN#") &gt; 9999999999999 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_SSCLMTP
    UNION ALL
    SELECT 'HUB_MT_SSCLMTP' AS table_name, 'ZFCTCD' AS field_name, 'Country Code' AS description, 'Length check (String &lt;=2)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(ZFCTCD) &gt; 2 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_SSCLMTP
    UNION ALL
    SELECT 'HUB_MT_SSCLMTP' AS table_name, 'ZFDCG' AS field_name, 'Domestic Customer Group Member' AS description, 'Length check (String &lt;=4)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(ZFDCG) &gt; 4 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_SSCLMTP
    UNION ALL
    SELECT 'HUB_MT_SSCLMTP' AS table_name, 'ZFDCB' AS field_name, 'Customer Branch Number' AS description, 'Range check (Integer &lt;=3d)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ABS(ZFDCB) &gt; 999 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_SSCLMTP
    UNION ALL
    SELECT 'HUB_MT_SSCLMTP' AS table_name, 'ZFDCS' AS field_name, 'Customer Serial Number' AS description, 'Range check (Integer &lt;=6d)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ABS(ZFDCS) &gt; 999999 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_SSCLMTP
    UNION ALL
    SELECT 'HUB_MT_SSCLMTP' AS table_name, 'ZFGMAB' AS field_name, 'Group Member Abbreviation' AS description, 'Length check (String &lt;=4)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(ZFGMAB) &gt; 4 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_SSCLMTP
    UNION ALL
    SELECT 'HUB_MT_SSCLMTP' AS table_name, 'ZFLGI' AS field_name, 'Customer Limit Group Indicator' AS description, 'Length check (String &lt;=1)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(ZFLGI) &gt; 1 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_SSCLMTP
    UNION ALL
    SELECT 'HUB_MT_SSCLMTP' AS table_name, 'ZFLMTY' AS field_name, 'Limit Type ***' AS description, 'Length check (String &lt;=3)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(ZFLMTY) &gt; 3 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_SSCLMTP
    UNION ALL
    SELECT 'HUB_MT_SSCLMTP' AS table_name, 'ZFLINE' AS field_name, 'Facility Line No' AS description, 'Length check (String &lt;=2)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(ZFLINE) &gt; 2 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_SSCLMTP
    UNION ALL
    SELECT 'HUB_MT_SSCLMTP' AS table_name, 'ZFDS20' AS field_name, 'Description of length 20' AS description, 'Length check (String &lt;=20)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(ZFDS20) &gt; 20 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_SSCLMTP
    UNION ALL
    SELECT 'HUB_MT_SSCLMTP' AS table_name, 'ZFACLI' AS field_name, 'A/C Limit Indicator' AS description, 'Length check (String &lt;=1)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(ZFACLI) &gt; 1 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_SSCLMTP
    UNION ALL
    SELECT 'HUB_MT_SSCLMTP' AS table_name, 'ZFLMPS' AS field_name, 'Limit Printing Sequence' AS description, 'Range check (Integer &lt;=3d)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ABS(ZFLMPS) &gt; 999 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_SSCLMTP
    UNION ALL
    SELECT 'HUB_MT_SSCLMTP' AS table_name, 'ZFLMCY' AS field_name, 'Limit Currency' AS description, 'Length check (String &lt;=3)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(ZFLMCY) &gt; 3 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_SSCLMTP
