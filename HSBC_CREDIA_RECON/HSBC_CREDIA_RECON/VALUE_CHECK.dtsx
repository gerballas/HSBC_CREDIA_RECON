    UNION ALL
    SELECT 'HIE_IPACMSP' AS table_name, 'IGACS' AS field_name, 'Account Number Serial' AS description, 'Range check (Integer &lt;=6d)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ABS(IGACS) &gt; 999999 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HIE_IPACMSP
