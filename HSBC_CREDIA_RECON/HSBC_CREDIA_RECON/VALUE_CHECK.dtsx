                      expressionType="Notify"
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">-- ====================================================================
-- Field Validation: ME01_VAL_PL
-- Scope: ME01 HUB Core Banking — Pledges / Liens
-- Schema: DATACUT35
-- Based on DD v1.17 + DC35 Oracle Metadata
-- Date format: len=8/9 -&gt; YYYYMMDD | len=10 -&gt; YYYY-MM-DD
-- Sentinel values '0' and '99999999' treated as valid
-- NULL values treated as acceptable
-- Only rows with invalid_count &gt; 0 are returned
-- ====================================================================
-- ** SET MIGRATION CUT-OFF DATE HERE **
WITH migration_date AS (
    SELECT TO_DATE('20260615', 'YYYYMMDD') AS cut_off FROM DUAL
)
SELECT CAST('ME01_VAL_PL_' || TO_CHAR(ROW_NUMBER() OVER (ORDER BY table_name, field_name, check_type), 'FM0000') AS VARCHAR2(50)) AS check_id,
    table_name, field_name, description, check_type,
    total_records, total_records - invalid_count AS valid_count, invalid_count,
    'DC3' AS DC_Version,
    SYSDATE AS Run_Timestamp
FROM (
    SELECT 'HUB_MT_PLACMSP' AS table_name, 'PFMDFL' AS field_name, 'Mode Flag' AS description, 'Length check (String &lt;=1)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(PFMDFL) &gt; 1 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_PLACMSP
    UNION ALL
    SELECT 'HUB_MT_PLACMSP' AS table_name, 'PFRRN#' AS field_name, 'Relative Record Number' AS description, 'Range check (Integer &lt;=13d)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ABS("PFRRN#") &gt; 9999999999999 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_PLACMSP
    UNION ALL
    SELECT 'HUB_MT_PLACMSP' AS table_name, 'PFCTCD' AS field_name, 'Country Code' AS description, 'Length check (String &lt;=2)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(PFCTCD) &gt; 2 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_PLACMSP
    UNION ALL
    SELECT 'HUB_MT_PLACMSP' AS table_name, 'PFGMAB' AS field_name, 'Group Member Abbreviation' AS description, 'Length check (String &lt;=4)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(PFGMAB) &gt; 4 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_PLACMSP
    UNION ALL
    SELECT 'HUB_MT_PLACMSP' AS table_name, 'PFACB' AS field_name, 'Account Branch' AS description, 'Range check (Integer &lt;=3d)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ABS(PFACB) &gt; 999 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_PLACMSP
    UNION ALL
    SELECT 'HUB_MT_PLACMSP' AS table_name, 'PFACS' AS field_name, 'Account Number Serial' AS description, 'Range check (Integer &lt;=6d)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ABS(PFACS) &gt; 999999 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_PLACMSP
    UNION ALL
    SELECT 'HUB_MT_PLACMSP' AS table_name, 'PFACX' AS field_name, 'Account Suffix' AS description, 'Range check (Integer &lt;=3d)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ABS(PFACX) &gt; 999 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_PLACMSP
    UNION ALL
    SELECT 'HUB_MT_PLACMSP' AS table_name, 'PFCYCD' AS field_name, 'Currency' AS description, 'Length check (String &lt;=3)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(PFCYCD) &gt; 3 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_PLACMSP
    UNION ALL
    SELECT 'HUB_MT_PLACMSP' AS table_name, 'PFAPTY' AS field_name, 'Account/Product Type' AS description, 'Length check (String &lt;=3)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(PFAPTY) &gt; 3 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_PLACMSP
    UNION ALL
    SELECT 'HUB_MT_PLACMSP' AS table_name, 'PFDCG' AS field_name, 'Domestic Customer Group Member' AS description, 'Length check (String &lt;=4)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(PFDCG) &gt; 4 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_PLACMSP
    UNION ALL
    SELECT 'HUB_MT_PLACMSP' AS table_name, 'PFDCB' AS field_name, 'Customer Branch Number' AS description, 'Range check (Integer &lt;=3d)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ABS(PFDCB) &gt; 999 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_PLACMSP
    UNION ALL
    SELECT 'HUB_MT_PLACMSP' AS table_name, 'PFDCS' AS field_name, 'Customer Serial Number' AS description, 'Range check (Integer &lt;=6d)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ABS(PFDCS) &gt; 999999 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_PLACMSP
    UNION ALL
    SELECT 'HUB_MT_PLACMSP' AS table_name, 'PFEBAI' AS field_name, 'Electronic Banking Account No ***' AS description, 'Length check (String &lt;=4)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(PFEBAI) &gt; 4 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_PLACMSP
    UNION ALL
    SELECT 'HUB_MT_PLACMSP' AS table_name, 'PFACSN' AS field_name, 'A/C Short Name' AS description, 'Length check (String &lt;=28)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(PFACSN) &gt; 28 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_PLACMSP
    UNION ALL
    SELECT 'HUB_MT_PLACMSP' AS table_name, 'PFAC2N' AS field_name, '2nd Language Account Short Name' AS description, 'Length check (String &lt;=28)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(PFAC2N) &gt; 28 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_PLACMSP
    UNION ALL
    SELECT 'HUB_MT_PLACMSP' AS table_name, 'PFTRNO' AS field_name, 'Transaction Reference No' AS description, 'Length check (String &lt;=16)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(PFTRNO) &gt; 16 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_PLACMSP
    UNION ALL
    SELECT 'HUB_MT_PLACMSP' AS table_name, 'PFCBCL' AS field_name, 'Central Bank A/C Classification' AS description, 'Length check (String &lt;=3)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(PFCBCL) &gt; 3 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_PLACMSP
    UNION ALL
    SELECT 'HUB_MT_PLACMSP' AS table_name, 'PFGAT1' AS field_name, 'GIMIS ATTRIBUTE 1' AS description, 'Length check (String &lt;=3)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(PFGAT1) &gt; 3 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_PLACMSP
    UNION ALL
    SELECT 'HUB_MT_PLACMSP' AS table_name, 'PFGAT2' AS field_name, 'GIMIS ATTRIBUTE 2' AS description, 'Length check (String &lt;=3)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(PFGAT2) &gt; 3 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_PLACMSP
    UNION ALL
    SELECT 'HUB_MT_PLACMSP' AS table_name, 'PFDTAO' AS field_name, 'Date A/C Opened ***' AS description, 'Date check - format (YYYYMMDD) + future date' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN (PFDTAO NOT IN ('0', '99999999') AND VALIDATE_CONVERSION(PFDTAO AS DATE,'YYYYMMDD') = 0) OR (PFDTAO NOT IN ('0', '99999999') AND TO_DATE(PFDTAO,'YYYYMMDD') &gt; (SELECT cut_off FROM migration_date)) THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_PLACMSP
    UNION ALL
    SELECT 'HUB_MT_PLACMSP' AS table_name, 'PFSTDT' AS field_name, 'Start Date' AS description, 'Date check - format (YYYYMMDD)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN PFSTDT NOT IN ('0', '99999999') AND VALIDATE_CONVERSION(PFSTDT AS DATE,'YYYYMMDD') = 0 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_PLACMSP
    UNION ALL
    SELECT 'HUB_MT_PLACMSP' AS table_name, 'PFDUDT' AS field_name, 'Due Date ***' AS description, 'Date check - format (YYYYMMDD)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN PFDUDT NOT IN ('0', '99999999') AND VALIDATE_CONVERSION(PFDUDT AS DATE,'YYYYMMDD') = 0 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_PLACMSP
    UNION ALL
    SELECT 'HUB_MT_PLACMSP' AS table_name, 'PFDACL' AS field_name, 'Date account closed' AS description, 'Date check - format (YYYYMMDD) + future date' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN (PFDACL NOT IN ('0', '99999999') AND VALIDATE_CONVERSION(PFDACL AS DATE,'YYYYMMDD') = 0) OR (PFDACL NOT IN ('0', '99999999') AND TO_DATE(PFDACL,'YYYYMMDD') &gt; (SELECT cut_off FROM migration_date)) THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_PLACMSP
    UNION ALL
    SELECT 'HUB_MT_PLACMSP' AS table_name, 'PFSTUS' AS field_name, 'Status ***' AS description, 'Length check (String &lt;=1)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(PFSTUS) &gt; 1 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_PLACMSP
    UNION ALL
    SELECT 'HUB_MT_PLACMSP' AS table_name, 'PFACOT' AS field_name, 'A/C Opened Today Indicator' AS description, 'Length check (String &lt;=1)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(PFACOT) &gt; 1 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_PLACMSP
    UNION ALL
    SELECT 'HUB_MT_PLACMSP' AS table_name, 'PFRSTR' AS field_name, 'Restriction' AS description, 'Length check (String &lt;=1)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(PFRSTR) &gt; 1 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_PLACMSP
    UNION ALL
    SELECT 'HUB_MT_PLACMSP' AS table_name, 'PFGBSP' AS field_name, 'GHO B/S Pointer' AS description, 'Range check (Integer &lt;=5d)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ABS(PFGBSP) &gt; 99999 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_PLACMSP
    UNION ALL
    SELECT 'HUB_MT_PLACMSP' AS table_name, 'PFCBSP' AS field_name, 'Central Bank B/S Pointer' AS description, 'Range check (Integer &lt;=5d)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ABS(PFCBSP) &gt; 99999 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_PLACMSP
    UNION ALL
    SELECT 'HUB_MT_PLACMSP' AS table_name, 'PFMKS1' AS field_name, 'Market Sector 1' AS description, 'Range check (Integer &lt;=5d)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ABS(PFMKS1) &gt; 99999 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_PLACMSP
    UNION ALL
    SELECT 'HUB_MT_PLACMSP' AS table_name, 'PFMKP1' AS field_name, 'Market Sector Proportion' AS description, 'Range check (Integer &lt;=3d)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ABS(PFMKP1) &gt; 999 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_PLACMSP
    UNION ALL
    SELECT 'HUB_MT_PLACMSP' AS table_name, 'PFMKS2' AS field_name, 'Market Sector 2' AS description, 'Range check (Integer &lt;=5d)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ABS(PFMKS2) &gt; 99999 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_PLACMSP
    UNION ALL
    SELECT 'HUB_MT_PLACMSP' AS table_name, 'PFMKP2' AS field_name, 'Market Sector Proportion' AS description, 'Range check (Integer &lt;=3d)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ABS(PFMKP2) &gt; 999 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_PLACMSP
    UNION ALL
    SELECT 'HUB_MT_PLACMSP' AS table_name, 'PFMKS3' AS field_name, 'Market Sector 3' AS description, 'Range check (Integer &lt;=5d)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ABS(PFMKS3) &gt; 99999 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_PLACMSP
    UNION ALL
