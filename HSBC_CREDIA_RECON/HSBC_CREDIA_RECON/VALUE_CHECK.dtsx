                  version="1">
                  <properties>
                    <property
                      dataType="System.String"
                      description="The name of the table to be fetched."
                      expressionType="Notify"
                      name="TableName"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      expressionType="Notify"
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">-- ====================================================================
-- Field Validation: ME20_VAL_IMP_DC
-- Scope: ME20 HIE Import/Export — Import Documentary Credits
-- Schema: DATACUT35
-- Based on DD v1.8 + DC35 Oracle Metadata
-- Note: IHTLUP (HHMMSS) and IBTLUP (HHMM) are TIME fields — format check only
-- Sentinel values '0' and '99999999' treated as valid
-- NULL values treated as acceptable
-- Only rows with invalid_count &gt; 0 are returned
-- ====================================================================
-- ** SET MIGRATION CUT-OFF DATE HERE (YYYYMMDD) **
WITH migration_date AS (
    SELECT 
        TO_DATE('20260615', 'YYYYMMDD') AS cut_off,
        TO_DATE('20260615', 'YYYYMMDD') AS cut_off_iso
    FROM DUAL
)
SELECT CAST('ME20_VAL_IMP_DC_' || TO_CHAR(ROW_NUMBER() OVER (ORDER BY table_name, field_name, check_type), 'FM0000') AS VARCHAR2(50)) AS check_id,
    table_name, field_name, description, check_type,
    total_records, total_records - invalid_count AS valid_count, invalid_count,
    'DC3' AS DC_Version,
    SYSDATE AS Run_Timestamp
FROM (
    SELECT 'HIE_IPDCMSP' AS table_name, 'IHMDFL' AS field_name, 'Mode Flag' AS description, 'Length check (String &lt;=1)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(IHMDFL) &gt; 1 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HIE_IPDCMSP
    UNION ALL
    SELECT 'HIE_IPDCMSP' AS table_name, 'IHRRN#' AS field_name, 'Relative Record Number' AS description, 'Range check (Integer &lt;=13d)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ABS("IHRRN#") &gt; 9999999999999 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HIE_IPDCMSP
    UNION ALL
    SELECT 'HIE_IPDCMSP' AS table_name, 'IHCTCD' AS field_name, 'Country Code' AS description, 'Length check (String &lt;=2)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(IHCTCD) &gt; 2 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HIE_IPDCMSP
    UNION ALL
    SELECT 'HIE_IPDCMSP' AS table_name, 'IHGMAB' AS field_name, 'Group Member Abbreviation' AS description, 'Length check (String &lt;=4)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(IHGMAB) &gt; 4 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HIE_IPDCMSP
    UNION ALL
    SELECT 'HIE_IPDCMSP' AS table_name, 'IHDCPT' AS field_name, 'DC product type' AS description, 'Length check (String &lt;=3)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(IHDCPT) &gt; 3 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HIE_IPDCMSP
    UNION ALL
    SELECT 'HIE_IPDCMSP' AS table_name, 'IHBRAB' AS field_name, 'Branch Mnemonic' AS description, 'Length check (String &lt;=3)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(IHBRAB) &gt; 3 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HIE_IPDCMSP
    UNION ALL
    SELECT 'HIE_IPDCMSP' AS table_name, 'IHDCNO' AS field_name, 'The serial part of DC number' AS description, 'Range check (Integer &lt;=6d)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ABS(IHDCNO) &gt; 999999 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HIE_IPDCMSP
    UNION ALL
    SELECT 'HIE_IPDCMSP' AS table_name, 'IHACB' AS field_name, 'Account Number' AS description, 'Range check (Integer &lt;=3d)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ABS(IHACB) &gt; 999 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HIE_IPDCMSP
    UNION ALL
    SELECT 'HIE_IPDCMSP' AS table_name, 'IHACS' AS field_name, 'Account Number' AS description, 'Range check (Integer &lt;=6d)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ABS(IHACS) &gt; 999999 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HIE_IPDCMSP
    UNION ALL
    SELECT 'HIE_IPDCMSP' AS table_name, 'IHACX' AS field_name, 'Account Number ***' AS description, 'Range check (Integer &lt;=3d)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ABS(IHACX) &gt; 999 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HIE_IPDCMSP
    UNION ALL
    SELECT 'HIE_IPDCMSP' AS table_name, 'IHDVNO' AS field_name, 'DC Version Number' AS description, 'Range check (Decimal &lt;=5d)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ABS(IHDVNO) &gt; 99999 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HIE_IPDCMSP
    UNION ALL
    SELECT 'HIE_IPDCMSP' AS table_name, 'IHNMD' AS field_name, 'Model or Normal record Flag' AS description, 'Length check (String &lt;=1)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(IHNMD) &gt; 1 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HIE_IPDCMSP
    UNION ALL
    SELECT 'HIE_IPDCMSP' AS table_name, 'IHNAD1' AS field_name, 'Customer Name and Address' AS description, 'Length check (String &lt;=35)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(IHNAD1) &gt; 35 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HIE_IPDCMSP
    UNION ALL
    SELECT 'HIE_IPDCMSP' AS table_name, 'IHNAD2' AS field_name, 'Customer Name and Address' AS description, 'Length check (String &lt;=35)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(IHNAD2) &gt; 35 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HIE_IPDCMSP
    UNION ALL
    SELECT 'HIE_IPDCMSP' AS table_name, 'IHNAD3' AS field_name, 'Customer Name and Address' AS description, 'Length check (String &lt;=35)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(IHNAD3) &gt; 35 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HIE_IPDCMSP
    UNION ALL
    SELECT 'HIE_IPDCMSP' AS table_name, 'IHNAD4' AS field_name, 'Customer Name and Address' AS description, 'Length check (String &lt;=35)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(IHNAD4) &gt; 35 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HIE_IPDCMSP
    UNION ALL
    SELECT 'HIE_IPDCMSP' AS table_name, 'IHNAD5' AS field_name, 'Customer Name and Address' AS description, 'Length check (String &lt;=35)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(IHNAD5) &gt; 35 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HIE_IPDCMSP
    UNION ALL
    SELECT 'HIE_IPDCMSP' AS table_name, 'IHBEA1' AS field_name, 'Beneficiary Name and Address Line 1' AS description, 'Length check (String &lt;=35)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(IHBEA1) &gt; 35 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HIE_IPDCMSP
    UNION ALL
    SELECT 'HIE_IPDCMSP' AS table_name, 'IHBEA2' AS field_name, 'Beneficiary Name and Address Line 2' AS description, 'Length check (String &lt;=35)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(IHBEA2) &gt; 35 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HIE_IPDCMSP
    UNION ALL
