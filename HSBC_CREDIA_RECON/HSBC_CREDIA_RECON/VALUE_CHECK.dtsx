    SELECT 'HUB_MT_DCPDCPP' AS table_name, 'D4CRTH' AS field_name, 'Credit Dormancy Threshold Amount (RCY)' AS description, 'Range check (Integer &lt;=13d)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ABS(D4CRTH) &gt; 9999999999999 THEN 1 ELSE 0 END) AS invalid_count, 'DC3' AS dc_version,CAST(SYSTIMESTAMP AS TIMESTAMP) AS run_timestmp FROM DATACUT35.HUB_MT_DCPDCPP
)
WHERE invalid_count &gt; 0
ORDER BY table_name, field_name, check_type;</property>
