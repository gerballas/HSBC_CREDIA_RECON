                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">-- ====================================================================
-- Field Validation: ME01_VAL_DD
-- Scope: ME01 HUB Core Banking — Demand Deposits + Overdrafts
-- Schema: DATACUT35
-- Based on DD v1.17 + DC35 Oracle Metadata
-- Date format: len=8/9 -&gt; YYYYMMDD | len=10 -&gt; YYYY-MM-DD
-- Sentinel values '0' and '99999999' treated as valid
-- NULL values treated as acceptable
-- Only rows with invalid_count &gt; 0 are returned
-- ====================================================================
-- ** SET MIGRATION CUT-OFF DATE HERE **
WITH migration_date AS (
    SELECT TO_DATE('20260615', 'YYYYMMDD') AS cut_off FROM DUAL
)
SELECT CAST('ME01_VAL_DD_' || TO_CHAR(ROW_NUMBER() OVER (ORDER BY table_name, field_name, check_type), 'FM0000') AS VARCHAR2(50)) AS check_id,
    table_name, field_name, description, check_type,
    total_records, total_records - invalid_count AS valid_count, invalid_count,
    'DC3' AS DC_Version,
    SYSDATE AS Run_Timestamp
FROM (
    SELECT 'HUB_MT_DDACMSP' AS table_name, 'DFMDFL' AS field_name, 'Mode Flag' AS description, 'Length check (String &lt;=1)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(DFMDFL) &gt; 1 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_DDACMSP
    UNION ALL
    SELECT 'HUB_MT_DDACMSP' AS table_name, 'DFRRN#' AS field_name, 'Relative Record Number' AS description, 'Range check (Integer &lt;=13d)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ABS("DFRRN#") &gt; 9999999999999 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_DDACMSP
    UNION ALL
    SELECT 'HUB_MT_DDACMSP' AS table_name, 'DFCTCD' AS field_name, 'Country Code' AS description, 'Length check (String &lt;=2)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(DFCTCD) &gt; 2 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_DDACMSP
    UNION ALL
    SELECT 'HUB_MT_DDACMSP' AS table_name, 'DFGMAB' AS field_name, 'Group Member Abbreviation' AS description, 'Length check (String &lt;=4)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(DFGMAB) &gt; 4 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_DDACMSP
    UNION ALL
    SELECT 'HUB_MT_DDACMSP' AS table_name, 'DFACB' AS field_name, 'Account Branch' AS description, 'Range check (Integer &lt;=3d)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ABS(DFACB) &gt; 999 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_DDACMSP
    UNION ALL
    SELECT 'HUB_MT_DDACMSP' AS table_name, 'DFACS' AS field_name, 'Account Number Serial' AS description, 'Range check (Integer &lt;=6d)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ABS(DFACS) &gt; 999999 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_DDACMSP
    UNION ALL
    SELECT 'HUB_MT_DDACMSP' AS table_name, 'DFACX' AS field_name, 'Account Suffix' AS description, 'Range check (Integer &lt;=3d)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ABS(DFACX) &gt; 999 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_DDACMSP
    UNION ALL
    SELECT 'HUB_MT_DDACMSP' AS table_name, 'DFAPTY' AS field_name, 'Account/Product Type' AS description, 'Length check (String &lt;=3)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(DFAPTY) &gt; 3 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_DDACMSP
    UNION ALL
    SELECT 'HUB_MT_DDACMSP' AS table_name, 'DFCYCD' AS field_name, 'Currency' AS description, 'Length check (String &lt;=3)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(DFCYCD) &gt; 3 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_DDACMSP
    UNION ALL
    SELECT 'HUB_MT_DDACMSP' AS table_name, 'DFDCG' AS field_name, 'Domestic Customer Group Member' AS description, 'Length check (String &lt;=4)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(DFDCG) &gt; 4 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_DDACMSP
    UNION ALL
    SELECT 'HUB_MT_DDACMSP' AS table_name, 'DFDCB' AS field_name, 'Customer Branch Number' AS description, 'Range check (Integer &lt;=3d)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ABS(DFDCB) &gt; 999 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_DDACMSP
    UNION ALL
    SELECT 'HUB_MT_DDACMSP' AS table_name, 'DFDCS' AS field_name, 'Customer Serial Number' AS description, 'Range check (Integer &lt;=6d)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ABS(DFDCS) &gt; 999999 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_DDACMSP
    UNION ALL
    SELECT 'HUB_MT_DDACMSP' AS table_name, 'DFEBAI' AS field_name, 'Electronic Banking Account No ***' AS description, 'Length check (String &lt;=4)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(DFEBAI) &gt; 4 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_DDACMSP
    UNION ALL
    SELECT 'HUB_MT_DDACMSP' AS table_name, 'DFACSN' AS field_name, 'A/C Short Name' AS description, 'Length check (String &lt;=28)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(DFACSN) &gt; 28 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_DDACMSP
    UNION ALL
    SELECT 'HUB_MT_DDACMSP' AS table_name, 'DFAC2N' AS field_name, '2nd Language Account Short Name' AS description, 'Length check (String &lt;=28)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(DFAC2N) &gt; 28 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_DDACMSP
    UNION ALL
    SELECT 'HUB_MT_DDACMSP' AS table_name, 'DFRSTR' AS field_name, 'Restriction' AS description, 'Length check (String &lt;=1)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(DFRSTR) &gt; 1 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_DDACMSP
    UNION ALL
    SELECT 'HUB_MT_DDACMSP' AS table_name, 'DFTUPI' AS field_name, 'Cheque Tick-Up Indicator' AS description, 'Length check (String &lt;=1)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(DFTUPI) &gt; 1 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_DDACMSP
    UNION ALL
    SELECT 'HUB_MT_DDACMSP' AS table_name, 'DFSTUS' AS field_name, 'Status ***' AS description, 'Length check (String &lt;=1)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(DFSTUS) &gt; 1 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_DDACMSP
    UNION ALL
    SELECT 'HUB_MT_DDACMSP' AS table_name, 'DFCBST' AS field_name, 'Statutory A/C Status' AS description, 'Length check (String &lt;=1)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(DFCBST) &gt; 1 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_DDACMSP
    UNION ALL
    SELECT 'HUB_MT_DDACMSP' AS table_name, 'DFDTAO' AS field_name, 'Date A/C Opened ***' AS description, 'Date check - format (YYYYMMDD) + future date' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN (DFDTAO NOT IN ('0', '99999999') AND VALIDATE_CONVERSION(DFDTAO AS DATE,'YYYYMMDD') = 0) OR (DFDTAO NOT IN ('0', '99999999') AND TO_DATE(DFDTAO,'YYYYMMDD') &gt; (SELECT cut_off FROM migration_date)) THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_DDACMSP
    UNION ALL
    SELECT 'HUB_MT_DDACMSP' AS table_name, 'DFCBCL' AS field_name, 'Central Bank A/C Classification' AS description, 'Length check (String &lt;=3)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(DFCBCL) &gt; 3 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_DDACMSP
    UNION ALL
    SELECT 'HUB_MT_DDACMSP' AS table_name, 'DFMKS1' AS field_name, 'Market Sector 1' AS description, 'Range check (Integer &lt;=5d)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ABS(DFMKS1) &gt; 99999 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_DDACMSP
    UNION ALL
    SELECT 'HUB_MT_DDACMSP' AS table_name, 'DFMKP1' AS field_name, 'Market Sector Proportion' AS description, 'Range check (Integer &lt;=3d)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ABS(DFMKP1) &gt; 999 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_DDACMSP
    UNION ALL
    SELECT 'HUB_MT_DDACMSP' AS table_name, 'DFMKS2' AS field_name, 'Market Sector 2' AS description, 'Range check (Integer &lt;=5d)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ABS(DFMKS2) &gt; 99999 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_DDACMSP
    UNION ALL
    SELECT 'HUB_MT_DDACMSP' AS table_name, 'DFMKP2' AS field_name, 'Market Sector Proportion' AS description, 'Range check (Integer &lt;=3d)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ABS(DFMKP2) &gt; 999 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_DDACMSP
    UNION ALL
