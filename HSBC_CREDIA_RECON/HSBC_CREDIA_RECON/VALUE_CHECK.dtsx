-- Field Validation: ME01_VAL_FN
-- Scope: ME01 HUB Core Banking — Business Register
-- Schema: DATACUT35
-- Based on DD v1.17 + DC35 Oracle Metadata
-- Date format: len=8/9 -&gt; YYYYMMDD | len=10 -&gt; YYYY-MM-DD
-- Sentinel values '0' and '99999999' treated as valid
-- NULL values treated as acceptable
-- Only rows with invalid_count &gt; 0 are returned
-- ====================================================================
-- ** SET MIGRATION CUT-OFF DATE HERE **
WITH migration_date AS (
    SELECT 
        TO_DATE('20260615', 'YYYYMMDD') AS cut_off,
        TO_DATE('20260615', 'YYYYMMDD') AS cut_off_iso
    FROM DUAL)

SELECT CAST('ME01_VAL_FN_' || TO_CHAR(ROW_NUMBER() OVER (ORDER BY table_name, field_name, check_type), 'FM0000') AS VARCHAR2(50)) AS check_id,
    table_name, field_name, description, check_type,
    total_records, total_records - invalid_count AS valid_count, invalid_count,
    'DC3' AS DC_Version,
    SYSDATE AS Run_Timestamp
FROM (
    SELECT 'HUB_MT_FN@BRGP' AS table_name, 'FNDTIS' AS field_name, 'BR_ITEM_INSERTION_DATE' AS description, 'Date check - format (YYYY-MM-DD) + future date' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN (FNDTIS NOT IN ('0', '99999999') AND VALIDATE_CONVERSION(FNDTIS AS DATE,'YYYY-MM-DD') = 0) OR (FNDTIS NOT IN ('0', '99999999') AND TO_DATE(FNDTIS,'YYYY-MM-DD') &gt; (SELECT cut_off_iso FROM migration_date)) THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35."HUB_MT_FN@BRGP"
    UNION ALL
    SELECT 'HUB_MT_FN@BRGP' AS table_name, 'FNDENT' AS field_name, 'IDENT' AS description, 'Range check (Integer &lt;=7d)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ABS(FNDENT) &gt; 9999999 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35."HUB_MT_FN@BRGP"
    UNION ALL
    SELECT 'HUB_MT_FN@BRGP' AS table_name, 'FNSTDT' AS field_name, 'STRDT' AS description, 'Date check - format (YYYYMMDD)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN FNSTDT NOT IN ('0', '99999999') AND VALIDATE_CONVERSION(FNSTDT AS DATE,'YYYYMMDD') = 0 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35."HUB_MT_FN@BRGP"
    UNION ALL
    SELECT 'HUB_MT_FN@BRGP' AS table_name, 'FNCLDT' AS field_name, 'CLSDT' AS description, 'Range check (Integer &lt;=8d)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ABS(FNCLDT) &gt; 99999999 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35."HUB_MT_FN@BRGP"
    UNION ALL
    SELECT 'HUB_MT_FN@BRGP' AS table_name, 'FNNACE' AS field_name, 'CBMNACE' AS description, 'Range check (Decimal &lt;=7d)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ABS(FNNACE) &gt; 9999999 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35."HUB_MT_FN@BRGP"
    UNION ALL
    SELECT 'HUB_MT_FN@BRGP' AS table_name, 'FNIDNO' AS field_name, 'MFSACOMP' AS description, 'Length check (String &lt;=20)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(FNIDNO) &gt; 20 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35."HUB_MT_FN@BRGP"
    UNION ALL
    SELECT 'HUB_MT_FN@BRGP' AS table_name, 'FNVAT#' AS field_name, 'VATNUM' AS description, 'Range check (Integer &lt;=8d)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ABS("FNVAT#") &gt; 99999999 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35."HUB_MT_FN@BRGP"
    UNION ALL
    SELECT 'HUB_MT_FN@BRGP' AS table_name, 'FNEXID' AS field_name, 'EXT_ID' AS description, 'Length check (String &lt;=50)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(FNEXID) &gt; 50 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35."HUB_MT_FN@BRGP"
    UNION ALL
    SELECT 'HUB_MT_FN@BRGP' AS table_name, 'FNNAME' AS field_name, 'ENTITY_NAME' AS description, 'Length check (String &lt;=200)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(FNNAME) &gt; 200 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35."HUB_MT_FN@BRGP"
    UNION ALL
    SELECT 'HUB_MT_FN@BRGP' AS table_name, 'FNRSDY' AS field_name, 'RESIDENCY' AS description, 'Length check (String &lt;=50)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(FNRSDY) &gt; 50 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35."HUB_MT_FN@BRGP"
    UNION ALL
    SELECT 'HUB_MT_FN@BRGP' AS table_name, 'FNSOSEC' AS field_name, 'NSOSECCHAR' AS description, 'Length check (String &lt;=5)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(FNSOSEC) &gt; 5 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35."HUB_MT_FN@BRGP"
    UNION ALL
    SELECT 'HUB_MT_FN@BRGP' AS table_name, 'FNSOSED' AS field_name, 'NSOSECCHAR_DESCRIPTION' AS description, 'Length check (String &lt;=200)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(FNSOSED) &gt; 200 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35."HUB_MT_FN@BRGP"
    UNION ALL
