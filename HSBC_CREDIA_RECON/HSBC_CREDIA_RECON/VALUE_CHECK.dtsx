                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">-- ====================================================================
-- Field Validation: ME01_VAL_SS_OTHER
-- Scope: ME01 HUB Core Banking — HVP, SEPA, E-Wallet &amp; Other SS@
-- Schema: DATACUT35
-- Based on DD v1.17 + DC35 Oracle Metadata
-- Date format: len=8/9 -&gt; YYYYMMDD | len=10 -&gt; YYYY-MM-DD
-- Sentinel values '0' and '99999999' treated as valid
-- NULL values treated as acceptable
-- Only rows with invalid_count &gt; 0 are returned
-- ====================================================================
-- ** SET MIGRATION CUT-OFF DATE HERE **
WITH migration_date AS (
    SELECT 
        TO_DATE('20260615', 'YYYYMMDD') AS cut_off,
        TO_DATE('20260615', 'YYYYMMDD') AS cut_off_iso
    FROM DUAL
)
SELECT CAST('ME01_VAL_SS_OTHER_' || TO_CHAR(ROW_NUMBER() OVER (ORDER BY table_name, field_name, check_type), 'FM0000') AS VARCHAR2(50)) AS check_id,
    table_name, field_name, description, check_type,
    total_records, total_records - invalid_count AS valid_count, invalid_count,
    'DC3' AS DC_Version,
    SYSDATE AS Run_Timestamp
FROM (
    SELECT 'HUB_MT_SS@HMTP' AS table_name, 'MTCLID' AS field_name, 'CLIENT ID' AS description, 'Length check (String &lt;=20)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(MTCLID) &gt; 20 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35."HUB_MT_SS@HMTP"
    UNION ALL
    SELECT 'HUB_MT_SS@HMTP' AS table_name, 'MTMTID' AS field_name, 'CUSTOMER ID' AS description, 'Length check (String &lt;=20)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(MTMTID) &gt; 20 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35."HUB_MT_SS@HMTP"
    UNION ALL
    SELECT 'HUB_MT_SS@HMTP' AS table_name, 'MTCTCD' AS field_name, 'COUNTRY CODE' AS description, 'Length check (String &lt;=2)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(MTCTCD) &gt; 2 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35."HUB_MT_SS@HMTP"
    UNION ALL
    SELECT 'HUB_MT_SS@HMTP' AS table_name, 'MTDCG' AS field_name, 'DOMESTIC CUSTOMER GROUP MEMBER' AS description, 'Length check (String &lt;=4)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(MTDCG) &gt; 4 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35."HUB_MT_SS@HMTP"
    UNION ALL
    SELECT 'HUB_MT_SS@HMTP' AS table_name, 'MTDCB' AS field_name, 'CUSTOMER BRANCH NUMBER' AS description, 'Range check (Integer &lt;=3d)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ABS(MTDCB) &gt; 999 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35."HUB_MT_SS@HMTP"
    UNION ALL
    SELECT 'HUB_MT_SS@HMTP' AS table_name, 'MTDCS' AS field_name, 'CUSTOMER SERIAL NUMBER' AS description, 'Range check (Integer &lt;=6d)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ABS(MTDCS) &gt; 999999 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35."HUB_MT_SS@HMTP"
    UNION ALL
    SELECT 'HUB_MT_SS@HMTP' AS table_name, 'MTIBAN' AS field_name, 'ACCOUNT NUM/IBAN' AS description, 'Length check (String &lt;=34)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(MTIBAN) &gt; 34 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35."HUB_MT_SS@HMTP"
