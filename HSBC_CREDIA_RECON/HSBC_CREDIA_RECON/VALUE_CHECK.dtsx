                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">-- ====================================================================
-- Field Validation: ME01_VAL_SS_MISC
-- Scope: ME01 HUB Core Banking — Charges, Holds, IFRS9, Safe Deposit
-- Schema: DATACUT35
-- Based on DD v1.17 + DC35 Oracle Metadata
-- Date format: len=8/9 -&gt; YYYYMMDD | len=10 -&gt; YYYY-MM-DD
-- Sentinel values '0' and '99999999' treated as valid
-- NULL values treated as acceptable
-- Only rows with invalid_count &gt; 0 are returned
-- ====================================================================
-- ** SET MIGRATION CUT-OFF DATE HERE **
WITH migration_date AS (
    SELECT 
        TO_DATE('20260615', 'YYYYMMDD') AS cut_off,
        TO_DATE('20260615', 'YYYYMMDD') AS cut_off_iso
    FROM DUAL
)
SELECT CAST('ME01_VAL_SS_MISC_' || TO_CHAR(ROW_NUMBER() OVER (ORDER BY table_name, field_name, check_type), 'FM0000') AS VARCHAR2(50)) AS check_id,
    table_name, field_name, description, check_type,
    total_records, total_records - invalid_count AS valid_count, invalid_count,
    'DC3' AS DC_Version,
    SYSDATE AS Run_Timestamp
FROM (
    SELECT 'HUB_MT_SSCHCLP' AS table_name, 'SCMDFL' AS field_name, 'Mode Flag' AS description, 'Length check (String &lt;=1)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(SCMDFL) &gt; 1 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_SSCHCLP
    UNION ALL
    SELECT 'HUB_MT_SSCHCLP' AS table_name, 'SCRRN#' AS field_name, 'Relative Record Number' AS description, 'Range check (Integer &lt;=13d)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ABS("SCRRN#") &gt; 9999999999999 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_SSCHCLP
    UNION ALL
    SELECT 'HUB_MT_SSCHCLP' AS table_name, 'SCCTCD' AS field_name, 'Country Code' AS description, 'Length check (String &lt;=2)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(SCCTCD) &gt; 2 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_SSCHCLP
    UNION ALL
    SELECT 'HUB_MT_SSCHCLP' AS table_name, 'SCGMAB' AS field_name, 'Group Member Abbreviation' AS description, 'Length check (String &lt;=4)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(SCGMAB) &gt; 4 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_SSCHCLP
    UNION ALL
    SELECT 'HUB_MT_SSCHCLP' AS table_name, 'SCCHRC' AS field_name, 'Charge Code' AS description, 'Length check (String &lt;=3)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(SCCHRC) &gt; 3 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_SSCHCLP
    UNION ALL
    SELECT 'HUB_MT_SSCHCLP' AS table_name, 'SCBRNO' AS field_name, 'Branch Number' AS description, 'Range check (Integer &lt;=4d)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ABS(SCBRNO) &gt; 9999 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_SSCHCLP
    UNION ALL
    SELECT 'HUB_MT_SSCHCLP' AS table_name, 'SCPRIE' AS field_name, 'Product/I/E type' AS description, 'Length check (String &lt;=3)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(SCPRIE) &gt; 3 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_SSCHCLP
    UNION ALL
    SELECT 'HUB_MT_SSCHCLP' AS table_name, 'SCMKS' AS field_name, 'Market Sector Code' AS description, 'Range check (Integer &lt;=6d)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ABS(SCMKS) &gt; 999999 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_SSCHCLP
    UNION ALL
    SELECT 'HUB_MT_SSCHCLP' AS table_name, 'SCGAT1' AS field_name, 'GIMIS ATTRIBUTE 1' AS description, 'Length check (String &lt;=3)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(SCGAT1) &gt; 3 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_SSCHCLP
    UNION ALL
    SELECT 'HUB_MT_SSCHCLP' AS table_name, 'SCGAT2' AS field_name, 'GIMIS ATTRIBUTE 2' AS description, 'Length check (String &lt;=3)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(SCGAT2) &gt; 3 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_SSCHCLP
    UNION ALL
    SELECT 'HUB_MT_SSCHCLP' AS table_name, 'SCCHCY' AS field_name, 'Charge Currency' AS description, 'Length check (String &lt;=3)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(SCCHCY) &gt; 3 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_SSCHCLP
    UNION ALL
    SELECT 'HUB_MT_SSCHCLP' AS table_name, 'SCGHCL' AS field_name, 'GHO Customer Classification' AS description, 'Length check (String &lt;=3)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(SCGHCL) &gt; 3 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_SSCHCLP
    UNION ALL
    SELECT 'HUB_MT_SSCHCLP' AS table_name, 'SCDCC' AS field_name, 'Domestic Customer Country' AS description, 'Length check (String &lt;=2)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(SCDCC) &gt; 2 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_SSCHCLP
    UNION ALL
    SELECT 'HUB_MT_SSCHCLP' AS table_name, 'SCDCG' AS field_name, 'Domestic Customer Group Member' AS description, 'Length check (String &lt;=4)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(SCDCG) &gt; 4 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_SSCHCLP
    UNION ALL
    SELECT 'HUB_MT_SSCHCLP' AS table_name, 'SCDCB' AS field_name, 'Customer Branch Number' AS description, 'Range check (Integer &lt;=3d)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ABS(SCDCB) &gt; 999 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_SSCHCLP
    UNION ALL
    SELECT 'HUB_MT_SSCHCLP' AS table_name, 'SCACS' AS field_name, 'Account Number Serial' AS description, 'Range check (Integer &lt;=6d)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ABS(SCACS) &gt; 999999 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_SSCHCLP
    UNION ALL
    SELECT 'HUB_MT_SSCHCLP' AS table_name, 'SCACX' AS field_name, 'Account Suffix' AS description, 'Range check (Integer &lt;=3d)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ABS(SCACX) &gt; 999 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_SSCHCLP
    UNION ALL
    SELECT 'HUB_MT_SSCHCLP' AS table_name, 'SCDYR1' AS field_name, 'Day Range 1' AS description, 'Range check (Integer &lt;=3d)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ABS(SCDYR1) &gt; 999 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_SSCHCLP
    UNION ALL
