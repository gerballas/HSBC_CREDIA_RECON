    UNION ALL
    SELECT 'HUB_MT_EBCUSTP' AS table_name, 'PCLDSP' AS field_name, 'Last date until when customer record is suspended.' AS description, 'Date check - format (YYYYMMDD)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN PCLDSP NOT IN ('0', '99999999') AND VALIDATE_CONVERSION(PCLDSP AS DATE,'YYYYMMDD') = 0 THEN 1 ELSE 0 END) AS invalid_count, 'DC3' AS dc_version,CAST(SYSTIMESTAMP AS TIMESTAMP) AS run_timestmp FROM DATACUT35.HUB_MT_EBCUSTP
    UNION ALL
    SELECT 'HUB_MT_EBCUSTP' AS table_name, 'PCDCPC' AS field_name, 'Date Customer Portfolio Changed' AS description, 'Date check - format (YYYYMMDD) + future date' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN (PCDCPC NOT IN ('0', '99999999') AND VALIDATE_CONVERSION(PCDCPC AS DATE,'YYYYMMDD') = 0) OR (PCDCPC NOT IN ('0', '99999999') AND TO_DATE(PCDCPC,'YYYYMMDD') &gt; (SELECT cut_off FROM migration_date)) THEN 1 ELSE 0 END) AS invalid_count, 'DC3' AS dc_version,CAST(SYSTIMESTAMP AS TIMESTAMP) AS run_timestmp FROM DATACUT35.HUB_MT_EBCUSTP
    UNION ALL
    SELECT 'HUB_MT_EBCUSTP' AS table_name, 'PCDAVP' AS field_name, 'Doubtful Advice Printed Flag' AS description, 'Length check (String &lt;=1)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(PCDAVP) &gt; 1 THEN 1 ELSE 0 END) AS invalid_count, 'DC3' AS dc_version,CAST(SYSTIMESTAMP AS TIMESTAMP) AS run_timestmp FROM DATACUT35.HUB_MT_EBCUSTP
    UNION ALL
