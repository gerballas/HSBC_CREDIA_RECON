    SELECT 'HUB_MT_BAOMGTP' AS table_name, 'BNFTAG' AS field_name, 'Field Tag for SWIFT Messages' AS description, 'Length check (String &lt;=5)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(BNFTAG) &gt; 5 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_BAOMGTP
    UNION ALL
    SELECT 'HUB_MT_BAOMGTP' AS table_name, 'BNFNAR' AS field_name, 'Field Narrative for Cable Message in SPEEDLINK' AS description, 'Length check (String &lt;=29)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(BNFNAR) &gt; 29 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_BAOMGTP
    UNION ALL
    SELECT 'HUB_MT_BAOMGTP' AS table_name, 'BNTX67' AS field_name, 'Message text' AS description, 'Length check (String &lt;=67)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(BNTX67) &gt; 67 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_BAOMGTP
    UNION ALL
    SELECT 'HUB_MT_BAPTACP' AS table_name, 'BKCTCD' AS field_name, 'Country Code' AS description, 'Length check (String &lt;=2)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(BKCTCD) &gt; 2 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_BAPTACP
    UNION ALL
    SELECT 'HUB_MT_BAPTACP' AS table_name, 'BKGMAB' AS field_name, 'Group Member Abbreviation' AS description, 'Length check (String &lt;=4)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(BKGMAB) &gt; 4 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_BAPTACP
    UNION ALL
    SELECT 'HUB_MT_BAPTACP' AS table_name, 'BKPTRF' AS field_name, 'Preferential Tariff' AS description, 'Length check (String &lt;=2)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(BKPTRF) &gt; 2 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_BAPTACP
    UNION ALL
    SELECT 'HUB_MT_BAPTACP' AS table_name, 'BKAPTY' AS field_name, 'Account/Product Type' AS description, 'Length check (String &lt;=3)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(BKAPTY) &gt; 3 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_BAPTACP
    UNION ALL
    SELECT 'HUB_MT_BAPTACP' AS table_name, 'BKEBSM' AS field_name, 'EBS Processing Method' AS description, 'Length check (String &lt;=2)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(BKEBSM) &gt; 2 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_BAPTACP
    UNION ALL
    SELECT 'HUB_MT_BAPTACP' AS table_name, 'BKTRTP' AS field_name, 'Transaction Type' AS description, 'Length check (String &lt;=2)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(BKTRTP) &gt; 2 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_BAPTACP
    UNION ALL
    SELECT 'HUB_MT_BAPTACP' AS table_name, 'BKCYCD' AS field_name, 'Currency' AS description, 'Length check (String &lt;=3)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(BKCYCD) &gt; 3 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_BAPTACP
    UNION ALL
    SELECT 'HUB_MT_BAPTACP' AS table_name, 'BKCHTP' AS field_name, 'Charge Type' AS description, 'Length check (String &lt;=1)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(BKCHTP) &gt; 1 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_BAPTACP
    UNION ALL
    SELECT 'HUB_MT_BAPTACP' AS table_name, 'BKDLUP' AS field_name, 'Last Update Date' AS description, 'Date check - format (YYYYMMDD) + future date' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN (BKDLUP NOT IN ('0', '99999999') AND VALIDATE_CONVERSION(BKDLUP AS DATE,'YYYYMMDD') = 0) OR (BKDLUP NOT IN ('0', '99999999') AND TO_DATE(BKDLUP,'YYYYMMDD') &gt; (SELECT cut_off FROM migration_date)) THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_BAPTACP
    UNION ALL
    SELECT 'HUB_MT_BAPTACP' AS table_name, 'BKTLUP' AS field_name, 'Time Last Updated' AS description, 'Range check (Integer &lt;=6d)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ABS(BKTLUP) &gt; 999999 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_BAPTACP
)
WHERE invalid_count &gt; 0
ORDER BY table_name, field_name, check_type;</property>
