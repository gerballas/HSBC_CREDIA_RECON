                      expressionType="Notify"
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">-- ====================================================================
-- Field Validation: ME01_VAL_TD
-- Scope: ME01 HUB Core Banking — Term Deposits
-- Schema: DATACUT35
-- Based on DD v1.17 + DC35 Oracle Metadata
-- Date format: len=8/9 -&gt; YYYYMMDD | len=10 -&gt; YYYY-MM-DD
-- Sentinel values '0' and '99999999' treated as valid
-- NULL values treated as acceptable
-- Only rows with invalid_count &gt; 0 are returned
-- ====================================================================
-- ** SET MIGRATION CUT-OFF DATE HERE **
WITH migration_date AS (
    SELECT 
        TO_DATE('20260615', 'YYYYMMDD') AS cut_off,
        TO_DATE('20260615', 'YYYYMMDD') AS cut_off_iso
    FROM DUAL
)
SELECT CAST('ME01_VAL_TD_' || TO_CHAR(ROW_NUMBER() OVER (ORDER BY table_name, field_name, check_type), 'FM0000') AS VARCHAR2(50)) AS check_id,
    table_name, field_name, description, check_type,
    total_records, total_records - invalid_count AS valid_count, invalid_count,
    'DC3' AS DC_Version,
    SYSDATE AS Run_Timestamp
FROM (
    SELECT 'HUB_MT_TDACMSP' AS table_name, 'TDMDFL' AS field_name, 'Mode Flag' AS description, 'Length check (String &lt;=1)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(TDMDFL) &gt; 1 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_TDACMSP
    UNION ALL
    SELECT 'HUB_MT_TDACMSP' AS table_name, 'TDRRN#' AS field_name, 'Relative Record Number' AS description, 'Range check (Integer &lt;=13d)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ABS("TDRRN#") &gt; 9999999999999 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_TDACMSP
    UNION ALL
    SELECT 'HUB_MT_TDACMSP' AS table_name, 'TDCTCD' AS field_name, 'Country Code' AS description, 'Length check (String &lt;=2)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(TDCTCD) &gt; 2 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_TDACMSP
    UNION ALL
    SELECT 'HUB_MT_TDACMSP' AS table_name, 'TDGMAB' AS field_name, 'Group Member Abbreviation' AS description, 'Length check (String &lt;=4)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(TDGMAB) &gt; 4 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_TDACMSP
    UNION ALL
    SELECT 'HUB_MT_TDACMSP' AS table_name, 'TDACB' AS field_name, 'Account Branch' AS description, 'Range check (Integer &lt;=3d)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ABS(TDACB) &gt; 999 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_TDACMSP
    UNION ALL
    SELECT 'HUB_MT_TDACMSP' AS table_name, 'TDACS' AS field_name, 'Account Number Serial' AS description, 'Range check (Integer &lt;=6d)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ABS(TDACS) &gt; 999999 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_TDACMSP
    UNION ALL
    SELECT 'HUB_MT_TDACMSP' AS table_name, 'TDACX' AS field_name, 'Account Suffix' AS description, 'Range check (Integer &lt;=3d)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ABS(TDACX) &gt; 999 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_TDACMSP
    UNION ALL
    SELECT 'HUB_MT_TDACMSP' AS table_name, 'TDAPTY' AS field_name, 'Account/Product Type' AS description, 'Length check (String &lt;=3)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(TDAPTY) &gt; 3 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_TDACMSP
    UNION ALL
    SELECT 'HUB_MT_TDACMSP' AS table_name, 'TDFAPT' AS field_name, 'The Product Type that can be changed to other' AS description, 'Length check (String &lt;=3)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(TDFAPT) &gt; 3 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_TDACMSP
    UNION ALL
    SELECT 'HUB_MT_TDACMSP' AS table_name, 'TDCYCD' AS field_name, 'Currency' AS description, 'Length check (String &lt;=3)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(TDCYCD) &gt; 3 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_TDACMSP
    UNION ALL
    SELECT 'HUB_MT_TDACMSP' AS table_name, 'TDDCG' AS field_name, 'Domestic Customer Group Member' AS description, 'Length check (String &lt;=4)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(TDDCG) &gt; 4 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_TDACMSP
    UNION ALL
    SELECT 'HUB_MT_TDACMSP' AS table_name, 'TDDCB' AS field_name, 'Customer Branch Number' AS description, 'Range check (Integer &lt;=3d)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ABS(TDDCB) &gt; 999 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_TDACMSP
    UNION ALL
    SELECT 'HUB_MT_TDACMSP' AS table_name, 'TDDCS' AS field_name, 'Customer Serial Number' AS description, 'Range check (Integer &lt;=6d)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ABS(TDDCS) &gt; 999999 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_TDACMSP
    UNION ALL
    SELECT 'HUB_MT_TDACMSP' AS table_name, 'TDEBAI' AS field_name, 'Electronic Banking Account No ***' AS description, 'Length check (String &lt;=4)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(TDEBAI) &gt; 4 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_TDACMSP
    UNION ALL
    SELECT 'HUB_MT_TDACMSP' AS table_name, 'TDACSN' AS field_name, 'A/C Short Name' AS description, 'Length check (String &lt;=28)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(TDACSN) &gt; 28 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_TDACMSP
    UNION ALL
    SELECT 'HUB_MT_TDACMSP' AS table_name, 'TDAC2N' AS field_name, '2nd Language Account Short Name' AS description, 'Length check (String &lt;=28)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(TDAC2N) &gt; 28 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_TDACMSP
    UNION ALL
    SELECT 'HUB_MT_TDACMSP' AS table_name, 'TDRSTR' AS field_name, 'Restriction' AS description, 'Length check (String &lt;=1)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(TDRSTR) &gt; 1 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_TDACMSP
    UNION ALL
    SELECT 'HUB_MT_TDACMSP' AS table_name, 'TDSTUS' AS field_name, 'Status ***' AS description, 'Length check (String &lt;=1)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(TDSTUS) &gt; 1 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_TDACMSP
    UNION ALL
    SELECT 'HUB_MT_TDACMSP' AS table_name, 'TDCBST' AS field_name, 'Statutory A/C Status' AS description, 'Length check (String &lt;=1)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(TDCBST) &gt; 1 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_TDACMSP
    UNION ALL
    SELECT 'HUB_MT_TDACMSP' AS table_name, 'TDGHCL' AS field_name, 'GHO Customer Classification' AS description, 'Length check (String &lt;=3)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(TDGHCL) &gt; 3 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_TDACMSP
    UNION ALL
    SELECT 'HUB_MT_TDACMSP' AS table_name, 'TDCRGR' AS field_name, 'Credit Grade' AS description, 'Length check (String &lt;=1)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(TDCRGR) &gt; 1 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_TDACMSP
    UNION ALL
    SELECT 'HUB_MT_TDACMSP' AS table_name, 'TDCTRS' AS field_name, 'Country of Registration/Residence' AS description, 'Length check (String &lt;=2)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(TDCTRS) &gt; 2 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_TDACMSP
    UNION ALL
    SELECT 'HUB_MT_TDACMSP' AS table_name, 'TDNATY' AS field_name, 'Nationality Code' AS description, 'Length check (String &lt;=2)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(TDNATY) &gt; 2 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_TDACMSP
    UNION ALL
    SELECT 'HUB_MT_TDACMSP' AS table_name, 'TDGMCI' AS field_name, 'GIMIS Customer Indicator' AS description, 'Length check (String &lt;=1)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(TDGMCI) &gt; 1 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_TDACMSP
    UNION ALL
    SELECT 'HUB_MT_TDACMSP' AS table_name, 'TDADRQ' AS field_name, 'Advice Required Code' AS description, 'Length check (String &lt;=1)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(TDADRQ) &gt; 1 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_TDACMSP
    UNION ALL
    SELECT 'HUB_MT_TDACMSP' AS table_name, 'TDLANG' AS field_name, 'Language Code' AS description, 'Length check (String &lt;=1)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(TDLANG) &gt; 1 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_TDACMSP
    UNION ALL
    SELECT 'HUB_MT_TDACMSP' AS table_name, 'TDDPCD' AS field_name, 'Despatch Code' AS description, 'Length check (String &lt;=1)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(TDDPCD) &gt; 1 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_TDACMSP
    UNION ALL
    SELECT 'HUB_MT_TDACMSP' AS table_name, 'TDCBBK' AS field_name, 'Correspondent Bank ID' AS description, 'Length check (String &lt;=4)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(TDCBBK) &gt; 4 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_TDACMSP
    UNION ALL
    SELECT 'HUB_MT_TDACMSP' AS table_name, 'TDCBBH' AS field_name, 'Correspondent Branch ID' AS description, 'Length check (String &lt;=4)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(TDCBBH) &gt; 4 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_TDACMSP
    UNION ALL
    SELECT 'HUB_MT_TDACMSP' AS table_name, 'TDDTAO' AS field_name, 'Date A/C Opened ***' AS description, 'Date check - format (YYYYMMDD) + future date' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN (TDDTAO NOT IN ('0', '99999999') AND VALIDATE_CONVERSION(TDDTAO AS DATE,'YYYYMMDD') = 0) OR (TDDTAO NOT IN ('0', '99999999') AND TO_DATE(TDDTAO,'YYYYMMDD') &gt; (SELECT cut_off FROM migration_date)) THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_TDACMSP
    UNION ALL
    SELECT 'HUB_MT_TDACMSP' AS table_name, 'TDDLAT' AS field_name, 'Date Last Active (YYYYMMDD)' AS description, 'Date check - format (YYYYMMDD) + future date' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN (TDDLAT NOT IN ('0', '99999999') AND VALIDATE_CONVERSION(TDDLAT AS DATE,'YYYYMMDD') = 0) OR (TDDLAT NOT IN ('0', '99999999') AND TO_DATE(TDDLAT,'YYYYMMDD') &gt; (SELECT cut_off FROM migration_date)) THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_TDACMSP
    UNION ALL
    SELECT 'HUB_MT_TDACMSP' AS table_name, 'TDCBCL' AS field_name, 'Central Bank A/C Classification' AS description, 'Length check (String &lt;=3)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(TDCBCL) &gt; 3 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_TDACMSP
    UNION ALL
