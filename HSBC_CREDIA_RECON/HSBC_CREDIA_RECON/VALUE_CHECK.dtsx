    UNION ALL
    SELECT 'HUB_MT_SSCTXPP' AS table_name, 'CTEHRF' AS field_name, 'Enhanced Review Flag' AS description, 'Length check (String &lt;=10)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(CTEHRF) &gt; 10 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_SSCTXPP
