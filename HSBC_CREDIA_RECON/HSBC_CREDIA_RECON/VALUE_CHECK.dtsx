    UNION ALL
    SELECT 'HUB_MT_SSCLMTP' AS table_name, 'ZFFCCC' AS field_name, 'Facility Category Code' AS description, 'Length check (String &lt;=1)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(ZFFCCC) &gt; 1 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_SSCLMTP
    UNION ALL
    SELECT 'HUB_MT_SSCLMTP' AS table_name, 'ZFGAVP' AS field_name, 'Advance Purpose Code ***' AS description, 'Length check (String &lt;=3)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(ZFGAVP) &gt; 3 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_SSCLMTP
    UNION ALL
    SELECT 'HUB_MT_SSCLMTP' AS table_name, 'ZFFRDT' AS field_name, 'Facility Review Date' AS description, 'Date check - format (YYYYMMDD)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ZFFRDT NOT IN ('0', '99999999') AND VALIDATE_CONVERSION(ZFFRDT AS DATE,'YYYYMMDD') = 0 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_SSCLMTP
    UNION ALL
    SELECT 'HUB_MT_SSCLMTP' AS table_name, 'ZFLFRD' AS field_name, 'Last Facility Review Date' AS description, 'Date check - format (YYYYMMDD) + future date' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN (ZFLFRD NOT IN ('0', '99999999') AND VALIDATE_CONVERSION(ZFLFRD AS DATE,'YYYYMMDD') = 0) OR (ZFLFRD NOT IN ('0', '99999999') AND TO_DATE(ZFLFRD,'YYYYMMDD') &gt; (SELECT cut_off FROM migration_date)) THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_SSCLMTP
    UNION ALL
    SELECT 'HUB_MT_SSCLMTP' AS table_name, 'ZFFMB' AS field_name, 'Facility Monitoring Branch' AS description, 'Range check (Integer &lt;=3d)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ABS(ZFFMB) &gt; 999 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_SSCLMTP
    UNION ALL
    SELECT 'HUB_MT_SSCLMTP' AS table_name, 'ZFCRPC' AS field_name, 'Cash Risk Percentage' AS description, 'Range check (Integer &lt;=3d)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ABS(ZFCRPC) &gt; 999 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_SSCLMTP
    UNION ALL
    SELECT 'HUB_MT_SSCLMTP' AS table_name, 'ZFFCPC' AS field_name, 'Total Facility Contribution Percentage' AS description, 'Range check (Integer &lt;=3d)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ABS(ZFFCPC) &gt; 999 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_SSCLMTP
    UNION ALL
    SELECT 'HUB_MT_SSCLMTP' AS table_name, 'ZFCSHI' AS field_name, 'Update Cash Limit Indicator' AS description, 'Length check (String &lt;=1)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(ZFCSHI) &gt; 1 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_SSCLMTP
    UNION ALL
    SELECT 'HUB_MT_SSCLMTP' AS table_name, 'ZFFNDI' AS field_name, 'Fund Advances' AS description, 'Length check (String &lt;=1)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(ZFFNDI) &gt; 1 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_SSCLMTP
    UNION ALL
    SELECT 'HUB_MT_SSCLMTP' AS table_name, 'ZFCNLM' AS field_name, 'Controlling Limit Type ***' AS description, 'Length check (String &lt;=3)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN LENGTH(ZFCNLM) &gt; 3 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35.HUB_MT_SSCLMTP
