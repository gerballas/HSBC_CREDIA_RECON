    SELECT 'HUB_MT_LS@RPACP' AS table_name, 'PQHDAM' AS field_name, 'HOLD AMOUNT' AS description, 'Range check (Integer &lt;=13d)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ABS(PQHDAM) &gt; 9999999999999 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35."HUB_MT_LS@RPACP"
    UNION ALL
    SELECT 'HUB_MT_LS@RPACP' AS table_name, 'PQDLUP' AS field_name, 'LAST UPDATE DATE' AS description, 'Date check - format (YYYYMMDD) + future date' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN (PQDLUP NOT IN ('0', '99999999') AND VALIDATE_CONVERSION(PQDLUP AS DATE,'YYYYMMDD') = 0) OR (PQDLUP NOT IN ('0', '99999999') AND TO_DATE(PQDLUP,'YYYYMMDD') &gt; (SELECT cut_off FROM migration_date)) THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35."HUB_MT_LS@RPACP"
    UNION ALL
    SELECT 'HUB_MT_LS@RPACP' AS table_name, 'PQTLUP' AS field_name, 'TIME LAST UPDATED' AS description, 'Range check (Integer &lt;=6d)' AS check_type, COUNT(*) AS total_records, SUM(CASE WHEN ABS(PQTLUP) &gt; 999999 THEN 1 ELSE 0 END) AS invalid_count FROM DATACUT35."HUB_MT_LS@RPACP"
)
WHERE invalid_count &gt; 0
ORDER BY table_name, field_name, check_type;</property>
