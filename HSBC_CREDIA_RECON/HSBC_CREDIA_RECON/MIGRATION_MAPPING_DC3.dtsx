      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{6821A5EC-D23A-4EAE-A8D7-C1BFCD7DE798}"
          SQLTask:SqlStatementSource="IF EXISTS (SELECT 1 FROM sys.tables WHERE name = 'MIGRATION_MAPPING_DC3' AND schema_id = SCHEMA_ID('RECON'))&#xA;&#xA;BEGIN&#xA;    EXEC('TRUNCATE TABLE RECON.MIGRATION_MAPPING_DC3');&#xA;END&#xA;&#xA;IF NOT EXISTS (SELECT 1 FROM sys.tables WHERE name = 'MIGRATION_MAPPING_DC3' AND schema_id = SCHEMA_ID('RECON'))&#xA;BEGIN&#xA;    CREATE TABLE RECON.MIGRATION_MAPPING_DC3 (&#xA;        ID              INT IDENTITY(1,1) PRIMARY KEY,&#xA;        MAPPING_FIELD   NVARCHAR(100)   NULL,&#xA;        HUB_VALUE       NVARCHAR(100)   NULL,&#xA;        PROFITS_VALUE   NVARCHAR(100)   NULL&#xA;    );&#xA;END" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
