                      <externalMetadataColumns />
                    </output>
                  </outputs>
                </component>
                <component
                  refId="Package\DQC_DC5\ME01_HUB_DQC\ME01_HUB_DQC"
                  componentClassID="Microsoft.SSISOracleSrc"
                  contactInfo="Oracle Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;1"
                  description="Oracle Source"
                  name="ME01_HUB_DQC"
                  usesDispositions="true"
                  version="1">
                  <properties>
                    <property
                      dataType="System.String"
                      description="The name of the table to be fetched."
                      expressionType="Notify"
                      name="TableName"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      expressionType="Notify"
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">WITH
  -- Ημερομηνία αναφοράς για τους ελέγχους "στο μέλλον" / ηλικίας. Για αναπαραγώγιμα αποτελέσματα βάλε την ημερομηνία του Data Cut.
  params AS (SELECT TO_NUMBER(TO_CHAR(TRUNC(SYSDATE), 'YYYYMMDD')) AS ref_num FROM dual),
  -- Κοινές λίστες: υπολογίζονται ΜΙΑ φορά και τις χρησιμοποιούν όλοι οι έλεγχοι διασύνδεσης.
  -- κωδικοί χωρών (SSSTDPP CT)
  ref_ct AS (
    SELECT /*+ MATERIALIZE */ DISTINCT TRIM("YHCODE") AS code FROM DATACUT5."HUB_MT_SSSTDPP" WHERE TRIM("YHTBID") = 'CT'
  ),
  -- legal types (SSSTDPP LE)
  ref_le AS (
    SELECT /*+ MATERIALIZE */ DISTINCT (CASE WHEN VALIDATE_CONVERSION(TRIM("YHCODE") AS NUMBER) = 1 THEN TO_NUMBER(TRIM("YHCODE")) END) AS n FROM DATACUT5."HUB_MT_SSSTDPP" WHERE TRIM("YHTBID") = 'LE'
  ),
  -- industry codes (SSSTDPP IY)
  ref_iy AS (
    SELECT /*+ MATERIALIZE */ DISTINCT (CASE WHEN VALIDATE_CONVERSION(TRIM("YHCODE") AS NUMBER) = 1 THEN TO_NUMBER(TRIM("YHCODE")) END) AS n FROM DATACUT5."HUB_MT_SSSTDPP" WHERE TRIM("YHTBID") = 'IY'
  ),
  -- πελάτες SSCUSTP
  k_cus AS (
    SELECT /*+ MATERIALIZE */ DISTINCT (CASE WHEN VALIDATE_CONVERSION(TRIM("ZGDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM("ZGDCB")) END) AS dcb, (CASE WHEN VALIDATE_CONVERSION(TRIM("ZGDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM("ZGDCS")) END) AS dcs FROM DATACUT5."HUB_MT_SSCUSTP" WHERE NVL("ZGMDFL",' ') &lt;&gt; 'S'
  ),
  -- πελάτες με εγγραφή SSINCIP
  k_ind AS (
    SELECT /*+ MATERIALIZE */ DISTINCT (CASE WHEN VALIDATE_CONVERSION(TRIM("ZKDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM("ZKDCB")) END) AS dcb, (CASE WHEN VALIDATE_CONVERSION(TRIM("ZKDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM("ZKDCS")) END) AS dcs FROM DATACUT5."HUB_MT_SSINCIP" WHERE NVL("ZKMDFL",' ') &lt;&gt; 'S'
  ),
  -- πελάτες με εγγραφή SSNICIP
  k_nic AS (
    SELECT /*+ MATERIALIZE */ DISTINCT (CASE WHEN VALIDATE_CONVERSION(TRIM("XUDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM("XUDCB")) END) AS dcb, (CASE WHEN VALIDATE_CONVERSION(TRIM("XUDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM("XUDCS")) END) AS dcs FROM DATACUT5."HUB_MT_SSNICIP" WHERE NVL("XUMDFL",' ') &lt;&gt; 'S'
  ),
  -- πελάτες με διεύθυνση SSADDRP
  k_adr AS (
    SELECT /*+ MATERIALIZE */ DISTINCT (CASE WHEN VALIDATE_CONVERSION(TRIM("ZBDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM("ZBDCB")) END) AS dcb, (CASE WHEN VALIDATE_CONVERSION(TRIM("ZBDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM("ZBDCS")) END) AS dcs FROM DATACUT5."HUB_MT_SSADDRP" WHERE NVL("ZBMDFL",' ') &lt;&gt; 'S'
  ),
  -- διευθύνσεις ανά πελάτη και Address ID
  k_adr_id AS (
    SELECT /*+ MATERIALIZE */ DISTINCT (CASE WHEN VALIDATE_CONVERSION(TRIM("ZBDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM("ZBDCB")) END) AS dcb, (CASE WHEN VALIDATE_CONVERSION(TRIM("ZBDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM("ZBDCS")) END) AS dcs, TRIM("ZBADID") AS adid FROM DATACUT5."HUB_MT_SSADDRP" WHERE NVL("ZBMDFL",' ') &lt;&gt; 'S'
  ),
  -- πελάτες με μη κλειστό λογαριασμό DD/LS/TD
  k_open AS (
    SELECT /*+ MATERIALIZE */ (CASE WHEN VALIDATE_CONVERSION(TRIM("DFDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM("DFDCB")) END) AS dcb, (CASE WHEN VALIDATE_CONVERSION(TRIM("DFDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM("DFDCS")) END) AS dcs FROM DATACUT5."HUB_MT_DDACMSP" WHERE NVL("DFMDFL",' ') &lt;&gt; 'S' AND NVL(TRIM("DFSTUS"),'#') &lt;&gt; '5'
      UNION SELECT (CASE WHEN VALIDATE_CONVERSION(TRIM("PODCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM("PODCB")) END), (CASE WHEN VALIDATE_CONVERSION(TRIM("PODCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM("PODCS")) END) FROM DATACUT5."HUB_MT_LSACMSP" WHERE NVL("POMDFL",' ') &lt;&gt; 'S' AND NVL(TRIM("POSTUS"),'#') &lt;&gt; '5'
      UNION SELECT (CASE WHEN VALIDATE_CONVERSION(TRIM("TDDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM("TDDCB")) END), (CASE WHEN VALIDATE_CONVERSION(TRIM("TDDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM("TDDCS")) END) FROM DATACUT5."HUB_MT_TDACMSP" WHERE NVL("TDMDFL",' ') &lt;&gt; 'S' AND NVL(TRIM("TDSTUS"),'#') &lt;&gt; '5'
  ),
  -- λογαριασμοί DDACMSP
  k_acc_DDACMSP AS (
    SELECT /*+ MATERIALIZE */ DISTINCT (CASE WHEN VALIDATE_CONVERSION(TRIM("DFACB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM("DFACB")) END) AS k1, (CASE WHEN VALIDATE_CONVERSION(TRIM("DFACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM("DFACS")) END) AS k2, (CASE WHEN VALIDATE_CONVERSION(TRIM("DFACX") AS NUMBER) = 1 THEN TO_NUMBER(TRIM("DFACX")) END) AS k3 FROM DATACUT5."HUB_MT_DDACMSP" WHERE NVL("DFMDFL",' ') &lt;&gt; 'S'
  ),
  -- λογαριασμοί LSACMSP
  k_acc_LSACMSP AS (
    SELECT /*+ MATERIALIZE */ DISTINCT (CASE WHEN VALIDATE_CONVERSION(TRIM("POACB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM("POACB")) END) AS k1, (CASE WHEN VALIDATE_CONVERSION(TRIM("POACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM("POACS")) END) AS k2, (CASE WHEN VALIDATE_CONVERSION(TRIM("POACX") AS NUMBER) = 1 THEN TO_NUMBER(TRIM("POACX")) END) AS k3 FROM DATACUT5."HUB_MT_LSACMSP" WHERE NVL("POMDFL",' ') &lt;&gt; 'S'
  ),
  -- λογαριασμοί TDACMSP
  k_acc_TDACMSP AS (
    SELECT /*+ MATERIALIZE */ DISTINCT (CASE WHEN VALIDATE_CONVERSION(TRIM("TDACB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM("TDACB")) END) AS k1, (CASE WHEN VALIDATE_CONVERSION(TRIM("TDACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM("TDACS")) END) AS k2, (CASE WHEN VALIDATE_CONVERSION(TRIM("TDACX") AS NUMBER) = 1 THEN TO_NUMBER(TRIM("TDACX")) END) AS k3 FROM DATACUT5."HUB_MT_TDACMSP" WHERE NVL("TDMDFL",' ') &lt;&gt; 'S'
  ),
  -- υπόλοιπο ανά λογαριασμό DDACMSP
  k_dd_bal AS (
    SELECT /*+ MATERIALIZE */ (CASE WHEN VALIDATE_CONVERSION(TRIM("DFACB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM("DFACB")) END) AS k1, (CASE WHEN VALIDATE_CONVERSION(TRIM("DFACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM("DFACS")) END) AS k2, (CASE WHEN VALIDATE_CONVERSION(TRIM("DFACX") AS NUMBER) = 1 THEN TO_NUMBER(TRIM("DFACX")) END) AS k3, MAX((CASE WHEN VALIDATE_CONVERSION(TRIM("DFRLBL") AS NUMBER) = 1 THEN TO_NUMBER(TRIM("DFRLBL")) END)) AS bal FROM DATACUT5."HUB_MT_DDACMSP" WHERE NVL("DFMDFL",' ') &lt;&gt; 'S' GROUP BY (CASE WHEN VALIDATE_CONVERSION(TRIM("DFACB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM("DFACB")) END), (CASE WHEN VALIDATE_CONVERSION(TRIM("DFACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM("DFACS")) END), (CASE WHEN VALIDATE_CONVERSION(TRIM("DFACX") AS NUMBER) = 1 THEN TO_NUMBER(TRIM("DFACX")) END)
  ),
  -- Επιπλέον κοινές λίστες των ελέγχων DC5 (DD v1.24)
  -- λογαριασμοί όλων των account masters (DD/LS/TD/PL/DC/IE/GL ACMSP)
  k_acc AS (
    SELECT /*+ MATERIALIZE */ (CASE WHEN VALIDATE_CONVERSION(TRIM("DFACB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM("DFACB")) END) AS k1, (CASE WHEN VALIDATE_CONVERSION(TRIM("DFACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM("DFACS")) END) AS k2, (CASE WHEN VALIDATE_CONVERSION(TRIM("DFACX") AS NUMBER) = 1 THEN TO_NUMBER(TRIM("DFACX")) END) AS k3 FROM DATACUT5."HUB_MT_DDACMSP" WHERE NVL("DFMDFL",' ') &lt;&gt; 'S'
    UNION SELECT (CASE WHEN VALIDATE_CONVERSION(TRIM("POACB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM("POACB")) END) AS k1, (CASE WHEN VALIDATE_CONVERSION(TRIM("POACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM("POACS")) END) AS k2, (CASE WHEN VALIDATE_CONVERSION(TRIM("POACX") AS NUMBER) = 1 THEN TO_NUMBER(TRIM("POACX")) END) AS k3 FROM DATACUT5."HUB_MT_LSACMSP" WHERE NVL("POMDFL",' ') &lt;&gt; 'S'
    UNION SELECT (CASE WHEN VALIDATE_CONVERSION(TRIM("TDACB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM("TDACB")) END) AS k1, (CASE WHEN VALIDATE_CONVERSION(TRIM("TDACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM("TDACS")) END) AS k2, (CASE WHEN VALIDATE_CONVERSION(TRIM("TDACX") AS NUMBER) = 1 THEN TO_NUMBER(TRIM("TDACX")) END) AS k3 FROM DATACUT5."HUB_MT_TDACMSP" WHERE NVL("TDMDFL",' ') &lt;&gt; 'S'
    UNION SELECT (CASE WHEN VALIDATE_CONVERSION(TRIM("PFACB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM("PFACB")) END) AS k1, (CASE WHEN VALIDATE_CONVERSION(TRIM("PFACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM("PFACS")) END) AS k2, (CASE WHEN VALIDATE_CONVERSION(TRIM("PFACX") AS NUMBER) = 1 THEN TO_NUMBER(TRIM("PFACX")) END) AS k3 FROM DATACUT5."HUB_MT_PLACMSP" WHERE NVL("PFMDFL",' ') &lt;&gt; 'S'
    UNION SELECT (CASE WHEN VALIDATE_CONVERSION(TRIM("D1ACB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM("D1ACB")) END) AS k1, (CASE WHEN VALIDATE_CONVERSION(TRIM("D1ACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM("D1ACS")) END) AS k2, (CASE WHEN VALIDATE_CONVERSION(TRIM("D1ACX") AS NUMBER) = 1 THEN TO_NUMBER(TRIM("D1ACX")) END) AS k3 FROM DATACUT5."HUB_MT_DCACMSP" WHERE NVL("D1MDFL",' ') &lt;&gt; 'S'
    UNION SELECT (CASE WHEN VALIDATE_CONVERSION(TRIM("KEACB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM("KEACB")) END) AS k1, (CASE WHEN VALIDATE_CONVERSION(TRIM("KEACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM("KEACS")) END) AS k2, (CASE WHEN VALIDATE_CONVERSION(TRIM("KEACX") AS NUMBER) = 1 THEN TO_NUMBER(TRIM("KEACX")) END) AS k3 FROM DATACUT5."HUB_MT_IEACMSP" WHERE NVL("KEMDFL",' ') &lt;&gt; 'S'
    UNION SELECT (CASE WHEN VALIDATE_CONVERSION(TRIM("GEACB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM("GEACB")) END) AS k1, (CASE WHEN VALIDATE_CONVERSION(TRIM("GEACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM("GEACS")) END) AS k2, (CASE WHEN VALIDATE_CONVERSION(TRIM("GEACX") AS NUMBER) = 1 THEN TO_NUMBER(TRIM("GEACX")) END) AS k3 FROM DATACUT5."HUB_MT_GLACMSP" WHERE NVL("GEMDFL",' ') &lt;&gt; 'S'
  ),
  -- λογαριασμοί DDACMSP
  k_acc_dd AS (
    SELECT /*+ MATERIALIZE */ DISTINCT (CASE WHEN VALIDATE_CONVERSION(TRIM("DFACB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM("DFACB")) END) AS k1, (CASE WHEN VALIDATE_CONVERSION(TRIM("DFACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM("DFACS")) END) AS k2, (CASE WHEN VALIDATE_CONVERSION(TRIM("DFACX") AS NUMBER) = 1 THEN TO_NUMBER(TRIM("DFACX")) END) AS k3 FROM DATACUT5."HUB_MT_DDACMSP" WHERE NVL("DFMDFL",' ') &lt;&gt; 'S'
  ),
  -- τύποι προϊόντων όλων των PDCPP (DD/TD/LS/LS@/PL/DC)
  ref_apty AS (
    SELECT /*+ MATERIALIZE */ TRIM("DAAPTY") AS code FROM DATACUT5."HUB_MT_DDPDCPP" WHERE NVL("DAMDFL",' ') &lt;&gt; 'S'
    UNION SELECT TRIM("TAAPTY") AS code FROM DATACUT5."HUB_MT_TDPDCPP" WHERE NVL("TAMDFL",' ') &lt;&gt; 'S'
    UNION SELECT TRIM("QCAPTY") AS code FROM DATACUT5."HUB_MT_LSPDCPP" WHERE NVL("QCMDFL",' ') &lt;&gt; 'S'
    UNION SELECT TRIM("QCAPTY") AS code FROM DATACUT5."HUB_MT_LS@PDCPP" WHERE NVL("QCMDFL",' ') &lt;&gt; 'S'
    UNION SELECT TRIM("PAAPTY") AS code FROM DATACUT5."HUB_MT_PLPDCPP" WHERE NVL("PAMDFL",' ') &lt;&gt; 'S'
    UNION SELECT TRIM("D4APTY") AS code FROM DATACUT5."HUB_MT_DCPDCPP" WHERE NVL("D4MDFL",' ') &lt;&gt; 'S'
  ),
  -- κωδικοί SSSTDPP B9 (customer code), χωρίς μηδενικά μπροστά
  ref_std_b9 AS (
    SELECT /*+ MATERIALIZE */ DISTINCT NVL(LTRIM(TRIM("YHCODE"), '0'), '0') AS code FROM DATACUT5."HUB_MT_SSSTDPP" WHERE TRIM("YHTBID") = 'B9'
  ),
  -- κωδικοί SSSTDPP CT (country code), χωρίς μηδενικά μπροστά
  ref_std_ct AS (
    SELECT /*+ MATERIALIZE */ DISTINCT NVL(LTRIM(TRIM("YHCODE"), '0'), '0') AS code FROM DATACUT5."HUB_MT_SSSTDPP" WHERE TRIM("YHTBID") = 'CT'
  ),
  -- κωδικοί SSSTDPP IY (industry code), χωρίς μηδενικά μπροστά
  ref_std_iy AS (
    SELECT /*+ MATERIALIZE */ DISTINCT NVL(LTRIM(TRIM("YHCODE"), '0'), '0') AS code FROM DATACUT5."HUB_MT_SSSTDPP" WHERE TRIM("YHTBID") = 'IY'
  ),
  -- κωδικοί SSSTDPP MS (market sector), χωρίς μηδενικά μπροστά
  ref_std_ms AS (
    SELECT /*+ MATERIALIZE */ DISTINCT NVL(LTRIM(TRIM("YHCODE"), '0'), '0') AS code FROM DATACUT5."HUB_MT_SSSTDPP" WHERE TRIM("YHTBID") = 'MS'
  ),
  -- κωδικοί SSSTDPP OC (occupation code), χωρίς μηδενικά μπροστά
  ref_std_oc AS (
    SELECT /*+ MATERIALIZE */ DISTINCT NVL(LTRIM(TRIM("YHCODE"), '0'), '0') AS code FROM DATACUT5."HUB_MT_SSSTDPP" WHERE TRIM("YHTBID") = 'OC'
  ),
  -- GHO κατηγορίες SSGHCLP
  k_ghcl AS (
    SELECT /*+ MATERIALIZE */ DISTINCT TRIM("VQGHCL") AS code FROM DATACUT5."HUB_MT_SSGHCLP" WHERE NVL("VQMDFL",' ') &lt;&gt; 'S'
  ),
  -- phone banking numbers EBCUSTP
  k_pbn AS (
    SELECT /*+ MATERIALIZE */ DISTINCT (CASE WHEN VALIDATE_CONVERSION(TRIM("PCPBN") AS NUMBER) = 1 THEN TO_NUMBER(TRIM("PCPBN")) END) AS pbn FROM DATACUT5."HUB_MT_EBCUSTP" WHERE NVL("PCMDFL",' ') &lt;&gt; 'S'
  ),
  -- καταστήματα SSBRCPP
  k_brn AS (
    SELECT /*+ MATERIALIZE */ DISTINCT (CASE WHEN VALIDATE_CONVERSION(TRIM("XIBRNO") AS NUMBER) = 1 THEN TO_NUMBER(TRIM("XIBRNO")) END) AS brn FROM DATACUT5."HUB_MT_SSBRCPP" WHERE NVL("XIMDFL",' ') &lt;&gt; 'S'
  ),
  all_checks AS (
/* ######################## DC4 V3 ελέγχοι (DD v1.22) ######################## */
/* =============================================================================
   AFSIADP - S/I Asso Party Non-Cust Name/Add File
   Πίνακας: DATACUT5."HUB_MT_AFSIADP"   Shadow: FRMDFL = 'S' (εξαιρούνται)   Έλεγχοι: 1
   ============================================================================= */
    SELECT 'AFSIADP - S/I Asso Party Non-Cust Name/Add File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- AFSIADP-001: Invalid date: Last Update Date (FRDLUP)
          COUNT(CASE WHEN NVL(t."FRMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t1,
          COUNT(CASE WHEN NVL(t."FRMDFL",' ') &lt;&gt; 'S' AND ((NOT (TRIM(t."FRDLUP") IS NULL OR REGEXP_LIKE(TRIM(t."FRDLUP"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."FRDLUP"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."FRDLUP") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."FRDLUP")) END), 0) &lt; 19000101)) THEN 1 END) AS f1
        FROM DATACUT5."HUB_MT_AFSIADP" t
        CROSS JOIN params p
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'AFSIADP-001|Invalid Dates|Invalid date: Last Update Date (FRDLUP)'
      ))
    UNION ALL
/* =============================================================================
   AFSIMSP - S/I Master File
   Πίνακας: DATACUT5."HUB_MT_AFSIMSP"   Shadow: FNMDFL = 'S' (εξαιρούνται)   Έλεγχοι: 2
   ============================================================================= */
    SELECT 'AFSIMSP - S/I Master File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- AFSIMSP-001: Invalid date: Date Last Activity (FNDLAC)
          COUNT(CASE WHEN NVL(t."FNMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t1,
          COUNT(CASE WHEN NVL(t."FNMDFL",' ') &lt;&gt; 'S' AND ((NOT (TRIM(t."FNDLAC") IS NULL OR REGEXP_LIKE(TRIM(t."FNDLAC"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."FNDLAC"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."FNDLAC") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."FNDLAC")) END), 0) &lt; 19000101)) THEN 1 END) AS f1,
          -- AFSIMSP-002: Invalid date: Last Update Date (FNDLUP)
          COUNT(CASE WHEN NVL(t."FNMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t2,
          COUNT(CASE WHEN NVL(t."FNMDFL",' ') &lt;&gt; 'S' AND ((NOT (TRIM(t."FNDLUP") IS NULL OR REGEXP_LIKE(TRIM(t."FNDLUP"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."FNDLUP"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."FNDLUP") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."FNDLUP")) END), 0) &lt; 19000101)) THEN 1 END) AS f2
        FROM DATACUT5."HUB_MT_AFSIMSP" t
        CROSS JOIN params p
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'AFSIMSP-001|Invalid Dates|Invalid date: Date Last Activity (FNDLAC)',
        (t2, f2) AS 'AFSIMSP-002|Invalid Dates|Invalid date: Last Update Date (FNDLUP)'
      ))
    UNION ALL
/* =============================================================================
   AFSIRAP - S/I Retention Amount File
   Πίνακας: DATACUT5."HUB_MT_AFSIRAP"   Shadow: FTMDFL = 'S' (εξαιρούνται)   Έλεγχοι: 1
   ============================================================================= */
    SELECT 'AFSIRAP - S/I Retention Amount File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- AFSIRAP-001: Invalid date: Last Update Date (FTDLUP)
          COUNT(CASE WHEN NVL(t."FTMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t1,
          COUNT(CASE WHEN NVL(t."FTMDFL",' ') &lt;&gt; 'S' AND ((NOT (TRIM(t."FTDLUP") IS NULL OR REGEXP_LIKE(TRIM(t."FTDLUP"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."FTDLUP"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."FTDLUP") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."FTDLUP")) END), 0) &lt; 19000101)) THEN 1 END) AS f1
        FROM DATACUT5."HUB_MT_AFSIRAP" t
        CROSS JOIN params p
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'AFSIRAP-001|Invalid Dates|Invalid date: Last Update Date (FTDLUP)'
      ))
    UNION ALL
/* =============================================================================
   AFSITJP - S/I Transaction Journal
   Πίνακας: DATACUT5."HUB_MT_AFSITJP"   Shadow: δεν υπάρχει mode flag   Έλεγχοι: 1
   ============================================================================= */
    SELECT 'AFSITJP - S/I Transaction Journal' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- AFSITJP-001: Invalid date: Posting Date (F0PSDT)
          COUNT(CASE WHEN 1=1 THEN 1 END) AS t1,
          COUNT(CASE WHEN 1=1 AND ((NOT (TRIM(t."F0PSDT") IS NULL OR REGEXP_LIKE(TRIM(t."F0PSDT"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."F0PSDT"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."F0PSDT") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."F0PSDT")) END), 0) &lt; 19000101)) THEN 1 END) AS f1
        FROM DATACUT5."HUB_MT_AFSITJP" t
        CROSS JOIN params p
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'AFSITJP-001|Invalid Dates|Invalid date: Posting Date (F0PSDT)'
      ))
    UNION ALL
/* =============================================================================
   DCACMSP - Demand Credit Master File
   Πίνακας: DATACUT5."HUB_MT_DCACMSP"   Shadow: D1MDFL = 'S' (εξαιρούνται)   Έλεγχοι: 12
   ============================================================================= */
    SELECT 'DCACMSP - Demand Credit Master File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- DCACMSP-001: Missing customer key (D1DCB/D1DCS)
          COUNT(CASE WHEN NVL(t."D1MDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t1,
          COUNT(CASE WHEN NVL(t."D1MDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."D1DCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."D1DCB")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."D1DCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."D1DCS")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."D1DCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."D1DCS")) END) = 0) THEN 1 END) AS f1,
          -- DCACMSP-002: Missing account key (D1ACB/D1ACS/D1ACX)
          COUNT(CASE WHEN NVL(t."D1MDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t2,
          COUNT(CASE WHEN NVL(t."D1MDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."D1ACB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."D1ACB")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."D1ACB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."D1ACB")) END) = 0 OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."D1ACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."D1ACS")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."D1ACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."D1ACS")) END) = 0 OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."D1ACX") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."D1ACX")) END) IS NULL) THEN 1 END) AS f2,
          -- DCACMSP-003: Invalid Facility Limit Category (D1LMCG), allowed A/B/C/D
          COUNT(CASE WHEN NVL(t."D1MDFL",' ') &lt;&gt; 'S' AND (TRIM(t."D1LMCG") IS NOT NULL) THEN 1 END) AS t3,
          COUNT(CASE WHEN NVL(t."D1MDFL",' ') &lt;&gt; 'S' AND (TRIM(t."D1LMCG") IS NOT NULL) AND (TRIM(t."D1LMCG") NOT IN ('A','B','C','D')) THEN 1 END) AS f3,
          -- DCACMSP-004: Invalid DR Interest Collection/Application Cycle (D1DIAC), allowed H/M/Q/Y
          COUNT(CASE WHEN NVL(t."D1MDFL",' ') &lt;&gt; 'S' AND (TRIM(t."D1DIAC") IS NOT NULL) THEN 1 END) AS t4,
          COUNT(CASE WHEN NVL(t."D1MDFL",' ') &lt;&gt; 'S' AND (TRIM(t."D1DIAC") IS NOT NULL) AND (TRIM(t."D1DIAC") NOT IN ('H','M','Q','Y')) THEN 1 END) AS f4,
          -- DCACMSP-005: Invalid PLOC Repayment Option (D1RPYO), allowed D/E/I/L/N/P
          COUNT(CASE WHEN NVL(t."D1MDFL",' ') &lt;&gt; 'S' AND (TRIM(t."D1RPYO") IS NOT NULL) THEN 1 END) AS t5,
          COUNT(CASE WHEN NVL(t."D1MDFL",' ') &lt;&gt; 'S' AND (TRIM(t."D1RPYO") IS NOT NULL) AND (TRIM(t."D1RPYO") NOT IN ('D','E','I','L','N','P')) THEN 1 END) AS f5,
          -- DCACMSP-006: Invalid PLOC - Repayment Frequency (D1RPYF), allowed H/M/N/P/Q/T/Y
          COUNT(CASE WHEN NVL(t."D1MDFL",' ') &lt;&gt; 'S' AND (TRIM(t."D1RPYF") IS NOT NULL) THEN 1 END) AS t6,
          COUNT(CASE WHEN NVL(t."D1MDFL",' ') &lt;&gt; 'S' AND (TRIM(t."D1RPYF") IS NOT NULL) AND (TRIM(t."D1RPYF") NOT IN ('H','M','N','P','Q','T','Y')) THEN 1 END) AS f6,
          -- DCACMSP-007: Invalid date: Last Debit Interest Application Date (D1LDID)
          COUNT(CASE WHEN NVL(t."D1MDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t7,
          COUNT(CASE WHEN NVL(t."D1MDFL",' ') &lt;&gt; 'S' AND ((NOT (TRIM(t."D1LDID") IS NULL OR REGEXP_LIKE(TRIM(t."D1LDID"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."D1LDID"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."D1LDID") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."D1LDID")) END), 0) &lt; 19000101)) THEN 1 END) AS f7,
          -- DCACMSP-008: Invalid date: PLOC - Last Repayment Calculation Date (D1LRPD)
          COUNT(CASE WHEN NVL(t."D1MDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t8,
          COUNT(CASE WHEN NVL(t."D1MDFL",' ') &lt;&gt; 'S' AND ((NOT (TRIM(t."D1LRPD") IS NULL OR REGEXP_LIKE(TRIM(t."D1LRPD"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."D1LRPD"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."D1LRPD") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."D1LRPD")) END), 0) &lt; 19000101)) THEN 1 END) AS f8,
          -- DCACMSP-009: Invalid date: PLOC - Last Autopayroll Transaction Date (D1LAPD)
          COUNT(CASE WHEN NVL(t."D1MDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t9,
          COUNT(CASE WHEN NVL(t."D1MDFL",' ') &lt;&gt; 'S' AND ((NOT (TRIM(t."D1LAPD") IS NULL OR REGEXP_LIKE(TRIM(t."D1LAPD"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."D1LAPD"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."D1LAPD") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."D1LAPD")) END), 0) &lt; 19000101)) THEN 1 END) AS f9,
          -- DCACMSP-010: Invalid date: Last Update Date (D1DLUP)
          COUNT(CASE WHEN NVL(t."D1MDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t10,
          COUNT(CASE WHEN NVL(t."D1MDFL",' ') &lt;&gt; 'S' AND ((NOT (TRIM(t."D1DLUP") IS NULL OR REGEXP_LIKE(TRIM(t."D1DLUP"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."D1DLUP"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."D1DLUP") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."D1DLUP")) END), 0) &lt; 19000101)) THEN 1 END) AS f10,
          -- DCACMSP-011: Duplicate account key (D1ACB+D1ACS+D1ACX)
          COUNT(CASE WHEN NVL(t."D1MDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."D1ACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."D1ACS")) END) IS NOT NULL) THEN 1 END) AS t11,
          COUNT(CASE WHEN NVL(t."D1MDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."D1ACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."D1ACS")) END) IS NOT NULL) AND (t.dq_dup11 &gt; 1) THEN 1 END) AS f11,
          -- DCACMSP-012: Customer (D1DCB+D1DCS) not found in SSCUSTP
          COUNT(CASE WHEN NVL(t."D1MDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."D1DCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."D1DCB")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."D1DCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."D1DCS")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."D1DCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."D1DCS")) END) &lt;&gt; 0) THEN 1 END) AS t12,
          COUNT(CASE WHEN NVL(t."D1MDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."D1DCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."D1DCB")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."D1DCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."D1DCS")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."D1DCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."D1DCS")) END) &lt;&gt; 0) AND (j1.dcb IS NULL) THEN 1 END) AS f12
        FROM (SELECT x.*,
                     COUNT(CASE WHEN NVL("D1MDFL",' ') &lt;&gt; 'S' THEN 1 END) OVER (PARTITION BY "D1ACB", "D1ACS", "D1ACX") AS dq_dup11
                FROM DATACUT5."HUB_MT_DCACMSP" x) t
        CROSS JOIN params p
        LEFT JOIN k_cus j1 ON j1.dcb = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."D1DCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."D1DCB")) END) AND j1.dcs = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."D1DCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."D1DCS")) END)
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'DCACMSP-001|Missing Data|Missing customer key (D1DCB/D1DCS)',
        (t2, f2) AS 'DCACMSP-002|Missing Data|Missing account key (D1ACB/D1ACS/D1ACX)',
        (t3, f3) AS 'DCACMSP-003|Invalid Values|Invalid Facility Limit Category (D1LMCG), allowed A/B/C/D',
        (t4, f4) AS 'DCACMSP-004|Invalid Values|Invalid DR Interest Collection/Application Cycle (D1DIAC), allowed H/M/Q/Y',
        (t5, f5) AS 'DCACMSP-005|Invalid Values|Invalid PLOC Repayment Option (D1RPYO), allowed D/E/I/L/N/P',
        (t6, f6) AS 'DCACMSP-006|Invalid Values|Invalid PLOC - Repayment Frequency (D1RPYF), allowed H/M/N/P/Q/T/Y',
        (t7, f7) AS 'DCACMSP-007|Invalid Dates|Invalid date: Last Debit Interest Application Date (D1LDID)',
        (t8, f8) AS 'DCACMSP-008|Invalid Dates|Invalid date: PLOC - Last Repayment Calculation Date (D1LRPD)',
        (t9, f9) AS 'DCACMSP-009|Invalid Dates|Invalid date: PLOC - Last Autopayroll Transaction Date (D1LAPD)',
        (t10, f10) AS 'DCACMSP-010|Invalid Dates|Invalid date: Last Update Date (D1DLUP)',
        (t11, f11) AS 'DCACMSP-011|Duplicates|Duplicate account key (D1ACB+D1ACS+D1ACX)',
        (t12, f12) AS 'DCACMSP-012|Missing Links|Customer (D1DCB+D1DCS) not found in SSCUSTP'
      ))
    UNION ALL
/* =============================================================================
   DDACESP - Demand Deposits A/c Master Extension File(DDACMSP)
   Πίνακας: DATACUT5."HUB_MT_DDACESP"   Shadow: DFMDFL = 'S' (εξαιρούνται)   Έλεγχοι: 2
   ============================================================================= */
    SELECT 'DDACESP - Demand Deposits A/c Master Extension File(DDACMSP)' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- DDACESP-001: Missing account key (DFACB/DFACS/DFACX)
          COUNT(CASE WHEN NVL(t."DFMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t1,
          COUNT(CASE WHEN NVL(t."DFMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."DFACB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."DFACB")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."DFACB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."DFACB")) END) = 0 OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."DFACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."DFACS")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."DFACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."DFACS")) END) = 0 OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."DFACX") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."DFACX")) END) IS NULL) THEN 1 END) AS f1,
          -- DDACESP-002: Account (DFACB+DFACS+DFACX) not found in DDACMSP
          COUNT(CASE WHEN NVL(t."DFMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."DFACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."DFACS")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."DFACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."DFACS")) END) &lt;&gt; 0) THEN 1 END) AS t2,
          COUNT(CASE WHEN NVL(t."DFMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."DFACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."DFACS")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."DFACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."DFACS")) END) &lt;&gt; 0) AND (j1.k1 IS NULL) THEN 1 END) AS f2
        FROM DATACUT5."HUB_MT_DDACESP" t
        CROSS JOIN params p
        LEFT JOIN k_acc_DDACMSP j1 ON j1.k1 = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."DFACB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."DFACB")) END) AND j1.k2 = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."DFACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."DFACS")) END) AND j1.k3 = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."DFACX") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."DFACX")) END)
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'DDACESP-001|Missing Data|Missing account key (DFACB/DFACS/DFACX)',
        (t2, f2) AS 'DDACESP-002|Missing Links|Account (DFACB+DFACS+DFACX) not found in DDACMSP'
      ))
    UNION ALL
/* =============================================================================
   DDACMSP - Demand Deposits Account Master File
   Πίνακας: DATACUT5."HUB_MT_DDACMSP"   Shadow: DFMDFL = 'S' (εξαιρούνται)   Έλεγχοι: 29
   ============================================================================= */
    SELECT 'DDACMSP - Demand Deposits Account Master File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- DDACMSP-001: Missing customer key (DFDCB/DFDCS)
          COUNT(CASE WHEN NVL(t."DFMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t1,
          COUNT(CASE WHEN NVL(t."DFMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."DFDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."DFDCB")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."DFDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."DFDCS")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."DFDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."DFDCS")) END) = 0) THEN 1 END) AS f1,
          -- DDACMSP-002: Missing account key (DFACB/DFACS/DFACX)
          COUNT(CASE WHEN NVL(t."DFMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t2,
          COUNT(CASE WHEN NVL(t."DFMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."DFACB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."DFACB")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."DFACB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."DFACB")) END) = 0 OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."DFACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."DFACS")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."DFACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."DFACS")) END) = 0 OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."DFACX") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."DFACX")) END) IS NULL) THEN 1 END) AS f2,
          -- DDACMSP-003: Invalid Restriction (DFRSTR), allowed 1/2/3/4/5/6
          COUNT(CASE WHEN NVL(t."DFMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."DFRSTR") IS NOT NULL) THEN 1 END) AS t3,
          COUNT(CASE WHEN NVL(t."DFMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."DFRSTR") IS NOT NULL) AND (TRIM(t."DFRSTR") NOT IN ('1','2','3','4','5','6')) THEN 1 END) AS f3,
          -- DDACMSP-004: Invalid Cheque Tick-Up Indicator (DFTUPI), allowed C/D/N
          COUNT(CASE WHEN NVL(t."DFMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."DFTUPI") IS NOT NULL) THEN 1 END) AS t4,
          COUNT(CASE WHEN NVL(t."DFMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."DFTUPI") IS NOT NULL) AND (TRIM(t."DFTUPI") NOT IN ('C','D','N')) THEN 1 END) AS f4,
          -- DDACMSP-005: Invalid Status (DFSTUS), allowed 1/2/3/4/5/6/7/A/B/C/E/S
          COUNT(CASE WHEN NVL(t."DFMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."DFSTUS") IS NOT NULL) THEN 1 END) AS t5,
          COUNT(CASE WHEN NVL(t."DFMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."DFSTUS") IS NOT NULL) AND (TRIM(t."DFSTUS") NOT IN ('1','2','3','4','5','6','7','A','B','C','E','S')) THEN 1 END) AS f5,
          -- DDACMSP-006: Invalid Statutory A/C Status (DFCBST), allowed 1/2/3/4/5
          COUNT(CASE WHEN NVL(t."DFMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."DFCBST") IS NOT NULL) THEN 1 END) AS t6,
          COUNT(CASE WHEN NVL(t."DFMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."DFCBST") IS NOT NULL) AND (TRIM(t."DFCBST") NOT IN ('1','2','3','4','5')) THEN 1 END) AS f6,
          -- DDACMSP-007: Invalid Service Charge Collection Method (DFSCCM), allowed A/M
          COUNT(CASE WHEN NVL(t."DFMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."DFSCCM") IS NOT NULL) THEN 1 END) AS t7,
          COUNT(CASE WHEN NVL(t."DFMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."DFSCCM") IS NOT NULL) AND (TRIM(t."DFSCCM") NOT IN ('A','M')) THEN 1 END) AS f7,
          -- DDACMSP-008: Invalid Balance/Interest Offset Indicator (DFBIOI), allowed B/I
          COUNT(CASE WHEN NVL(t."DFMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."DFBIOI") IS NOT NULL) THEN 1 END) AS t8,
          COUNT(CASE WHEN NVL(t."DFMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."DFBIOI") IS NOT NULL) AND (TRIM(t."DFBIOI") NOT IN ('B','I')) THEN 1 END) AS f8,
          -- DDACMSP-009: Invalid Change of Balance Status (DFBSCH), allowed 1/2/3/4
          COUNT(CASE WHEN NVL(t."DFMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."DFBSCH") IS NOT NULL) THEN 1 END) AS t9,
          COUNT(CASE WHEN NVL(t."DFMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."DFBSCH") IS NOT NULL) AND (TRIM(t."DFBSCH") NOT IN ('1','2','3','4')) THEN 1 END) AS f9,
          -- DDACMSP-010: Invalid Credit Grade (DFCRGR), allowed 1/2/3/6/7
          COUNT(CASE WHEN NVL(t."DFMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."DFCRGR") IS NOT NULL) THEN 1 END) AS t10,
          COUNT(CASE WHEN NVL(t."DFMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."DFCRGR") IS NOT NULL) AND (TRIM(t."DFCRGR") NOT IN ('1','2','3','6','7')) THEN 1 END) AS f10,
          -- DDACMSP-011: Country of Registration/Residence (DFCTRS) not a valid country code (SSSTDPP CT)
          COUNT(CASE WHEN NVL(t."DFMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."DFCTRS") IS NOT NULL) THEN 1 END) AS t11,
          COUNT(CASE WHEN NVL(t."DFMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."DFCTRS") IS NOT NULL) AND (j1.code IS NULL) THEN 1 END) AS f11,
          -- DDACMSP-012: Nationality Code (DFNATY) not a valid country code (SSSTDPP CT)
          COUNT(CASE WHEN NVL(t."DFMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."DFNATY") IS NOT NULL) THEN 1 END) AS t12,
          COUNT(CASE WHEN NVL(t."DFMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."DFNATY") IS NOT NULL) AND (j2.code IS NULL) THEN 1 END) AS f12,
          -- DDACMSP-013: Invalid GIMIS Customer Indicator (DFGMCI), allowed C/I/M/N/S
          COUNT(CASE WHEN NVL(t."DFMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."DFGMCI") IS NOT NULL) THEN 1 END) AS t13,
          COUNT(CASE WHEN NVL(t."DFMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."DFGMCI") IS NOT NULL) AND (TRIM(t."DFGMCI") NOT IN ('C','I','M','N','S')) THEN 1 END) AS f13,
          -- DDACMSP-014: Invalid Language Code (DFLANG), allowed 1/2/3/P/S
          COUNT(CASE WHEN NVL(t."DFMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."DFLANG") IS NOT NULL) THEN 1 END) AS t14,
          COUNT(CASE WHEN NVL(t."DFMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."DFLANG") IS NOT NULL) AND (TRIM(t."DFLANG") NOT IN ('1','2','3','P','S')) THEN 1 END) AS f14,
          -- DDACMSP-015: Invalid Despatch Code (DFDPCD), allowed A/C/G/H/K/M/N/P/W
          COUNT(CASE WHEN NVL(t."DFMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."DFDPCD") IS NOT NULL) THEN 1 END) AS t15,
          COUNT(CASE WHEN NVL(t."DFMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."DFDPCD") IS NOT NULL) AND (TRIM(t."DFDPCD") NOT IN ('A','C','G','H','K','M','N','P','W')) THEN 1 END) AS f15,
          -- DDACMSP-016: Invalid Maturity (remaining maturity) (DFMTCD), allowed A/B/C/D/E/F/G/H/I/J/P/Q/R/S/T
          COUNT(CASE WHEN NVL(t."DFMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."DFMTCD") IS NOT NULL) THEN 1 END) AS t16,
          COUNT(CASE WHEN NVL(t."DFMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."DFMTCD") IS NOT NULL) AND (TRIM(t."DFMTCD") NOT IN ('A','B','C','D','E','F','G','H','I','J','P','Q','R','S','T')) THEN 1 END) AS f16,
          -- DDACMSP-017: Invalid Pooling Account Type (DFPLAC), allowed 2/4/9
          COUNT(CASE WHEN NVL(t."DFMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."DFPLAC") IS NOT NULL) THEN 1 END) AS t17,
          COUNT(CASE WHEN NVL(t."DFMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."DFPLAC") IS NOT NULL) AND (TRIM(t."DFPLAC") NOT IN ('2','4','9')) THEN 1 END) AS f17,
          -- DDACMSP-018: Invalid TRIAD Credit Line Management Exclusion Flag (DFTCLF), allowed B/D/I/N
          COUNT(CASE WHEN NVL(t."DFMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."DFTCLF") IS NOT NULL) THEN 1 END) AS t18,
          COUNT(CASE WHEN NVL(t."DFMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."DFTCLF") IS NOT NULL) AND (TRIM(t."DFTCLF") NOT IN ('B','D','I','N')) THEN 1 END) AS f18,
          -- DDACMSP-019: Invalid date: Date A/C Opened (DFDTAO)
          COUNT(CASE WHEN NVL(t."DFMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t19,
          COUNT(CASE WHEN NVL(t."DFMDFL",' ') &lt;&gt; 'S' AND ((NOT (TRIM(t."DFDTAO") IS NULL OR REGEXP_LIKE(TRIM(t."DFDTAO"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."DFDTAO"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."DFDTAO") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."DFDTAO")) END), 0) &lt; 19000101)) THEN 1 END) AS f19,
          -- DDACMSP-020: Invalid date: Date Last Transaction (DFDLTN)
          COUNT(CASE WHEN NVL(t."DFMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t20,
          COUNT(CASE WHEN NVL(t."DFMDFL",' ') &lt;&gt; 'S' AND ((NOT (TRIM(t."DFDLTN") IS NULL OR REGEXP_LIKE(TRIM(t."DFDLTN"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."DFDLTN"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."DFDLTN") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."DFDLTN")) END), 0) &lt; 19000101)) THEN 1 END) AS f20,
          -- DDACMSP-021: Invalid date: Date Passbook Last Updated (DFDLPU)
          COUNT(CASE WHEN NVL(t."DFMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t21,
          COUNT(CASE WHEN NVL(t."DFMDFL",' ') &lt;&gt; 'S' AND ((NOT (TRIM(t."DFDLPU") IS NULL OR REGEXP_LIKE(TRIM(t."DFDLPU"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."DFDLPU"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."DFDLPU") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."DFDLPU")) END), 0) &lt; 19000101)) THEN 1 END) AS f21,
          -- DDACMSP-022: Invalid date: Last Last Interest Application Date (DFLLID)
          COUNT(CASE WHEN NVL(t."DFMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t22,
          COUNT(CASE WHEN NVL(t."DFMDFL",' ') &lt;&gt; 'S' AND ((NOT (TRIM(t."DFLLID") IS NULL OR REGEXP_LIKE(TRIM(t."DFLLID"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."DFLLID"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."DFLLID") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."DFLLID")) END), 0) &lt; 19000101)) THEN 1 END) AS f22,
          -- DDACMSP-023: Invalid date: Date of application (DFDTAP)
          COUNT(CASE WHEN NVL(t."DFMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t23,
          COUNT(CASE WHEN NVL(t."DFMDFL",' ') &lt;&gt; 'S' AND ((NOT (TRIM(t."DFDTAP") IS NULL OR REGEXP_LIKE(TRIM(t."DFDTAP"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."DFDTAP"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."DFDTAP") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."DFDTAP")) END), 0) &lt; 19000101)) THEN 1 END) AS f23,
          -- DDACMSP-024: Invalid date: Block Code Date Last Update (DFBDUP)
          COUNT(CASE WHEN NVL(t."DFMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t24,
          COUNT(CASE WHEN NVL(t."DFMDFL",' ') &lt;&gt; 'S' AND ((NOT (TRIM(t."DFBDUP") IS NULL OR REGEXP_LIKE(TRIM(t."DFBDUP"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."DFBDUP"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."DFBDUP") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."DFBDUP")) END), 0) &lt; 19000101)) THEN 1 END) AS f24,
          -- DDACMSP-025: Invalid date: Last Update Date (DFDLUP)
          COUNT(CASE WHEN NVL(t."DFMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t25,
          COUNT(CASE WHEN NVL(t."DFMDFL",' ') &lt;&gt; 'S' AND ((NOT (TRIM(t."DFDLUP") IS NULL OR REGEXP_LIKE(TRIM(t."DFDLUP"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."DFDLUP"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."DFDLUP") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."DFDLUP")) END), 0) &lt; 19000101)) THEN 1 END) AS f25,
          -- DDACMSP-026: Duplicate account key (DFACB+DFACS+DFACX)
          COUNT(CASE WHEN NVL(t."DFMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."DFACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."DFACS")) END) IS NOT NULL) THEN 1 END) AS t26,
          COUNT(CASE WHEN NVL(t."DFMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."DFACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."DFACS")) END) IS NOT NULL) AND (t.dq_dup26 &gt; 1) THEN 1 END) AS f26,
          -- DDACMSP-027: Customer (DFDCB+DFDCS) not found in SSCUSTP
          COUNT(CASE WHEN NVL(t."DFMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."DFDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."DFDCB")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."DFDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."DFDCS")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."DFDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."DFDCS")) END) &lt;&gt; 0) THEN 1 END) AS t27,
          COUNT(CASE WHEN NVL(t."DFMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."DFDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."DFDCB")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."DFDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."DFDCS")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."DFDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."DFDCS")) END) &lt;&gt; 0) AND (j3.dcb IS NULL) THEN 1 END) AS f27,
          -- DDACMSP-B01: Closed DD account with non-zero ledger balance (DFSTUS=5, DFRLBL)
          COUNT(CASE WHEN NVL(t."DFMDFL",' ') &lt;&gt; 'S' AND (NVL(TRIM(t."DFSTUS"),'#') = '5') THEN 1 END) AS t28,
          COUNT(CASE WHEN NVL(t."DFMDFL",' ') &lt;&gt; 'S' AND (NVL(TRIM(t."DFSTUS"),'#') = '5') AND (NVL((CASE WHEN VALIDATE_CONVERSION(TRIM(t."DFRLBL") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."DFRLBL")) END),0) &lt;&gt; 0) THEN 1 END) AS f28,
          -- DDACMSP-T01: Active DD account without transaction for more than 1 year (DFDLTN)
          COUNT(CASE WHEN NVL(t."DFMDFL",' ') &lt;&gt; 'S' AND (NVL(TRIM(t."DFSTUS"),'#') = '1') THEN 1 END) AS t29,
          COUNT(CASE WHEN NVL(t."DFMDFL",' ') &lt;&gt; 'S' AND (NVL(TRIM(t."DFSTUS"),'#') = '1') AND ((CASE WHEN REGEXP_LIKE(TRIM(t."DFDLTN"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."DFDLTN") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."DFDLTN")) END) &lt; p.ref_num - 10000) THEN 1 END) AS f29
        FROM (SELECT x.*,
                     COUNT(CASE WHEN NVL("DFMDFL",' ') &lt;&gt; 'S' THEN 1 END) OVER (PARTITION BY "DFACB", "DFACS", "DFACX") AS dq_dup26
                FROM DATACUT5."HUB_MT_DDACMSP" x) t
        CROSS JOIN params p
        LEFT JOIN ref_ct j1 ON j1.code = TRIM(t."DFCTRS")
        LEFT JOIN ref_ct j2 ON j2.code = TRIM(t."DFNATY")
        LEFT JOIN k_cus j3 ON j3.dcb = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."DFDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."DFDCB")) END) AND j3.dcs = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."DFDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."DFDCS")) END)
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'DDACMSP-001|Missing Data|Missing customer key (DFDCB/DFDCS)',
        (t2, f2) AS 'DDACMSP-002|Missing Data|Missing account key (DFACB/DFACS/DFACX)',
        (t3, f3) AS 'DDACMSP-003|Invalid Values|Invalid Restriction (DFRSTR), allowed 1/2/3/4/5/6',
        (t4, f4) AS 'DDACMSP-004|Invalid Values|Invalid Cheque Tick-Up Indicator (DFTUPI), allowed C/D/N',
        (t5, f5) AS 'DDACMSP-005|Invalid Values|Invalid Status (DFSTUS), allowed 1/2/3/4/5/6/7/A/B/C/E/S',
        (t6, f6) AS 'DDACMSP-006|Invalid Values|Invalid Statutory A/C Status (DFCBST), allowed 1/2/3/4/5',
        (t7, f7) AS 'DDACMSP-007|Invalid Values|Invalid Service Charge Collection Method (DFSCCM), allowed A/M',
        (t8, f8) AS 'DDACMSP-008|Invalid Values|Invalid Balance/Interest Offset Indicator (DFBIOI), allowed B/I',
        (t9, f9) AS 'DDACMSP-009|Invalid Values|Invalid Change of Balance Status (DFBSCH), allowed 1/2/3/4',
        (t10, f10) AS 'DDACMSP-010|Invalid Values|Invalid Credit Grade (DFCRGR), allowed 1/2/3/6/7',
        (t11, f11) AS 'DDACMSP-011|Invalid Values|Country of Registration/Residence (DFCTRS) not a valid country code (SSSTDPP CT)',
        (t12, f12) AS 'DDACMSP-012|Invalid Values|Nationality Code (DFNATY) not a valid country code (SSSTDPP CT)',
        (t13, f13) AS 'DDACMSP-013|Invalid Values|Invalid GIMIS Customer Indicator (DFGMCI), allowed C/I/M/N/S',
        (t14, f14) AS 'DDACMSP-014|Invalid Values|Invalid Language Code (DFLANG), allowed 1/2/3/P/S',
        (t15, f15) AS 'DDACMSP-015|Invalid Values|Invalid Despatch Code (DFDPCD), allowed A/C/G/H/K/M/N/P/W',
        (t16, f16) AS 'DDACMSP-016|Invalid Values|Invalid Maturity (remaining maturity) (DFMTCD), allowed A/B/C/D/E/F/G/H/I/J/P/Q/R/S/T',
        (t17, f17) AS 'DDACMSP-017|Invalid Values|Invalid Pooling Account Type (DFPLAC), allowed 2/4/9',
        (t18, f18) AS 'DDACMSP-018|Invalid Values|Invalid TRIAD Credit Line Management Exclusion Flag (DFTCLF), allowed B/D/I/N',
        (t19, f19) AS 'DDACMSP-019|Invalid Dates|Invalid date: Date A/C Opened (DFDTAO)',
        (t20, f20) AS 'DDACMSP-020|Invalid Dates|Invalid date: Date Last Transaction (DFDLTN)',
        (t21, f21) AS 'DDACMSP-021|Invalid Dates|Invalid date: Date Passbook Last Updated (DFDLPU)',
        (t22, f22) AS 'DDACMSP-022|Invalid Dates|Invalid date: Last Last Interest Application Date (DFLLID)',
        (t23, f23) AS 'DDACMSP-023|Invalid Dates|Invalid date: Date of application (DFDTAP)',
        (t24, f24) AS 'DDACMSP-024|Invalid Dates|Invalid date: Block Code Date Last Update (DFBDUP)',
        (t25, f25) AS 'DDACMSP-025|Invalid Dates|Invalid date: Last Update Date (DFDLUP)',
        (t26, f26) AS 'DDACMSP-026|Duplicates|Duplicate account key (DFACB+DFACS+DFACX)',
        (t27, f27) AS 'DDACMSP-027|Missing Links|Customer (DFDCB+DFDCS) not found in SSCUSTP',
        (t28, f28) AS 'DDACMSP-B01|Balances|Closed DD account with non-zero ledger balance (DFSTUS=5, DFRLBL)',
        (t29, f29) AS 'DDACMSP-T01|Timeliness|Active DD account without transaction for more than 1 year (DFDLTN)'
      ))
    UNION ALL
/* =============================================================================
   DDCQBKP - Demand Deposits Cheque Book File
   Πίνακας: DATACUT5."HUB_MT_DDCQBKP"   Shadow: DJMDFL = 'S' (εξαιρούνται)   Έλεγχοι: 4
   ============================================================================= */
    SELECT 'DDCQBKP - Demand Deposits Cheque Book File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- DDCQBKP-001: Missing account key (DJACB/DJACS/DJACX)
          COUNT(CASE WHEN NVL(t."DJMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t1,
          COUNT(CASE WHEN NVL(t."DJMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."DJACB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."DJACB")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."DJACB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."DJACB")) END) = 0 OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."DJACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."DJACS")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."DJACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."DJACS")) END) = 0 OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."DJACX") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."DJACX")) END) IS NULL) THEN 1 END) AS f1,
          -- DDCQBKP-002: Invalid date: Date Issued (DJDTIS)
          COUNT(CASE WHEN NVL(t."DJMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t2,
          COUNT(CASE WHEN NVL(t."DJMDFL",' ') &lt;&gt; 'S' AND ((NOT (TRIM(t."DJDTIS") IS NULL OR REGEXP_LIKE(TRIM(t."DJDTIS"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."DJDTIS"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."DJDTIS") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."DJDTIS")) END), 0) &lt; 19000101)) THEN 1 END) AS f2,
          -- DDCQBKP-003: Invalid date: Last Update Date (DJDLUP)
          COUNT(CASE WHEN NVL(t."DJMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t3,
          COUNT(CASE WHEN NVL(t."DJMDFL",' ') &lt;&gt; 'S' AND ((NOT (TRIM(t."DJDLUP") IS NULL OR REGEXP_LIKE(TRIM(t."DJDLUP"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."DJDLUP"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."DJDLUP") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."DJDLUP")) END), 0) &lt; 19000101)) THEN 1 END) AS f3,
          -- DDCQBKP-004: Account (DJACB+DJACS+DJACX) not found in DDACMSP
          COUNT(CASE WHEN NVL(t."DJMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."DJACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."DJACS")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."DJACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."DJACS")) END) &lt;&gt; 0) THEN 1 END) AS t4,
          COUNT(CASE WHEN NVL(t."DJMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."DJACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."DJACS")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."DJACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."DJACS")) END) &lt;&gt; 0) AND (j1.k1 IS NULL) THEN 1 END) AS f4
        FROM DATACUT5."HUB_MT_DDCQBKP" t
        CROSS JOIN params p
        LEFT JOIN k_acc_DDACMSP j1 ON j1.k1 = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."DJACB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."DJACB")) END) AND j1.k2 = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."DJACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."DJACS")) END) AND j1.k3 = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."DJACX") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."DJACX")) END)
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'DDCQBKP-001|Missing Data|Missing account key (DJACB/DJACS/DJACX)',
        (t2, f2) AS 'DDCQBKP-002|Invalid Dates|Invalid date: Date Issued (DJDTIS)',
        (t3, f3) AS 'DDCQBKP-003|Invalid Dates|Invalid date: Last Update Date (DJDLUP)',
        (t4, f4) AS 'DDCQBKP-004|Missing Links|Account (DJACB+DJACS+DJACX) not found in DDACMSP'
      ))
    UNION ALL
/* =============================================================================
   DDCRINP - Demand Deposits Credit Interest Segment File f
   Πίνακας: DATACUT5."HUB_MT_DDCRINP"   Shadow: DGMDFL = 'S' (εξαιρούνται)   Έλεγχοι: 4
   ============================================================================= */
    SELECT 'DDCRINP - Demand Deposits Credit Interest Segment File f' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- DDCRINP-001: Missing account key (DGACB/DGACS/DGACX)
          COUNT(CASE WHEN NVL(t."DGMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t1,
          COUNT(CASE WHEN NVL(t."DGMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."DGACB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."DGACB")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."DGACB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."DGACB")) END) = 0 OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."DGACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."DGACS")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."DGACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."DGACS")) END) = 0 OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."DGACX") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."DGACX")) END) IS NULL) THEN 1 END) AS f1,
          -- DDCRINP-002: Invalid date: Last Credit Interest Application Date (DGLCID)
          COUNT(CASE WHEN NVL(t."DGMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t2,
          COUNT(CASE WHEN NVL(t."DGMDFL",' ') &lt;&gt; 'S' AND ((NOT (TRIM(t."DGLCID") IS NULL OR REGEXP_LIKE(TRIM(t."DGLCID"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."DGLCID"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."DGLCID") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."DGLCID")) END), 0) &lt; 19000101)) THEN 1 END) AS f2,
          -- DDCRINP-003: Invalid date: Last Update Date (DGDLUP)
          COUNT(CASE WHEN NVL(t."DGMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t3,
          COUNT(CASE WHEN NVL(t."DGMDFL",' ') &lt;&gt; 'S' AND ((NOT (TRIM(t."DGDLUP") IS NULL OR REGEXP_LIKE(TRIM(t."DGDLUP"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."DGDLUP"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."DGDLUP") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."DGDLUP")) END), 0) &lt; 19000101)) THEN 1 END) AS f3,
          -- DDCRINP-004: Account (DGACB+DGACS+DGACX) not found in DDACMSP
          COUNT(CASE WHEN NVL(t."DGMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."DGACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."DGACS")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."DGACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."DGACS")) END) &lt;&gt; 0) THEN 1 END) AS t4,
          COUNT(CASE WHEN NVL(t."DGMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."DGACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."DGACS")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."DGACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."DGACS")) END) &lt;&gt; 0) AND (j1.k1 IS NULL) THEN 1 END) AS f4
        FROM DATACUT5."HUB_MT_DDCRINP" t
        CROSS JOIN params p
        LEFT JOIN k_acc_DDACMSP j1 ON j1.k1 = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."DGACB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."DGACB")) END) AND j1.k2 = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."DGACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."DGACS")) END) AND j1.k3 = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."DGACX") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."DGACX")) END)
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'DDCRINP-001|Missing Data|Missing account key (DGACB/DGACS/DGACX)',
        (t2, f2) AS 'DDCRINP-002|Invalid Dates|Invalid date: Last Credit Interest Application Date (DGLCID)',
        (t3, f3) AS 'DDCRINP-003|Invalid Dates|Invalid date: Last Update Date (DGDLUP)',
        (t4, f4) AS 'DDCRINP-004|Missing Links|Account (DGACB+DGACS+DGACX) not found in DDACMSP'
      ))
    UNION ALL
/* =============================================================================
   DDIBANP - IBAN Master File
   Πίνακας: DATACUT5."HUB_MT_DDIBANP"   Shadow: δεν υπάρχει mode flag   Έλεγχοι: 5
   ============================================================================= */
    SELECT 'DDIBANP - IBAN Master File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- DDIBANP-001: Missing account key (IBACB/IBACS/IBACX)
          COUNT(CASE WHEN 1=1 THEN 1 END) AS t1,
          COUNT(CASE WHEN 1=1 AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."IBACB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."IBACB")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."IBACB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."IBACB")) END) = 0 OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."IBACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."IBACS")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."IBACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."IBACS")) END) = 0 OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."IBACX") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."IBACX")) END) IS NULL) THEN 1 END) AS f1,
          -- DDIBANP-002: Invalid date: Last Update Date (IBDLUP)
          COUNT(CASE WHEN 1=1 THEN 1 END) AS t2,
          COUNT(CASE WHEN 1=1 AND ((NOT (TRIM(t."IBDLUP") IS NULL OR REGEXP_LIKE(TRIM(t."IBDLUP"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."IBDLUP"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."IBDLUP") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."IBDLUP")) END), 0) &lt; 19000101)) THEN 1 END) AS f2,
          -- DDIBANP-003: Account (IBACB+IBACS+IBACX) not found in DDACMSP
          COUNT(CASE WHEN ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."IBACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."IBACS")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."IBACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."IBACS")) END) &lt;&gt; 0) THEN 1 END) AS t3,
          COUNT(CASE WHEN ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."IBACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."IBACS")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."IBACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."IBACS")) END) &lt;&gt; 0) AND (j1.k1 IS NULL) THEN 1 END) AS f3,
          -- DDIBANP-F01: IBAN check digits invalid (IBIBAN, ISO 13616 mod 97)
          COUNT(CASE WHEN (REGEXP_LIKE(UPPER(TRIM(t."IBIBAN")), '^MT[0-9]{2}[A-Z]{4}[0-9]{5}[A-Z0-9]{18}$')) THEN 1 END) AS t4,
          COUNT(CASE WHEN (REGEXP_LIKE(UPPER(TRIM(t."IBIBAN")), '^MT[0-9]{2}[A-Z]{4}[0-9]{5}[A-Z0-9]{18}$')) AND (MOD(MOD(TO_NUMBER(SUBSTR(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(SUBSTR(UPPER(TRIM(t."IBIBAN")),5) || SUBSTR(UPPER(TRIM(t."IBIBAN")),1,4),'A','10'),'B','11'),'C','12'),'D','13'),'E','14'),'F','15'),'G','16'),'H','17'),'I','18'),'J','19'),'K','20'),'L','21'),'M','22'),'N','23'),'O','24'),'P','25'),'Q','26'),'R','27'),'S','28'),'T','29'),'U','30'),'V','31'),'W','32'),'X','33'),'Y','34'),'Z','35'),1,LENGTH(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(SUBSTR(UPPER(TRIM(t."IBIBAN")),5) || SUBSTR(UPPER(TRIM(t."IBIBAN")),1,4),'A','10'),'B','11'),'C','12'),'D','13'),'E','14'),'F','15'),'G','16'),'H','17'),'I','18'),'J','19'),'K','20'),'L','21'),'M','22'),'N','23'),'O','24'),'P','25'),'Q','26'),'R','27'),'S','28'),'T','29'),'U','30'),'V','31'),'W','32'),'X','33'),'Y','34'),'Z','35'))-30)),97) * MOD(POWER(10,30),97) + MOD(TO_NUMBER(SUBSTR(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(REPLACE(SUBSTR(UPPER(TRIM(t."IBIBAN")),5) || SUBSTR(UPPER(TRIM(t."IBIBAN")),1,4),'A','10'),'B','11'),'C','12'),'D','13'),'E','14'),'F','15'),'G','16'),'H','17'),'I','18'),'J','19'),'K','20'),'L','21'),'M','22'),'N','23'),'O','24'),'P','25'),'Q','26'),'R','27'),'S','28'),'T','29'),'U','30'),'V','31'),'W','32'),'X','33'),'Y','34'),'Z','35'),-30)),97), 97) &lt;&gt; 1) THEN 1 END) AS f4,
          -- DDIBANP-F02: IBAN not in Maltese format (IBIBAN: MT + 2 check digits + 4-letter bank + 5-digit sort code + 18 characters)
          COUNT(CASE WHEN (TRIM(t."IBIBAN") IS NOT NULL) THEN 1 END) AS t5,
          COUNT(CASE WHEN (TRIM(t."IBIBAN") IS NOT NULL) AND (NOT REGEXP_LIKE(UPPER(TRIM(t."IBIBAN")), '^MT[0-9]{2}[A-Z]{4}[0-9]{5}[A-Z0-9]{18}$')) THEN 1 END) AS f5
        FROM DATACUT5."HUB_MT_DDIBANP" t
        CROSS JOIN params p
        LEFT JOIN k_acc_DDACMSP j1 ON j1.k1 = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."IBACB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."IBACB")) END) AND j1.k2 = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."IBACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."IBACS")) END) AND j1.k3 = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."IBACX") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."IBACX")) END)
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'DDIBANP-001|Missing Data|Missing account key (IBACB/IBACS/IBACX)',
        (t2, f2) AS 'DDIBANP-002|Invalid Dates|Invalid date: Last Update Date (IBDLUP)',
        (t3, f3) AS 'DDIBANP-003|Missing Links|Account (IBACB+IBACS+IBACX) not found in DDACMSP',
        (t4, f4) AS 'DDIBANP-F01|Format|IBAN check digits invalid (IBIBAN, ISO 13616 mod 97)',
        (t5, f5) AS 'DDIBANP-F02|Format|IBAN not in Maltese format (IBIBAN: MT + 2 check digits + 4-letter bank + 5-digit sort code + 18 characters)'
      ))
    UNION ALL
/* =============================================================================
   DDIRHFP - Demand Deposits Interest Rate History File
   Πίνακας: DATACUT5."HUB_MT_DDIRHFP"   Shadow: DRMDFL = 'S' (εξαιρούνται)   Έλεγχοι: 3
   ============================================================================= */
    SELECT 'DDIRHFP - Demand Deposits Interest Rate History File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- DDIRHFP-001: Missing account key (DRACB/DRACS/DRACX)
          COUNT(CASE WHEN NVL(t."DRMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t1,
          COUNT(CASE WHEN NVL(t."DRMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."DRACB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."DRACB")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."DRACB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."DRACB")) END) = 0 OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."DRACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."DRACS")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."DRACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."DRACS")) END) = 0 OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."DRACX") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."DRACX")) END) IS NULL) THEN 1 END) AS f1,
          -- DDIRHFP-002: Invalid date: Last Update Date (DRDLUP)
          COUNT(CASE WHEN NVL(t."DRMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t2,
          COUNT(CASE WHEN NVL(t."DRMDFL",' ') &lt;&gt; 'S' AND ((NOT (TRIM(t."DRDLUP") IS NULL OR REGEXP_LIKE(TRIM(t."DRDLUP"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."DRDLUP"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."DRDLUP") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."DRDLUP")) END), 0) &lt; 19000101)) THEN 1 END) AS f2,
          -- DDIRHFP-003: Account (DRACB+DRACS+DRACX) not found in DDACMSP
          COUNT(CASE WHEN NVL(t."DRMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."DRACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."DRACS")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."DRACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."DRACS")) END) &lt;&gt; 0) THEN 1 END) AS t3,
          COUNT(CASE WHEN NVL(t."DRMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."DRACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."DRACS")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."DRACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."DRACS")) END) &lt;&gt; 0) AND (j1.k1 IS NULL) THEN 1 END) AS f3
        FROM DATACUT5."HUB_MT_DDIRHFP" t
        CROSS JOIN params p
        LEFT JOIN k_acc_DDACMSP j1 ON j1.k1 = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."DRACB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."DRACB")) END) AND j1.k2 = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."DRACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."DRACS")) END) AND j1.k3 = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."DRACX") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."DRACX")) END)
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'DDIRHFP-001|Missing Data|Missing account key (DRACB/DRACS/DRACX)',
        (t2, f2) AS 'DDIRHFP-002|Invalid Dates|Invalid date: Last Update Date (DRDLUP)',
        (t3, f3) AS 'DDIRHFP-003|Missing Links|Account (DRACB+DRACS+DRACX) not found in DDACMSP'
      ))
    UNION ALL
/* =============================================================================
   DDSMCPP - Demand Deposits Account Statement Copies File
   Πίνακας: DATACUT5."HUB_MT_DDSMCPP"   Shadow: DIMDFL = 'S' (εξαιρούνται)   Έλεγχοι: 3
   ============================================================================= */
    SELECT 'DDSMCPP - Demand Deposits Account Statement Copies File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- DDSMCPP-001: Missing account key (DIACB/DIACS/DIACX)
          COUNT(CASE WHEN NVL(t."DIMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t1,
          COUNT(CASE WHEN NVL(t."DIMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."DIACB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."DIACB")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."DIACB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."DIACB")) END) = 0 OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."DIACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."DIACS")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."DIACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."DIACS")) END) = 0 OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."DIACX") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."DIACX")) END) IS NULL) THEN 1 END) AS f1,
          -- DDSMCPP-002: Invalid date: Last Update Date (DIDLUP)
          COUNT(CASE WHEN NVL(t."DIMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t2,
          COUNT(CASE WHEN NVL(t."DIMDFL",' ') &lt;&gt; 'S' AND ((NOT (TRIM(t."DIDLUP") IS NULL OR REGEXP_LIKE(TRIM(t."DIDLUP"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."DIDLUP"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."DIDLUP") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."DIDLUP")) END), 0) &lt; 19000101)) THEN 1 END) AS f2,
          -- DDSMCPP-003: Account (DIACB+DIACS+DIACX) not found in DDACMSP
          COUNT(CASE WHEN NVL(t."DIMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."DIACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."DIACS")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."DIACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."DIACS")) END) &lt;&gt; 0) THEN 1 END) AS t3,
          COUNT(CASE WHEN NVL(t."DIMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."DIACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."DIACS")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."DIACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."DIACS")) END) &lt;&gt; 0) AND (j1.k1 IS NULL) THEN 1 END) AS f3
        FROM DATACUT5."HUB_MT_DDSMCPP" t
        CROSS JOIN params p
        LEFT JOIN k_acc_DDACMSP j1 ON j1.k1 = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."DIACB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."DIACB")) END) AND j1.k2 = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."DIACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."DIACS")) END) AND j1.k3 = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."DIACX") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."DIACX")) END)
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'DDSMCPP-001|Missing Data|Missing account key (DIACB/DIACS/DIACX)',
        (t2, f2) AS 'DDSMCPP-002|Invalid Dates|Invalid date: Last Update Date (DIDLUP)',
        (t3, f3) AS 'DDSMCPP-003|Missing Links|Account (DIACB+DIACS+DIACX) not found in DDACMSP'
      ))
    UNION ALL
/* =============================================================================
   DDSPCQP - Demand Deposits Stop/Lost Cheques File
   Πίνακας: DATACUT5."HUB_MT_DDSPCQP"   Shadow: DKMDFL = 'S' (εξαιρούνται)   Έλεγχοι: 4
   ============================================================================= */
    SELECT 'DDSPCQP - Demand Deposits Stop/Lost Cheques File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- DDSPCQP-001: Missing account key (DKACB/DKACS/DKACX)
          COUNT(CASE WHEN NVL(t."DKMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t1,
          COUNT(CASE WHEN NVL(t."DKMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."DKACB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."DKACB")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."DKACB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."DKACB")) END) = 0 OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."DKACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."DKACS")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."DKACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."DKACS")) END) = 0 OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."DKACX") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."DKACX")) END) IS NULL) THEN 1 END) AS f1,
          -- DDSPCQP-002: Invalid date: Last Update Date (DKDLUP)
          COUNT(CASE WHEN NVL(t."DKMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t2,
          COUNT(CASE WHEN NVL(t."DKMDFL",' ') &lt;&gt; 'S' AND ((NOT (TRIM(t."DKDLUP") IS NULL OR REGEXP_LIKE(TRIM(t."DKDLUP"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."DKDLUP"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."DKDLUP") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."DKDLUP")) END), 0) &lt; 19000101)) THEN 1 END) AS f2,
          -- DDSPCQP-003: Invalid date: Capture Date (DKCPDT)
          COUNT(CASE WHEN NVL(t."DKMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t3,
          COUNT(CASE WHEN NVL(t."DKMDFL",' ') &lt;&gt; 'S' AND ((NOT (TRIM(t."DKCPDT") IS NULL OR REGEXP_LIKE(TRIM(t."DKCPDT"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."DKCPDT"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."DKCPDT") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."DKCPDT")) END), 0) &lt; 19000101)) THEN 1 END) AS f3,
          -- DDSPCQP-004: Account (DKACB+DKACS+DKACX) not found in DDACMSP
          COUNT(CASE WHEN NVL(t."DKMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."DKACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."DKACS")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."DKACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."DKACS")) END) &lt;&gt; 0) THEN 1 END) AS t4,
          COUNT(CASE WHEN NVL(t."DKMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."DKACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."DKACS")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."DKACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."DKACS")) END) &lt;&gt; 0) AND (j1.k1 IS NULL) THEN 1 END) AS f4
        FROM DATACUT5."HUB_MT_DDSPCQP" t
        CROSS JOIN params p
        LEFT JOIN k_acc_DDACMSP j1 ON j1.k1 = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."DKACB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."DKACB")) END) AND j1.k2 = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."DKACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."DKACS")) END) AND j1.k3 = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."DKACX") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."DKACX")) END)
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'DDSPCQP-001|Missing Data|Missing account key (DKACB/DKACS/DKACX)',
        (t2, f2) AS 'DDSPCQP-002|Invalid Dates|Invalid date: Last Update Date (DKDLUP)',
        (t3, f3) AS 'DDSPCQP-003|Invalid Dates|Invalid date: Capture Date (DKCPDT)',
        (t4, f4) AS 'DDSPCQP-004|Missing Links|Account (DKACB+DKACS+DKACX) not found in DDACMSP'
      ))
    UNION ALL
/* =============================================================================
   DDSTMTP - Demand Deposits Account Statement Segment File
   Πίνακας: DATACUT5."HUB_MT_DDSTMTP"   Shadow: DHMDFL = 'S' (εξαιρούνται)   Έλεγχοι: 4
   ============================================================================= */
    SELECT 'DDSTMTP - Demand Deposits Account Statement Segment File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- DDSTMTP-001: Missing account key (DHACB/DHACS/DHACX)
          COUNT(CASE WHEN NVL(t."DHMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t1,
          COUNT(CASE WHEN NVL(t."DHMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."DHACB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."DHACB")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."DHACB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."DHACB")) END) = 0 OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."DHACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."DHACS")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."DHACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."DHACS")) END) = 0 OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."DHACX") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."DHACX")) END) IS NULL) THEN 1 END) AS f1,
          -- DDSTMTP-002: Invalid date: Date Last Statement (DHDTLS)
          COUNT(CASE WHEN NVL(t."DHMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t2,
          COUNT(CASE WHEN NVL(t."DHMDFL",' ') &lt;&gt; 'S' AND ((NOT (TRIM(t."DHDTLS") IS NULL OR REGEXP_LIKE(TRIM(t."DHDTLS"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."DHDTLS"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."DHDTLS") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."DHDTLS")) END), 0) &lt; 19000101)) THEN 1 END) AS f2,
          -- DDSTMTP-003: Invalid date: Last Update Date (DHDLUP)
          COUNT(CASE WHEN NVL(t."DHMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t3,
          COUNT(CASE WHEN NVL(t."DHMDFL",' ') &lt;&gt; 'S' AND ((NOT (TRIM(t."DHDLUP") IS NULL OR REGEXP_LIKE(TRIM(t."DHDLUP"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."DHDLUP"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."DHDLUP") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."DHDLUP")) END), 0) &lt; 19000101)) THEN 1 END) AS f3,
          -- DDSTMTP-004: Account (DHACB+DHACS+DHACX) not found in DDACMSP
          COUNT(CASE WHEN NVL(t."DHMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."DHACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."DHACS")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."DHACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."DHACS")) END) &lt;&gt; 0) THEN 1 END) AS t4,
          COUNT(CASE WHEN NVL(t."DHMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."DHACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."DHACS")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."DHACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."DHACS")) END) &lt;&gt; 0) AND (j1.k1 IS NULL) THEN 1 END) AS f4
        FROM DATACUT5."HUB_MT_DDSTMTP" t
        CROSS JOIN params p
        LEFT JOIN k_acc_DDACMSP j1 ON j1.k1 = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."DHACB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."DHACB")) END) AND j1.k2 = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."DHACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."DHACS")) END) AND j1.k3 = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."DHACX") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."DHACX")) END)
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'DDSTMTP-001|Missing Data|Missing account key (DHACB/DHACS/DHACX)',
        (t2, f2) AS 'DDSTMTP-002|Invalid Dates|Invalid date: Date Last Statement (DHDTLS)',
        (t3, f3) AS 'DDSTMTP-003|Invalid Dates|Invalid date: Last Update Date (DHDLUP)',
        (t4, f4) AS 'DDSTMTP-004|Missing Links|Account (DHACB+DHACS+DHACX) not found in DDACMSP'
      ))
    UNION ALL
/* =============================================================================
   EBCUSTP - E-Banking Customer Information File
   Πίνακας: DATACUT5."HUB_MT_EBCUSTP"   Shadow: PCMDFL = 'S' (εξαιρούνται)   Έλεγχοι: 15
   ============================================================================= */
    SELECT 'EBCUSTP - E-Banking Customer Information File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- EBCUSTP-001: Missing customer key (PCDCB/PCDCS)
          COUNT(CASE WHEN NVL(t."PCMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t1,
          COUNT(CASE WHEN NVL(t."PCMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."PCDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."PCDCB")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."PCDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."PCDCS")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."PCDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."PCDCS")) END) = 0) THEN 1 END) AS f1,
          -- EBCUSTP-002: Invalid Class of HPB Customers (PCCSCL), allowed C/D/I
          COUNT(CASE WHEN NVL(t."PCMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."PCCSCL") IS NOT NULL) THEN 1 END) AS t2,
          COUNT(CASE WHEN NVL(t."PCMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."PCCSCL") IS NOT NULL) AND (TRIM(t."PCCSCL") NOT IN ('C','D','I')) THEN 1 END) AS f2,
          -- EBCUSTP-003: Invalid Status of PBN or HPB customer (PCPBNS), allowed D/H/M/N/P/S
          COUNT(CASE WHEN NVL(t."PCMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."PCPBNS") IS NOT NULL) THEN 1 END) AS t3,
          COUNT(CASE WHEN NVL(t."PCMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."PCPBNS") IS NOT NULL) AND (TRIM(t."PCPBNS") NOT IN ('D','H','M','N','P','S')) THEN 1 END) AS f3,
          -- EBCUSTP-004: Invalid Way of PBN status changed (PCWSTC), allowed M/S
          COUNT(CASE WHEN NVL(t."PCMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."PCWSTC") IS NOT NULL) THEN 1 END) AS t4,
          COUNT(CASE WHEN NVL(t."PCMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."PCWSTC") IS NOT NULL) AND (TRIM(t."PCWSTC") NOT IN ('M','S')) THEN 1 END) AS f4,
          -- EBCUSTP-005: Invalid Doubtful Advice Printed Flag (PCDAVP), allowed D/N/Y
          COUNT(CASE WHEN NVL(t."PCMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."PCDAVP") IS NOT NULL) THEN 1 END) AS t5,
          COUNT(CASE WHEN NVL(t."PCMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."PCDAVP") IS NOT NULL) AND (TRIM(t."PCDAVP") NOT IN ('D','N','Y')) THEN 1 END) AS f5,
          -- EBCUSTP-006: Invalid SMS Alert Status R/N/S (PCSMAU), allowed N/R/S
          COUNT(CASE WHEN NVL(t."PCMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."PCSMAU") IS NOT NULL) THEN 1 END) AS t6,
          COUNT(CASE WHEN NVL(t."PCMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."PCSMAU") IS NOT NULL) AND (TRIM(t."PCSMAU") NOT IN ('N','R','S')) THEN 1 END) AS f6,
          -- EBCUSTP-007: Invalid Registration Method (PCRGMD), allowed A/C/P
          COUNT(CASE WHEN NVL(t."PCMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."PCRGMD") IS NOT NULL) THEN 1 END) AS t7,
          COUNT(CASE WHEN NVL(t."PCMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."PCRGMD") IS NOT NULL) AND (TRIM(t."PCRGMD") NOT IN ('A','C','P')) THEN 1 END) AS f7,
          -- EBCUSTP-008: Invalid Identity Type (PCIDTY), allowed I/P
          COUNT(CASE WHEN NVL(t."PCMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."PCIDTY") IS NOT NULL) THEN 1 END) AS t8,
          COUNT(CASE WHEN NVL(t."PCMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."PCIDTY") IS NOT NULL) AND (TRIM(t."PCIDTY") NOT IN ('I','P')) THEN 1 END) AS f8,
          -- EBCUSTP-009: Invalid Alert Language Pref (PCLANG), allowed 1/2/3/P/S
          COUNT(CASE WHEN NVL(t."PCMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."PCLANG") IS NOT NULL) THEN 1 END) AS t9,
          COUNT(CASE WHEN NVL(t."PCMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."PCLANG") IS NOT NULL) AND (TRIM(t."PCLANG") NOT IN ('1','2','3','P','S')) THEN 1 END) AS f9,
          -- EBCUSTP-010: Invalid date: Date Last Fund Transfer (PCDLFT)
          COUNT(CASE WHEN NVL(t."PCMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t10,
          COUNT(CASE WHEN NVL(t."PCMDFL",' ') &lt;&gt; 'S' AND ((NOT (TRIM(t."PCDLFT") IS NULL OR REGEXP_LIKE(TRIM(t."PCDLFT"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."PCDLFT"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."PCDLFT") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."PCDLFT")) END), 0) &lt; 19000101)) THEN 1 END) AS f10,
          -- EBCUSTP-011: Invalid date: Date Last Term Deposit Placement (PCDLTD)
          COUNT(CASE WHEN NVL(t."PCMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t11,
          COUNT(CASE WHEN NVL(t."PCMDFL",' ') &lt;&gt; 'S' AND ((NOT (TRIM(t."PCDLTD") IS NULL OR REGEXP_LIKE(TRIM(t."PCDLTD"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."PCDLTD"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."PCDLTD") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."PCDLTD")) END), 0) &lt; 19000101)) THEN 1 END) AS f11,
          -- EBCUSTP-012: Invalid date: Date Last 3rd Party Payment (PCDLPM)
          COUNT(CASE WHEN NVL(t."PCMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t12,
          COUNT(CASE WHEN NVL(t."PCMDFL",' ') &lt;&gt; 'S' AND ((NOT (TRIM(t."PCDLPM") IS NULL OR REGEXP_LIKE(TRIM(t."PCDLPM"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."PCDLPM"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."PCDLPM") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."PCDLPM")) END), 0) &lt; 19000101)) THEN 1 END) AS f12,
          -- EBCUSTP-013: Invalid date: Last Update Date (PCDLUP)
          COUNT(CASE WHEN NVL(t."PCMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t13,
          COUNT(CASE WHEN NVL(t."PCMDFL",' ') &lt;&gt; 'S' AND ((NOT (TRIM(t."PCDLUP") IS NULL OR REGEXP_LIKE(TRIM(t."PCDLUP"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."PCDLUP"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."PCDLUP") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."PCDLUP")) END), 0) &lt; 19000101)) THEN 1 END) AS f13,
          -- EBCUSTP-014: Customer (PCDCB+PCDCS) not found in SSCUSTP
          COUNT(CASE WHEN NVL(t."PCMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."PCDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."PCDCB")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."PCDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."PCDCS")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."PCDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."PCDCS")) END) &lt;&gt; 0) THEN 1 END) AS t14,
          COUNT(CASE WHEN NVL(t."PCMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."PCDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."PCDCB")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."PCDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."PCDCS")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."PCDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."PCDCS")) END) &lt;&gt; 0) AND (j1.dcb IS NULL) THEN 1 END) AS f14,
          -- EBCUSTP-F01: Mobile number with invalid format (PCTEN3)
          COUNT(CASE WHEN NVL(t."PCMDFL",' ') &lt;&gt; 'S' AND ((TRIM(t."PCTEN3") IS NOT NULL)) THEN 1 END) AS t15,
          COUNT(CASE WHEN NVL(t."PCMDFL",' ') &lt;&gt; 'S' AND ((TRIM(t."PCTEN3") IS NOT NULL)) AND ((TRIM(t."PCTEN3") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(t."PCTEN3"), '^\+?[0-9][0-9 ()/-]{5,}$'))) THEN 1 END) AS f15
        FROM DATACUT5."HUB_MT_EBCUSTP" t
        CROSS JOIN params p
        LEFT JOIN k_cus j1 ON j1.dcb = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."PCDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."PCDCB")) END) AND j1.dcs = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."PCDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."PCDCS")) END)
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'EBCUSTP-001|Missing Data|Missing customer key (PCDCB/PCDCS)',
        (t2, f2) AS 'EBCUSTP-002|Invalid Values|Invalid Class of HPB Customers (PCCSCL), allowed C/D/I',
        (t3, f3) AS 'EBCUSTP-003|Invalid Values|Invalid Status of PBN or HPB customer (PCPBNS), allowed D/H/M/N/P/S',
        (t4, f4) AS 'EBCUSTP-004|Invalid Values|Invalid Way of PBN status changed (PCWSTC), allowed M/S',
        (t5, f5) AS 'EBCUSTP-005|Invalid Values|Invalid Doubtful Advice Printed Flag (PCDAVP), allowed D/N/Y',
        (t6, f6) AS 'EBCUSTP-006|Invalid Values|Invalid SMS Alert Status R/N/S (PCSMAU), allowed N/R/S',
        (t7, f7) AS 'EBCUSTP-007|Invalid Values|Invalid Registration Method (PCRGMD), allowed A/C/P',
        (t8, f8) AS 'EBCUSTP-008|Invalid Values|Invalid Identity Type (PCIDTY), allowed I/P',
        (t9, f9) AS 'EBCUSTP-009|Invalid Values|Invalid Alert Language Pref (PCLANG), allowed 1/2/3/P/S',
        (t10, f10) AS 'EBCUSTP-010|Invalid Dates|Invalid date: Date Last Fund Transfer (PCDLFT)',
        (t11, f11) AS 'EBCUSTP-011|Invalid Dates|Invalid date: Date Last Term Deposit Placement (PCDLTD)',
        (t12, f12) AS 'EBCUSTP-012|Invalid Dates|Invalid date: Date Last 3rd Party Payment (PCDLPM)',
        (t13, f13) AS 'EBCUSTP-013|Invalid Dates|Invalid date: Last Update Date (PCDLUP)',
        (t14, f14) AS 'EBCUSTP-014|Missing Links|Customer (PCDCB+PCDCS) not found in SSCUSTP',
        (t15, f15) AS 'EBCUSTP-F01|Format|Mobile number with invalid format (PCTEN3)'
      ))
    UNION ALL
/* =============================================================================
   EBDCNOP - E-Banking Domestic Customer File
   Πίνακας: DATACUT5."HUB_MT_EBDCNOP"   Shadow: ICMDFL = 'S' (εξαιρούνται)   Έλεγχοι: 3
   ============================================================================= */
    SELECT 'EBDCNOP - E-Banking Domestic Customer File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- EBDCNOP-001: Missing customer key (ICDCB/ICDCS)
          COUNT(CASE WHEN NVL(t."ICMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t1,
          COUNT(CASE WHEN NVL(t."ICMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."ICDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ICDCB")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ICDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ICDCS")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ICDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ICDCS")) END) = 0) THEN 1 END) AS f1,
          -- EBDCNOP-002: Invalid date: Last Update Date (ICDLUP)
          COUNT(CASE WHEN NVL(t."ICMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t2,
          COUNT(CASE WHEN NVL(t."ICMDFL",' ') &lt;&gt; 'S' AND ((NOT (TRIM(t."ICDLUP") IS NULL OR REGEXP_LIKE(TRIM(t."ICDLUP"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."ICDLUP"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."ICDLUP") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."ICDLUP")) END), 0) &lt; 19000101)) THEN 1 END) AS f2,
          -- EBDCNOP-003: Customer (ICDCB+ICDCS) not found in SSCUSTP
          COUNT(CASE WHEN NVL(t."ICMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."ICDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ICDCB")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ICDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ICDCS")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ICDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ICDCS")) END) &lt;&gt; 0) THEN 1 END) AS t3,
          COUNT(CASE WHEN NVL(t."ICMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."ICDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ICDCB")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ICDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ICDCS")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ICDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ICDCS")) END) &lt;&gt; 0) AND (j1.dcb IS NULL) THEN 1 END) AS f3
        FROM DATACUT5."HUB_MT_EBDCNOP" t
        CROSS JOIN params p
        LEFT JOIN k_cus j1 ON j1.dcb = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ICDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ICDCB")) END) AND j1.dcs = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ICDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ICDCS")) END)
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'EBDCNOP-001|Missing Data|Missing customer key (ICDCB/ICDCS)',
        (t2, f2) AS 'EBDCNOP-002|Invalid Dates|Invalid date: Last Update Date (ICDLUP)',
        (t3, f3) AS 'EBDCNOP-003|Missing Links|Customer (ICDCB+ICDCS) not found in SSCUSTP'
      ))
    UNION ALL
/* =============================================================================
   EUDTSDDP - EVPS - ACH Direct Debit
   Πίνακας: DATACUT5."HUB_MT_EUDTSDDP"   Shadow: δεν υπάρχει mode flag   Έλεγχοι: 3
   ============================================================================= */
    SELECT 'EUDTSDDP - EVPS - ACH Direct Debit' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- EUDTSDDP-001: Country of Residence DR (SDDCTY) not a valid country code (SSSTDPP CT)
          COUNT(CASE WHEN (TRIM(t."SDDCTY") IS NOT NULL) THEN 1 END) AS t1,
          COUNT(CASE WHEN (TRIM(t."SDDCTY") IS NOT NULL) AND (j1.code IS NULL) THEN 1 END) AS f1,
          -- EUDTSDDP-002: Invalid date: Transaction Date (SDTRDT)
          COUNT(CASE WHEN 1=1 THEN 1 END) AS t2,
          COUNT(CASE WHEN 1=1 AND ((NOT (TRIM(t."SDTRDT") IS NULL OR REGEXP_LIKE(TRIM(t."SDTRDT"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."SDTRDT"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."SDTRDT") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."SDTRDT")) END), 0) &lt; 19000101)) THEN 1 END) AS f2,
          -- EUDTSDDP-003: Invalid date: Last Update Date (SDDLUP)
          COUNT(CASE WHEN 1=1 THEN 1 END) AS t3,
          COUNT(CASE WHEN 1=1 AND ((NOT (TRIM(t."SDDLUP") IS NULL OR REGEXP_LIKE(TRIM(t."SDDLUP"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."SDDLUP"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."SDDLUP") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."SDDLUP")) END), 0) &lt; 19000101)) THEN 1 END) AS f3
        FROM DATACUT5."HUB_MT_EUDTSDDP" t
        CROSS JOIN params p
        LEFT JOIN ref_ct j1 ON j1.code = TRIM(t."SDDCTY")
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'EUDTSDDP-001|Invalid Values|Country of Residence DR (SDDCTY) not a valid country code (SSSTDPP CT)',
        (t2, f2) AS 'EUDTSDDP-002|Invalid Dates|Invalid date: Transaction Date (SDTRDT)',
        (t3, f3) AS 'EUDTSDDP-003|Invalid Dates|Invalid date: Last Update Date (SDDLUP)'
      ))
    UNION ALL
/* =============================================================================
   GLACMSP - General Ledger Account Master File
   Πίνακας: DATACUT5."HUB_MT_GLACMSP"   Shadow: GEMDFL = 'S' (εξαιρούνται)   Έλεγχοι: 8
   ============================================================================= */
    SELECT 'GLACMSP - General Ledger Account Master File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- GLACMSP-001: Missing account key (GEACB/GEACS/GEACX)
          COUNT(CASE WHEN NVL(t."GEMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t1,
          COUNT(CASE WHEN NVL(t."GEMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."GEACB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."GEACB")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."GEACB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."GEACB")) END) = 0 OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."GEACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."GEACS")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."GEACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."GEACS")) END) = 0 OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."GEACX") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."GEACX")) END) IS NULL) THEN 1 END) AS f1,
          -- GLACMSP-002: Invalid Exception Code (GEEXCD), allowed 0/1/2
          COUNT(CASE WHEN NVL(t."GEMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."GEEXCD") IS NOT NULL) THEN 1 END) AS t2,
          COUNT(CASE WHEN NVL(t."GEMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."GEEXCD") IS NOT NULL) AND (TRIM(t."GEEXCD") NOT IN ('0','1','2')) THEN 1 END) AS f2,
          -- GLACMSP-003: Invalid Statement Cycle (GESMCY), allowed A/B/D/F/H/M/Q/W/X/Y
          COUNT(CASE WHEN NVL(t."GEMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."GESMCY") IS NOT NULL) THEN 1 END) AS t3,
          COUNT(CASE WHEN NVL(t."GEMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."GESMCY") IS NOT NULL) AND (TRIM(t."GESMCY") NOT IN ('A','B','D','F','H','M','Q','W','X','Y')) THEN 1 END) AS f3,
          -- GLACMSP-004: Invalid Despatch Code (GEDPCD), allowed A/C/G/H/K/M/N/P/W
          COUNT(CASE WHEN NVL(t."GEMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."GEDPCD") IS NOT NULL) THEN 1 END) AS t4,
          COUNT(CASE WHEN NVL(t."GEMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."GEDPCD") IS NOT NULL) AND (TRIM(t."GEDPCD") NOT IN ('A','C','G','H','K','M','N','P','W')) THEN 1 END) AS f4,
          -- GLACMSP-005: Invalid date: Date Last Statement (GEDTLS)
          COUNT(CASE WHEN NVL(t."GEMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t5,
          COUNT(CASE WHEN NVL(t."GEMDFL",' ') &lt;&gt; 'S' AND ((NOT (TRIM(t."GEDTLS") IS NULL OR REGEXP_LIKE(TRIM(t."GEDTLS"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."GEDTLS"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."GEDTLS") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."GEDTLS")) END), 0) &lt; 19000101)) THEN 1 END) AS f5,
          -- GLACMSP-006: Invalid date: Date A/C Opened (GEDTAO)
          COUNT(CASE WHEN NVL(t."GEMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t6,
          COUNT(CASE WHEN NVL(t."GEMDFL",' ') &lt;&gt; 'S' AND ((NOT (TRIM(t."GEDTAO") IS NULL OR REGEXP_LIKE(TRIM(t."GEDTAO"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."GEDTAO"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."GEDTAO") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."GEDTAO")) END), 0) &lt; 19000101)) THEN 1 END) AS f6,
          -- GLACMSP-007: Invalid date: Date Last Transaction (GEDLTN)
          COUNT(CASE WHEN NVL(t."GEMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t7,
          COUNT(CASE WHEN NVL(t."GEMDFL",' ') &lt;&gt; 'S' AND ((NOT (TRIM(t."GEDLTN") IS NULL OR REGEXP_LIKE(TRIM(t."GEDLTN"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."GEDLTN"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."GEDLTN") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."GEDLTN")) END), 0) &lt; 19000101)) THEN 1 END) AS f7,
          -- GLACMSP-008: Invalid date: Last Update Date (GEDLUP)
          COUNT(CASE WHEN NVL(t."GEMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t8,
          COUNT(CASE WHEN NVL(t."GEMDFL",' ') &lt;&gt; 'S' AND ((NOT (TRIM(t."GEDLUP") IS NULL OR REGEXP_LIKE(TRIM(t."GEDLUP"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."GEDLUP"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."GEDLUP") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."GEDLUP")) END), 0) &lt; 19000101)) THEN 1 END) AS f8
        FROM DATACUT5."HUB_MT_GLACMSP" t
        CROSS JOIN params p
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'GLACMSP-001|Missing Data|Missing account key (GEACB/GEACS/GEACX)',
        (t2, f2) AS 'GLACMSP-002|Invalid Values|Invalid Exception Code (GEEXCD), allowed 0/1/2',
        (t3, f3) AS 'GLACMSP-003|Invalid Values|Invalid Statement Cycle (GESMCY), allowed A/B/D/F/H/M/Q/W/X/Y',
        (t4, f4) AS 'GLACMSP-004|Invalid Values|Invalid Despatch Code (GEDPCD), allowed A/C/G/H/K/M/N/P/W',
        (t5, f5) AS 'GLACMSP-005|Invalid Dates|Invalid date: Date Last Statement (GEDTLS)',
        (t6, f6) AS 'GLACMSP-006|Invalid Dates|Invalid date: Date A/C Opened (GEDTAO)',
        (t7, f7) AS 'GLACMSP-007|Invalid Dates|Invalid date: Date Last Transaction (GEDLTN)',
        (t8, f8) AS 'GLACMSP-008|Invalid Dates|Invalid date: Last Update Date (GEDLUP)'
      ))
    UNION ALL
/* =============================================================================
   IBACIDP - IB Account ID File
   Πίνακας: DATACUT5."HUB_MT_IBACIDP"   Shadow: IAMDFL = 'S' (εξαιρούνται)   Έλεγχοι: 2
   ============================================================================= */
    SELECT 'IBACIDP - IB Account ID File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- IBACIDP-001: Missing account key (IAACB/IAACS/IAACX)
          COUNT(CASE WHEN NVL(t."IAMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t1,
          COUNT(CASE WHEN NVL(t."IAMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."IAACB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."IAACB")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."IAACB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."IAACB")) END) = 0 OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."IAACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."IAACS")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."IAACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."IAACS")) END) = 0 OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."IAACX") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."IAACX")) END) IS NULL) THEN 1 END) AS f1,
          -- IBACIDP-002: Invalid date: Last Update Date (IADLUP)
          COUNT(CASE WHEN NVL(t."IAMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t2,
          COUNT(CASE WHEN NVL(t."IAMDFL",' ') &lt;&gt; 'S' AND ((NOT (TRIM(t."IADLUP") IS NULL OR REGEXP_LIKE(TRIM(t."IADLUP"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."IADLUP"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."IADLUP") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."IADLUP")) END), 0) &lt; 19000101)) THEN 1 END) AS f2
        FROM DATACUT5."HUB_MT_IBACIDP" t
        CROSS JOIN params p
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'IBACIDP-001|Missing Data|Missing account key (IAACB/IAACS/IAACX)',
        (t2, f2) AS 'IBACIDP-002|Invalid Dates|Invalid date: Last Update Date (IADLUP)'
      ))
    UNION ALL
/* =============================================================================
   LS@FBIP - LS FRINGE BENEFITS DETAIL FILE
   Πίνακας: DATACUT5."HUB_MT_LS@FBIP"   Shadow: δεν υπάρχει mode flag   Έλεγχοι: 5
   ============================================================================= */
    SELECT 'LS@FBIP - LS FRINGE BENEFITS DETAIL FILE' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- LS_FBIP-001: Missing customer key (FBDCB/FBDCS)
          COUNT(CASE WHEN 1=1 THEN 1 END) AS t1,
          COUNT(CASE WHEN 1=1 AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."FBDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."FBDCB")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."FBDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."FBDCS")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."FBDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."FBDCS")) END) = 0) THEN 1 END) AS f1,
          -- LS_FBIP-002: Missing account key (FBACB/FBACS/FBACX)
          COUNT(CASE WHEN 1=1 THEN 1 END) AS t2,
          COUNT(CASE WHEN 1=1 AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."FBACB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."FBACB")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."FBACB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."FBACB")) END) = 0 OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."FBACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."FBACS")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."FBACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."FBACS")) END) = 0 OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."FBACX") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."FBACX")) END) IS NULL) THEN 1 END) AS f2,
          -- LS_FBIP-003: Invalid date: LAST INTEREST CALCULATION DATE (FBLICD)
          COUNT(CASE WHEN 1=1 THEN 1 END) AS t3,
          COUNT(CASE WHEN 1=1 AND ((NOT (TRIM(t."FBLICD") IS NULL OR REGEXP_LIKE(TRIM(t."FBLICD"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."FBLICD"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."FBLICD") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."FBLICD")) END), 0) &lt; 19000101)) THEN 1 END) AS f3,
          -- LS_FBIP-004: Customer (FBDCB+FBDCS) not found in SSCUSTP
          COUNT(CASE WHEN ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."FBDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."FBDCB")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."FBDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."FBDCS")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."FBDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."FBDCS")) END) &lt;&gt; 0) THEN 1 END) AS t4,
          COUNT(CASE WHEN ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."FBDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."FBDCB")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."FBDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."FBDCS")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."FBDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."FBDCS")) END) &lt;&gt; 0) AND (j1.dcb IS NULL) THEN 1 END) AS f4,
          -- LS_FBIP-005: Account (FBACB+FBACS+FBACX) not found in LSACMSP
          COUNT(CASE WHEN ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."FBACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."FBACS")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."FBACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."FBACS")) END) &lt;&gt; 0) THEN 1 END) AS t5,
          COUNT(CASE WHEN ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."FBACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."FBACS")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."FBACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."FBACS")) END) &lt;&gt; 0) AND (j2.k1 IS NULL) THEN 1 END) AS f5
        FROM DATACUT5."HUB_MT_LS@FBIP" t
        CROSS JOIN params p
        LEFT JOIN k_cus j1 ON j1.dcb = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."FBDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."FBDCB")) END) AND j1.dcs = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."FBDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."FBDCS")) END)
        LEFT JOIN k_acc_LSACMSP j2 ON j2.k1 = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."FBACB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."FBACB")) END) AND j2.k2 = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."FBACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."FBACS")) END) AND j2.k3 = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."FBACX") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."FBACX")) END)
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'LS_FBIP-001|Missing Data|Missing customer key (FBDCB/FBDCS)',
        (t2, f2) AS 'LS_FBIP-002|Missing Data|Missing account key (FBACB/FBACS/FBACX)',
        (t3, f3) AS 'LS_FBIP-003|Invalid Dates|Invalid date: LAST INTEREST CALCULATION DATE (FBLICD)',
        (t4, f4) AS 'LS_FBIP-004|Missing Links|Customer (FBDCB+FBDCS) not found in SSCUSTP',
        (t5, f5) AS 'LS_FBIP-005|Missing Links|Account (FBACB+FBACS+FBACX) not found in LSACMSP'
      ))
    UNION ALL
/* =============================================================================
   LS@INACP - LS LOCAL INTEREST ACCRUAL DETAIL FILE
   Πίνακας: DATACUT5."HUB_MT_LS@INACP"   Shadow: δεν υπάρχει mode flag   Έλεγχοι: 4
   ============================================================================= */
    SELECT 'LS@INACP - LS LOCAL INTEREST ACCRUAL DETAIL FILE' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- LS_INACP-001: Missing account key (E1ACB/E1ACS/E1ACX)
          COUNT(CASE WHEN 1=1 THEN 1 END) AS t1,
          COUNT(CASE WHEN 1=1 AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."E1ACB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."E1ACB")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."E1ACB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."E1ACB")) END) = 0 OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."E1ACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."E1ACS")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."E1ACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."E1ACS")) END) = 0 OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."E1ACX") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."E1ACX")) END) IS NULL) THEN 1 END) AS f1,
          -- LS_INACP-002: Invalid date: LAST INTEREST CALCULATION DATE (E1LICD)
          COUNT(CASE WHEN 1=1 THEN 1 END) AS t2,
          COUNT(CASE WHEN 1=1 AND ((NOT (TRIM(t."E1LICD") IS NULL OR REGEXP_LIKE(TRIM(t."E1LICD"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."E1LICD"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."E1LICD") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."E1LICD")) END), 0) &lt; 19000101)) THEN 1 END) AS f2,
          -- LS_INACP-003: Invalid date: LAST UPDATE DATE (E1DLUP)
          COUNT(CASE WHEN 1=1 THEN 1 END) AS t3,
          COUNT(CASE WHEN 1=1 AND ((NOT (TRIM(t."E1DLUP") IS NULL OR REGEXP_LIKE(TRIM(t."E1DLUP"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."E1DLUP"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."E1DLUP") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."E1DLUP")) END), 0) &lt; 19000101)) THEN 1 END) AS f3,
          -- LS_INACP-004: Account (E1ACB+E1ACS+E1ACX) not found in LSACMSP
          COUNT(CASE WHEN ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."E1ACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."E1ACS")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."E1ACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."E1ACS")) END) &lt;&gt; 0) THEN 1 END) AS t4,
          COUNT(CASE WHEN ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."E1ACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."E1ACS")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."E1ACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."E1ACS")) END) &lt;&gt; 0) AND (j1.k1 IS NULL) THEN 1 END) AS f4
        FROM DATACUT5."HUB_MT_LS@INACP" t
        CROSS JOIN params p
        LEFT JOIN k_acc_LSACMSP j1 ON j1.k1 = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."E1ACB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."E1ACB")) END) AND j1.k2 = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."E1ACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."E1ACS")) END) AND j1.k3 = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."E1ACX") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."E1ACX")) END)
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'LS_INACP-001|Missing Data|Missing account key (E1ACB/E1ACS/E1ACX)',
        (t2, f2) AS 'LS_INACP-002|Invalid Dates|Invalid date: LAST INTEREST CALCULATION DATE (E1LICD)',
        (t3, f3) AS 'LS_INACP-003|Invalid Dates|Invalid date: LAST UPDATE DATE (E1DLUP)',
        (t4, f4) AS 'LS_INACP-004|Missing Links|Account (E1ACB+E1ACS+E1ACX) not found in LSACMSP'
      ))
    UNION ALL
/* =============================================================================
   LS@INSLP - LS LOCAL INTEREST CALCULATION FILE
   Πίνακας: DATACUT5."HUB_MT_LS@INSLP"   Shadow: RQMDFL = 'S' (εξαιρούνται)   Έλεγχοι: 2
   ============================================================================= */
    SELECT 'LS@INSLP - LS LOCAL INTEREST CALCULATION FILE' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- LS_INSLP-001: Missing account key (RQACB/RQACS/RQACX)
          COUNT(CASE WHEN NVL(t."RQMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t1,
          COUNT(CASE WHEN NVL(t."RQMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."RQACB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."RQACB")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."RQACB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."RQACB")) END) = 0 OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."RQACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."RQACS")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."RQACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."RQACS")) END) = 0 OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."RQACX") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."RQACX")) END) IS NULL) THEN 1 END) AS f1,
          -- LS_INSLP-002: Account (RQACB+RQACS+RQACX) not found in LSACMSP
          COUNT(CASE WHEN NVL(t."RQMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."RQACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."RQACS")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."RQACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."RQACS")) END) &lt;&gt; 0) THEN 1 END) AS t2,
          COUNT(CASE WHEN NVL(t."RQMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."RQACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."RQACS")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."RQACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."RQACS")) END) &lt;&gt; 0) AND (j1.k1 IS NULL) THEN 1 END) AS f2
        FROM DATACUT5."HUB_MT_LS@INSLP" t
        CROSS JOIN params p
        LEFT JOIN k_acc_LSACMSP j1 ON j1.k1 = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."RQACB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."RQACB")) END) AND j1.k2 = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."RQACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."RQACS")) END) AND j1.k3 = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."RQACX") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."RQACX")) END)
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'LS_INSLP-001|Missing Data|Missing account key (RQACB/RQACS/RQACX)',
        (t2, f2) AS 'LS_INSLP-002|Missing Links|Account (RQACB+RQACS+RQACX) not found in LSACMSP'
      ))
    UNION ALL
/* =============================================================================
   LS@OLMP - LS Original Limit and Maturity Date
   Πίνακας: DATACUT5."HUB_MT_LS@OLMP"   Shadow: δεν υπάρχει mode flag   Έλεγχοι: 3
   ============================================================================= */
    SELECT 'LS@OLMP - LS Original Limit and Maturity Date' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- LS_OLMP-001: Missing account key (OLACB/OLACS/OLACX)
          COUNT(CASE WHEN 1=1 THEN 1 END) AS t1,
          COUNT(CASE WHEN 1=1 AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."OLACB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."OLACB")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."OLACB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."OLACB")) END) = 0 OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."OLACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."OLACS")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."OLACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."OLACS")) END) = 0 OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."OLACX") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."OLACX")) END) IS NULL) THEN 1 END) AS f1,
          -- LS_OLMP-002: Invalid date: Original Maturity Date (OLMTDT)
          COUNT(CASE WHEN 1=1 THEN 1 END) AS t2,
          COUNT(CASE WHEN 1=1 AND ((NOT (TRIM(t."OLMTDT") IS NULL OR REGEXP_LIKE(TRIM(t."OLMTDT"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."OLMTDT"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."OLMTDT") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."OLMTDT")) END), 0) &lt; 19000101)) THEN 1 END) AS f2,
          -- LS_OLMP-003: Account (OLACB+OLACS+OLACX) not found in LSACMSP
          COUNT(CASE WHEN ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."OLACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."OLACS")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."OLACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."OLACS")) END) &lt;&gt; 0) THEN 1 END) AS t3,
          COUNT(CASE WHEN ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."OLACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."OLACS")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."OLACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."OLACS")) END) &lt;&gt; 0) AND (j1.k1 IS NULL) THEN 1 END) AS f3
        FROM DATACUT5."HUB_MT_LS@OLMP" t
        CROSS JOIN params p
        LEFT JOIN k_acc_LSACMSP j1 ON j1.k1 = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."OLACB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."OLACB")) END) AND j1.k2 = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."OLACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."OLACS")) END) AND j1.k3 = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."OLACX") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."OLACX")) END)
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'LS_OLMP-001|Missing Data|Missing account key (OLACB/OLACS/OLACX)',
        (t2, f2) AS 'LS_OLMP-002|Invalid Dates|Invalid date: Original Maturity Date (OLMTDT)',
        (t3, f3) AS 'LS_OLMP-003|Missing Links|Account (OLACB+OLACS+OLACX) not found in LSACMSP'
      ))
    UNION ALL
/* =============================================================================
   LS@RPACP - LS Local Repayment Account File
   Πίνακας: DATACUT5."HUB_MT_LS@RPACP"   Shadow: PQMDFL = 'S' (εξαιρούνται)   Έλεγχοι: 3
   ============================================================================= */
    SELECT 'LS@RPACP - LS Local Repayment Account File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- LS_RPACP-001: Missing account key (PQACB/PQACS/PQACX)
          COUNT(CASE WHEN NVL(t."PQMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t1,
          COUNT(CASE WHEN NVL(t."PQMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."PQACB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."PQACB")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."PQACB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."PQACB")) END) = 0 OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."PQACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."PQACS")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."PQACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."PQACS")) END) = 0 OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."PQACX") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."PQACX")) END) IS NULL) THEN 1 END) AS f1,
          -- LS_RPACP-002: Invalid date: LAST UPDATE DATE (PQDLUP)
          COUNT(CASE WHEN NVL(t."PQMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t2,
          COUNT(CASE WHEN NVL(t."PQMDFL",' ') &lt;&gt; 'S' AND ((NOT (TRIM(t."PQDLUP") IS NULL OR REGEXP_LIKE(TRIM(t."PQDLUP"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."PQDLUP"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."PQDLUP") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."PQDLUP")) END), 0) &lt; 19000101)) THEN 1 END) AS f2,
          -- LS_RPACP-003: Account (PQACB+PQACS+PQACX) not found in LSACMSP
          COUNT(CASE WHEN NVL(t."PQMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."PQACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."PQACS")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."PQACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."PQACS")) END) &lt;&gt; 0) THEN 1 END) AS t3,
          COUNT(CASE WHEN NVL(t."PQMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."PQACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."PQACS")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."PQACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."PQACS")) END) &lt;&gt; 0) AND (j1.k1 IS NULL) THEN 1 END) AS f3
        FROM DATACUT5."HUB_MT_LS@RPACP" t
        CROSS JOIN params p
        LEFT JOIN k_acc_LSACMSP j1 ON j1.k1 = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."PQACB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."PQACB")) END) AND j1.k2 = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."PQACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."PQACS")) END) AND j1.k3 = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."PQACX") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."PQACX")) END)
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'LS_RPACP-001|Missing Data|Missing account key (PQACB/PQACS/PQACX)',
        (t2, f2) AS 'LS_RPACP-002|Invalid Dates|Invalid date: LAST UPDATE DATE (PQDLUP)',
        (t3, f3) AS 'LS_RPACP-003|Missing Links|Account (PQACB+PQACS+PQACX) not found in LSACMSP'
      ))
    UNION ALL
/* =============================================================================
   LSACMSP - LS ACCOUNT MASTER FILE
   Πίνακας: DATACUT5."HUB_MT_LSACMSP"   Shadow: POMDFL = 'S' (εξαιρούνται)   Έλεγχοι: 22
   ============================================================================= */
    SELECT 'LSACMSP - LS ACCOUNT MASTER FILE' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- LSACMSP-001: Missing customer key (PODCB/PODCS)
          COUNT(CASE WHEN NVL(t."POMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t1,
          COUNT(CASE WHEN NVL(t."POMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."PODCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."PODCB")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."PODCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."PODCS")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."PODCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."PODCS")) END) = 0) THEN 1 END) AS f1,
          -- LSACMSP-002: Missing account key (POACB/POACS/POACX)
          COUNT(CASE WHEN NVL(t."POMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t2,
          COUNT(CASE WHEN NVL(t."POMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."POACB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."POACB")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."POACB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."POACB")) END) = 0 OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."POACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."POACS")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."POACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."POACS")) END) = 0 OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."POACX") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."POACX")) END) IS NULL) THEN 1 END) AS f2,
          -- LSACMSP-003: Invalid FACILITY CATEGORY CODE (POFCCC), allowed A/B/C
          COUNT(CASE WHEN NVL(t."POMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."POFCCC") IS NOT NULL) THEN 1 END) AS t3,
          COUNT(CASE WHEN NVL(t."POMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."POFCCC") IS NOT NULL) AND (TRIM(t."POFCCC") NOT IN ('A','B','C')) THEN 1 END) AS f3,
          -- LSACMSP-004: Invalid RESTRICTION (PORSTR), allowed 1/2/3/4/5/6
          COUNT(CASE WHEN NVL(t."POMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."PORSTR") IS NOT NULL) THEN 1 END) AS t4,
          COUNT(CASE WHEN NVL(t."POMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."PORSTR") IS NOT NULL) AND (TRIM(t."PORSTR") NOT IN ('1','2','3','4','5','6')) THEN 1 END) AS f4,
          -- LSACMSP-005: Invalid STATUS (POSTUS), allowed 1/2/3/4/5/6/7/A/B/C/E/S
          COUNT(CASE WHEN NVL(t."POMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."POSTUS") IS NOT NULL) THEN 1 END) AS t5,
          COUNT(CASE WHEN NVL(t."POMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."POSTUS") IS NOT NULL) AND (TRIM(t."POSTUS") NOT IN ('1','2','3','4','5','6','7','A','B','C','E','S')) THEN 1 END) AS f5,
          -- LSACMSP-006: Invalid MATURITY (REMAINING MATURITY) (POMTCD), allowed A/B/C/D/E/F/G/H/I/J/P/Q/R/S/T
          COUNT(CASE WHEN NVL(t."POMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."POMTCD") IS NOT NULL) THEN 1 END) AS t6,
          COUNT(CASE WHEN NVL(t."POMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."POMTCD") IS NOT NULL) AND (TRIM(t."POMTCD") NOT IN ('A','B','C','D','E','F','G','H','I','J','P','Q','R','S','T')) THEN 1 END) AS f6,
          -- LSACMSP-007: Invalid LANGUAGE CODE (POLANG), allowed 1/2/3/P/S
          COUNT(CASE WHEN NVL(t."POMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."POLANG") IS NOT NULL) THEN 1 END) AS t7,
          COUNT(CASE WHEN NVL(t."POMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."POLANG") IS NOT NULL) AND (TRIM(t."POLANG") NOT IN ('1','2','3','P','S')) THEN 1 END) AS f7,
          -- LSACMSP-008: Invalid DESPATCH CODE (PODPCD), allowed A/C/G/H/K/M/N/P/W
          COUNT(CASE WHEN NVL(t."POMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."PODPCD") IS NOT NULL) THEN 1 END) AS t8,
          COUNT(CASE WHEN NVL(t."POMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."PODPCD") IS NOT NULL) AND (TRIM(t."PODPCD") NOT IN ('A','C','G','H','K','M','N','P','W')) THEN 1 END) AS f8,
          -- LSACMSP-009: Invalid INSTALMENT ADJUSTMENT FOR HOLIDAY :1 - BEFORE (POIAJH), allowed 1/2/3/4
          COUNT(CASE WHEN NVL(t."POMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."POIAJH") IS NOT NULL) THEN 1 END) AS t9,
          COUNT(CASE WHEN NVL(t."POMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."POIAJH") IS NOT NULL) AND (TRIM(t."POIAJH") NOT IN ('1','2','3','4')) THEN 1 END) AS f9,
          -- LSACMSP-010: Invalid HOLIDAY ADJUSTMENT FOR INTEREST COLLECTION(2, 4) (POSAJH), allowed 2/4
          COUNT(CASE WHEN NVL(t."POMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."POSAJH") IS NOT NULL) THEN 1 END) AS t10,
          COUNT(CASE WHEN NVL(t."POMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."POSAJH") IS NOT NULL) AND (TRIM(t."POSAJH") NOT IN ('2','4')) THEN 1 END) AS f10,
          -- LSACMSP-011: Invalid OVERDUE INTEREST INSTRUCTION CODE (POOIIC), allowed 0/1
          COUNT(CASE WHEN NVL(t."POMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."POOIIC") IS NOT NULL) THEN 1 END) AS t11,
          COUNT(CASE WHEN NVL(t."POMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."POOIIC") IS NOT NULL) AND (TRIM(t."POOIIC") NOT IN ('0','1')) THEN 1 END) AS f11,
          -- LSACMSP-012: Invalid ROLLOVER INSTRUCTION (POLRIN), allowed 0/1/2
          COUNT(CASE WHEN NVL(t."POMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."POLRIN") IS NOT NULL) THEN 1 END) AS t12,
          COUNT(CASE WHEN NVL(t."POMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."POLRIN") IS NOT NULL) AND (TRIM(t."POLRIN") NOT IN ('0','1','2')) THEN 1 END) AS f12,
          -- LSACMSP-013: Invalid date: DATE A/C OPENED (PODTAO)
          COUNT(CASE WHEN NVL(t."POMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t13,
          COUNT(CASE WHEN NVL(t."POMDFL",' ') &lt;&gt; 'S' AND ((NOT (TRIM(t."PODTAO") IS NULL OR REGEXP_LIKE(TRIM(t."PODTAO"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."PODTAO"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."PODTAO") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."PODTAO")) END), 0) &lt; 19000101)) THEN 1 END) AS f13,
          -- LSACMSP-014: Invalid date: DATE LAST ACTIVITY (PODLAC)
          COUNT(CASE WHEN NVL(t."POMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t14,
          COUNT(CASE WHEN NVL(t."POMDFL",' ') &lt;&gt; 'S' AND ((NOT (TRIM(t."PODLAC") IS NULL OR REGEXP_LIKE(TRIM(t."PODLAC"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."PODLAC"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."PODLAC") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."PODLAC")) END), 0) &lt; 19000101)) THEN 1 END) AS f14,
          -- LSACMSP-015: Invalid date: LAST INTEREST APPLICATION DATE (POLIAD)
          COUNT(CASE WHEN NVL(t."POMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t15,
          COUNT(CASE WHEN NVL(t."POMDFL",' ') &lt;&gt; 'S' AND ((NOT (TRIM(t."POLIAD") IS NULL OR REGEXP_LIKE(TRIM(t."POLIAD"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."POLIAD"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."POLIAD") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."POLIAD")) END), 0) &lt; 19000101)) THEN 1 END) AS f15,
          -- LSACMSP-016: Invalid date: LAST LAST INTEREST APPLICATION DATE (POLLIA)
          COUNT(CASE WHEN NVL(t."POMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t16,
          COUNT(CASE WHEN NVL(t."POMDFL",' ') &lt;&gt; 'S' AND ((NOT (TRIM(t."POLLIA") IS NULL OR REGEXP_LIKE(TRIM(t."POLLIA"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."POLLIA"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."POLLIA") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."POLLIA")) END), 0) &lt; 19000101)) THEN 1 END) AS f16,
          -- LSACMSP-017: Invalid date: BLOCK CODE DATE LAST UPDATE (POBDUP)
          COUNT(CASE WHEN NVL(t."POMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t17,
          COUNT(CASE WHEN NVL(t."POMDFL",' ') &lt;&gt; 'S' AND ((NOT (TRIM(t."POBDUP") IS NULL OR REGEXP_LIKE(TRIM(t."POBDUP"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."POBDUP"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."POBDUP") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."POBDUP")) END), 0) &lt; 19000101)) THEN 1 END) AS f17,
          -- LSACMSP-018: Invalid date: LAST UPDATE DATE (PODLUP)
          COUNT(CASE WHEN NVL(t."POMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t18,
          COUNT(CASE WHEN NVL(t."POMDFL",' ') &lt;&gt; 'S' AND ((NOT (TRIM(t."PODLUP") IS NULL OR REGEXP_LIKE(TRIM(t."PODLUP"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."PODLUP"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."PODLUP") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."PODLUP")) END), 0) &lt; 19000101)) THEN 1 END) AS f18,
          -- LSACMSP-019: Duplicate account key (POACB+POACS+POACX)
          COUNT(CASE WHEN NVL(t."POMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."POACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."POACS")) END) IS NOT NULL) THEN 1 END) AS t19,
          COUNT(CASE WHEN NVL(t."POMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."POACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."POACS")) END) IS NOT NULL) AND (t.dq_dup19 &gt; 1) THEN 1 END) AS f19,
          -- LSACMSP-020: Customer (PODCB+PODCS) not found in SSCUSTP
          COUNT(CASE WHEN NVL(t."POMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."PODCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."PODCB")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."PODCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."PODCS")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."PODCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."PODCS")) END) &lt;&gt; 0) THEN 1 END) AS t20,
          COUNT(CASE WHEN NVL(t."POMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."PODCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."PODCB")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."PODCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."PODCS")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."PODCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."PODCS")) END) &lt;&gt; 0) AND (j1.dcb IS NULL) THEN 1 END) AS f20,
          -- LSACMSP-B01: Negative outstanding principal on open loan (POROPR &lt; 0)
          COUNT(CASE WHEN NVL(t."POMDFL",' ') &lt;&gt; 'S' AND (NVL(TRIM(t."POSTUS"),'#') NOT IN ('4','5')) THEN 1 END) AS t21,
          COUNT(CASE WHEN NVL(t."POMDFL",' ') &lt;&gt; 'S' AND (NVL(TRIM(t."POSTUS"),'#') NOT IN ('4','5')) AND (NVL((CASE WHEN VALIDATE_CONVERSION(TRIM(t."POROPR") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."POROPR")) END),0) &lt; 0) THEN 1 END) AS f21,
          -- LSACMSP-B02: Closed loan with outstanding principal (POSTUS=5, POROPR)
          COUNT(CASE WHEN NVL(t."POMDFL",' ') &lt;&gt; 'S' AND (NVL(TRIM(t."POSTUS"),'#') = '5') THEN 1 END) AS t22,
          COUNT(CASE WHEN NVL(t."POMDFL",' ') &lt;&gt; 'S' AND (NVL(TRIM(t."POSTUS"),'#') = '5') AND (NVL((CASE WHEN VALIDATE_CONVERSION(TRIM(t."POROPR") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."POROPR")) END),0) &lt;&gt; 0) THEN 1 END) AS f22
        FROM (SELECT x.*,
                     COUNT(CASE WHEN NVL("POMDFL",' ') &lt;&gt; 'S' THEN 1 END) OVER (PARTITION BY "POACB", "POACS", "POACX") AS dq_dup19
                FROM DATACUT5."HUB_MT_LSACMSP" x) t
        CROSS JOIN params p
        LEFT JOIN k_cus j1 ON j1.dcb = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."PODCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."PODCB")) END) AND j1.dcs = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."PODCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."PODCS")) END)
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'LSACMSP-001|Missing Data|Missing customer key (PODCB/PODCS)',
        (t2, f2) AS 'LSACMSP-002|Missing Data|Missing account key (POACB/POACS/POACX)',
        (t3, f3) AS 'LSACMSP-003|Invalid Values|Invalid FACILITY CATEGORY CODE (POFCCC), allowed A/B/C',
        (t4, f4) AS 'LSACMSP-004|Invalid Values|Invalid RESTRICTION (PORSTR), allowed 1/2/3/4/5/6',
        (t5, f5) AS 'LSACMSP-005|Invalid Values|Invalid STATUS (POSTUS), allowed 1/2/3/4/5/6/7/A/B/C/E/S',
        (t6, f6) AS 'LSACMSP-006|Invalid Values|Invalid MATURITY (REMAINING MATURITY) (POMTCD), allowed A/B/C/D/E/F/G/H/I/J/P/Q/R/S/T',
        (t7, f7) AS 'LSACMSP-007|Invalid Values|Invalid LANGUAGE CODE (POLANG), allowed 1/2/3/P/S',
        (t8, f8) AS 'LSACMSP-008|Invalid Values|Invalid DESPATCH CODE (PODPCD), allowed A/C/G/H/K/M/N/P/W',
        (t9, f9) AS 'LSACMSP-009|Invalid Values|Invalid INSTALMENT ADJUSTMENT FOR HOLIDAY :1 - BEFORE (POIAJH), allowed 1/2/3/4',
        (t10, f10) AS 'LSACMSP-010|Invalid Values|Invalid HOLIDAY ADJUSTMENT FOR INTEREST COLLECTION(2, 4) (POSAJH), allowed 2/4',
        (t11, f11) AS 'LSACMSP-011|Invalid Values|Invalid OVERDUE INTEREST INSTRUCTION CODE (POOIIC), allowed 0/1',
        (t12, f12) AS 'LSACMSP-012|Invalid Values|Invalid ROLLOVER INSTRUCTION (POLRIN), allowed 0/1/2',
        (t13, f13) AS 'LSACMSP-013|Invalid Dates|Invalid date: DATE A/C OPENED (PODTAO)',
        (t14, f14) AS 'LSACMSP-014|Invalid Dates|Invalid date: DATE LAST ACTIVITY (PODLAC)',
        (t15, f15) AS 'LSACMSP-015|Invalid Dates|Invalid date: LAST INTEREST APPLICATION DATE (POLIAD)',
        (t16, f16) AS 'LSACMSP-016|Invalid Dates|Invalid date: LAST LAST INTEREST APPLICATION DATE (POLLIA)',
        (t17, f17) AS 'LSACMSP-017|Invalid Dates|Invalid date: BLOCK CODE DATE LAST UPDATE (POBDUP)',
        (t18, f18) AS 'LSACMSP-018|Invalid Dates|Invalid date: LAST UPDATE DATE (PODLUP)',
        (t19, f19) AS 'LSACMSP-019|Duplicates|Duplicate account key (POACB+POACS+POACX)',
        (t20, f20) AS 'LSACMSP-020|Missing Links|Customer (PODCB+PODCS) not found in SSCUSTP',
        (t21, f21) AS 'LSACMSP-B01|Balances|Negative outstanding principal on open loan (POROPR &lt; 0)',
        (t22, f22) AS 'LSACMSP-B02|Balances|Closed loan with outstanding principal (POSTUS=5, POROPR)'
      ))
    UNION ALL
/* =============================================================================
   LSILRSP - LS IRREGULAR LOAN REPAYMENT SCHEDULE FILE
   Πίνακας: DATACUT5."HUB_MT_LSILRSP"   Shadow: IOMDFL = 'S' (εξαιρούνται)   Έλεγχοι: 3
   ============================================================================= */
    SELECT 'LSILRSP - LS IRREGULAR LOAN REPAYMENT SCHEDULE FILE' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- LSILRSP-001: Missing account key (IOACB/IOACS/IOACX)
          COUNT(CASE WHEN NVL(t."IOMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t1,
          COUNT(CASE WHEN NVL(t."IOMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."IOACB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."IOACB")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."IOACB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."IOACB")) END) = 0 OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."IOACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."IOACS")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."IOACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."IOACS")) END) = 0 OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."IOACX") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."IOACX")) END) IS NULL) THEN 1 END) AS f1,
          -- LSILRSP-002: Invalid date: LAST UPDATE DATE (IODLUP)
          COUNT(CASE WHEN NVL(t."IOMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t2,
          COUNT(CASE WHEN NVL(t."IOMDFL",' ') &lt;&gt; 'S' AND ((NOT (TRIM(t."IODLUP") IS NULL OR REGEXP_LIKE(TRIM(t."IODLUP"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."IODLUP"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."IODLUP") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."IODLUP")) END), 0) &lt; 19000101)) THEN 1 END) AS f2,
          -- LSILRSP-003: Account (IOACB+IOACS+IOACX) not found in LSACMSP
          COUNT(CASE WHEN NVL(t."IOMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."IOACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."IOACS")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."IOACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."IOACS")) END) &lt;&gt; 0) THEN 1 END) AS t3,
          COUNT(CASE WHEN NVL(t."IOMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."IOACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."IOACS")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."IOACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."IOACS")) END) &lt;&gt; 0) AND (j1.k1 IS NULL) THEN 1 END) AS f3
        FROM DATACUT5."HUB_MT_LSILRSP" t
        CROSS JOIN params p
        LEFT JOIN k_acc_LSACMSP j1 ON j1.k1 = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."IOACB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."IOACB")) END) AND j1.k2 = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."IOACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."IOACS")) END) AND j1.k3 = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."IOACX") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."IOACX")) END)
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'LSILRSP-001|Missing Data|Missing account key (IOACB/IOACS/IOACX)',
        (t2, f2) AS 'LSILRSP-002|Invalid Dates|Invalid date: LAST UPDATE DATE (IODLUP)',
        (t3, f3) AS 'LSILRSP-003|Missing Links|Account (IOACB+IOACS+IOACX) not found in LSACMSP'
      ))
    UNION ALL
/* =============================================================================
   LSINACP - LS INTEREST ACCRUAL DETAIL FILE
   Πίνακας: DATACUT5."HUB_MT_LSINACP"   Shadow: EQMDFL = 'S' (εξαιρούνται)   Έλεγχοι: 4
   ============================================================================= */
    SELECT 'LSINACP - LS INTEREST ACCRUAL DETAIL FILE' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- LSINACP-001: Missing account key (EQACB/EQACS/EQACX)
          COUNT(CASE WHEN NVL(t."EQMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t1,
          COUNT(CASE WHEN NVL(t."EQMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."EQACB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."EQACB")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."EQACB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."EQACB")) END) = 0 OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."EQACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."EQACS")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."EQACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."EQACS")) END) = 0 OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."EQACX") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."EQACX")) END) IS NULL) THEN 1 END) AS f1,
          -- LSINACP-002: Invalid date: LAST INTEREST CALCULATION DATE (EQLICD)
          COUNT(CASE WHEN NVL(t."EQMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t2,
          COUNT(CASE WHEN NVL(t."EQMDFL",' ') &lt;&gt; 'S' AND ((NOT (TRIM(t."EQLICD") IS NULL OR REGEXP_LIKE(TRIM(t."EQLICD"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."EQLICD"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."EQLICD") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."EQLICD")) END), 0) &lt; 19000101)) THEN 1 END) AS f2,
          -- LSINACP-003: Invalid date: LAST UPDATE DATE (EQDLUP)
          COUNT(CASE WHEN NVL(t."EQMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t3,
          COUNT(CASE WHEN NVL(t."EQMDFL",' ') &lt;&gt; 'S' AND ((NOT (TRIM(t."EQDLUP") IS NULL OR REGEXP_LIKE(TRIM(t."EQDLUP"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."EQDLUP"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."EQDLUP") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."EQDLUP")) END), 0) &lt; 19000101)) THEN 1 END) AS f3,
          -- LSINACP-004: Account (EQACB+EQACS+EQACX) not found in LSACMSP
          COUNT(CASE WHEN NVL(t."EQMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."EQACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."EQACS")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."EQACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."EQACS")) END) &lt;&gt; 0) THEN 1 END) AS t4,
          COUNT(CASE WHEN NVL(t."EQMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."EQACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."EQACS")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."EQACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."EQACS")) END) &lt;&gt; 0) AND (j1.k1 IS NULL) THEN 1 END) AS f4
        FROM DATACUT5."HUB_MT_LSINACP" t
        CROSS JOIN params p
        LEFT JOIN k_acc_LSACMSP j1 ON j1.k1 = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."EQACB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."EQACB")) END) AND j1.k2 = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."EQACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."EQACS")) END) AND j1.k3 = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."EQACX") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."EQACX")) END)
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'LSINACP-001|Missing Data|Missing account key (EQACB/EQACS/EQACX)',
        (t2, f2) AS 'LSINACP-002|Invalid Dates|Invalid date: LAST INTEREST CALCULATION DATE (EQLICD)',
        (t3, f3) AS 'LSINACP-003|Invalid Dates|Invalid date: LAST UPDATE DATE (EQDLUP)',
        (t4, f4) AS 'LSINACP-004|Missing Links|Account (EQACB+EQACS+EQACX) not found in LSACMSP'
      ))
    UNION ALL
/* =============================================================================
   LSINSLP - LS LOAN SCHEDULER FILE (INTEREST CALCULATION)
   Πίνακας: DATACUT5."HUB_MT_LSINSLP"   Shadow: RVMDFL = 'S' (εξαιρούνται)   Έλεγχοι: 3
   ============================================================================= */
    SELECT 'LSINSLP - LS LOAN SCHEDULER FILE (INTEREST CALCULATION)' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- LSINSLP-001: Missing account key (RVACB/RVACS/RVACX)
          COUNT(CASE WHEN NVL(t."RVMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t1,
          COUNT(CASE WHEN NVL(t."RVMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."RVACB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."RVACB")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."RVACB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."RVACB")) END) = 0 OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."RVACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."RVACS")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."RVACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."RVACS")) END) = 0 OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."RVACX") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."RVACX")) END) IS NULL) THEN 1 END) AS f1,
          -- LSINSLP-002: Invalid date: LAST UPDATE DATE (RVDLUP)
          COUNT(CASE WHEN NVL(t."RVMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t2,
          COUNT(CASE WHEN NVL(t."RVMDFL",' ') &lt;&gt; 'S' AND ((NOT (TRIM(t."RVDLUP") IS NULL OR REGEXP_LIKE(TRIM(t."RVDLUP"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."RVDLUP"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."RVDLUP") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."RVDLUP")) END), 0) &lt; 19000101)) THEN 1 END) AS f2,
          -- LSINSLP-003: Account (RVACB+RVACS+RVACX) not found in LSACMSP
          COUNT(CASE WHEN NVL(t."RVMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."RVACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."RVACS")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."RVACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."RVACS")) END) &lt;&gt; 0) THEN 1 END) AS t3,
          COUNT(CASE WHEN NVL(t."RVMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."RVACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."RVACS")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."RVACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."RVACS")) END) &lt;&gt; 0) AND (j1.k1 IS NULL) THEN 1 END) AS f3
        FROM DATACUT5."HUB_MT_LSINSLP" t
        CROSS JOIN params p
        LEFT JOIN k_acc_LSACMSP j1 ON j1.k1 = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."RVACB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."RVACB")) END) AND j1.k2 = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."RVACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."RVACS")) END) AND j1.k3 = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."RVACX") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."RVACX")) END)
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'LSINSLP-001|Missing Data|Missing account key (RVACB/RVACS/RVACX)',
        (t2, f2) AS 'LSINSLP-002|Invalid Dates|Invalid date: LAST UPDATE DATE (RVDLUP)',
        (t3, f3) AS 'LSINSLP-003|Missing Links|Account (RVACB+RVACS+RVACX) not found in LSACMSP'
      ))
    UNION ALL
/* =============================================================================
   LSIRHFP - LS INTEREST RATE HISTORY FILE
   Πίνακας: DATACUT5."HUB_MT_LSIRHFP"   Shadow: δεν υπάρχει mode flag   Έλεγχοι: 3
   ============================================================================= */
    SELECT 'LSIRHFP - LS INTEREST RATE HISTORY FILE' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- LSIRHFP-001: Missing account key (LIACB/LIACS/LIACX)
          COUNT(CASE WHEN 1=1 THEN 1 END) AS t1,
          COUNT(CASE WHEN 1=1 AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."LIACB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."LIACB")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."LIACB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."LIACB")) END) = 0 OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."LIACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."LIACS")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."LIACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."LIACS")) END) = 0 OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."LIACX") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."LIACX")) END) IS NULL) THEN 1 END) AS f1,
          -- LSIRHFP-002: Invalid date: LAST UPDATE DATE (LIDLUP)
          COUNT(CASE WHEN 1=1 THEN 1 END) AS t2,
          COUNT(CASE WHEN 1=1 AND ((NOT (TRIM(t."LIDLUP") IS NULL OR REGEXP_LIKE(TRIM(t."LIDLUP"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."LIDLUP"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."LIDLUP") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."LIDLUP")) END), 0) &lt; 19000101)) THEN 1 END) AS f2,
          -- LSIRHFP-003: Account (LIACB+LIACS+LIACX) not found in LSACMSP
          COUNT(CASE WHEN ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."LIACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."LIACS")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."LIACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."LIACS")) END) &lt;&gt; 0) THEN 1 END) AS t3,
          COUNT(CASE WHEN ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."LIACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."LIACS")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."LIACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."LIACS")) END) &lt;&gt; 0) AND (j1.k1 IS NULL) THEN 1 END) AS f3
        FROM DATACUT5."HUB_MT_LSIRHFP" t
        CROSS JOIN params p
        LEFT JOIN k_acc_LSACMSP j1 ON j1.k1 = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."LIACB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."LIACB")) END) AND j1.k2 = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."LIACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."LIACS")) END) AND j1.k3 = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."LIACX") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."LIACX")) END)
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'LSIRHFP-001|Missing Data|Missing account key (LIACB/LIACS/LIACX)',
        (t2, f2) AS 'LSIRHFP-002|Invalid Dates|Invalid date: LAST UPDATE DATE (LIDLUP)',
        (t3, f3) AS 'LSIRHFP-003|Missing Links|Account (LIACB+LIACS+LIACX) not found in LSACMSP'
      ))
    UNION ALL
/* =============================================================================
   LSPMHSP - LS LOANS PAYMENT HISTORY FILE
   Πίνακας: DATACUT5."HUB_MT_LSPMHSP"   Shadow: δεν υπάρχει mode flag   Έλεγχοι: 1
   ============================================================================= */
    SELECT 'LSPMHSP - LS LOANS PAYMENT HISTORY FILE' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- LSPMHSP-001: Invalid date: CAPTURE DATE (CNCPDT)
          COUNT(CASE WHEN 1=1 THEN 1 END) AS t1,
          COUNT(CASE WHEN 1=1 AND ((NOT (TRIM(t."CNCPDT") IS NULL OR REGEXP_LIKE(TRIM(t."CNCPDT"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."CNCPDT"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."CNCPDT") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."CNCPDT")) END), 0) &lt; 19000101)) THEN 1 END) AS f1
        FROM DATACUT5."HUB_MT_LSPMHSP" t
        CROSS JOIN params p
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'LSPMHSP-001|Invalid Dates|Invalid date: CAPTURE DATE (CNCPDT)'
      ))
    UNION ALL
/* =============================================================================
   LSRHSLP - LS REPAYMENT HISTORY SCHEDULE FILE
   Πίνακας: DATACUT5."HUB_MT_LSRHSLP"   Shadow: CFMDFL = 'S' (εξαιρούνται)   Έλεγχοι: 3
   ============================================================================= */
    SELECT 'LSRHSLP - LS REPAYMENT HISTORY SCHEDULE FILE' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- LSRHSLP-001: Missing account key (CFACB/CFACS/CFACX)
          COUNT(CASE WHEN NVL(t."CFMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t1,
          COUNT(CASE WHEN NVL(t."CFMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."CFACB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."CFACB")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."CFACB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."CFACB")) END) = 0 OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."CFACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."CFACS")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."CFACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."CFACS")) END) = 0 OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."CFACX") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."CFACX")) END) IS NULL) THEN 1 END) AS f1,
          -- LSRHSLP-002: Invalid date: LAST UPDATE DATE (CFDLUP)
          COUNT(CASE WHEN NVL(t."CFMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t2,
          COUNT(CASE WHEN NVL(t."CFMDFL",' ') &lt;&gt; 'S' AND ((NOT (TRIM(t."CFDLUP") IS NULL OR REGEXP_LIKE(TRIM(t."CFDLUP"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."CFDLUP"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."CFDLUP") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."CFDLUP")) END), 0) &lt; 19000101)) THEN 1 END) AS f2,
          -- LSRHSLP-003: Account (CFACB+CFACS+CFACX) not found in LSACMSP
          COUNT(CASE WHEN NVL(t."CFMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."CFACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."CFACS")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."CFACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."CFACS")) END) &lt;&gt; 0) THEN 1 END) AS t3,
          COUNT(CASE WHEN NVL(t."CFMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."CFACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."CFACS")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."CFACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."CFACS")) END) &lt;&gt; 0) AND (j1.k1 IS NULL) THEN 1 END) AS f3
        FROM DATACUT5."HUB_MT_LSRHSLP" t
        CROSS JOIN params p
        LEFT JOIN k_acc_LSACMSP j1 ON j1.k1 = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."CFACB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."CFACB")) END) AND j1.k2 = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."CFACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."CFACS")) END) AND j1.k3 = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."CFACX") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."CFACX")) END)
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'LSRHSLP-001|Missing Data|Missing account key (CFACB/CFACS/CFACX)',
        (t2, f2) AS 'LSRHSLP-002|Invalid Dates|Invalid date: LAST UPDATE DATE (CFDLUP)',
        (t3, f3) AS 'LSRHSLP-003|Missing Links|Account (CFACB+CFACS+CFACX) not found in LSACMSP'
      ))
    UNION ALL
/* =============================================================================
   LSRPSLP - LS LOAN SCHEDULER FILE (REPAYMENT CALCULATION)
   Πίνακας: DATACUT5."HUB_MT_LSRPSLP"   Shadow: RNMDFL = 'S' (εξαιρούνται)   Έλεγχοι: 3
   ============================================================================= */
    SELECT 'LSRPSLP - LS LOAN SCHEDULER FILE (REPAYMENT CALCULATION)' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- LSRPSLP-001: Missing account key (RNACB/RNACS/RNACX)
          COUNT(CASE WHEN NVL(t."RNMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t1,
          COUNT(CASE WHEN NVL(t."RNMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."RNACB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."RNACB")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."RNACB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."RNACB")) END) = 0 OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."RNACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."RNACS")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."RNACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."RNACS")) END) = 0 OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."RNACX") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."RNACX")) END) IS NULL) THEN 1 END) AS f1,
          -- LSRPSLP-002: Invalid date: LAST UPDATE DATE (RNDLUP)
          COUNT(CASE WHEN NVL(t."RNMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t2,
          COUNT(CASE WHEN NVL(t."RNMDFL",' ') &lt;&gt; 'S' AND ((NOT (TRIM(t."RNDLUP") IS NULL OR REGEXP_LIKE(TRIM(t."RNDLUP"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."RNDLUP"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."RNDLUP") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."RNDLUP")) END), 0) &lt; 19000101)) THEN 1 END) AS f2,
          -- LSRPSLP-003: Account (RNACB+RNACS+RNACX) not found in LSACMSP
          COUNT(CASE WHEN NVL(t."RNMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."RNACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."RNACS")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."RNACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."RNACS")) END) &lt;&gt; 0) THEN 1 END) AS t3,
          COUNT(CASE WHEN NVL(t."RNMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."RNACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."RNACS")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."RNACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."RNACS")) END) &lt;&gt; 0) AND (j1.k1 IS NULL) THEN 1 END) AS f3
        FROM DATACUT5."HUB_MT_LSRPSLP" t
        CROSS JOIN params p
        LEFT JOIN k_acc_LSACMSP j1 ON j1.k1 = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."RNACB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."RNACB")) END) AND j1.k2 = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."RNACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."RNACS")) END) AND j1.k3 = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."RNACX") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."RNACX")) END)
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'LSRPSLP-001|Missing Data|Missing account key (RNACB/RNACS/RNACX)',
        (t2, f2) AS 'LSRPSLP-002|Invalid Dates|Invalid date: LAST UPDATE DATE (RNDLUP)',
        (t3, f3) AS 'LSRPSLP-003|Missing Links|Account (RNACB+RNACS+RNACX) not found in LSACMSP'
      ))
    UNION ALL
/* =============================================================================
   OR@CORP - Cashier s Order Reconciliation History File
   Πίνακας: DATACUT5."HUB_MT_OR@CORP"   Shadow: δεν υπάρχει mode flag   Έλεγχοι: 1
   ============================================================================= */
    SELECT 'OR@CORP - Cashier s Order Reconciliation History File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- OR_CORP-001: Invalid date: Date Issued (RNCPDT)
          COUNT(CASE WHEN 1=1 THEN 1 END) AS t1,
          COUNT(CASE WHEN 1=1 AND ((NOT (TRIM(t."RNCPDT") IS NULL OR REGEXP_LIKE(TRIM(t."RNCPDT"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."RNCPDT"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."RNCPDT") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."RNCPDT")) END), 0) &lt; 19000101)) THEN 1 END) AS f1
        FROM DATACUT5."HUB_MT_OR@CORP" t
        CROSS JOIN params p
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'OR_CORP-001|Invalid Dates|Invalid date: Date Issued (RNCPDT)'
      ))
    UNION ALL
/* =============================================================================
   ORCOMSP - OR Cashier Order Master
   Πίνακας: DATACUT5."HUB_MT_ORCOMSP"   Shadow: ORMDFL = 'S' (εξαιρούνται)   Έλεγχοι: 2
   ============================================================================= */
    SELECT 'ORCOMSP - OR Cashier Order Master' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- ORCOMSP-001: Invalid date: Capture Date (ORCPDT)
          COUNT(CASE WHEN NVL(t."ORMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t1,
          COUNT(CASE WHEN NVL(t."ORMDFL",' ') &lt;&gt; 'S' AND ((NOT (TRIM(t."ORCPDT") IS NULL OR REGEXP_LIKE(TRIM(t."ORCPDT"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."ORCPDT"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."ORCPDT") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."ORCPDT")) END), 0) &lt; 19000101)) THEN 1 END) AS f1,
          -- ORCOMSP-002: Invalid date: Last Update Date (ORDLUP)
          COUNT(CASE WHEN NVL(t."ORMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t2,
          COUNT(CASE WHEN NVL(t."ORMDFL",' ') &lt;&gt; 'S' AND ((NOT (TRIM(t."ORDLUP") IS NULL OR REGEXP_LIKE(TRIM(t."ORDLUP"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."ORDLUP"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."ORDLUP") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."ORDLUP")) END), 0) &lt; 19000101)) THEN 1 END) AS f2
        FROM DATACUT5."HUB_MT_ORCOMSP" t
        CROSS JOIN params p
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'ORCOMSP-001|Invalid Dates|Invalid date: Capture Date (ORCPDT)',
        (t2, f2) AS 'ORCOMSP-002|Invalid Dates|Invalid date: Last Update Date (ORDLUP)'
      ))
    UNION ALL
/* =============================================================================
   PLACMSP - PGL A/C Information Master File
   Πίνακας: DATACUT5."HUB_MT_PLACMSP"   Shadow: PFMDFL = 'S' (εξαιρούνται)   Έλεγχοι: 18
   ============================================================================= */
    SELECT 'PLACMSP - PGL A/C Information Master File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- PLACMSP-001: Missing customer key (PFDCB/PFDCS)
          COUNT(CASE WHEN NVL(t."PFMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t1,
          COUNT(CASE WHEN NVL(t."PFMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."PFDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."PFDCB")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."PFDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."PFDCS")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."PFDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."PFDCS")) END) = 0) THEN 1 END) AS f1,
          -- PLACMSP-002: Missing account key (PFACB/PFACS/PFACX)
          COUNT(CASE WHEN NVL(t."PFMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t2,
          COUNT(CASE WHEN NVL(t."PFMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."PFACB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."PFACB")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."PFACB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."PFACB")) END) = 0 OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."PFACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."PFACS")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."PFACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."PFACS")) END) = 0 OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."PFACX") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."PFACX")) END) IS NULL) THEN 1 END) AS f2,
          -- PLACMSP-003: Invalid Status (PFSTUS), allowed 1/2/3/4/5/6/7/A/B/C/E/S
          COUNT(CASE WHEN NVL(t."PFMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."PFSTUS") IS NOT NULL) THEN 1 END) AS t3,
          COUNT(CASE WHEN NVL(t."PFMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."PFSTUS") IS NOT NULL) AND (TRIM(t."PFSTUS") NOT IN ('1','2','3','4','5','6','7','A','B','C','E','S')) THEN 1 END) AS f3,
          -- PLACMSP-004: Invalid Restriction (PFRSTR), allowed 1/2/3/4/5/6
          COUNT(CASE WHEN NVL(t."PFMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."PFRSTR") IS NOT NULL) THEN 1 END) AS t4,
          COUNT(CASE WHEN NVL(t."PFMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."PFRSTR") IS NOT NULL) AND (TRIM(t."PFRSTR") NOT IN ('1','2','3','4','5','6')) THEN 1 END) AS f4,
          -- PLACMSP-005: Invalid Maturity (remaining maturity) (PFMTCD), allowed A/B/C/D/E/F/G/H/I/J/P/Q/R/S/T
          COUNT(CASE WHEN NVL(t."PFMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."PFMTCD") IS NOT NULL) THEN 1 END) AS t5,
          COUNT(CASE WHEN NVL(t."PFMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."PFMTCD") IS NOT NULL) AND (TRIM(t."PFMTCD") NOT IN ('A','B','C','D','E','F','G','H','I','J','P','Q','R','S','T')) THEN 1 END) AS f5,
          -- PLACMSP-006: Invalid Credit Grade (PFCRGR), allowed 1/2/3/6/7
          COUNT(CASE WHEN NVL(t."PFMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."PFCRGR") IS NOT NULL) THEN 1 END) AS t6,
          COUNT(CASE WHEN NVL(t."PFMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."PFCRGR") IS NOT NULL) AND (TRIM(t."PFCRGR") NOT IN ('1','2','3','6','7')) THEN 1 END) AS f6,
          -- PLACMSP-007: Country of Registration/Residence (PFCTRS) not a valid country code (SSSTDPP CT)
          COUNT(CASE WHEN NVL(t."PFMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."PFCTRS") IS NOT NULL) THEN 1 END) AS t7,
          COUNT(CASE WHEN NVL(t."PFMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."PFCTRS") IS NOT NULL) AND (j1.code IS NULL) THEN 1 END) AS f7,
          -- PLACMSP-008: Nationality Code (PFNATY) not a valid country code (SSSTDPP CT)
          COUNT(CASE WHEN NVL(t."PFMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."PFNATY") IS NOT NULL) THEN 1 END) AS t8,
          COUNT(CASE WHEN NVL(t."PFMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."PFNATY") IS NOT NULL) AND (j2.code IS NULL) THEN 1 END) AS f8,
          -- PLACMSP-009: Invalid GIMIS Customer Indicator (PFGMCI), allowed C/I/M/N/S
          COUNT(CASE WHEN NVL(t."PFMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."PFGMCI") IS NOT NULL) THEN 1 END) AS t9,
          COUNT(CASE WHEN NVL(t."PFMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."PFGMCI") IS NOT NULL) AND (TRIM(t."PFGMCI") NOT IN ('C','I','M','N','S')) THEN 1 END) AS f9,
          -- PLACMSP-010: Invalid Language Code (PFLANG), allowed 1/2/3/P/S
          COUNT(CASE WHEN NVL(t."PFMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."PFLANG") IS NOT NULL) THEN 1 END) AS t10,
          COUNT(CASE WHEN NVL(t."PFMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."PFLANG") IS NOT NULL) AND (TRIM(t."PFLANG") NOT IN ('1','2','3','P','S')) THEN 1 END) AS f10,
          -- PLACMSP-011: Invalid Despatch Code (PFDPCD), allowed A/C/G/H/K/M/N/P/W
          COUNT(CASE WHEN NVL(t."PFMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."PFDPCD") IS NOT NULL) THEN 1 END) AS t11,
          COUNT(CASE WHEN NVL(t."PFMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."PFDPCD") IS NOT NULL) AND (TRIM(t."PFDPCD") NOT IN ('A','C','G','H','K','M','N','P','W')) THEN 1 END) AS f11,
          -- PLACMSP-012: Invalid date: Date A/C Opened (PFDTAO)
          COUNT(CASE WHEN NVL(t."PFMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t12,
          COUNT(CASE WHEN NVL(t."PFMDFL",' ') &lt;&gt; 'S' AND ((NOT (TRIM(t."PFDTAO") IS NULL OR REGEXP_LIKE(TRIM(t."PFDTAO"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."PFDTAO"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."PFDTAO") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."PFDTAO")) END), 0) &lt; 19000101)) THEN 1 END) AS f12,
          -- PLACMSP-013: Invalid date: Date account closed (PFDACL)
          COUNT(CASE WHEN NVL(t."PFMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t13,
          COUNT(CASE WHEN NVL(t."PFMDFL",' ') &lt;&gt; 'S' AND ((NOT (TRIM(t."PFDACL") IS NULL OR REGEXP_LIKE(TRIM(t."PFDACL"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."PFDACL"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."PFDACL") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."PFDACL")) END), 0) &lt; 19000101)) THEN 1 END) AS f13,
          -- PLACMSP-014: Invalid date: Date Last Activity (PFDLAC)
          COUNT(CASE WHEN NVL(t."PFMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t14,
          COUNT(CASE WHEN NVL(t."PFMDFL",' ') &lt;&gt; 'S' AND ((NOT (TRIM(t."PFDLAC") IS NULL OR REGEXP_LIKE(TRIM(t."PFDLAC"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."PFDLAC"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."PFDLAC") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."PFDLAC")) END), 0) &lt; 19000101)) THEN 1 END) AS f14,
          -- PLACMSP-015: Invalid date: Last Update Date (PFDLUP)
          COUNT(CASE WHEN NVL(t."PFMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t15,
          COUNT(CASE WHEN NVL(t."PFMDFL",' ') &lt;&gt; 'S' AND ((NOT (TRIM(t."PFDLUP") IS NULL OR REGEXP_LIKE(TRIM(t."PFDLUP"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."PFDLUP"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."PFDLUP") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."PFDLUP")) END), 0) &lt; 19000101)) THEN 1 END) AS f15,
          -- PLACMSP-016: Duplicate account key (PFACB+PFACS+PFACX)
          COUNT(CASE WHEN NVL(t."PFMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."PFACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."PFACS")) END) IS NOT NULL) THEN 1 END) AS t16,
          COUNT(CASE WHEN NVL(t."PFMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."PFACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."PFACS")) END) IS NOT NULL) AND (t.dq_dup16 &gt; 1) THEN 1 END) AS f16,
          -- PLACMSP-017: Customer (PFDCB+PFDCS) not found in SSCUSTP
          COUNT(CASE WHEN NVL(t."PFMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."PFDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."PFDCB")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."PFDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."PFDCS")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."PFDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."PFDCS")) END) &lt;&gt; 0) THEN 1 END) AS t17,
          COUNT(CASE WHEN NVL(t."PFMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."PFDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."PFDCB")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."PFDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."PFDCS")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."PFDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."PFDCS")) END) &lt;&gt; 0) AND (j3.dcb IS NULL) THEN 1 END) AS f17,
          -- PLACMSP-018: Date account closed before Date A/C Opened (PFDACL &lt; PFDTAO)
          COUNT(CASE WHEN NVL(t."PFMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t18,
          COUNT(CASE WHEN NVL(t."PFMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN REGEXP_LIKE(TRIM(t."PFDACL"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."PFDACL") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."PFDACL")) END) &lt; (CASE WHEN REGEXP_LIKE(TRIM(t."PFDTAO"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."PFDTAO") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."PFDTAO")) END)) THEN 1 END) AS f18
        FROM (SELECT x.*,
                     COUNT(CASE WHEN NVL("PFMDFL",' ') &lt;&gt; 'S' THEN 1 END) OVER (PARTITION BY "PFACB", "PFACS", "PFACX") AS dq_dup16
                FROM DATACUT5."HUB_MT_PLACMSP" x) t
        CROSS JOIN params p
        LEFT JOIN ref_ct j1 ON j1.code = TRIM(t."PFCTRS")
        LEFT JOIN ref_ct j2 ON j2.code = TRIM(t."PFNATY")
        LEFT JOIN k_cus j3 ON j3.dcb = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."PFDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."PFDCB")) END) AND j3.dcs = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."PFDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."PFDCS")) END)
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'PLACMSP-001|Missing Data|Missing customer key (PFDCB/PFDCS)',
        (t2, f2) AS 'PLACMSP-002|Missing Data|Missing account key (PFACB/PFACS/PFACX)',
        (t3, f3) AS 'PLACMSP-003|Invalid Values|Invalid Status (PFSTUS), allowed 1/2/3/4/5/6/7/A/B/C/E/S',
        (t4, f4) AS 'PLACMSP-004|Invalid Values|Invalid Restriction (PFRSTR), allowed 1/2/3/4/5/6',
        (t5, f5) AS 'PLACMSP-005|Invalid Values|Invalid Maturity (remaining maturity) (PFMTCD), allowed A/B/C/D/E/F/G/H/I/J/P/Q/R/S/T',
        (t6, f6) AS 'PLACMSP-006|Invalid Values|Invalid Credit Grade (PFCRGR), allowed 1/2/3/6/7',
        (t7, f7) AS 'PLACMSP-007|Invalid Values|Country of Registration/Residence (PFCTRS) not a valid country code (SSSTDPP CT)',
        (t8, f8) AS 'PLACMSP-008|Invalid Values|Nationality Code (PFNATY) not a valid country code (SSSTDPP CT)',
        (t9, f9) AS 'PLACMSP-009|Invalid Values|Invalid GIMIS Customer Indicator (PFGMCI), allowed C/I/M/N/S',
        (t10, f10) AS 'PLACMSP-010|Invalid Values|Invalid Language Code (PFLANG), allowed 1/2/3/P/S',
        (t11, f11) AS 'PLACMSP-011|Invalid Values|Invalid Despatch Code (PFDPCD), allowed A/C/G/H/K/M/N/P/W',
        (t12, f12) AS 'PLACMSP-012|Invalid Dates|Invalid date: Date A/C Opened (PFDTAO)',
        (t13, f13) AS 'PLACMSP-013|Invalid Dates|Invalid date: Date account closed (PFDACL)',
        (t14, f14) AS 'PLACMSP-014|Invalid Dates|Invalid date: Date Last Activity (PFDLAC)',
        (t15, f15) AS 'PLACMSP-015|Invalid Dates|Invalid date: Last Update Date (PFDLUP)',
        (t16, f16) AS 'PLACMSP-016|Duplicates|Duplicate account key (PFACB+PFACS+PFACX)',
        (t17, f17) AS 'PLACMSP-017|Missing Links|Customer (PFDCB+PFDCS) not found in SSCUSTP',
        (t18, f18) AS 'PLACMSP-018|Inconsistent Data|Date account closed before Date A/C Opened (PFDACL &lt; PFDTAO)'
      ))
    UNION ALL
/* =============================================================================
   SS@ACPP - FIAU CBAR Accounts Current Table
   Πίνακας: DATACUT5."HUB_MT_SS@ACPP"   Shadow: δεν υπάρχει mode flag   Έλεγχοι: 2
   ============================================================================= */
    SELECT 'SS@ACPP - FIAU CBAR Accounts Current Table' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- SS_ACPP-001: Invalid date: Account Opening Date (ACDTAD)
          COUNT(CASE WHEN 1=1 THEN 1 END) AS t1,
          COUNT(CASE WHEN 1=1 AND ((NOT (TRIM(t."ACDTAD") IS NULL OR REGEXP_LIKE(TRIM(t."ACDTAD"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."ACDTAD"), '^[0-9]{4}-[0-9]{2}-[0-9]{2}$') AND VALIDATE_CONVERSION(TRIM(t."ACDTAD") AS DATE, 'YYYY-MM-DD') = 1 THEN TO_NUMBER(REPLACE(TRIM(t."ACDTAD"), '-')) END), 0) &lt; 19000101)) THEN 1 END) AS f1,
          -- SS_ACPP-002: Invalid date: Relationship Start Date (ACSTRT)
          COUNT(CASE WHEN 1=1 THEN 1 END) AS t2,
          COUNT(CASE WHEN 1=1 AND ((NOT (TRIM(t."ACSTRT") IS NULL OR REGEXP_LIKE(TRIM(t."ACSTRT"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."ACSTRT"), '^[0-9]{4}-[0-9]{2}-[0-9]{2}$') AND VALIDATE_CONVERSION(TRIM(t."ACSTRT") AS DATE, 'YYYY-MM-DD') = 1 THEN TO_NUMBER(REPLACE(TRIM(t."ACSTRT"), '-')) END), 0) &lt; 19000101)) THEN 1 END) AS f2
        FROM DATACUT5."HUB_MT_SS@ACPP" t
        CROSS JOIN params p
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'SS_ACPP-001|Invalid Dates|Invalid date: Account Opening Date (ACDTAD)',
        (t2, f2) AS 'SS_ACPP-002|Invalid Dates|Invalid date: Relationship Start Date (ACSTRT)'
      ))
    UNION ALL
/* =============================================================================
   SS@BMNP - BW3 Next Payment Details
   Πίνακας: DATACUT5."HUB_MT_SS@BMNP"   Shadow: δεν υπάρχει mode flag   Έλεγχοι: 7
   ============================================================================= */
    SELECT 'SS@BMNP - BW3 Next Payment Details' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- SS_BMNP-001: Invalid date: BW3 Expiry Date (BWEXDT)
          COUNT(CASE WHEN 1=1 THEN 1 END) AS t1,
          COUNT(CASE WHEN 1=1 AND ((NOT (TRIM(t."BWEXDT") IS NULL OR REGEXP_LIKE(TRIM(t."BWEXDT"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."BWEXDT"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."BWEXDT") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."BWEXDT")) END), 0) &lt; 19000101)) THEN 1 END) AS f1,
          -- SS_BMNP-002: Invalid date: Date Card Opened (BWDTCO)
          COUNT(CASE WHEN 1=1 THEN 1 END) AS t2,
          COUNT(CASE WHEN 1=1 AND ((NOT (TRIM(t."BWDTCO") IS NULL OR REGEXP_LIKE(TRIM(t."BWDTCO"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."BWDTCO"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."BWDTCO") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."BWDTCO")) END), 0) &lt; 19000101)) THEN 1 END) AS f2,
          -- SS_BMNP-003: Invalid date: Last Purchase Date (BWLPUD)
          COUNT(CASE WHEN 1=1 THEN 1 END) AS t3,
          COUNT(CASE WHEN 1=1 AND ((NOT (TRIM(t."BWLPUD") IS NULL OR REGEXP_LIKE(TRIM(t."BWLPUD"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."BWLPUD"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."BWLPUD") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."BWLPUD")) END), 0) &lt; 19000101)) THEN 1 END) AS f3,
          -- SS_BMNP-004: Invalid date: Last Payment Date (BWLPAD)
          COUNT(CASE WHEN 1=1 THEN 1 END) AS t4,
          COUNT(CASE WHEN 1=1 AND ((NOT (TRIM(t."BWLPAD") IS NULL OR REGEXP_LIKE(TRIM(t."BWLPAD"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."BWLPAD"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."BWLPAD") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."BWLPAD")) END), 0) &lt; 19000101)) THEN 1 END) AS f4,
          -- SS_BMNP-005: Invalid date: Last Cash Advance Date (BWLCAD)
          COUNT(CASE WHEN 1=1 THEN 1 END) AS t5,
          COUNT(CASE WHEN 1=1 AND ((NOT (TRIM(t."BWLCAD") IS NULL OR REGEXP_LIKE(TRIM(t."BWLCAD"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."BWLCAD"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."BWLCAD") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."BWLCAD")) END), 0) &lt; 19000101)) THEN 1 END) AS f5,
          -- SS_BMNP-006: Invalid date: Date Card Opened (BWDTC2)
          COUNT(CASE WHEN 1=1 THEN 1 END) AS t6,
          COUNT(CASE WHEN 1=1 AND ((NOT (TRIM(t."BWDTC2") IS NULL OR REGEXP_LIKE(TRIM(t."BWDTC2"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."BWDTC2"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."BWDTC2") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."BWDTC2")) END), 0) &lt; 19000101)) THEN 1 END) AS f6,
          -- SS_BMNP-007: Invalid date: Date of Birth (BWDTBR)
          COUNT(CASE WHEN 1=1 THEN 1 END) AS t7,
          COUNT(CASE WHEN 1=1 AND ((NOT (TRIM(t."BWDTBR") IS NULL OR REGEXP_LIKE(TRIM(t."BWDTBR"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."BWDTBR"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."BWDTBR") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."BWDTBR")) END), 0) &lt; 19000101)) THEN 1 END) AS f7
        FROM DATACUT5."HUB_MT_SS@BMNP" t
        CROSS JOIN params p
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'SS_BMNP-001|Invalid Dates|Invalid date: BW3 Expiry Date (BWEXDT)',
        (t2, f2) AS 'SS_BMNP-002|Invalid Dates|Invalid date: Date Card Opened (BWDTCO)',
        (t3, f3) AS 'SS_BMNP-003|Invalid Dates|Invalid date: Last Purchase Date (BWLPUD)',
        (t4, f4) AS 'SS_BMNP-004|Invalid Dates|Invalid date: Last Payment Date (BWLPAD)',
        (t5, f5) AS 'SS_BMNP-005|Invalid Dates|Invalid date: Last Cash Advance Date (BWLCAD)',
        (t6, f6) AS 'SS_BMNP-006|Invalid Dates|Invalid date: Date Card Opened (BWDTC2)',
        (t7, f7) AS 'SS_BMNP-007|Invalid Dates|Invalid date: Date of Birth (BWDTBR)'
      ))
    UNION ALL
/* =============================================================================
   SS@CAIFP - Company Management Information File
   Πίνακας: DATACUT5."HUB_MT_SS@CAIFP"   Shadow: δεν υπάρχει mode flag   Έλεγχοι: 7
   ============================================================================= */
    SELECT 'SS@CAIFP - Company Management Information File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- SS_CAIFP-001: Missing customer key (Z@DCB/Z@DCS)
          COUNT(CASE WHEN 1=1 THEN 1 END) AS t1,
          COUNT(CASE WHEN 1=1 AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."Z@DCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."Z@DCB")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."Z@DCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."Z@DCS")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."Z@DCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."Z@DCS")) END) = 0) THEN 1 END) AS f1,
          -- SS_CAIFP-002: Invalid Gender (Z@SEX), allowed F/M
          COUNT(CASE WHEN (TRIM(t."Z@SEX") IS NOT NULL) THEN 1 END) AS t2,
          COUNT(CASE WHEN (TRIM(t."Z@SEX") IS NOT NULL) AND (TRIM(t."Z@SEX") NOT IN ('F','M')) THEN 1 END) AS f2,
          -- SS_CAIFP-003: Invalid Identity Document Type (Z@IDTY), allowed I/P
          COUNT(CASE WHEN (TRIM(t."Z@IDTY") IS NOT NULL) THEN 1 END) AS t3,
          COUNT(CASE WHEN (TRIM(t."Z@IDTY") IS NOT NULL) AND (TRIM(t."Z@IDTY") NOT IN ('I','P')) THEN 1 END) AS f3,
          -- SS_CAIFP-004: ID Country of Issue (Z@IDCI) not a valid country code (SSSTDPP CT)
          COUNT(CASE WHEN (TRIM(t."Z@IDCI") IS NOT NULL) THEN 1 END) AS t4,
          COUNT(CASE WHEN (TRIM(t."Z@IDCI") IS NOT NULL) AND (j1.code IS NULL) THEN 1 END) AS f4,
          -- SS_CAIFP-005: Invalid date: Guardianship Expiry Date (Z@GEXP)
          COUNT(CASE WHEN 1=1 THEN 1 END) AS t5,
          COUNT(CASE WHEN 1=1 AND ((NOT (TRIM(t."Z@GEXP") IS NULL OR REGEXP_LIKE(TRIM(t."Z@GEXP"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."Z@GEXP"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."Z@GEXP") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."Z@GEXP")) END), 0) &lt; 19000101)) THEN 1 END) AS f5,
          -- SS_CAIFP-006: Customer (Z@DCB+Z@DCS) not found in SSCUSTP
          COUNT(CASE WHEN ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."Z@DCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."Z@DCB")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."Z@DCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."Z@DCS")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."Z@DCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."Z@DCS")) END) &lt;&gt; 0) THEN 1 END) AS t6,
          COUNT(CASE WHEN ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."Z@DCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."Z@DCB")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."Z@DCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."Z@DCS")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."Z@DCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."Z@DCS")) END) &lt;&gt; 0) AND (j2.dcb IS NULL) THEN 1 END) AS f6,
          -- SS_CAIFP-007: Customer (Z@DCB2+Z@DCS2) not found in SSCUSTP
          COUNT(CASE WHEN ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."Z@DCB2") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."Z@DCB2")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."Z@DCS2") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."Z@DCS2")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."Z@DCS2") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."Z@DCS2")) END) &lt;&gt; 0) THEN 1 END) AS t7,
          COUNT(CASE WHEN ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."Z@DCB2") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."Z@DCB2")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."Z@DCS2") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."Z@DCS2")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."Z@DCS2") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."Z@DCS2")) END) &lt;&gt; 0) AND (j3.dcb IS NULL) THEN 1 END) AS f7
        FROM DATACUT5."HUB_MT_SS@CAIFP" t
        CROSS JOIN params p
        LEFT JOIN ref_ct j1 ON j1.code = TRIM(t."Z@IDCI")
        LEFT JOIN k_cus j2 ON j2.dcb = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."Z@DCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."Z@DCB")) END) AND j2.dcs = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."Z@DCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."Z@DCS")) END)
        LEFT JOIN k_cus j3 ON j3.dcb = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."Z@DCB2") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."Z@DCB2")) END) AND j3.dcs = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."Z@DCS2") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."Z@DCS2")) END)
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'SS_CAIFP-001|Missing Data|Missing customer key (Z@DCB/Z@DCS)',
        (t2, f2) AS 'SS_CAIFP-002|Invalid Values|Invalid Gender (Z@SEX), allowed F/M',
        (t3, f3) AS 'SS_CAIFP-003|Invalid Values|Invalid Identity Document Type (Z@IDTY), allowed I/P',
        (t4, f4) AS 'SS_CAIFP-004|Invalid Values|ID Country of Issue (Z@IDCI) not a valid country code (SSSTDPP CT)',
        (t5, f5) AS 'SS_CAIFP-005|Invalid Dates|Invalid date: Guardianship Expiry Date (Z@GEXP)',
        (t6, f6) AS 'SS_CAIFP-006|Missing Links|Customer (Z@DCB+Z@DCS) not found in SSCUSTP',
        (t7, f7) AS 'SS_CAIFP-007|Missing Links|Customer (Z@DCB2+Z@DCS2) not found in SSCUSTP'
      ))
    UNION ALL
/* =============================================================================
   SS@CAJP - Credit Application Approval Journal File
   Πίνακας: DATACUT5."HUB_MT_SS@CAJP"   Shadow: δεν υπάρχει mode flag   Έλεγχοι: 5
   ============================================================================= */
    SELECT 'SS@CAJP - Credit Application Approval Journal File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- SS_CAJP-001: Missing customer key (CADCB/CADCS)
          COUNT(CASE WHEN 1=1 THEN 1 END) AS t1,
          COUNT(CASE WHEN 1=1 AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."CADCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."CADCB")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."CADCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."CADCS")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."CADCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."CADCS")) END) = 0) THEN 1 END) AS f1,
          -- SS_CAJP-002: Missing account key (CAACB/CAACS/CAACX)
          COUNT(CASE WHEN 1=1 THEN 1 END) AS t2,
          COUNT(CASE WHEN 1=1 AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."CAACB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."CAACB")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."CAACB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."CAACB")) END) = 0 OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."CAACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."CAACS")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."CAACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."CAACS")) END) = 0 OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."CAACX") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."CAACX")) END) IS NULL) THEN 1 END) AS f2,
          -- SS_CAJP-003: Invalid date: Capture Date (CACPDT)
          COUNT(CASE WHEN 1=1 THEN 1 END) AS t3,
          COUNT(CASE WHEN 1=1 AND ((NOT (TRIM(t."CACPDT") IS NULL OR REGEXP_LIKE(TRIM(t."CACPDT"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."CACPDT"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."CACPDT") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."CACPDT")) END), 0) &lt; 19000101)) THEN 1 END) AS f3,
          -- SS_CAJP-004: Invalid date: Approval/Verification Date (CAAVDT)
          COUNT(CASE WHEN 1=1 THEN 1 END) AS t4,
          COUNT(CASE WHEN 1=1 AND ((NOT (TRIM(t."CAAVDT") IS NULL OR REGEXP_LIKE(TRIM(t."CAAVDT"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."CAAVDT"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."CAAVDT") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."CAAVDT")) END), 0) &lt; 19000101)) THEN 1 END) AS f4,
          -- SS_CAJP-005: Customer (CADCB+CADCS) not found in SSCUSTP
          COUNT(CASE WHEN ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."CADCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."CADCB")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."CADCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."CADCS")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."CADCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."CADCS")) END) &lt;&gt; 0) THEN 1 END) AS t5,
          COUNT(CASE WHEN ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."CADCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."CADCB")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."CADCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."CADCS")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."CADCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."CADCS")) END) &lt;&gt; 0) AND (j1.dcb IS NULL) THEN 1 END) AS f5
        FROM DATACUT5."HUB_MT_SS@CAJP" t
        CROSS JOIN params p
        LEFT JOIN k_cus j1 ON j1.dcb = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."CADCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."CADCB")) END) AND j1.dcs = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."CADCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."CADCS")) END)
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'SS_CAJP-001|Missing Data|Missing customer key (CADCB/CADCS)',
        (t2, f2) AS 'SS_CAJP-002|Missing Data|Missing account key (CAACB/CAACS/CAACX)',
        (t3, f3) AS 'SS_CAJP-003|Invalid Dates|Invalid date: Capture Date (CACPDT)',
        (t4, f4) AS 'SS_CAJP-004|Invalid Dates|Invalid date: Approval/Verification Date (CAAVDT)',
        (t5, f5) AS 'SS_CAJP-005|Missing Links|Customer (CADCB+CADCS) not found in SSCUSTP'
      ))
    UNION ALL
/* =============================================================================
   SS@EWLP - E-Wallet Companies File
   Πίνακας: DATACUT5."HUB_MT_SS@EWLP"   Shadow: δεν υπάρχει mode flag   Έλεγχοι: 1
   ============================================================================= */
    SELECT 'SS@EWLP - E-Wallet Companies File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- SS_EWLP-001: Invalid date: Capture Date (EWCPDT)
          COUNT(CASE WHEN 1=1 THEN 1 END) AS t1,
          COUNT(CASE WHEN 1=1 AND ((NOT (TRIM(t."EWCPDT") IS NULL OR REGEXP_LIKE(TRIM(t."EWCPDT"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."EWCPDT"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."EWCPDT") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."EWCPDT")) END), 0) &lt; 19000101)) THEN 1 END) AS f1
        FROM DATACUT5."HUB_MT_SS@EWLP" t
        CROSS JOIN params p
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'SS_EWLP-001|Invalid Dates|Invalid date: Capture Date (EWCPDT)'
      ))
    UNION ALL
/* =============================================================================
   SS@FRBP - FORBEARANCE RECORDS
   Πίνακας: DATACUT5."HUB_MT_SS@FRBP"   Shadow: δεν υπάρχει mode flag   Έλεγχοι: 3
   ============================================================================= */
    SELECT 'SS@FRBP - FORBEARANCE RECORDS' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- SS_FRBP-001: Missing customer key (FRDCB/FRDCS)
          COUNT(CASE WHEN 1=1 THEN 1 END) AS t1,
          COUNT(CASE WHEN 1=1 AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."FRDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."FRDCB")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."FRDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."FRDCS")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."FRDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."FRDCS")) END) = 0) THEN 1 END) AS f1,
          -- SS_FRBP-002: Invalid date: CAPTURE DATE (FRCPDT)
          COUNT(CASE WHEN 1=1 THEN 1 END) AS t2,
          COUNT(CASE WHEN 1=1 AND ((NOT (TRIM(t."FRCPDT") IS NULL OR REGEXP_LIKE(TRIM(t."FRCPDT"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."FRCPDT"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."FRCPDT") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."FRCPDT")) END), 0) &lt; 19000101)) THEN 1 END) AS f2,
          -- SS_FRBP-003: Customer (FRDCB+FRDCS) not found in SSCUSTP
          COUNT(CASE WHEN ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."FRDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."FRDCB")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."FRDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."FRDCS")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."FRDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."FRDCS")) END) &lt;&gt; 0) THEN 1 END) AS t3,
          COUNT(CASE WHEN ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."FRDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."FRDCB")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."FRDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."FRDCS")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."FRDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."FRDCS")) END) &lt;&gt; 0) AND (j1.dcb IS NULL) THEN 1 END) AS f3
        FROM DATACUT5."HUB_MT_SS@FRBP" t
        CROSS JOIN params p
        LEFT JOIN k_cus j1 ON j1.dcb = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."FRDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."FRDCB")) END) AND j1.dcs = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."FRDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."FRDCS")) END)
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'SS_FRBP-001|Missing Data|Missing customer key (FRDCB/FRDCS)',
        (t2, f2) AS 'SS_FRBP-002|Invalid Dates|Invalid date: CAPTURE DATE (FRCPDT)',
        (t3, f3) AS 'SS_FRBP-003|Missing Links|Customer (FRDCB+FRDCS) not found in SSCUSTP'
      ))
    UNION ALL
/* =============================================================================
   SS@HCLP - HIGH VALUE PAYMENTS - CLIENT FILE
   Πίνακας: DATACUT5."HUB_MT_SS@HCLP"   Shadow: δεν υπάρχει mode flag   Έλεγχοι: 2
   ============================================================================= */
    SELECT 'SS@HCLP - HIGH VALUE PAYMENTS - CLIENT FILE' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- SS_HCLP-001: Missing customer key (CLDCB/CLDCS)
          COUNT(CASE WHEN 1=1 THEN 1 END) AS t1,
          COUNT(CASE WHEN 1=1 AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."CLDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."CLDCB")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."CLDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."CLDCS")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."CLDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."CLDCS")) END) = 0) THEN 1 END) AS f1,
          -- SS_HCLP-002: Customer (CLDCB+CLDCS) not found in SSCUSTP
          COUNT(CASE WHEN ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."CLDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."CLDCB")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."CLDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."CLDCS")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."CLDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."CLDCS")) END) &lt;&gt; 0) THEN 1 END) AS t2,
          COUNT(CASE WHEN ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."CLDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."CLDCB")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."CLDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."CLDCS")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."CLDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."CLDCS")) END) &lt;&gt; 0) AND (j1.dcb IS NULL) THEN 1 END) AS f2
        FROM DATACUT5."HUB_MT_SS@HCLP" t
        CROSS JOIN params p
        LEFT JOIN k_cus j1 ON j1.dcb = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."CLDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."CLDCB")) END) AND j1.dcs = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."CLDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."CLDCS")) END)
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'SS_HCLP-001|Missing Data|Missing customer key (CLDCB/CLDCS)',
        (t2, f2) AS 'SS_HCLP-002|Missing Links|Customer (CLDCB+CLDCS) not found in SSCUSTP'
      ))
    UNION ALL
/* =============================================================================
   SS@HMTP - HIGH VALUE PAYMENTS - CUSTOMER/MERCHANT FILE
   Πίνακας: DATACUT5."HUB_MT_SS@HMTP"   Shadow: δεν υπάρχει mode flag   Έλεγχοι: 2
   ============================================================================= */
    SELECT 'SS@HMTP - HIGH VALUE PAYMENTS - CUSTOMER/MERCHANT FILE' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- SS_HMTP-001: Missing customer key (MTDCB/MTDCS)
          COUNT(CASE WHEN 1=1 THEN 1 END) AS t1,
          COUNT(CASE WHEN 1=1 AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."MTDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."MTDCB")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."MTDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."MTDCS")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."MTDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."MTDCS")) END) = 0) THEN 1 END) AS f1,
          -- SS_HMTP-002: Customer (MTDCB+MTDCS) not found in SSCUSTP
          COUNT(CASE WHEN ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."MTDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."MTDCB")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."MTDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."MTDCS")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."MTDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."MTDCS")) END) &lt;&gt; 0) THEN 1 END) AS t2,
          COUNT(CASE WHEN ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."MTDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."MTDCB")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."MTDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."MTDCS")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."MTDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."MTDCS")) END) &lt;&gt; 0) AND (j1.dcb IS NULL) THEN 1 END) AS f2
        FROM DATACUT5."HUB_MT_SS@HMTP" t
        CROSS JOIN params p
        LEFT JOIN k_cus j1 ON j1.dcb = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."MTDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."MTDCB")) END) AND j1.dcs = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."MTDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."MTDCS")) END)
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'SS_HMTP-001|Missing Data|Missing customer key (MTDCB/MTDCS)',
        (t2, f2) AS 'SS_HMTP-002|Missing Links|Customer (MTDCB+MTDCS) not found in SSCUSTP'
      ))
    UNION ALL
/* =============================================================================
   SS@ICIP - Local Customer Information File
   Πίνακας: DATACUT5."HUB_MT_SS@ICIP"   Shadow: LCMDFL = 'S' (εξαιρούνται)   Έλεγχοι: 2
   ============================================================================= */
    SELECT 'SS@ICIP - Local Customer Information File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- SS_ICIP-001: Invalid date: Date Customer Deceased (LCDTDC)
          COUNT(CASE WHEN NVL(t."LCMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t1,
          COUNT(CASE WHEN NVL(t."LCMDFL",' ') &lt;&gt; 'S' AND ((NOT (TRIM(t."LCDTDC") IS NULL OR REGEXP_LIKE(TRIM(t."LCDTDC"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."LCDTDC"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."LCDTDC") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."LCDTDC")) END), 0) &lt; 19000101)) THEN 1 END) AS f1,
          -- SS_ICIP-002: Invalid date: Date ID Filed (LCIDDT)
          COUNT(CASE WHEN NVL(t."LCMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t2,
          COUNT(CASE WHEN NVL(t."LCMDFL",' ') &lt;&gt; 'S' AND ((NOT (TRIM(t."LCIDDT") IS NULL OR REGEXP_LIKE(TRIM(t."LCIDDT"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."LCIDDT"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."LCIDDT") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."LCIDDT")) END), 0) &lt; 19000101)) THEN 1 END) AS f2
        FROM DATACUT5."HUB_MT_SS@ICIP" t
        CROSS JOIN params p
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'SS_ICIP-001|Invalid Dates|Invalid date: Date Customer Deceased (LCDTDC)',
        (t2, f2) AS 'SS_ICIP-002|Invalid Dates|Invalid date: Date ID Filed (LCIDDT)'
      ))
    UNION ALL
/* =============================================================================
   SS@IPPP - FIAU CBAR Involved Parties Current Table
   Πίνακας: DATACUT5."HUB_MT_SS@IPPP"   Shadow: δεν υπάρχει mode flag   Έλεγχοι: 8
   ============================================================================= */
    SELECT 'SS@IPPP - FIAU CBAR Involved Parties Current Table' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- SS_IPPP-001: Birth Country (IPBCTD) not a valid country code (SSSTDPP CT)
          COUNT(CASE WHEN (TRIM(t."IPBCTD") IS NOT NULL) THEN 1 END) AS t1,
          COUNT(CASE WHEN (TRIM(t."IPBCTD") IS NOT NULL) AND (j1.code IS NULL) THEN 1 END) AS f1,
          -- SS_IPPP-002: Country of Residence (IPCTRS) not a valid country code (SSSTDPP CT)
          COUNT(CASE WHEN (TRIM(t."IPCTRS") IS NOT NULL) THEN 1 END) AS t2,
          COUNT(CASE WHEN (TRIM(t."IPCTRS") IS NOT NULL) AND (j2.code IS NULL) THEN 1 END) AS f2,
          -- SS_IPPP-003: Nationality 1 (IPNATY) not a valid country code (SSSTDPP CT)
          COUNT(CASE WHEN (TRIM(t."IPNATY") IS NOT NULL) THEN 1 END) AS t3,
          COUNT(CASE WHEN (TRIM(t."IPNATY") IS NOT NULL) AND (j3.code IS NULL) THEN 1 END) AS f3,
          -- SS_IPPP-004: Nationality 2 (IPDUCD) not a valid country code (SSSTDPP CT)
          COUNT(CASE WHEN (TRIM(t."IPDUCD") IS NOT NULL) THEN 1 END) AS t4,
          COUNT(CASE WHEN (TRIM(t."IPDUCD") IS NOT NULL) AND (j4.code IS NULL) THEN 1 END) AS f4,
          -- SS_IPPP-005: Nationality 3 (IPTCTD) not a valid country code (SSSTDPP CT)
          COUNT(CASE WHEN (TRIM(t."IPTCTD") IS NOT NULL) THEN 1 END) AS t5,
          COUNT(CASE WHEN (TRIM(t."IPTCTD") IS NOT NULL) AND (j5.code IS NULL) THEN 1 END) AS f5,
          -- SS_IPPP-006: Document Issue Country (IPTXDC) not a valid country code (SSSTDPP CT)
          COUNT(CASE WHEN (TRIM(t."IPTXDC") IS NOT NULL) THEN 1 END) AS t6,
          COUNT(CASE WHEN (TRIM(t."IPTXDC") IS NOT NULL) AND (j6.code IS NULL) THEN 1 END) AS f6,
          -- SS_IPPP-007: Registration Country (IPCTRG) not a valid country code (SSSTDPP CT)
          COUNT(CASE WHEN (TRIM(t."IPCTRG") IS NOT NULL) THEN 1 END) AS t7,
          COUNT(CASE WHEN (TRIM(t."IPCTRG") IS NOT NULL) AND (j7.code IS NULL) THEN 1 END) AS f7,
          -- SS_IPPP-008: Invalid date: Birth Date (IPDTBR)
          COUNT(CASE WHEN 1=1 THEN 1 END) AS t8,
          COUNT(CASE WHEN 1=1 AND ((NOT (TRIM(t."IPDTBR") IS NULL OR REGEXP_LIKE(TRIM(t."IPDTBR"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."IPDTBR"), '^[0-9]{4}-[0-9]{2}-[0-9]{2}$') AND VALIDATE_CONVERSION(TRIM(t."IPDTBR") AS DATE, 'YYYY-MM-DD') = 1 THEN TO_NUMBER(REPLACE(TRIM(t."IPDTBR"), '-')) END), 0) &lt; 19000101)) THEN 1 END) AS f8
        FROM DATACUT5."HUB_MT_SS@IPPP" t
        CROSS JOIN params p
        LEFT JOIN ref_ct j1 ON j1.code = TRIM(t."IPBCTD")
        LEFT JOIN ref_ct j2 ON j2.code = TRIM(t."IPCTRS")
        LEFT JOIN ref_ct j3 ON j3.code = TRIM(t."IPNATY")
        LEFT JOIN ref_ct j4 ON j4.code = TRIM(t."IPDUCD")
        LEFT JOIN ref_ct j5 ON j5.code = TRIM(t."IPTCTD")
        LEFT JOIN ref_ct j6 ON j6.code = TRIM(t."IPTXDC")
        LEFT JOIN ref_ct j7 ON j7.code = TRIM(t."IPCTRG")
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'SS_IPPP-001|Invalid Values|Birth Country (IPBCTD) not a valid country code (SSSTDPP CT)',
        (t2, f2) AS 'SS_IPPP-002|Invalid Values|Country of Residence (IPCTRS) not a valid country code (SSSTDPP CT)',
        (t3, f3) AS 'SS_IPPP-003|Invalid Values|Nationality 1 (IPNATY) not a valid country code (SSSTDPP CT)',
        (t4, f4) AS 'SS_IPPP-004|Invalid Values|Nationality 2 (IPDUCD) not a valid country code (SSSTDPP CT)',
        (t5, f5) AS 'SS_IPPP-005|Invalid Values|Nationality 3 (IPTCTD) not a valid country code (SSSTDPP CT)',
        (t6, f6) AS 'SS_IPPP-006|Invalid Values|Document Issue Country (IPTXDC) not a valid country code (SSSTDPP CT)',
        (t7, f7) AS 'SS_IPPP-007|Invalid Values|Registration Country (IPCTRG) not a valid country code (SSSTDPP CT)',
        (t8, f8) AS 'SS_IPPP-008|Invalid Dates|Invalid date: Birth Date (IPDTBR)'
      ))
    UNION ALL
/* =============================================================================
   SS@LDDP - Loan Drawdown Details for VAT regulatory reporting
   Πίνακας: DATACUT5."HUB_MT_SS@LDDP"   Shadow: δεν υπάρχει mode flag   Έλεγχοι: 3
   ============================================================================= */
    SELECT 'SS@LDDP - Loan Drawdown Details for VAT regulatory reporting' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- SS_LDDP-001: Missing customer key (LDDCB/LDDCS)
          COUNT(CASE WHEN 1=1 THEN 1 END) AS t1,
          COUNT(CASE WHEN 1=1 AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."LDDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."LDDCB")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."LDDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."LDDCS")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."LDDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."LDDCS")) END) = 0) THEN 1 END) AS f1,
          -- SS_LDDP-002: Invalid date: Capture Date (LDCPDT)
          COUNT(CASE WHEN 1=1 THEN 1 END) AS t2,
          COUNT(CASE WHEN 1=1 AND ((NOT (TRIM(t."LDCPDT") IS NULL OR REGEXP_LIKE(TRIM(t."LDCPDT"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."LDCPDT"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."LDCPDT") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."LDCPDT")) END), 0) &lt; 19000101)) THEN 1 END) AS f2,
          -- SS_LDDP-003: Customer (LDDCB+LDDCS) not found in SSCUSTP
          COUNT(CASE WHEN ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."LDDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."LDDCB")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."LDDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."LDDCS")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."LDDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."LDDCS")) END) &lt;&gt; 0) THEN 1 END) AS t3,
          COUNT(CASE WHEN ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."LDDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."LDDCB")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."LDDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."LDDCS")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."LDDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."LDDCS")) END) &lt;&gt; 0) AND (j1.dcb IS NULL) THEN 1 END) AS f3
        FROM DATACUT5."HUB_MT_SS@LDDP" t
        CROSS JOIN params p
        LEFT JOIN k_cus j1 ON j1.dcb = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."LDDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."LDDCB")) END) AND j1.dcs = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."LDDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."LDDCS")) END)
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'SS_LDDP-001|Missing Data|Missing customer key (LDDCB/LDDCS)',
        (t2, f2) AS 'SS_LDDP-002|Invalid Dates|Invalid date: Capture Date (LDCPDT)',
        (t3, f3) AS 'SS_LDDP-003|Missing Links|Customer (LDDCB+LDDCS) not found in SSCUSTP'
      ))
    UNION ALL
/* =============================================================================
   SS@NCUSP - Connected Party Non-Customer File
   Πίνακας: DATACUT5."HUB_MT_SS@NCUSP"   Shadow: ZWMDFL = 'S' (εξαιρούνται)   Έλεγχοι: 18
   ============================================================================= */
    SELECT 'SS@NCUSP - Connected Party Non-Customer File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- SS_NCUSP-001: Missing customer key (ZWDCB/ZWDCS)
          COUNT(CASE WHEN NVL(t."ZWMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t1,
          COUNT(CASE WHEN NVL(t."ZWMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZWDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZWDCB")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZWDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZWDCS")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZWDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZWDCS")) END) = 0) THEN 1 END) AS f1,
          -- SS_NCUSP-002: Invalid Sex Code (ZWSEX), allowed F/M
          COUNT(CASE WHEN NVL(t."ZWMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZWSEX") IS NOT NULL) THEN 1 END) AS t2,
          COUNT(CASE WHEN NVL(t."ZWMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZWSEX") IS NOT NULL) AND (TRIM(t."ZWSEX") NOT IN ('F','M')) THEN 1 END) AS f2,
          -- SS_NCUSP-003: Invalid Identity Document Type (ZWIDTY), allowed I/P
          COUNT(CASE WHEN NVL(t."ZWMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZWIDTY") IS NOT NULL) THEN 1 END) AS t3,
          COUNT(CASE WHEN NVL(t."ZWMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZWIDTY") IS NOT NULL) AND (TRIM(t."ZWIDTY") NOT IN ('I','P')) THEN 1 END) AS f3,
          -- SS_NCUSP-004: Invalid Education Level (ZWEDUC), allowed 1/2/3/4/5
          COUNT(CASE WHEN NVL(t."ZWMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZWEDUC") IS NOT NULL) THEN 1 END) AS t4,
          COUNT(CASE WHEN NVL(t."ZWMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZWEDUC") IS NOT NULL) AND (TRIM(t."ZWEDUC") NOT IN ('1','2','3','4','5')) THEN 1 END) AS f4,
          -- SS_NCUSP-005: Invalid Periodicity Code (ZWPRDY), allowed A/B/D/F/H/M/N/Q/W/X/Y
          COUNT(CASE WHEN NVL(t."ZWMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZWPRDY") IS NOT NULL) THEN 1 END) AS t5,
          COUNT(CASE WHEN NVL(t."ZWMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZWPRDY") IS NOT NULL) AND (TRIM(t."ZWPRDY") NOT IN ('A','B','D','F','H','M','N','Q','W','X','Y')) THEN 1 END) AS f5,
          -- SS_NCUSP-006: Invalid Marital status (ZWMST), allowed 1/2/3
          COUNT(CASE WHEN NVL(t."ZWMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZWMST") IS NOT NULL) THEN 1 END) AS t6,
          COUNT(CASE WHEN NVL(t."ZWMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZWMST") IS NOT NULL) AND (TRIM(t."ZWMST") NOT IN ('1','2','3')) THEN 1 END) AS f6,
          -- SS_NCUSP-007: Invalid Home Ownership Status (ZWHOME), allowed 1/2/3/4/5
          COUNT(CASE WHEN NVL(t."ZWMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZWHOME") IS NOT NULL) THEN 1 END) AS t7,
          COUNT(CASE WHEN NVL(t."ZWMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZWHOME") IS NOT NULL) AND (TRIM(t."ZWHOME") NOT IN ('1','2','3','4','5')) THEN 1 END) AS f7,
          -- SS_NCUSP-008: Invalid Despatch Code (ZWDPCD), allowed A/C/G/H/K/M/N/P/W
          COUNT(CASE WHEN NVL(t."ZWMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZWDPCD") IS NOT NULL) THEN 1 END) AS t8,
          COUNT(CASE WHEN NVL(t."ZWMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZWDPCD") IS NOT NULL) AND (TRIM(t."ZWDPCD") NOT IN ('A','C','G','H','K','M','N','P','W')) THEN 1 END) AS f8,
          -- SS_NCUSP-009: Invalid Language Code (ZWLANG), allowed 1/2/3/P/S
          COUNT(CASE WHEN NVL(t."ZWMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZWLANG") IS NOT NULL) THEN 1 END) AS t9,
          COUNT(CASE WHEN NVL(t."ZWMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZWLANG") IS NOT NULL) AND (TRIM(t."ZWLANG") NOT IN ('1','2','3','P','S')) THEN 1 END) AS f9,
          -- SS_NCUSP-010: Country of Registration/Residence (ZWCTRS) not a valid country code (SSSTDPP CT)
          COUNT(CASE WHEN NVL(t."ZWMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZWCTRS") IS NOT NULL) THEN 1 END) AS t10,
          COUNT(CASE WHEN NVL(t."ZWMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZWCTRS") IS NOT NULL) AND (j1.code IS NULL) THEN 1 END) AS f10,
          -- SS_NCUSP-011: Nationality Code (ZWNATY) not a valid country code (SSSTDPP CT)
          COUNT(CASE WHEN NVL(t."ZWMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZWNATY") IS NOT NULL) THEN 1 END) AS t11,
          COUNT(CASE WHEN NVL(t."ZWMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZWNATY") IS NOT NULL) AND (j2.code IS NULL) THEN 1 END) AS f11,
          -- SS_NCUSP-012: Country Code of Birth (ZWBCTD) not a valid country code (SSSTDPP CT)
          COUNT(CASE WHEN NVL(t."ZWMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZWBCTD") IS NOT NULL) THEN 1 END) AS t12,
          COUNT(CASE WHEN NVL(t."ZWMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZWBCTD") IS NOT NULL) AND (j3.code IS NULL) THEN 1 END) AS f12,
          -- SS_NCUSP-013: ID Country of Issue (ZWIDCI) not a valid country code (SSSTDPP CT)
          COUNT(CASE WHEN NVL(t."ZWMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZWIDCI") IS NOT NULL) THEN 1 END) AS t13,
          COUNT(CASE WHEN NVL(t."ZWMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZWIDCI") IS NOT NULL) AND (j4.code IS NULL) THEN 1 END) AS f13,
          -- SS_NCUSP-014: Invalid date: Date Request added (ZWDTAD)
          COUNT(CASE WHEN NVL(t."ZWMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t14,
          COUNT(CASE WHEN NVL(t."ZWMDFL",' ') &lt;&gt; 'S' AND ((NOT (TRIM(t."ZWDTAD") IS NULL OR REGEXP_LIKE(TRIM(t."ZWDTAD"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."ZWDTAD"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."ZWDTAD") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."ZWDTAD")) END), 0) &lt; 19000101)) THEN 1 END) AS f14,
          -- SS_NCUSP-015: Invalid date: Last Update Date (ZWDLUP)
          COUNT(CASE WHEN NVL(t."ZWMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t15,
          COUNT(CASE WHEN NVL(t."ZWMDFL",' ') &lt;&gt; 'S' AND ((NOT (TRIM(t."ZWDLUP") IS NULL OR REGEXP_LIKE(TRIM(t."ZWDLUP"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."ZWDLUP"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."ZWDLUP") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."ZWDLUP")) END), 0) &lt; 19000101)) THEN 1 END) AS f15,
          -- SS_NCUSP-016: Invalid date: Date of Birth (ZWDTBR)
          COUNT(CASE WHEN NVL(t."ZWMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t16,
          COUNT(CASE WHEN NVL(t."ZWMDFL",' ') &lt;&gt; 'S' AND ((NOT (TRIM(t."ZWDTBR") IS NULL OR REGEXP_LIKE(TRIM(t."ZWDTBR"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."ZWDTBR"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."ZWDTBR") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."ZWDTBR")) END), 0) &lt; 19000101)) THEN 1 END) AS f16,
          -- SS_NCUSP-017: Invalid date: Entry Date of Current Market Sector (MSC) (ZWMSD1)
          COUNT(CASE WHEN NVL(t."ZWMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t17,
          COUNT(CASE WHEN NVL(t."ZWMDFL",' ') &lt;&gt; 'S' AND ((NOT (TRIM(t."ZWMSD1") IS NULL OR REGEXP_LIKE(TRIM(t."ZWMSD1"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."ZWMSD1"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."ZWMSD1") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."ZWMSD1")) END), 0) &lt; 19000101)) THEN 1 END) AS f17,
          -- SS_NCUSP-018: Customer (ZWDCB+ZWDCS) not found in SSCUSTP
          COUNT(CASE WHEN NVL(t."ZWMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZWDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZWDCB")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZWDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZWDCS")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZWDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZWDCS")) END) &lt;&gt; 0) THEN 1 END) AS t18,
          COUNT(CASE WHEN NVL(t."ZWMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZWDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZWDCB")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZWDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZWDCS")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZWDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZWDCS")) END) &lt;&gt; 0) AND (j5.dcb IS NULL) THEN 1 END) AS f18
        FROM DATACUT5."HUB_MT_SS@NCUSP" t
        CROSS JOIN params p
        LEFT JOIN ref_ct j1 ON j1.code = TRIM(t."ZWCTRS")
        LEFT JOIN ref_ct j2 ON j2.code = TRIM(t."ZWNATY")
        LEFT JOIN ref_ct j3 ON j3.code = TRIM(t."ZWBCTD")
        LEFT JOIN ref_ct j4 ON j4.code = TRIM(t."ZWIDCI")
        LEFT JOIN k_cus j5 ON j5.dcb = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZWDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZWDCB")) END) AND j5.dcs = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZWDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZWDCS")) END)
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'SS_NCUSP-001|Missing Data|Missing customer key (ZWDCB/ZWDCS)',
        (t2, f2) AS 'SS_NCUSP-002|Invalid Values|Invalid Sex Code (ZWSEX), allowed F/M',
        (t3, f3) AS 'SS_NCUSP-003|Invalid Values|Invalid Identity Document Type (ZWIDTY), allowed I/P',
        (t4, f4) AS 'SS_NCUSP-004|Invalid Values|Invalid Education Level (ZWEDUC), allowed 1/2/3/4/5',
        (t5, f5) AS 'SS_NCUSP-005|Invalid Values|Invalid Periodicity Code (ZWPRDY), allowed A/B/D/F/H/M/N/Q/W/X/Y',
        (t6, f6) AS 'SS_NCUSP-006|Invalid Values|Invalid Marital status (ZWMST), allowed 1/2/3',
        (t7, f7) AS 'SS_NCUSP-007|Invalid Values|Invalid Home Ownership Status (ZWHOME), allowed 1/2/3/4/5',
        (t8, f8) AS 'SS_NCUSP-008|Invalid Values|Invalid Despatch Code (ZWDPCD), allowed A/C/G/H/K/M/N/P/W',
        (t9, f9) AS 'SS_NCUSP-009|Invalid Values|Invalid Language Code (ZWLANG), allowed 1/2/3/P/S',
        (t10, f10) AS 'SS_NCUSP-010|Invalid Values|Country of Registration/Residence (ZWCTRS) not a valid country code (SSSTDPP CT)',
        (t11, f11) AS 'SS_NCUSP-011|Invalid Values|Nationality Code (ZWNATY) not a valid country code (SSSTDPP CT)',
        (t12, f12) AS 'SS_NCUSP-012|Invalid Values|Country Code of Birth (ZWBCTD) not a valid country code (SSSTDPP CT)',
        (t13, f13) AS 'SS_NCUSP-013|Invalid Values|ID Country of Issue (ZWIDCI) not a valid country code (SSSTDPP CT)',
        (t14, f14) AS 'SS_NCUSP-014|Invalid Dates|Invalid date: Date Request added (ZWDTAD)',
        (t15, f15) AS 'SS_NCUSP-015|Invalid Dates|Invalid date: Last Update Date (ZWDLUP)',
        (t16, f16) AS 'SS_NCUSP-016|Invalid Dates|Invalid date: Date of Birth (ZWDTBR)',
        (t17, f17) AS 'SS_NCUSP-017|Invalid Dates|Invalid date: Entry Date of Current Market Sector (MSC) (ZWMSD1)',
        (t18, f18) AS 'SS_NCUSP-018|Missing Links|Customer (ZWDCB+ZWDCS) not found in SSCUSTP'
      ))
    UNION ALL
/* =============================================================================
   SS@RPMP - REGISTERED PROPERTY MASTER FILE
   Πίνακας: DATACUT5."HUB_MT_SS@RPMP"   Shadow: δεν υπάρχει mode flag   Έλεγχοι: 3
   ============================================================================= */
    SELECT 'SS@RPMP - REGISTERED PROPERTY MASTER FILE' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- SS_RPMP-001: Invalid date: EXPIRY DATE (RPEXDT)
          COUNT(CASE WHEN 1=1 THEN 1 END) AS t1,
          COUNT(CASE WHEN 1=1 AND ((NOT (TRIM(t."RPEXDT") IS NULL OR REGEXP_LIKE(TRIM(t."RPEXDT"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."RPEXDT"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."RPEXDT") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."RPEXDT")) END), 0) &lt; 19000101)) THEN 1 END) AS f1,
          -- SS_RPMP-002: Invalid date: DATE OF LAST BAA HELD (RPDLBA)
          COUNT(CASE WHEN 1=1 THEN 1 END) AS t2,
          COUNT(CASE WHEN 1=1 AND ((NOT (TRIM(t."RPDLBA") IS NULL OR REGEXP_LIKE(TRIM(t."RPDLBA"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."RPDLBA"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."RPDLBA") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."RPDLBA")) END), 0) &lt; 19000101)) THEN 1 END) AS f2,
          -- SS_RPMP-003: Invalid date: CAPTURE DATE (RPCPDT)
          COUNT(CASE WHEN 1=1 THEN 1 END) AS t3,
          COUNT(CASE WHEN 1=1 AND ((NOT (TRIM(t."RPCPDT") IS NULL OR REGEXP_LIKE(TRIM(t."RPCPDT"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."RPCPDT"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."RPCPDT") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."RPCPDT")) END), 0) &lt; 19000101)) THEN 1 END) AS f3
        FROM DATACUT5."HUB_MT_SS@RPMP" t
        CROSS JOIN params p
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'SS_RPMP-001|Invalid Dates|Invalid date: EXPIRY DATE (RPEXDT)',
        (t2, f2) AS 'SS_RPMP-002|Invalid Dates|Invalid date: DATE OF LAST BAA HELD (RPDLBA)',
        (t3, f3) AS 'SS_RPMP-003|Invalid Dates|Invalid date: CAPTURE DATE (RPCPDT)'
      ))
    UNION ALL
/* =============================================================================
   SS@SCHP - Security Held Extension File
   Πίνακας: DATACUT5."HUB_MT_SS@SCHP"   Shadow: δεν υπάρχει mode flag   Έλεγχοι: 3
   ============================================================================= */
    SELECT 'SS@SCHP - Security Held Extension File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- SS_SCHP-001: Missing customer key (SCDCB/SCDCS)
          COUNT(CASE WHEN 1=1 THEN 1 END) AS t1,
          COUNT(CASE WHEN 1=1 AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."SCDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."SCDCB")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."SCDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."SCDCS")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."SCDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."SCDCS")) END) = 0) THEN 1 END) AS f1,
          -- SS_SCHP-002: Invalid date: Date of Policy Issue (SCPLDT)
          COUNT(CASE WHEN 1=1 THEN 1 END) AS t2,
          COUNT(CASE WHEN 1=1 AND ((NOT (TRIM(t."SCPLDT") IS NULL OR REGEXP_LIKE(TRIM(t."SCPLDT"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."SCPLDT"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."SCPLDT") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."SCPLDT")) END), 0) &lt; 19000101)) THEN 1 END) AS f2,
          -- SS_SCHP-003: Customer (SCDCB+SCDCS) not found in SSCUSTP
          COUNT(CASE WHEN ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."SCDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."SCDCB")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."SCDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."SCDCS")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."SCDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."SCDCS")) END) &lt;&gt; 0) THEN 1 END) AS t3,
          COUNT(CASE WHEN ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."SCDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."SCDCB")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."SCDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."SCDCS")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."SCDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."SCDCS")) END) &lt;&gt; 0) AND (j1.dcb IS NULL) THEN 1 END) AS f3
        FROM DATACUT5."HUB_MT_SS@SCHP" t
        CROSS JOIN params p
        LEFT JOIN k_cus j1 ON j1.dcb = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."SCDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."SCDCB")) END) AND j1.dcs = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."SCDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."SCDCS")) END)
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'SS_SCHP-001|Missing Data|Missing customer key (SCDCB/SCDCS)',
        (t2, f2) AS 'SS_SCHP-002|Invalid Dates|Invalid date: Date of Policy Issue (SCPLDT)',
        (t3, f3) AS 'SS_SCHP-003|Missing Links|Customer (SCDCB+SCDCS) not found in SSCUSTP'
      ))
    UNION ALL
/* =============================================================================
   SS@SXDP - Security Held Extension Share Details File
   Πίνακας: DATACUT5."HUB_MT_SS@SXDP"   Shadow: δεν υπάρχει mode flag   Έλεγχοι: 3
   ============================================================================= */
    SELECT 'SS@SXDP - Security Held Extension Share Details File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- SS_SXDP-001: Missing customer key (DHDCB/DHDCS)
          COUNT(CASE WHEN 1=1 THEN 1 END) AS t1,
          COUNT(CASE WHEN 1=1 AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."DHDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."DHDCB")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."DHDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."DHDCS")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."DHDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."DHDCS")) END) = 0) THEN 1 END) AS f1,
          -- SS_SXDP-002: Invalid date: Last Update Date (DHDLUP)
          COUNT(CASE WHEN 1=1 THEN 1 END) AS t2,
          COUNT(CASE WHEN 1=1 AND ((NOT (TRIM(t."DHDLUP") IS NULL OR REGEXP_LIKE(TRIM(t."DHDLUP"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."DHDLUP"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."DHDLUP") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."DHDLUP")) END), 0) &lt; 19000101)) THEN 1 END) AS f2,
          -- SS_SXDP-003: Customer (DHDCB+DHDCS) not found in SSCUSTP
          COUNT(CASE WHEN ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."DHDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."DHDCB")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."DHDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."DHDCS")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."DHDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."DHDCS")) END) &lt;&gt; 0) THEN 1 END) AS t3,
          COUNT(CASE WHEN ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."DHDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."DHDCB")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."DHDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."DHDCS")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."DHDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."DHDCS")) END) &lt;&gt; 0) AND (j1.dcb IS NULL) THEN 1 END) AS f3
        FROM DATACUT5."HUB_MT_SS@SXDP" t
        CROSS JOIN params p
        LEFT JOIN k_cus j1 ON j1.dcb = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."DHDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."DHDCB")) END) AND j1.dcs = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."DHDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."DHDCS")) END)
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'SS_SXDP-001|Missing Data|Missing customer key (DHDCB/DHDCS)',
        (t2, f2) AS 'SS_SXDP-002|Invalid Dates|Invalid date: Last Update Date (DHDLUP)',
        (t3, f3) AS 'SS_SXDP-003|Missing Links|Customer (DHDCB+DHDCS) not found in SSCUSTP'
      ))
    UNION ALL
/* =============================================================================
   SSADDRP - Customer Address File
   Πίνακας: DATACUT5."HUB_MT_SSADDRP"   Shadow: ZBMDFL = 'S' (εξαιρούνται)   Έλεγχοι: 12
   ============================================================================= */
    SELECT 'SSADDRP - Customer Address File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- SSADDRP-001: Missing addressee name, address line 1 (ZBNAD1)
          COUNT(CASE WHEN NVL(t."ZBMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t1,
          COUNT(CASE WHEN NVL(t."ZBMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZBNAD1") IS NULL) THEN 1 END) AS f1,
          -- SSADDRP-002: Address with all address lines 2-5 empty (ZBNAD2-ZBNAD5)
          COUNT(CASE WHEN NVL(t."ZBMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t2,
          COUNT(CASE WHEN NVL(t."ZBMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZBNAD2") IS NULL AND TRIM(t."ZBNAD3") IS NULL AND TRIM(t."ZBNAD4") IS NULL AND TRIM(t."ZBNAD5") IS NULL) THEN 1 END) AS f2,
          -- SSADDRP-003: Missing customer key (ZBDCB/ZBDCS)
          COUNT(CASE WHEN NVL(t."ZBMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t3,
          COUNT(CASE WHEN NVL(t."ZBMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZBDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZBDCB")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZBDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZBDCS")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZBDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZBDCS")) END) = 0) THEN 1 END) AS f3,
          -- SSADDRP-004: Address ID not P1-P9 / S1-S9 (ZBADID)
          COUNT(CASE WHEN NVL(t."ZBMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t4,
          COUNT(CASE WHEN NVL(t."ZBMDFL",' ') &lt;&gt; 'S' AND (NOT REGEXP_LIKE(NVL(TRIM(t."ZBADID"),'#'), '^[PS][1-9]$')) THEN 1 END) AS f4,
          -- SSADDRP-005: Invalid Despatch Code (ZBDPCD), allowed A/C/G/H/K/M/N/P/W
          COUNT(CASE WHEN NVL(t."ZBMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZBDPCD") IS NOT NULL) THEN 1 END) AS t5,
          COUNT(CASE WHEN NVL(t."ZBMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZBDPCD") IS NOT NULL) AND (TRIM(t."ZBDPCD") NOT IN ('A','C','G','H','K','M','N','P','W')) THEN 1 END) AS f5,
          -- SSADDRP-006: Address Country Code (ZBADCE) not a valid country code (SSSTDPP CT)
          COUNT(CASE WHEN NVL(t."ZBMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZBADCE") IS NOT NULL) THEN 1 END) AS t6,
          COUNT(CASE WHEN NVL(t."ZBMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZBADCE") IS NOT NULL) AND (j1.code IS NULL) THEN 1 END) AS f6,
          -- SSADDRP-007: Invalid date: Last Update Date (ZBDLUP)
          COUNT(CASE WHEN NVL(t."ZBMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t7,
          COUNT(CASE WHEN NVL(t."ZBMDFL",' ') &lt;&gt; 'S' AND ((NOT (TRIM(t."ZBDLUP") IS NULL OR REGEXP_LIKE(TRIM(t."ZBDLUP"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."ZBDLUP"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."ZBDLUP") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."ZBDLUP")) END), 0) &lt; 19000101)) THEN 1 END) AS f7,
          -- SSADDRP-008: Duplicate address per customer and address ID (ZBDCB+ZBDCS+ZBADID)
          COUNT(CASE WHEN NVL(t."ZBMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZBDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZBDCB")) END) IS NOT NULL) THEN 1 END) AS t8,
          COUNT(CASE WHEN NVL(t."ZBMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZBDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZBDCB")) END) IS NOT NULL) AND (t.dq_dup8 &gt; 1) THEN 1 END) AS f8,
          -- SSADDRP-009: Customer (ZBDCB+ZBDCS) not found in SSCUSTP
          COUNT(CASE WHEN NVL(t."ZBMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZBDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZBDCB")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZBDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZBDCS")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZBDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZBDCS")) END) &lt;&gt; 0) THEN 1 END) AS t9,
          COUNT(CASE WHEN NVL(t."ZBMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZBDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZBDCB")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZBDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZBDCS")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZBDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZBDCS")) END) &lt;&gt; 0) AND (j2.dcb IS NULL) THEN 1 END) AS f9,
          -- SSADDRP-F01: Fax number with invalid format (ZBFAXN/ZBFAN2)
          COUNT(CASE WHEN NVL(t."ZBMDFL",' ') &lt;&gt; 'S' AND ((TRIM(t."ZBFAXN") IS NOT NULL OR TRIM(t."ZBFAN2") IS NOT NULL)) THEN 1 END) AS t10,
          COUNT(CASE WHEN NVL(t."ZBMDFL",' ') &lt;&gt; 'S' AND ((TRIM(t."ZBFAXN") IS NOT NULL OR TRIM(t."ZBFAN2") IS NOT NULL)) AND ((TRIM(t."ZBFAXN") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(t."ZBFAXN"), '^\+?[0-9][0-9 ()/-]{5,}$')) OR (TRIM(t."ZBFAN2") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(t."ZBFAN2"), '^\+?[0-9][0-9 ()/-]{5,}$'))) THEN 1 END) AS f10,
          -- SSADDRP-F02: Mobile number with invalid format (ZBTEN3)
          COUNT(CASE WHEN NVL(t."ZBMDFL",' ') &lt;&gt; 'S' AND ((TRIM(t."ZBTEN3") IS NOT NULL)) THEN 1 END) AS t11,
          COUNT(CASE WHEN NVL(t."ZBMDFL",' ') &lt;&gt; 'S' AND ((TRIM(t."ZBTEN3") IS NOT NULL)) AND ((TRIM(t."ZBTEN3") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(t."ZBTEN3"), '^\+?[0-9][0-9 ()/-]{5,}$'))) THEN 1 END) AS f11,
          -- SSADDRP-F03: Telephone number with invalid format (ZBTENO/ZBTEN2)
          COUNT(CASE WHEN NVL(t."ZBMDFL",' ') &lt;&gt; 'S' AND ((TRIM(t."ZBTENO") IS NOT NULL OR TRIM(t."ZBTEN2") IS NOT NULL)) THEN 1 END) AS t12,
          COUNT(CASE WHEN NVL(t."ZBMDFL",' ') &lt;&gt; 'S' AND ((TRIM(t."ZBTENO") IS NOT NULL OR TRIM(t."ZBTEN2") IS NOT NULL)) AND ((TRIM(t."ZBTENO") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(t."ZBTENO"), '^\+?[0-9][0-9 ()/-]{5,}$')) OR (TRIM(t."ZBTEN2") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(t."ZBTEN2"), '^\+?[0-9][0-9 ()/-]{5,}$'))) THEN 1 END) AS f12
        FROM (SELECT x.*,
                     COUNT(CASE WHEN NVL("ZBMDFL",' ') &lt;&gt; 'S' THEN 1 END) OVER (PARTITION BY "ZBDCB", "ZBDCS", "ZBADID") AS dq_dup8
                FROM DATACUT5."HUB_MT_SSADDRP" x) t
        CROSS JOIN params p
        LEFT JOIN ref_ct j1 ON j1.code = TRIM(t."ZBADCE")
        LEFT JOIN k_cus j2 ON j2.dcb = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZBDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZBDCB")) END) AND j2.dcs = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZBDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZBDCS")) END)
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'SSADDRP-001|Missing Data|Missing addressee name, address line 1 (ZBNAD1)',
        (t2, f2) AS 'SSADDRP-002|Missing Data|Address with all address lines 2-5 empty (ZBNAD2-ZBNAD5)',
        (t3, f3) AS 'SSADDRP-003|Missing Data|Missing customer key (ZBDCB/ZBDCS)',
        (t4, f4) AS 'SSADDRP-004|Invalid Values|Address ID not P1-P9 / S1-S9 (ZBADID)',
        (t5, f5) AS 'SSADDRP-005|Invalid Values|Invalid Despatch Code (ZBDPCD), allowed A/C/G/H/K/M/N/P/W',
        (t6, f6) AS 'SSADDRP-006|Invalid Values|Address Country Code (ZBADCE) not a valid country code (SSSTDPP CT)',
        (t7, f7) AS 'SSADDRP-007|Invalid Dates|Invalid date: Last Update Date (ZBDLUP)',
        (t8, f8) AS 'SSADDRP-008|Duplicates|Duplicate address per customer and address ID (ZBDCB+ZBDCS+ZBADID)',
        (t9, f9) AS 'SSADDRP-009|Missing Links|Customer (ZBDCB+ZBDCS) not found in SSCUSTP',
        (t10, f10) AS 'SSADDRP-F01|Format|Fax number with invalid format (ZBFAXN/ZBFAN2)',
        (t11, f11) AS 'SSADDRP-F02|Format|Mobile number with invalid format (ZBTEN3)',
        (t12, f12) AS 'SSADDRP-F03|Format|Telephone number with invalid format (ZBTENO/ZBTEN2)'
      ))
    UNION ALL
/* =============================================================================
   SSALSFP - Account Level Statistics File
   Πίνακας: DATACUT5."HUB_MT_SSALSFP"   Shadow: δεν υπάρχει mode flag   Έλεγχοι: 5
   ============================================================================= */
    SELECT 'SSALSFP - Account Level Statistics File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- SSALSFP-001: Missing customer key (ALDCB/ALDCS)
          COUNT(CASE WHEN 1=1 THEN 1 END) AS t1,
          COUNT(CASE WHEN 1=1 AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."ALDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ALDCB")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ALDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ALDCS")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ALDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ALDCS")) END) = 0) THEN 1 END) AS f1,
          -- SSALSFP-002: Missing account key (ALACB/ALACS/ALACX)
          COUNT(CASE WHEN 1=1 THEN 1 END) AS t2,
          COUNT(CASE WHEN 1=1 AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."ALACB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ALACB")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ALACB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ALACB")) END) = 0 OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ALACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ALACS")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ALACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ALACS")) END) = 0 OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ALACX") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ALACX")) END) IS NULL) THEN 1 END) AS f2,
          -- SSALSFP-003: Country of Registration/Residence (ALCTRS) not a valid country code (SSSTDPP CT)
          COUNT(CASE WHEN (TRIM(t."ALCTRS") IS NOT NULL) THEN 1 END) AS t3,
          COUNT(CASE WHEN (TRIM(t."ALCTRS") IS NOT NULL) AND (j1.code IS NULL) THEN 1 END) AS f3,
          -- SSALSFP-004: Invalid date: Last Update Date (ALDLUP)
          COUNT(CASE WHEN 1=1 THEN 1 END) AS t4,
          COUNT(CASE WHEN 1=1 AND ((NOT (TRIM(t."ALDLUP") IS NULL OR REGEXP_LIKE(TRIM(t."ALDLUP"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."ALDLUP"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."ALDLUP") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."ALDLUP")) END), 0) &lt; 19000101)) THEN 1 END) AS f4,
          -- SSALSFP-005: Customer (ALDCB+ALDCS) not found in SSCUSTP
          COUNT(CASE WHEN ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."ALDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ALDCB")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ALDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ALDCS")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ALDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ALDCS")) END) &lt;&gt; 0) THEN 1 END) AS t5,
          COUNT(CASE WHEN ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."ALDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ALDCB")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ALDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ALDCS")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ALDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ALDCS")) END) &lt;&gt; 0) AND (j2.dcb IS NULL) THEN 1 END) AS f5
        FROM DATACUT5."HUB_MT_SSALSFP" t
        CROSS JOIN params p
        LEFT JOIN ref_ct j1 ON j1.code = TRIM(t."ALCTRS")
        LEFT JOIN k_cus j2 ON j2.dcb = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ALDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ALDCB")) END) AND j2.dcs = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ALDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ALDCS")) END)
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'SSALSFP-001|Missing Data|Missing customer key (ALDCB/ALDCS)',
        (t2, f2) AS 'SSALSFP-002|Missing Data|Missing account key (ALACB/ALACS/ALACX)',
        (t3, f3) AS 'SSALSFP-003|Invalid Values|Country of Registration/Residence (ALCTRS) not a valid country code (SSSTDPP CT)',
        (t4, f4) AS 'SSALSFP-004|Invalid Dates|Invalid date: Last Update Date (ALDLUP)',
        (t5, f5) AS 'SSALSFP-005|Missing Links|Customer (ALDCB+ALDCS) not found in SSCUSTP'
      ))
    UNION ALL
/* =============================================================================
   SSBKLSP - Customer Blacklist File
   Πίνακας: DATACUT5."HUB_MT_SSBKLSP"   Shadow: V7MDFL = 'S' (εξαιρούνται)   Έλεγχοι: 5
   ============================================================================= */
    SELECT 'SSBKLSP - Customer Blacklist File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- SSBKLSP-001: Invalid Identity Document Type (V7IDTY), allowed I/P
          COUNT(CASE WHEN NVL(t."V7MDFL",' ') &lt;&gt; 'S' AND (TRIM(t."V7IDTY") IS NOT NULL) THEN 1 END) AS t1,
          COUNT(CASE WHEN NVL(t."V7MDFL",' ') &lt;&gt; 'S' AND (TRIM(t."V7IDTY") IS NOT NULL) AND (TRIM(t."V7IDTY") NOT IN ('I','P')) THEN 1 END) AS f1,
          -- SSBKLSP-002: Invalid date: Date Request added (V7DTAD)
          COUNT(CASE WHEN NVL(t."V7MDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t2,
          COUNT(CASE WHEN NVL(t."V7MDFL",' ') &lt;&gt; 'S' AND ((NOT (TRIM(t."V7DTAD") IS NULL OR REGEXP_LIKE(TRIM(t."V7DTAD"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."V7DTAD"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."V7DTAD") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."V7DTAD")) END), 0) &lt; 19000101)) THEN 1 END) AS f2,
          -- SSBKLSP-003: Invalid date: Blacklist Expiry Date (V7BLEX)
          COUNT(CASE WHEN NVL(t."V7MDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t3,
          COUNT(CASE WHEN NVL(t."V7MDFL",' ') &lt;&gt; 'S' AND ((NOT (TRIM(t."V7BLEX") IS NULL OR REGEXP_LIKE(TRIM(t."V7BLEX"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."V7BLEX"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."V7BLEX") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."V7BLEX")) END), 0) &lt; 19000101)) THEN 1 END) AS f3,
          -- SSBKLSP-004: Invalid date: Last Update Date (V7DLUP)
          COUNT(CASE WHEN NVL(t."V7MDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t4,
          COUNT(CASE WHEN NVL(t."V7MDFL",' ') &lt;&gt; 'S' AND ((NOT (TRIM(t."V7DLUP") IS NULL OR REGEXP_LIKE(TRIM(t."V7DLUP"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."V7DLUP"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."V7DLUP") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."V7DLUP")) END), 0) &lt; 19000101)) THEN 1 END) AS f4,
          -- SSBKLSP-T01: Expired blacklist record still present (V7BLEX)
          COUNT(CASE WHEN NVL(t."V7MDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t5,
          COUNT(CASE WHEN NVL(t."V7MDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN REGEXP_LIKE(TRIM(t."V7BLEX"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."V7BLEX") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."V7BLEX")) END) &lt; p.ref_num) THEN 1 END) AS f5
        FROM DATACUT5."HUB_MT_SSBKLSP" t
        CROSS JOIN params p
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'SSBKLSP-001|Invalid Values|Invalid Identity Document Type (V7IDTY), allowed I/P',
        (t2, f2) AS 'SSBKLSP-002|Invalid Dates|Invalid date: Date Request added (V7DTAD)',
        (t3, f3) AS 'SSBKLSP-003|Invalid Dates|Invalid date: Blacklist Expiry Date (V7BLEX)',
        (t4, f4) AS 'SSBKLSP-004|Invalid Dates|Invalid date: Last Update Date (V7DLUP)',
        (t5, f5) AS 'SSBKLSP-T01|Timeliness|Expired blacklist record still present (V7BLEX)'
      ))
    UNION ALL
/* =============================================================================
   SSCAIFP - Company Management Information File
   Πίνακας: DATACUT5."HUB_MT_SSCAIFP"   Shadow: ZUMDFL = 'S' (εξαιρούνται)   Έλεγχοι: 17
   ============================================================================= */
    SELECT 'SSCAIFP - Company Management Information File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- SSCAIFP-001: Missing customer key (ZUDCB/ZUDCS)
          COUNT(CASE WHEN NVL(t."ZUMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t1,
          COUNT(CASE WHEN NVL(t."ZUMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZUDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZUDCB")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZUDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZUDCS")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZUDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZUDCS")) END) = 0) THEN 1 END) AS f1,
          -- SSCAIFP-002: Nationality Code (ZUNATY) not a valid country code (SSSTDPP CT)
          COUNT(CASE WHEN NVL(t."ZUMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZUNATY") IS NOT NULL) THEN 1 END) AS t2,
          COUNT(CASE WHEN NVL(t."ZUMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZUNATY") IS NOT NULL) AND (j1.code IS NULL) THEN 1 END) AS f2,
          -- SSCAIFP-003: Invalid Identity Document Type (ZUIDTY), allowed I/P
          COUNT(CASE WHEN NVL(t."ZUMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZUIDTY") IS NOT NULL) THEN 1 END) AS t3,
          COUNT(CASE WHEN NVL(t."ZUMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZUIDTY") IS NOT NULL) AND (TRIM(t."ZUIDTY") NOT IN ('I','P')) THEN 1 END) AS f3,
          -- SSCAIFP-004: Country of Registration/Residence (ZUCTRS) not a valid country code (SSSTDPP CT)
          COUNT(CASE WHEN NVL(t."ZUMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZUCTRS") IS NOT NULL) THEN 1 END) AS t4,
          COUNT(CASE WHEN NVL(t."ZUMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZUCTRS") IS NOT NULL) AND (j2.code IS NULL) THEN 1 END) AS f4,
          -- SSCAIFP-005: Country of Head Quarters (ZUCTHQ) not a valid country code (SSSTDPP CT)
          COUNT(CASE WHEN NVL(t."ZUMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZUCTHQ") IS NOT NULL) THEN 1 END) AS t5,
          COUNT(CASE WHEN NVL(t."ZUMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZUCTHQ") IS NOT NULL) AND (j3.code IS NULL) THEN 1 END) AS f5,
          -- SSCAIFP-006: Country of Birth Place (ZUBCTD) not a valid country code (SSSTDPP CT)
          COUNT(CASE WHEN NVL(t."ZUMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZUBCTD") IS NOT NULL) THEN 1 END) AS t6,
          COUNT(CASE WHEN NVL(t."ZUMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZUBCTD") IS NOT NULL) AND (j4.code IS NULL) THEN 1 END) AS f6,
          -- SSCAIFP-007: Country of Dual Nationality (ZUDUCD) not a valid country code (SSSTDPP CT)
          COUNT(CASE WHEN NVL(t."ZUMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZUDUCD") IS NOT NULL) THEN 1 END) AS t7,
          COUNT(CASE WHEN NVL(t."ZUMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZUDUCD") IS NOT NULL) AND (j5.code IS NULL) THEN 1 END) AS f7,
          -- SSCAIFP-008: Country of Third Nationality (ZUTCTD) not a valid country code (SSSTDPP CT)
          COUNT(CASE WHEN NVL(t."ZUMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZUTCTD") IS NOT NULL) THEN 1 END) AS t8,
          COUNT(CASE WHEN NVL(t."ZUMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZUTCTD") IS NOT NULL) AND (j6.code IS NULL) THEN 1 END) AS f8,
          -- SSCAIFP-009: ADDRESS COUNTRY CODE (ZUADCE) not a valid country code (SSSTDPP CT)
          COUNT(CASE WHEN NVL(t."ZUMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZUADCE") IS NOT NULL) THEN 1 END) AS t9,
          COUNT(CASE WHEN NVL(t."ZUMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZUADCE") IS NOT NULL) AND (j7.code IS NULL) THEN 1 END) AS f9,
          -- SSCAIFP-010: COUNTRY OF TAX RESIDENCY 1 (ZUC1TR) not a valid country code (SSSTDPP CT)
          COUNT(CASE WHEN NVL(t."ZUMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZUC1TR") IS NOT NULL) THEN 1 END) AS t10,
          COUNT(CASE WHEN NVL(t."ZUMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZUC1TR") IS NOT NULL) AND (j8.code IS NULL) THEN 1 END) AS f10,
          -- SSCAIFP-011: COUNTRY OF TAX RESIDENCY 2 (ZUC2TR) not a valid country code (SSSTDPP CT)
          COUNT(CASE WHEN NVL(t."ZUMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZUC2TR") IS NOT NULL) THEN 1 END) AS t11,
          COUNT(CASE WHEN NVL(t."ZUMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZUC2TR") IS NOT NULL) AND (j9.code IS NULL) THEN 1 END) AS f11,
          -- SSCAIFP-012: COUNTRY OF TAX RESIDENCY 3 (ZUC3TR) not a valid country code (SSSTDPP CT)
          COUNT(CASE WHEN NVL(t."ZUMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZUC3TR") IS NOT NULL) THEN 1 END) AS t12,
          COUNT(CASE WHEN NVL(t."ZUMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZUC3TR") IS NOT NULL) AND (j10.code IS NULL) THEN 1 END) AS f12,
          -- SSCAIFP-013: Invalid date: Date of Birth (ZUDTBR)
          COUNT(CASE WHEN NVL(t."ZUMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t13,
          COUNT(CASE WHEN NVL(t."ZUMDFL",' ') &lt;&gt; 'S' AND ((NOT (TRIM(t."ZUDTBR") IS NULL OR REGEXP_LIKE(TRIM(t."ZUDTBR"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."ZUDTBR"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."ZUDTBR") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."ZUDTBR")) END), 0) &lt; 19000101)) THEN 1 END) AS f13,
          -- SSCAIFP-014: Invalid date: Last Update Date (ZUDLUP)
          COUNT(CASE WHEN NVL(t."ZUMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t14,
          COUNT(CASE WHEN NVL(t."ZUMDFL",' ') &lt;&gt; 'S' AND ((NOT (TRIM(t."ZUDLUP") IS NULL OR REGEXP_LIKE(TRIM(t."ZUDLUP"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."ZUDLUP"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."ZUDLUP") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."ZUDLUP")) END), 0) &lt; 19000101)) THEN 1 END) AS f14,
          -- SSCAIFP-015: Customer (ZUDCB+ZUDCS) not found in SSCUSTP
          COUNT(CASE WHEN NVL(t."ZUMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZUDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZUDCB")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZUDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZUDCS")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZUDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZUDCS")) END) &lt;&gt; 0) THEN 1 END) AS t15,
          COUNT(CASE WHEN NVL(t."ZUMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZUDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZUDCB")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZUDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZUDCS")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZUDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZUDCS")) END) &lt;&gt; 0) AND (j11.dcb IS NULL) THEN 1 END) AS f15,
          -- SSCAIFP-016: Customer (ZUDCB2+ZUDCS2) not found in SSCUSTP
          COUNT(CASE WHEN NVL(t."ZUMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZUDCB2") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZUDCB2")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZUDCS2") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZUDCS2")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZUDCS2") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZUDCS2")) END) &lt;&gt; 0) THEN 1 END) AS t16,
          COUNT(CASE WHEN NVL(t."ZUMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZUDCB2") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZUDCB2")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZUDCS2") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZUDCS2")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZUDCS2") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZUDCS2")) END) &lt;&gt; 0) AND (j12.dcb IS NULL) THEN 1 END) AS f16,
          -- SSCAIFP-F01: Telephone number with invalid format (ZUTENO/ZUTEN2)
          COUNT(CASE WHEN NVL(t."ZUMDFL",' ') &lt;&gt; 'S' AND ((TRIM(t."ZUTENO") IS NOT NULL OR TRIM(t."ZUTEN2") IS NOT NULL)) THEN 1 END) AS t17,
          COUNT(CASE WHEN NVL(t."ZUMDFL",' ') &lt;&gt; 'S' AND ((TRIM(t."ZUTENO") IS NOT NULL OR TRIM(t."ZUTEN2") IS NOT NULL)) AND ((TRIM(t."ZUTENO") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(t."ZUTENO"), '^\+?[0-9][0-9 ()/-]{5,}$')) OR (TRIM(t."ZUTEN2") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(t."ZUTEN2"), '^\+?[0-9][0-9 ()/-]{5,}$'))) THEN 1 END) AS f17
        FROM DATACUT5."HUB_MT_SSCAIFP" t
        CROSS JOIN params p
        LEFT JOIN ref_ct j1 ON j1.code = TRIM(t."ZUNATY")
        LEFT JOIN ref_ct j2 ON j2.code = TRIM(t."ZUCTRS")
        LEFT JOIN ref_ct j3 ON j3.code = TRIM(t."ZUCTHQ")
        LEFT JOIN ref_ct j4 ON j4.code = TRIM(t."ZUBCTD")
        LEFT JOIN ref_ct j5 ON j5.code = TRIM(t."ZUDUCD")
        LEFT JOIN ref_ct j6 ON j6.code = TRIM(t."ZUTCTD")
        LEFT JOIN ref_ct j7 ON j7.code = TRIM(t."ZUADCE")
        LEFT JOIN ref_ct j8 ON j8.code = TRIM(t."ZUC1TR")
        LEFT JOIN ref_ct j9 ON j9.code = TRIM(t."ZUC2TR")
        LEFT JOIN ref_ct j10 ON j10.code = TRIM(t."ZUC3TR")
        LEFT JOIN k_cus j11 ON j11.dcb = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZUDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZUDCB")) END) AND j11.dcs = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZUDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZUDCS")) END)
        LEFT JOIN k_cus j12 ON j12.dcb = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZUDCB2") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZUDCB2")) END) AND j12.dcs = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZUDCS2") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZUDCS2")) END)
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'SSCAIFP-001|Missing Data|Missing customer key (ZUDCB/ZUDCS)',
        (t2, f2) AS 'SSCAIFP-002|Invalid Values|Nationality Code (ZUNATY) not a valid country code (SSSTDPP CT)',
        (t3, f3) AS 'SSCAIFP-003|Invalid Values|Invalid Identity Document Type (ZUIDTY), allowed I/P',
        (t4, f4) AS 'SSCAIFP-004|Invalid Values|Country of Registration/Residence (ZUCTRS) not a valid country code (SSSTDPP CT)',
        (t5, f5) AS 'SSCAIFP-005|Invalid Values|Country of Head Quarters (ZUCTHQ) not a valid country code (SSSTDPP CT)',
        (t6, f6) AS 'SSCAIFP-006|Invalid Values|Country of Birth Place (ZUBCTD) not a valid country code (SSSTDPP CT)',
        (t7, f7) AS 'SSCAIFP-007|Invalid Values|Country of Dual Nationality (ZUDUCD) not a valid country code (SSSTDPP CT)',
        (t8, f8) AS 'SSCAIFP-008|Invalid Values|Country of Third Nationality (ZUTCTD) not a valid country code (SSSTDPP CT)',
        (t9, f9) AS 'SSCAIFP-009|Invalid Values|ADDRESS COUNTRY CODE (ZUADCE) not a valid country code (SSSTDPP CT)',
        (t10, f10) AS 'SSCAIFP-010|Invalid Values|COUNTRY OF TAX RESIDENCY 1 (ZUC1TR) not a valid country code (SSSTDPP CT)',
        (t11, f11) AS 'SSCAIFP-011|Invalid Values|COUNTRY OF TAX RESIDENCY 2 (ZUC2TR) not a valid country code (SSSTDPP CT)',
        (t12, f12) AS 'SSCAIFP-012|Invalid Values|COUNTRY OF TAX RESIDENCY 3 (ZUC3TR) not a valid country code (SSSTDPP CT)',
        (t13, f13) AS 'SSCAIFP-013|Invalid Dates|Invalid date: Date of Birth (ZUDTBR)',
        (t14, f14) AS 'SSCAIFP-014|Invalid Dates|Invalid date: Last Update Date (ZUDLUP)',
        (t15, f15) AS 'SSCAIFP-015|Missing Links|Customer (ZUDCB+ZUDCS) not found in SSCUSTP',
        (t16, f16) AS 'SSCAIFP-016|Missing Links|Customer (ZUDCB2+ZUDCS2) not found in SSCUSTP',
        (t17, f17) AS 'SSCAIFP-F01|Format|Telephone number with invalid format (ZUTENO/ZUTEN2)'
      ))
    UNION ALL
/* =============================================================================
   SSCDDMP - Customer Remediation Master File
   Πίνακας: DATACUT5."HUB_MT_SSCDDMP"   Shadow: δεν υπάρχει mode flag   Έλεγχοι: 6
   ============================================================================= */
    SELECT 'SSCDDMP - Customer Remediation Master File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- SSCDDMP-001: Missing customer key (CMDCB/CMDCS)
          COUNT(CASE WHEN 1=1 THEN 1 END) AS t1,
          COUNT(CASE WHEN 1=1 AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."CMDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."CMDCB")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."CMDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."CMDCS")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."CMDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."CMDCS")) END) = 0) THEN 1 END) AS f1,
          -- SSCDDMP-002: Invalid date: LAST CDD REVIEW DATE (CMCLDR)
          COUNT(CASE WHEN 1=1 THEN 1 END) AS t2,
          COUNT(CASE WHEN 1=1 AND ((NOT (TRIM(t."CMCLDR") IS NULL OR REGEXP_LIKE(TRIM(t."CMCLDR"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."CMCLDR"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."CMCLDR") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."CMCLDR")) END), 0) &lt; 19000101)) THEN 1 END) AS f2,
          -- SSCDDMP-003: Invalid date: EXPECTED CDD EXPIRY DATE (CMCEYD)
          COUNT(CASE WHEN 1=1 THEN 1 END) AS t3,
          COUNT(CASE WHEN 1=1 AND ((NOT (TRIM(t."CMCEYD") IS NULL OR REGEXP_LIKE(TRIM(t."CMCEYD"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."CMCEYD"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."CMCEYD") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."CMCEYD")) END), 0) &lt; 19000101)) THEN 1 END) AS f3,
          -- SSCDDMP-004: Invalid date: LAST UPDATE DATE (CMDLUP)
          COUNT(CASE WHEN 1=1 THEN 1 END) AS t4,
          COUNT(CASE WHEN 1=1 AND ((NOT (TRIM(t."CMDLUP") IS NULL OR REGEXP_LIKE(TRIM(t."CMDLUP"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."CMDLUP"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."CMDLUP") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."CMDLUP")) END), 0) &lt; 19000101)) THEN 1 END) AS f4,
          -- SSCDDMP-005: Customer (CMDCB+CMDCS) not found in SSCUSTP
          COUNT(CASE WHEN ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."CMDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."CMDCB")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."CMDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."CMDCS")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."CMDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."CMDCS")) END) &lt;&gt; 0) THEN 1 END) AS t5,
          COUNT(CASE WHEN ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."CMDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."CMDCB")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."CMDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."CMDCS")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."CMDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."CMDCS")) END) &lt;&gt; 0) AND (j1.dcb IS NULL) THEN 1 END) AS f5,
          -- SSCDDMP-T01: Customer due diligence expired (CMCEYD)
          COUNT(CASE WHEN 1=1 THEN 1 END) AS t6,
          COUNT(CASE WHEN 1=1 AND ((CASE WHEN REGEXP_LIKE(TRIM(t."CMCEYD"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."CMCEYD") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."CMCEYD")) END) &lt; p.ref_num) THEN 1 END) AS f6
        FROM DATACUT5."HUB_MT_SSCDDMP" t
        CROSS JOIN params p
        LEFT JOIN k_cus j1 ON j1.dcb = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."CMDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."CMDCB")) END) AND j1.dcs = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."CMDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."CMDCS")) END)
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'SSCDDMP-001|Missing Data|Missing customer key (CMDCB/CMDCS)',
        (t2, f2) AS 'SSCDDMP-002|Invalid Dates|Invalid date: LAST CDD REVIEW DATE (CMCLDR)',
        (t3, f3) AS 'SSCDDMP-003|Invalid Dates|Invalid date: EXPECTED CDD EXPIRY DATE (CMCEYD)',
        (t4, f4) AS 'SSCDDMP-004|Invalid Dates|Invalid date: LAST UPDATE DATE (CMDLUP)',
        (t5, f5) AS 'SSCDDMP-005|Missing Links|Customer (CMDCB+CMDCS) not found in SSCUSTP',
        (t6, f6) AS 'SSCDDMP-T01|Timeliness|Customer due diligence expired (CMCEYD)'
      ))
    UNION ALL
/* =============================================================================
   SSCHCLP - SVC Charging Control Master File
   Πίνακας: DATACUT5."HUB_MT_SSCHCLP"   Shadow: SCMDFL = 'S' (εξαιρούνται)   Έλεγχοι: 2
   ============================================================================= */
    SELECT 'SSCHCLP - SVC Charging Control Master File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- SSCHCLP-001: Invalid date: Date of application (SCDTAP)
          COUNT(CASE WHEN NVL(t."SCMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t1,
          COUNT(CASE WHEN NVL(t."SCMDFL",' ') &lt;&gt; 'S' AND ((NOT (TRIM(t."SCDTAP") IS NULL OR REGEXP_LIKE(TRIM(t."SCDTAP"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."SCDTAP"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."SCDTAP") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."SCDTAP")) END), 0) &lt; 19000101)) THEN 1 END) AS f1,
          -- SSCHCLP-002: Invalid date: Last Update Date (SCDLUP)
          COUNT(CASE WHEN NVL(t."SCMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t2,
          COUNT(CASE WHEN NVL(t."SCMDFL",' ') &lt;&gt; 'S' AND ((NOT (TRIM(t."SCDLUP") IS NULL OR REGEXP_LIKE(TRIM(t."SCDLUP"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."SCDLUP"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."SCDLUP") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."SCDLUP")) END), 0) &lt; 19000101)) THEN 1 END) AS f2
        FROM DATACUT5."HUB_MT_SSCHCLP" t
        CROSS JOIN params p
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'SSCHCLP-001|Invalid Dates|Invalid date: Date of application (SCDTAP)',
        (t2, f2) AS 'SSCHCLP-002|Invalid Dates|Invalid date: Last Update Date (SCDLUP)'
      ))
    UNION ALL
/* =============================================================================
   SSCLACP - Closed Account File
   Πίνακας: DATACUT5."HUB_MT_SSCLACP"   Shadow: δεν υπάρχει mode flag   Έλεγχοι: 7
   ============================================================================= */
    SELECT 'SSCLACP - Closed Account File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- SSCLACP-001: Missing customer key (ZIDCB/ZIDCS)
          COUNT(CASE WHEN 1=1 THEN 1 END) AS t1,
          COUNT(CASE WHEN 1=1 AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZIDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZIDCB")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZIDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZIDCS")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZIDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZIDCS")) END) = 0) THEN 1 END) AS f1,
          -- SSCLACP-002: Missing account key (ZIACB/ZIACS/ZIACX)
          COUNT(CASE WHEN 1=1 THEN 1 END) AS t2,
          COUNT(CASE WHEN 1=1 AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZIACB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZIACB")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZIACB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZIACB")) END) = 0 OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZIACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZIACS")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZIACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZIACS")) END) = 0 OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZIACX") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZIACX")) END) IS NULL) THEN 1 END) AS f2,
          -- SSCLACP-003: Invalid date: Date Account Closed (ZIDTAS)
          COUNT(CASE WHEN 1=1 THEN 1 END) AS t3,
          COUNT(CASE WHEN 1=1 AND ((NOT (TRIM(t."ZIDTAS") IS NULL OR REGEXP_LIKE(TRIM(t."ZIDTAS"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."ZIDTAS"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."ZIDTAS") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."ZIDTAS")) END), 0) &lt; 19000101)) THEN 1 END) AS f3,
          -- SSCLACP-004: Invalid date: Date A/C Opened (ZIDTAO)
          COUNT(CASE WHEN 1=1 THEN 1 END) AS t4,
          COUNT(CASE WHEN 1=1 AND ((NOT (TRIM(t."ZIDTAO") IS NULL OR REGEXP_LIKE(TRIM(t."ZIDTAO"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."ZIDTAO"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."ZIDTAO") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."ZIDTAO")) END), 0) &lt; 19000101)) THEN 1 END) AS f4,
          -- SSCLACP-005: Invalid date: Date of Birth (ZIZTBR)
          COUNT(CASE WHEN 1=1 THEN 1 END) AS t5,
          COUNT(CASE WHEN 1=1 AND ((NOT (TRIM(t."ZIZTBR") IS NULL OR REGEXP_LIKE(TRIM(t."ZIZTBR"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."ZIZTBR"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."ZIZTBR") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."ZIZTBR")) END), 0) &lt; 19000101)) THEN 1 END) AS f5,
          -- SSCLACP-006: Customer (ZIDCB+ZIDCS) not found in SSCUSTP
          COUNT(CASE WHEN ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZIDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZIDCB")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZIDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZIDCS")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZIDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZIDCS")) END) &lt;&gt; 0) THEN 1 END) AS t6,
          COUNT(CASE WHEN ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZIDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZIDCB")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZIDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZIDCS")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZIDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZIDCS")) END) &lt;&gt; 0) AND (j1.dcb IS NULL) THEN 1 END) AS f6,
          -- SSCLACP-007: Date Account Closed before Date A/C Opened (ZIDTAS &lt; ZIDTAO)
          COUNT(CASE WHEN 1=1 THEN 1 END) AS t7,
          COUNT(CASE WHEN 1=1 AND ((CASE WHEN REGEXP_LIKE(TRIM(t."ZIDTAS"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."ZIDTAS") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."ZIDTAS")) END) &lt; (CASE WHEN REGEXP_LIKE(TRIM(t."ZIDTAO"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."ZIDTAO") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."ZIDTAO")) END)) THEN 1 END) AS f7
        FROM DATACUT5."HUB_MT_SSCLACP" t
        CROSS JOIN params p
        LEFT JOIN k_cus j1 ON j1.dcb = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZIDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZIDCB")) END) AND j1.dcs = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZIDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZIDCS")) END)
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'SSCLACP-001|Missing Data|Missing customer key (ZIDCB/ZIDCS)',
        (t2, f2) AS 'SSCLACP-002|Missing Data|Missing account key (ZIACB/ZIACS/ZIACX)',
        (t3, f3) AS 'SSCLACP-003|Invalid Dates|Invalid date: Date Account Closed (ZIDTAS)',
        (t4, f4) AS 'SSCLACP-004|Invalid Dates|Invalid date: Date A/C Opened (ZIDTAO)',
        (t5, f5) AS 'SSCLACP-005|Invalid Dates|Invalid date: Date of Birth (ZIZTBR)',
        (t6, f6) AS 'SSCLACP-006|Missing Links|Customer (ZIDCB+ZIDCS) not found in SSCUSTP',
        (t7, f7) AS 'SSCLACP-007|Inconsistent Data|Date Account Closed before Date A/C Opened (ZIDTAS &lt; ZIDTAO)'
      ))
    UNION ALL
/* =============================================================================
   SSCLMTP - Customer Limit File
   Πίνακας: DATACUT5."HUB_MT_SSCLMTP"   Shadow: ZFMDFL = 'S' (εξαιρούνται)   Έλεγχοι: 8
   ============================================================================= */
    SELECT 'SSCLMTP - Customer Limit File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- SSCLMTP-001: Missing customer key (ZFDCB/ZFDCS)
          COUNT(CASE WHEN NVL(t."ZFMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t1,
          COUNT(CASE WHEN NVL(t."ZFMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZFDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZFDCB")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZFDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZFDCS")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZFDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZFDCS")) END) = 0) THEN 1 END) AS f1,
          -- SSCLMTP-002: Invalid Facility Category Code (ZFFCCC), allowed A/B/C
          COUNT(CASE WHEN NVL(t."ZFMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZFFCCC") IS NOT NULL) THEN 1 END) AS t2,
          COUNT(CASE WHEN NVL(t."ZFMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZFFCCC") IS NOT NULL) AND (TRIM(t."ZFFCCC") NOT IN ('A','B','C')) THEN 1 END) AS f2,
          -- SSCLMTP-003: Invalid date: Last Facility Review Date (ZFLFRD)
          COUNT(CASE WHEN NVL(t."ZFMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t3,
          COUNT(CASE WHEN NVL(t."ZFMDFL",' ') &lt;&gt; 'S' AND ((NOT (TRIM(t."ZFLFRD") IS NULL OR REGEXP_LIKE(TRIM(t."ZFLFRD"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."ZFLFRD"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."ZFLFRD") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."ZFLFRD")) END), 0) &lt; 19000101)) THEN 1 END) AS f3,
          -- SSCLMTP-004: Invalid date: Date Last Overlimit (ZFDLOL)
          COUNT(CASE WHEN NVL(t."ZFMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t4,
          COUNT(CASE WHEN NVL(t."ZFMDFL",' ') &lt;&gt; 'S' AND ((NOT (TRIM(t."ZFDLOL") IS NULL OR REGEXP_LIKE(TRIM(t."ZFDLOL"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."ZFDLOL"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."ZFDLOL") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."ZFDLOL")) END), 0) &lt; 19000101)) THEN 1 END) AS f4,
          -- SSCLMTP-005: Invalid date: Last Update Date (ZFDLUP)
          COUNT(CASE WHEN NVL(t."ZFMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t5,
          COUNT(CASE WHEN NVL(t."ZFMDFL",' ') &lt;&gt; 'S' AND ((NOT (TRIM(t."ZFDLUP") IS NULL OR REGEXP_LIKE(TRIM(t."ZFDLUP"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."ZFDLUP"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."ZFDLUP") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."ZFDLUP")) END), 0) &lt; 19000101)) THEN 1 END) AS f5,
          -- SSCLMTP-006: Invalid date: LIMIT MATURITY DATE (ZFOLDD)
          COUNT(CASE WHEN NVL(t."ZFMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t6,
          COUNT(CASE WHEN NVL(t."ZFMDFL",' ') &lt;&gt; 'S' AND ((NOT (TRIM(t."ZFOLDD") IS NULL OR REGEXP_LIKE(TRIM(t."ZFOLDD"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."ZFOLDD"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."ZFOLDD") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."ZFOLDD")) END), 0) &lt; 19000101)) THEN 1 END) AS f6,
          -- SSCLMTP-007: Customer (ZFDCB+ZFDCS) not found in SSCUSTP
          COUNT(CASE WHEN NVL(t."ZFMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZFDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZFDCB")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZFDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZFDCS")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZFDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZFDCS")) END) &lt;&gt; 0) THEN 1 END) AS t7,
          COUNT(CASE WHEN NVL(t."ZFMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZFDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZFDCB")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZFDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZFDCS")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZFDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZFDCS")) END) &lt;&gt; 0) AND (j1.dcb IS NULL) THEN 1 END) AS f7,
          -- SSCLMTP-T01: Credit facility overdue for review (ZFFRDT)
          COUNT(CASE WHEN NVL(t."ZFMDFL",' ') &lt;&gt; 'S' AND (NVL(TRIM(t."ZFDROP"),'#') &lt;&gt; 'Y') THEN 1 END) AS t8,
          COUNT(CASE WHEN NVL(t."ZFMDFL",' ') &lt;&gt; 'S' AND (NVL(TRIM(t."ZFDROP"),'#') &lt;&gt; 'Y') AND ((CASE WHEN REGEXP_LIKE(TRIM(t."ZFFRDT"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."ZFFRDT") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."ZFFRDT")) END) &lt; p.ref_num) THEN 1 END) AS f8
        FROM DATACUT5."HUB_MT_SSCLMTP" t
        CROSS JOIN params p
        LEFT JOIN k_cus j1 ON j1.dcb = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZFDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZFDCB")) END) AND j1.dcs = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZFDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZFDCS")) END)
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'SSCLMTP-001|Missing Data|Missing customer key (ZFDCB/ZFDCS)',
        (t2, f2) AS 'SSCLMTP-002|Invalid Values|Invalid Facility Category Code (ZFFCCC), allowed A/B/C',
        (t3, f3) AS 'SSCLMTP-003|Invalid Dates|Invalid date: Last Facility Review Date (ZFLFRD)',
        (t4, f4) AS 'SSCLMTP-004|Invalid Dates|Invalid date: Date Last Overlimit (ZFDLOL)',
        (t5, f5) AS 'SSCLMTP-005|Invalid Dates|Invalid date: Last Update Date (ZFDLUP)',
        (t6, f6) AS 'SSCLMTP-006|Invalid Dates|Invalid date: LIMIT MATURITY DATE (ZFOLDD)',
        (t7, f7) AS 'SSCLMTP-007|Missing Links|Customer (ZFDCB+ZFDCS) not found in SSCUSTP',
        (t8, f8) AS 'SSCLMTP-T01|Timeliness|Credit facility overdue for review (ZFFRDT)'
      ))
    UNION ALL
/* =============================================================================
   SSCPFCP - Customer Pre Facility File
   Πίνακας: DATACUT5."HUB_MT_SSCPFCP"   Shadow: ZXMDFL = 'S' (εξαιρούνται)   Έλεγχοι: 5
   ============================================================================= */
    SELECT 'SSCPFCP - Customer Pre Facility File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- SSCPFCP-001: Missing customer key (ZXDCB/ZXDCS)
          COUNT(CASE WHEN NVL(t."ZXMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t1,
          COUNT(CASE WHEN NVL(t."ZXMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZXDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZXDCB")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZXDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZXDCS")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZXDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZXDCS")) END) = 0) THEN 1 END) AS f1,
          -- SSCPFCP-002: Invalid date: Date Graded (ZXDTGR)
          COUNT(CASE WHEN NVL(t."ZXMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t2,
          COUNT(CASE WHEN NVL(t."ZXMDFL",' ') &lt;&gt; 'S' AND ((NOT (TRIM(t."ZXDTGR") IS NULL OR REGEXP_LIKE(TRIM(t."ZXDTGR"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."ZXDTGR"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."ZXDTGR") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."ZXDTGR")) END), 0) &lt; 19000101)) THEN 1 END) AS f2,
          -- SSCPFCP-003: Invalid date: Date Request added (ZXDTAD)
          COUNT(CASE WHEN NVL(t."ZXMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t3,
          COUNT(CASE WHEN NVL(t."ZXMDFL",' ') &lt;&gt; 'S' AND ((NOT (TRIM(t."ZXDTAD") IS NULL OR REGEXP_LIKE(TRIM(t."ZXDTAD"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."ZXDTAD"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."ZXDTAD") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."ZXDTAD")) END), 0) &lt; 19000101)) THEN 1 END) AS f3,
          -- SSCPFCP-004: Invalid date: Last Update Date (ZXDLUP)
          COUNT(CASE WHEN NVL(t."ZXMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t4,
          COUNT(CASE WHEN NVL(t."ZXMDFL",' ') &lt;&gt; 'S' AND ((NOT (TRIM(t."ZXDLUP") IS NULL OR REGEXP_LIKE(TRIM(t."ZXDLUP"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."ZXDLUP"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."ZXDLUP") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."ZXDLUP")) END), 0) &lt; 19000101)) THEN 1 END) AS f4,
          -- SSCPFCP-005: Customer (ZXDCB+ZXDCS) not found in SSCUSTP
          COUNT(CASE WHEN NVL(t."ZXMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZXDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZXDCB")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZXDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZXDCS")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZXDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZXDCS")) END) &lt;&gt; 0) THEN 1 END) AS t5,
          COUNT(CASE WHEN NVL(t."ZXMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZXDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZXDCB")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZXDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZXDCS")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZXDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZXDCS")) END) &lt;&gt; 0) AND (j1.dcb IS NULL) THEN 1 END) AS f5
        FROM DATACUT5."HUB_MT_SSCPFCP" t
        CROSS JOIN params p
        LEFT JOIN k_cus j1 ON j1.dcb = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZXDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZXDCB")) END) AND j1.dcs = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZXDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZXDCS")) END)
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'SSCPFCP-001|Missing Data|Missing customer key (ZXDCB/ZXDCS)',
        (t2, f2) AS 'SSCPFCP-002|Invalid Dates|Invalid date: Date Graded (ZXDTGR)',
        (t3, f3) AS 'SSCPFCP-003|Invalid Dates|Invalid date: Date Request added (ZXDTAD)',
        (t4, f4) AS 'SSCPFCP-004|Invalid Dates|Invalid date: Last Update Date (ZXDLUP)',
        (t5, f5) AS 'SSCPFCP-005|Missing Links|Customer (ZXDCB+ZXDCS) not found in SSCUSTP'
      ))
    UNION ALL
/* =============================================================================
   SSCTXPP - Customer Tax Classification file
   Πίνακας: DATACUT5."HUB_MT_SSCTXPP"   Shadow: δεν υπάρχει mode flag   Έλεγχοι: 5
   ============================================================================= */
    SELECT 'SSCTXPP - Customer Tax Classification file' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- SSCTXPP-001: Missing customer key (CTDCB/CTDCS)
          COUNT(CASE WHEN 1=1 THEN 1 END) AS t1,
          COUNT(CASE WHEN 1=1 AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."CTDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."CTDCB")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."CTDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."CTDCS")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."CTDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."CTDCS")) END) = 0) THEN 1 END) AS f1,
          -- SSCTXPP-002: Customer Tax Classification Country (CTTCCO) not a valid country code (SSSTDPP CT)
          COUNT(CASE WHEN (TRIM(t."CTTCCO") IS NOT NULL) THEN 1 END) AS t2,
          COUNT(CASE WHEN (TRIM(t."CTTCCO") IS NOT NULL) AND (j1.code IS NULL) THEN 1 END) AS f2,
          -- SSCTXPP-003: Invalid date: Enhanced Review Completed Date (CTDLRD)
          COUNT(CASE WHEN 1=1 THEN 1 END) AS t3,
          COUNT(CASE WHEN 1=1 AND ((NOT (TRIM(t."CTDLRD") IS NULL OR REGEXP_LIKE(TRIM(t."CTDLRD"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."CTDLRD"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."CTDLRD") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."CTDLRD")) END), 0) &lt; 19000101)) THEN 1 END) AS f3,
          -- SSCTXPP-004: Invalid date: Last Updated Date (CTDLUP)
          COUNT(CASE WHEN 1=1 THEN 1 END) AS t4,
          COUNT(CASE WHEN 1=1 AND ((NOT (TRIM(t."CTDLUP") IS NULL OR REGEXP_LIKE(TRIM(t."CTDLUP"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."CTDLUP"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."CTDLUP") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."CTDLUP")) END), 0) &lt; 19000101)) THEN 1 END) AS f4,
          -- SSCTXPP-005: Customer (CTDCB+CTDCS) not found in SSCUSTP
          COUNT(CASE WHEN ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."CTDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."CTDCB")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."CTDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."CTDCS")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."CTDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."CTDCS")) END) &lt;&gt; 0) THEN 1 END) AS t5,
          COUNT(CASE WHEN ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."CTDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."CTDCB")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."CTDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."CTDCS")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."CTDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."CTDCS")) END) &lt;&gt; 0) AND (j2.dcb IS NULL) THEN 1 END) AS f5
        FROM DATACUT5."HUB_MT_SSCTXPP" t
        CROSS JOIN params p
        LEFT JOIN ref_ct j1 ON j1.code = TRIM(t."CTTCCO")
        LEFT JOIN k_cus j2 ON j2.dcb = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."CTDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."CTDCB")) END) AND j2.dcs = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."CTDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."CTDCS")) END)
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'SSCTXPP-001|Missing Data|Missing customer key (CTDCB/CTDCS)',
        (t2, f2) AS 'SSCTXPP-002|Invalid Values|Customer Tax Classification Country (CTTCCO) not a valid country code (SSSTDPP CT)',
        (t3, f3) AS 'SSCTXPP-003|Invalid Dates|Invalid date: Enhanced Review Completed Date (CTDLRD)',
        (t4, f4) AS 'SSCTXPP-004|Invalid Dates|Invalid date: Last Updated Date (CTDLUP)',
        (t5, f5) AS 'SSCTXPP-005|Missing Links|Customer (CTDCB+CTDCS) not found in SSCUSTP'
      ))
    UNION ALL
/* =============================================================================
   SSCUSTP - Customer Information File
   Πίνακας: DATACUT5."HUB_MT_SSCUSTP"   Shadow: ZGMDFL = 'S' (εξαιρούνται)   Έλεγχοι: 105
   ============================================================================= */
    SELECT 'SSCUSTP - Customer Information File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- SSCUSTP-001: Missing country code or group member (ZGCTCD/ZGDCG)
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t1,
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZGCTCD") IS NULL OR TRIM(t."ZGDCG") IS NULL) THEN 1 END) AS f1,
          -- SSCUSTP-002: Missing customer full name (ZGCSFN)
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t2,
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZGCSFN") IS NULL) THEN 1 END) AS f2,
          -- SSCUSTP-003: Missing correspondence name (ZGCSCN)
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t3,
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZGCSCN") IS NULL) THEN 1 END) AS f3,
          -- SSCUSTP-004: Missing customer short name (ZGCSSN)
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t4,
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZGCSSN") IS NULL) THEN 1 END) AS f4,
          -- SSCUSTP-005: Missing GHO customer classification (ZGGHCL)
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t5,
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZGGHCL") IS NULL) THEN 1 END) AS f5,
          -- SSCUSTP-006: Missing country of residence/registration (ZGCTRS)
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t6,
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZGCTRS") IS NULL) THEN 1 END) AS f6,
          -- SSCUSTP-007: Missing nationality for individuals (ZGNATY, ZGLGTP 01/02)
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZGLGTP") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZGLGTP")) END) IN (1,2)) THEN 1 END) AS t7,
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZGLGTP") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZGLGTP")) END) IN (1,2)) AND (TRIM(t."ZGNATY") IS NULL) THEN 1 END) AS f7,
          -- SSCUSTP-008: Active customer without identity document (ZGIDTY/ZGIDNO)
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZGCAST") = 'Y') THEN 1 END) AS t8,
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZGCAST") = 'Y') AND (TRIM(t."ZGIDTY") IS NULL OR TRIM(t."ZGIDNO") IS NULL) THEN 1 END) AS f8,
          -- SSCUSTP-009: Active customer without tax number (ZGTXNO)
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZGCAST") = 'Y') THEN 1 END) AS t9,
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZGCAST") = 'Y') AND (TRIM(t."ZGTXNO") IS NULL) THEN 1 END) AS f9,
          -- SSCUSTP-010: Missing customer legal type (ZGLGTP)
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t10,
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND (((CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZGLGTP") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZGLGTP")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZGLGTP") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZGLGTP")) END) = 0)) THEN 1 END) AS f10,
          -- SSCUSTP-011: Missing account officer (ZGCRDO)
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t11,
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND (((CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZGCRDO") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZGCRDO")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZGCRDO") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZGCRDO")) END) = 0)) THEN 1 END) AS f11,
          -- SSCUSTP-012: Missing primary market sector (ZGMKS1)
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t12,
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND (((CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZGMKS1") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZGMKS1")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZGMKS1") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZGMKS1")) END) = 0)) THEN 1 END) AS f12,
          -- SSCUSTP-013: Missing industry code (ZGINDY)
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t13,
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND (((CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZGINDY") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZGINDY")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZGINDY") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZGINDY")) END) = 0)) THEN 1 END) AS f13,
          -- SSCUSTP-014: Missing central bank customer classification (ZGCUCL)
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t14,
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZGCUCL") IS NULL) THEN 1 END) AS f14,
          -- SSCUSTP-015: Missing primary address code (ZGADR1)
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t15,
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZGADR1") IS NULL) THEN 1 END) AS f15,
          -- SSCUSTP-016: Missing language code (ZGLANG)
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t16,
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZGLANG") IS NULL) THEN 1 END) AS f16,
          -- SSCUSTP-017: Missing date request added (ZGDTAD)
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t17,
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND ((TRIM(t."ZGDTAD") IS NULL OR REGEXP_LIKE(TRIM(t."ZGDTAD"), '^[0 -]*$'))) THEN 1 END) AS f17,
          -- SSCUSTP-018: Missing last update date (ZGDLUP)
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t18,
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND ((TRIM(t."ZGDLUP") IS NULL OR REGEXP_LIKE(TRIM(t."ZGDLUP"), '^[0 -]*$'))) THEN 1 END) AS f18,
          -- SSCUSTP-019: Customer branch/serial missing or out of range (ZGDCB 1-999, ZGDCS &gt; 0)
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t19,
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZGDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZGDCB")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZGDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZGDCS")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZGDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZGDCB")) END) NOT BETWEEN 1 AND 999 OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZGDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZGDCS")) END) &lt;= 0) THEN 1 END) AS f19,
          -- SSCUSTP-020: Country code not a valid country code (ZGCTCD vs SSSTDPP CT)
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZGCTCD") IS NOT NULL) THEN 1 END) AS t20,
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZGCTCD") IS NOT NULL) AND (j1.code IS NULL) THEN 1 END) AS f20,
          -- SSCUSTP-021: Customer full name contains no letters (ZGCSFN)
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZGCSFN") IS NOT NULL) THEN 1 END) AS t21,
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZGCSFN") IS NOT NULL) AND (NOT REGEXP_LIKE(t."ZGCSFN", '[[:alpha:]]')) THEN 1 END) AS f21,
          -- SSCUSTP-022: Customer names with leading space, double spaces or control characters (ZGCSFN/ZGCSCN/ZGCSSN)
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t22,
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND (REGEXP_LIKE(t."ZGCSFN", '^ |[[:cntrl:]]') OR INSTR(TRIM(t."ZGCSFN"), '  ') &gt; 0 OR REGEXP_LIKE(t."ZGCSCN", '^ |[[:cntrl:]]') OR INSTR(TRIM(t."ZGCSCN"), '  ') &gt; 0 OR REGEXP_LIKE(t."ZGCSSN", '^ |[[:cntrl:]]') OR INSTR(TRIM(t."ZGCSSN"), '  ') &gt; 0) THEN 1 END) AS f22,
          -- SSCUSTP-023: Client indicator missing or not R/C/B (ZGRCBI)
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t23,
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND (NVL(TRIM(t."ZGRCBI"),'#') NOT IN ('R','C','B')) THEN 1 END) AS f23,
          -- SSCUSTP-024: Customer account status missing or not Y/N (ZGCAST)
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t24,
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND (NVL(TRIM(t."ZGCAST"),'#') NOT IN ('Y','N')) THEN 1 END) AS f24,
          -- SSCUSTP-025: Nationality not a valid country code (ZGNATY vs SSSTDPP CT)
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZGNATY") IS NOT NULL) THEN 1 END) AS t25,
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZGNATY") IS NOT NULL) AND (j2.code IS NULL) THEN 1 END) AS f25,
          -- SSCUSTP-026: Country of residence/registration not a valid country code (ZGCTRS vs SSSTDPP CT)
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZGCTRS") IS NOT NULL) THEN 1 END) AS t26,
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZGCTRS") IS NOT NULL) AND (j3.code IS NULL) THEN 1 END) AS f26,
          -- SSCUSTP-027: International customer ID country not a valid country code (ZGICC vs SSSTDPP CT)
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZGICC") IS NOT NULL) THEN 1 END) AS t27,
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZGICC") IS NOT NULL) AND (j4.code IS NULL) THEN 1 END) AS f27,
          -- SSCUSTP-028: International customer ID branch/serial out of range (ZGICB/ZGICS)
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZGICC") IS NOT NULL) THEN 1 END) AS t28,
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZGICC") IS NOT NULL) AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZGICB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZGICB")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZGICB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZGICB")) END) NOT BETWEEN 1 AND 9999 OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZGICS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZGICS")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZGICS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZGICS")) END) NOT BETWEEN 1 AND 9999999) THEN 1 END) AS f28,
          -- SSCUSTP-029: Identity document type not I/P (ZGIDTY)
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZGIDTY") IS NOT NULL) THEN 1 END) AS t29,
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZGIDTY") IS NOT NULL) AND (TRIM(t."ZGIDTY") NOT IN ('I','P')) THEN 1 END) AS f29,
          -- SSCUSTP-030: Identity document number with non-alphanumeric characters (ZGIDNO)
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZGIDNO") IS NOT NULL) THEN 1 END) AS t30,
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZGIDNO") IS NOT NULL) AND (NOT REGEXP_LIKE(TRIM(t."ZGIDNO"), '^[A-Za-z0-9]+$')) THEN 1 END) AS f30,
          -- SSCUSTP-031: Language code not P/S (ZGLANG)
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZGLANG") IS NOT NULL) THEN 1 END) AS t31,
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZGLANG") IS NOT NULL) AND (TRIM(t."ZGLANG") NOT IN ('P','S')) THEN 1 END) AS f31,
          -- SSCUSTP-032: GIMIS customer indicator not N/S/M/C/I (ZGGMCI)
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZGGMCI") IS NOT NULL) THEN 1 END) AS t32,
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZGGMCI") IS NOT NULL) AND (TRIM(t."ZGGMCI") NOT IN ('N','S','M','C','I')) THEN 1 END) AS f32,
          -- SSCUSTP-033: EBP customer indicator not Y/N (ZGEBCI)
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZGEBCI") IS NOT NULL) THEN 1 END) AS t33,
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZGEBCI") IS NOT NULL) AND (TRIM(t."ZGEBCI") NOT IN ('Y','N')) THEN 1 END) AS f33,
          -- SSCUSTP-034: International corporate a/c indicator not Y/N (ZGICAI)
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZGICAI") IS NOT NULL) THEN 1 END) AS t34,
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZGICAI") IS NOT NULL) AND (TRIM(t."ZGICAI") NOT IN ('Y','N')) THEN 1 END) AS f34,
          -- SSCUSTP-035: Composite statement required indicator not Y/N (ZGCSRQ)
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZGCSRQ") IS NOT NULL) THEN 1 END) AS t35,
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZGCSRQ") IS NOT NULL) AND (TRIM(t."ZGCSRQ") NOT IN ('Y','N')) THEN 1 END) AS f35,
          -- SSCUSTP-036: Automatic purge indicator not Y/N (ZGAUPU)
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZGAUPU") IS NOT NULL) THEN 1 END) AS t36,
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZGAUPU") IS NOT NULL) AND (TRIM(t."ZGAUPU") NOT IN ('Y','N')) THEN 1 END) AS f36,
          -- SSCUSTP-037: Advice required code not Y/N (ZGADRQ)
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZGADRQ") IS NOT NULL) THEN 1 END) AS t37,
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZGADRQ") IS NOT NULL) AND (TRIM(t."ZGADRQ") NOT IN ('Y','N')) THEN 1 END) AS f37,
          -- SSCUSTP-038: Exempt service charge indicator not Y/N (ZGSCEI)
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZGSCEI") IS NOT NULL) THEN 1 END) AS t38,
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZGSCEI") IS NOT NULL) AND (TRIM(t."ZGSCEI") NOT IN ('Y','N')) THEN 1 END) AS f38,
          -- SSCUSTP-039: Visa card holder indicator not Y/N (ZGVSHD)
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZGVSHD") IS NOT NULL) THEN 1 END) AS t39,
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZGVSHD") IS NOT NULL) AND (TRIM(t."ZGVSHD") NOT IN ('Y','N')) THEN 1 END) AS f39,
          -- SSCUSTP-040: Master card holder indicator not Y/N (ZGMCHD)
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZGMCHD") IS NOT NULL) THEN 1 END) AS t40,
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZGMCHD") IS NOT NULL) AND (TRIM(t."ZGMCHD") NOT IN ('Y','N')) THEN 1 END) AS f40,
          -- SSCUSTP-041: Cheque guaranteed card holder indicator not Y/N (ZGCGCH)
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZGCGCH") IS NOT NULL) THEN 1 END) AS t41,
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZGCGCH") IS NOT NULL) AND (TRIM(t."ZGCGCH") NOT IN ('Y','N')) THEN 1 END) AS f41,
          -- SSCUSTP-042: Drop indicator not Y/N (ZGDROP)
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZGDROP") IS NOT NULL) THEN 1 END) AS t42,
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZGDROP") IS NOT NULL) AND (TRIM(t."ZGDROP") NOT IN ('Y','N')) THEN 1 END) AS f42,
          -- SSCUSTP-043: Print O/D limit indicator not Y/N (ZGPTOD)
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZGPTOD") IS NOT NULL) THEN 1 END) AS t43,
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZGPTOD") IS NOT NULL) AND (TRIM(t."ZGPTOD") NOT IN ('Y','N')) THEN 1 END) AS f43,
          -- SSCUSTP-044: Auto grading indicator not Y/N (ZGAUGR)
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZGAUGR") IS NOT NULL) THEN 1 END) AS t44,
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZGAUGR") IS NOT NULL) AND (TRIM(t."ZGAUGR") NOT IN ('Y','N')) THEN 1 END) AS f44,
          -- SSCUSTP-045: Statement cycle not D/W/F/A/M/B/Q/H/Y/X (ZGSMCY)
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZGSMCY") IS NOT NULL) THEN 1 END) AS t45,
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZGSMCY") IS NOT NULL) AND (TRIM(t."ZGSMCY") NOT IN ('D','W','F','A','M','B','Q','H','Y','X')) THEN 1 END) AS f45,
          -- SSCUSTP-046: Special statement cycle not D/W/F/A/M/B/Q/H/Y/X (ZGSMC2)
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZGSMC2") IS NOT NULL) THEN 1 END) AS t46,
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZGSMC2") IS NOT NULL) AND (TRIM(t."ZGSMC2") NOT IN ('D','W','F','A','M','B','Q','H','Y','X')) THEN 1 END) AS f46,
          -- SSCUSTP-047: Repair charge application method not A/B (ZGRCAM)
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZGRCAM") IS NOT NULL) THEN 1 END) AS t47,
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZGRCAM") IS NOT NULL) AND (TRIM(t."ZGRCAM") NOT IN ('A','B')) THEN 1 END) AS f47,
          -- SSCUSTP-048: Customer legal type not in standing data LE (ZGLGTP)
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZGLGTP") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZGLGTP")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZGLGTP") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZGLGTP")) END) &lt;&gt; 0) THEN 1 END) AS t48,
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZGLGTP") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZGLGTP")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZGLGTP") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZGLGTP")) END) &lt;&gt; 0) AND (j5.n IS NULL) THEN 1 END) AS f48,
          -- SSCUSTP-049: Industry code not in standing data IY (ZGINDY)
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZGINDY") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZGINDY")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZGINDY") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZGINDY")) END) &lt;&gt; 0) THEN 1 END) AS t49,
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZGINDY") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZGINDY")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZGINDY") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZGINDY")) END) &lt;&gt; 0) AND (j6.n IS NULL) THEN 1 END) AS f49,
          -- SSCUSTP-050: Account officer not 001-998 (ZGCRDO)
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZGCRDO") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZGCRDO")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZGCRDO") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZGCRDO")) END) &lt;&gt; 0) THEN 1 END) AS t50,
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZGCRDO") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZGCRDO")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZGCRDO") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZGCRDO")) END) &lt;&gt; 0) AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZGCRDO") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZGCRDO")) END) NOT BETWEEN 1 AND 998) THEN 1 END) AS f50,
          -- SSCUSTP-051: Market sector proportion outside 0-100 (ZGMKP1/ZGMKP2/ZGMKP3)
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t51,
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND (NVL((CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZGMKP1") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZGMKP1")) END),0) NOT BETWEEN 0 AND 100 OR NVL((CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZGMKP2") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZGMKP2")) END),0) NOT BETWEEN 0 AND 100 OR NVL((CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZGMKP3") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZGMKP3")) END),0) NOT BETWEEN 0 AND 100) THEN 1 END) AS f51,
          -- SSCUSTP-052: FX buying/selling margin negative or above 100% (ZGFXBM/ZGFXSM)
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t52,
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND (NVL((CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZGFXBM") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZGFXBM")) END),0) NOT BETWEEN 0 AND 100 OR NVL((CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZGFXSM") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZGFXSM")) END),0) NOT BETWEEN 0 AND 100) THEN 1 END) AS f52,
          -- SSCUSTP-053: Number of copies required negative or above 99 (ZGNOCR)
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t53,
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND (NVL((CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZGNOCR") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZGNOCR")) END),0) NOT BETWEEN 0 AND 99) THEN 1 END) AS f53,
          -- SSCUSTP-054: Negative threshold or pre-approved limit amount (ZGAPTA/ZGAPTT/ZGPRAL)
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t54,
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND (NVL((CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZGAPTA") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZGAPTA")) END),0) &lt; 0 OR NVL((CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZGAPTT") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZGAPTT")) END),0) &lt; 0 OR NVL((CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZGPRAL") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZGPRAL")) END),0) &lt; 0) THEN 1 END) AS f54,
          -- SSCUSTP-055: Random digit outside 0-99 (ZGRDDG)
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t55,
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND (NVL((CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZGRDDG") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZGRDDG")) END),0) NOT BETWEEN 0 AND 99) THEN 1 END) AS f55,
          -- SSCUSTP-056: Time last updated not a valid HHMMSS (ZGTLUP)
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZGTLUP") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZGTLUP")) END) IS NOT NULL) THEN 1 END) AS t56,
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZGTLUP") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZGTLUP")) END) IS NOT NULL) AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZGTLUP") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZGTLUP")) END) &lt; 0 OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZGTLUP") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZGTLUP")) END) &gt; 235959 OR MOD((CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZGTLUP") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZGTLUP")) END),100) &gt; 59 OR MOD(TRUNC((CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZGTLUP") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZGTLUP")) END)/100),100) &gt; 59) THEN 1 END) AS f56,
          -- SSCUSTP-057: Address code not P1-P9 / S1-S9 (ZGADR1-ZGADR9)
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t57,
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND ((TRIM(t."ZGADR1") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(t."ZGADR1"), '^[PS][1-9]$')) OR (TRIM(t."ZGADR2") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(t."ZGADR2"), '^[PS][1-9]$')) OR (TRIM(t."ZGADR3") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(t."ZGADR3"), '^[PS][1-9]$')) OR (TRIM(t."ZGADR4") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(t."ZGADR4"), '^[PS][1-9]$')) OR (TRIM(t."ZGADR5") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(t."ZGADR5"), '^[PS][1-9]$')) OR (TRIM(t."ZGADR6") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(t."ZGADR6"), '^[PS][1-9]$')) OR (TRIM(t."ZGADR7") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(t."ZGADR7"), '^[PS][1-9]$')) OR (TRIM(t."ZGADR8") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(t."ZGADR8"), '^[PS][1-9]$')) OR (TRIM(t."ZGADR9") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(t."ZGADR9"), '^[PS][1-9]$'))) THEN 1 END) AS f57,
          -- SSCUSTP-058: Correspondent bank/branch ID not 4 letters (ZGCBBK/ZGCBBH)
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t58,
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND ((TRIM(t."ZGCBBK") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(t."ZGCBBK"), '^[A-Z]{4}$')) OR (TRIM(t."ZGCBBH") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(t."ZGCBBH"), '^[A-Z]{4}$'))) THEN 1 END) AS f58,
          -- SSCUSTP-059: Name segment beyond full name length (ZGLNSP/ZGFNSP/ZGTLSP/ZGITSP and lengths)
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t59,
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND ((NVL((CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZGLNSP") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZGLNSP")) END),0) &gt; 0 AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZGLNSP") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZGLNSP")) END) + NVL((CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZGLNLN") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZGLNLN")) END),0) - 1 &gt; NVL(LENGTH(RTRIM(t."ZGCSFN")),0)) OR (NVL((CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZGFNSP") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZGFNSP")) END),0) &gt; 0 AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZGFNSP") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZGFNSP")) END) + NVL((CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZGFNLN") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZGFNLN")) END),0) - 1 &gt; NVL(LENGTH(RTRIM(t."ZGCSFN")),0)) OR (NVL((CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZGTLSP") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZGTLSP")) END),0) &gt; 0 AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZGTLSP") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZGTLSP")) END) + NVL((CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZGTLLN") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZGTLLN")) END),0) - 1 &gt; NVL(LENGTH(RTRIM(t."ZGCSFN")),0)) OR (NVL((CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZGITSP") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZGITSP")) END),0) &gt; 0 AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZGITSP") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZGITSP")) END) + NVL((CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZGITLN") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZGITLN")) END),0) - 1 &gt; NVL(LENGTH(RTRIM(t."ZGCSFN")),0))) THEN 1 END) AS f59,
          -- SSCUSTP-060: Invalid Date request added (ZGDTAD)
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t60,
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND ((NOT (TRIM(t."ZGDTAD") IS NULL OR REGEXP_LIKE(TRIM(t."ZGDTAD"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."ZGDTAD"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."ZGDTAD") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."ZGDTAD")) END), 0) &lt; 19000101)) THEN 1 END) AS f60,
          -- SSCUSTP-061: Date request added in the future (ZGDTAD)
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t61,
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND ((NVL((CASE WHEN REGEXP_LIKE(TRIM(t."ZGDTAD"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."ZGDTAD") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."ZGDTAD")) END), 0) &gt; p.ref_num)) THEN 1 END) AS f61,
          -- SSCUSTP-062: Invalid Last update date (ZGDLUP)
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t62,
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND ((NOT (TRIM(t."ZGDLUP") IS NULL OR REGEXP_LIKE(TRIM(t."ZGDLUP"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."ZGDLUP"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."ZGDLUP") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."ZGDLUP")) END), 0) &lt; 19000101)) THEN 1 END) AS f62,
          -- SSCUSTP-063: Last update date in the future (ZGDLUP)
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t63,
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND ((NVL((CASE WHEN REGEXP_LIKE(TRIM(t."ZGDLUP"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."ZGDLUP") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."ZGDLUP")) END), 0) &gt; p.ref_num)) THEN 1 END) AS f63,
          -- SSCUSTP-064: Invalid Next statement date (ZGDTNS)
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t64,
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND ((NOT (TRIM(t."ZGDTNS") IS NULL OR REGEXP_LIKE(TRIM(t."ZGDTNS"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."ZGDTNS"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."ZGDTNS") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."ZGDTNS")) END), 0) &lt; 19000101)) THEN 1 END) AS f64,
          -- SSCUSTP-065: Next statement date in the past for active customer (ZGDTNS)
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZGCAST") = 'Y' AND TRIM(t."ZGSMCY") IS NOT NULL) THEN 1 END) AS t65,
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZGCAST") = 'Y' AND TRIM(t."ZGSMCY") IS NOT NULL) AND ((CASE WHEN REGEXP_LIKE(TRIM(t."ZGDTNS"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."ZGDTNS") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."ZGDTNS")) END) &lt; p.ref_num) THEN 1 END) AS f65,
          -- SSCUSTP-066: Invalid Special next statement date (ZGDTN2)
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t66,
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND ((NOT (TRIM(t."ZGDTN2") IS NULL OR REGEXP_LIKE(TRIM(t."ZGDTN2"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."ZGDTN2"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."ZGDTN2") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."ZGDTN2")) END), 0) &lt; 19000101)) THEN 1 END) AS f66,
          -- SSCUSTP-067: Invalid Date of contact (ZGDTCT)
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t67,
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND ((NOT (TRIM(t."ZGDTCT") IS NULL OR REGEXP_LIKE(TRIM(t."ZGDTCT"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."ZGDTCT"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."ZGDTCT") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."ZGDTCT")) END), 0) &lt; 19000101)) THEN 1 END) AS f67,
          -- SSCUSTP-068: Date of contact in the future (ZGDTCT)
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t68,
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND ((NVL((CASE WHEN REGEXP_LIKE(TRIM(t."ZGDTCT"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."ZGDTCT") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."ZGDTCT")) END), 0) &gt; p.ref_num)) THEN 1 END) AS f68,
          -- SSCUSTP-069: Invalid GIMIS customer load date (ZGGMDL)
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t69,
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND ((NOT (TRIM(t."ZGGMDL") IS NULL OR REGEXP_LIKE(TRIM(t."ZGGMDL"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."ZGGMDL"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."ZGGMDL") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."ZGGMDL")) END), 0) &lt; 19000101)) THEN 1 END) AS f69,
          -- SSCUSTP-070: GIMIS customer load date in the future (ZGGMDL)
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t70,
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND ((NVL((CASE WHEN REGEXP_LIKE(TRIM(t."ZGGMDL"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."ZGGMDL") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."ZGGMDL")) END), 0) &gt; p.ref_num)) THEN 1 END) AS f70,
          -- SSCUSTP-071: Invalid Entry date of current market sector (ZGMSD1)
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t71,
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND ((NOT (TRIM(t."ZGMSD1") IS NULL OR REGEXP_LIKE(TRIM(t."ZGMSD1"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."ZGMSD1"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."ZGMSD1") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."ZGMSD1")) END), 0) &lt; 19000101)) THEN 1 END) AS f71,
          -- SSCUSTP-072: Entry date of current market sector in the future (ZGMSD1)
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t72,
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND ((NVL((CASE WHEN REGEXP_LIKE(TRIM(t."ZGMSD1"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."ZGMSD1") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."ZGMSD1")) END), 0) &gt; p.ref_num)) THEN 1 END) AS f72,
          -- SSCUSTP-073: Invalid Entry date of previous market sector (ZGMSD2)
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t73,
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND ((NOT (TRIM(t."ZGMSD2") IS NULL OR REGEXP_LIKE(TRIM(t."ZGMSD2"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."ZGMSD2"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."ZGMSD2") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."ZGMSD2")) END), 0) &lt; 19000101)) THEN 1 END) AS f73,
          -- SSCUSTP-074: Entry date of previous market sector in the future (ZGMSD2)
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t74,
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND ((NVL((CASE WHEN REGEXP_LIKE(TRIM(t."ZGMSD2"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."ZGMSD2") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."ZGMSD2")) END), 0) &gt; p.ref_num)) THEN 1 END) AS f74,
          -- SSCUSTP-075: Duplicate customer key (ZGDCB+ZGDCS)
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZGDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZGDCB")) END) IS NOT NULL) THEN 1 END) AS t75,
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZGDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZGDCB")) END) IS NOT NULL) AND (t.dq_dup75 &gt; 1) THEN 1 END) AS f75,
          -- SSCUSTP-076: Duplicate full customer key (ZGCTCD+ZGDCG+ZGDCB+ZGDCS)
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZGDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZGDCB")) END) IS NOT NULL) THEN 1 END) AS t76,
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZGDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZGDCB")) END) IS NOT NULL) AND (t.dq_dup76 &gt; 1) THEN 1 END) AS f76,
          -- SSCUSTP-077: Same identity document on more than one customer (ZGIDTY+ZGIDNO)
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZGIDNO") IS NOT NULL) THEN 1 END) AS t77,
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZGIDNO") IS NOT NULL) AND (t.dq_dup77 &gt; 1) THEN 1 END) AS f77,
          -- SSCUSTP-078: Same tax number on more than one customer (ZGTXNO)
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZGTXNO") IS NOT NULL) THEN 1 END) AS t78,
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZGTXNO") IS NOT NULL) AND (t.dq_dup78 &gt; 1) THEN 1 END) AS f78,
          -- SSCUSTP-079: Same full name and ID number on different customers (ZGCSFN+ZGIDNO)
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZGIDNO") IS NOT NULL AND TRIM(t."ZGCSFN") IS NOT NULL) THEN 1 END) AS t79,
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZGIDNO") IS NOT NULL AND TRIM(t."ZGCSFN") IS NOT NULL) AND (t.dq_dup79 &gt; 1) THEN 1 END) AS f79,
          -- SSCUSTP-080: Same address code repeated within customer (ZGADR1-ZGADR9)
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t80,
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND ((TRIM(t."ZGADR1") IS NOT NULL AND TRIM(t."ZGADR1") = TRIM(t."ZGADR2")) OR (TRIM(t."ZGADR1") IS NOT NULL AND TRIM(t."ZGADR1") = TRIM(t."ZGADR3")) OR (TRIM(t."ZGADR1") IS NOT NULL AND TRIM(t."ZGADR1") = TRIM(t."ZGADR4")) OR (TRIM(t."ZGADR1") IS NOT NULL AND TRIM(t."ZGADR1") = TRIM(t."ZGADR5")) OR (TRIM(t."ZGADR1") IS NOT NULL AND TRIM(t."ZGADR1") = TRIM(t."ZGADR6")) OR (TRIM(t."ZGADR1") IS NOT NULL AND TRIM(t."ZGADR1") = TRIM(t."ZGADR7")) OR (TRIM(t."ZGADR1") IS NOT NULL AND TRIM(t."ZGADR1") = TRIM(t."ZGADR8")) OR (TRIM(t."ZGADR1") IS NOT NULL AND TRIM(t."ZGADR1") = TRIM(t."ZGADR9")) OR (TRIM(t."ZGADR2") IS NOT NULL AND TRIM(t."ZGADR2") = TRIM(t."ZGADR3")) OR (TRIM(t."ZGADR2") IS NOT NULL AND TRIM(t."ZGADR2") = TRIM(t."ZGADR4")) OR (TRIM(t."ZGADR2") IS NOT NULL AND TRIM(t."ZGADR2") = TRIM(t."ZGADR5")) OR (TRIM(t."ZGADR2") IS NOT NULL AND TRIM(t."ZGADR2") = TRIM(t."ZGADR6")) OR (TRIM(t."ZGADR2") IS NOT NULL AND TRIM(t."ZGADR2") = TRIM(t."ZGADR7")) OR (TRIM(t."ZGADR2") IS NOT NULL AND TRIM(t."ZGADR2") = TRIM(t."ZGADR8")) OR (TRIM(t."ZGADR2") IS NOT NULL AND TRIM(t."ZGADR2") = TRIM(t."ZGADR9")) OR (TRIM(t."ZGADR3") IS NOT NULL AND TRIM(t."ZGADR3") = TRIM(t."ZGADR4")) OR (TRIM(t."ZGADR3") IS NOT NULL AND TRIM(t."ZGADR3") = TRIM(t."ZGADR5")) OR (TRIM(t."ZGADR3") IS NOT NULL AND TRIM(t."ZGADR3") = TRIM(t."ZGADR6")) OR (TRIM(t."ZGADR3") IS NOT NULL AND TRIM(t."ZGADR3") = TRIM(t."ZGADR7")) OR (TRIM(t."ZGADR3") IS NOT NULL AND TRIM(t."ZGADR3") = TRIM(t."ZGADR8")) OR (TRIM(t."ZGADR3") IS NOT NULL AND TRIM(t."ZGADR3") = TRIM(t."ZGADR9")) OR (TRIM(t."ZGADR4") IS NOT NULL AND TRIM(t."ZGADR4") = TRIM(t."ZGADR5")) OR (TRIM(t."ZGADR4") IS NOT NULL AND TRIM(t."ZGADR4") = TRIM(t."ZGADR6")) OR (TRIM(t."ZGADR4") IS NOT NULL AND TRIM(t."ZGADR4") = TRIM(t."ZGADR7")) OR (TRIM(t."ZGADR4") IS NOT NULL AND TRIM(t."ZGADR4") = TRIM(t."ZGADR8")) OR (TRIM(t."ZGADR4") IS NOT NULL AND TRIM(t."ZGADR4") = TRIM(t."ZGADR9")) OR (TRIM(t."ZGADR5") IS NOT NULL AND TRIM(t."ZGADR5") = TRIM(t."ZGADR6")) OR (TRIM(t."ZGADR5") IS NOT NULL AND TRIM(t."ZGADR5") = TRIM(t."ZGADR7")) OR (TRIM(t."ZGADR5") IS NOT NULL AND TRIM(t."ZGADR5") = TRIM(t."ZGADR8")) OR (TRIM(t."ZGADR5") IS NOT NULL AND TRIM(t."ZGADR5") = TRIM(t."ZGADR9")) OR (TRIM(t."ZGADR6") IS NOT NULL AND TRIM(t."ZGADR6") = TRIM(t."ZGADR7")) OR (TRIM(t."ZGADR6") IS NOT NULL AND TRIM(t."ZGADR6") = TRIM(t."ZGADR8")) OR (TRIM(t."ZGADR6") IS NOT NULL AND TRIM(t."ZGADR6") = TRIM(t."ZGADR9")) OR (TRIM(t."ZGADR7") IS NOT NULL AND TRIM(t."ZGADR7") = TRIM(t."ZGADR8")) OR (TRIM(t."ZGADR7") IS NOT NULL AND TRIM(t."ZGADR7") = TRIM(t."ZGADR9")) OR (TRIM(t."ZGADR8") IS NOT NULL AND TRIM(t."ZGADR8") = TRIM(t."ZGADR9"))) THEN 1 END) AS f80,
          -- SSCUSTP-081: Same market sector repeated within customer (ZGMKS1/ZGMKS2/ZGMKS3)
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t81,
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND ((NVL((CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZGMKS1") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZGMKS1")) END),0) &lt;&gt; 0 AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZGMKS1") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZGMKS1")) END) = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZGMKS2") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZGMKS2")) END) OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZGMKS1") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZGMKS1")) END) = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZGMKS3") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZGMKS3")) END))) OR (NVL((CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZGMKS2") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZGMKS2")) END),0) &lt;&gt; 0 AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZGMKS2") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZGMKS2")) END) = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZGMKS3") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZGMKS3")) END))) THEN 1 END) AS f81,
          -- SSCUSTP-082: Customer has neither individual (SSINCIP) nor company (SSNICIP) record
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t82,
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND (j7.dcb IS NULL AND j8.dcb IS NULL) THEN 1 END) AS f82,
          -- SSCUSTP-083: Customer without any address record (SSADDRP)
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t83,
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND (j9.dcb IS NULL) THEN 1 END) AS f83,
          -- SSCUSTP-084: Address code without matching SSADDRP record (ZGADR1-ZGADR9 vs ZBADID)
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t84,
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND ((TRIM(t."ZGADR1") IS NOT NULL AND j10.dcb IS NULL) OR (TRIM(t."ZGADR2") IS NOT NULL AND j11.dcb IS NULL) OR (TRIM(t."ZGADR3") IS NOT NULL AND j12.dcb IS NULL) OR (TRIM(t."ZGADR4") IS NOT NULL AND j13.dcb IS NULL) OR (TRIM(t."ZGADR5") IS NOT NULL AND j14.dcb IS NULL) OR (TRIM(t."ZGADR6") IS NOT NULL AND j15.dcb IS NULL) OR (TRIM(t."ZGADR7") IS NOT NULL AND j16.dcb IS NULL) OR (TRIM(t."ZGADR8") IS NOT NULL AND j17.dcb IS NULL) OR (TRIM(t."ZGADR9") IS NOT NULL AND j18.dcb IS NULL)) THEN 1 END) AS f84,
          -- SSCUSTP-085: Identity document type and number not populated together (ZGIDTY/ZGIDNO)
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t85,
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND ((TRIM(t."ZGIDTY") IS NULL AND TRIM(t."ZGIDNO") IS NOT NULL) OR (TRIM(t."ZGIDTY") IS NOT NULL AND TRIM(t."ZGIDNO") IS NULL)) THEN 1 END) AS f85,
          -- SSCUSTP-086: Customer has both individual (SSINCIP) and company (SSNICIP) record
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t86,
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND (j7.dcb IS NOT NULL AND j8.dcb IS NOT NULL) THEN 1 END) AS f86,
          -- SSCUSTP-087: Customer flagged active (ZGCAST=Y) but holds no open DD/LS/TD account
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZGCAST") = 'Y') THEN 1 END) AS t87,
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZGCAST") = 'Y') AND (j19.dcb IS NULL) THEN 1 END) AS f87,
          -- SSCUSTP-088: Customer flagged inactive (ZGCAST=N) but holds an open DD/LS/TD account
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZGCAST") = 'N') THEN 1 END) AS t88,
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZGCAST") = 'N') AND (j19.dcb IS NOT NULL) THEN 1 END) AS f88,
          -- SSCUSTP-089: Dropped customer (ZGDROP=Y) still holds an open DD/LS/TD account
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZGDROP") = 'Y') THEN 1 END) AS t89,
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZGDROP") = 'Y') AND (j19.dcb IS NOT NULL) THEN 1 END) AS f89,
          -- SSCUSTP-090: Dropped customer (ZGDROP=Y) flagged active (ZGCAST=Y)
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t90,
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZGDROP") = 'Y' AND TRIM(t."ZGCAST") = 'Y') THEN 1 END) AS f90,
          -- SSCUSTP-091: Client indicator does not match legal type (ZGRCBI vs ZGLGTP)
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t91,
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND ((TRIM(t."ZGRCBI") = 'R' AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZGLGTP") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZGLGTP")) END) &gt;= 4) OR (TRIM(t."ZGRCBI") IN ('C','B') AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZGLGTP") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZGLGTP")) END) IN (1,2))) THEN 1 END) AS f91,
          -- SSCUSTP-092: Legal type does not match individual/company record (ZGLGTP vs SSINCIP/SSNICIP)
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t92,
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND (((CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZGLGTP") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZGLGTP")) END) IN (1,2) AND j8.dcb IS NOT NULL) OR ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZGLGTP") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZGLGTP")) END) &gt;= 4 AND j7.dcb IS NOT NULL)) THEN 1 END) AS f92,
          -- SSCUSTP-093: Market sector proportions do not sum to 100 (ZGMKS1-3/ZGMKP1-3)
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND ((NVL((CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZGMKS2") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZGMKS2")) END),0) &lt;&gt; 0 OR NVL((CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZGMKS3") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZGMKS3")) END),0) &lt;&gt; 0)) THEN 1 END) AS t93,
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND ((NVL((CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZGMKS2") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZGMKS2")) END),0) &lt;&gt; 0 OR NVL((CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZGMKS3") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZGMKS3")) END),0) &lt;&gt; 0)) AND (NVL((CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZGMKP1") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZGMKP1")) END),0) + NVL((CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZGMKP2") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZGMKP2")) END),0) + NVL((CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZGMKP3") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZGMKP3")) END),0) &lt;&gt; 100) THEN 1 END) AS f93,
          -- SSCUSTP-094: Market sector proportion without sector, or sector without proportion (ZGMKS1-3/ZGMKP1-3)
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t94,
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND ((NVL((CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZGMKP1") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZGMKP1")) END),0) &lt;&gt; 0 AND NVL((CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZGMKS1") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZGMKS1")) END),0) = 0) OR (NVL((CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZGMKP2") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZGMKP2")) END),0) &lt;&gt; 0 AND NVL((CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZGMKS2") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZGMKS2")) END),0) = 0) OR (NVL((CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZGMKP3") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZGMKP3")) END),0) &lt;&gt; 0 AND NVL((CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZGMKS3") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZGMKS3")) END),0) = 0) OR ((NVL((CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZGMKS2") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZGMKS2")) END),0) &lt;&gt; 0 OR NVL((CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZGMKS3") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZGMKS3")) END),0) &lt;&gt; 0) AND NVL((CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZGMKS1") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZGMKS1")) END),0) &lt;&gt; 0 AND NVL((CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZGMKP1") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZGMKP1")) END),0) = 0) OR ((NVL((CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZGMKS2") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZGMKS2")) END),0) &lt;&gt; 0 OR NVL((CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZGMKS3") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZGMKS3")) END),0) &lt;&gt; 0) AND NVL((CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZGMKS2") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZGMKS2")) END),0) &lt;&gt; 0 AND NVL((CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZGMKP2") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZGMKP2")) END),0) = 0) OR ((NVL((CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZGMKS2") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZGMKS2")) END),0) &lt;&gt; 0 OR NVL((CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZGMKS3") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZGMKS3")) END),0) &lt;&gt; 0) AND NVL((CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZGMKS3") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZGMKS3")) END),0) &lt;&gt; 0 AND NVL((CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZGMKP3") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZGMKP3")) END),0) = 0)) THEN 1 END) AS f94,
          -- SSCUSTP-095: Market sector 2/3 populated while sector 1 is empty (ZGMKS1/ZGMKS2/ZGMKS3)
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t95,
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND (NVL((CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZGMKS1") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZGMKS1")) END),0) = 0 AND (NVL((CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZGMKS2") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZGMKS2")) END),0) &lt;&gt; 0 OR NVL((CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZGMKS3") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZGMKS3")) END),0) &lt;&gt; 0)) THEN 1 END) AS f95,
          -- SSCUSTP-096: Previous market sector equals current (ZGPMKS vs ZGMKS1)
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t96,
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND (NVL((CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZGPMKS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZGPMKS")) END),0) &lt;&gt; 0 AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZGPMKS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZGPMKS")) END) = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZGMKS1") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZGMKS1")) END)) THEN 1 END) AS f96,
          -- SSCUSTP-097: Previous market sector and its entry date inconsistent (ZGPMKS/ZGMSD2/ZGMSD1)
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t97,
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND ((NVL((CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZGPMKS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZGPMKS")) END),0) &lt;&gt; 0 AND (TRIM(t."ZGMSD2") IS NULL OR REGEXP_LIKE(TRIM(t."ZGMSD2"), '^[0 -]*$'))) OR (NVL((CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZGPMKS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZGPMKS")) END),0) = 0 AND NOT (TRIM(t."ZGMSD2") IS NULL OR REGEXP_LIKE(TRIM(t."ZGMSD2"), '^[0 -]*$'))) OR ((CASE WHEN REGEXP_LIKE(TRIM(t."ZGMSD2"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."ZGMSD2") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."ZGMSD2")) END) &gt; (CASE WHEN REGEXP_LIKE(TRIM(t."ZGMSD1"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."ZGMSD1") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."ZGMSD1")) END))) THEN 1 END) AS f97,
          -- SSCUSTP-098: International customer ID partially populated (ZGICC/ZGICG/ZGICB/ZGICS)
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t98,
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN TRIM(t."ZGICC") IS NOT NULL THEN 1 ELSE 0 END + CASE WHEN TRIM(t."ZGICG") IS NOT NULL THEN 1 ELSE 0 END + CASE WHEN NVL((CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZGICB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZGICB")) END),0) &lt;&gt; 0 THEN 1 ELSE 0 END + CASE WHEN NVL((CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZGICS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZGICS")) END),0) &lt;&gt; 0 THEN 1 ELSE 0 END) BETWEEN 1 AND 3) THEN 1 END) AS f98,
          -- SSCUSTP-099: 2nd-language names do not match language code (ZGLANG vs ZGC2FN/ZGC2CN/ZGC2SN)
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t99,
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND ((TRIM(t."ZGLANG") = 'P' AND (TRIM(t."ZGC2FN") IS NOT NULL OR TRIM(t."ZGC2CN") IS NOT NULL OR TRIM(t."ZGC2SN") IS NOT NULL)) OR (TRIM(t."ZGLANG") = 'S' AND TRIM(t."ZGC2FN") IS NULL)) THEN 1 END) AS f99,
          -- SSCUSTP-100: Composite statement required without cycle, next date or copies (ZGCSRQ/ZGSMCY/ZGDTNS/ZGNOCR)
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZGCSRQ") = 'Y') THEN 1 END) AS t100,
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZGCSRQ") = 'Y') AND (TRIM(t."ZGSMCY") IS NULL OR (TRIM(t."ZGDTNS") IS NULL OR REGEXP_LIKE(TRIM(t."ZGDTNS"), '^[0 -]*$')) OR NVL((CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZGNOCR") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZGNOCR")) END),0) = 0) THEN 1 END) AS f100,
          -- SSCUSTP-101: Special statement date and special cycle not populated together (ZGDTN2/ZGSMC2)
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t101,
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND ((NOT (TRIM(t."ZGDTN2") IS NULL OR REGEXP_LIKE(TRIM(t."ZGDTN2"), '^[0 -]*$')) AND TRIM(t."ZGSMC2") IS NULL) OR ((TRIM(t."ZGDTN2") IS NULL OR REGEXP_LIKE(TRIM(t."ZGDTN2"), '^[0 -]*$')) AND TRIM(t."ZGSMC2") IS NOT NULL)) THEN 1 END) AS f101,
          -- SSCUSTP-102: GIMIS indicator and GIMIS load date inconsistent (ZGGMCI/ZGGMDL)
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t102,
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND ((TRIM(t."ZGGMCI") IN ('S','M','C','I') AND (TRIM(t."ZGGMDL") IS NULL OR REGEXP_LIKE(TRIM(t."ZGGMDL"), '^[0 -]*$'))) OR (TRIM(t."ZGGMCI") = 'N' AND NOT (TRIM(t."ZGGMDL") IS NULL OR REGEXP_LIKE(TRIM(t."ZGGMDL"), '^[0 -]*$')))) THEN 1 END) AS f102,
          -- SSCUSTP-103: Correspondent bank and branch not populated together (ZGCBBK/ZGCBBH)
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t103,
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND ((TRIM(t."ZGCBBK") IS NOT NULL AND TRIM(t."ZGCBBH") IS NULL) OR (TRIM(t."ZGCBBK") IS NULL AND TRIM(t."ZGCBBH") IS NOT NULL)) THEN 1 END) AS f103,
          -- SSCUSTP-104: Last update date before date request added (ZGDLUP &lt; ZGDTAD)
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t104,
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN REGEXP_LIKE(TRIM(t."ZGDLUP"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."ZGDLUP") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."ZGDLUP")) END) &lt; (CASE WHEN REGEXP_LIKE(TRIM(t."ZGDTAD"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."ZGDTAD") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."ZGDTAD")) END)) THEN 1 END) AS f104,
          -- SSCUSTP-T01: Active customer not updated for more than 2 years (ZGDLUP)
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND (NVL(TRIM(t."ZGDROP"),'#') &lt;&gt; 'Y' AND TRIM(t."ZGCAST") = 'Y') THEN 1 END) AS t105,
          COUNT(CASE WHEN NVL(t."ZGMDFL",' ') &lt;&gt; 'S' AND (NVL(TRIM(t."ZGDROP"),'#') &lt;&gt; 'Y' AND TRIM(t."ZGCAST") = 'Y') AND ((CASE WHEN REGEXP_LIKE(TRIM(t."ZGDLUP"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."ZGDLUP") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."ZGDLUP")) END) &lt; p.ref_num - 20000) THEN 1 END) AS f105
        FROM (SELECT x.*,
                     COUNT(CASE WHEN NVL("ZGMDFL",' ') &lt;&gt; 'S' THEN 1 END) OVER (PARTITION BY "ZGDCB", "ZGDCS") AS dq_dup75,
                     COUNT(CASE WHEN NVL("ZGMDFL",' ') &lt;&gt; 'S' THEN 1 END) OVER (PARTITION BY "ZGCTCD", "ZGDCG", "ZGDCB", "ZGDCS") AS dq_dup76,
                     COUNT(CASE WHEN NVL("ZGMDFL",' ') &lt;&gt; 'S' AND TRIM("ZGIDNO") IS NOT NULL THEN 1 END) OVER (PARTITION BY "ZGIDTY", "ZGIDNO") AS dq_dup77,
                     COUNT(CASE WHEN NVL("ZGMDFL",' ') &lt;&gt; 'S' AND TRIM("ZGTXNO") IS NOT NULL THEN 1 END) OVER (PARTITION BY "ZGTXNO") AS dq_dup78,
                     COUNT(CASE WHEN NVL("ZGMDFL",' ') &lt;&gt; 'S' AND TRIM("ZGIDNO") IS NOT NULL THEN 1 END) OVER (PARTITION BY "ZGCSFN", "ZGIDNO") AS dq_dup79
                FROM DATACUT5."HUB_MT_SSCUSTP" x) t
        CROSS JOIN params p
        LEFT JOIN ref_ct j1 ON j1.code = TRIM(t."ZGCTCD")
        LEFT JOIN ref_ct j2 ON j2.code = TRIM(t."ZGNATY")
        LEFT JOIN ref_ct j3 ON j3.code = TRIM(t."ZGCTRS")
        LEFT JOIN ref_ct j4 ON j4.code = TRIM(t."ZGICC")
        LEFT JOIN ref_le j5 ON j5.n = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZGLGTP") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZGLGTP")) END)
        LEFT JOIN ref_iy j6 ON j6.n = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZGINDY") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZGINDY")) END)
        LEFT JOIN k_ind j7 ON j7.dcb = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZGDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZGDCB")) END) AND j7.dcs = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZGDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZGDCS")) END)
        LEFT JOIN k_nic j8 ON j8.dcb = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZGDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZGDCB")) END) AND j8.dcs = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZGDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZGDCS")) END)
        LEFT JOIN k_adr j9 ON j9.dcb = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZGDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZGDCB")) END) AND j9.dcs = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZGDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZGDCS")) END)
        LEFT JOIN k_adr_id j10 ON j10.dcb = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZGDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZGDCB")) END) AND j10.dcs = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZGDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZGDCS")) END) AND j10.adid = TRIM(t."ZGADR1")
        LEFT JOIN k_adr_id j11 ON j11.dcb = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZGDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZGDCB")) END) AND j11.dcs = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZGDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZGDCS")) END) AND j11.adid = TRIM(t."ZGADR2")
        LEFT JOIN k_adr_id j12 ON j12.dcb = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZGDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZGDCB")) END) AND j12.dcs = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZGDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZGDCS")) END) AND j12.adid = TRIM(t."ZGADR3")
        LEFT JOIN k_adr_id j13 ON j13.dcb = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZGDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZGDCB")) END) AND j13.dcs = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZGDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZGDCS")) END) AND j13.adid = TRIM(t."ZGADR4")
        LEFT JOIN k_adr_id j14 ON j14.dcb = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZGDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZGDCB")) END) AND j14.dcs = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZGDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZGDCS")) END) AND j14.adid = TRIM(t."ZGADR5")
        LEFT JOIN k_adr_id j15 ON j15.dcb = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZGDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZGDCB")) END) AND j15.dcs = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZGDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZGDCS")) END) AND j15.adid = TRIM(t."ZGADR6")
        LEFT JOIN k_adr_id j16 ON j16.dcb = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZGDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZGDCB")) END) AND j16.dcs = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZGDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZGDCS")) END) AND j16.adid = TRIM(t."ZGADR7")
        LEFT JOIN k_adr_id j17 ON j17.dcb = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZGDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZGDCB")) END) AND j17.dcs = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZGDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZGDCS")) END) AND j17.adid = TRIM(t."ZGADR8")
        LEFT JOIN k_adr_id j18 ON j18.dcb = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZGDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZGDCB")) END) AND j18.dcs = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZGDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZGDCS")) END) AND j18.adid = TRIM(t."ZGADR9")
        LEFT JOIN k_open j19 ON j19.dcb = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZGDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZGDCB")) END) AND j19.dcs = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZGDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZGDCS")) END)
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'SSCUSTP-001|Missing Data|Missing country code or group member (ZGCTCD/ZGDCG)',
        (t2, f2) AS 'SSCUSTP-002|Missing Data|Missing customer full name (ZGCSFN)',
        (t3, f3) AS 'SSCUSTP-003|Missing Data|Missing correspondence name (ZGCSCN)',
        (t4, f4) AS 'SSCUSTP-004|Missing Data|Missing customer short name (ZGCSSN)',
        (t5, f5) AS 'SSCUSTP-005|Missing Data|Missing GHO customer classification (ZGGHCL)',
        (t6, f6) AS 'SSCUSTP-006|Missing Data|Missing country of residence/registration (ZGCTRS)',
        (t7, f7) AS 'SSCUSTP-007|Missing Data|Missing nationality for individuals (ZGNATY, ZGLGTP 01/02)',
        (t8, f8) AS 'SSCUSTP-008|Missing Data|Active customer without identity document (ZGIDTY/ZGIDNO)',
        (t9, f9) AS 'SSCUSTP-009|Missing Data|Active customer without tax number (ZGTXNO)',
        (t10, f10) AS 'SSCUSTP-010|Missing Data|Missing customer legal type (ZGLGTP)',
        (t11, f11) AS 'SSCUSTP-011|Missing Data|Missing account officer (ZGCRDO)',
        (t12, f12) AS 'SSCUSTP-012|Missing Data|Missing primary market sector (ZGMKS1)',
        (t13, f13) AS 'SSCUSTP-013|Missing Data|Missing industry code (ZGINDY)',
        (t14, f14) AS 'SSCUSTP-014|Missing Data|Missing central bank customer classification (ZGCUCL)',
        (t15, f15) AS 'SSCUSTP-015|Missing Data|Missing primary address code (ZGADR1)',
        (t16, f16) AS 'SSCUSTP-016|Missing Data|Missing language code (ZGLANG)',
        (t17, f17) AS 'SSCUSTP-017|Missing Data|Missing date request added (ZGDTAD)',
        (t18, f18) AS 'SSCUSTP-018|Missing Data|Missing last update date (ZGDLUP)',
        (t19, f19) AS 'SSCUSTP-019|Invalid Values|Customer branch/serial missing or out of range (ZGDCB 1-999, ZGDCS &gt; 0)',
        (t20, f20) AS 'SSCUSTP-020|Invalid Values|Country code not a valid country code (ZGCTCD vs SSSTDPP CT)',
        (t21, f21) AS 'SSCUSTP-021|Invalid Values|Customer full name contains no letters (ZGCSFN)',
        (t22, f22) AS 'SSCUSTP-022|Invalid Values|Customer names with leading space, double spaces or control characters (ZGCSFN/ZGCSCN/ZGCSSN)',
        (t23, f23) AS 'SSCUSTP-023|Invalid Values|Client indicator missing or not R/C/B (ZGRCBI)',
        (t24, f24) AS 'SSCUSTP-024|Invalid Values|Customer account status missing or not Y/N (ZGCAST)',
        (t25, f25) AS 'SSCUSTP-025|Invalid Values|Nationality not a valid country code (ZGNATY vs SSSTDPP CT)',
        (t26, f26) AS 'SSCUSTP-026|Invalid Values|Country of residence/registration not a valid country code (ZGCTRS vs SSSTDPP CT)',
        (t27, f27) AS 'SSCUSTP-027|Invalid Values|International customer ID country not a valid country code (ZGICC vs SSSTDPP CT)',
        (t28, f28) AS 'SSCUSTP-028|Invalid Values|International customer ID branch/serial out of range (ZGICB/ZGICS)',
        (t29, f29) AS 'SSCUSTP-029|Invalid Values|Identity document type not I/P (ZGIDTY)',
        (t30, f30) AS 'SSCUSTP-030|Invalid Values|Identity document number with non-alphanumeric characters (ZGIDNO)',
        (t31, f31) AS 'SSCUSTP-031|Invalid Values|Language code not P/S (ZGLANG)',
        (t32, f32) AS 'SSCUSTP-032|Invalid Values|GIMIS customer indicator not N/S/M/C/I (ZGGMCI)',
        (t33, f33) AS 'SSCUSTP-033|Invalid Values|EBP customer indicator not Y/N (ZGEBCI)',
        (t34, f34) AS 'SSCUSTP-034|Invalid Values|International corporate a/c indicator not Y/N (ZGICAI)',
        (t35, f35) AS 'SSCUSTP-035|Invalid Values|Composite statement required indicator not Y/N (ZGCSRQ)',
        (t36, f36) AS 'SSCUSTP-036|Invalid Values|Automatic purge indicator not Y/N (ZGAUPU)',
        (t37, f37) AS 'SSCUSTP-037|Invalid Values|Advice required code not Y/N (ZGADRQ)',
        (t38, f38) AS 'SSCUSTP-038|Invalid Values|Exempt service charge indicator not Y/N (ZGSCEI)',
        (t39, f39) AS 'SSCUSTP-039|Invalid Values|Visa card holder indicator not Y/N (ZGVSHD)',
        (t40, f40) AS 'SSCUSTP-040|Invalid Values|Master card holder indicator not Y/N (ZGMCHD)',
        (t41, f41) AS 'SSCUSTP-041|Invalid Values|Cheque guaranteed card holder indicator not Y/N (ZGCGCH)',
        (t42, f42) AS 'SSCUSTP-042|Invalid Values|Drop indicator not Y/N (ZGDROP)',
        (t43, f43) AS 'SSCUSTP-043|Invalid Values|Print O/D limit indicator not Y/N (ZGPTOD)',
        (t44, f44) AS 'SSCUSTP-044|Invalid Values|Auto grading indicator not Y/N (ZGAUGR)',
        (t45, f45) AS 'SSCUSTP-045|Invalid Values|Statement cycle not D/W/F/A/M/B/Q/H/Y/X (ZGSMCY)',
        (t46, f46) AS 'SSCUSTP-046|Invalid Values|Special statement cycle not D/W/F/A/M/B/Q/H/Y/X (ZGSMC2)',
        (t47, f47) AS 'SSCUSTP-047|Invalid Values|Repair charge application method not A/B (ZGRCAM)',
        (t48, f48) AS 'SSCUSTP-048|Invalid Values|Customer legal type not in standing data LE (ZGLGTP)',
        (t49, f49) AS 'SSCUSTP-049|Invalid Values|Industry code not in standing data IY (ZGINDY)',
        (t50, f50) AS 'SSCUSTP-050|Invalid Values|Account officer not 001-998 (ZGCRDO)',
        (t51, f51) AS 'SSCUSTP-051|Invalid Values|Market sector proportion outside 0-100 (ZGMKP1/ZGMKP2/ZGMKP3)',
        (t52, f52) AS 'SSCUSTP-052|Invalid Values|FX buying/selling margin negative or above 100% (ZGFXBM/ZGFXSM)',
        (t53, f53) AS 'SSCUSTP-053|Invalid Values|Number of copies required negative or above 99 (ZGNOCR)',
        (t54, f54) AS 'SSCUSTP-054|Invalid Values|Negative threshold or pre-approved limit amount (ZGAPTA/ZGAPTT/ZGPRAL)',
        (t55, f55) AS 'SSCUSTP-055|Invalid Values|Random digit outside 0-99 (ZGRDDG)',
        (t56, f56) AS 'SSCUSTP-056|Invalid Values|Time last updated not a valid HHMMSS (ZGTLUP)',
        (t57, f57) AS 'SSCUSTP-057|Invalid Values|Address code not P1-P9 / S1-S9 (ZGADR1-ZGADR9)',
        (t58, f58) AS 'SSCUSTP-058|Invalid Values|Correspondent bank/branch ID not 4 letters (ZGCBBK/ZGCBBH)',
        (t59, f59) AS 'SSCUSTP-059|Invalid Values|Name segment beyond full name length (ZGLNSP/ZGFNSP/ZGTLSP/ZGITSP and lengths)',
        (t60, f60) AS 'SSCUSTP-060|Invalid Dates|Invalid Date request added (ZGDTAD)',
        (t61, f61) AS 'SSCUSTP-061|Invalid Dates|Date request added in the future (ZGDTAD)',
        (t62, f62) AS 'SSCUSTP-062|Invalid Dates|Invalid Last update date (ZGDLUP)',
        (t63, f63) AS 'SSCUSTP-063|Invalid Dates|Last update date in the future (ZGDLUP)',
        (t64, f64) AS 'SSCUSTP-064|Invalid Dates|Invalid Next statement date (ZGDTNS)',
        (t65, f65) AS 'SSCUSTP-065|Invalid Dates|Next statement date in the past for active customer (ZGDTNS)',
        (t66, f66) AS 'SSCUSTP-066|Invalid Dates|Invalid Special next statement date (ZGDTN2)',
        (t67, f67) AS 'SSCUSTP-067|Invalid Dates|Invalid Date of contact (ZGDTCT)',
        (t68, f68) AS 'SSCUSTP-068|Invalid Dates|Date of contact in the future (ZGDTCT)',
        (t69, f69) AS 'SSCUSTP-069|Invalid Dates|Invalid GIMIS customer load date (ZGGMDL)',
        (t70, f70) AS 'SSCUSTP-070|Invalid Dates|GIMIS customer load date in the future (ZGGMDL)',
        (t71, f71) AS 'SSCUSTP-071|Invalid Dates|Invalid Entry date of current market sector (ZGMSD1)',
        (t72, f72) AS 'SSCUSTP-072|Invalid Dates|Entry date of current market sector in the future (ZGMSD1)',
        (t73, f73) AS 'SSCUSTP-073|Invalid Dates|Invalid Entry date of previous market sector (ZGMSD2)',
        (t74, f74) AS 'SSCUSTP-074|Invalid Dates|Entry date of previous market sector in the future (ZGMSD2)',
        (t75, f75) AS 'SSCUSTP-075|Duplicates|Duplicate customer key (ZGDCB+ZGDCS)',
        (t76, f76) AS 'SSCUSTP-076|Duplicates|Duplicate full customer key (ZGCTCD+ZGDCG+ZGDCB+ZGDCS)',
        (t77, f77) AS 'SSCUSTP-077|Duplicates|Same identity document on more than one customer (ZGIDTY+ZGIDNO)',
        (t78, f78) AS 'SSCUSTP-078|Duplicates|Same tax number on more than one customer (ZGTXNO)',
        (t79, f79) AS 'SSCUSTP-079|Duplicates|Same full name and ID number on different customers (ZGCSFN+ZGIDNO)',
        (t80, f80) AS 'SSCUSTP-080|Duplicates|Same address code repeated within customer (ZGADR1-ZGADR9)',
        (t81, f81) AS 'SSCUSTP-081|Duplicates|Same market sector repeated within customer (ZGMKS1/ZGMKS2/ZGMKS3)',
        (t82, f82) AS 'SSCUSTP-082|Missing Links|Customer has neither individual (SSINCIP) nor company (SSNICIP) record',
        (t83, f83) AS 'SSCUSTP-083|Missing Links|Customer without any address record (SSADDRP)',
        (t84, f84) AS 'SSCUSTP-084|Missing Links|Address code without matching SSADDRP record (ZGADR1-ZGADR9 vs ZBADID)',
        (t85, f85) AS 'SSCUSTP-085|Inconsistent Data|Identity document type and number not populated together (ZGIDTY/ZGIDNO)',
        (t86, f86) AS 'SSCUSTP-086|Inconsistent Data|Customer has both individual (SSINCIP) and company (SSNICIP) record',
        (t87, f87) AS 'SSCUSTP-087|Inconsistent Data|Customer flagged active (ZGCAST=Y) but holds no open DD/LS/TD account',
        (t88, f88) AS 'SSCUSTP-088|Inconsistent Data|Customer flagged inactive (ZGCAST=N) but holds an open DD/LS/TD account',
        (t89, f89) AS 'SSCUSTP-089|Inconsistent Data|Dropped customer (ZGDROP=Y) still holds an open DD/LS/TD account',
        (t90, f90) AS 'SSCUSTP-090|Inconsistent Data|Dropped customer (ZGDROP=Y) flagged active (ZGCAST=Y)',
        (t91, f91) AS 'SSCUSTP-091|Inconsistent Data|Client indicator does not match legal type (ZGRCBI vs ZGLGTP)',
        (t92, f92) AS 'SSCUSTP-092|Inconsistent Data|Legal type does not match individual/company record (ZGLGTP vs SSINCIP/SSNICIP)',
        (t93, f93) AS 'SSCUSTP-093|Inconsistent Data|Market sector proportions do not sum to 100 (ZGMKS1-3/ZGMKP1-3)',
        (t94, f94) AS 'SSCUSTP-094|Inconsistent Data|Market sector proportion without sector, or sector without proportion (ZGMKS1-3/ZGMKP1-3)',
        (t95, f95) AS 'SSCUSTP-095|Inconsistent Data|Market sector 2/3 populated while sector 1 is empty (ZGMKS1/ZGMKS2/ZGMKS3)',
        (t96, f96) AS 'SSCUSTP-096|Inconsistent Data|Previous market sector equals current (ZGPMKS vs ZGMKS1)',
        (t97, f97) AS 'SSCUSTP-097|Inconsistent Data|Previous market sector and its entry date inconsistent (ZGPMKS/ZGMSD2/ZGMSD1)',
        (t98, f98) AS 'SSCUSTP-098|Inconsistent Data|International customer ID partially populated (ZGICC/ZGICG/ZGICB/ZGICS)',
        (t99, f99) AS 'SSCUSTP-099|Inconsistent Data|2nd-language names do not match language code (ZGLANG vs ZGC2FN/ZGC2CN/ZGC2SN)',
        (t100, f100) AS 'SSCUSTP-100|Inconsistent Data|Composite statement required without cycle, next date or copies (ZGCSRQ/ZGSMCY/ZGDTNS/ZGNOCR)',
        (t101, f101) AS 'SSCUSTP-101|Inconsistent Data|Special statement date and special cycle not populated together (ZGDTN2/ZGSMC2)',
        (t102, f102) AS 'SSCUSTP-102|Inconsistent Data|GIMIS indicator and GIMIS load date inconsistent (ZGGMCI/ZGGMDL)',
        (t103, f103) AS 'SSCUSTP-103|Inconsistent Data|Correspondent bank and branch not populated together (ZGCBBK/ZGCBBH)',
        (t104, f104) AS 'SSCUSTP-104|Inconsistent Data|Last update date before date request added (ZGDLUP &lt; ZGDTAD)',
        (t105, f105) AS 'SSCUSTP-T01|Timeliness|Active customer not updated for more than 2 years (ZGDLUP)'
      ))
    UNION ALL
/* =============================================================================
   SSGHCLP - GHO Customer Classification File
   Πίνακας: DATACUT5."HUB_MT_SSGHCLP"   Shadow: VQMDFL = 'S' (εξαιρούνται)   Έλεγχοι: 1
   ============================================================================= */
    SELECT 'SSGHCLP - GHO Customer Classification File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- SSGHCLP-001: Invalid date: Last Update Date (VQDLUP)
          COUNT(CASE WHEN NVL(t."VQMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t1,
          COUNT(CASE WHEN NVL(t."VQMDFL",' ') &lt;&gt; 'S' AND ((NOT (TRIM(t."VQDLUP") IS NULL OR REGEXP_LIKE(TRIM(t."VQDLUP"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."VQDLUP"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."VQDLUP") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."VQDLUP")) END), 0) &lt; 19000101)) THEN 1 END) AS f1
        FROM DATACUT5."HUB_MT_SSGHCLP" t
        CROSS JOIN params p
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'SSGHCLP-001|Invalid Dates|Invalid date: Last Update Date (VQDLUP)'
      ))
    UNION ALL
/* =============================================================================
   SSGPNMP - Customer Group Name File
   Πίνακας: DATACUT5."HUB_MT_SSGPNMP"   Shadow: ZPMDFL = 'S' (εξαιρούνται)   Έλεγχοι: 1
   ============================================================================= */
    SELECT 'SSGPNMP - Customer Group Name File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- SSGPNMP-001: Invalid date: Last Update Date (ZPDLUP)
          COUNT(CASE WHEN NVL(t."ZPMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t1,
          COUNT(CASE WHEN NVL(t."ZPMDFL",' ') &lt;&gt; 'S' AND ((NOT (TRIM(t."ZPDLUP") IS NULL OR REGEXP_LIKE(TRIM(t."ZPDLUP"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."ZPDLUP"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."ZPDLUP") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."ZPDLUP")) END), 0) &lt; 19000101)) THEN 1 END) AS f1
        FROM DATACUT5."HUB_MT_SSGPNMP" t
        CROSS JOIN params p
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'SSGPNMP-001|Invalid Dates|Invalid date: Last Update Date (ZPDLUP)'
      ))
    UNION ALL
/* =============================================================================
   SSGPRLP - Customer Group Relationships File
   Πίνακας: DATACUT5."HUB_MT_SSGPRLP"   Shadow: ZHMDFL = 'S' (εξαιρούνται)   Έλεγχοι: 3
   ============================================================================= */
    SELECT 'SSGPRLP - Customer Group Relationships File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- SSGPRLP-001: Missing customer key (ZHDCB/ZHDCS)
          COUNT(CASE WHEN NVL(t."ZHMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t1,
          COUNT(CASE WHEN NVL(t."ZHMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZHDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZHDCB")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZHDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZHDCS")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZHDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZHDCS")) END) = 0) THEN 1 END) AS f1,
          -- SSGPRLP-002: Invalid date: Last Update Date (ZHDLUP)
          COUNT(CASE WHEN NVL(t."ZHMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t2,
          COUNT(CASE WHEN NVL(t."ZHMDFL",' ') &lt;&gt; 'S' AND ((NOT (TRIM(t."ZHDLUP") IS NULL OR REGEXP_LIKE(TRIM(t."ZHDLUP"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."ZHDLUP"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."ZHDLUP") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."ZHDLUP")) END), 0) &lt; 19000101)) THEN 1 END) AS f2,
          -- SSGPRLP-003: Customer (ZHDCB+ZHDCS) not found in SSCUSTP
          COUNT(CASE WHEN NVL(t."ZHMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZHDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZHDCB")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZHDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZHDCS")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZHDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZHDCS")) END) &lt;&gt; 0) THEN 1 END) AS t3,
          COUNT(CASE WHEN NVL(t."ZHMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZHDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZHDCB")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZHDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZHDCS")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZHDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZHDCS")) END) &lt;&gt; 0) AND (j1.dcb IS NULL) THEN 1 END) AS f3
        FROM DATACUT5."HUB_MT_SSGPRLP" t
        CROSS JOIN params p
        LEFT JOIN k_cus j1 ON j1.dcb = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZHDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZHDCB")) END) AND j1.dcs = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZHDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZHDCS")) END)
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'SSGPRLP-001|Missing Data|Missing customer key (ZHDCB/ZHDCS)',
        (t2, f2) AS 'SSGPRLP-002|Invalid Dates|Invalid date: Last Update Date (ZHDLUP)',
        (t3, f3) AS 'SSGPRLP-003|Missing Links|Customer (ZHDCB+ZHDCS) not found in SSCUSTP'
      ))
    UNION ALL
/* =============================================================================
   SSHCDMP - HUB CUSTOMER DECEASED MARKER FILE
   Πίνακας: DATACUT5."HUB_MT_SSHCDMP"   Shadow: δεν υπάρχει mode flag   Έλεγχοι: 5
   ============================================================================= */
    SELECT 'SSHCDMP - HUB CUSTOMER DECEASED MARKER FILE' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- SSHCDMP-001: Missing customer key (ZEDCB/ZEDCS)
          COUNT(CASE WHEN 1=1 THEN 1 END) AS t1,
          COUNT(CASE WHEN 1=1 AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZEDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZEDCB")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZEDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZEDCS")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZEDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZEDCS")) END) = 0) THEN 1 END) AS f1,
          -- SSHCDMP-002: Invalid date: DATE DECEASED (ZEDOLS)
          COUNT(CASE WHEN 1=1 THEN 1 END) AS t2,
          COUNT(CASE WHEN 1=1 AND ((NOT (TRIM(t."ZEDOLS") IS NULL OR REGEXP_LIKE(TRIM(t."ZEDOLS"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."ZEDOLS"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."ZEDOLS") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."ZEDOLS")) END), 0) &lt; 19000101)) THEN 1 END) AS f2,
          -- SSHCDMP-003: Invalid date: DATE REQUEST ADDED (ZEDTAD)
          COUNT(CASE WHEN 1=1 THEN 1 END) AS t3,
          COUNT(CASE WHEN 1=1 AND ((NOT (TRIM(t."ZEDTAD") IS NULL OR REGEXP_LIKE(TRIM(t."ZEDTAD"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."ZEDTAD"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."ZEDTAD") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."ZEDTAD")) END), 0) &lt; 19000101)) THEN 1 END) AS f3,
          -- SSHCDMP-004: Invalid date: DATE LAST UPDATED (ZEDLUP)
          COUNT(CASE WHEN 1=1 THEN 1 END) AS t4,
          COUNT(CASE WHEN 1=1 AND ((NOT (TRIM(t."ZEDLUP") IS NULL OR REGEXP_LIKE(TRIM(t."ZEDLUP"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."ZEDLUP"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."ZEDLUP") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."ZEDLUP")) END), 0) &lt; 19000101)) THEN 1 END) AS f4,
          -- SSHCDMP-005: Customer (ZEDCB+ZEDCS) not found in SSCUSTP
          COUNT(CASE WHEN ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZEDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZEDCB")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZEDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZEDCS")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZEDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZEDCS")) END) &lt;&gt; 0) THEN 1 END) AS t5,
          COUNT(CASE WHEN ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZEDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZEDCB")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZEDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZEDCS")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZEDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZEDCS")) END) &lt;&gt; 0) AND (j1.dcb IS NULL) THEN 1 END) AS f5
        FROM DATACUT5."HUB_MT_SSHCDMP" t
        CROSS JOIN params p
        LEFT JOIN k_cus j1 ON j1.dcb = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZEDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZEDCB")) END) AND j1.dcs = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZEDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZEDCS")) END)
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'SSHCDMP-001|Missing Data|Missing customer key (ZEDCB/ZEDCS)',
        (t2, f2) AS 'SSHCDMP-002|Invalid Dates|Invalid date: DATE DECEASED (ZEDOLS)',
        (t3, f3) AS 'SSHCDMP-003|Invalid Dates|Invalid date: DATE REQUEST ADDED (ZEDTAD)',
        (t4, f4) AS 'SSHCDMP-004|Invalid Dates|Invalid date: DATE LAST UPDATED (ZEDLUP)',
        (t5, f5) AS 'SSHCDMP-005|Missing Links|Customer (ZEDCB+ZEDCS) not found in SSCUSTP'
      ))
    UNION ALL
/* =============================================================================
   SSHOLDP - Holds File
   Πίνακας: DATACUT5."HUB_MT_SSHOLDP"   Shadow: X4MDFL = 'S' (εξαιρούνται)   Έλεγχοι: 5
   ============================================================================= */
    SELECT 'SSHOLDP - Holds File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- SSHOLDP-001: Missing account key (X4ACB/X4ACS/X4ACX)
          COUNT(CASE WHEN NVL(t."X4MDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t1,
          COUNT(CASE WHEN NVL(t."X4MDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."X4ACB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."X4ACB")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."X4ACB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."X4ACB")) END) = 0 OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."X4ACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."X4ACS")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."X4ACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."X4ACS")) END) = 0 OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."X4ACX") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."X4ACX")) END) IS NULL) THEN 1 END) AS f1,
          -- SSHOLDP-002: Invalid date: Hold Expiry Date (X4HEDT)
          COUNT(CASE WHEN NVL(t."X4MDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t2,
          COUNT(CASE WHEN NVL(t."X4MDFL",' ') &lt;&gt; 'S' AND ((NOT (TRIM(t."X4HEDT") IS NULL OR REGEXP_LIKE(TRIM(t."X4HEDT"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."X4HEDT"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."X4HEDT") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."X4HEDT")) END), 0) &lt; 19000101)) THEN 1 END) AS f2,
          -- SSHOLDP-003: Invalid date: Last Update Date (X4DLUP)
          COUNT(CASE WHEN NVL(t."X4MDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t3,
          COUNT(CASE WHEN NVL(t."X4MDFL",' ') &lt;&gt; 'S' AND ((NOT (TRIM(t."X4DLUP") IS NULL OR REGEXP_LIKE(TRIM(t."X4DLUP"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."X4DLUP"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."X4DLUP") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."X4DLUP")) END), 0) &lt; 19000101)) THEN 1 END) AS f3,
          -- SSHOLDP-B01: Hold amount greater than DD account ledger balance (X4HDAM &gt; DFRLBL)
          COUNT(CASE WHEN NVL(t."X4MDFL",' ') &lt;&gt; 'S' AND (NVL((CASE WHEN VALIDATE_CONVERSION(TRIM(t."X4HDAM") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."X4HDAM")) END),0) &gt; 0 AND j1.k1 IS NOT NULL) THEN 1 END) AS t4,
          COUNT(CASE WHEN NVL(t."X4MDFL",' ') &lt;&gt; 'S' AND (NVL((CASE WHEN VALIDATE_CONVERSION(TRIM(t."X4HDAM") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."X4HDAM")) END),0) &gt; 0 AND j1.k1 IS NOT NULL) AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."X4HDAM") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."X4HDAM")) END) &gt; NVL(j1.bal,0)) THEN 1 END) AS f4,
          -- SSHOLDP-T01: Expired hold still present (X4HEDT)
          COUNT(CASE WHEN NVL(t."X4MDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t5,
          COUNT(CASE WHEN NVL(t."X4MDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN REGEXP_LIKE(TRIM(t."X4HEDT"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."X4HEDT") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."X4HEDT")) END) &lt; p.ref_num) THEN 1 END) AS f5
        FROM DATACUT5."HUB_MT_SSHOLDP" t
        CROSS JOIN params p
        LEFT JOIN k_dd_bal j1 ON j1.k1 = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."X4ACB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."X4ACB")) END) AND j1.k2 = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."X4ACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."X4ACS")) END) AND j1.k3 = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."X4ACX") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."X4ACX")) END)
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'SSHOLDP-001|Missing Data|Missing account key (X4ACB/X4ACS/X4ACX)',
        (t2, f2) AS 'SSHOLDP-002|Invalid Dates|Invalid date: Hold Expiry Date (X4HEDT)',
        (t3, f3) AS 'SSHOLDP-003|Invalid Dates|Invalid date: Last Update Date (X4DLUP)',
        (t4, f4) AS 'SSHOLDP-B01|Balances|Hold amount greater than DD account ledger balance (X4HDAM &gt; DFRLBL)',
        (t5, f5) AS 'SSHOLDP-T01|Timeliness|Expired hold still present (X4HEDT)'
      ))
    UNION ALL
/* =============================================================================
   SSICADP - Individual Customer Additional Information File
   Πίνακας: DATACUT5."HUB_MT_SSICADP"   Shadow: δεν υπάρχει mode flag   Έλεγχοι: 12
   ============================================================================= */
    SELECT 'SSICADP - Individual Customer Additional Information File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- SSICADP-001: Missing customer key (ZYDCB/ZYDCS)
          COUNT(CASE WHEN 1=1 THEN 1 END) AS t1,
          COUNT(CASE WHEN 1=1 AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZYDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZYDCB")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZYDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZYDCS")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZYDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZYDCS")) END) = 0) THEN 1 END) AS f1,
          -- SSICADP-002: Invalid HSBC Staff Type (ZYSTFT), allowed S/U
          COUNT(CASE WHEN (TRIM(t."ZYSTFT") IS NOT NULL) THEN 1 END) AS t2,
          COUNT(CASE WHEN (TRIM(t."ZYSTFT") IS NOT NULL) AND (TRIM(t."ZYSTFT") NOT IN ('S','U')) THEN 1 END) AS f2,
          -- SSICADP-003: Permanent Address Country (ZYPACU) not a valid country code (SSSTDPP CT)
          COUNT(CASE WHEN (TRIM(t."ZYPACU") IS NOT NULL) THEN 1 END) AS t3,
          COUNT(CASE WHEN (TRIM(t."ZYPACU") IS NOT NULL) AND (j1.code IS NULL) THEN 1 END) AS f3,
          -- SSICADP-004: Country of Dual Nationality (ZYDUCD) not a valid country code (SSSTDPP CT)
          COUNT(CASE WHEN (TRIM(t."ZYDUCD") IS NOT NULL) THEN 1 END) AS t4,
          COUNT(CASE WHEN (TRIM(t."ZYDUCD") IS NOT NULL) AND (j2.code IS NULL) THEN 1 END) AS f4,
          -- SSICADP-005: Country of Third Nationality (ZYTCTD) not a valid country code (SSSTDPP CT)
          COUNT(CASE WHEN (TRIM(t."ZYTCTD") IS NOT NULL) THEN 1 END) AS t5,
          COUNT(CASE WHEN (TRIM(t."ZYTCTD") IS NOT NULL) AND (j3.code IS NULL) THEN 1 END) AS f5,
          -- SSICADP-006: Country of Birth Place (ZYBCTD) not a valid country code (SSSTDPP CT)
          COUNT(CASE WHEN (TRIM(t."ZYBCTD") IS NOT NULL) THEN 1 END) AS t6,
          COUNT(CASE WHEN (TRIM(t."ZYBCTD") IS NOT NULL) AND (j4.code IS NULL) THEN 1 END) AS f6,
          -- SSICADP-007: Country of Tax Residency 1 (ZYC1TR) not a valid country code (SSSTDPP CT)
          COUNT(CASE WHEN (TRIM(t."ZYC1TR") IS NOT NULL) THEN 1 END) AS t7,
          COUNT(CASE WHEN (TRIM(t."ZYC1TR") IS NOT NULL) AND (j5.code IS NULL) THEN 1 END) AS f7,
          -- SSICADP-008: Country of Tax Residency 2 (ZYC2TR) not a valid country code (SSSTDPP CT)
          COUNT(CASE WHEN (TRIM(t."ZYC2TR") IS NOT NULL) THEN 1 END) AS t8,
          COUNT(CASE WHEN (TRIM(t."ZYC2TR") IS NOT NULL) AND (j6.code IS NULL) THEN 1 END) AS f8,
          -- SSICADP-009: Country of Tax Residency 3 (ZYC3TR) not a valid country code (SSSTDPP CT)
          COUNT(CASE WHEN (TRIM(t."ZYC3TR") IS NOT NULL) THEN 1 END) AS t9,
          COUNT(CASE WHEN (TRIM(t."ZYC3TR") IS NOT NULL) AND (j7.code IS NULL) THEN 1 END) AS f9,
          -- SSICADP-010: Invalid date: Id Document Date of Expiry (ZYIDEP)
          COUNT(CASE WHEN 1=1 THEN 1 END) AS t10,
          COUNT(CASE WHEN 1=1 AND ((NOT (TRIM(t."ZYIDEP") IS NULL OR REGEXP_LIKE(TRIM(t."ZYIDEP"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."ZYIDEP"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."ZYIDEP") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."ZYIDEP")) END), 0) &lt; 19000101)) THEN 1 END) AS f10,
          -- SSICADP-011: Customer (ZYDCB+ZYDCS) not found in SSCUSTP
          COUNT(CASE WHEN ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZYDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZYDCB")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZYDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZYDCS")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZYDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZYDCS")) END) &lt;&gt; 0) THEN 1 END) AS t11,
          COUNT(CASE WHEN ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZYDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZYDCB")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZYDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZYDCS")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZYDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZYDCS")) END) &lt;&gt; 0) AND (j8.dcb IS NULL) THEN 1 END) AS f11,
          -- SSICADP-F01: Business e-mail with invalid format (ZYIAD2)
          COUNT(CASE WHEN ((TRIM(t."ZYIAD2") IS NOT NULL)) THEN 1 END) AS t12,
          COUNT(CASE WHEN ((TRIM(t."ZYIAD2") IS NOT NULL)) AND ((TRIM(t."ZYIAD2") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(t."ZYIAD2"), '^[A-Za-z0-9._%+''-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}$'))) THEN 1 END) AS f12
        FROM DATACUT5."HUB_MT_SSICADP" t
        CROSS JOIN params p
        LEFT JOIN ref_ct j1 ON j1.code = TRIM(t."ZYPACU")
        LEFT JOIN ref_ct j2 ON j2.code = TRIM(t."ZYDUCD")
        LEFT JOIN ref_ct j3 ON j3.code = TRIM(t."ZYTCTD")
        LEFT JOIN ref_ct j4 ON j4.code = TRIM(t."ZYBCTD")
        LEFT JOIN ref_ct j5 ON j5.code = TRIM(t."ZYC1TR")
        LEFT JOIN ref_ct j6 ON j6.code = TRIM(t."ZYC2TR")
        LEFT JOIN ref_ct j7 ON j7.code = TRIM(t."ZYC3TR")
        LEFT JOIN k_cus j8 ON j8.dcb = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZYDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZYDCB")) END) AND j8.dcs = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZYDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZYDCS")) END)
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'SSICADP-001|Missing Data|Missing customer key (ZYDCB/ZYDCS)',
        (t2, f2) AS 'SSICADP-002|Invalid Values|Invalid HSBC Staff Type (ZYSTFT), allowed S/U',
        (t3, f3) AS 'SSICADP-003|Invalid Values|Permanent Address Country (ZYPACU) not a valid country code (SSSTDPP CT)',
        (t4, f4) AS 'SSICADP-004|Invalid Values|Country of Dual Nationality (ZYDUCD) not a valid country code (SSSTDPP CT)',
        (t5, f5) AS 'SSICADP-005|Invalid Values|Country of Third Nationality (ZYTCTD) not a valid country code (SSSTDPP CT)',
        (t6, f6) AS 'SSICADP-006|Invalid Values|Country of Birth Place (ZYBCTD) not a valid country code (SSSTDPP CT)',
        (t7, f7) AS 'SSICADP-007|Invalid Values|Country of Tax Residency 1 (ZYC1TR) not a valid country code (SSSTDPP CT)',
        (t8, f8) AS 'SSICADP-008|Invalid Values|Country of Tax Residency 2 (ZYC2TR) not a valid country code (SSSTDPP CT)',
        (t9, f9) AS 'SSICADP-009|Invalid Values|Country of Tax Residency 3 (ZYC3TR) not a valid country code (SSSTDPP CT)',
        (t10, f10) AS 'SSICADP-010|Invalid Dates|Invalid date: Id Document Date of Expiry (ZYIDEP)',
        (t11, f11) AS 'SSICADP-011|Missing Links|Customer (ZYDCB+ZYDCS) not found in SSCUSTP',
        (t12, f12) AS 'SSICADP-F01|Format|Business e-mail with invalid format (ZYIAD2)'
      ))
    UNION ALL
/* =============================================================================
   SSINCIP - Individual Customer Information File
   Πίνακας: DATACUT5."HUB_MT_SSINCIP"   Shadow: ZKMDFL = 'S' (εξαιρούνται)   Έλεγχοι: 14
   ============================================================================= */
    SELECT 'SSINCIP - Individual Customer Information File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- SSINCIP-001: Missing date of birth (ZKDTBR)
          COUNT(CASE WHEN NVL(t."ZKMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t1,
          COUNT(CASE WHEN NVL(t."ZKMDFL",' ') &lt;&gt; 'S' AND ((TRIM(t."ZKDTBR") IS NULL OR REGEXP_LIKE(TRIM(t."ZKDTBR"), '^[0 -]*$'))) THEN 1 END) AS f1,
          -- SSINCIP-002: Missing sex code (ZKSEX)
          COUNT(CASE WHEN NVL(t."ZKMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t2,
          COUNT(CASE WHEN NVL(t."ZKMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZKSEX") IS NULL) THEN 1 END) AS f2,
          -- SSINCIP-003: Missing occupation code (ZKOCPT)
          COUNT(CASE WHEN NVL(t."ZKMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t3,
          COUNT(CASE WHEN NVL(t."ZKMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZKOCPT") IS NULL) THEN 1 END) AS f3,
          -- SSINCIP-004: Missing customer key (ZKDCB/ZKDCS)
          COUNT(CASE WHEN NVL(t."ZKMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t4,
          COUNT(CASE WHEN NVL(t."ZKMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZKDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZKDCB")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZKDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZKDCS")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZKDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZKDCS")) END) = 0) THEN 1 END) AS f4,
          -- SSINCIP-005: Sex code not F/M (ZKSEX)
          COUNT(CASE WHEN NVL(t."ZKMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZKSEX") IS NOT NULL) THEN 1 END) AS t5,
          COUNT(CASE WHEN NVL(t."ZKMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZKSEX") IS NOT NULL) AND (TRIM(t."ZKSEX") NOT IN ('F','M')) THEN 1 END) AS f5,
          -- SSINCIP-006: Occupation code not 01-99 (ZKOCPT)
          COUNT(CASE WHEN NVL(t."ZKMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZKOCPT") IS NOT NULL) THEN 1 END) AS t6,
          COUNT(CASE WHEN NVL(t."ZKMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZKOCPT") IS NOT NULL) AND (NOT REGEXP_LIKE(TRIM(t."ZKOCPT"), '^[0-9]{2}$') OR TRIM(t."ZKOCPT") = '00') THEN 1 END) AS f6,
          -- SSINCIP-007: Marital status not 1/2/3 (ZKMST)
          COUNT(CASE WHEN NVL(t."ZKMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZKMST") IS NOT NULL) THEN 1 END) AS t7,
          COUNT(CASE WHEN NVL(t."ZKMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZKMST") IS NOT NULL) AND (TRIM(t."ZKMST") NOT IN ('1','2','3')) THEN 1 END) AS f7,
          -- SSINCIP-008: Invalid Education Level (ZKEDUC), allowed 1/2/3/4/5
          COUNT(CASE WHEN NVL(t."ZKMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZKEDUC") IS NOT NULL) THEN 1 END) AS t8,
          COUNT(CASE WHEN NVL(t."ZKMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZKEDUC") IS NOT NULL) AND (TRIM(t."ZKEDUC") NOT IN ('1','2','3','4','5')) THEN 1 END) AS f8,
          -- SSINCIP-009: Invalid Home Ownership Status (ZKHOME), allowed 1/2/3/4/5
          COUNT(CASE WHEN NVL(t."ZKMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZKHOME") IS NOT NULL) THEN 1 END) AS t9,
          COUNT(CASE WHEN NVL(t."ZKMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZKHOME") IS NOT NULL) AND (TRIM(t."ZKHOME") NOT IN ('1','2','3','4','5')) THEN 1 END) AS f9,
          -- SSINCIP-010: Invalid Periodicity Code (ZKPRDY), allowed A/B/D/F/H/M/N/Q/W/X/Y
          COUNT(CASE WHEN NVL(t."ZKMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZKPRDY") IS NOT NULL) THEN 1 END) AS t10,
          COUNT(CASE WHEN NVL(t."ZKMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."ZKPRDY") IS NOT NULL) AND (TRIM(t."ZKPRDY") NOT IN ('A','B','D','F','H','M','N','Q','W','X','Y')) THEN 1 END) AS f10,
          -- SSINCIP-011: Customer older than 120 years (ZKDTBR)
          COUNT(CASE WHEN NVL(t."ZKMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t11,
          COUNT(CASE WHEN NVL(t."ZKMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN REGEXP_LIKE(TRIM(t."ZKDTBR"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."ZKDTBR") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."ZKDTBR")) END) &lt; p.ref_num - 1200000) THEN 1 END) AS f11,
          -- SSINCIP-012: Invalid date: Date of Birth (ZKDTBR)
          COUNT(CASE WHEN NVL(t."ZKMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t12,
          COUNT(CASE WHEN NVL(t."ZKMDFL",' ') &lt;&gt; 'S' AND ((NOT (TRIM(t."ZKDTBR") IS NULL OR REGEXP_LIKE(TRIM(t."ZKDTBR"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."ZKDTBR"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."ZKDTBR") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."ZKDTBR")) END), 0) &lt; 19000101)) THEN 1 END) AS f12,
          -- SSINCIP-013: Duplicate individual record per customer (ZKDCB+ZKDCS)
          COUNT(CASE WHEN NVL(t."ZKMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZKDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZKDCB")) END) IS NOT NULL) THEN 1 END) AS t13,
          COUNT(CASE WHEN NVL(t."ZKMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZKDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZKDCB")) END) IS NOT NULL) AND (t.dq_dup13 &gt; 1) THEN 1 END) AS f13,
          -- SSINCIP-014: Customer (ZKDCB+ZKDCS) not found in SSCUSTP
          COUNT(CASE WHEN NVL(t."ZKMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZKDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZKDCB")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZKDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZKDCS")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZKDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZKDCS")) END) &lt;&gt; 0) THEN 1 END) AS t14,
          COUNT(CASE WHEN NVL(t."ZKMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZKDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZKDCB")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZKDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZKDCS")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZKDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZKDCS")) END) &lt;&gt; 0) AND (j1.dcb IS NULL) THEN 1 END) AS f14
        FROM (SELECT x.*,
                     COUNT(CASE WHEN NVL("ZKMDFL",' ') &lt;&gt; 'S' THEN 1 END) OVER (PARTITION BY "ZKDCB", "ZKDCS") AS dq_dup13
                FROM DATACUT5."HUB_MT_SSINCIP" x) t
        CROSS JOIN params p
        LEFT JOIN k_cus j1 ON j1.dcb = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZKDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZKDCB")) END) AND j1.dcs = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZKDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZKDCS")) END)
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'SSINCIP-001|Missing Data|Missing date of birth (ZKDTBR)',
        (t2, f2) AS 'SSINCIP-002|Missing Data|Missing sex code (ZKSEX)',
        (t3, f3) AS 'SSINCIP-003|Missing Data|Missing occupation code (ZKOCPT)',
        (t4, f4) AS 'SSINCIP-004|Missing Data|Missing customer key (ZKDCB/ZKDCS)',
        (t5, f5) AS 'SSINCIP-005|Invalid Values|Sex code not F/M (ZKSEX)',
        (t6, f6) AS 'SSINCIP-006|Invalid Values|Occupation code not 01-99 (ZKOCPT)',
        (t7, f7) AS 'SSINCIP-007|Invalid Values|Marital status not 1/2/3 (ZKMST)',
        (t8, f8) AS 'SSINCIP-008|Invalid Values|Invalid Education Level (ZKEDUC), allowed 1/2/3/4/5',
        (t9, f9) AS 'SSINCIP-009|Invalid Values|Invalid Home Ownership Status (ZKHOME), allowed 1/2/3/4/5',
        (t10, f10) AS 'SSINCIP-010|Invalid Values|Invalid Periodicity Code (ZKPRDY), allowed A/B/D/F/H/M/N/Q/W/X/Y',
        (t11, f11) AS 'SSINCIP-011|Invalid Dates|Customer older than 120 years (ZKDTBR)',
        (t12, f12) AS 'SSINCIP-012|Invalid Dates|Invalid date: Date of Birth (ZKDTBR)',
        (t13, f13) AS 'SSINCIP-013|Duplicates|Duplicate individual record per customer (ZKDCB+ZKDCS)',
        (t14, f14) AS 'SSINCIP-014|Missing Links|Customer (ZKDCB+ZKDCS) not found in SSCUSTP'
      ))
    UNION ALL
/* =============================================================================
   SSLIACP - HUB-Interface A/C Information File
   Πίνακας: DATACUT5."HUB_MT_SSLIACP"   Shadow: ZKMDFL = 'S' (εξαιρούνται)   Έλεγχοι: 4
   ============================================================================= */
    SELECT 'SSLIACP - HUB-Interface A/C Information File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- SSLIACP-001: Missing customer key (ZKDCB/ZKDCS)
          COUNT(CASE WHEN NVL(t."ZKMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t1,
          COUNT(CASE WHEN NVL(t."ZKMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZKDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZKDCB")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZKDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZKDCS")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZKDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZKDCS")) END) = 0) THEN 1 END) AS f1,
          -- SSLIACP-002: Invalid date: Posting Date (ZKPSDT)
          COUNT(CASE WHEN NVL(t."ZKMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t2,
          COUNT(CASE WHEN NVL(t."ZKMDFL",' ') &lt;&gt; 'S' AND ((NOT (TRIM(t."ZKPSDT") IS NULL OR REGEXP_LIKE(TRIM(t."ZKPSDT"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."ZKPSDT"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."ZKPSDT") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."ZKPSDT")) END), 0) &lt; 19000101)) THEN 1 END) AS f2,
          -- SSLIACP-003: Invalid date: Last Update Date (ZKDLUP)
          COUNT(CASE WHEN NVL(t."ZKMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t3,
          COUNT(CASE WHEN NVL(t."ZKMDFL",' ') &lt;&gt; 'S' AND ((NOT (TRIM(t."ZKDLUP") IS NULL OR REGEXP_LIKE(TRIM(t."ZKDLUP"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."ZKDLUP"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."ZKDLUP") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."ZKDLUP")) END), 0) &lt; 19000101)) THEN 1 END) AS f3,
          -- SSLIACP-004: Customer (ZKDCB+ZKDCS) not found in SSCUSTP
          COUNT(CASE WHEN NVL(t."ZKMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZKDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZKDCB")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZKDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZKDCS")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZKDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZKDCS")) END) &lt;&gt; 0) THEN 1 END) AS t4,
          COUNT(CASE WHEN NVL(t."ZKMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZKDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZKDCB")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZKDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZKDCS")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZKDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZKDCS")) END) &lt;&gt; 0) AND (j1.dcb IS NULL) THEN 1 END) AS f4
        FROM DATACUT5."HUB_MT_SSLIACP" t
        CROSS JOIN params p
        LEFT JOIN k_cus j1 ON j1.dcb = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZKDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZKDCB")) END) AND j1.dcs = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZKDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZKDCS")) END)
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'SSLIACP-001|Missing Data|Missing customer key (ZKDCB/ZKDCS)',
        (t2, f2) AS 'SSLIACP-002|Invalid Dates|Invalid date: Posting Date (ZKPSDT)',
        (t3, f3) AS 'SSLIACP-003|Invalid Dates|Invalid date: Last Update Date (ZKDLUP)',
        (t4, f4) AS 'SSLIACP-004|Missing Links|Customer (ZKDCB+ZKDCS) not found in SSCUSTP'
      ))
    UNION ALL
/* =============================================================================
   SSNICIP - Non-individual Customer Information File
   Πίνακας: DATACUT5."HUB_MT_SSNICIP"   Shadow: XUMDFL = 'S' (εξαιρούνται)   Έλεγχοι: 21
   ============================================================================= */
    SELECT 'SSNICIP - Non-individual Customer Information File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- SSNICIP-001: Missing incorporation number (XUINCN)
          COUNT(CASE WHEN NVL(t."XUMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t1,
          COUNT(CASE WHEN NVL(t."XUMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."XUINCN") IS NULL) THEN 1 END) AS f1,
          -- SSNICIP-002: Missing date of incorporation (XUDTIC)
          COUNT(CASE WHEN NVL(t."XUMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t2,
          COUNT(CASE WHEN NVL(t."XUMDFL",' ') &lt;&gt; 'S' AND ((TRIM(t."XUDTIC") IS NULL OR REGEXP_LIKE(TRIM(t."XUDTIC"), '^[0 -]*$'))) THEN 1 END) AS f2,
          -- SSNICIP-003: Missing customer key (XUDCB/XUDCS)
          COUNT(CASE WHEN NVL(t."XUMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t3,
          COUNT(CASE WHEN NVL(t."XUMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."XUDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."XUDCB")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."XUDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."XUDCS")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."XUDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."XUDCS")) END) = 0) THEN 1 END) AS f3,
          -- SSNICIP-004: Counntry of HeadQuarters (XUCTHQ) not a valid country code (SSSTDPP CT)
          COUNT(CASE WHEN NVL(t."XUMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."XUCTHQ") IS NOT NULL) THEN 1 END) AS t4,
          COUNT(CASE WHEN NVL(t."XUMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."XUCTHQ") IS NOT NULL) AND (j1.code IS NULL) THEN 1 END) AS f4,
          -- SSNICIP-005: Invalid Ranking in the Industry-1 (XURNK1), allowed 1/2/3/4
          COUNT(CASE WHEN NVL(t."XUMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."XURNK1") IS NOT NULL) THEN 1 END) AS t5,
          COUNT(CASE WHEN NVL(t."XUMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."XURNK1") IS NOT NULL) AND (TRIM(t."XURNK1") NOT IN ('1','2','3','4')) THEN 1 END) AS f5,
          -- SSNICIP-006: Invalid Ranking in the Industry-1 (XURNK2), allowed 1/2/3/4
          COUNT(CASE WHEN NVL(t."XUMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."XURNK2") IS NOT NULL) THEN 1 END) AS t6,
          COUNT(CASE WHEN NVL(t."XUMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."XURNK2") IS NOT NULL) AND (TRIM(t."XURNK2") NOT IN ('1','2','3','4')) THEN 1 END) AS f6,
          -- SSNICIP-007: Invalid Ranking in the Industry-1 (XURNK3), allowed 1/2/3/4
          COUNT(CASE WHEN NVL(t."XUMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."XURNK3") IS NOT NULL) THEN 1 END) AS t7,
          COUNT(CASE WHEN NVL(t."XUMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."XURNK3") IS NOT NULL) AND (TRIM(t."XURNK3") NOT IN ('1','2','3','4')) THEN 1 END) AS f7,
          -- SSNICIP-008: Invalid Management Style Code (XUMGMT), allowed 1/2/3/4/5
          COUNT(CASE WHEN NVL(t."XUMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."XUMGMT") IS NOT NULL) THEN 1 END) AS t8,
          COUNT(CASE WHEN NVL(t."XUMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."XUMGMT") IS NOT NULL) AND (TRIM(t."XUMGMT") NOT IN ('1','2','3','4','5')) THEN 1 END) AS f8,
          -- SSNICIP-009: Invalid Importance to Bank/Group (XUIMPT), allowed 1/2/3/4
          COUNT(CASE WHEN NVL(t."XUMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."XUIMPT") IS NOT NULL) THEN 1 END) AS t9,
          COUNT(CASE WHEN NVL(t."XUMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."XUIMPT") IS NOT NULL) AND (TRIM(t."XUIMPT") NOT IN ('1','2','3','4')) THEN 1 END) AS f9,
          -- SSNICIP-010: Invalid Tiering (XUTIER), allowed 2/3
          COUNT(CASE WHEN NVL(t."XUMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."XUTIER") IS NOT NULL) THEN 1 END) AS t10,
          COUNT(CASE WHEN NVL(t."XUMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."XUTIER") IS NOT NULL) AND (TRIM(t."XUTIER") NOT IN ('2','3')) THEN 1 END) AS f10,
          -- SSNICIP-011: Invalid HIE IND (XUHIEI), allowed B/E/I/N
          COUNT(CASE WHEN NVL(t."XUMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."XUHIEI") IS NOT NULL) THEN 1 END) AS t11,
          COUNT(CASE WHEN NVL(t."XUMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."XUHIEI") IS NOT NULL) AND (TRIM(t."XUHIEI") NOT IN ('B','E','I','N')) THEN 1 END) AS f11,
          -- SSNICIP-012: Country of Tax Residency 1 (XUC1TR) not a valid country code (SSSTDPP CT)
          COUNT(CASE WHEN NVL(t."XUMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."XUC1TR") IS NOT NULL) THEN 1 END) AS t12,
          COUNT(CASE WHEN NVL(t."XUMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."XUC1TR") IS NOT NULL) AND (j2.code IS NULL) THEN 1 END) AS f12,
          -- SSNICIP-013: Country of Tax Residency 2 (XUC2TR) not a valid country code (SSSTDPP CT)
          COUNT(CASE WHEN NVL(t."XUMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."XUC2TR") IS NOT NULL) THEN 1 END) AS t13,
          COUNT(CASE WHEN NVL(t."XUMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."XUC2TR") IS NOT NULL) AND (j3.code IS NULL) THEN 1 END) AS f13,
          -- SSNICIP-014: Country of Tax Residency 3 (XUC3TR) not a valid country code (SSSTDPP CT)
          COUNT(CASE WHEN NVL(t."XUMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."XUC3TR") IS NOT NULL) THEN 1 END) AS t14,
          COUNT(CASE WHEN NVL(t."XUMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."XUC3TR") IS NOT NULL) AND (j4.code IS NULL) THEN 1 END) AS f14,
          -- SSNICIP-015: Invalid date: Date of Incorporation (XUDTIC)
          COUNT(CASE WHEN NVL(t."XUMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t15,
          COUNT(CASE WHEN NVL(t."XUMDFL",' ') &lt;&gt; 'S' AND ((NOT (TRIM(t."XUDTIC") IS NULL OR REGEXP_LIKE(TRIM(t."XUDTIC"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."XUDTIC"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."XUDTIC") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."XUDTIC")) END), 0) &lt; 19000101)) THEN 1 END) AS f15,
          -- SSNICIP-016: Invalid date: Business Start Date (XUDTBS)
          COUNT(CASE WHEN NVL(t."XUMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t16,
          COUNT(CASE WHEN NVL(t."XUMDFL",' ') &lt;&gt; 'S' AND ((NOT (TRIM(t."XUDTBS") IS NULL OR REGEXP_LIKE(TRIM(t."XUDTBS"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."XUDTBS"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."XUDTBS") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."XUDTBS")) END), 0) &lt; 19000101)) THEN 1 END) AS f16,
          -- SSNICIP-017: Duplicate company record per customer (XUDCB+XUDCS)
          COUNT(CASE WHEN NVL(t."XUMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."XUDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."XUDCB")) END) IS NOT NULL) THEN 1 END) AS t17,
          COUNT(CASE WHEN NVL(t."XUMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."XUDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."XUDCB")) END) IS NOT NULL) AND (t.dq_dup17 &gt; 1) THEN 1 END) AS f17,
          -- SSNICIP-018: Customer (XUDCB+XUDCS) not found in SSCUSTP
          COUNT(CASE WHEN NVL(t."XUMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."XUDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."XUDCB")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."XUDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."XUDCS")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."XUDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."XUDCS")) END) &lt;&gt; 0) THEN 1 END) AS t18,
          COUNT(CASE WHEN NVL(t."XUMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."XUDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."XUDCB")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."XUDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."XUDCS")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."XUDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."XUDCS")) END) &lt;&gt; 0) AND (j5.dcb IS NULL) THEN 1 END) AS f18,
          -- SSNICIP-F01: Mobile number with invalid format (XUMPNO...XUM15P)
          COUNT(CASE WHEN NVL(t."XUMDFL",' ') &lt;&gt; 'S' AND ((TRIM(t."XUMPNO") IS NOT NULL OR TRIM(t."XUM02P") IS NOT NULL OR TRIM(t."XUM03P") IS NOT NULL OR TRIM(t."XUM04P") IS NOT NULL OR TRIM(t."XUM05P") IS NOT NULL OR TRIM(t."XUM06P") IS NOT NULL OR TRIM(t."XUM07P") IS NOT NULL OR TRIM(t."XUM08P") IS NOT NULL OR TRIM(t."XUM09P") IS NOT NULL OR TRIM(t."XUM10P") IS NOT NULL OR TRIM(t."XUM11P") IS NOT NULL OR TRIM(t."XUM12P") IS NOT NULL OR TRIM(t."XUM13P") IS NOT NULL OR TRIM(t."XUM14P") IS NOT NULL OR TRIM(t."XUM15P") IS NOT NULL)) THEN 1 END) AS t19,
          COUNT(CASE WHEN NVL(t."XUMDFL",' ') &lt;&gt; 'S' AND ((TRIM(t."XUMPNO") IS NOT NULL OR TRIM(t."XUM02P") IS NOT NULL OR TRIM(t."XUM03P") IS NOT NULL OR TRIM(t."XUM04P") IS NOT NULL OR TRIM(t."XUM05P") IS NOT NULL OR TRIM(t."XUM06P") IS NOT NULL OR TRIM(t."XUM07P") IS NOT NULL OR TRIM(t."XUM08P") IS NOT NULL OR TRIM(t."XUM09P") IS NOT NULL OR TRIM(t."XUM10P") IS NOT NULL OR TRIM(t."XUM11P") IS NOT NULL OR TRIM(t."XUM12P") IS NOT NULL OR TRIM(t."XUM13P") IS NOT NULL OR TRIM(t."XUM14P") IS NOT NULL OR TRIM(t."XUM15P") IS NOT NULL)) AND ((TRIM(t."XUMPNO") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(t."XUMPNO"), '^\+?[0-9][0-9 ()/-]{5,}$')) OR (TRIM(t."XUM02P") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(t."XUM02P"), '^\+?[0-9][0-9 ()/-]{5,}$')) OR (TRIM(t."XUM03P") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(t."XUM03P"), '^\+?[0-9][0-9 ()/-]{5,}$')) OR (TRIM(t."XUM04P") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(t."XUM04P"), '^\+?[0-9][0-9 ()/-]{5,}$')) OR (TRIM(t."XUM05P") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(t."XUM05P"), '^\+?[0-9][0-9 ()/-]{5,}$')) OR (TRIM(t."XUM06P") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(t."XUM06P"), '^\+?[0-9][0-9 ()/-]{5,}$')) OR (TRIM(t."XUM07P") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(t."XUM07P"), '^\+?[0-9][0-9 ()/-]{5,}$')) OR (TRIM(t."XUM08P") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(t."XUM08P"), '^\+?[0-9][0-9 ()/-]{5,}$')) OR (TRIM(t."XUM09P") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(t."XUM09P"), '^\+?[0-9][0-9 ()/-]{5,}$')) OR (TRIM(t."XUM10P") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(t."XUM10P"), '^\+?[0-9][0-9 ()/-]{5,}$')) OR (TRIM(t."XUM11P") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(t."XUM11P"), '^\+?[0-9][0-9 ()/-]{5,}$')) OR (TRIM(t."XUM12P") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(t."XUM12P"), '^\+?[0-9][0-9 ()/-]{5,}$')) OR (TRIM(t."XUM13P") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(t."XUM13P"), '^\+?[0-9][0-9 ()/-]{5,}$')) OR (TRIM(t."XUM14P") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(t."XUM14P"), '^\+?[0-9][0-9 ()/-]{5,}$')) OR (TRIM(t."XUM15P") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(t."XUM15P"), '^\+?[0-9][0-9 ()/-]{5,}$'))) THEN 1 END) AS f19,
          -- SSNICIP-F02: Telephone number with invalid format (XUTENO...XUW15P)
          COUNT(CASE WHEN NVL(t."XUMDFL",' ') &lt;&gt; 'S' AND ((TRIM(t."XUTENO") IS NOT NULL OR TRIM(t."XUW02P") IS NOT NULL OR TRIM(t."XUW03P") IS NOT NULL OR TRIM(t."XUW04P") IS NOT NULL OR TRIM(t."XUW05P") IS NOT NULL OR TRIM(t."XUW06P") IS NOT NULL OR TRIM(t."XUW07P") IS NOT NULL OR TRIM(t."XUW08P") IS NOT NULL OR TRIM(t."XUW09P") IS NOT NULL OR TRIM(t."XUW10P") IS NOT NULL OR TRIM(t."XUW11P") IS NOT NULL OR TRIM(t."XUW12P") IS NOT NULL OR TRIM(t."XUW13P") IS NOT NULL OR TRIM(t."XUW14P") IS NOT NULL OR TRIM(t."XUW15P") IS NOT NULL)) THEN 1 END) AS t20,
          COUNT(CASE WHEN NVL(t."XUMDFL",' ') &lt;&gt; 'S' AND ((TRIM(t."XUTENO") IS NOT NULL OR TRIM(t."XUW02P") IS NOT NULL OR TRIM(t."XUW03P") IS NOT NULL OR TRIM(t."XUW04P") IS NOT NULL OR TRIM(t."XUW05P") IS NOT NULL OR TRIM(t."XUW06P") IS NOT NULL OR TRIM(t."XUW07P") IS NOT NULL OR TRIM(t."XUW08P") IS NOT NULL OR TRIM(t."XUW09P") IS NOT NULL OR TRIM(t."XUW10P") IS NOT NULL OR TRIM(t."XUW11P") IS NOT NULL OR TRIM(t."XUW12P") IS NOT NULL OR TRIM(t."XUW13P") IS NOT NULL OR TRIM(t."XUW14P") IS NOT NULL OR TRIM(t."XUW15P") IS NOT NULL)) AND ((TRIM(t."XUTENO") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(t."XUTENO"), '^\+?[0-9][0-9 ()/-]{5,}$')) OR (TRIM(t."XUW02P") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(t."XUW02P"), '^\+?[0-9][0-9 ()/-]{5,}$')) OR (TRIM(t."XUW03P") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(t."XUW03P"), '^\+?[0-9][0-9 ()/-]{5,}$')) OR (TRIM(t."XUW04P") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(t."XUW04P"), '^\+?[0-9][0-9 ()/-]{5,}$')) OR (TRIM(t."XUW05P") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(t."XUW05P"), '^\+?[0-9][0-9 ()/-]{5,}$')) OR (TRIM(t."XUW06P") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(t."XUW06P"), '^\+?[0-9][0-9 ()/-]{5,}$')) OR (TRIM(t."XUW07P") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(t."XUW07P"), '^\+?[0-9][0-9 ()/-]{5,}$')) OR (TRIM(t."XUW08P") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(t."XUW08P"), '^\+?[0-9][0-9 ()/-]{5,}$')) OR (TRIM(t."XUW09P") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(t."XUW09P"), '^\+?[0-9][0-9 ()/-]{5,}$')) OR (TRIM(t."XUW10P") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(t."XUW10P"), '^\+?[0-9][0-9 ()/-]{5,}$')) OR (TRIM(t."XUW11P") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(t."XUW11P"), '^\+?[0-9][0-9 ()/-]{5,}$')) OR (TRIM(t."XUW12P") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(t."XUW12P"), '^\+?[0-9][0-9 ()/-]{5,}$')) OR (TRIM(t."XUW13P") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(t."XUW13P"), '^\+?[0-9][0-9 ()/-]{5,}$')) OR (TRIM(t."XUW14P") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(t."XUW14P"), '^\+?[0-9][0-9 ()/-]{5,}$')) OR (TRIM(t."XUW15P") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(t."XUW15P"), '^\+?[0-9][0-9 ()/-]{5,}$'))) THEN 1 END) AS f20,
          -- SSNICIP-F03: E-mail address with invalid format (XUEMAD...XUE15A)
          COUNT(CASE WHEN NVL(t."XUMDFL",' ') &lt;&gt; 'S' AND ((TRIM(t."XUEMAD") IS NOT NULL OR TRIM(t."XUE02A") IS NOT NULL OR TRIM(t."XUE03A") IS NOT NULL OR TRIM(t."XUE04A") IS NOT NULL OR TRIM(t."XUE05A") IS NOT NULL OR TRIM(t."XUE06A") IS NOT NULL OR TRIM(t."XUE07A") IS NOT NULL OR TRIM(t."XUE08A") IS NOT NULL OR TRIM(t."XUE09A") IS NOT NULL OR TRIM(t."XUE10A") IS NOT NULL OR TRIM(t."XUE11A") IS NOT NULL OR TRIM(t."XUE12A") IS NOT NULL OR TRIM(t."XUE13A") IS NOT NULL OR TRIM(t."XUE14A") IS NOT NULL OR TRIM(t."XUE15A") IS NOT NULL)) THEN 1 END) AS t21,
          COUNT(CASE WHEN NVL(t."XUMDFL",' ') &lt;&gt; 'S' AND ((TRIM(t."XUEMAD") IS NOT NULL OR TRIM(t."XUE02A") IS NOT NULL OR TRIM(t."XUE03A") IS NOT NULL OR TRIM(t."XUE04A") IS NOT NULL OR TRIM(t."XUE05A") IS NOT NULL OR TRIM(t."XUE06A") IS NOT NULL OR TRIM(t."XUE07A") IS NOT NULL OR TRIM(t."XUE08A") IS NOT NULL OR TRIM(t."XUE09A") IS NOT NULL OR TRIM(t."XUE10A") IS NOT NULL OR TRIM(t."XUE11A") IS NOT NULL OR TRIM(t."XUE12A") IS NOT NULL OR TRIM(t."XUE13A") IS NOT NULL OR TRIM(t."XUE14A") IS NOT NULL OR TRIM(t."XUE15A") IS NOT NULL)) AND ((TRIM(t."XUEMAD") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(t."XUEMAD"), '^[A-Za-z0-9._%+''-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}$')) OR (TRIM(t."XUE02A") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(t."XUE02A"), '^[A-Za-z0-9._%+''-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}$')) OR (TRIM(t."XUE03A") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(t."XUE03A"), '^[A-Za-z0-9._%+''-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}$')) OR (TRIM(t."XUE04A") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(t."XUE04A"), '^[A-Za-z0-9._%+''-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}$')) OR (TRIM(t."XUE05A") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(t."XUE05A"), '^[A-Za-z0-9._%+''-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}$')) OR (TRIM(t."XUE06A") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(t."XUE06A"), '^[A-Za-z0-9._%+''-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}$')) OR (TRIM(t."XUE07A") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(t."XUE07A"), '^[A-Za-z0-9._%+''-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}$')) OR (TRIM(t."XUE08A") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(t."XUE08A"), '^[A-Za-z0-9._%+''-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}$')) OR (TRIM(t."XUE09A") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(t."XUE09A"), '^[A-Za-z0-9._%+''-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}$')) OR (TRIM(t."XUE10A") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(t."XUE10A"), '^[A-Za-z0-9._%+''-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}$')) OR (TRIM(t."XUE11A") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(t."XUE11A"), '^[A-Za-z0-9._%+''-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}$')) OR (TRIM(t."XUE12A") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(t."XUE12A"), '^[A-Za-z0-9._%+''-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}$')) OR (TRIM(t."XUE13A") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(t."XUE13A"), '^[A-Za-z0-9._%+''-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}$')) OR (TRIM(t."XUE14A") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(t."XUE14A"), '^[A-Za-z0-9._%+''-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}$')) OR (TRIM(t."XUE15A") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(t."XUE15A"), '^[A-Za-z0-9._%+''-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}$'))) THEN 1 END) AS f21
        FROM (SELECT x.*,
                     COUNT(CASE WHEN NVL("XUMDFL",' ') &lt;&gt; 'S' THEN 1 END) OVER (PARTITION BY "XUDCB", "XUDCS") AS dq_dup17
                FROM DATACUT5."HUB_MT_SSNICIP" x) t
        CROSS JOIN params p
        LEFT JOIN ref_ct j1 ON j1.code = TRIM(t."XUCTHQ")
        LEFT JOIN ref_ct j2 ON j2.code = TRIM(t."XUC1TR")
        LEFT JOIN ref_ct j3 ON j3.code = TRIM(t."XUC2TR")
        LEFT JOIN ref_ct j4 ON j4.code = TRIM(t."XUC3TR")
        LEFT JOIN k_cus j5 ON j5.dcb = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."XUDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."XUDCB")) END) AND j5.dcs = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."XUDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."XUDCS")) END)
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'SSNICIP-001|Missing Data|Missing incorporation number (XUINCN)',
        (t2, f2) AS 'SSNICIP-002|Missing Data|Missing date of incorporation (XUDTIC)',
        (t3, f3) AS 'SSNICIP-003|Missing Data|Missing customer key (XUDCB/XUDCS)',
        (t4, f4) AS 'SSNICIP-004|Invalid Values|Counntry of HeadQuarters (XUCTHQ) not a valid country code (SSSTDPP CT)',
        (t5, f5) AS 'SSNICIP-005|Invalid Values|Invalid Ranking in the Industry-1 (XURNK1), allowed 1/2/3/4',
        (t6, f6) AS 'SSNICIP-006|Invalid Values|Invalid Ranking in the Industry-1 (XURNK2), allowed 1/2/3/4',
        (t7, f7) AS 'SSNICIP-007|Invalid Values|Invalid Ranking in the Industry-1 (XURNK3), allowed 1/2/3/4',
        (t8, f8) AS 'SSNICIP-008|Invalid Values|Invalid Management Style Code (XUMGMT), allowed 1/2/3/4/5',
        (t9, f9) AS 'SSNICIP-009|Invalid Values|Invalid Importance to Bank/Group (XUIMPT), allowed 1/2/3/4',
        (t10, f10) AS 'SSNICIP-010|Invalid Values|Invalid Tiering (XUTIER), allowed 2/3',
        (t11, f11) AS 'SSNICIP-011|Invalid Values|Invalid HIE IND (XUHIEI), allowed B/E/I/N',
        (t12, f12) AS 'SSNICIP-012|Invalid Values|Country of Tax Residency 1 (XUC1TR) not a valid country code (SSSTDPP CT)',
        (t13, f13) AS 'SSNICIP-013|Invalid Values|Country of Tax Residency 2 (XUC2TR) not a valid country code (SSSTDPP CT)',
        (t14, f14) AS 'SSNICIP-014|Invalid Values|Country of Tax Residency 3 (XUC3TR) not a valid country code (SSSTDPP CT)',
        (t15, f15) AS 'SSNICIP-015|Invalid Dates|Invalid date: Date of Incorporation (XUDTIC)',
        (t16, f16) AS 'SSNICIP-016|Invalid Dates|Invalid date: Business Start Date (XUDTBS)',
        (t17, f17) AS 'SSNICIP-017|Duplicates|Duplicate company record per customer (XUDCB+XUDCS)',
        (t18, f18) AS 'SSNICIP-018|Missing Links|Customer (XUDCB+XUDCS) not found in SSCUSTP',
        (t19, f19) AS 'SSNICIP-F01|Format|Mobile number with invalid format (XUMPNO...XUM15P)',
        (t20, f20) AS 'SSNICIP-F02|Format|Telephone number with invalid format (XUTENO...XUW15P)',
        (t21, f21) AS 'SSNICIP-F03|Format|E-mail address with invalid format (XUEMAD...XUE15A)'
      ))
    UNION ALL
/* =============================================================================
   SSPRJIP - Personal Joint account Information File
   Πίνακας: DATACUT5."HUB_MT_SSPRJIP"   Shadow: X0MDFL = 'S' (εξαιρούνται)   Έλεγχοι: 2
   ============================================================================= */
    SELECT 'SSPRJIP - Personal Joint account Information File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- SSPRJIP-001: Missing customer key (X0DCB/X0DCS)
          COUNT(CASE WHEN NVL(t."X0MDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t1,
          COUNT(CASE WHEN NVL(t."X0MDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."X0DCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."X0DCB")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."X0DCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."X0DCS")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."X0DCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."X0DCS")) END) = 0) THEN 1 END) AS f1,
          -- SSPRJIP-002: Customer (X0DCB+X0DCS) not found in SSCUSTP
          COUNT(CASE WHEN NVL(t."X0MDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."X0DCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."X0DCB")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."X0DCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."X0DCS")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."X0DCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."X0DCS")) END) &lt;&gt; 0) THEN 1 END) AS t2,
          COUNT(CASE WHEN NVL(t."X0MDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."X0DCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."X0DCB")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."X0DCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."X0DCS")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."X0DCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."X0DCS")) END) &lt;&gt; 0) AND (j1.dcb IS NULL) THEN 1 END) AS f2
        FROM DATACUT5."HUB_MT_SSPRJIP" t
        CROSS JOIN params p
        LEFT JOIN k_cus j1 ON j1.dcb = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."X0DCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."X0DCB")) END) AND j1.dcs = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."X0DCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."X0DCS")) END)
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'SSPRJIP-001|Missing Data|Missing customer key (X0DCB/X0DCS)',
        (t2, f2) AS 'SSPRJIP-002|Missing Links|Customer (X0DCB+X0DCS) not found in SSCUSTP'
      ))
    UNION ALL
/* =============================================================================
   SSSCCIP - Customer Special Category Code Information File
   Πίνακας: DATACUT5."HUB_MT_SSSCCIP"   Shadow: SCMDFL = 'S' (εξαιρούνται)   Έλεγχοι: 4
   ============================================================================= */
    SELECT 'SSSCCIP - Customer Special Category Code Information File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- SSSCCIP-001: Missing customer key (SCDCB/SCDCS)
          COUNT(CASE WHEN NVL(t."SCMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t1,
          COUNT(CASE WHEN NVL(t."SCMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."SCDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."SCDCB")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."SCDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."SCDCS")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."SCDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."SCDCS")) END) = 0) THEN 1 END) AS f1,
          -- SSSCCIP-002: Invalid date: Capture Date (SCCPDT)
          COUNT(CASE WHEN NVL(t."SCMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t2,
          COUNT(CASE WHEN NVL(t."SCMDFL",' ') &lt;&gt; 'S' AND ((NOT (TRIM(t."SCCPDT") IS NULL OR REGEXP_LIKE(TRIM(t."SCCPDT"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."SCCPDT"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."SCCPDT") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."SCCPDT")) END), 0) &lt; 19000101)) THEN 1 END) AS f2,
          -- SSSCCIP-003: Invalid date: Date Last Updated (SCDLUP)
          COUNT(CASE WHEN NVL(t."SCMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t3,
          COUNT(CASE WHEN NVL(t."SCMDFL",' ') &lt;&gt; 'S' AND ((NOT (TRIM(t."SCDLUP") IS NULL OR REGEXP_LIKE(TRIM(t."SCDLUP"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."SCDLUP"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."SCDLUP") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."SCDLUP")) END), 0) &lt; 19000101)) THEN 1 END) AS f3,
          -- SSSCCIP-004: Customer (SCDCB+SCDCS) not found in SSCUSTP
          COUNT(CASE WHEN NVL(t."SCMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."SCDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."SCDCB")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."SCDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."SCDCS")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."SCDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."SCDCS")) END) &lt;&gt; 0) THEN 1 END) AS t4,
          COUNT(CASE WHEN NVL(t."SCMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."SCDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."SCDCB")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."SCDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."SCDCS")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."SCDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."SCDCS")) END) &lt;&gt; 0) AND (j1.dcb IS NULL) THEN 1 END) AS f4
        FROM DATACUT5."HUB_MT_SSSCCIP" t
        CROSS JOIN params p
        LEFT JOIN k_cus j1 ON j1.dcb = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."SCDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."SCDCB")) END) AND j1.dcs = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."SCDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."SCDCS")) END)
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'SSSCCIP-001|Missing Data|Missing customer key (SCDCB/SCDCS)',
        (t2, f2) AS 'SSSCCIP-002|Invalid Dates|Invalid date: Capture Date (SCCPDT)',
        (t3, f3) AS 'SSSCCIP-003|Invalid Dates|Invalid date: Date Last Updated (SCDLUP)',
        (t4, f4) AS 'SSSCCIP-004|Missing Links|Customer (SCDCB+SCDCS) not found in SSCUSTP'
      ))
    UNION ALL
/* =============================================================================
   SSSCRLP - Security Relationship File
   Πίνακας: DATACUT5."HUB_MT_SSSCRLP"   Shadow: VYMDFL = 'S' (εξαιρούνται)   Έλεγχοι: 3
   ============================================================================= */
    SELECT 'SSSCRLP - Security Relationship File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- SSSCRLP-001: Missing customer key (VYDCB/VYDCS)
          COUNT(CASE WHEN NVL(t."VYMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t1,
          COUNT(CASE WHEN NVL(t."VYMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."VYDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."VYDCB")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."VYDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."VYDCS")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."VYDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."VYDCS")) END) = 0) THEN 1 END) AS f1,
          -- SSSCRLP-002: Invalid date: Last Update Date (VYDLUP)
          COUNT(CASE WHEN NVL(t."VYMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t2,
          COUNT(CASE WHEN NVL(t."VYMDFL",' ') &lt;&gt; 'S' AND ((NOT (TRIM(t."VYDLUP") IS NULL OR REGEXP_LIKE(TRIM(t."VYDLUP"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."VYDLUP"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."VYDLUP") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."VYDLUP")) END), 0) &lt; 19000101)) THEN 1 END) AS f2,
          -- SSSCRLP-003: Customer (VYDCB+VYDCS) not found in SSCUSTP
          COUNT(CASE WHEN NVL(t."VYMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."VYDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."VYDCB")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."VYDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."VYDCS")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."VYDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."VYDCS")) END) &lt;&gt; 0) THEN 1 END) AS t3,
          COUNT(CASE WHEN NVL(t."VYMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."VYDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."VYDCB")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."VYDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."VYDCS")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."VYDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."VYDCS")) END) &lt;&gt; 0) AND (j1.dcb IS NULL) THEN 1 END) AS f3
        FROM DATACUT5."HUB_MT_SSSCRLP" t
        CROSS JOIN params p
        LEFT JOIN k_cus j1 ON j1.dcb = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."VYDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."VYDCB")) END) AND j1.dcs = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."VYDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."VYDCS")) END)
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'SSSCRLP-001|Missing Data|Missing customer key (VYDCB/VYDCS)',
        (t2, f2) AS 'SSSCRLP-002|Invalid Dates|Invalid date: Last Update Date (VYDLUP)',
        (t3, f3) AS 'SSSCRLP-003|Missing Links|Customer (VYDCB+VYDCS) not found in SSCUSTP'
      ))
    UNION ALL
/* =============================================================================
   SSSECHP - Security Held File
   Πίνακας: DATACUT5."HUB_MT_SSSECHP"   Shadow: Y2MDFL = 'S' (εξαιρούνται)   Έλεγχοι: 6
   ============================================================================= */
    SELECT 'SSSECHP - Security Held File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- SSSECHP-001: Missing customer key (Y2DCB/Y2DCS)
          COUNT(CASE WHEN NVL(t."Y2MDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t1,
          COUNT(CASE WHEN NVL(t."Y2MDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."Y2DCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."Y2DCB")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."Y2DCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."Y2DCS")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."Y2DCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."Y2DCS")) END) = 0) THEN 1 END) AS f1,
          -- SSSECHP-002: Invalid date: Security Expiry Date (Y2SCEX)
          COUNT(CASE WHEN NVL(t."Y2MDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t2,
          COUNT(CASE WHEN NVL(t."Y2MDFL",' ') &lt;&gt; 'S' AND ((NOT (TRIM(t."Y2SCEX") IS NULL OR REGEXP_LIKE(TRIM(t."Y2SCEX"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."Y2SCEX"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."Y2SCEX") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."Y2SCEX")) END), 0) &lt; 19000101)) THEN 1 END) AS f2,
          -- SSSECHP-003: Invalid date: Insurance Expiry Date (Y2ISEX)
          COUNT(CASE WHEN NVL(t."Y2MDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t3,
          COUNT(CASE WHEN NVL(t."Y2MDFL",' ') &lt;&gt; 'S' AND ((NOT (TRIM(t."Y2ISEX") IS NULL OR REGEXP_LIKE(TRIM(t."Y2ISEX"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."Y2ISEX"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."Y2ISEX") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."Y2ISEX")) END), 0) &lt; 19000101)) THEN 1 END) AS f3,
          -- SSSECHP-004: Invalid date: Last Update Date (Y2DLUP)
          COUNT(CASE WHEN NVL(t."Y2MDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t4,
          COUNT(CASE WHEN NVL(t."Y2MDFL",' ') &lt;&gt; 'S' AND ((NOT (TRIM(t."Y2DLUP") IS NULL OR REGEXP_LIKE(TRIM(t."Y2DLUP"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."Y2DLUP"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."Y2DLUP") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."Y2DLUP")) END), 0) &lt; 19000101)) THEN 1 END) AS f4,
          -- SSSECHP-005: Invalid date: Date Request added (Y2DTAD)
          COUNT(CASE WHEN NVL(t."Y2MDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t5,
          COUNT(CASE WHEN NVL(t."Y2MDFL",' ') &lt;&gt; 'S' AND ((NOT (TRIM(t."Y2DTAD") IS NULL OR REGEXP_LIKE(TRIM(t."Y2DTAD"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."Y2DTAD"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."Y2DTAD") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."Y2DTAD")) END), 0) &lt; 19000101)) THEN 1 END) AS f5,
          -- SSSECHP-006: Customer (Y2DCB+Y2DCS) not found in SSCUSTP
          COUNT(CASE WHEN NVL(t."Y2MDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."Y2DCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."Y2DCB")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."Y2DCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."Y2DCS")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."Y2DCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."Y2DCS")) END) &lt;&gt; 0) THEN 1 END) AS t6,
          COUNT(CASE WHEN NVL(t."Y2MDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."Y2DCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."Y2DCB")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."Y2DCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."Y2DCS")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."Y2DCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."Y2DCS")) END) &lt;&gt; 0) AND (j1.dcb IS NULL) THEN 1 END) AS f6
        FROM DATACUT5."HUB_MT_SSSECHP" t
        CROSS JOIN params p
        LEFT JOIN k_cus j1 ON j1.dcb = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."Y2DCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."Y2DCB")) END) AND j1.dcs = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."Y2DCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."Y2DCS")) END)
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'SSSECHP-001|Missing Data|Missing customer key (Y2DCB/Y2DCS)',
        (t2, f2) AS 'SSSECHP-002|Invalid Dates|Invalid date: Security Expiry Date (Y2SCEX)',
        (t3, f3) AS 'SSSECHP-003|Invalid Dates|Invalid date: Insurance Expiry Date (Y2ISEX)',
        (t4, f4) AS 'SSSECHP-004|Invalid Dates|Invalid date: Last Update Date (Y2DLUP)',
        (t5, f5) AS 'SSSECHP-005|Invalid Dates|Invalid date: Date Request added (Y2DTAD)',
        (t6, f6) AS 'SSSECHP-006|Missing Links|Customer (Y2DCB+Y2DCS) not found in SSCUSTP'
      ))
    UNION ALL
/* =============================================================================
   SSSPINP - Special Instructions File
   Πίνακας: DATACUT5."HUB_MT_SSSPINP"   Shadow: YGMDFL = 'S' (εξαιρούνται)   Έλεγχοι: 3
   ============================================================================= */
    SELECT 'SSSPINP - Special Instructions File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- SSSPINP-001: Missing account key (YGACB/YGACS/YGACX)
          COUNT(CASE WHEN NVL(t."YGMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t1,
          COUNT(CASE WHEN NVL(t."YGMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."YGACB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."YGACB")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."YGACB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."YGACB")) END) = 0 OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."YGACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."YGACS")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."YGACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."YGACS")) END) = 0 OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."YGACX") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."YGACX")) END) IS NULL) THEN 1 END) AS f1,
          -- SSSPINP-002: Invalid date: Date Request added (YGDTAD)
          COUNT(CASE WHEN NVL(t."YGMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t2,
          COUNT(CASE WHEN NVL(t."YGMDFL",' ') &lt;&gt; 'S' AND ((NOT (TRIM(t."YGDTAD") IS NULL OR REGEXP_LIKE(TRIM(t."YGDTAD"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."YGDTAD"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."YGDTAD") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."YGDTAD")) END), 0) &lt; 19000101)) THEN 1 END) AS f2,
          -- SSSPINP-003: Invalid date: Last Update Date (YGDLUP)
          COUNT(CASE WHEN NVL(t."YGMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t3,
          COUNT(CASE WHEN NVL(t."YGMDFL",' ') &lt;&gt; 'S' AND ((NOT (TRIM(t."YGDLUP") IS NULL OR REGEXP_LIKE(TRIM(t."YGDLUP"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."YGDLUP"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."YGDLUP") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."YGDLUP")) END), 0) &lt; 19000101)) THEN 1 END) AS f3
        FROM DATACUT5."HUB_MT_SSSPINP" t
        CROSS JOIN params p
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'SSSPINP-001|Missing Data|Missing account key (YGACB/YGACS/YGACX)',
        (t2, f2) AS 'SSSPINP-002|Invalid Dates|Invalid date: Date Request added (YGDTAD)',
        (t3, f3) AS 'SSSPINP-003|Invalid Dates|Invalid date: Last Update Date (YGDLUP)'
      ))
    UNION ALL
/* =============================================================================
   SSTXDPP - Customer Tax Document file
   Πίνακας: DATACUT5."HUB_MT_SSTXDPP"   Shadow: δεν υπάρχει mode flag   Έλεγχοι: 10
   ============================================================================= */
    SELECT 'SSTXDPP - Customer Tax Document file' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- SSTXDPP-001: Missing customer key (TDDCB/TDDCS)
          COUNT(CASE WHEN 1=1 THEN 1 END) AS t1,
          COUNT(CASE WHEN 1=1 AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."TDDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."TDDCB")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."TDDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."TDDCS")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."TDDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."TDDCS")) END) = 0) THEN 1 END) AS f1,
          -- SSTXDPP-002: CUSTOMER TAX CLASSIFICATION COUNTRY (TDTCCO) not a valid country code (SSSTDPP CT)
          COUNT(CASE WHEN (TRIM(t."TDTCCO") IS NOT NULL) THEN 1 END) AS t2,
          COUNT(CASE WHEN (TRIM(t."TDTCCO") IS NOT NULL) AND (j1.code IS NULL) THEN 1 END) AS f2,
          -- SSTXDPP-003: Tax Documentation Country of Issue (TDTXDC) not a valid country code (SSSTDPP CT)
          COUNT(CASE WHEN (TRIM(t."TDTXDC") IS NOT NULL) THEN 1 END) AS t3,
          COUNT(CASE WHEN (TRIM(t."TDTXDC") IS NOT NULL) AND (j2.code IS NULL) THEN 1 END) AS f3,
          -- SSTXDPP-004: Address Country Code (TDADCE) not a valid country code (SSSTDPP CT)
          COUNT(CASE WHEN (TRIM(t."TDADCE") IS NOT NULL) THEN 1 END) AS t4,
          COUNT(CASE WHEN (TRIM(t."TDADCE") IS NOT NULL) AND (j3.code IS NULL) THEN 1 END) AS f4,
          -- SSTXDPP-005: Invalid date: Tax documentation Date of Issue (TDTDTI)
          COUNT(CASE WHEN 1=1 THEN 1 END) AS t5,
          COUNT(CASE WHEN 1=1 AND ((NOT (TRIM(t."TDTDTI") IS NULL OR REGEXP_LIKE(TRIM(t."TDTDTI"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."TDTDTI"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."TDTDTI") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."TDTDTI")) END), 0) &lt; 19000101)) THEN 1 END) AS f5,
          -- SSTXDPP-006: Invalid date: Tax documentation Date Received (TDTDRD)
          COUNT(CASE WHEN 1=1 THEN 1 END) AS t6,
          COUNT(CASE WHEN 1=1 AND ((NOT (TRIM(t."TDTDRD") IS NULL OR REGEXP_LIKE(TRIM(t."TDTDRD"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."TDTDRD"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."TDTDRD") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."TDTDRD")) END), 0) &lt; 19000101)) THEN 1 END) AS f6,
          -- SSTXDPP-007: Invalid date: Tax documentation Date of Expiry (TDTDDE)
          COUNT(CASE WHEN 1=1 THEN 1 END) AS t7,
          COUNT(CASE WHEN 1=1 AND ((NOT (TRIM(t."TDTDDE") IS NULL OR REGEXP_LIKE(TRIM(t."TDTDDE"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."TDTDDE"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."TDTDDE") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."TDTDDE")) END), 0) &lt; 19000101)) THEN 1 END) AS f7,
          -- SSTXDPP-008: Invalid date: Last Updated Date (TDDLUP)
          COUNT(CASE WHEN 1=1 THEN 1 END) AS t8,
          COUNT(CASE WHEN 1=1 AND ((NOT (TRIM(t."TDDLUP") IS NULL OR REGEXP_LIKE(TRIM(t."TDDLUP"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."TDDLUP"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."TDDLUP") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."TDDLUP")) END), 0) &lt; 19000101)) THEN 1 END) AS f8,
          -- SSTXDPP-009: Customer (TDDCB+TDDCS) not found in SSCUSTP
          COUNT(CASE WHEN ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."TDDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."TDDCB")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."TDDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."TDDCS")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."TDDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."TDDCS")) END) &lt;&gt; 0) THEN 1 END) AS t9,
          COUNT(CASE WHEN ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."TDDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."TDDCB")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."TDDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."TDDCS")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."TDDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."TDDCS")) END) &lt;&gt; 0) AND (j4.dcb IS NULL) THEN 1 END) AS f9,
          -- SSTXDPP-T01: Tax documentation expired (TDTDDE)
          COUNT(CASE WHEN 1=1 THEN 1 END) AS t10,
          COUNT(CASE WHEN 1=1 AND ((CASE WHEN REGEXP_LIKE(TRIM(t."TDTDDE"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."TDTDDE") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."TDTDDE")) END) &lt; p.ref_num) THEN 1 END) AS f10
        FROM DATACUT5."HUB_MT_SSTXDPP" t
        CROSS JOIN params p
        LEFT JOIN ref_ct j1 ON j1.code = TRIM(t."TDTCCO")
        LEFT JOIN ref_ct j2 ON j2.code = TRIM(t."TDTXDC")
        LEFT JOIN ref_ct j3 ON j3.code = TRIM(t."TDADCE")
        LEFT JOIN k_cus j4 ON j4.dcb = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."TDDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."TDDCB")) END) AND j4.dcs = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."TDDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."TDDCS")) END)
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'SSTXDPP-001|Missing Data|Missing customer key (TDDCB/TDDCS)',
        (t2, f2) AS 'SSTXDPP-002|Invalid Values|CUSTOMER TAX CLASSIFICATION COUNTRY (TDTCCO) not a valid country code (SSSTDPP CT)',
        (t3, f3) AS 'SSTXDPP-003|Invalid Values|Tax Documentation Country of Issue (TDTXDC) not a valid country code (SSSTDPP CT)',
        (t4, f4) AS 'SSTXDPP-004|Invalid Values|Address Country Code (TDADCE) not a valid country code (SSSTDPP CT)',
        (t5, f5) AS 'SSTXDPP-005|Invalid Dates|Invalid date: Tax documentation Date of Issue (TDTDTI)',
        (t6, f6) AS 'SSTXDPP-006|Invalid Dates|Invalid date: Tax documentation Date Received (TDTDRD)',
        (t7, f7) AS 'SSTXDPP-007|Invalid Dates|Invalid date: Tax documentation Date of Expiry (TDTDDE)',
        (t8, f8) AS 'SSTXDPP-008|Invalid Dates|Invalid date: Last Updated Date (TDDLUP)',
        (t9, f9) AS 'SSTXDPP-009|Missing Links|Customer (TDDCB+TDDCS) not found in SSCUSTP',
        (t10, f10) AS 'SSTXDPP-T01|Timeliness|Tax documentation expired (TDTDDE)'
      ))
    UNION ALL
/* =============================================================================
   SSWAINP - HUB Write-Off Account Information File
   Πίνακας: DATACUT5."HUB_MT_SSWAINP"   Shadow: VIMDFL = 'S' (εξαιρούνται)   Έλεγχοι: 6
   ============================================================================= */
    SELECT 'SSWAINP - HUB Write-Off Account Information File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- SSWAINP-001: Missing customer key (VIDCB/VIDCS)
          COUNT(CASE WHEN NVL(t."VIMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t1,
          COUNT(CASE WHEN NVL(t."VIMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."VIDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."VIDCB")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."VIDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."VIDCS")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."VIDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."VIDCS")) END) = 0) THEN 1 END) AS f1,
          -- SSWAINP-002: Missing account key (VIACB/VIACS/VIACX)
          COUNT(CASE WHEN NVL(t."VIMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t2,
          COUNT(CASE WHEN NVL(t."VIMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."VIACB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."VIACB")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."VIACB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."VIACB")) END) = 0 OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."VIACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."VIACS")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."VIACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."VIACS")) END) = 0 OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."VIACX") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."VIACX")) END) IS NULL) THEN 1 END) AS f2,
          -- SSWAINP-003: Invalid date: Write-off Date (VIWODT)
          COUNT(CASE WHEN NVL(t."VIMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t3,
          COUNT(CASE WHEN NVL(t."VIMDFL",' ') &lt;&gt; 'S' AND ((NOT (TRIM(t."VIWODT") IS NULL OR REGEXP_LIKE(TRIM(t."VIWODT"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."VIWODT"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."VIWODT") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."VIWODT")) END), 0) &lt; 19000101)) THEN 1 END) AS f3,
          -- SSWAINP-004: Invalid date: Last Update Date (VIDLUP)
          COUNT(CASE WHEN NVL(t."VIMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t4,
          COUNT(CASE WHEN NVL(t."VIMDFL",' ') &lt;&gt; 'S' AND ((NOT (TRIM(t."VIDLUP") IS NULL OR REGEXP_LIKE(TRIM(t."VIDLUP"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."VIDLUP"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."VIDLUP") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."VIDLUP")) END), 0) &lt; 19000101)) THEN 1 END) AS f4,
          -- SSWAINP-005: Customer (VIDCB+VIDCS) not found in SSCUSTP
          COUNT(CASE WHEN NVL(t."VIMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."VIDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."VIDCB")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."VIDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."VIDCS")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."VIDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."VIDCS")) END) &lt;&gt; 0) THEN 1 END) AS t5,
          COUNT(CASE WHEN NVL(t."VIMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."VIDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."VIDCB")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."VIDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."VIDCS")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."VIDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."VIDCS")) END) &lt;&gt; 0) AND (j1.dcb IS NULL) THEN 1 END) AS f5,
          -- SSWAINP-B01: Current write-off balance greater than original (VIWCLB &gt; VIWOLB)
          COUNT(CASE WHEN NVL(t."VIMDFL",' ') &lt;&gt; 'S' AND (NVL((CASE WHEN VALIDATE_CONVERSION(TRIM(t."VIWOLB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."VIWOLB")) END),0) &lt;&gt; 0 OR NVL((CASE WHEN VALIDATE_CONVERSION(TRIM(t."VIWCLB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."VIWCLB")) END),0) &lt;&gt; 0) THEN 1 END) AS t6,
          COUNT(CASE WHEN NVL(t."VIMDFL",' ') &lt;&gt; 'S' AND (NVL((CASE WHEN VALIDATE_CONVERSION(TRIM(t."VIWOLB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."VIWOLB")) END),0) &lt;&gt; 0 OR NVL((CASE WHEN VALIDATE_CONVERSION(TRIM(t."VIWCLB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."VIWCLB")) END),0) &lt;&gt; 0) AND (ABS(NVL((CASE WHEN VALIDATE_CONVERSION(TRIM(t."VIWCLB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."VIWCLB")) END),0)) &gt; ABS(NVL((CASE WHEN VALIDATE_CONVERSION(TRIM(t."VIWOLB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."VIWOLB")) END),0)) OR ABS(NVL((CASE WHEN VALIDATE_CONVERSION(TRIM(t."VIWCLL") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."VIWCLL")) END),0)) &gt; ABS(NVL((CASE WHEN VALIDATE_CONVERSION(TRIM(t."VIWOLL") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."VIWOLL")) END),0))) THEN 1 END) AS f6
        FROM DATACUT5."HUB_MT_SSWAINP" t
        CROSS JOIN params p
        LEFT JOIN k_cus j1 ON j1.dcb = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."VIDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."VIDCB")) END) AND j1.dcs = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."VIDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."VIDCS")) END)
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'SSWAINP-001|Missing Data|Missing customer key (VIDCB/VIDCS)',
        (t2, f2) AS 'SSWAINP-002|Missing Data|Missing account key (VIACB/VIACS/VIACX)',
        (t3, f3) AS 'SSWAINP-003|Invalid Dates|Invalid date: Write-off Date (VIWODT)',
        (t4, f4) AS 'SSWAINP-004|Invalid Dates|Invalid date: Last Update Date (VIDLUP)',
        (t5, f5) AS 'SSWAINP-005|Missing Links|Customer (VIDCB+VIDCS) not found in SSCUSTP',
        (t6, f6) AS 'SSWAINP-B01|Balances|Current write-off balance greater than original (VIWCLB &gt; VIWOLB)'
      ))
    UNION ALL
/* =============================================================================
   SX@OWNSP - Safe Deposit Box Ownership File
   Πίνακας: DATACUT5."HUB_MT_SX@OWNSP"   Shadow: SBMDFL = 'S' (εξαιρούνται)   Έλεγχοι: 1
   ============================================================================= */
    SELECT 'SX@OWNSP - Safe Deposit Box Ownership File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- SX_OWNSP-001: Invalid date: Last Update Date (SBDLUP)
          COUNT(CASE WHEN NVL(t."SBMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t1,
          COUNT(CASE WHEN NVL(t."SBMDFL",' ') &lt;&gt; 'S' AND ((NOT (TRIM(t."SBDLUP") IS NULL OR REGEXP_LIKE(TRIM(t."SBDLUP"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."SBDLUP"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."SBDLUP") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."SBDLUP")) END), 0) &lt; 19000101)) THEN 1 END) AS f1
        FROM DATACUT5."HUB_MT_SX@OWNSP" t
        CROSS JOIN params p
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'SX_OWNSP-001|Invalid Dates|Invalid date: Last Update Date (SBDLUP)'
      ))
    UNION ALL
/* =============================================================================
   SXOWNSP - Safe Deposit Box Ownership File
   Πίνακας: DATACUT5."HUB_MT_SXOWNSP"   Shadow: SBMDFL = 'S' (εξαιρούνται)   Έλεγχοι: 1
   ============================================================================= */
    SELECT 'SXOWNSP - Safe Deposit Box Ownership File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- SXOWNSP-001: Invalid date: Last Update Date (SBDLUP)
          COUNT(CASE WHEN NVL(t."SBMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t1,
          COUNT(CASE WHEN NVL(t."SBMDFL",' ') &lt;&gt; 'S' AND ((NOT (TRIM(t."SBDLUP") IS NULL OR REGEXP_LIKE(TRIM(t."SBDLUP"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."SBDLUP"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."SBDLUP") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."SBDLUP")) END), 0) &lt; 19000101)) THEN 1 END) AS f1
        FROM DATACUT5."HUB_MT_SXOWNSP" t
        CROSS JOIN params p
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'SXOWNSP-001|Invalid Dates|Invalid date: Last Update Date (SBDLUP)'
      ))
    UNION ALL
/* =============================================================================
   TDACADP - TD Account Additional Information File
   Πίνακας: DATACUT5."HUB_MT_TDACADP"   Shadow: TAMDFL = 'S' (εξαιρούνται)   Έλεγχοι: 1
   ============================================================================= */
    SELECT 'TDACADP - TD Account Additional Information File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- TDACADP-001: Invalid date: DATE LAST UPDATE (TADLUP)
          COUNT(CASE WHEN NVL(t."TAMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t1,
          COUNT(CASE WHEN NVL(t."TAMDFL",' ') &lt;&gt; 'S' AND ((NOT (TRIM(t."TADLUP") IS NULL OR REGEXP_LIKE(TRIM(t."TADLUP"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."TADLUP"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."TADLUP") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."TADLUP")) END), 0) &lt; 19000101)) THEN 1 END) AS f1
        FROM DATACUT5."HUB_MT_TDACADP" t
        CROSS JOIN params p
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'TDACADP-001|Invalid Dates|Invalid date: DATE LAST UPDATE (TADLUP)'
      ))
    UNION ALL
/* =============================================================================
   TDACMSP - Term Deposits Account Master File
   Πίνακας: DATACUT5."HUB_MT_TDACMSP"   Shadow: TDMDFL = 'S' (εξαιρούνται)   Έλεγχοι: 25
   ============================================================================= */
    SELECT 'TDACMSP - Term Deposits Account Master File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- TDACMSP-001: Missing customer key (TDDCB/TDDCS)
          COUNT(CASE WHEN NVL(t."TDMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t1,
          COUNT(CASE WHEN NVL(t."TDMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."TDDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."TDDCB")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."TDDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."TDDCS")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."TDDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."TDDCS")) END) = 0) THEN 1 END) AS f1,
          -- TDACMSP-002: Missing account key (TDACB/TDACS/TDACX)
          COUNT(CASE WHEN NVL(t."TDMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t2,
          COUNT(CASE WHEN NVL(t."TDMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."TDACB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."TDACB")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."TDACB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."TDACB")) END) = 0 OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."TDACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."TDACS")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."TDACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."TDACS")) END) = 0 OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."TDACX") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."TDACX")) END) IS NULL) THEN 1 END) AS f2,
          -- TDACMSP-003: Invalid Restriction (TDRSTR), allowed 1/2/3/4/5/6
          COUNT(CASE WHEN NVL(t."TDMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."TDRSTR") IS NOT NULL) THEN 1 END) AS t3,
          COUNT(CASE WHEN NVL(t."TDMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."TDRSTR") IS NOT NULL) AND (TRIM(t."TDRSTR") NOT IN ('1','2','3','4','5','6')) THEN 1 END) AS f3,
          -- TDACMSP-004: Invalid Status (TDSTUS), allowed 1/2/3/4/5/6/7/A/B/C/E/S
          COUNT(CASE WHEN NVL(t."TDMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."TDSTUS") IS NOT NULL) THEN 1 END) AS t4,
          COUNT(CASE WHEN NVL(t."TDMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."TDSTUS") IS NOT NULL) AND (TRIM(t."TDSTUS") NOT IN ('1','2','3','4','5','6','7','A','B','C','E','S')) THEN 1 END) AS f4,
          -- TDACMSP-005: Invalid Statutory A/C Status (TDCBST), allowed 1/2/3/4/5
          COUNT(CASE WHEN NVL(t."TDMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."TDCBST") IS NOT NULL) THEN 1 END) AS t5,
          COUNT(CASE WHEN NVL(t."TDMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."TDCBST") IS NOT NULL) AND (TRIM(t."TDCBST") NOT IN ('1','2','3','4','5')) THEN 1 END) AS f5,
          -- TDACMSP-006: Invalid Credit Grade (TDCRGR), allowed 1/2/3/6/7
          COUNT(CASE WHEN NVL(t."TDMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."TDCRGR") IS NOT NULL) THEN 1 END) AS t6,
          COUNT(CASE WHEN NVL(t."TDMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."TDCRGR") IS NOT NULL) AND (TRIM(t."TDCRGR") NOT IN ('1','2','3','6','7')) THEN 1 END) AS f6,
          -- TDACMSP-007: Country of Registration/Residence (TDCTRS) not a valid country code (SSSTDPP CT)
          COUNT(CASE WHEN NVL(t."TDMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."TDCTRS") IS NOT NULL) THEN 1 END) AS t7,
          COUNT(CASE WHEN NVL(t."TDMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."TDCTRS") IS NOT NULL) AND (j1.code IS NULL) THEN 1 END) AS f7,
          -- TDACMSP-008: Nationality Code (TDNATY) not a valid country code (SSSTDPP CT)
          COUNT(CASE WHEN NVL(t."TDMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."TDNATY") IS NOT NULL) THEN 1 END) AS t8,
          COUNT(CASE WHEN NVL(t."TDMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."TDNATY") IS NOT NULL) AND (j2.code IS NULL) THEN 1 END) AS f8,
          -- TDACMSP-009: Invalid GIMIS Customer Indicator (TDGMCI), allowed C/I/M/N/S
          COUNT(CASE WHEN NVL(t."TDMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."TDGMCI") IS NOT NULL) THEN 1 END) AS t9,
          COUNT(CASE WHEN NVL(t."TDMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."TDGMCI") IS NOT NULL) AND (TRIM(t."TDGMCI") NOT IN ('C','I','M','N','S')) THEN 1 END) AS f9,
          -- TDACMSP-010: Invalid Language Code (TDLANG), allowed 1/2/3/P/S
          COUNT(CASE WHEN NVL(t."TDMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."TDLANG") IS NOT NULL) THEN 1 END) AS t10,
          COUNT(CASE WHEN NVL(t."TDMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."TDLANG") IS NOT NULL) AND (TRIM(t."TDLANG") NOT IN ('1','2','3','P','S')) THEN 1 END) AS f10,
          -- TDACMSP-011: Invalid Despatch Code (TDDPCD), allowed A/C/G/H/K/M/N/P/W
          COUNT(CASE WHEN NVL(t."TDMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."TDDPCD") IS NOT NULL) THEN 1 END) AS t11,
          COUNT(CASE WHEN NVL(t."TDMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."TDDPCD") IS NOT NULL) AND (TRIM(t."TDDPCD") NOT IN ('A','C','G','H','K','M','N','P','W')) THEN 1 END) AS f11,
          -- TDACMSP-012: Invalid Interest Application Cycle (TDINAC), allowed H/M/Q/Y
          COUNT(CASE WHEN NVL(t."TDMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."TDINAC") IS NOT NULL) THEN 1 END) AS t12,
          COUNT(CASE WHEN NVL(t."TDMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."TDINAC") IS NOT NULL) AND (TRIM(t."TDINAC") NOT IN ('H','M','Q','Y')) THEN 1 END) AS f12,
          -- TDACMSP-013: Invalid Overdue Deposit Int Calculation Method (TDODIC), allowed 0/1/2
          COUNT(CASE WHEN NVL(t."TDMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."TDODIC") IS NOT NULL) THEN 1 END) AS t13,
          COUNT(CASE WHEN NVL(t."TDMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."TDODIC") IS NOT NULL) AND (TRIM(t."TDODIC") NOT IN ('0','1','2')) THEN 1 END) AS f13,
          -- TDACMSP-014: Invalid Maturity (remaining maturity) (TDMTCD), allowed A/B/C/D/E/F/G/H/I/J/P/Q/R/S/T
          COUNT(CASE WHEN NVL(t."TDMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."TDMTCD") IS NOT NULL) THEN 1 END) AS t14,
          COUNT(CASE WHEN NVL(t."TDMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."TDMTCD") IS NOT NULL) AND (TRIM(t."TDMTCD") NOT IN ('A','B','C','D','E','F','G','H','I','J','P','Q','R','S','T')) THEN 1 END) AS f14,
          -- TDACMSP-015: Invalid Maturity Instruction (TDMTIN), allowed 0/1/2/3
          COUNT(CASE WHEN NVL(t."TDMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."TDMTIN") IS NOT NULL) THEN 1 END) AS t15,
          COUNT(CASE WHEN NVL(t."TDMDFL",' ') &lt;&gt; 'S' AND (TRIM(t."TDMTIN") IS NOT NULL) AND (TRIM(t."TDMTIN") NOT IN ('0','1','2','3')) THEN 1 END) AS f15,
          -- TDACMSP-016: Invalid date: Date A/C Opened (TDDTAO)
          COUNT(CASE WHEN NVL(t."TDMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t16,
          COUNT(CASE WHEN NVL(t."TDMDFL",' ') &lt;&gt; 'S' AND ((NOT (TRIM(t."TDDTAO") IS NULL OR REGEXP_LIKE(TRIM(t."TDDTAO"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."TDDTAO"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."TDDTAO") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."TDDTAO")) END), 0) &lt; 19000101)) THEN 1 END) AS f16,
          -- TDACMSP-017: Invalid date: Date Last Active (YYYYMMDD) (TDDLAT)
          COUNT(CASE WHEN NVL(t."TDMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t17,
          COUNT(CASE WHEN NVL(t."TDMDFL",' ') &lt;&gt; 'S' AND ((NOT (TRIM(t."TDDLAT") IS NULL OR REGEXP_LIKE(TRIM(t."TDDLAT"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."TDDLAT"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."TDDLAT") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."TDDLAT")) END), 0) &lt; 19000101)) THEN 1 END) AS f17,
          -- TDACMSP-018: Invalid date: Date last interest application (TDDLIA)
          COUNT(CASE WHEN NVL(t."TDMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t18,
          COUNT(CASE WHEN NVL(t."TDMDFL",' ') &lt;&gt; 'S' AND ((NOT (TRIM(t."TDDLIA") IS NULL OR REGEXP_LIKE(TRIM(t."TDDLIA"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."TDDLIA"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."TDDLIA") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."TDDLIA")) END), 0) &lt; 19000101)) THEN 1 END) AS f18,
          -- TDACMSP-019: Invalid date: Last Update Date (TDDLUP)
          COUNT(CASE WHEN NVL(t."TDMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t19,
          COUNT(CASE WHEN NVL(t."TDMDFL",' ') &lt;&gt; 'S' AND ((NOT (TRIM(t."TDDLUP") IS NULL OR REGEXP_LIKE(TRIM(t."TDDLUP"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."TDDLUP"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."TDDLUP") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."TDDLUP")) END), 0) &lt; 19000101)) THEN 1 END) AS f19,
          -- TDACMSP-020: Duplicate account key (TDACB+TDACS+TDACX)
          COUNT(CASE WHEN NVL(t."TDMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."TDACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."TDACS")) END) IS NOT NULL) THEN 1 END) AS t20,
          COUNT(CASE WHEN NVL(t."TDMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."TDACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."TDACS")) END) IS NOT NULL) AND (t.dq_dup20 &gt; 1) THEN 1 END) AS f20,
          -- TDACMSP-021: Customer (TDDCB+TDDCS) not found in SSCUSTP
          COUNT(CASE WHEN NVL(t."TDMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."TDDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."TDDCB")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."TDDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."TDDCS")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."TDDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."TDDCS")) END) &lt;&gt; 0) THEN 1 END) AS t21,
          COUNT(CASE WHEN NVL(t."TDMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."TDDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."TDDCB")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."TDDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."TDDCS")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."TDDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."TDDCS")) END) &lt;&gt; 0) AND (j3.dcb IS NULL) THEN 1 END) AS f21,
          -- TDACMSP-B01: Deposit under lien greater than ledger balance (TDDPUL &gt; TDRLBL)
          COUNT(CASE WHEN NVL(t."TDMDFL",' ') &lt;&gt; 'S' AND (NVL((CASE WHEN VALIDATE_CONVERSION(TRIM(t."TDDPUL") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."TDDPUL")) END),0) &gt; 0) THEN 1 END) AS t22,
          COUNT(CASE WHEN NVL(t."TDMDFL",' ') &lt;&gt; 'S' AND (NVL((CASE WHEN VALIDATE_CONVERSION(TRIM(t."TDDPUL") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."TDDPUL")) END),0) &gt; 0) AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."TDDPUL") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."TDDPUL")) END) &gt; NVL((CASE WHEN VALIDATE_CONVERSION(TRIM(t."TDRLBL") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."TDRLBL")) END),0)) THEN 1 END) AS f22,
          -- TDACMSP-B02: Closed term deposit with non-zero ledger balance (TDSTUS=5, TDRLBL)
          COUNT(CASE WHEN NVL(t."TDMDFL",' ') &lt;&gt; 'S' AND (NVL(TRIM(t."TDSTUS"),'#') = '5') THEN 1 END) AS t23,
          COUNT(CASE WHEN NVL(t."TDMDFL",' ') &lt;&gt; 'S' AND (NVL(TRIM(t."TDSTUS"),'#') = '5') AND (NVL((CASE WHEN VALIDATE_CONVERSION(TRIM(t."TDRLBL") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."TDRLBL")) END),0) &lt;&gt; 0) THEN 1 END) AS f23,
          -- TDACMSP-T01: Active term deposit opened more than 10 years ago (TDDTAO)
          COUNT(CASE WHEN NVL(t."TDMDFL",' ') &lt;&gt; 'S' AND (NVL(TRIM(t."TDSTUS"),'#') = '1') THEN 1 END) AS t24,
          COUNT(CASE WHEN NVL(t."TDMDFL",' ') &lt;&gt; 'S' AND (NVL(TRIM(t."TDSTUS"),'#') = '1') AND ((CASE WHEN REGEXP_LIKE(TRIM(t."TDDTAO"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."TDDTAO") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."TDDTAO")) END) &lt; p.ref_num - 100000) THEN 1 END) AS f24,
          -- TDACMSP-T02: Matured term deposit still active (TDDUDT &lt; today)
          COUNT(CASE WHEN NVL(t."TDMDFL",' ') &lt;&gt; 'S' AND (NVL(TRIM(t."TDSTUS"),'#') = '1') THEN 1 END) AS t25,
          COUNT(CASE WHEN NVL(t."TDMDFL",' ') &lt;&gt; 'S' AND (NVL(TRIM(t."TDSTUS"),'#') = '1') AND ((CASE WHEN REGEXP_LIKE(TRIM(t."TDDUDT"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."TDDUDT") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."TDDUDT")) END) &lt; p.ref_num) THEN 1 END) AS f25
        FROM (SELECT x.*,
                     COUNT(CASE WHEN NVL("TDMDFL",' ') &lt;&gt; 'S' THEN 1 END) OVER (PARTITION BY "TDACB", "TDACS", "TDACX") AS dq_dup20
                FROM DATACUT5."HUB_MT_TDACMSP" x) t
        CROSS JOIN params p
        LEFT JOIN ref_ct j1 ON j1.code = TRIM(t."TDCTRS")
        LEFT JOIN ref_ct j2 ON j2.code = TRIM(t."TDNATY")
        LEFT JOIN k_cus j3 ON j3.dcb = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."TDDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."TDDCB")) END) AND j3.dcs = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."TDDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."TDDCS")) END)
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'TDACMSP-001|Missing Data|Missing customer key (TDDCB/TDDCS)',
        (t2, f2) AS 'TDACMSP-002|Missing Data|Missing account key (TDACB/TDACS/TDACX)',
        (t3, f3) AS 'TDACMSP-003|Invalid Values|Invalid Restriction (TDRSTR), allowed 1/2/3/4/5/6',
        (t4, f4) AS 'TDACMSP-004|Invalid Values|Invalid Status (TDSTUS), allowed 1/2/3/4/5/6/7/A/B/C/E/S',
        (t5, f5) AS 'TDACMSP-005|Invalid Values|Invalid Statutory A/C Status (TDCBST), allowed 1/2/3/4/5',
        (t6, f6) AS 'TDACMSP-006|Invalid Values|Invalid Credit Grade (TDCRGR), allowed 1/2/3/6/7',
        (t7, f7) AS 'TDACMSP-007|Invalid Values|Country of Registration/Residence (TDCTRS) not a valid country code (SSSTDPP CT)',
        (t8, f8) AS 'TDACMSP-008|Invalid Values|Nationality Code (TDNATY) not a valid country code (SSSTDPP CT)',
        (t9, f9) AS 'TDACMSP-009|Invalid Values|Invalid GIMIS Customer Indicator (TDGMCI), allowed C/I/M/N/S',
        (t10, f10) AS 'TDACMSP-010|Invalid Values|Invalid Language Code (TDLANG), allowed 1/2/3/P/S',
        (t11, f11) AS 'TDACMSP-011|Invalid Values|Invalid Despatch Code (TDDPCD), allowed A/C/G/H/K/M/N/P/W',
        (t12, f12) AS 'TDACMSP-012|Invalid Values|Invalid Interest Application Cycle (TDINAC), allowed H/M/Q/Y',
        (t13, f13) AS 'TDACMSP-013|Invalid Values|Invalid Overdue Deposit Int Calculation Method (TDODIC), allowed 0/1/2',
        (t14, f14) AS 'TDACMSP-014|Invalid Values|Invalid Maturity (remaining maturity) (TDMTCD), allowed A/B/C/D/E/F/G/H/I/J/P/Q/R/S/T',
        (t15, f15) AS 'TDACMSP-015|Invalid Values|Invalid Maturity Instruction (TDMTIN), allowed 0/1/2/3',
        (t16, f16) AS 'TDACMSP-016|Invalid Dates|Invalid date: Date A/C Opened (TDDTAO)',
        (t17, f17) AS 'TDACMSP-017|Invalid Dates|Invalid date: Date Last Active (YYYYMMDD) (TDDLAT)',
        (t18, f18) AS 'TDACMSP-018|Invalid Dates|Invalid date: Date last interest application (TDDLIA)',
        (t19, f19) AS 'TDACMSP-019|Invalid Dates|Invalid date: Last Update Date (TDDLUP)',
        (t20, f20) AS 'TDACMSP-020|Duplicates|Duplicate account key (TDACB+TDACS+TDACX)',
        (t21, f21) AS 'TDACMSP-021|Missing Links|Customer (TDDCB+TDDCS) not found in SSCUSTP',
        (t22, f22) AS 'TDACMSP-B01|Balances|Deposit under lien greater than ledger balance (TDDPUL &gt; TDRLBL)',
        (t23, f23) AS 'TDACMSP-B02|Balances|Closed term deposit with non-zero ledger balance (TDSTUS=5, TDRLBL)',
        (t24, f24) AS 'TDACMSP-T01|Timeliness|Active term deposit opened more than 10 years ago (TDDTAO)',
        (t25, f25) AS 'TDACMSP-T02|Timeliness|Matured term deposit still active (TDDUDT &lt; today)'
      ))
    UNION ALL
/* =============================================================================
   LSOIACP - LS OVERDUE INTEREST ACCRUAL DETAIL FILE
   Πίνακας: DATACUT5."HUB_MT_LSOIACP"   Shadow: EIMDFL = 'S' (εξαιρούνται)   Έλεγχοι: 3
   ============================================================================= */
    SELECT 'LSOIACP - LS OVERDUE INTEREST ACCRUAL DETAIL FILE' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- LSOIACP-001: Missing account key (EIACB/EIACS/EIACX)
          COUNT(CASE WHEN NVL(t."EIMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t1,
          COUNT(CASE WHEN NVL(t."EIMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."EIACB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."EIACB")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."EIACB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."EIACB")) END) = 0 OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."EIACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."EIACS")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."EIACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."EIACS")) END) = 0 OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."EIACX") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."EIACX")) END) IS NULL) THEN 1 END) AS f1,
          -- LSOIACP-002: Invalid date: LAST UPDATE DATE (EIDLUP)
          COUNT(CASE WHEN NVL(t."EIMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t2,
          COUNT(CASE WHEN NVL(t."EIMDFL",' ') &lt;&gt; 'S' AND ((NOT (TRIM(t."EIDLUP") IS NULL OR REGEXP_LIKE(TRIM(t."EIDLUP"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."EIDLUP"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."EIDLUP") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."EIDLUP")) END), 0) &lt; 19000101)) THEN 1 END) AS f2,
          -- LSOIACP-003: Account (EIACB+EIACS+EIACX) not found in LSACMSP
          COUNT(CASE WHEN NVL(t."EIMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."EIACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."EIACS")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."EIACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."EIACS")) END) &lt;&gt; 0) THEN 1 END) AS t3,
          COUNT(CASE WHEN NVL(t."EIMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."EIACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."EIACS")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."EIACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."EIACS")) END) &lt;&gt; 0) AND (j1.k1 IS NULL) THEN 1 END) AS f3
        FROM DATACUT5."HUB_MT_LSOIACP" t
        CROSS JOIN params p
        LEFT JOIN k_acc_LSACMSP j1 ON j1.k1 = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."EIACB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."EIACB")) END) AND j1.k2 = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."EIACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."EIACS")) END) AND j1.k3 = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."EIACX") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."EIACX")) END)
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'LSOIACP-001|Missing Data|Missing account key (EIACB/EIACS/EIACX)',
        (t2, f2) AS 'LSOIACP-002|Invalid Dates|Invalid date: LAST UPDATE DATE (EIDLUP)',
        (t3, f3) AS 'LSOIACP-003|Missing Links|Account (EIACB+EIACS+EIACX) not found in LSACMSP'
      ))
    UNION ALL
/* =============================================================================
   LSRPACP - LS REPAYMENT ACCOUNT FILE
   Πίνακας: DATACUT5."HUB_MT_LSRPACP"   Shadow: PQMDFL = 'S' (εξαιρούνται)   Έλεγχοι: 3
   ============================================================================= */
    SELECT 'LSRPACP - LS REPAYMENT ACCOUNT FILE' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- LSRPACP-001: Missing account key (PQACB/PQACS/PQACX)
          COUNT(CASE WHEN NVL(t."PQMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t1,
          COUNT(CASE WHEN NVL(t."PQMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."PQACB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."PQACB")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."PQACB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."PQACB")) END) = 0 OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."PQACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."PQACS")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."PQACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."PQACS")) END) = 0 OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."PQACX") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."PQACX")) END) IS NULL) THEN 1 END) AS f1,
          -- LSRPACP-002: Invalid date: LAST UPDATE DATE (PQDLUP)
          COUNT(CASE WHEN NVL(t."PQMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t2,
          COUNT(CASE WHEN NVL(t."PQMDFL",' ') &lt;&gt; 'S' AND ((NOT (TRIM(t."PQDLUP") IS NULL OR REGEXP_LIKE(TRIM(t."PQDLUP"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."PQDLUP"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."PQDLUP") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."PQDLUP")) END), 0) &lt; 19000101)) THEN 1 END) AS f2,
          -- LSRPACP-003: Account (PQACB+PQACS+PQACX) not found in LSACMSP
          COUNT(CASE WHEN NVL(t."PQMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."PQACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."PQACS")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."PQACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."PQACS")) END) &lt;&gt; 0) THEN 1 END) AS t3,
          COUNT(CASE WHEN NVL(t."PQMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."PQACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."PQACS")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."PQACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."PQACS")) END) &lt;&gt; 0) AND (j1.k1 IS NULL) THEN 1 END) AS f3
        FROM DATACUT5."HUB_MT_LSRPACP" t
        CROSS JOIN params p
        LEFT JOIN k_acc_LSACMSP j1 ON j1.k1 = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."PQACB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."PQACB")) END) AND j1.k2 = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."PQACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."PQACS")) END) AND j1.k3 = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."PQACX") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."PQACX")) END)
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'LSRPACP-001|Missing Data|Missing account key (PQACB/PQACS/PQACX)',
        (t2, f2) AS 'LSRPACP-002|Invalid Dates|Invalid date: LAST UPDATE DATE (PQDLUP)',
        (t3, f3) AS 'LSRPACP-003|Missing Links|Account (PQACB+PQACS+PQACX) not found in LSACMSP'
      ))
    UNION ALL
/* =============================================================================
   BAIMGCP - BOA Inward Message Control Information
   Πίνακας: DATACUT5."HUB_MT_BAIMGCP"   Shadow: BHMDFL = 'S' (εξαιρούνται)   Έλεγχοι: 4
   ============================================================================= */
    SELECT 'BAIMGCP - BOA Inward Message Control Information' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- BAIMGCP-001: Invalid date: Date Received (BHDTRC)
          COUNT(CASE WHEN NVL(t."BHMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t1,
          COUNT(CASE WHEN NVL(t."BHMDFL",' ') &lt;&gt; 'S' AND ((NOT (TRIM(t."BHDTRC") IS NULL OR REGEXP_LIKE(TRIM(t."BHDTRC"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."BHDTRC"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."BHDTRC") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."BHDTRC")) END), 0) &lt; 19000101)) THEN 1 END) AS f1,
          -- BAIMGCP-002: Invalid date: Approval/Verification Date (BHAVDT)
          COUNT(CASE WHEN NVL(t."BHMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t2,
          COUNT(CASE WHEN NVL(t."BHMDFL",' ') &lt;&gt; 'S' AND ((NOT (TRIM(t."BHAVDT") IS NULL OR REGEXP_LIKE(TRIM(t."BHAVDT"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."BHAVDT"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."BHAVDT") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."BHAVDT")) END), 0) &lt; 19000101)) THEN 1 END) AS f2,
          -- BAIMGCP-003: Invalid date: Outward Capture Date (BHOWCD)
          COUNT(CASE WHEN NVL(t."BHMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t3,
          COUNT(CASE WHEN NVL(t."BHMDFL",' ') &lt;&gt; 'S' AND ((NOT (TRIM(t."BHOWCD") IS NULL OR REGEXP_LIKE(TRIM(t."BHOWCD"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."BHOWCD"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."BHOWCD") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."BHOWCD")) END), 0) &lt; 19000101)) THEN 1 END) AS f3,
          -- BAIMGCP-004: Invalid date: Last Update Date (BHDLUP)
          COUNT(CASE WHEN NVL(t."BHMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t4,
          COUNT(CASE WHEN NVL(t."BHMDFL",' ') &lt;&gt; 'S' AND ((NOT (TRIM(t."BHDLUP") IS NULL OR REGEXP_LIKE(TRIM(t."BHDLUP"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."BHDLUP"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."BHDLUP") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."BHDLUP")) END), 0) &lt; 19000101)) THEN 1 END) AS f4
        FROM DATACUT5."HUB_MT_BAIMGCP" t
        CROSS JOIN params p
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'BAIMGCP-001|Invalid Dates|Invalid date: Date Received (BHDTRC)',
        (t2, f2) AS 'BAIMGCP-002|Invalid Dates|Invalid date: Approval/Verification Date (BHAVDT)',
        (t3, f3) AS 'BAIMGCP-003|Invalid Dates|Invalid date: Outward Capture Date (BHOWCD)',
        (t4, f4) AS 'BAIMGCP-004|Invalid Dates|Invalid date: Last Update Date (BHDLUP)'
      ))
    UNION ALL
/* =============================================================================
   DDTNJNP - Demand Deposits Transaction Journal
   Πίνακας: DATACUT5."HUB_MT_DDTNJNP"   Shadow: δεν υπάρχει mode flag   Έλεγχοι: 6
   ============================================================================= */
    SELECT 'DDTNJNP - Demand Deposits Transaction Journal' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- DDTNJNP-001: Invalid date: Capture Date (DPCPDT)
          COUNT(CASE WHEN 1=1 THEN 1 END) AS t1,
          COUNT(CASE WHEN 1=1 AND ((NOT (TRIM(t."DPCPDT") IS NULL OR REGEXP_LIKE(TRIM(t."DPCPDT"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."DPCPDT"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."DPCPDT") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."DPCPDT")) END), 0) &lt; 19000101)) THEN 1 END) AS f1,
          -- DDTNJNP-002: Invalid date: Approval/Verification Date (DPAVDT)
          COUNT(CASE WHEN 1=1 THEN 1 END) AS t2,
          COUNT(CASE WHEN 1=1 AND ((NOT (TRIM(t."DPAVDT") IS NULL OR REGEXP_LIKE(TRIM(t."DPAVDT"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."DPAVDT"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."DPAVDT") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."DPAVDT")) END), 0) &lt; 19000101)) THEN 1 END) AS f2,
          -- DDTNJNP-003: Invalid date: Posting Date (DPPSDT)
          COUNT(CASE WHEN 1=1 THEN 1 END) AS t3,
          COUNT(CASE WHEN 1=1 AND ((NOT (TRIM(t."DPPSDT") IS NULL OR REGEXP_LIKE(TRIM(t."DPPSDT"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."DPPSDT"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."DPPSDT") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."DPPSDT")) END), 0) &lt; 19000101)) THEN 1 END) AS f3,
          -- DDTNJNP-004: Invalid date: Date of Original Entry (DPDOOE)
          COUNT(CASE WHEN 1=1 THEN 1 END) AS t4,
          COUNT(CASE WHEN 1=1 AND ((NOT (TRIM(t."DPDOOE") IS NULL OR REGEXP_LIKE(TRIM(t."DPDOOE"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."DPDOOE"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."DPDOOE") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."DPDOOE")) END), 0) &lt; 19000101)) THEN 1 END) AS f4,
          -- DDTNJNP-005: Customer (DPDCB+DPDCS) not found in SSCUSTP
          COUNT(CASE WHEN ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."DPDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."DPDCB")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."DPDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."DPDCS")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."DPDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."DPDCS")) END) &lt;&gt; 0) THEN 1 END) AS t5,
          COUNT(CASE WHEN ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."DPDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."DPDCB")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."DPDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."DPDCS")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."DPDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."DPDCS")) END) &lt;&gt; 0) AND (j1.dcb IS NULL) THEN 1 END) AS f5,
          -- DDTNJNP-006: Account (DPACB+DPACS+DPACX) not found in DDACMSP
          COUNT(CASE WHEN ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."DPACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."DPACS")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."DPACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."DPACS")) END) &lt;&gt; 0) THEN 1 END) AS t6,
          COUNT(CASE WHEN ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."DPACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."DPACS")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."DPACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."DPACS")) END) &lt;&gt; 0) AND (j2.k1 IS NULL) THEN 1 END) AS f6
        FROM DATACUT5."HUB_MT_DDTNJNP" t
        CROSS JOIN params p
        LEFT JOIN k_cus j1 ON j1.dcb = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."DPDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."DPDCB")) END) AND j1.dcs = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."DPDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."DPDCS")) END)
        LEFT JOIN k_acc_DDACMSP j2 ON j2.k1 = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."DPACB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."DPACB")) END) AND j2.k2 = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."DPACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."DPACS")) END) AND j2.k3 = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."DPACX") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."DPACX")) END)
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'DDTNJNP-001|Invalid Dates|Invalid date: Capture Date (DPCPDT)',
        (t2, f2) AS 'DDTNJNP-002|Invalid Dates|Invalid date: Approval/Verification Date (DPAVDT)',
        (t3, f3) AS 'DDTNJNP-003|Invalid Dates|Invalid date: Posting Date (DPPSDT)',
        (t4, f4) AS 'DDTNJNP-004|Invalid Dates|Invalid date: Date of Original Entry (DPDOOE)',
        (t5, f5) AS 'DDTNJNP-005|Missing Links|Customer (DPDCB+DPDCS) not found in SSCUSTP',
        (t6, f6) AS 'DDTNJNP-006|Missing Links|Account (DPACB+DPACS+DPACX) not found in DDACMSP'
      ))
    UNION ALL
/* =============================================================================
   DDTNJXP - DD Transaction Narrative Extension File
   Πίνακας: DATACUT5."HUB_MT_DDTNJXP"   Shadow: δεν υπάρχει mode flag   Έλεγχοι: 4
   ============================================================================= */
    SELECT 'DDTNJXP - DD Transaction Narrative Extension File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- DDTNJXP-001: Missing account key (NEACB/NEACS/NEACX)
          COUNT(CASE WHEN 1=1 THEN 1 END) AS t1,
          COUNT(CASE WHEN 1=1 AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."NEACB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."NEACB")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."NEACB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."NEACB")) END) = 0 OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."NEACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."NEACS")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."NEACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."NEACS")) END) = 0 OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."NEACX") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."NEACX")) END) IS NULL) THEN 1 END) AS f1,
          -- DDTNJXP-002: Invalid date: Capture Date (NECPDT)
          COUNT(CASE WHEN 1=1 THEN 1 END) AS t2,
          COUNT(CASE WHEN 1=1 AND ((NOT (TRIM(t."NECPDT") IS NULL OR REGEXP_LIKE(TRIM(t."NECPDT"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."NECPDT"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."NECPDT") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."NECPDT")) END), 0) &lt; 19000101)) THEN 1 END) AS f2,
          -- DDTNJXP-003: Invalid date: Posting Date (NEPSDT)
          COUNT(CASE WHEN 1=1 THEN 1 END) AS t3,
          COUNT(CASE WHEN 1=1 AND ((NOT (TRIM(t."NEPSDT") IS NULL OR REGEXP_LIKE(TRIM(t."NEPSDT"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."NEPSDT"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."NEPSDT") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."NEPSDT")) END), 0) &lt; 19000101)) THEN 1 END) AS f3,
          -- DDTNJXP-004: Account (NEACB+NEACS+NEACX) not found in DDACMSP
          COUNT(CASE WHEN ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."NEACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."NEACS")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."NEACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."NEACS")) END) &lt;&gt; 0) THEN 1 END) AS t4,
          COUNT(CASE WHEN ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."NEACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."NEACS")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."NEACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."NEACS")) END) &lt;&gt; 0) AND (j1.k1 IS NULL) THEN 1 END) AS f4
        FROM DATACUT5."HUB_MT_DDTNJXP" t
        CROSS JOIN params p
        LEFT JOIN k_acc_DDACMSP j1 ON j1.k1 = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."NEACB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."NEACB")) END) AND j1.k2 = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."NEACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."NEACS")) END) AND j1.k3 = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."NEACX") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."NEACX")) END)
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'DDTNJXP-001|Missing Data|Missing account key (NEACB/NEACS/NEACX)',
        (t2, f2) AS 'DDTNJXP-002|Invalid Dates|Invalid date: Capture Date (NECPDT)',
        (t3, f3) AS 'DDTNJXP-003|Invalid Dates|Invalid date: Posting Date (NEPSDT)',
        (t4, f4) AS 'DDTNJXP-004|Missing Links|Account (NEACB+NEACS+NEACX) not found in DDACMSP'
      ))
    UNION ALL
/* =============================================================================
   GLTNJNP - General Ledger Transaction Journal File
   Πίνακας: DATACUT5."HUB_MT_GLTNJNP"   Shadow: δεν υπάρχει mode flag   Έλεγχοι: 3
   ============================================================================= */
    SELECT 'GLTNJNP - General Ledger Transaction Journal File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- GLTNJNP-001: Invalid date: Capture Date (G4CPDT)
          COUNT(CASE WHEN 1=1 THEN 1 END) AS t1,
          COUNT(CASE WHEN 1=1 AND ((NOT (TRIM(t."G4CPDT") IS NULL OR REGEXP_LIKE(TRIM(t."G4CPDT"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."G4CPDT"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."G4CPDT") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."G4CPDT")) END), 0) &lt; 19000101)) THEN 1 END) AS f1,
          -- GLTNJNP-002: Invalid date: Approval/Verification Date (G4AVDT)
          COUNT(CASE WHEN 1=1 THEN 1 END) AS t2,
          COUNT(CASE WHEN 1=1 AND ((NOT (TRIM(t."G4AVDT") IS NULL OR REGEXP_LIKE(TRIM(t."G4AVDT"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."G4AVDT"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."G4AVDT") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."G4AVDT")) END), 0) &lt; 19000101)) THEN 1 END) AS f2,
          -- GLTNJNP-003: Invalid date: Posting Date (G4PSDT)
          COUNT(CASE WHEN 1=1 THEN 1 END) AS t3,
          COUNT(CASE WHEN 1=1 AND ((NOT (TRIM(t."G4PSDT") IS NULL OR REGEXP_LIKE(TRIM(t."G4PSDT"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."G4PSDT"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."G4PSDT") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."G4PSDT")) END), 0) &lt; 19000101)) THEN 1 END) AS f3
        FROM DATACUT5."HUB_MT_GLTNJNP" t
        CROSS JOIN params p
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'GLTNJNP-001|Invalid Dates|Invalid date: Capture Date (G4CPDT)',
        (t2, f2) AS 'GLTNJNP-002|Invalid Dates|Invalid date: Approval/Verification Date (G4AVDT)',
        (t3, f3) AS 'GLTNJNP-003|Invalid Dates|Invalid date: Posting Date (G4PSDT)'
      ))
    UNION ALL
/* =============================================================================
   LSTNJNP - LS TRANSACTION JOURNAL FILE
   Πίνακας: DATACUT5."HUB_MT_LSTNJNP"   Shadow: δεν υπάρχει mode flag   Έλεγχοι: 4
   ============================================================================= */
    SELECT 'LSTNJNP - LS TRANSACTION JOURNAL FILE' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- LSTNJNP-001: Invalid date: CAPTURE DATE (ZYCPDT)
          COUNT(CASE WHEN 1=1 THEN 1 END) AS t1,
          COUNT(CASE WHEN 1=1 AND ((NOT (TRIM(t."ZYCPDT") IS NULL OR REGEXP_LIKE(TRIM(t."ZYCPDT"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."ZYCPDT"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."ZYCPDT") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."ZYCPDT")) END), 0) &lt; 19000101)) THEN 1 END) AS f1,
          -- LSTNJNP-002: Invalid date: APPROVAL/VERIFICATION DATE (ZYAVDT)
          COUNT(CASE WHEN 1=1 THEN 1 END) AS t2,
          COUNT(CASE WHEN 1=1 AND ((NOT (TRIM(t."ZYAVDT") IS NULL OR REGEXP_LIKE(TRIM(t."ZYAVDT"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."ZYAVDT"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."ZYAVDT") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."ZYAVDT")) END), 0) &lt; 19000101)) THEN 1 END) AS f2,
          -- LSTNJNP-003: Invalid date: POSTING DATE (ZYPSDT)
          COUNT(CASE WHEN 1=1 THEN 1 END) AS t3,
          COUNT(CASE WHEN 1=1 AND ((NOT (TRIM(t."ZYPSDT") IS NULL OR REGEXP_LIKE(TRIM(t."ZYPSDT"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."ZYPSDT"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."ZYPSDT") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."ZYPSDT")) END), 0) &lt; 19000101)) THEN 1 END) AS f3,
          -- LSTNJNP-004: Account (ZYACB+ZYACS+ZYACX) not found in LSACMSP
          COUNT(CASE WHEN ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZYACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZYACS")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZYACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZYACS")) END) &lt;&gt; 0) THEN 1 END) AS t4,
          COUNT(CASE WHEN ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZYACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZYACS")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZYACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZYACS")) END) &lt;&gt; 0) AND (j1.k1 IS NULL) THEN 1 END) AS f4
        FROM DATACUT5."HUB_MT_LSTNJNP" t
        CROSS JOIN params p
        LEFT JOIN k_acc_LSACMSP j1 ON j1.k1 = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZYACB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZYACB")) END) AND j1.k2 = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZYACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZYACS")) END) AND j1.k3 = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZYACX") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZYACX")) END)
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'LSTNJNP-001|Invalid Dates|Invalid date: CAPTURE DATE (ZYCPDT)',
        (t2, f2) AS 'LSTNJNP-002|Invalid Dates|Invalid date: APPROVAL/VERIFICATION DATE (ZYAVDT)',
        (t3, f3) AS 'LSTNJNP-003|Invalid Dates|Invalid date: POSTING DATE (ZYPSDT)',
        (t4, f4) AS 'LSTNJNP-004|Missing Links|Account (ZYACB+ZYACS+ZYACX) not found in LSACMSP'
      ))
    UNION ALL
/* =============================================================================
   TDTRNJP - Term Deposits Transaction Journal
   Πίνακας: DATACUT5."HUB_MT_TDTRNJP"   Shadow: δεν υπάρχει mode flag   Έλεγχοι: 3
   ============================================================================= */
    SELECT 'TDTRNJP - Term Deposits Transaction Journal' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- TDTRNJP-001: Invalid date: Capture Date (THCPDT)
          COUNT(CASE WHEN 1=1 THEN 1 END) AS t1,
          COUNT(CASE WHEN 1=1 AND ((NOT (TRIM(t."THCPDT") IS NULL OR REGEXP_LIKE(TRIM(t."THCPDT"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."THCPDT"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."THCPDT") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."THCPDT")) END), 0) &lt; 19000101)) THEN 1 END) AS f1,
          -- TDTRNJP-002: Invalid date: Posting Date (THPSDT)
          COUNT(CASE WHEN 1=1 THEN 1 END) AS t2,
          COUNT(CASE WHEN 1=1 AND ((NOT (TRIM(t."THPSDT") IS NULL OR REGEXP_LIKE(TRIM(t."THPSDT"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."THPSDT"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."THPSDT") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."THPSDT")) END), 0) &lt; 19000101)) THEN 1 END) AS f2,
          -- TDTRNJP-003: Account (THACB+THACS+THACX) not found in TDACMSP
          COUNT(CASE WHEN ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."THACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."THACS")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."THACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."THACS")) END) &lt;&gt; 0) THEN 1 END) AS t3,
          COUNT(CASE WHEN ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."THACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."THACS")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."THACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."THACS")) END) &lt;&gt; 0) AND (j1.k1 IS NULL) THEN 1 END) AS f3
        FROM DATACUT5."HUB_MT_TDTRNJP" t
        CROSS JOIN params p
        LEFT JOIN k_acc_TDACMSP j1 ON j1.k1 = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."THACB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."THACB")) END) AND j1.k2 = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."THACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."THACS")) END) AND j1.k3 = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."THACX") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."THACX")) END)
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'TDTRNJP-001|Invalid Dates|Invalid date: Capture Date (THCPDT)',
        (t2, f2) AS 'TDTRNJP-002|Invalid Dates|Invalid date: Posting Date (THPSDT)',
        (t3, f3) AS 'TDTRNJP-003|Missing Links|Account (THACB+THACS+THACX) not found in TDACMSP'
      ))
    UNION ALL
/* =============================================================================
   IETNJNP - I&amp;E Transaction Journal
   Πίνακας: DATACUT5."HUB_MT_IETNJNP"   Shadow: δεν υπάρχει mode flag   Έλεγχοι: 3
   ============================================================================= */
    SELECT 'IETNJNP - I&amp;E Transaction Journal' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- IETNJNP-001: Invalid date: Capture Date (KSCPDT)
          COUNT(CASE WHEN 1=1 THEN 1 END) AS t1,
          COUNT(CASE WHEN 1=1 AND ((NOT (TRIM(t."KSCPDT") IS NULL OR REGEXP_LIKE(TRIM(t."KSCPDT"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."KSCPDT"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."KSCPDT") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."KSCPDT")) END), 0) &lt; 19000101)) THEN 1 END) AS f1,
          -- IETNJNP-002: Invalid date: Approval/Verification Date (KSAVDT)
          COUNT(CASE WHEN 1=1 THEN 1 END) AS t2,
          COUNT(CASE WHEN 1=1 AND ((NOT (TRIM(t."KSAVDT") IS NULL OR REGEXP_LIKE(TRIM(t."KSAVDT"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."KSAVDT"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."KSAVDT") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."KSAVDT")) END), 0) &lt; 19000101)) THEN 1 END) AS f2,
          -- IETNJNP-003: Invalid date: Posting Date (KSPSDT)
          COUNT(CASE WHEN 1=1 THEN 1 END) AS t3,
          COUNT(CASE WHEN 1=1 AND ((NOT (TRIM(t."KSPSDT") IS NULL OR REGEXP_LIKE(TRIM(t."KSPSDT"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."KSPSDT"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."KSPSDT") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."KSPSDT")) END), 0) &lt; 19000101)) THEN 1 END) AS f3
        FROM DATACUT5."HUB_MT_IETNJNP" t
        CROSS JOIN params p
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'IETNJNP-001|Invalid Dates|Invalid date: Capture Date (KSCPDT)',
        (t2, f2) AS 'IETNJNP-002|Invalid Dates|Invalid date: Approval/Verification Date (KSAVDT)',
        (t3, f3) AS 'IETNJNP-003|Invalid Dates|Invalid date: Posting Date (KSPSDT)'
      ))
    UNION ALL
/* =============================================================================
   IEACMSP - I&amp;E Account File
   Πίνακας: DATACUT5."HUB_MT_IEACMSP"   Shadow: KEMDFL = 'S' (εξαιρούνται)   Έλεγχοι: 3
   ============================================================================= */
    SELECT 'IEACMSP - I&amp;E Account File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- IEACMSP-001: Missing account key (KEACB/KEACS/KEACX)
          COUNT(CASE WHEN NVL(t."KEMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t1,
          COUNT(CASE WHEN NVL(t."KEMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."KEACB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."KEACB")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."KEACB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."KEACB")) END) = 0 OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."KEACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."KEACS")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."KEACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."KEACS")) END) = 0 OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."KEACX") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."KEACX")) END) IS NULL) THEN 1 END) AS f1,
          -- IEACMSP-002: Invalid date: Date A/C Opened (KEDTAO)
          COUNT(CASE WHEN NVL(t."KEMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t2,
          COUNT(CASE WHEN NVL(t."KEMDFL",' ') &lt;&gt; 'S' AND ((NOT (TRIM(t."KEDTAO") IS NULL OR REGEXP_LIKE(TRIM(t."KEDTAO"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."KEDTAO"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."KEDTAO") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."KEDTAO")) END), 0) &lt; 19000101)) THEN 1 END) AS f2,
          -- IEACMSP-003: Invalid date: Last Update Date (KEDLUP)
          COUNT(CASE WHEN NVL(t."KEMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t3,
          COUNT(CASE WHEN NVL(t."KEMDFL",' ') &lt;&gt; 'S' AND ((NOT (TRIM(t."KEDLUP") IS NULL OR REGEXP_LIKE(TRIM(t."KEDLUP"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."KEDLUP"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."KEDLUP") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."KEDLUP")) END), 0) &lt; 19000101)) THEN 1 END) AS f3
        FROM DATACUT5."HUB_MT_IEACMSP" t
        CROSS JOIN params p
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'IEACMSP-001|Missing Data|Missing account key (KEACB/KEACS/KEACX)',
        (t2, f2) AS 'IEACMSP-002|Invalid Dates|Invalid date: Date A/C Opened (KEDTAO)',
        (t3, f3) AS 'IEACMSP-003|Invalid Dates|Invalid date: Last Update Date (KEDLUP)'
      ))
    UNION ALL
/* =============================================================================
   IESBACP - I&amp;E Subsidiary Account File
   Πίνακας: DATACUT5."HUB_MT_IESBACP"   Shadow: KFMDFL = 'S' (εξαιρούνται)   Έλεγχοι: 4
   ============================================================================= */
    SELECT 'IESBACP - I&amp;E Subsidiary Account File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- IESBACP-001: Missing account key (KFACB/KFACS/KFACX)
          COUNT(CASE WHEN NVL(t."KFMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t1,
          COUNT(CASE WHEN NVL(t."KFMDFL",' ') &lt;&gt; 'S' AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."KFACB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."KFACB")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."KFACB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."KFACB")) END) = 0 OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."KFACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."KFACS")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."KFACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."KFACS")) END) = 0 OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."KFACX") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."KFACX")) END) IS NULL) THEN 1 END) AS f1,
          -- IESBACP-002: Invalid date: Date A/C Opened (KFDTAO)
          COUNT(CASE WHEN NVL(t."KFMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t2,
          COUNT(CASE WHEN NVL(t."KFMDFL",' ') &lt;&gt; 'S' AND ((NOT (TRIM(t."KFDTAO") IS NULL OR REGEXP_LIKE(TRIM(t."KFDTAO"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."KFDTAO"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."KFDTAO") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."KFDTAO")) END), 0) &lt; 19000101)) THEN 1 END) AS f2,
          -- IESBACP-003: Invalid date: Date Last Activity (KFDLAC)
          COUNT(CASE WHEN NVL(t."KFMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t3,
          COUNT(CASE WHEN NVL(t."KFMDFL",' ') &lt;&gt; 'S' AND ((NOT (TRIM(t."KFDLAC") IS NULL OR REGEXP_LIKE(TRIM(t."KFDLAC"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."KFDLAC"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."KFDLAC") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."KFDLAC")) END), 0) &lt; 19000101)) THEN 1 END) AS f3,
          -- IESBACP-004: Invalid date: Last Update Date (KFDLUP)
          COUNT(CASE WHEN NVL(t."KFMDFL",' ') &lt;&gt; 'S' THEN 1 END) AS t4,
          COUNT(CASE WHEN NVL(t."KFMDFL",' ') &lt;&gt; 'S' AND ((NOT (TRIM(t."KFDLUP") IS NULL OR REGEXP_LIKE(TRIM(t."KFDLUP"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."KFDLUP"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."KFDLUP") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."KFDLUP")) END), 0) &lt; 19000101)) THEN 1 END) AS f4
        FROM DATACUT5."HUB_MT_IESBACP" t
        CROSS JOIN params p
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'IESBACP-001|Missing Data|Missing account key (KFACB/KFACS/KFACX)',
        (t2, f2) AS 'IESBACP-002|Invalid Dates|Invalid date: Date A/C Opened (KFDTAO)',
        (t3, f3) AS 'IESBACP-003|Invalid Dates|Invalid date: Date Last Activity (KFDLAC)',
        (t4, f4) AS 'IESBACP-004|Invalid Dates|Invalid date: Last Update Date (KFDLUP)'
      ))
    UNION ALL
/* =============================================================================
   SS@CFEP - Customer Service Fee Exemption File
   Πίνακας: DATACUT5."HUB_MT_SS@CFEP"   Shadow: δεν υπάρχει mode flag   Έλεγχοι: 4
   ============================================================================= */
    SELECT 'SS@CFEP - Customer Service Fee Exemption File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- SS_CFEP-001: Missing customer key (CEDCB/CEDCS)
          COUNT(CASE WHEN 1=1 THEN 1 END) AS t1,
          COUNT(CASE WHEN 1=1 AND ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."CEDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."CEDCB")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."CEDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."CEDCS")) END) IS NULL OR (CASE WHEN VALIDATE_CONVERSION(TRIM(t."CEDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."CEDCS")) END) = 0) THEN 1 END) AS f1,
          -- SS_CFEP-002: Invalid date: Expiry Date (CEEXDT)
          COUNT(CASE WHEN 1=1 THEN 1 END) AS t2,
          COUNT(CASE WHEN 1=1 AND ((NOT (TRIM(t."CEEXDT") IS NULL OR REGEXP_LIKE(TRIM(t."CEEXDT"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."CEEXDT"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."CEEXDT") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."CEEXDT")) END), 0) &lt; 19000101)) THEN 1 END) AS f2,
          -- SS_CFEP-003: Invalid date: Capture Date (CECPDT)
          COUNT(CASE WHEN 1=1 THEN 1 END) AS t3,
          COUNT(CASE WHEN 1=1 AND ((NOT (TRIM(t."CECPDT") IS NULL OR REGEXP_LIKE(TRIM(t."CECPDT"), '^[0 -]*$')) AND NVL((CASE WHEN REGEXP_LIKE(TRIM(t."CECPDT"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."CECPDT") AS DATE, 'YYYYMMDD') = 1 THEN TO_NUMBER(TRIM(t."CECPDT")) END), 0) &lt; 19000101)) THEN 1 END) AS f3,
          -- SS_CFEP-004: Customer (CEDCB+CEDCS) not found in SSCUSTP
          COUNT(CASE WHEN ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."CEDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."CEDCB")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."CEDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."CEDCS")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."CEDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."CEDCS")) END) &lt;&gt; 0) THEN 1 END) AS t4,
          COUNT(CASE WHEN ((CASE WHEN VALIDATE_CONVERSION(TRIM(t."CEDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."CEDCB")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."CEDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."CEDCS")) END) IS NOT NULL AND (CASE WHEN VALIDATE_CONVERSION(TRIM(t."CEDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."CEDCS")) END) &lt;&gt; 0) AND (j1.dcb IS NULL) THEN 1 END) AS f4
        FROM DATACUT5."HUB_MT_SS@CFEP" t
        CROSS JOIN params p
        LEFT JOIN k_cus j1 ON j1.dcb = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."CEDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."CEDCB")) END) AND j1.dcs = (CASE WHEN VALIDATE_CONVERSION(TRIM(t."CEDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."CEDCS")) END)
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'SS_CFEP-001|Missing Data|Missing customer key (CEDCB/CEDCS)',
        (t2, f2) AS 'SS_CFEP-002|Invalid Dates|Invalid date: Expiry Date (CEEXDT)',
        (t3, f3) AS 'SS_CFEP-003|Invalid Dates|Invalid date: Capture Date (CECPDT)',
        (t4, f4) AS 'SS_CFEP-004|Missing Links|Customer (CEDCB+CEDCS) not found in SSCUSTP'
      ))
    UNION ALL
/* ############## DC5 μέρος 1: νέοι πίνακες / αλλαγμένα πεδία (DD v1.24) ############## */
/* =============================================================================
   IBCMINP - Internet Banking Customers Migration Information
   Πίνακας: DATACUT5."HUB_MT_IBCMINP"   Shadow: δεν υπάρχει mode flag   Έλεγχοι: 11
   Νέος πίνακας στο DD v1.24. Ένας Internet Banking χρήστης ανά εγγραφή.
   ============================================================================= */
    SELECT 'IBCMINP - Internet Banking Customers Migration Information' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- IBCMINP-001: Missing Internet Banking ID (IMIBID)
          COUNT(*) AS t1,
          COUNT(CASE WHEN TRIM(s."IMIBID") IS NULL THEN 1 END) AS f1,
          -- IBCMINP-002: Missing customer serial (IMDCS)
          COUNT(*) AS t2,
          COUNT(CASE WHEN NVL(s.n_imdcs, 0) = 0 THEN 1 END) AS f2,
          -- IBCMINP-003: Duplicate Internet Banking ID (IMIBID)
          COUNT(CASE WHEN TRIM(s."IMIBID") IS NOT NULL THEN 1 END) AS t3,
          COUNT(CASE WHEN TRIM(s."IMIBID") IS NOT NULL AND s.dup_imibid &gt; 1 THEN 1 END) AS f3,
          -- IBCMINP-004: Customer (IMDCB+IMDCS) not found in SSCUSTP
          COUNT(CASE WHEN NVL(s.n_imdcb, 0) &lt;&gt; 0 AND NVL(s.n_imdcs, 0) &lt;&gt; 0 THEN 1 END) AS t4,
          COUNT(CASE WHEN NVL(s.n_imdcb, 0) &lt;&gt; 0 AND NVL(s.n_imdcs, 0) &lt;&gt; 0 AND j1.dcb IS NULL THEN 1 END) AS f4,
          -- IBCMINP-005: Not an integer value: Phone Banking Number (IMPBN)
          COUNT(CASE WHEN TRIM(s."IMPBN") IS NOT NULL THEN 1 END) AS t5,
          COUNT(CASE WHEN TRIM(s."IMPBN") IS NOT NULL AND (VALIDATE_CONVERSION(TRIM(s."IMPBN") AS NUMBER) = 0 OR s.n_impbn &lt;&gt; TRUNC(s.n_impbn)) THEN 1 END) AS f5,
          -- IBCMINP-006: Phone banking number (IMPBN) not found in EBCUSTP
          COUNT(CASE WHEN NVL(s.n_impbn, 0) &lt;&gt; 0 THEN 1 END) AS t6,
          COUNT(CASE WHEN NVL(s.n_impbn, 0) &lt;&gt; 0 AND j2.pbn IS NULL THEN 1 END) AS f6,
          -- IBCMINP-007: Invalid date: Start Date (IMSTDT)
          COUNT(*) AS t7,
          COUNT(CASE WHEN s.dv_imstdt = -1 THEN 1 END) AS f7,
          -- IBCMINP-008: Invalid date: Last Update Date (IMDLUP)
          COUNT(*) AS t8,
          COUNT(CASE WHEN s.dv_imdlup = -1 THEN 1 END) AS f8,
          -- IBCMINP-009: Invalid time: Start Time (IMSTTM)
          COUNT(*) AS t9,
          COUNT(CASE WHEN s.tm_imsttm = 1 THEN 1 END) AS f9,
          -- IBCMINP-010: Invalid time: Time Last Updated (IMTLUP)
          COUNT(*) AS t10,
          COUNT(CASE WHEN s.tm_imtlup = 1 THEN 1 END) AS f10,
          -- IBCMINP-011: Missing HIB status (IMIFSS)
          COUNT(*) AS t11,
          COUNT(CASE WHEN TRIM(s."IMIFSS") IS NULL THEN 1 END) AS f11
        FROM (
          SELECT s0.*, COUNT(*) OVER (PARTITION BY TRIM(s0."IMIBID")) AS dup_imibid
            FROM (
              SELECT t."IMIBID",
                     t."IMIFSS",
                     t."IMPBN",
                     (CASE WHEN VALIDATE_CONVERSION(TRIM(t."IMDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."IMDCS")) END) AS n_imdcs,
                     (CASE WHEN VALIDATE_CONVERSION(TRIM(t."IMDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."IMDCB")) END) AS n_imdcb,
                     (CASE WHEN VALIDATE_CONVERSION(TRIM(t."IMPBN") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."IMPBN")) END) AS n_impbn,
                     (CASE WHEN TRIM(t."IMSTDT") IS NULL OR REGEXP_LIKE(TRIM(t."IMSTDT"), '^[0 -]*$') THEN NULL
                       WHEN REGEXP_LIKE(TRIM(t."IMSTDT"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."IMSTDT") AS DATE, 'YYYYMMDD') = 1 AND TRIM(t."IMSTDT") &gt;= '19000101' THEN TO_NUMBER(TRIM(t."IMSTDT")) ELSE -1 END) AS dv_imstdt,
                     (CASE WHEN TRIM(t."IMDLUP") IS NULL OR REGEXP_LIKE(TRIM(t."IMDLUP"), '^[0 -]*$') THEN NULL
                       WHEN REGEXP_LIKE(TRIM(t."IMDLUP"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."IMDLUP") AS DATE, 'YYYYMMDD') = 1 AND TRIM(t."IMDLUP") &gt;= '19000101' THEN TO_NUMBER(TRIM(t."IMDLUP")) ELSE -1 END) AS dv_imdlup,
                     (CASE WHEN TRIM(t."IMSTTM") IS NOT NULL AND NOT REGEXP_LIKE(LPAD(TRIM(t."IMSTTM"), 6, '0'), '^([01][0-9]|2[0-3])[0-5][0-9][0-5][0-9]$') THEN 1 ELSE 0 END) AS tm_imsttm,
                     (CASE WHEN TRIM(t."IMTLUP") IS NOT NULL AND NOT REGEXP_LIKE(LPAD(TRIM(t."IMTLUP"), 6, '0'), '^([01][0-9]|2[0-3])[0-5][0-9][0-5][0-9]$') THEN 1 ELSE 0 END) AS tm_imtlup
                FROM DATACUT5."HUB_MT_IBCMINP" t
            ) s0
        ) s
        LEFT JOIN k_cus j1 ON j1.dcb = s.n_imdcb AND j1.dcs = s.n_imdcs
        LEFT JOIN k_pbn j2 ON j2.pbn = s.n_impbn
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'IBCMINP-001|Missing Data|Missing Internet Banking ID (IMIBID)',
        (t2, f2) AS 'IBCMINP-002|Missing Data|Missing customer serial (IMDCS)',
        (t3, f3) AS 'IBCMINP-003|Duplicates|Duplicate Internet Banking ID (IMIBID)',
        (t4, f4) AS 'IBCMINP-004|Missing Links|Customer (IMDCB+IMDCS) not found in SSCUSTP',
        (t5, f5) AS 'IBCMINP-005|Invalid Values|Not an integer value: Phone Banking Number (IMPBN)',
        (t6, f6) AS 'IBCMINP-006|Missing Links|Phone banking number (IMPBN) not found in EBCUSTP',
        (t7, f7) AS 'IBCMINP-007|Invalid Dates|Invalid date: Start Date (IMSTDT)',
        (t8, f8) AS 'IBCMINP-008|Invalid Dates|Invalid date: Last Update Date (IMDLUP)',
        (t9, f9) AS 'IBCMINP-009|Invalid Values|Invalid time: Start Time (IMSTTM)',
        (t10, f10) AS 'IBCMINP-010|Invalid Values|Invalid time: Time Last Updated (IMTLUP)',
        (t11, f11) AS 'IBCMINP-011|Missing Data|Missing HIB status (IMIFSS)'
      ))
    UNION ALL
/* =============================================================================
   SS@HCTP - Home Loans - Policy Certificates Master File
   Πίνακας: DATACUT5."HUB_MT_SS@HCTP"   Shadow: δεν υπάρχει mode flag   Έλεγχοι: 21
   Νέος πίνακας στο DD v1.24 (πιστοποιητικά ασφάλισης στεγαστικών).
   ============================================================================= */
    SELECT 'SS@HCTP - Home Loans - Policy Certificates Master File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- SS_HCTP-001: Missing certificate number (HCCTNO)
          COUNT(*) AS t1,
          COUNT(CASE WHEN TRIM(s."HCCTNO") IS NULL THEN 1 END) AS f1,
          -- SS_HCTP-002: Duplicate certificate number (HCCTNO)
          COUNT(CASE WHEN TRIM(s."HCCTNO") IS NOT NULL THEN 1 END) AS t2,
          COUNT(CASE WHEN TRIM(s."HCCTNO") IS NOT NULL AND s.dup_hcctno &gt; 1 THEN 1 END) AS f2,
          -- SS_HCTP-003: Certificate owner (HCOCB+HCOCS) not found in SSCUSTP
          COUNT(CASE WHEN NVL(s.n_hcocb, 0) &lt;&gt; 0 AND NVL(s.n_hcocs, 0) &lt;&gt; 0 THEN 1 END) AS t3,
          COUNT(CASE WHEN NVL(s.n_hcocb, 0) &lt;&gt; 0 AND NVL(s.n_hcocs, 0) &lt;&gt; 0 AND j1.dcb IS NULL THEN 1 END) AS f3,
          -- SS_HCTP-004: Borrower (HCBCB+HCBCS) not found in SSCUSTP
          COUNT(CASE WHEN NVL(s.n_hcbcb, 0) &lt;&gt; 0 AND NVL(s.n_hcbcs, 0) &lt;&gt; 0 THEN 1 END) AS t4,
          COUNT(CASE WHEN NVL(s.n_hcbcb, 0) &lt;&gt; 0 AND NVL(s.n_hcbcs, 0) &lt;&gt; 0 AND j2.dcb IS NULL THEN 1 END) AS f4,
          -- SS_HCTP-005: Missing borrower customer serial (HCBCS)
          COUNT(*) AS t5,
          COUNT(CASE WHEN NVL(s.n_hcbcs, 0) = 0 THEN 1 END) AS f5,
          -- SS_HCTP-006: Certificate Owner Country Code (HCOTCD) not in SSSTDPP CT (country code)
          COUNT(CASE WHEN TRIM(s."HCOTCD") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."HCOTCD"), '^[0. ]*$') THEN 1 END) AS t6,
          COUNT(CASE WHEN TRIM(s."HCOTCD") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."HCOTCD"), '^[0. ]*$') AND j3.code IS NULL THEN 1 END) AS f6,
          -- SS_HCTP-007: Borrower Country Code (HCBTCD) not in SSSTDPP CT (country code)
          COUNT(CASE WHEN TRIM(s."HCBTCD") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."HCBTCD"), '^[0. ]*$') THEN 1 END) AS t7,
          COUNT(CASE WHEN TRIM(s."HCBTCD") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."HCBTCD"), '^[0. ]*$') AND j4.code IS NULL THEN 1 END) AS f7,
          -- SS_HCTP-008: Currency (HCCYCD) not a valid ISO currency code (3 letters; SSCYIFP not in extract)
          COUNT(CASE WHEN TRIM(s."HCCYCD") IS NOT NULL THEN 1 END) AS t8,
          COUNT(CASE WHEN TRIM(s."HCCYCD") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."HCCYCD"), '^[A-Z]{3}$') THEN 1 END) AS f8,
          -- SS_HCTP-009: Invalid date: Certificate Date (HCCTDT)
          COUNT(*) AS t9,
          COUNT(CASE WHEN s.dv_hcctdt = -1 THEN 1 END) AS f9,
          -- SS_HCTP-010: Invalid date: Certificate End Date (HCCEDT)
          COUNT(*) AS t10,
          COUNT(CASE WHEN s.dv_hccedt = -1 THEN 1 END) AS f10,
          -- SS_HCTP-011: Invalid date: Paid Up To (HCPUTO)
          COUNT(*) AS t11,
          COUNT(CASE WHEN s.dv_hcputo = -1 THEN 1 END) AS f11,
          -- SS_HCTP-012: Invalid date: Original Date of Certificate (HCODTC)
          COUNT(*) AS t12,
          COUNT(CASE WHEN s.dv_hcodtc = -1 THEN 1 END) AS f12,
          -- SS_HCTP-013: Certificate end date before certificate date (HCCEDT &lt; HCCTDT)
          COUNT(CASE WHEN s.dv_hcctdt &gt; 0 AND s.dv_hccedt &gt; 0 THEN 1 END) AS t13,
          COUNT(CASE WHEN s.dv_hcctdt &gt; 0 AND s.dv_hccedt &gt; 0 AND s.dv_hccedt &lt; s.dv_hcctdt THEN 1 END) AS f13,
          -- SS_HCTP-014: Value not in (A/I): Certificate Status (HCCTST)
          COUNT(*) AS t14,
          COUNT(CASE WHEN NVL(TRIM(s."HCCTST"), '#') NOT IN ('A', 'I') THEN 1 END) AS f14,
          -- SS_HCTP-015: Value not in (H/C/κενό): System Held (HCSTHL)
          COUNT(CASE WHEN TRIM(s."HCSTHL") IS NOT NULL THEN 1 END) AS t15,
          COUNT(CASE WHEN TRIM(s."HCSTHL") IS NOT NULL AND TRIM(s."HCSTHL") NOT IN ('H', 'C') THEN 1 END) AS f15,
          -- SS_HCTP-016: Value not in (Y/N/κενό): Certificate Held (HCCTHD)
          COUNT(CASE WHEN TRIM(s."HCCTHD") IS NOT NULL THEN 1 END) AS t16,
          COUNT(CASE WHEN TRIM(s."HCCTHD") IS NOT NULL AND TRIM(s."HCCTHD") NOT IN ('Y', 'N') THEN 1 END) AS f16,
          -- SS_HCTP-017: Value not in (Y/N/κενό): Is Insured (HCISIN)
          COUNT(CASE WHEN TRIM(s."HCISIN") IS NOT NULL THEN 1 END) AS t17,
          COUNT(CASE WHEN TRIM(s."HCISIN") IS NOT NULL AND TRIM(s."HCISIN") NOT IN ('Y', 'N') THEN 1 END) AS f17,
          -- SS_HCTP-018: Negative value: Annual Premium (HCANPR)
          COUNT(CASE WHEN s.n_hcanpr IS NOT NULL THEN 1 END) AS t18,
          COUNT(CASE WHEN s.n_hcanpr &lt; 0 THEN 1 END) AS f18,
          -- SS_HCTP-019: Negative value: Sum Insured (HCSUMI)
          COUNT(CASE WHEN s.n_hcsumi IS NOT NULL THEN 1 END) AS t19,
          COUNT(CASE WHEN s.n_hcsumi &lt; 0 THEN 1 END) AS f19,
          -- SS_HCTP-020: Negative value: Present Value (HCPRVL)
          COUNT(CASE WHEN s.n_hcprvl IS NOT NULL THEN 1 END) AS t20,
          COUNT(CASE WHEN s.n_hcprvl &lt; 0 THEN 1 END) AS f20,
          -- SS_HCTP-021: Negative value: Term (years) (HCTERM)
          COUNT(CASE WHEN s.n_hcterm IS NOT NULL THEN 1 END) AS t21,
          COUNT(CASE WHEN s.n_hcterm &lt; 0 THEN 1 END) AS f21
        FROM (
          SELECT s0.*, COUNT(*) OVER (PARTITION BY TRIM(s0."HCCTNO")) AS dup_hcctno
            FROM (
              SELECT t."HCBTCD",
                     t."HCCTHD",
                     t."HCCTNO",
                     t."HCCTST",
                     t."HCCYCD",
                     t."HCISIN",
                     t."HCOTCD",
                     t."HCSTHL",
                     (CASE WHEN VALIDATE_CONVERSION(TRIM(t."HCOCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."HCOCB")) END) AS n_hcocb,
                     (CASE WHEN VALIDATE_CONVERSION(TRIM(t."HCOCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."HCOCS")) END) AS n_hcocs,
                     (CASE WHEN VALIDATE_CONVERSION(TRIM(t."HCBCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."HCBCB")) END) AS n_hcbcb,
                     (CASE WHEN VALIDATE_CONVERSION(TRIM(t."HCBCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."HCBCS")) END) AS n_hcbcs,
                     (CASE WHEN TRIM(t."HCCTDT") IS NULL OR REGEXP_LIKE(TRIM(t."HCCTDT"), '^[0 -]*$') THEN NULL
                       WHEN REGEXP_LIKE(TRIM(t."HCCTDT"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."HCCTDT") AS DATE, 'YYYYMMDD') = 1 AND TRIM(t."HCCTDT") &gt;= '19000101' THEN TO_NUMBER(TRIM(t."HCCTDT")) ELSE -1 END) AS dv_hcctdt,
                     (CASE WHEN TRIM(t."HCCEDT") IS NULL OR REGEXP_LIKE(TRIM(t."HCCEDT"), '^[0 -]*$') THEN NULL
                       WHEN REGEXP_LIKE(TRIM(t."HCCEDT"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."HCCEDT") AS DATE, 'YYYYMMDD') = 1 AND TRIM(t."HCCEDT") &gt;= '19000101' THEN TO_NUMBER(TRIM(t."HCCEDT")) ELSE -1 END) AS dv_hccedt,
                     (CASE WHEN TRIM(t."HCPUTO") IS NULL OR REGEXP_LIKE(TRIM(t."HCPUTO"), '^[0 -]*$') THEN NULL
                       WHEN REGEXP_LIKE(TRIM(t."HCPUTO"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."HCPUTO") AS DATE, 'YYYYMMDD') = 1 AND TRIM(t."HCPUTO") &gt;= '19000101' THEN TO_NUMBER(TRIM(t."HCPUTO")) ELSE -1 END) AS dv_hcputo,
                     (CASE WHEN TRIM(t."HCODTC") IS NULL OR REGEXP_LIKE(TRIM(t."HCODTC"), '^[0 -]*$') THEN NULL
                       WHEN REGEXP_LIKE(TRIM(t."HCODTC"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."HCODTC") AS DATE, 'YYYYMMDD') = 1 AND TRIM(t."HCODTC") &gt;= '19000101' THEN TO_NUMBER(TRIM(t."HCODTC")) ELSE -1 END) AS dv_hcodtc,
                     (CASE WHEN VALIDATE_CONVERSION(TRIM(t."HCANPR") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."HCANPR")) END) AS n_hcanpr,
                     (CASE WHEN VALIDATE_CONVERSION(TRIM(t."HCSUMI") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."HCSUMI")) END) AS n_hcsumi,
                     (CASE WHEN VALIDATE_CONVERSION(TRIM(t."HCPRVL") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."HCPRVL")) END) AS n_hcprvl,
                     (CASE WHEN VALIDATE_CONVERSION(TRIM(t."HCTERM") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."HCTERM")) END) AS n_hcterm
                FROM DATACUT5."HUB_MT_SS@HCTP" t
            ) s0
        ) s
        LEFT JOIN k_cus j1 ON j1.dcb = s.n_hcocb AND j1.dcs = s.n_hcocs
        LEFT JOIN k_cus j2 ON j2.dcb = s.n_hcbcb AND j2.dcs = s.n_hcbcs
        LEFT JOIN ref_std_ct j3 ON j3.code = NVL(LTRIM(TRIM(s."HCOTCD"), '0'), '0')
        LEFT JOIN ref_std_ct j4 ON j4.code = NVL(LTRIM(TRIM(s."HCBTCD"), '0'), '0')
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'SS_HCTP-001|Missing Data|Missing certificate number (HCCTNO)',
        (t2, f2) AS 'SS_HCTP-002|Duplicates|Duplicate certificate number (HCCTNO)',
        (t3, f3) AS 'SS_HCTP-003|Missing Links|Certificate owner (HCOCB+HCOCS) not found in SSCUSTP',
        (t4, f4) AS 'SS_HCTP-004|Missing Links|Borrower (HCBCB+HCBCS) not found in SSCUSTP',
        (t5, f5) AS 'SS_HCTP-005|Missing Data|Missing borrower customer serial (HCBCS)',
        (t6, f6) AS 'SS_HCTP-006|Invalid Values|Certificate Owner Country Code (HCOTCD) not in SSSTDPP CT (country code)',
        (t7, f7) AS 'SS_HCTP-007|Invalid Values|Borrower Country Code (HCBTCD) not in SSSTDPP CT (country code)',
        (t8, f8) AS 'SS_HCTP-008|Format|Currency (HCCYCD) not a valid ISO currency code (3 letters; SSCYIFP not in extract)',
        (t9, f9) AS 'SS_HCTP-009|Invalid Dates|Invalid date: Certificate Date (HCCTDT)',
        (t10, f10) AS 'SS_HCTP-010|Invalid Dates|Invalid date: Certificate End Date (HCCEDT)',
        (t11, f11) AS 'SS_HCTP-011|Invalid Dates|Invalid date: Paid Up To (HCPUTO)',
        (t12, f12) AS 'SS_HCTP-012|Invalid Dates|Invalid date: Original Date of Certificate (HCODTC)',
        (t13, f13) AS 'SS_HCTP-013|Inconsistent Data|Certificate end date before certificate date (HCCEDT &lt; HCCTDT)',
        (t14, f14) AS 'SS_HCTP-014|Invalid Values|Value not in (A/I): Certificate Status (HCCTST)',
        (t15, f15) AS 'SS_HCTP-015|Invalid Values|Value not in (H/C/κενό): System Held (HCSTHL)',
        (t16, f16) AS 'SS_HCTP-016|Invalid Values|Value not in (Y/N/κενό): Certificate Held (HCCTHD)',
        (t17, f17) AS 'SS_HCTP-017|Invalid Values|Value not in (Y/N/κενό): Is Insured (HCISIN)',
        (t18, f18) AS 'SS_HCTP-018|Invalid Values|Negative value: Annual Premium (HCANPR)',
        (t19, f19) AS 'SS_HCTP-019|Invalid Values|Negative value: Sum Insured (HCSUMI)',
        (t20, f20) AS 'SS_HCTP-020|Invalid Values|Negative value: Present Value (HCPRVL)',
        (t21, f21) AS 'SS_HCTP-021|Invalid Values|Negative value: Term (years) (HCTERM)'
      ))
    UNION ALL
/* =============================================================================
   SS@HLDP - Holds File
   Πίνακας: DATACUT5."HUB_MT_SS@HLDP"   Shadow: δεν υπάρχει mode flag   Έλεγχοι: 7
   Νέος πίνακας στο DD v1.24 (holds σε λογαριασμούς).
   ============================================================================= */
    SELECT 'SS@HLDP - Holds File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- SS_HLDP-001: Missing account serial (IHACS)
          COUNT(*) AS t1,
          COUNT(CASE WHEN NVL(s.n_ihacs, 0) = 0 THEN 1 END) AS f1,
          -- SS_HLDP-002: Account (IHACB+IHACS+IHACX) not found in any account master (DD/LS/TD/PL/DC/IE/GL ACMSP)
          COUNT(CASE WHEN NVL(s.n_ihacs, 0) &lt;&gt; 0 THEN 1 END) AS t2,
          COUNT(CASE WHEN NVL(s.n_ihacs, 0) &lt;&gt; 0 AND j1.k1 IS NULL THEN 1 END) AS f2,
          -- SS_HLDP-003: Hold amount zero or negative (IHHDAM)
          COUNT(*) AS t3,
          COUNT(CASE WHEN NVL(s.n_ihhdam, 0) &lt;= 0 THEN 1 END) AS f3,
          -- SS_HLDP-004: Invalid date: Capture Date (IHCPDT)
          COUNT(*) AS t4,
          COUNT(CASE WHEN s.dv_ihcpdt = -1 THEN 1 END) AS f4,
          -- SS_HLDP-005: Invalid date: Value Date (IHVLDT)
          COUNT(*) AS t5,
          COUNT(CASE WHEN s.dv_ihvldt = -1 THEN 1 END) AS f5,
          -- SS_HLDP-006: Invalid date: Last Update Date (IHDLUP)
          COUNT(*) AS t6,
          COUNT(CASE WHEN s.dv_ihdlup = -1 THEN 1 END) AS f6,
          -- SS_HLDP-007: Invalid time: Last Update Time (IHTLUP)
          COUNT(*) AS t7,
          COUNT(CASE WHEN s.tm_ihtlup = 1 THEN 1 END) AS f7
        FROM (
              SELECT (CASE WHEN VALIDATE_CONVERSION(TRIM(t."IHACB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."IHACB")) END) AS n_ihacb,
                     (CASE WHEN VALIDATE_CONVERSION(TRIM(t."IHACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."IHACS")) END) AS n_ihacs,
                     (CASE WHEN VALIDATE_CONVERSION(TRIM(t."IHACX") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."IHACX")) END) AS n_ihacx,
                     (CASE WHEN VALIDATE_CONVERSION(TRIM(t."IHHDAM") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."IHHDAM")) END) AS n_ihhdam,
                     (CASE WHEN TRIM(t."IHCPDT") IS NULL OR REGEXP_LIKE(TRIM(t."IHCPDT"), '^[0 -]*$') THEN NULL
                       WHEN REGEXP_LIKE(TRIM(t."IHCPDT"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."IHCPDT") AS DATE, 'YYYYMMDD') = 1 AND TRIM(t."IHCPDT") &gt;= '19000101' THEN TO_NUMBER(TRIM(t."IHCPDT")) ELSE -1 END) AS dv_ihcpdt,
                     (CASE WHEN TRIM(t."IHVLDT") IS NULL OR REGEXP_LIKE(TRIM(t."IHVLDT"), '^[0 -]*$') THEN NULL
                       WHEN REGEXP_LIKE(TRIM(t."IHVLDT"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."IHVLDT") AS DATE, 'YYYYMMDD') = 1 AND TRIM(t."IHVLDT") &gt;= '19000101' THEN TO_NUMBER(TRIM(t."IHVLDT")) ELSE -1 END) AS dv_ihvldt,
                     (CASE WHEN TRIM(t."IHDLUP") IS NULL OR REGEXP_LIKE(TRIM(t."IHDLUP"), '^[0 -]*$') THEN NULL
                       WHEN REGEXP_LIKE(TRIM(t."IHDLUP"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."IHDLUP") AS DATE, 'YYYYMMDD') = 1 AND TRIM(t."IHDLUP") &gt;= '19000101' THEN TO_NUMBER(TRIM(t."IHDLUP")) ELSE -1 END) AS dv_ihdlup,
                     (CASE WHEN TRIM(t."IHTLUP") IS NOT NULL AND NOT REGEXP_LIKE(LPAD(TRIM(t."IHTLUP"), 6, '0'), '^([01][0-9]|2[0-3])[0-5][0-9][0-5][0-9]$') THEN 1 ELSE 0 END) AS tm_ihtlup
                FROM DATACUT5."HUB_MT_SS@HLDP" t
        ) s
        LEFT JOIN k_acc j1 ON j1.k1 = s.n_ihacb AND j1.k2 = s.n_ihacs AND j1.k3 = s.n_ihacx
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'SS_HLDP-001|Missing Data|Missing account serial (IHACS)',
        (t2, f2) AS 'SS_HLDP-002|Missing Links|Account (IHACB+IHACS+IHACX) not found in any account master (DD/LS/TD/PL/DC/IE/GL ACMSP)',
        (t3, f3) AS 'SS_HLDP-003|Invalid Values|Hold amount zero or negative (IHHDAM)',
        (t4, f4) AS 'SS_HLDP-004|Invalid Dates|Invalid date: Capture Date (IHCPDT)',
        (t5, f5) AS 'SS_HLDP-005|Invalid Dates|Invalid date: Value Date (IHVLDT)',
        (t6, f6) AS 'SS_HLDP-006|Invalid Dates|Invalid date: Last Update Date (IHDLUP)',
        (t7, f7) AS 'SS_HLDP-007|Invalid Values|Invalid time: Last Update Time (IHTLUP)'
      ))
    UNION ALL
/* =============================================================================
   SS@HMGP - Home Loans - Property Valuation Percentage Margins
   Πίνακας: DATACUT5."HUB_MT_SS@HMGP"   Shadow: δεν υπάρχει mode flag   Έλεγχοι: 8
   Νέος πίνακας στο DD v1.24 (περιθώρια αποτίμησης ακινήτων, ποσοστά).
   ============================================================================= */
    SELECT 'SS@HMGP - Home Loans - Property Valuation Percentage Margins' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- SS_HMGP-001: Invalid date: Start Date (MGSTDT)
          COUNT(*) AS t1,
          COUNT(CASE WHEN s.dv_mgstdt = -1 THEN 1 END) AS f1,
          -- SS_HMGP-002: Invalid date: End Date (MGEDDT)
          COUNT(*) AS t2,
          COUNT(CASE WHEN s.dv_mgeddt = -1 THEN 1 END) AS f2,
          -- SS_HMGP-003: End date before start date (MGEDDT &lt; MGSTDT)
          COUNT(CASE WHEN s.dv_mgstdt &gt; 0 AND s.dv_mgeddt &gt; 0 THEN 1 END) AS t3,
          COUNT(CASE WHEN s.dv_mgstdt &gt; 0 AND s.dv_mgeddt &gt; 0 AND s.dv_mgeddt &lt; s.dv_mgstdt THEN 1 END) AS f3,
          -- SS_HMGP-004: Value outside 0-100: TYPE P0 margin % (MGTYP0)
          COUNT(CASE WHEN s.n_mgtyp0 IS NOT NULL THEN 1 END) AS t4,
          COUNT(CASE WHEN s.n_mgtyp0 &lt; 0 OR s.n_mgtyp0 &gt; 100 THEN 1 END) AS f4,
          -- SS_HMGP-005: Value outside 0-100: TYPE P1 margin % (MGTYP1)
          COUNT(CASE WHEN s.n_mgtyp1 IS NOT NULL THEN 1 END) AS t5,
          COUNT(CASE WHEN s.n_mgtyp1 &lt; 0 OR s.n_mgtyp1 &gt; 100 THEN 1 END) AS f5,
          -- SS_HMGP-006: Value outside 0-100: TYPE P2 margin % (MGTYP2)
          COUNT(CASE WHEN s.n_mgtyp2 IS NOT NULL THEN 1 END) AS t6,
          COUNT(CASE WHEN s.n_mgtyp2 &lt; 0 OR s.n_mgtyp2 &gt; 100 THEN 1 END) AS f6,
          -- SS_HMGP-007: Value outside 0-100: TYPE P3 margin % (MGTYP3)
          COUNT(CASE WHEN s.n_mgtyp3 IS NOT NULL THEN 1 END) AS t7,
          COUNT(CASE WHEN s.n_mgtyp3 &lt; 0 OR s.n_mgtyp3 &gt; 100 THEN 1 END) AS f7,
          -- SS_HMGP-008: Value outside 0-100: TYPE P4 margin % (MGTYP4)
          COUNT(CASE WHEN s.n_mgtyp4 IS NOT NULL THEN 1 END) AS t8,
          COUNT(CASE WHEN s.n_mgtyp4 &lt; 0 OR s.n_mgtyp4 &gt; 100 THEN 1 END) AS f8
        FROM (
              SELECT (CASE WHEN TRIM(t."MGSTDT") IS NULL OR REGEXP_LIKE(TRIM(t."MGSTDT"), '^[0 -]*$') THEN NULL
                       WHEN REGEXP_LIKE(TRIM(t."MGSTDT"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."MGSTDT") AS DATE, 'YYYYMMDD') = 1 AND TRIM(t."MGSTDT") &gt;= '19000101' THEN TO_NUMBER(TRIM(t."MGSTDT")) ELSE -1 END) AS dv_mgstdt,
                     (CASE WHEN TRIM(t."MGEDDT") IS NULL OR REGEXP_LIKE(TRIM(t."MGEDDT"), '^[0 -]*$') THEN NULL
                       WHEN REGEXP_LIKE(TRIM(t."MGEDDT"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."MGEDDT") AS DATE, 'YYYYMMDD') = 1 AND TRIM(t."MGEDDT") &gt;= '19000101' THEN TO_NUMBER(TRIM(t."MGEDDT")) ELSE -1 END) AS dv_mgeddt,
                     (CASE WHEN VALIDATE_CONVERSION(TRIM(t."MGTYP0") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."MGTYP0")) END) AS n_mgtyp0,
                     (CASE WHEN VALIDATE_CONVERSION(TRIM(t."MGTYP1") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."MGTYP1")) END) AS n_mgtyp1,
                     (CASE WHEN VALIDATE_CONVERSION(TRIM(t."MGTYP2") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."MGTYP2")) END) AS n_mgtyp2,
                     (CASE WHEN VALIDATE_CONVERSION(TRIM(t."MGTYP3") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."MGTYP3")) END) AS n_mgtyp3,
                     (CASE WHEN VALIDATE_CONVERSION(TRIM(t."MGTYP4") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."MGTYP4")) END) AS n_mgtyp4
                FROM DATACUT5."HUB_MT_SS@HMGP" t
        ) s
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'SS_HMGP-001|Invalid Dates|Invalid date: Start Date (MGSTDT)',
        (t2, f2) AS 'SS_HMGP-002|Invalid Dates|Invalid date: End Date (MGEDDT)',
        (t3, f3) AS 'SS_HMGP-003|Inconsistent Data|End date before start date (MGEDDT &lt; MGSTDT)',
        (t4, f4) AS 'SS_HMGP-004|Invalid Values|Value outside 0-100: TYPE P0 margin % (MGTYP0)',
        (t5, f5) AS 'SS_HMGP-005|Invalid Values|Value outside 0-100: TYPE P1 margin % (MGTYP1)',
        (t6, f6) AS 'SS_HMGP-006|Invalid Values|Value outside 0-100: TYPE P2 margin % (MGTYP2)',
        (t7, f7) AS 'SS_HMGP-007|Invalid Values|Value outside 0-100: TYPE P3 margin % (MGTYP3)',
        (t8, f8) AS 'SS_HMGP-008|Invalid Values|Value outside 0-100: TYPE P4 margin % (MGTYP4)'
      ))
    UNION ALL
/* =============================================================================
   SS@RPTP - REGISTERED PROPERTY TABLE FILE
   Πίνακας: DATACUT5."HUB_MT_SS@RPTP"   Shadow: δεν υπάρχει mode flag   Έλεγχοι: 3
   Νέος πίνακας στο DD v1.24 (πίνακας τύπων ακινήτου, reference data).
   ============================================================================= */
    SELECT 'SS@RPTP - REGISTERED PROPERTY TABLE FILE' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- SS_RPTP-001: Missing record code (TBCODE)
          COUNT(*) AS t1,
          COUNT(CASE WHEN TRIM(s."TBCODE") IS NULL THEN 1 END) AS f1,
          -- SS_RPTP-002: Missing description (TBDS35)
          COUNT(*) AS t2,
          COUNT(CASE WHEN TRIM(s."TBDS35") IS NULL THEN 1 END) AS f2,
          -- SS_RPTP-003: Duplicate table id + record code (TBTBID+TBCODE)
          COUNT(CASE WHEN TRIM(s."TBTBID") IS NOT NULL AND TRIM(s."TBCODE") IS NOT NULL THEN 1 END) AS t3,
          COUNT(CASE WHEN TRIM(s."TBTBID") IS NOT NULL AND TRIM(s."TBCODE") IS NOT NULL AND s.dup_tbtbid_tbcode &gt; 1 THEN 1 END) AS f3
        FROM (
          SELECT s0.*, COUNT(*) OVER (PARTITION BY TRIM(s0."TBTBID"), TRIM(s0."TBCODE")) AS dup_tbtbid_tbcode
            FROM (
              SELECT t."TBCODE",
                     t."TBDS35",
                     t."TBTBID"
                FROM DATACUT5."HUB_MT_SS@RPTP" t
            ) s0
        ) s
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'SS_RPTP-001|Missing Data|Missing record code (TBCODE)',
        (t2, f2) AS 'SS_RPTP-002|Missing Data|Missing description (TBDS35)',
        (t3, f3) AS 'SS_RPTP-003|Duplicates|Duplicate table id + record code (TBTBID+TBCODE)'
      ))
    UNION ALL
/* =============================================================================
   SSCLGHP - Clearing Hold Summary File
   Πίνακας: DATACUT5."HUB_MT_SSCLGHP"   Shadow: δεν υπάρχει mode flag   Έλεγχοι: 4
   Νέος πίνακας στο DD v1.24 (clearing holds ανά λογαριασμό).
   ============================================================================= */
    SELECT 'SSCLGHP - Clearing Hold Summary File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- SSCLGHP-001: Missing account serial (UYACS)
          COUNT(*) AS t1,
          COUNT(CASE WHEN NVL(s.n_uyacs, 0) = 0 THEN 1 END) AS f1,
          -- SSCLGHP-002: Account (UYACB+UYACS+UYACX) not found in any account master (DD/LS/TD/PL/DC/IE/GL ACMSP)
          COUNT(CASE WHEN NVL(s.n_uyacs, 0) &lt;&gt; 0 THEN 1 END) AS t2,
          COUNT(CASE WHEN NVL(s.n_uyacs, 0) &lt;&gt; 0 AND j1.k1 IS NULL THEN 1 END) AS f2,
          -- SSCLGHP-003: Duplicate account + system code (UYACB+UYACS+UYACX+UYSSCD)
          COUNT(CASE WHEN TRIM(s."UYACB") IS NOT NULL AND TRIM(s."UYACS") IS NOT NULL AND TRIM(s."UYACX") IS NOT NULL AND TRIM(s."UYSSCD") IS NOT NULL THEN 1 END) AS t3,
          COUNT(CASE WHEN TRIM(s."UYACB") IS NOT NULL AND TRIM(s."UYACS") IS NOT NULL AND TRIM(s."UYACX") IS NOT NULL AND TRIM(s."UYSSCD") IS NOT NULL AND s.dup_uyacb_uyacs_uyacx_uysscd &gt; 1 THEN 1 END) AS f3,
          -- SSCLGHP-004: Negative value: Clearing hold value (UYCHVN)
          COUNT(CASE WHEN s.n_uychvn IS NOT NULL THEN 1 END) AS t4,
          COUNT(CASE WHEN s.n_uychvn &lt; 0 THEN 1 END) AS f4
        FROM (
          SELECT s0.*, COUNT(*) OVER (PARTITION BY TRIM(s0."UYACB"), TRIM(s0."UYACS"), TRIM(s0."UYACX"), TRIM(s0."UYSSCD")) AS dup_uyacb_uyacs_uyacx_uysscd
            FROM (
              SELECT t."UYACB",
                     t."UYACS",
                     t."UYACX",
                     t."UYSSCD",
                     (CASE WHEN VALIDATE_CONVERSION(TRIM(t."UYACB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."UYACB")) END) AS n_uyacb,
                     (CASE WHEN VALIDATE_CONVERSION(TRIM(t."UYACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."UYACS")) END) AS n_uyacs,
                     (CASE WHEN VALIDATE_CONVERSION(TRIM(t."UYACX") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."UYACX")) END) AS n_uyacx,
                     (CASE WHEN VALIDATE_CONVERSION(TRIM(t."UYCHVN") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."UYCHVN")) END) AS n_uychvn
                FROM DATACUT5."HUB_MT_SSCLGHP" t
            ) s0
        ) s
        LEFT JOIN k_acc j1 ON j1.k1 = s.n_uyacb AND j1.k2 = s.n_uyacs AND j1.k3 = s.n_uyacx
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'SSCLGHP-001|Missing Data|Missing account serial (UYACS)',
        (t2, f2) AS 'SSCLGHP-002|Missing Links|Account (UYACB+UYACS+UYACX) not found in any account master (DD/LS/TD/PL/DC/IE/GL ACMSP)',
        (t3, f3) AS 'SSCLGHP-003|Duplicates|Duplicate account + system code (UYACB+UYACS+UYACX+UYSSCD)',
        (t4, f4) AS 'SSCLGHP-004|Invalid Values|Negative value: Clearing hold value (UYCHVN)'
      ))
    UNION ALL
/* =============================================================================
   SS@PDFP - PAD Statement Final Transmission File
   Πίνακας: DATACUT5."HUB_MT_SS@PDFP"   Shadow: δεν υπάρχει mode flag   Έλεγχοι: 2
   Υπάρχων πίνακας: το PDPPBN άλλαξε από String σε Integer (format 9999999999) στο DD v1.24.
   ============================================================================= */
    SELECT 'SS@PDFP - PAD Statement Final Transmission File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- SS_PDFP-501: Not an integer value: Phone Banking Number (PDPPBN)
          COUNT(CASE WHEN TRIM(s."PDPPBN") IS NOT NULL THEN 1 END) AS t1,
          COUNT(CASE WHEN TRIM(s."PDPPBN") IS NOT NULL AND (VALIDATE_CONVERSION(TRIM(s."PDPPBN") AS NUMBER) = 0 OR s.n_pdppbn &lt;&gt; TRUNC(s.n_pdppbn)) THEN 1 END) AS f1,
          -- SS_PDFP-502: Phone banking number (PDPPBN) not found in EBCUSTP
          COUNT(CASE WHEN NVL(s.n_pdppbn, 0) &lt;&gt; 0 THEN 1 END) AS t2,
          COUNT(CASE WHEN NVL(s.n_pdppbn, 0) &lt;&gt; 0 AND j1.pbn IS NULL THEN 1 END) AS f2
        FROM (
              SELECT t."PDPPBN",
                     (CASE WHEN VALIDATE_CONVERSION(TRIM(t."PDPPBN") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."PDPPBN")) END) AS n_pdppbn
                FROM DATACUT5."HUB_MT_SS@PDFP" t
        ) s
        LEFT JOIN k_pbn j1 ON j1.pbn = s.n_pdppbn
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'SS_PDFP-501|Invalid Values|Not an integer value: Phone Banking Number (PDPPBN)',
        (t2, f2) AS 'SS_PDFP-502|Missing Links|Phone banking number (PDPPBN) not found in EBCUSTP'
      ))
    UNION ALL
/* =============================================================================
   SSGPNMP - Customer Group Name File
   Πίνακας: DATACUT5."HUB_MT_SSGPNMP"   Shadow: ZPMDFL = 'S' (εξαιρούνται)   Έλεγχοι: 2
   Υπάρχων πίνακας: το πεδίο "SSCUSTP" του DC4 διορθώθηκε σε ZPCGC στο DD v1.24.
   Κανόνας DD: ZPCGC + ZPCGG + ZPCGB + ZPCGS πρέπει να υπάρχει στο SSCUSTP.
   ============================================================================= */
    SELECT 'SSGPNMP - Customer Group Name File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- SSGPNMP-501: Missing customer group country code (ZPCGC)
          COUNT(*) AS t1,
          COUNT(CASE WHEN TRIM(s."ZPCGC") IS NULL THEN 1 END) AS f1,
          -- SSGPNMP-502: Group customer (ZPCGB+ZPCGS) not found in SSCUSTP
          COUNT(CASE WHEN NVL(s.n_zpcgb, 0) &lt;&gt; 0 AND NVL(s.n_zpcgs, 0) &lt;&gt; 0 THEN 1 END) AS t2,
          COUNT(CASE WHEN NVL(s.n_zpcgb, 0) &lt;&gt; 0 AND NVL(s.n_zpcgs, 0) &lt;&gt; 0 AND j1.dcb IS NULL THEN 1 END) AS f2
        FROM (
              SELECT t."ZPCGC",
                     (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZPCGB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZPCGB")) END) AS n_zpcgb,
                     (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZPCGS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZPCGS")) END) AS n_zpcgs
                FROM DATACUT5."HUB_MT_SSGPNMP" t
               WHERE NVL(t."ZPMDFL",' ') &lt;&gt; 'S'
        ) s
        LEFT JOIN k_cus j1 ON j1.dcb = s.n_zpcgb AND j1.dcs = s.n_zpcgs
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'SSGPNMP-501|Missing Data|Missing customer group country code (ZPCGC)',
        (t2, f2) AS 'SSGPNMP-502|Missing Links|Group customer (ZPCGB+ZPCGS) not found in SSCUSTP'
      ))
    UNION ALL
/* ################ DC5 μέρος 2: κανόνες Free column (DD v1.24) ################ */
/* =============================================================================
   AFSIADP - S/I Asso Party Non-Cust Name/Add File
   Πίνακας: DATACUT5."HUB_MT_AFSIADP"   Shadow: FRMDFL = 'S' (εξαιρούνται)   Έλεγχοι: 3
   Έλεγχοι από τους κανόνες της στήλης Free column του DD v1.24.
   ============================================================================= */
    SELECT 'AFSIADP - S/I Asso Party Non-Cust Name/Add File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- AFSIADP-501: Primary party account (FRPPAB+FRPPAS+FRPPAX) not found in DDACMSP
          COUNT(CASE WHEN NVL(s.n_frppas, 0) &lt;&gt; 0 THEN 1 END) AS t1,
          COUNT(CASE WHEN NVL(s.n_frppas, 0) &lt;&gt; 0 AND j1.k1 IS NULL THEN 1 END) AS f1,
          -- AFSIADP-502: Destination Country Code (FRCTCM) not in SSSTDPP CT (country code)
          COUNT(CASE WHEN TRIM(s."FRCTCM") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."FRCTCM"), '^[0. ]*$') THEN 1 END) AS t2,
          COUNT(CASE WHEN TRIM(s."FRCTCM") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."FRCTCM"), '^[0. ]*$') AND j2.code IS NULL THEN 1 END) AS f2,
          -- AFSIADP-503: Intermediary Bank Country (FRIBCT) not in SSSTDPP CT (country code)
          COUNT(CASE WHEN TRIM(s."FRIBCT") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."FRIBCT"), '^[0. ]*$') THEN 1 END) AS t3,
          COUNT(CASE WHEN TRIM(s."FRIBCT") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."FRIBCT"), '^[0. ]*$') AND j3.code IS NULL THEN 1 END) AS f3
        FROM (
              SELECT t."FRCTCM",
                     t."FRIBCT",
                     (CASE WHEN VALIDATE_CONVERSION(TRIM(t."FRPPAB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."FRPPAB")) END) AS n_frppab,
                     (CASE WHEN VALIDATE_CONVERSION(TRIM(t."FRPPAS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."FRPPAS")) END) AS n_frppas,
                     (CASE WHEN VALIDATE_CONVERSION(TRIM(t."FRPPAX") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."FRPPAX")) END) AS n_frppax
                FROM DATACUT5."HUB_MT_AFSIADP" t
               WHERE NVL(t."FRMDFL",' ') &lt;&gt; 'S'
        ) s
        LEFT JOIN k_acc_dd j1 ON j1.k1 = s.n_frppab AND j1.k2 = s.n_frppas AND j1.k3 = s.n_frppax
        LEFT JOIN ref_std_ct j2 ON j2.code = NVL(LTRIM(TRIM(s."FRCTCM"), '0'), '0')
        LEFT JOIN ref_std_ct j3 ON j3.code = NVL(LTRIM(TRIM(s."FRIBCT"), '0'), '0')
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'AFSIADP-501|Missing Links|Primary party account (FRPPAB+FRPPAS+FRPPAX) not found in DDACMSP',
        (t2, f2) AS 'AFSIADP-502|Invalid Values|Destination Country Code (FRCTCM) not in SSSTDPP CT (country code)',
        (t3, f3) AS 'AFSIADP-503|Invalid Values|Intermediary Bank Country (FRIBCT) not in SSSTDPP CT (country code)'
      ))
    UNION ALL
/* =============================================================================
   AFSIMSP - S/I Master File
   Πίνακας: DATACUT5."HUB_MT_AFSIMSP"   Shadow: FNMDFL = 'S' (εξαιρούνται)   Έλεγχοι: 6
   Έλεγχοι από τους κανόνες της στήλης Free column του DD v1.24.
   ============================================================================= */
    SELECT 'AFSIMSP - S/I Master File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- AFSIMSP-501: Primary party account (FNPPAB+FNPPAS+FNPPAX) not found in DDACMSP
          COUNT(CASE WHEN NVL(s.n_fnppas, 0) &lt;&gt; 0 THEN 1 END) AS t1,
          COUNT(CASE WHEN NVL(s.n_fnppas, 0) &lt;&gt; 0 AND j1.k1 IS NULL THEN 1 END) AS f1,
          -- AFSIMSP-502: Currency (FNCYCD) not a valid ISO currency code (3 letters; SSCYIFP not in extract)
          COUNT(CASE WHEN TRIM(s."FNCYCD") IS NOT NULL THEN 1 END) AS t2,
          COUNT(CASE WHEN TRIM(s."FNCYCD") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."FNCYCD"), '^[A-Z]{3}$') THEN 1 END) AS f2,
          -- AFSIMSP-503: Phone banking number (FNPBN) not found in EBCUSTP
          COUNT(CASE WHEN NVL(s.n_fnpbn, 0) &lt;&gt; 0 THEN 1 END) AS t3,
          COUNT(CASE WHEN NVL(s.n_fnpbn, 0) &lt;&gt; 0 AND j2.pbn IS NULL THEN 1 END) AS f3,
          -- AFSIMSP-504: Phone banking number (FNRPBN) not found in EBCUSTP
          COUNT(CASE WHEN NVL(s.n_fnrpbn, 0) &lt;&gt; 0 THEN 1 END) AS t4,
          COUNT(CASE WHEN NVL(s.n_fnrpbn, 0) &lt;&gt; 0 AND j3.pbn IS NULL THEN 1 END) AS f4,
          -- AFSIMSP-505: Branch (FNAD1B) not found in SSBRCPP
          COUNT(CASE WHEN NVL(s.n_fnad1b, 0) &lt;&gt; 0 THEN 1 END) AS t5,
          COUNT(CASE WHEN NVL(s.n_fnad1b, 0) &lt;&gt; 0 AND j4.brn IS NULL THEN 1 END) AS f5,
          -- AFSIMSP-506: Product type (FNAPTY) not found in any PDCPP (DD/TD/LS/PL/DC)
          COUNT(CASE WHEN TRIM(s."FNAPTY") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."FNAPTY"), '^[0. ]*$') THEN 1 END) AS t6,
          COUNT(CASE WHEN TRIM(s."FNAPTY") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."FNAPTY"), '^[0. ]*$') AND j5.code IS NULL THEN 1 END) AS f6
        FROM (
              SELECT t."FNAPTY",
                     t."FNCYCD",
                     (CASE WHEN VALIDATE_CONVERSION(TRIM(t."FNPPAB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."FNPPAB")) END) AS n_fnppab,
                     (CASE WHEN VALIDATE_CONVERSION(TRIM(t."FNPPAS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."FNPPAS")) END) AS n_fnppas,
                     (CASE WHEN VALIDATE_CONVERSION(TRIM(t."FNPPAX") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."FNPPAX")) END) AS n_fnppax,
                     (CASE WHEN VALIDATE_CONVERSION(TRIM(t."FNPBN") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."FNPBN")) END) AS n_fnpbn,
                     (CASE WHEN VALIDATE_CONVERSION(TRIM(t."FNRPBN") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."FNRPBN")) END) AS n_fnrpbn,
                     (CASE WHEN VALIDATE_CONVERSION(TRIM(t."FNAD1B") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."FNAD1B")) END) AS n_fnad1b
                FROM DATACUT5."HUB_MT_AFSIMSP" t
               WHERE NVL(t."FNMDFL",' ') &lt;&gt; 'S'
        ) s
        LEFT JOIN k_acc_dd j1 ON j1.k1 = s.n_fnppab AND j1.k2 = s.n_fnppas AND j1.k3 = s.n_fnppax
        LEFT JOIN k_pbn j2 ON j2.pbn = s.n_fnpbn
        LEFT JOIN k_pbn j3 ON j3.pbn = s.n_fnrpbn
        LEFT JOIN k_brn j4 ON j4.brn = s.n_fnad1b
        LEFT JOIN ref_apty j5 ON j5.code = TRIM(s."FNAPTY")
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'AFSIMSP-501|Missing Links|Primary party account (FNPPAB+FNPPAS+FNPPAX) not found in DDACMSP',
        (t2, f2) AS 'AFSIMSP-502|Format|Currency (FNCYCD) not a valid ISO currency code (3 letters; SSCYIFP not in extract)',
        (t3, f3) AS 'AFSIMSP-503|Missing Links|Phone banking number (FNPBN) not found in EBCUSTP',
        (t4, f4) AS 'AFSIMSP-504|Missing Links|Phone banking number (FNRPBN) not found in EBCUSTP',
        (t5, f5) AS 'AFSIMSP-505|Missing Links|Branch (FNAD1B) not found in SSBRCPP',
        (t6, f6) AS 'AFSIMSP-506|Missing Links|Product type (FNAPTY) not found in any PDCPP (DD/TD/LS/PL/DC)'
      ))
    UNION ALL
/* =============================================================================
   AFSIRAP - S/I Retention Amount File
   Πίνακας: DATACUT5."HUB_MT_AFSIRAP"   Shadow: FTMDFL = 'S' (εξαιρούνται)   Έλεγχοι: 1
   Έλεγχοι από τους κανόνες της στήλης Free column του DD v1.24.
   ============================================================================= */
    SELECT 'AFSIRAP - S/I Retention Amount File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- AFSIRAP-501: Primary party account (FTPPAB+FTPPAS+FTPPAX) not found in DDACMSP
          COUNT(CASE WHEN NVL(s.n_ftppas, 0) &lt;&gt; 0 THEN 1 END) AS t1,
          COUNT(CASE WHEN NVL(s.n_ftppas, 0) &lt;&gt; 0 AND j1.k1 IS NULL THEN 1 END) AS f1
        FROM (
              SELECT (CASE WHEN VALIDATE_CONVERSION(TRIM(t."FTPPAB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."FTPPAB")) END) AS n_ftppab,
                     (CASE WHEN VALIDATE_CONVERSION(TRIM(t."FTPPAS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."FTPPAS")) END) AS n_ftppas,
                     (CASE WHEN VALIDATE_CONVERSION(TRIM(t."FTPPAX") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."FTPPAX")) END) AS n_ftppax
                FROM DATACUT5."HUB_MT_AFSIRAP" t
               WHERE NVL(t."FTMDFL",' ') &lt;&gt; 'S'
        ) s
        LEFT JOIN k_acc_dd j1 ON j1.k1 = s.n_ftppab AND j1.k2 = s.n_ftppas AND j1.k3 = s.n_ftppax
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'AFSIRAP-501|Missing Links|Primary party account (FTPPAB+FTPPAS+FTPPAX) not found in DDACMSP'
      ))
    UNION ALL
/* =============================================================================
   AFSITJP - S/I Transaction Journal
   Πίνακας: DATACUT5."HUB_MT_AFSITJP"   Shadow: δεν υπάρχει mode flag   Έλεγχοι: 5
   Έλεγχοι από τους κανόνες της στήλης Free column του DD v1.24.
   ============================================================================= */
    SELECT 'AFSITJP - S/I Transaction Journal' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- AFSITJP-501: Primary party account (F0PPAB+F0PPAS+F0PPAX) not found in DDACMSP
          COUNT(CASE WHEN NVL(s.n_f0ppas, 0) &lt;&gt; 0 THEN 1 END) AS t1,
          COUNT(CASE WHEN NVL(s.n_f0ppas, 0) &lt;&gt; 0 AND j1.k1 IS NULL THEN 1 END) AS f1,
          -- AFSITJP-502: Currency (F0CYCD) not a valid ISO currency code (3 letters; SSCYIFP not in extract)
          COUNT(CASE WHEN TRIM(s."F0CYCD") IS NOT NULL THEN 1 END) AS t2,
          COUNT(CASE WHEN TRIM(s."F0CYCD") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."F0CYCD"), '^[A-Z]{3}$') THEN 1 END) AS f2,
          -- AFSITJP-503: Local Currency (F0LCYC) not a valid ISO currency code (3 letters; SSCYIFP not in extract)
          COUNT(CASE WHEN TRIM(s."F0LCYC") IS NOT NULL THEN 1 END) AS t3,
          COUNT(CASE WHEN TRIM(s."F0LCYC") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."F0LCYC"), '^[A-Z]{3}$') THEN 1 END) AS f3,
          -- AFSITJP-504: Receiver Charge Currency (F0RCHC) not a valid ISO currency code (3 letters; SSCYIFP not in extract)
          COUNT(CASE WHEN TRIM(s."F0RCHC") IS NOT NULL THEN 1 END) AS t4,
          COUNT(CASE WHEN TRIM(s."F0RCHC") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."F0RCHC"), '^[A-Z]{3}$') THEN 1 END) AS f4,
          -- AFSITJP-505: Product type (F0APTY) not found in any PDCPP (DD/TD/LS/PL/DC)
          COUNT(CASE WHEN TRIM(s."F0APTY") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."F0APTY"), '^[0. ]*$') THEN 1 END) AS t5,
          COUNT(CASE WHEN TRIM(s."F0APTY") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."F0APTY"), '^[0. ]*$') AND j2.code IS NULL THEN 1 END) AS f5
        FROM (
              SELECT t."F0APTY",
                     t."F0CYCD",
                     t."F0LCYC",
                     t."F0RCHC",
                     (CASE WHEN VALIDATE_CONVERSION(TRIM(t."F0PPAB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."F0PPAB")) END) AS n_f0ppab,
                     (CASE WHEN VALIDATE_CONVERSION(TRIM(t."F0PPAS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."F0PPAS")) END) AS n_f0ppas,
                     (CASE WHEN VALIDATE_CONVERSION(TRIM(t."F0PPAX") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."F0PPAX")) END) AS n_f0ppax
                FROM DATACUT5."HUB_MT_AFSITJP" t
        ) s
        LEFT JOIN k_acc_dd j1 ON j1.k1 = s.n_f0ppab AND j1.k2 = s.n_f0ppas AND j1.k3 = s.n_f0ppax
        LEFT JOIN ref_apty j2 ON j2.code = TRIM(s."F0APTY")
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'AFSITJP-501|Missing Links|Primary party account (F0PPAB+F0PPAS+F0PPAX) not found in DDACMSP',
        (t2, f2) AS 'AFSITJP-502|Format|Currency (F0CYCD) not a valid ISO currency code (3 letters; SSCYIFP not in extract)',
        (t3, f3) AS 'AFSITJP-503|Format|Local Currency (F0LCYC) not a valid ISO currency code (3 letters; SSCYIFP not in extract)',
        (t4, f4) AS 'AFSITJP-504|Format|Receiver Charge Currency (F0RCHC) not a valid ISO currency code (3 letters; SSCYIFP not in extract)',
        (t5, f5) AS 'AFSITJP-505|Missing Links|Product type (F0APTY) not found in any PDCPP (DD/TD/LS/PL/DC)'
      ))
    UNION ALL
/* =============================================================================
   BAPTACP - Preferential Tariff Control File
   Πίνακας: DATACUT5."HUB_MT_BAPTACP"   Shadow: δεν υπάρχει mode flag   Έλεγχοι: 2
   Έλεγχοι από τους κανόνες της στήλης Free column του DD v1.24.
   ============================================================================= */
    SELECT 'BAPTACP - Preferential Tariff Control File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- BAPTACP-501: Currency (BKCYCD) not a valid ISO currency code (3 letters; SSCYIFP not in extract)
          COUNT(CASE WHEN TRIM(s."BKCYCD") IS NOT NULL THEN 1 END) AS t1,
          COUNT(CASE WHEN TRIM(s."BKCYCD") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."BKCYCD"), '^[A-Z]{3}$') THEN 1 END) AS f1,
          -- BAPTACP-502: Product type (BKAPTY) not found in any PDCPP (DD/TD/LS/PL/DC)
          COUNT(CASE WHEN TRIM(s."BKAPTY") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."BKAPTY"), '^[0. ]*$') THEN 1 END) AS t2,
          COUNT(CASE WHEN TRIM(s."BKAPTY") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."BKAPTY"), '^[0. ]*$') AND j1.code IS NULL THEN 1 END) AS f2
        FROM (
              SELECT t."BKAPTY",
                     t."BKCYCD"
                FROM DATACUT5."HUB_MT_BAPTACP" t
        ) s
        LEFT JOIN ref_apty j1 ON j1.code = TRIM(s."BKAPTY")
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'BAPTACP-501|Format|Currency (BKCYCD) not a valid ISO currency code (3 letters; SSCYIFP not in extract)',
        (t2, f2) AS 'BAPTACP-502|Missing Links|Product type (BKAPTY) not found in any PDCPP (DD/TD/LS/PL/DC)'
      ))
    UNION ALL
/* =============================================================================
   DCACMSP - Demand Credit Master File
   Πίνακας: DATACUT5."HUB_MT_DCACMSP"   Shadow: D1MDFL = 'S' (εξαιρούνται)   Έλεγχοι: 2
   Έλεγχοι από τους κανόνες της στήλης Free column του DD v1.24.
   ============================================================================= */
    SELECT 'DCACMSP - Demand Credit Master File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- DCACMSP-501: Currency (D1CYCD) not a valid ISO currency code (3 letters; SSCYIFP not in extract)
          COUNT(CASE WHEN TRIM(s."D1CYCD") IS NOT NULL THEN 1 END) AS t1,
          COUNT(CASE WHEN TRIM(s."D1CYCD") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."D1CYCD"), '^[A-Z]{3}$') THEN 1 END) AS f1,
          -- DCACMSP-502: Product type (D1APTY) not found in any PDCPP (DD/TD/LS/PL/DC)
          COUNT(CASE WHEN TRIM(s."D1APTY") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."D1APTY"), '^[0. ]*$') THEN 1 END) AS t2,
          COUNT(CASE WHEN TRIM(s."D1APTY") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."D1APTY"), '^[0. ]*$') AND j1.code IS NULL THEN 1 END) AS f2
        FROM (
              SELECT t."D1APTY",
                     t."D1CYCD"
                FROM DATACUT5."HUB_MT_DCACMSP" t
               WHERE NVL(t."D1MDFL",' ') &lt;&gt; 'S'
        ) s
        LEFT JOIN ref_apty j1 ON j1.code = TRIM(s."D1APTY")
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'DCACMSP-501|Format|Currency (D1CYCD) not a valid ISO currency code (3 letters; SSCYIFP not in extract)',
        (t2, f2) AS 'DCACMSP-502|Missing Links|Product type (D1APTY) not found in any PDCPP (DD/TD/LS/PL/DC)'
      ))
    UNION ALL
/* =============================================================================
   DCDRICP - Demand Credit DR Interest Ctl File - Prod Copy
   Πίνακας: DATACUT5."HUB_MT_DCDRICP"   Shadow: D2MDFL = 'S' (εξαιρούνται)   Έλεγχοι: 3
   Έλεγχοι από τους κανόνες της στήλης Free column του DD v1.24.
   ============================================================================= */
    SELECT 'DCDRICP - Demand Credit DR Interest Ctl File - Prod Copy' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- DCDRICP-501: Currency (D2CYCD) not a valid ISO currency code (3 letters; SSCYIFP not in extract)
          COUNT(CASE WHEN TRIM(s."D2CYCD") IS NOT NULL THEN 1 END) AS t1,
          COUNT(CASE WHEN TRIM(s."D2CYCD") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."D2CYCD"), '^[A-Z]{3}$') THEN 1 END) AS f1,
          -- DCDRICP-502: GHO classification (D2GHCL) not found in SSGHCLP
          COUNT(CASE WHEN TRIM(s."D2GHCL") IS NOT NULL THEN 1 END) AS t2,
          COUNT(CASE WHEN TRIM(s."D2GHCL") IS NOT NULL AND j1.code IS NULL THEN 1 END) AS f2,
          -- DCDRICP-503: Product type (D2APTY) not found in any PDCPP (DD/TD/LS/PL/DC)
          COUNT(CASE WHEN TRIM(s."D2APTY") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."D2APTY"), '^[0. ]*$') THEN 1 END) AS t3,
          COUNT(CASE WHEN TRIM(s."D2APTY") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."D2APTY"), '^[0. ]*$') AND j2.code IS NULL THEN 1 END) AS f3
        FROM (
              SELECT t."D2APTY",
                     t."D2CYCD",
                     t."D2GHCL"
                FROM DATACUT5."HUB_MT_DCDRICP" t
               WHERE NVL(t."D2MDFL",' ') &lt;&gt; 'S'
        ) s
        LEFT JOIN k_ghcl j1 ON j1.code = TRIM(s."D2GHCL")
        LEFT JOIN ref_apty j2 ON j2.code = TRIM(s."D2APTY")
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'DCDRICP-501|Format|Currency (D2CYCD) not a valid ISO currency code (3 letters; SSCYIFP not in extract)',
        (t2, f2) AS 'DCDRICP-502|Missing Links|GHO classification (D2GHCL) not found in SSGHCLP',
        (t3, f3) AS 'DCDRICP-503|Missing Links|Product type (D2APTY) not found in any PDCPP (DD/TD/LS/PL/DC)'
      ))
    UNION ALL
/* =============================================================================
   DDACMSP - Demand Deposits Account Master File
   Πίνακας: DATACUT5."HUB_MT_DDACMSP"   Shadow: DFMDFL = 'S' (εξαιρούνται)   Έλεγχοι: 7
   Έλεγχοι από τους κανόνες της στήλης Free column του DD v1.24.
   ============================================================================= */
    SELECT 'DDACMSP - Demand Deposits Account Master File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- DDACMSP-501: Market Sector 1 (DFMKS1) not in SSSTDPP MS (market sector)
          COUNT(CASE WHEN TRIM(s."DFMKS1") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."DFMKS1"), '^[0. ]*$') THEN 1 END) AS t1,
          COUNT(CASE WHEN TRIM(s."DFMKS1") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."DFMKS1"), '^[0. ]*$') AND j1.code IS NULL THEN 1 END) AS f1,
          -- DDACMSP-502: Market Sector 2 (DFMKS2) not in SSSTDPP MS (market sector)
          COUNT(CASE WHEN TRIM(s."DFMKS2") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."DFMKS2"), '^[0. ]*$') THEN 1 END) AS t2,
          COUNT(CASE WHEN TRIM(s."DFMKS2") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."DFMKS2"), '^[0. ]*$') AND j2.code IS NULL THEN 1 END) AS f2,
          -- DDACMSP-503: Market Sector 3 (DFMKS3) not in SSSTDPP MS (market sector)
          COUNT(CASE WHEN TRIM(s."DFMKS3") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."DFMKS3"), '^[0. ]*$') THEN 1 END) AS t3,
          COUNT(CASE WHEN TRIM(s."DFMKS3") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."DFMKS3"), '^[0. ]*$') AND j3.code IS NULL THEN 1 END) AS f3,
          -- DDACMSP-504: Currency (DFCYCD) not a valid ISO currency code (3 letters; SSCYIFP not in extract)
          COUNT(CASE WHEN TRIM(s."DFCYCD") IS NOT NULL THEN 1 END) AS t4,
          COUNT(CASE WHEN TRIM(s."DFCYCD") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."DFCYCD"), '^[A-Z]{3}$') THEN 1 END) AS f4,
          -- DDACMSP-505: GHO classification (DFGHCL) not found in SSGHCLP
          COUNT(CASE WHEN TRIM(s."DFGHCL") IS NOT NULL THEN 1 END) AS t5,
          COUNT(CASE WHEN TRIM(s."DFGHCL") IS NOT NULL AND j4.code IS NULL THEN 1 END) AS f5,
          -- DDACMSP-506: Branch (DFACB) not found in SSBRCPP
          COUNT(CASE WHEN NVL(s.n_dfacb, 0) &lt;&gt; 0 THEN 1 END) AS t6,
          COUNT(CASE WHEN NVL(s.n_dfacb, 0) &lt;&gt; 0 AND j5.brn IS NULL THEN 1 END) AS f6,
          -- DDACMSP-507: Product type (DFAPTY) not found in any PDCPP (DD/TD/LS/PL/DC)
          COUNT(CASE WHEN TRIM(s."DFAPTY") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."DFAPTY"), '^[0. ]*$') THEN 1 END) AS t7,
          COUNT(CASE WHEN TRIM(s."DFAPTY") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."DFAPTY"), '^[0. ]*$') AND j6.code IS NULL THEN 1 END) AS f7
        FROM (
              SELECT t."DFAPTY",
                     t."DFCYCD",
                     t."DFGHCL",
                     t."DFMKS1",
                     t."DFMKS2",
                     t."DFMKS3",
                     (CASE WHEN VALIDATE_CONVERSION(TRIM(t."DFACB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."DFACB")) END) AS n_dfacb
                FROM DATACUT5."HUB_MT_DDACMSP" t
               WHERE NVL(t."DFMDFL",' ') &lt;&gt; 'S'
        ) s
        LEFT JOIN ref_std_ms j1 ON j1.code = NVL(LTRIM(TRIM(s."DFMKS1"), '0'), '0')
        LEFT JOIN ref_std_ms j2 ON j2.code = NVL(LTRIM(TRIM(s."DFMKS2"), '0'), '0')
        LEFT JOIN ref_std_ms j3 ON j3.code = NVL(LTRIM(TRIM(s."DFMKS3"), '0'), '0')
        LEFT JOIN k_ghcl j4 ON j4.code = TRIM(s."DFGHCL")
        LEFT JOIN k_brn j5 ON j5.brn = s.n_dfacb
        LEFT JOIN ref_apty j6 ON j6.code = TRIM(s."DFAPTY")
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'DDACMSP-501|Invalid Values|Market Sector 1 (DFMKS1) not in SSSTDPP MS (market sector)',
        (t2, f2) AS 'DDACMSP-502|Invalid Values|Market Sector 2 (DFMKS2) not in SSSTDPP MS (market sector)',
        (t3, f3) AS 'DDACMSP-503|Invalid Values|Market Sector 3 (DFMKS3) not in SSSTDPP MS (market sector)',
        (t4, f4) AS 'DDACMSP-504|Format|Currency (DFCYCD) not a valid ISO currency code (3 letters; SSCYIFP not in extract)',
        (t5, f5) AS 'DDACMSP-505|Missing Links|GHO classification (DFGHCL) not found in SSGHCLP',
        (t6, f6) AS 'DDACMSP-506|Missing Links|Branch (DFACB) not found in SSBRCPP',
        (t7, f7) AS 'DDACMSP-507|Missing Links|Product type (DFAPTY) not found in any PDCPP (DD/TD/LS/PL/DC)'
      ))
    UNION ALL
/* =============================================================================
   DDCQBKP - Demand Deposits Cheque Book File
   Πίνακας: DATACUT5."HUB_MT_DDCQBKP"   Shadow: DJMDFL = 'S' (εξαιρούνται)   Έλεγχοι: 1
   Έλεγχοι από τους κανόνες της στήλης Free column του DD v1.24.
   ============================================================================= */
    SELECT 'DDCQBKP - Demand Deposits Cheque Book File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- DDCQBKP-501: Currency (DJCYCD) not a valid ISO currency code (3 letters; SSCYIFP not in extract)
          COUNT(CASE WHEN TRIM(s."DJCYCD") IS NOT NULL THEN 1 END) AS t1,
          COUNT(CASE WHEN TRIM(s."DJCYCD") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."DJCYCD"), '^[A-Z]{3}$') THEN 1 END) AS f1
        FROM (
              SELECT t."DJCYCD"
                FROM DATACUT5."HUB_MT_DDCQBKP" t
               WHERE NVL(t."DJMDFL",' ') &lt;&gt; 'S'
        ) s
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'DDCQBKP-501|Format|Currency (DJCYCD) not a valid ISO currency code (3 letters; SSCYIFP not in extract)'
      ))
    UNION ALL
/* =============================================================================
   DDCRINP - Demand Deposits Credit Interest Segment File  f
   Πίνακας: DATACUT5."HUB_MT_DDCRINP"   Shadow: DGMDFL = 'S' (εξαιρούνται)   Έλεγχοι: 2
   Έλεγχοι από τους κανόνες της στήλης Free column του DD v1.24.
   ============================================================================= */
    SELECT 'DDCRINP - Demand Deposits Credit Interest Segment File  f' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- DDCRINP-501: Currency (DGCYCD) not a valid ISO currency code (3 letters; SSCYIFP not in extract)
          COUNT(CASE WHEN TRIM(s."DGCYCD") IS NOT NULL THEN 1 END) AS t1,
          COUNT(CASE WHEN TRIM(s."DGCYCD") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."DGCYCD"), '^[A-Z]{3}$') THEN 1 END) AS f1,
          -- DDCRINP-502: Product type (DGAPTY) not found in any PDCPP (DD/TD/LS/PL/DC)
          COUNT(CASE WHEN TRIM(s."DGAPTY") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."DGAPTY"), '^[0. ]*$') THEN 1 END) AS t2,
          COUNT(CASE WHEN TRIM(s."DGAPTY") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."DGAPTY"), '^[0. ]*$') AND j1.code IS NULL THEN 1 END) AS f2
        FROM (
              SELECT t."DGAPTY",
                     t."DGCYCD"
                FROM DATACUT5."HUB_MT_DDCRINP" t
               WHERE NVL(t."DGMDFL",' ') &lt;&gt; 'S'
        ) s
        LEFT JOIN ref_apty j1 ON j1.code = TRIM(s."DGAPTY")
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'DDCRINP-501|Format|Currency (DGCYCD) not a valid ISO currency code (3 letters; SSCYIFP not in extract)',
        (t2, f2) AS 'DDCRINP-502|Missing Links|Product type (DGAPTY) not found in any PDCPP (DD/TD/LS/PL/DC)'
      ))
    UNION ALL
/* =============================================================================
   DDIBANP - IBAN Master File
   Πίνακας: DATACUT5."HUB_MT_DDIBANP"   Shadow: δεν υπάρχει mode flag   Έλεγχοι: 1
   Έλεγχοι από τους κανόνες της στήλης Free column του DD v1.24.
   ============================================================================= */
    SELECT 'DDIBANP - IBAN Master File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- DDIBANP-501: Currency (IBCYCD) not a valid ISO currency code (3 letters; SSCYIFP not in extract)
          COUNT(CASE WHEN TRIM(s."IBCYCD") IS NOT NULL THEN 1 END) AS t1,
          COUNT(CASE WHEN TRIM(s."IBCYCD") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."IBCYCD"), '^[A-Z]{3}$') THEN 1 END) AS f1
        FROM (
              SELECT t."IBCYCD"
                FROM DATACUT5."HUB_MT_DDIBANP" t
        ) s
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'DDIBANP-501|Format|Currency (IBCYCD) not a valid ISO currency code (3 letters; SSCYIFP not in extract)'
      ))
    UNION ALL
/* =============================================================================
   DDSPCPP - Demand Depostis Sub-product Control File (Prod)
   Πίνακας: DATACUT5."HUB_MT_DDSPCPP"   Shadow: DBMDFL = 'S' (εξαιρούνται)   Έλεγχοι: 2
   Έλεγχοι από τους κανόνες της στήλης Free column του DD v1.24.
   ============================================================================= */
    SELECT 'DDSPCPP - Demand Depostis Sub-product Control File (Prod)' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- DDSPCPP-501: Currency (DBCYCD) not a valid ISO currency code (3 letters; SSCYIFP not in extract)
          COUNT(CASE WHEN TRIM(s."DBCYCD") IS NOT NULL THEN 1 END) AS t1,
          COUNT(CASE WHEN TRIM(s."DBCYCD") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."DBCYCD"), '^[A-Z]{3}$') THEN 1 END) AS f1,
          -- DDSPCPP-502: Product type (DBAPTY) not found in any PDCPP (DD/TD/LS/PL/DC)
          COUNT(CASE WHEN TRIM(s."DBAPTY") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."DBAPTY"), '^[0. ]*$') THEN 1 END) AS t2,
          COUNT(CASE WHEN TRIM(s."DBAPTY") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."DBAPTY"), '^[0. ]*$') AND j1.code IS NULL THEN 1 END) AS f2
        FROM (
              SELECT t."DBAPTY",
                     t."DBCYCD"
                FROM DATACUT5."HUB_MT_DDSPCPP" t
               WHERE NVL(t."DBMDFL",' ') &lt;&gt; 'S'
        ) s
        LEFT JOIN ref_apty j1 ON j1.code = TRIM(s."DBAPTY")
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'DDSPCPP-501|Format|Currency (DBCYCD) not a valid ISO currency code (3 letters; SSCYIFP not in extract)',
        (t2, f2) AS 'DDSPCPP-502|Missing Links|Product type (DBAPTY) not found in any PDCPP (DD/TD/LS/PL/DC)'
      ))
    UNION ALL
/* =============================================================================
   DDSTMTP - Demand Deposits Account Statement Segment File
   Πίνακας: DATACUT5."HUB_MT_DDSTMTP"   Shadow: DHMDFL = 'S' (εξαιρούνται)   Έλεγχοι: 1
   Έλεγχοι από τους κανόνες της στήλης Free column του DD v1.24.
   ============================================================================= */
    SELECT 'DDSTMTP - Demand Deposits Account Statement Segment File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- DDSTMTP-501: Product type (DHAPTY) not found in any PDCPP (DD/TD/LS/PL/DC)
          COUNT(CASE WHEN TRIM(s."DHAPTY") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."DHAPTY"), '^[0. ]*$') THEN 1 END) AS t1,
          COUNT(CASE WHEN TRIM(s."DHAPTY") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."DHAPTY"), '^[0. ]*$') AND j1.code IS NULL THEN 1 END) AS f1
        FROM (
              SELECT t."DHAPTY"
                FROM DATACUT5."HUB_MT_DDSTMTP" t
               WHERE NVL(t."DHMDFL",' ') &lt;&gt; 'S'
        ) s
        LEFT JOIN ref_apty j1 ON j1.code = TRIM(s."DHAPTY")
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'DDSTMTP-501|Missing Links|Product type (DHAPTY) not found in any PDCPP (DD/TD/LS/PL/DC)'
      ))
    UNION ALL
/* =============================================================================
   EBDCNOP - E-Banking Domestic Customer File
   Πίνακας: DATACUT5."HUB_MT_EBDCNOP"   Shadow: ICMDFL = 'S' (εξαιρούνται)   Έλεγχοι: 1
   Έλεγχοι από τους κανόνες της στήλης Free column του DD v1.24.
   ============================================================================= */
    SELECT 'EBDCNOP - E-Banking Domestic Customer File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- EBDCNOP-501: Phone banking number (ICPBN) not found in EBCUSTP
          COUNT(CASE WHEN NVL(s.n_icpbn, 0) &lt;&gt; 0 THEN 1 END) AS t1,
          COUNT(CASE WHEN NVL(s.n_icpbn, 0) &lt;&gt; 0 AND j1.pbn IS NULL THEN 1 END) AS f1
        FROM (
              SELECT (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ICPBN") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ICPBN")) END) AS n_icpbn
                FROM DATACUT5."HUB_MT_EBDCNOP" t
               WHERE NVL(t."ICMDFL",' ') &lt;&gt; 'S'
        ) s
        LEFT JOIN k_pbn j1 ON j1.pbn = s.n_icpbn
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'EBDCNOP-501|Missing Links|Phone banking number (ICPBN) not found in EBCUSTP'
      ))
    UNION ALL
/* =============================================================================
   EBMHIFP - HE Merchant Detail File
   Πίνακας: DATACUT5."HUB_MT_EBMHIFP"   Shadow: NFMDFL = 'S' (εξαιρούνται)   Έλεγχοι: 1
   Έλεγχοι από τους κανόνες της στήλης Free column του DD v1.24.
   ============================================================================= */
    SELECT 'EBMHIFP - HE Merchant Detail File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- EBMHIFP-501: Currency (NFCYCD) not a valid ISO currency code (3 letters; SSCYIFP not in extract)
          COUNT(CASE WHEN TRIM(s."NFCYCD") IS NOT NULL THEN 1 END) AS t1,
          COUNT(CASE WHEN TRIM(s."NFCYCD") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."NFCYCD"), '^[A-Z]{3}$') THEN 1 END) AS f1
        FROM (
              SELECT t."NFCYCD"
                FROM DATACUT5."HUB_MT_EBMHIFP" t
               WHERE NVL(t."NFMDFL",' ') &lt;&gt; 'S'
        ) s
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'EBMHIFP-501|Format|Currency (NFCYCD) not a valid ISO currency code (3 letters; SSCYIFP not in extract)'
      ))
    UNION ALL
/* =============================================================================
   EUDTSDDP - EVPS - ACH Direct Debit
   Πίνακας: DATACUT5."HUB_MT_EUDTSDDP"   Shadow: δεν υπάρχει mode flag   Έλεγχοι: 4
   Έλεγχοι από τους κανόνες της στήλης Free column του DD v1.24.
   ============================================================================= */
    SELECT 'EUDTSDDP - EVPS - ACH Direct Debit' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- EUDTSDDP-501: Creditor Country (SDCCTC) not in SSSTDPP CT (country code)
          COUNT(CASE WHEN TRIM(s."SDCCTC") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."SDCCTC"), '^[0. ]*$') THEN 1 END) AS t1,
          COUNT(CASE WHEN TRIM(s."SDCCTC") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."SDCCTC"), '^[0. ]*$') AND j1.code IS NULL THEN 1 END) AS f1,
          -- EUDTSDDP-502: Country of Residence CR (SDCTRY) not in SSSTDPP CT (country code)
          COUNT(CASE WHEN TRIM(s."SDCTRY") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."SDCTRY"), '^[0. ]*$') THEN 1 END) AS t2,
          COUNT(CASE WHEN TRIM(s."SDCTRY") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."SDCTRY"), '^[0. ]*$') AND j2.code IS NULL THEN 1 END) AS f2,
          -- EUDTSDDP-503: Debitor Country (SDDCTC) not in SSSTDPP CT (country code)
          COUNT(CASE WHEN TRIM(s."SDDCTC") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."SDDCTC"), '^[0. ]*$') THEN 1 END) AS t3,
          COUNT(CASE WHEN TRIM(s."SDDCTC") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."SDDCTC"), '^[0. ]*$') AND j3.code IS NULL THEN 1 END) AS f3,
          -- EUDTSDDP-504: Payment Currency (SDPCCY) not a valid ISO currency code (3 letters; SSCYIFP not in extract)
          COUNT(CASE WHEN TRIM(s."SDPCCY") IS NOT NULL THEN 1 END) AS t4,
          COUNT(CASE WHEN TRIM(s."SDPCCY") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."SDPCCY"), '^[A-Z]{3}$') THEN 1 END) AS f4
        FROM (
              SELECT t."SDCCTC",
                     t."SDCTRY",
                     t."SDDCTC",
                     t."SDPCCY"
                FROM DATACUT5."HUB_MT_EUDTSDDP" t
        ) s
        LEFT JOIN ref_std_ct j1 ON j1.code = NVL(LTRIM(TRIM(s."SDCCTC"), '0'), '0')
        LEFT JOIN ref_std_ct j2 ON j2.code = NVL(LTRIM(TRIM(s."SDCTRY"), '0'), '0')
        LEFT JOIN ref_std_ct j3 ON j3.code = NVL(LTRIM(TRIM(s."SDDCTC"), '0'), '0')
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'EUDTSDDP-501|Invalid Values|Creditor Country (SDCCTC) not in SSSTDPP CT (country code)',
        (t2, f2) AS 'EUDTSDDP-502|Invalid Values|Country of Residence CR (SDCTRY) not in SSSTDPP CT (country code)',
        (t3, f3) AS 'EUDTSDDP-503|Invalid Values|Debitor Country (SDDCTC) not in SSSTDPP CT (country code)',
        (t4, f4) AS 'EUDTSDDP-504|Format|Payment Currency (SDPCCY) not a valid ISO currency code (3 letters; SSCYIFP not in extract)'
      ))
    UNION ALL
/* =============================================================================
   FN@BRGP - CBM BUSINESS REGISTER
   Πίνακας: DATACUT5."HUB_MT_FN@BRGP"   Shadow: δεν υπάρχει mode flag   Έλεγχοι: 1
   Έλεγχοι από τους κανόνες της στήλης Free column του DD v1.24.
   ============================================================================= */
    SELECT 'FN@BRGP - CBM BUSINESS REGISTER' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- FN_BRGP-501: CBMNACE (FNNACE) not in SSSTDPP IY (industry code)
          COUNT(CASE WHEN TRIM(s."FNNACE") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."FNNACE"), '^[0. ]*$') THEN 1 END) AS t1,
          COUNT(CASE WHEN TRIM(s."FNNACE") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."FNNACE"), '^[0. ]*$') AND j1.code IS NULL THEN 1 END) AS f1
        FROM (
              SELECT t."FNNACE"
                FROM DATACUT5."HUB_MT_FN@BRGP" t
        ) s
        LEFT JOIN ref_std_iy j1 ON j1.code = NVL(LTRIM(TRIM(s."FNNACE"), '0'), '0')
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'FN_BRGP-501|Invalid Values|CBMNACE (FNNACE) not in SSSTDPP IY (industry code)'
      ))
    UNION ALL
/* =============================================================================
   FN@DDCP - Business register Data Dictionary
   Πίνακας: DATACUT5."HUB_MT_FN@DDCP"   Shadow: δεν υπάρχει mode flag   Έλεγχοι: 1
   Έλεγχοι από τους κανόνες της στήλης Free column του DD v1.24.
   ============================================================================= */
    SELECT 'FN@DDCP - Business register Data Dictionary' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- FN_DDCP-501: CBMNACE (FDNACE) not in SSSTDPP IY (industry code)
          COUNT(CASE WHEN TRIM(s."FDNACE") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."FDNACE"), '^[0. ]*$') THEN 1 END) AS t1,
          COUNT(CASE WHEN TRIM(s."FDNACE") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."FDNACE"), '^[0. ]*$') AND j1.code IS NULL THEN 1 END) AS f1
        FROM (
              SELECT t."FDNACE"
                FROM DATACUT5."HUB_MT_FN@DDCP" t
        ) s
        LEFT JOIN ref_std_iy j1 ON j1.code = NVL(LTRIM(TRIM(s."FDNACE"), '0'), '0')
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'FN_DDCP-501|Invalid Values|CBMNACE (FDNACE) not in SSSTDPP IY (industry code)'
      ))
    UNION ALL
/* =============================================================================
   GLACMSP - General Ledger Account Master File
   Πίνακας: DATACUT5."HUB_MT_GLACMSP"   Shadow: GEMDFL = 'S' (εξαιρούνται)   Έλεγχοι: 2
   Έλεγχοι από τους κανόνες της στήλης Free column του DD v1.24.
   ============================================================================= */
    SELECT 'GLACMSP - General Ledger Account Master File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- GLACMSP-501: Currency (GECYCD) not a valid ISO currency code (3 letters; SSCYIFP not in extract)
          COUNT(CASE WHEN TRIM(s."GECYCD") IS NOT NULL THEN 1 END) AS t1,
          COUNT(CASE WHEN TRIM(s."GECYCD") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."GECYCD"), '^[A-Z]{3}$') THEN 1 END) AS f1,
          -- GLACMSP-502: Branch (GEACB) not found in SSBRCPP
          COUNT(CASE WHEN NVL(s.n_geacb, 0) &lt;&gt; 0 THEN 1 END) AS t2,
          COUNT(CASE WHEN NVL(s.n_geacb, 0) &lt;&gt; 0 AND j1.brn IS NULL THEN 1 END) AS f2
        FROM (
              SELECT t."GECYCD",
                     (CASE WHEN VALIDATE_CONVERSION(TRIM(t."GEACB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."GEACB")) END) AS n_geacb
                FROM DATACUT5."HUB_MT_GLACMSP" t
               WHERE NVL(t."GEMDFL",' ') &lt;&gt; 'S'
        ) s
        LEFT JOIN k_brn j1 ON j1.brn = s.n_geacb
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'GLACMSP-501|Format|Currency (GECYCD) not a valid ISO currency code (3 letters; SSCYIFP not in extract)',
        (t2, f2) AS 'GLACMSP-502|Missing Links|Branch (GEACB) not found in SSBRCPP'
      ))
    UNION ALL
/* =============================================================================
   IBACIDP - IB Account ID File
   Πίνακας: DATACUT5."HUB_MT_IBACIDP"   Shadow: IAMDFL = 'S' (εξαιρούνται)   Έλεγχοι: 4
   Έλεγχοι από τους κανόνες της στήλης Free column του DD v1.24.
   ============================================================================= */
    SELECT 'IBACIDP - IB Account ID File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- IBACIDP-501: Account (IAACB+IAACS+IAACX) not found in any account master (DD/LS/TD/PL/DC/IE/GL ACMSP)
          COUNT(CASE WHEN NVL(s.n_iaacs, 0) &lt;&gt; 0 THEN 1 END) AS t1,
          COUNT(CASE WHEN NVL(s.n_iaacs, 0) &lt;&gt; 0 AND j1.k1 IS NULL THEN 1 END) AS f1,
          -- IBACIDP-502: Currency (IACYCD) not a valid ISO currency code (3 letters; SSCYIFP not in extract)
          COUNT(CASE WHEN TRIM(s."IACYCD") IS NOT NULL THEN 1 END) AS t2,
          COUNT(CASE WHEN TRIM(s."IACYCD") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."IACYCD"), '^[A-Z]{3}$') THEN 1 END) AS f2,
          -- IBACIDP-503: Phone banking number (IAPBN) not found in EBCUSTP
          COUNT(CASE WHEN NVL(s.n_iapbn, 0) &lt;&gt; 0 THEN 1 END) AS t3,
          COUNT(CASE WHEN NVL(s.n_iapbn, 0) &lt;&gt; 0 AND j2.pbn IS NULL THEN 1 END) AS f3,
          -- IBACIDP-504: Product type (IAAPTY) not found in any PDCPP (DD/TD/LS/PL/DC)
          COUNT(CASE WHEN TRIM(s."IAAPTY") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."IAAPTY"), '^[0. ]*$') THEN 1 END) AS t4,
          COUNT(CASE WHEN TRIM(s."IAAPTY") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."IAAPTY"), '^[0. ]*$') AND j3.code IS NULL THEN 1 END) AS f4
        FROM (
              SELECT t."IAAPTY",
                     t."IACYCD",
                     (CASE WHEN VALIDATE_CONVERSION(TRIM(t."IAACB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."IAACB")) END) AS n_iaacb,
                     (CASE WHEN VALIDATE_CONVERSION(TRIM(t."IAACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."IAACS")) END) AS n_iaacs,
                     (CASE WHEN VALIDATE_CONVERSION(TRIM(t."IAACX") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."IAACX")) END) AS n_iaacx,
                     (CASE WHEN VALIDATE_CONVERSION(TRIM(t."IAPBN") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."IAPBN")) END) AS n_iapbn
                FROM DATACUT5."HUB_MT_IBACIDP" t
               WHERE NVL(t."IAMDFL",' ') &lt;&gt; 'S'
        ) s
        LEFT JOIN k_acc j1 ON j1.k1 = s.n_iaacb AND j1.k2 = s.n_iaacs AND j1.k3 = s.n_iaacx
        LEFT JOIN k_pbn j2 ON j2.pbn = s.n_iapbn
        LEFT JOIN ref_apty j3 ON j3.code = TRIM(s."IAAPTY")
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'IBACIDP-501|Missing Links|Account (IAACB+IAACS+IAACX) not found in any account master (DD/LS/TD/PL/DC/IE/GL ACMSP)',
        (t2, f2) AS 'IBACIDP-502|Format|Currency (IACYCD) not a valid ISO currency code (3 letters; SSCYIFP not in extract)',
        (t3, f3) AS 'IBACIDP-503|Missing Links|Phone banking number (IAPBN) not found in EBCUSTP',
        (t4, f4) AS 'IBACIDP-504|Missing Links|Product type (IAAPTY) not found in any PDCPP (DD/TD/LS/PL/DC)'
      ))
    UNION ALL
/* =============================================================================
   IBESMCP - IB E-Statement Control File
   Πίνακας: DATACUT5."HUB_MT_IBESMCP"   Shadow: δεν υπάρχει mode flag   Έλεγχοι: 2
   Έλεγχοι από τους κανόνες της στήλης Free column του DD v1.24.
   ============================================================================= */
    SELECT 'IBESMCP - IB E-Statement Control File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- IBESMCP-501: Customer (YGDCB+YGDCS) not found in SSCUSTP
          COUNT(CASE WHEN NVL(s.n_ygdcb, 0) &lt;&gt; 0 AND NVL(s.n_ygdcs, 0) &lt;&gt; 0 THEN 1 END) AS t1,
          COUNT(CASE WHEN NVL(s.n_ygdcb, 0) &lt;&gt; 0 AND NVL(s.n_ygdcs, 0) &lt;&gt; 0 AND j1.dcb IS NULL THEN 1 END) AS f1,
          -- IBESMCP-502: Account (YGACB+YGACS+YGACX) not found in any account master (DD/LS/TD/PL/DC/IE/GL ACMSP)
          COUNT(CASE WHEN NVL(s.n_ygacs, 0) &lt;&gt; 0 THEN 1 END) AS t2,
          COUNT(CASE WHEN NVL(s.n_ygacs, 0) &lt;&gt; 0 AND j2.k1 IS NULL THEN 1 END) AS f2
        FROM (
              SELECT (CASE WHEN VALIDATE_CONVERSION(TRIM(t."YGDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."YGDCB")) END) AS n_ygdcb,
                     (CASE WHEN VALIDATE_CONVERSION(TRIM(t."YGDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."YGDCS")) END) AS n_ygdcs,
                     (CASE WHEN VALIDATE_CONVERSION(TRIM(t."YGACB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."YGACB")) END) AS n_ygacb,
                     (CASE WHEN VALIDATE_CONVERSION(TRIM(t."YGACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."YGACS")) END) AS n_ygacs,
                     (CASE WHEN VALIDATE_CONVERSION(TRIM(t."YGACX") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."YGACX")) END) AS n_ygacx
                FROM DATACUT5."HUB_MT_IBESMCP" t
        ) s
        LEFT JOIN k_cus j1 ON j1.dcb = s.n_ygdcb AND j1.dcs = s.n_ygdcs
        LEFT JOIN k_acc j2 ON j2.k1 = s.n_ygacb AND j2.k2 = s.n_ygacs AND j2.k3 = s.n_ygacx
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'IBESMCP-501|Missing Links|Customer (YGDCB+YGDCS) not found in SSCUSTP',
        (t2, f2) AS 'IBESMCP-502|Missing Links|Account (YGACB+YGACS+YGACX) not found in any account master (DD/LS/TD/PL/DC/IE/GL ACMSP)'
      ))
    UNION ALL
/* =============================================================================
   LS@RHICP - LS Repayment Holiday Interest File
   Πίνακας: DATACUT5."HUB_MT_LS@RHICP"   Shadow: EIMDFL = 'S' (εξαιρούνται)   Έλεγχοι: 1
   Έλεγχοι από τους κανόνες της στήλης Free column του DD v1.24.
   ============================================================================= */
    SELECT 'LS@RHICP - LS Repayment Holiday Interest File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- LS_RHICP-501: Account (EIACB+EIACS+EIACX) not found in any account master (DD/LS/TD/PL/DC/IE/GL ACMSP)
          COUNT(CASE WHEN NVL(s.n_eiacs, 0) &lt;&gt; 0 THEN 1 END) AS t1,
          COUNT(CASE WHEN NVL(s.n_eiacs, 0) &lt;&gt; 0 AND j1.k1 IS NULL THEN 1 END) AS f1
        FROM (
              SELECT (CASE WHEN VALIDATE_CONVERSION(TRIM(t."EIACB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."EIACB")) END) AS n_eiacb,
                     (CASE WHEN VALIDATE_CONVERSION(TRIM(t."EIACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."EIACS")) END) AS n_eiacs,
                     (CASE WHEN VALIDATE_CONVERSION(TRIM(t."EIACX") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."EIACX")) END) AS n_eiacx
                FROM DATACUT5."HUB_MT_LS@RHICP" t
               WHERE NVL(t."EIMDFL",' ') &lt;&gt; 'S'
        ) s
        LEFT JOIN k_acc j1 ON j1.k1 = s.n_eiacb AND j1.k2 = s.n_eiacs AND j1.k3 = s.n_eiacx
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'LS_RHICP-501|Missing Links|Account (EIACB+EIACS+EIACX) not found in any account master (DD/LS/TD/PL/DC/IE/GL ACMSP)'
      ))
    UNION ALL
/* =============================================================================
   LSACMSP - LS ACCOUNT MASTER FILE
   Πίνακας: DATACUT5."HUB_MT_LSACMSP"   Shadow: POMDFL = 'S' (εξαιρούνται)   Έλεγχοι: 6
   Έλεγχοι από τους κανόνες της στήλης Free column του DD v1.24.
   ============================================================================= */
    SELECT 'LSACMSP - LS ACCOUNT MASTER FILE' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- LSACMSP-501: MARKET SECTOR 1 (POMKS1) not in SSSTDPP MS (market sector)
          COUNT(CASE WHEN TRIM(s."POMKS1") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."POMKS1"), '^[0. ]*$') THEN 1 END) AS t1,
          COUNT(CASE WHEN TRIM(s."POMKS1") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."POMKS1"), '^[0. ]*$') AND j1.code IS NULL THEN 1 END) AS f1,
          -- LSACMSP-502: MARKET SECTOR 2 (POMKS2) not in SSSTDPP MS (market sector)
          COUNT(CASE WHEN TRIM(s."POMKS2") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."POMKS2"), '^[0. ]*$') THEN 1 END) AS t2,
          COUNT(CASE WHEN TRIM(s."POMKS2") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."POMKS2"), '^[0. ]*$') AND j2.code IS NULL THEN 1 END) AS f2,
          -- LSACMSP-503: MARKET SECTOR 3 (POMKS3) not in SSSTDPP MS (market sector)
          COUNT(CASE WHEN TRIM(s."POMKS3") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."POMKS3"), '^[0. ]*$') THEN 1 END) AS t3,
          COUNT(CASE WHEN TRIM(s."POMKS3") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."POMKS3"), '^[0. ]*$') AND j3.code IS NULL THEN 1 END) AS f3,
          -- LSACMSP-504: CURRENCY (POCYCD) not a valid ISO currency code (3 letters; SSCYIFP not in extract)
          COUNT(CASE WHEN TRIM(s."POCYCD") IS NOT NULL THEN 1 END) AS t4,
          COUNT(CASE WHEN TRIM(s."POCYCD") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."POCYCD"), '^[A-Z]{3}$') THEN 1 END) AS f4,
          -- LSACMSP-505: Branch (POACB) not found in SSBRCPP
          COUNT(CASE WHEN NVL(s.n_poacb, 0) &lt;&gt; 0 THEN 1 END) AS t5,
          COUNT(CASE WHEN NVL(s.n_poacb, 0) &lt;&gt; 0 AND j4.brn IS NULL THEN 1 END) AS f5,
          -- LSACMSP-506: Product type (POAPTY) not found in any PDCPP (DD/TD/LS/PL/DC)
          COUNT(CASE WHEN TRIM(s."POAPTY") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."POAPTY"), '^[0. ]*$') THEN 1 END) AS t6,
          COUNT(CASE WHEN TRIM(s."POAPTY") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."POAPTY"), '^[0. ]*$') AND j5.code IS NULL THEN 1 END) AS f6
        FROM (
              SELECT t."POAPTY",
                     t."POCYCD",
                     t."POMKS1",
                     t."POMKS2",
                     t."POMKS3",
                     (CASE WHEN VALIDATE_CONVERSION(TRIM(t."POACB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."POACB")) END) AS n_poacb
                FROM DATACUT5."HUB_MT_LSACMSP" t
               WHERE NVL(t."POMDFL",' ') &lt;&gt; 'S'
        ) s
        LEFT JOIN ref_std_ms j1 ON j1.code = NVL(LTRIM(TRIM(s."POMKS1"), '0'), '0')
        LEFT JOIN ref_std_ms j2 ON j2.code = NVL(LTRIM(TRIM(s."POMKS2"), '0'), '0')
        LEFT JOIN ref_std_ms j3 ON j3.code = NVL(LTRIM(TRIM(s."POMKS3"), '0'), '0')
        LEFT JOIN k_brn j4 ON j4.brn = s.n_poacb
        LEFT JOIN ref_apty j5 ON j5.code = TRIM(s."POAPTY")
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'LSACMSP-501|Invalid Values|MARKET SECTOR 1 (POMKS1) not in SSSTDPP MS (market sector)',
        (t2, f2) AS 'LSACMSP-502|Invalid Values|MARKET SECTOR 2 (POMKS2) not in SSSTDPP MS (market sector)',
        (t3, f3) AS 'LSACMSP-503|Invalid Values|MARKET SECTOR 3 (POMKS3) not in SSSTDPP MS (market sector)',
        (t4, f4) AS 'LSACMSP-504|Format|CURRENCY (POCYCD) not a valid ISO currency code (3 letters; SSCYIFP not in extract)',
        (t5, f5) AS 'LSACMSP-505|Missing Links|Branch (POACB) not found in SSBRCPP',
        (t6, f6) AS 'LSACMSP-506|Missing Links|Product type (POAPTY) not found in any PDCPP (DD/TD/LS/PL/DC)'
      ))
    UNION ALL
/* =============================================================================
   LSPMHSP - LS LOANS PAYMENT HISTORY FILE
   Πίνακας: DATACUT5."HUB_MT_LSPMHSP"   Shadow: δεν υπάρχει mode flag   Έλεγχοι: 3
   Έλεγχοι από τους κανόνες της στήλης Free column του DD v1.24.
   ============================================================================= */
    SELECT 'LSPMHSP - LS LOANS PAYMENT HISTORY FILE' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- LSPMHSP-501: Account (CNACB+CNACS+CNACX) not found in any account master (DD/LS/TD/PL/DC/IE/GL ACMSP)
          COUNT(CASE WHEN NVL(s.n_cnacs, 0) &lt;&gt; 0 THEN 1 END) AS t1,
          COUNT(CASE WHEN NVL(s.n_cnacs, 0) &lt;&gt; 0 AND j1.k1 IS NULL THEN 1 END) AS f1,
          -- LSPMHSP-502: PAYMENT CURRENCY (CNPCCY) not a valid ISO currency code (3 letters; SSCYIFP not in extract)
          COUNT(CASE WHEN TRIM(s."CNPCCY") IS NOT NULL THEN 1 END) AS t2,
          COUNT(CASE WHEN TRIM(s."CNPCCY") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."CNPCCY"), '^[A-Z]{3}$') THEN 1 END) AS f2,
          -- LSPMHSP-503: Product type (CNAPTY) not found in any PDCPP (DD/TD/LS/PL/DC)
          COUNT(CASE WHEN TRIM(s."CNAPTY") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."CNAPTY"), '^[0. ]*$') THEN 1 END) AS t3,
          COUNT(CASE WHEN TRIM(s."CNAPTY") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."CNAPTY"), '^[0. ]*$') AND j2.code IS NULL THEN 1 END) AS f3
        FROM (
              SELECT t."CNAPTY",
                     t."CNPCCY",
                     (CASE WHEN VALIDATE_CONVERSION(TRIM(t."CNACB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."CNACB")) END) AS n_cnacb,
                     (CASE WHEN VALIDATE_CONVERSION(TRIM(t."CNACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."CNACS")) END) AS n_cnacs,
                     (CASE WHEN VALIDATE_CONVERSION(TRIM(t."CNACX") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."CNACX")) END) AS n_cnacx
                FROM DATACUT5."HUB_MT_LSPMHSP" t
        ) s
        LEFT JOIN k_acc j1 ON j1.k1 = s.n_cnacb AND j1.k2 = s.n_cnacs AND j1.k3 = s.n_cnacx
        LEFT JOIN ref_apty j2 ON j2.code = TRIM(s."CNAPTY")
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'LSPMHSP-501|Missing Links|Account (CNACB+CNACS+CNACX) not found in any account master (DD/LS/TD/PL/DC/IE/GL ACMSP)',
        (t2, f2) AS 'LSPMHSP-502|Format|PAYMENT CURRENCY (CNPCCY) not a valid ISO currency code (3 letters; SSCYIFP not in extract)',
        (t3, f3) AS 'LSPMHSP-503|Missing Links|Product type (CNAPTY) not found in any PDCPP (DD/TD/LS/PL/DC)'
      ))
    UNION ALL
/* =============================================================================
   LSSPCPP - LS SUB PRODUCT CONTROL FILE
   Πίνακας: DATACUT5."HUB_MT_LSSPCPP"   Shadow: QIMDFL = 'S' (εξαιρούνται)   Έλεγχοι: 2
   Έλεγχοι από τους κανόνες της στήλης Free column του DD v1.24.
   ============================================================================= */
    SELECT 'LSSPCPP - LS SUB PRODUCT CONTROL FILE' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- LSSPCPP-501: CURRENCY (QICYCD) not a valid ISO currency code (3 letters; SSCYIFP not in extract)
          COUNT(CASE WHEN TRIM(s."QICYCD") IS NOT NULL THEN 1 END) AS t1,
          COUNT(CASE WHEN TRIM(s."QICYCD") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."QICYCD"), '^[A-Z]{3}$') THEN 1 END) AS f1,
          -- LSSPCPP-502: Product type (QIAPTY) not found in any PDCPP (DD/TD/LS/PL/DC)
          COUNT(CASE WHEN TRIM(s."QIAPTY") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."QIAPTY"), '^[0. ]*$') THEN 1 END) AS t2,
          COUNT(CASE WHEN TRIM(s."QIAPTY") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."QIAPTY"), '^[0. ]*$') AND j1.code IS NULL THEN 1 END) AS f2
        FROM (
              SELECT t."QIAPTY",
                     t."QICYCD"
                FROM DATACUT5."HUB_MT_LSSPCPP" t
               WHERE NVL(t."QIMDFL",' ') &lt;&gt; 'S'
        ) s
        LEFT JOIN ref_apty j1 ON j1.code = TRIM(s."QIAPTY")
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'LSSPCPP-501|Format|CURRENCY (QICYCD) not a valid ISO currency code (3 letters; SSCYIFP not in extract)',
        (t2, f2) AS 'LSSPCPP-502|Missing Links|Product type (QIAPTY) not found in any PDCPP (DD/TD/LS/PL/DC)'
      ))
    UNION ALL
/* =============================================================================
   ORCOMSP - OR Cashier Order Master
   Πίνακας: DATACUT5."HUB_MT_ORCOMSP"   Shadow: ORMDFL = 'S' (εξαιρούνται)   Έλεγχοι: 1
   Έλεγχοι από τους κανόνες της στήλης Free column του DD v1.24.
   ============================================================================= */
    SELECT 'ORCOMSP - OR Cashier Order Master' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- ORCOMSP-501: Cashier Order Currency (ORCOCY) not a valid ISO currency code (3 letters; SSCYIFP not in extract)
          COUNT(CASE WHEN TRIM(s."ORCOCY") IS NOT NULL THEN 1 END) AS t1,
          COUNT(CASE WHEN TRIM(s."ORCOCY") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."ORCOCY"), '^[A-Z]{3}$') THEN 1 END) AS f1
        FROM (
              SELECT t."ORCOCY"
                FROM DATACUT5."HUB_MT_ORCOMSP" t
               WHERE NVL(t."ORMDFL",' ') &lt;&gt; 'S'
        ) s
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'ORCOMSP-501|Format|Cashier Order Currency (ORCOCY) not a valid ISO currency code (3 letters; SSCYIFP not in extract)'
      ))
    UNION ALL
/* =============================================================================
   PLACMSP - PGL A/C Information Master File
   Πίνακας: DATACUT5."HUB_MT_PLACMSP"   Shadow: PFMDFL = 'S' (εξαιρούνται)   Έλεγχοι: 7
   Έλεγχοι από τους κανόνες της στήλης Free column του DD v1.24.
   ============================================================================= */
    SELECT 'PLACMSP - PGL A/C Information Master File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- PLACMSP-501: Market Sector 1 (PFMKS1) not in SSSTDPP MS (market sector)
          COUNT(CASE WHEN TRIM(s."PFMKS1") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."PFMKS1"), '^[0. ]*$') THEN 1 END) AS t1,
          COUNT(CASE WHEN TRIM(s."PFMKS1") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."PFMKS1"), '^[0. ]*$') AND j1.code IS NULL THEN 1 END) AS f1,
          -- PLACMSP-502: Market Sector 2 (PFMKS2) not in SSSTDPP MS (market sector)
          COUNT(CASE WHEN TRIM(s."PFMKS2") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."PFMKS2"), '^[0. ]*$') THEN 1 END) AS t2,
          COUNT(CASE WHEN TRIM(s."PFMKS2") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."PFMKS2"), '^[0. ]*$') AND j2.code IS NULL THEN 1 END) AS f2,
          -- PLACMSP-503: Market Sector 3 (PFMKS3) not in SSSTDPP MS (market sector)
          COUNT(CASE WHEN TRIM(s."PFMKS3") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."PFMKS3"), '^[0. ]*$') THEN 1 END) AS t3,
          COUNT(CASE WHEN TRIM(s."PFMKS3") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."PFMKS3"), '^[0. ]*$') AND j3.code IS NULL THEN 1 END) AS f3,
          -- PLACMSP-504: Currency (PFCYCD) not a valid ISO currency code (3 letters; SSCYIFP not in extract)
          COUNT(CASE WHEN TRIM(s."PFCYCD") IS NOT NULL THEN 1 END) AS t4,
          COUNT(CASE WHEN TRIM(s."PFCYCD") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."PFCYCD"), '^[A-Z]{3}$') THEN 1 END) AS f4,
          -- PLACMSP-505: GHO classification (PFGHCL) not found in SSGHCLP
          COUNT(CASE WHEN TRIM(s."PFGHCL") IS NOT NULL THEN 1 END) AS t5,
          COUNT(CASE WHEN TRIM(s."PFGHCL") IS NOT NULL AND j4.code IS NULL THEN 1 END) AS f5,
          -- PLACMSP-506: Branch (PFACB) not found in SSBRCPP
          COUNT(CASE WHEN NVL(s.n_pfacb, 0) &lt;&gt; 0 THEN 1 END) AS t6,
          COUNT(CASE WHEN NVL(s.n_pfacb, 0) &lt;&gt; 0 AND j5.brn IS NULL THEN 1 END) AS f6,
          -- PLACMSP-507: Product type (PFAPTY) not found in any PDCPP (DD/TD/LS/PL/DC)
          COUNT(CASE WHEN TRIM(s."PFAPTY") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."PFAPTY"), '^[0. ]*$') THEN 1 END) AS t7,
          COUNT(CASE WHEN TRIM(s."PFAPTY") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."PFAPTY"), '^[0. ]*$') AND j6.code IS NULL THEN 1 END) AS f7
        FROM (
              SELECT t."PFAPTY",
                     t."PFCYCD",
                     t."PFGHCL",
                     t."PFMKS1",
                     t."PFMKS2",
                     t."PFMKS3",
                     (CASE WHEN VALIDATE_CONVERSION(TRIM(t."PFACB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."PFACB")) END) AS n_pfacb
                FROM DATACUT5."HUB_MT_PLACMSP" t
               WHERE NVL(t."PFMDFL",' ') &lt;&gt; 'S'
        ) s
        LEFT JOIN ref_std_ms j1 ON j1.code = NVL(LTRIM(TRIM(s."PFMKS1"), '0'), '0')
        LEFT JOIN ref_std_ms j2 ON j2.code = NVL(LTRIM(TRIM(s."PFMKS2"), '0'), '0')
        LEFT JOIN ref_std_ms j3 ON j3.code = NVL(LTRIM(TRIM(s."PFMKS3"), '0'), '0')
        LEFT JOIN k_ghcl j4 ON j4.code = TRIM(s."PFGHCL")
        LEFT JOIN k_brn j5 ON j5.brn = s.n_pfacb
        LEFT JOIN ref_apty j6 ON j6.code = TRIM(s."PFAPTY")
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'PLACMSP-501|Invalid Values|Market Sector 1 (PFMKS1) not in SSSTDPP MS (market sector)',
        (t2, f2) AS 'PLACMSP-502|Invalid Values|Market Sector 2 (PFMKS2) not in SSSTDPP MS (market sector)',
        (t3, f3) AS 'PLACMSP-503|Invalid Values|Market Sector 3 (PFMKS3) not in SSSTDPP MS (market sector)',
        (t4, f4) AS 'PLACMSP-504|Format|Currency (PFCYCD) not a valid ISO currency code (3 letters; SSCYIFP not in extract)',
        (t5, f5) AS 'PLACMSP-505|Missing Links|GHO classification (PFGHCL) not found in SSGHCLP',
        (t6, f6) AS 'PLACMSP-506|Missing Links|Branch (PFACB) not found in SSBRCPP',
        (t7, f7) AS 'PLACMSP-507|Missing Links|Product type (PFAPTY) not found in any PDCPP (DD/TD/LS/PL/DC)'
      ))
    UNION ALL
/* =============================================================================
   PLSPCPP - Progressive Ledger Sub-product Control File
   Πίνακας: DATACUT5."HUB_MT_PLSPCPP"   Shadow: PBMDFL = 'S' (εξαιρούνται)   Έλεγχοι: 2
   Έλεγχοι από τους κανόνες της στήλης Free column του DD v1.24.
   ============================================================================= */
    SELECT 'PLSPCPP - Progressive Ledger Sub-product Control File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- PLSPCPP-501: Currency (PBCYCD) not a valid ISO currency code (3 letters; SSCYIFP not in extract)
          COUNT(CASE WHEN TRIM(s."PBCYCD") IS NOT NULL THEN 1 END) AS t1,
          COUNT(CASE WHEN TRIM(s."PBCYCD") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."PBCYCD"), '^[A-Z]{3}$') THEN 1 END) AS f1,
          -- PLSPCPP-502: Product type (PBAPTY) not found in any PDCPP (DD/TD/LS/PL/DC)
          COUNT(CASE WHEN TRIM(s."PBAPTY") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."PBAPTY"), '^[0. ]*$') THEN 1 END) AS t2,
          COUNT(CASE WHEN TRIM(s."PBAPTY") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."PBAPTY"), '^[0. ]*$') AND j1.code IS NULL THEN 1 END) AS f2
        FROM (
              SELECT t."PBAPTY",
                     t."PBCYCD"
                FROM DATACUT5."HUB_MT_PLSPCPP" t
               WHERE NVL(t."PBMDFL",' ') &lt;&gt; 'S'
        ) s
        LEFT JOIN ref_apty j1 ON j1.code = TRIM(s."PBAPTY")
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'PLSPCPP-501|Format|Currency (PBCYCD) not a valid ISO currency code (3 letters; SSCYIFP not in extract)',
        (t2, f2) AS 'PLSPCPP-502|Missing Links|Product type (PBAPTY) not found in any PDCPP (DD/TD/LS/PL/DC)'
      ))
    UNION ALL
/* =============================================================================
   SS@BMNP - BW3 Next Payment Details
   Πίνακας: DATACUT5."HUB_MT_SS@BMNP"   Shadow: δεν υπάρχει mode flag   Έλεγχοι: 3
   Έλεγχοι από τους κανόνες της στήλης Free column του DD v1.24.
   ============================================================================= */
    SELECT 'SS@BMNP - BW3 Next Payment Details' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- SS_BMNP-501: Nationality Code (BWNATY) not in SSSTDPP CT (country code)
          COUNT(CASE WHEN TRIM(s."BWNATY") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."BWNATY"), '^[0. ]*$') THEN 1 END) AS t1,
          COUNT(CASE WHEN TRIM(s."BWNATY") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."BWNATY"), '^[0. ]*$') AND j1.code IS NULL THEN 1 END) AS f1,
          -- SS_BMNP-502: Country of Registration/Residence (BWCTRS) not in SSSTDPP CT (country code)
          COUNT(CASE WHEN TRIM(s."BWCTRS") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."BWCTRS"), '^[0. ]*$') THEN 1 END) AS t2,
          COUNT(CASE WHEN TRIM(s."BWCTRS") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."BWCTRS"), '^[0. ]*$') AND j2.code IS NULL THEN 1 END) AS f2,
          -- SS_BMNP-503: BW3 Currency (BWCYCD) not a valid ISO currency code (3 letters; SSCYIFP not in extract)
          COUNT(CASE WHEN TRIM(s."BWCYCD") IS NOT NULL THEN 1 END) AS t3,
          COUNT(CASE WHEN TRIM(s."BWCYCD") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."BWCYCD"), '^[A-Z]{3}$') THEN 1 END) AS f3
        FROM (
              SELECT t."BWCTRS",
                     t."BWCYCD",
                     t."BWNATY"
                FROM DATACUT5."HUB_MT_SS@BMNP" t
        ) s
        LEFT JOIN ref_std_ct j1 ON j1.code = NVL(LTRIM(TRIM(s."BWNATY"), '0'), '0')
        LEFT JOIN ref_std_ct j2 ON j2.code = NVL(LTRIM(TRIM(s."BWCTRS"), '0'), '0')
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'SS_BMNP-501|Invalid Values|Nationality Code (BWNATY) not in SSSTDPP CT (country code)',
        (t2, f2) AS 'SS_BMNP-502|Invalid Values|Country of Registration/Residence (BWCTRS) not in SSSTDPP CT (country code)',
        (t3, f3) AS 'SS_BMNP-503|Format|BW3 Currency (BWCYCD) not a valid ISO currency code (3 letters; SSCYIFP not in extract)'
      ))
    UNION ALL
/* =============================================================================
   SS@CACP - CAA Product Control File
   Πίνακας: DATACUT5."HUB_MT_SS@CACP"   Shadow: δεν υπάρχει mode flag   Έλεγχοι: 1
   Έλεγχοι από τους κανόνες της στήλης Free column του DD v1.24.
   ============================================================================= */
    SELECT 'SS@CACP - CAA Product Control File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- SS_CACP-501: Product type (ACAPTY) not found in any PDCPP (DD/TD/LS/PL/DC)
          COUNT(CASE WHEN TRIM(s."ACAPTY") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."ACAPTY"), '^[0. ]*$') THEN 1 END) AS t1,
          COUNT(CASE WHEN TRIM(s."ACAPTY") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."ACAPTY"), '^[0. ]*$') AND j1.code IS NULL THEN 1 END) AS f1
        FROM (
              SELECT t."ACAPTY"
                FROM DATACUT5."HUB_MT_SS@CACP" t
        ) s
        LEFT JOIN ref_apty j1 ON j1.code = TRIM(s."ACAPTY")
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'SS_CACP-501|Missing Links|Product type (ACAPTY) not found in any PDCPP (DD/TD/LS/PL/DC)'
      ))
    UNION ALL
/* =============================================================================
   SS@CAIFP - Company Management Information File
   Πίνακας: DATACUT5."HUB_MT_SS@CAIFP"   Shadow: δεν υπάρχει mode flag   Έλεγχοι: 2
   Έλεγχοι από τους κανόνες της στήλης Free column του DD v1.24.
   ============================================================================= */
    SELECT 'SS@CAIFP - Company Management Information File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- SS_CAIFP-501: Customer Code (Z@CTCG) not in SSSTDPP B9 (customer code)
          COUNT(CASE WHEN TRIM(s."Z@CTCG") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."Z@CTCG"), '^[0. ]*$') THEN 1 END) AS t1,
          COUNT(CASE WHEN TRIM(s."Z@CTCG") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."Z@CTCG"), '^[0. ]*$') AND j1.code IS NULL THEN 1 END) AS f1,
          -- SS_CAIFP-502: Phone banking number (Z@PBN) not found in EBCUSTP
          COUNT(CASE WHEN NVL(s.n_z_pbn, 0) &lt;&gt; 0 THEN 1 END) AS t2,
          COUNT(CASE WHEN NVL(s.n_z_pbn, 0) &lt;&gt; 0 AND j2.pbn IS NULL THEN 1 END) AS f2
        FROM (
              SELECT t."Z@CTCG",
                     (CASE WHEN VALIDATE_CONVERSION(TRIM(t."Z@PBN") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."Z@PBN")) END) AS n_z_pbn
                FROM DATACUT5."HUB_MT_SS@CAIFP" t
        ) s
        LEFT JOIN ref_std_b9 j1 ON j1.code = NVL(LTRIM(TRIM(s."Z@CTCG"), '0'), '0')
        LEFT JOIN k_pbn j2 ON j2.pbn = s.n_z_pbn
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'SS_CAIFP-501|Invalid Values|Customer Code (Z@CTCG) not in SSSTDPP B9 (customer code)',
        (t2, f2) AS 'SS_CAIFP-502|Missing Links|Phone banking number (Z@PBN) not found in EBCUSTP'
      ))
    UNION ALL
/* =============================================================================
   SS@CAJP - Credit Application Approval Journal File
   Πίνακας: DATACUT5."HUB_MT_SS@CAJP"   Shadow: δεν υπάρχει mode flag   Έλεγχοι: 4
   Έλεγχοι από τους κανόνες της στήλης Free column του DD v1.24.
   ============================================================================= */
    SELECT 'SS@CAJP - Credit Application Approval Journal File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- SS_CAJP-501: Account (CAACB+CAACS+CAACX) not found in any account master (DD/LS/TD/PL/DC/IE/GL ACMSP)
          COUNT(CASE WHEN NVL(s.n_caacs, 0) &lt;&gt; 0 THEN 1 END) AS t1,
          COUNT(CASE WHEN NVL(s.n_caacs, 0) &lt;&gt; 0 AND j1.k1 IS NULL THEN 1 END) AS f1,
          -- SS_CAJP-502: Market Sector 1 (CAMKS1) not in SSSTDPP MS (market sector)
          COUNT(CASE WHEN TRIM(s."CAMKS1") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."CAMKS1"), '^[0. ]*$') THEN 1 END) AS t2,
          COUNT(CASE WHEN TRIM(s."CAMKS1") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."CAMKS1"), '^[0. ]*$') AND j2.code IS NULL THEN 1 END) AS f2,
          -- SS_CAJP-503: Currency (CACYCD) not a valid ISO currency code (3 letters; SSCYIFP not in extract)
          COUNT(CASE WHEN TRIM(s."CACYCD") IS NOT NULL THEN 1 END) AS t3,
          COUNT(CASE WHEN TRIM(s."CACYCD") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."CACYCD"), '^[A-Z]{3}$') THEN 1 END) AS f3,
          -- SS_CAJP-504: Product type (CAAPTY) not found in any PDCPP (DD/TD/LS/PL/DC)
          COUNT(CASE WHEN TRIM(s."CAAPTY") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."CAAPTY"), '^[0. ]*$') THEN 1 END) AS t4,
          COUNT(CASE WHEN TRIM(s."CAAPTY") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."CAAPTY"), '^[0. ]*$') AND j3.code IS NULL THEN 1 END) AS f4
        FROM (
              SELECT t."CAAPTY",
                     t."CACYCD",
                     t."CAMKS1",
                     (CASE WHEN VALIDATE_CONVERSION(TRIM(t."CAACB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."CAACB")) END) AS n_caacb,
                     (CASE WHEN VALIDATE_CONVERSION(TRIM(t."CAACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."CAACS")) END) AS n_caacs,
                     (CASE WHEN VALIDATE_CONVERSION(TRIM(t."CAACX") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."CAACX")) END) AS n_caacx
                FROM DATACUT5."HUB_MT_SS@CAJP" t
        ) s
        LEFT JOIN k_acc j1 ON j1.k1 = s.n_caacb AND j1.k2 = s.n_caacs AND j1.k3 = s.n_caacx
        LEFT JOIN ref_std_ms j2 ON j2.code = NVL(LTRIM(TRIM(s."CAMKS1"), '0'), '0')
        LEFT JOIN ref_apty j3 ON j3.code = TRIM(s."CAAPTY")
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'SS_CAJP-501|Missing Links|Account (CAACB+CAACS+CAACX) not found in any account master (DD/LS/TD/PL/DC/IE/GL ACMSP)',
        (t2, f2) AS 'SS_CAJP-502|Invalid Values|Market Sector 1 (CAMKS1) not in SSSTDPP MS (market sector)',
        (t3, f3) AS 'SS_CAJP-503|Format|Currency (CACYCD) not a valid ISO currency code (3 letters; SSCYIFP not in extract)',
        (t4, f4) AS 'SS_CAJP-504|Missing Links|Product type (CAAPTY) not found in any PDCPP (DD/TD/LS/PL/DC)'
      ))
    UNION ALL
/* =============================================================================
   SS@FRBP - FORBEARANCE RECORDS
   Πίνακας: DATACUT5."HUB_MT_SS@FRBP"   Shadow: δεν υπάρχει mode flag   Έλεγχοι: 1
   Έλεγχοι από τους κανόνες της στήλης Free column του DD v1.24.
   ============================================================================= */
    SELECT 'SS@FRBP - FORBEARANCE RECORDS' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- SS_FRBP-501: Account (FRACB+FRACS+FRACX) not found in any account master (DD/LS/TD/PL/DC/IE/GL ACMSP)
          COUNT(CASE WHEN NVL(s.n_fracs, 0) &lt;&gt; 0 THEN 1 END) AS t1,
          COUNT(CASE WHEN NVL(s.n_fracs, 0) &lt;&gt; 0 AND j1.k1 IS NULL THEN 1 END) AS f1
        FROM (
              SELECT (CASE WHEN VALIDATE_CONVERSION(TRIM(t."FRACB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."FRACB")) END) AS n_fracb,
                     (CASE WHEN VALIDATE_CONVERSION(TRIM(t."FRACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."FRACS")) END) AS n_fracs,
                     (CASE WHEN VALIDATE_CONVERSION(TRIM(t."FRACX") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."FRACX")) END) AS n_fracx
                FROM DATACUT5."HUB_MT_SS@FRBP" t
        ) s
        LEFT JOIN k_acc j1 ON j1.k1 = s.n_fracb AND j1.k2 = s.n_fracs AND j1.k3 = s.n_fracx
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'SS_FRBP-501|Missing Links|Account (FRACB+FRACS+FRACX) not found in any account master (DD/LS/TD/PL/DC/IE/GL ACMSP)'
      ))
    UNION ALL
/* =============================================================================
   SS@ICIP - Local Customer Information File
   Πίνακας: DATACUT5."HUB_MT_SS@ICIP"   Shadow: LCMDFL = 'S' (εξαιρούνται)   Έλεγχοι: 1
   Έλεγχοι από τους κανόνες της στήλης Free column του DD v1.24.
   ============================================================================= */
    SELECT 'SS@ICIP - Local Customer Information File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- SS_ICIP-501: Customer (LCDCB+LCDCS) not found in SSCUSTP
          COUNT(CASE WHEN NVL(s.n_lcdcb, 0) &lt;&gt; 0 AND NVL(s.n_lcdcs, 0) &lt;&gt; 0 THEN 1 END) AS t1,
          COUNT(CASE WHEN NVL(s.n_lcdcb, 0) &lt;&gt; 0 AND NVL(s.n_lcdcs, 0) &lt;&gt; 0 AND j1.dcb IS NULL THEN 1 END) AS f1
        FROM (
              SELECT (CASE WHEN VALIDATE_CONVERSION(TRIM(t."LCDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."LCDCB")) END) AS n_lcdcb,
                     (CASE WHEN VALIDATE_CONVERSION(TRIM(t."LCDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."LCDCS")) END) AS n_lcdcs
                FROM DATACUT5."HUB_MT_SS@ICIP" t
               WHERE NVL(t."LCMDFL",' ') &lt;&gt; 'S'
        ) s
        LEFT JOIN k_cus j1 ON j1.dcb = s.n_lcdcb AND j1.dcs = s.n_lcdcs
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'SS_ICIP-501|Missing Links|Customer (LCDCB+LCDCS) not found in SSCUSTP'
      ))
    UNION ALL
/* =============================================================================
   SS@LDDP - Loan Drawdown Details for VAT regulatory reporting
   Πίνακας: DATACUT5."HUB_MT_SS@LDDP"   Shadow: δεν υπάρχει mode flag   Έλεγχοι: 2
   Έλεγχοι από τους κανόνες της στήλης Free column του DD v1.24.
   ============================================================================= */
    SELECT 'SS@LDDP - Loan Drawdown Details for VAT regulatory reporting' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- SS_LDDP-501: VAT Country Code (LDVTCC) not in SSSTDPP CT (country code)
          COUNT(CASE WHEN TRIM(s."LDVTCC") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."LDVTCC"), '^[0. ]*$') THEN 1 END) AS t1,
          COUNT(CASE WHEN TRIM(s."LDVTCC") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."LDVTCC"), '^[0. ]*$') AND j1.code IS NULL THEN 1 END) AS f1,
          -- SS_LDDP-502: Currency (LDCYCD) not a valid ISO currency code (3 letters; SSCYIFP not in extract)
          COUNT(CASE WHEN TRIM(s."LDCYCD") IS NOT NULL THEN 1 END) AS t2,
          COUNT(CASE WHEN TRIM(s."LDCYCD") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."LDCYCD"), '^[A-Z]{3}$') THEN 1 END) AS f2
        FROM (
              SELECT t."LDCYCD",
                     t."LDVTCC"
                FROM DATACUT5."HUB_MT_SS@LDDP" t
        ) s
        LEFT JOIN ref_std_ct j1 ON j1.code = NVL(LTRIM(TRIM(s."LDVTCC"), '0'), '0')
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'SS_LDDP-501|Invalid Values|VAT Country Code (LDVTCC) not in SSSTDPP CT (country code)',
        (t2, f2) AS 'SS_LDDP-502|Format|Currency (LDCYCD) not a valid ISO currency code (3 letters; SSCYIFP not in extract)'
      ))
    UNION ALL
/* =============================================================================
   SS@NCUSP - Connected Party Non-Customer File
   Πίνακας: DATACUT5."HUB_MT_SS@NCUSP"   Shadow: ZWMDFL = 'S' (εξαιρούνται)   Έλεγχοι: 7
   Έλεγχοι από τους κανόνες της στήλης Free column του DD v1.24.
   ============================================================================= */
    SELECT 'SS@NCUSP - Connected Party Non-Customer File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- SS_NCUSP-501: Occupation Code (ZWOCPT) not in SSSTDPP OC (occupation code)
          COUNT(CASE WHEN TRIM(s."ZWOCPT") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."ZWOCPT"), '^[0. ]*$') THEN 1 END) AS t1,
          COUNT(CASE WHEN TRIM(s."ZWOCPT") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."ZWOCPT"), '^[0. ]*$') AND j1.code IS NULL THEN 1 END) AS f1,
          -- SS_NCUSP-502: Industry Code (ZWINDY) not in SSSTDPP IY (industry code)
          COUNT(CASE WHEN TRIM(s."ZWINDY") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."ZWINDY"), '^[0. ]*$') THEN 1 END) AS t2,
          COUNT(CASE WHEN TRIM(s."ZWINDY") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."ZWINDY"), '^[0. ]*$') AND j2.code IS NULL THEN 1 END) AS f2,
          -- SS_NCUSP-503: Race (ZWRACE) not in SSSTDPP CT (country code)
          COUNT(CASE WHEN TRIM(s."ZWRACE") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."ZWRACE"), '^[0. ]*$') THEN 1 END) AS t3,
          COUNT(CASE WHEN TRIM(s."ZWRACE") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."ZWRACE"), '^[0. ]*$') AND j3.code IS NULL THEN 1 END) AS f3,
          -- SS_NCUSP-504: Market Sector 1 (ZWMKS1) not in SSSTDPP MS (market sector)
          COUNT(CASE WHEN TRIM(s."ZWMKS1") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."ZWMKS1"), '^[0. ]*$') THEN 1 END) AS t4,
          COUNT(CASE WHEN TRIM(s."ZWMKS1") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."ZWMKS1"), '^[0. ]*$') AND j4.code IS NULL THEN 1 END) AS f4,
          -- SS_NCUSP-505: Dual Citizenship (ZWDUCD) not in SSSTDPP CT (country code)
          COUNT(CASE WHEN TRIM(s."ZWDUCD") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."ZWDUCD"), '^[0. ]*$') THEN 1 END) AS t5,
          COUNT(CASE WHEN TRIM(s."ZWDUCD") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."ZWDUCD"), '^[0. ]*$') AND j5.code IS NULL THEN 1 END) AS f5,
          -- SS_NCUSP-506: Third Citizenship (ZWTCTD) not in SSSTDPP CT (country code)
          COUNT(CASE WHEN TRIM(s."ZWTCTD") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."ZWTCTD"), '^[0. ]*$') THEN 1 END) AS t6,
          COUNT(CASE WHEN TRIM(s."ZWTCTD") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."ZWTCTD"), '^[0. ]*$') AND j6.code IS NULL THEN 1 END) AS f6,
          -- SS_NCUSP-507: GHO classification (ZWGHCL) not found in SSGHCLP
          COUNT(CASE WHEN TRIM(s."ZWGHCL") IS NOT NULL THEN 1 END) AS t7,
          COUNT(CASE WHEN TRIM(s."ZWGHCL") IS NOT NULL AND j7.code IS NULL THEN 1 END) AS f7
        FROM (
              SELECT t."ZWDUCD",
                     t."ZWGHCL",
                     t."ZWINDY",
                     t."ZWMKS1",
                     t."ZWOCPT",
                     t."ZWRACE",
                     t."ZWTCTD"
                FROM DATACUT5."HUB_MT_SS@NCUSP" t
               WHERE NVL(t."ZWMDFL",' ') &lt;&gt; 'S'
        ) s
        LEFT JOIN ref_std_oc j1 ON j1.code = NVL(LTRIM(TRIM(s."ZWOCPT"), '0'), '0')
        LEFT JOIN ref_std_iy j2 ON j2.code = NVL(LTRIM(TRIM(s."ZWINDY"), '0'), '0')
        LEFT JOIN ref_std_ct j3 ON j3.code = NVL(LTRIM(TRIM(s."ZWRACE"), '0'), '0')
        LEFT JOIN ref_std_ms j4 ON j4.code = NVL(LTRIM(TRIM(s."ZWMKS1"), '0'), '0')
        LEFT JOIN ref_std_ct j5 ON j5.code = NVL(LTRIM(TRIM(s."ZWDUCD"), '0'), '0')
        LEFT JOIN ref_std_ct j6 ON j6.code = NVL(LTRIM(TRIM(s."ZWTCTD"), '0'), '0')
        LEFT JOIN k_ghcl j7 ON j7.code = TRIM(s."ZWGHCL")
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'SS_NCUSP-501|Invalid Values|Occupation Code (ZWOCPT) not in SSSTDPP OC (occupation code)',
        (t2, f2) AS 'SS_NCUSP-502|Invalid Values|Industry Code (ZWINDY) not in SSSTDPP IY (industry code)',
        (t3, f3) AS 'SS_NCUSP-503|Invalid Values|Race (ZWRACE) not in SSSTDPP CT (country code)',
        (t4, f4) AS 'SS_NCUSP-504|Invalid Values|Market Sector 1 (ZWMKS1) not in SSSTDPP MS (market sector)',
        (t5, f5) AS 'SS_NCUSP-505|Invalid Values|Dual Citizenship (ZWDUCD) not in SSSTDPP CT (country code)',
        (t6, f6) AS 'SS_NCUSP-506|Invalid Values|Third Citizenship (ZWTCTD) not in SSSTDPP CT (country code)',
        (t7, f7) AS 'SS_NCUSP-507|Missing Links|GHO classification (ZWGHCL) not found in SSGHCLP'
      ))
    UNION ALL
/* =============================================================================
   SS@PDFP - PAD Statement Final Transmission File
   Πίνακας: DATACUT5."HUB_MT_SS@PDFP"   Shadow: δεν υπάρχει mode flag   Έλεγχοι: 1
   Έλεγχοι από τους κανόνες της στήλης Free column του DD v1.24.
   ============================================================================= */
    SELECT 'SS@PDFP - PAD Statement Final Transmission File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- SS_PDFP-503: Currency Code (PDPCYCDR) not a valid ISO currency code (3 letters; SSCYIFP not in extract)
          COUNT(CASE WHEN TRIM(s."PDPCYCDR") IS NOT NULL THEN 1 END) AS t1,
          COUNT(CASE WHEN TRIM(s."PDPCYCDR") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."PDPCYCDR"), '^[A-Z]{3}$') THEN 1 END) AS f1
        FROM (
              SELECT t."PDPCYCDR"
                FROM DATACUT5."HUB_MT_SS@PDFP" t
        ) s
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'SS_PDFP-503|Format|Currency Code (PDPCYCDR) not a valid ISO currency code (3 letters; SSCYIFP not in extract)'
      ))
    UNION ALL
/* =============================================================================
   SS@PDRP - PAD Statement Customer Static Master Data File
   Πίνακας: DATACUT5."HUB_MT_SS@PDRP"   Shadow: δεν υπάρχει mode flag   Έλεγχοι: 1
   Έλεγχοι από τους κανόνες της στήλης Free column του DD v1.24.
   ============================================================================= */
    SELECT 'SS@PDRP - PAD Statement Customer Static Master Data File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- SS_PDRP-501: Phone banking number (PDRPBN) not found in EBCUSTP
          COUNT(CASE WHEN NVL(s.n_pdrpbn, 0) &lt;&gt; 0 THEN 1 END) AS t1,
          COUNT(CASE WHEN NVL(s.n_pdrpbn, 0) &lt;&gt; 0 AND j1.pbn IS NULL THEN 1 END) AS f1
        FROM (
              SELECT (CASE WHEN VALIDATE_CONVERSION(TRIM(t."PDRPBN") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."PDRPBN")) END) AS n_pdrpbn
                FROM DATACUT5."HUB_MT_SS@PDRP" t
        ) s
        LEFT JOIN k_pbn j1 ON j1.pbn = s.n_pdrpbn
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'SS_PDRP-501|Missing Links|Phone banking number (PDRPBN) not found in EBCUSTP'
      ))
    UNION ALL
/* =============================================================================
   SS@TXCP - Local S/I Transaction Control File
   Πίνακας: DATACUT5."HUB_MT_SS@TXCP"   Shadow: δεν υπάρχει mode flag   Έλεγχοι: 1
   Έλεγχοι από τους κανόνες της στήλης Free column του DD v1.24.
   ============================================================================= */
    SELECT 'SS@TXCP - Local S/I Transaction Control File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- SS_TXCP-501: Currency (X1CYCD) not a valid ISO currency code (3 letters; SSCYIFP not in extract)
          COUNT(CASE WHEN TRIM(s."X1CYCD") IS NOT NULL THEN 1 END) AS t1,
          COUNT(CASE WHEN TRIM(s."X1CYCD") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."X1CYCD"), '^[A-Z]{3}$') THEN 1 END) AS f1
        FROM (
              SELECT t."X1CYCD"
                FROM DATACUT5."HUB_MT_SS@TXCP" t
        ) s
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'SS_TXCP-501|Format|Currency (X1CYCD) not a valid ISO currency code (3 letters; SSCYIFP not in extract)'
      ))
    UNION ALL
/* =============================================================================
   SSALSFP - Account Level Statistics File
   Πίνακας: DATACUT5."HUB_MT_SSALSFP"   Shadow: δεν υπάρχει mode flag   Έλεγχοι: 7
   Έλεγχοι από τους κανόνες της στήλης Free column του DD v1.24.
   ============================================================================= */
    SELECT 'SSALSFP - Account Level Statistics File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- SSALSFP-501: Account (ALACB+ALACS+ALACX) not found in any account master (DD/LS/TD/PL/DC/IE/GL ACMSP)
          COUNT(CASE WHEN NVL(s.n_alacs, 0) &lt;&gt; 0 THEN 1 END) AS t1,
          COUNT(CASE WHEN NVL(s.n_alacs, 0) &lt;&gt; 0 AND j1.k1 IS NULL THEN 1 END) AS f1,
          -- SSALSFP-502: Market Sector 1 (ALMKS1) not in SSSTDPP MS (market sector)
          COUNT(CASE WHEN TRIM(s."ALMKS1") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."ALMKS1"), '^[0. ]*$') THEN 1 END) AS t2,
          COUNT(CASE WHEN TRIM(s."ALMKS1") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."ALMKS1"), '^[0. ]*$') AND j2.code IS NULL THEN 1 END) AS f2,
          -- SSALSFP-503: Market Sector 2 (ALMKS2) not in SSSTDPP MS (market sector)
          COUNT(CASE WHEN TRIM(s."ALMKS2") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."ALMKS2"), '^[0. ]*$') THEN 1 END) AS t3,
          COUNT(CASE WHEN TRIM(s."ALMKS2") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."ALMKS2"), '^[0. ]*$') AND j3.code IS NULL THEN 1 END) AS f3,
          -- SSALSFP-504: Market Sector 3 (ALMKS3) not in SSSTDPP MS (market sector)
          COUNT(CASE WHEN TRIM(s."ALMKS3") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."ALMKS3"), '^[0. ]*$') THEN 1 END) AS t4,
          COUNT(CASE WHEN TRIM(s."ALMKS3") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."ALMKS3"), '^[0. ]*$') AND j4.code IS NULL THEN 1 END) AS f4,
          -- SSALSFP-505: Industry Code (ALINDY) not in SSSTDPP IY (industry code)
          COUNT(CASE WHEN TRIM(s."ALINDY") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."ALINDY"), '^[0. ]*$') THEN 1 END) AS t5,
          COUNT(CASE WHEN TRIM(s."ALINDY") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."ALINDY"), '^[0. ]*$') AND j5.code IS NULL THEN 1 END) AS f5,
          -- SSALSFP-506: Currency (ALCYCD) not a valid ISO currency code (3 letters; SSCYIFP not in extract)
          COUNT(CASE WHEN TRIM(s."ALCYCD") IS NOT NULL THEN 1 END) AS t6,
          COUNT(CASE WHEN TRIM(s."ALCYCD") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."ALCYCD"), '^[A-Z]{3}$') THEN 1 END) AS f6,
          -- SSALSFP-507: GHO classification (ALGHCL) not found in SSGHCLP
          COUNT(CASE WHEN TRIM(s."ALGHCL") IS NOT NULL THEN 1 END) AS t7,
          COUNT(CASE WHEN TRIM(s."ALGHCL") IS NOT NULL AND j6.code IS NULL THEN 1 END) AS f7
        FROM (
              SELECT t."ALCYCD",
                     t."ALGHCL",
                     t."ALINDY",
                     t."ALMKS1",
                     t."ALMKS2",
                     t."ALMKS3",
                     (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ALACB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ALACB")) END) AS n_alacb,
                     (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ALACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ALACS")) END) AS n_alacs,
                     (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ALACX") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ALACX")) END) AS n_alacx
                FROM DATACUT5."HUB_MT_SSALSFP" t
        ) s
        LEFT JOIN k_acc j1 ON j1.k1 = s.n_alacb AND j1.k2 = s.n_alacs AND j1.k3 = s.n_alacx
        LEFT JOIN ref_std_ms j2 ON j2.code = NVL(LTRIM(TRIM(s."ALMKS1"), '0'), '0')
        LEFT JOIN ref_std_ms j3 ON j3.code = NVL(LTRIM(TRIM(s."ALMKS2"), '0'), '0')
        LEFT JOIN ref_std_ms j4 ON j4.code = NVL(LTRIM(TRIM(s."ALMKS3"), '0'), '0')
        LEFT JOIN ref_std_iy j5 ON j5.code = NVL(LTRIM(TRIM(s."ALINDY"), '0'), '0')
        LEFT JOIN k_ghcl j6 ON j6.code = TRIM(s."ALGHCL")
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'SSALSFP-501|Missing Links|Account (ALACB+ALACS+ALACX) not found in any account master (DD/LS/TD/PL/DC/IE/GL ACMSP)',
        (t2, f2) AS 'SSALSFP-502|Invalid Values|Market Sector 1 (ALMKS1) not in SSSTDPP MS (market sector)',
        (t3, f3) AS 'SSALSFP-503|Invalid Values|Market Sector 2 (ALMKS2) not in SSSTDPP MS (market sector)',
        (t4, f4) AS 'SSALSFP-504|Invalid Values|Market Sector 3 (ALMKS3) not in SSSTDPP MS (market sector)',
        (t5, f5) AS 'SSALSFP-505|Invalid Values|Industry Code (ALINDY) not in SSSTDPP IY (industry code)',
        (t6, f6) AS 'SSALSFP-506|Format|Currency (ALCYCD) not a valid ISO currency code (3 letters; SSCYIFP not in extract)',
        (t7, f7) AS 'SSALSFP-507|Missing Links|GHO classification (ALGHCL) not found in SSGHCLP'
      ))
    UNION ALL
/* =============================================================================
   SSCAIFP - Company Management Information File
   Πίνακας: DATACUT5."HUB_MT_SSCAIFP"   Shadow: ZUMDFL = 'S' (εξαιρούνται)   Έλεγχοι: 2
   Έλεγχοι από τους κανόνες της στήλης Free column του DD v1.24.
   ============================================================================= */
    SELECT 'SSCAIFP - Company Management Information File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- SSCAIFP-501: Customer Code (ZUCTCG) not in SSSTDPP B9 (customer code)
          COUNT(CASE WHEN TRIM(s."ZUCTCG") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."ZUCTCG"), '^[0. ]*$') THEN 1 END) AS t1,
          COUNT(CASE WHEN TRIM(s."ZUCTCG") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."ZUCTCG"), '^[0. ]*$') AND j1.code IS NULL THEN 1 END) AS f1,
          -- SSCAIFP-502: Occupation Code (ZUOCPT) not in SSSTDPP OC (occupation code)
          COUNT(CASE WHEN TRIM(s."ZUOCPT") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."ZUOCPT"), '^[0. ]*$') THEN 1 END) AS t2,
          COUNT(CASE WHEN TRIM(s."ZUOCPT") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."ZUOCPT"), '^[0. ]*$') AND j2.code IS NULL THEN 1 END) AS f2
        FROM (
              SELECT t."ZUCTCG",
                     t."ZUOCPT"
                FROM DATACUT5."HUB_MT_SSCAIFP" t
               WHERE NVL(t."ZUMDFL",' ') &lt;&gt; 'S'
        ) s
        LEFT JOIN ref_std_b9 j1 ON j1.code = NVL(LTRIM(TRIM(s."ZUCTCG"), '0'), '0')
        LEFT JOIN ref_std_oc j2 ON j2.code = NVL(LTRIM(TRIM(s."ZUOCPT"), '0'), '0')
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'SSCAIFP-501|Invalid Values|Customer Code (ZUCTCG) not in SSSTDPP B9 (customer code)',
        (t2, f2) AS 'SSCAIFP-502|Invalid Values|Occupation Code (ZUOCPT) not in SSSTDPP OC (occupation code)'
      ))
    UNION ALL
/* =============================================================================
   SSCHCLP - SVC Charging Control Master File
   Πίνακας: DATACUT5."HUB_MT_SSCHCLP"   Shadow: SCMDFL = 'S' (εξαιρούνται)   Έλεγχοι: 2
   Έλεγχοι από τους κανόνες της στήλης Free column του DD v1.24.
   ============================================================================= */
    SELECT 'SSCHCLP - SVC Charging Control Master File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- SSCHCLP-501: Charge Currency (SCCHCY) not a valid ISO currency code (3 letters; SSCYIFP not in extract)
          COUNT(CASE WHEN TRIM(s."SCCHCY") IS NOT NULL THEN 1 END) AS t1,
          COUNT(CASE WHEN TRIM(s."SCCHCY") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."SCCHCY"), '^[A-Z]{3}$') THEN 1 END) AS f1,
          -- SSCHCLP-502: GHO classification (SCGHCL) not found in SSGHCLP
          COUNT(CASE WHEN TRIM(s."SCGHCL") IS NOT NULL THEN 1 END) AS t2,
          COUNT(CASE WHEN TRIM(s."SCGHCL") IS NOT NULL AND j1.code IS NULL THEN 1 END) AS f2
        FROM (
              SELECT t."SCCHCY",
                     t."SCGHCL"
                FROM DATACUT5."HUB_MT_SSCHCLP" t
               WHERE NVL(t."SCMDFL",' ') &lt;&gt; 'S'
        ) s
        LEFT JOIN k_ghcl j1 ON j1.code = TRIM(s."SCGHCL")
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'SSCHCLP-501|Format|Charge Currency (SCCHCY) not a valid ISO currency code (3 letters; SSCYIFP not in extract)',
        (t2, f2) AS 'SSCHCLP-502|Missing Links|GHO classification (SCGHCL) not found in SSGHCLP'
      ))
    UNION ALL
/* =============================================================================
   SSCHDAP - SVC Charging Control Detail by Amount File
   Πίνακας: DATACUT5."HUB_MT_SSCHDAP"   Shadow: SDMDFL = 'S' (εξαιρούνται)   Έλεγχοι: 2
   Έλεγχοι από τους κανόνες της στήλης Free column του DD v1.24.
   ============================================================================= */
    SELECT 'SSCHDAP - SVC Charging Control Detail by Amount File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- SSCHDAP-501: Charge Currency (SDCHCY) not a valid ISO currency code (3 letters; SSCYIFP not in extract)
          COUNT(CASE WHEN TRIM(s."SDCHCY") IS NOT NULL THEN 1 END) AS t1,
          COUNT(CASE WHEN TRIM(s."SDCHCY") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."SDCHCY"), '^[A-Z]{3}$') THEN 1 END) AS f1,
          -- SSCHDAP-502: GHO classification (SDGHCL) not found in SSGHCLP
          COUNT(CASE WHEN TRIM(s."SDGHCL") IS NOT NULL THEN 1 END) AS t2,
          COUNT(CASE WHEN TRIM(s."SDGHCL") IS NOT NULL AND j1.code IS NULL THEN 1 END) AS f2
        FROM (
              SELECT t."SDCHCY",
                     t."SDGHCL"
                FROM DATACUT5."HUB_MT_SSCHDAP" t
               WHERE NVL(t."SDMDFL",' ') &lt;&gt; 'S'
        ) s
        LEFT JOIN k_ghcl j1 ON j1.code = TRIM(s."SDGHCL")
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'SSCHDAP-501|Format|Charge Currency (SDCHCY) not a valid ISO currency code (3 letters; SSCYIFP not in extract)',
        (t2, f2) AS 'SSCHDAP-502|Missing Links|GHO classification (SDGHCL) not found in SSGHCLP'
      ))
    UNION ALL
/* =============================================================================
   SSCLACP - Closed Account File
   Πίνακας: DATACUT5."HUB_MT_SSCLACP"   Shadow: δεν υπάρχει mode flag   Έλεγχοι: 4
   Έλεγχοι από τους κανόνες της στήλης Free column του DD v1.24.
   ============================================================================= */
    SELECT 'SSCLACP - Closed Account File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- SSCLACP-501: Account (ZIACB+ZIACS+ZIACX) not found in any account master (DD/LS/TD/PL/DC/IE/GL ACMSP)
          COUNT(CASE WHEN NVL(s.n_ziacs, 0) &lt;&gt; 0 THEN 1 END) AS t1,
          COUNT(CASE WHEN NVL(s.n_ziacs, 0) &lt;&gt; 0 AND j1.k1 IS NULL THEN 1 END) AS f1,
          -- SSCLACP-502: Currency (ZICYCD) not a valid ISO currency code (3 letters; SSCYIFP not in extract)
          COUNT(CASE WHEN TRIM(s."ZICYCD") IS NOT NULL THEN 1 END) AS t2,
          COUNT(CASE WHEN TRIM(s."ZICYCD") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."ZICYCD"), '^[A-Z]{3}$') THEN 1 END) AS f2,
          -- SSCLACP-503: Branch (ZIDCB) not found in SSBRCPP
          COUNT(CASE WHEN NVL(s.n_zidcb, 0) &lt;&gt; 0 THEN 1 END) AS t3,
          COUNT(CASE WHEN NVL(s.n_zidcb, 0) &lt;&gt; 0 AND j2.brn IS NULL THEN 1 END) AS f3,
          -- SSCLACP-504: Product type (ZIAPTY) not found in any PDCPP (DD/TD/LS/PL/DC)
          COUNT(CASE WHEN TRIM(s."ZIAPTY") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."ZIAPTY"), '^[0. ]*$') THEN 1 END) AS t4,
          COUNT(CASE WHEN TRIM(s."ZIAPTY") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."ZIAPTY"), '^[0. ]*$') AND j3.code IS NULL THEN 1 END) AS f4
        FROM (
              SELECT t."ZIAPTY",
                     t."ZICYCD",
                     (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZIACB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZIACB")) END) AS n_ziacb,
                     (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZIACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZIACS")) END) AS n_ziacs,
                     (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZIACX") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZIACX")) END) AS n_ziacx,
                     (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZIDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZIDCB")) END) AS n_zidcb
                FROM DATACUT5."HUB_MT_SSCLACP" t
        ) s
        LEFT JOIN k_acc j1 ON j1.k1 = s.n_ziacb AND j1.k2 = s.n_ziacs AND j1.k3 = s.n_ziacx
        LEFT JOIN k_brn j2 ON j2.brn = s.n_zidcb
        LEFT JOIN ref_apty j3 ON j3.code = TRIM(s."ZIAPTY")
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'SSCLACP-501|Missing Links|Account (ZIACB+ZIACS+ZIACX) not found in any account master (DD/LS/TD/PL/DC/IE/GL ACMSP)',
        (t2, f2) AS 'SSCLACP-502|Format|Currency (ZICYCD) not a valid ISO currency code (3 letters; SSCYIFP not in extract)',
        (t3, f3) AS 'SSCLACP-503|Missing Links|Branch (ZIDCB) not found in SSBRCPP',
        (t4, f4) AS 'SSCLACP-504|Missing Links|Product type (ZIAPTY) not found in any PDCPP (DD/TD/LS/PL/DC)'
      ))
    UNION ALL
/* =============================================================================
   SSCUSTP - Customer Information File
   Πίνακας: DATACUT5."HUB_MT_SSCUSTP"   Shadow: ZGMDFL = 'S' (εξαιρούνται)   Έλεγχοι: 5
   Έλεγχοι από τους κανόνες της στήλης Free column του DD v1.24.
   ============================================================================= */
    SELECT 'SSCUSTP - Customer Information File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- SSCUSTP-501: Market Sector 1 (ZGMKS1) not in SSSTDPP MS (market sector)
          COUNT(CASE WHEN TRIM(s."ZGMKS1") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."ZGMKS1"), '^[0. ]*$') THEN 1 END) AS t1,
          COUNT(CASE WHEN TRIM(s."ZGMKS1") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."ZGMKS1"), '^[0. ]*$') AND j1.code IS NULL THEN 1 END) AS f1,
          -- SSCUSTP-502: Market Sector 2 (ZGMKS2) not in SSSTDPP MS (market sector)
          COUNT(CASE WHEN TRIM(s."ZGMKS2") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."ZGMKS2"), '^[0. ]*$') THEN 1 END) AS t2,
          COUNT(CASE WHEN TRIM(s."ZGMKS2") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."ZGMKS2"), '^[0. ]*$') AND j2.code IS NULL THEN 1 END) AS f2,
          -- SSCUSTP-503: Market Sector 3 (ZGMKS3) not in SSSTDPP MS (market sector)
          COUNT(CASE WHEN TRIM(s."ZGMKS3") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."ZGMKS3"), '^[0. ]*$') THEN 1 END) AS t3,
          COUNT(CASE WHEN TRIM(s."ZGMKS3") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."ZGMKS3"), '^[0. ]*$') AND j3.code IS NULL THEN 1 END) AS f3,
          -- SSCUSTP-504: GHO classification (ZGGHCL) not found in SSGHCLP
          COUNT(CASE WHEN TRIM(s."ZGGHCL") IS NOT NULL THEN 1 END) AS t4,
          COUNT(CASE WHEN TRIM(s."ZGGHCL") IS NOT NULL AND j4.code IS NULL THEN 1 END) AS f4,
          -- SSCUSTP-505: Branch (ZGDCB) not found in SSBRCPP
          COUNT(CASE WHEN NVL(s.n_zgdcb, 0) &lt;&gt; 0 THEN 1 END) AS t5,
          COUNT(CASE WHEN NVL(s.n_zgdcb, 0) &lt;&gt; 0 AND j5.brn IS NULL THEN 1 END) AS f5
        FROM (
              SELECT t."ZGGHCL",
                     t."ZGMKS1",
                     t."ZGMKS2",
                     t."ZGMKS3",
                     (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZGDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZGDCB")) END) AS n_zgdcb
                FROM DATACUT5."HUB_MT_SSCUSTP" t
               WHERE NVL(t."ZGMDFL",' ') &lt;&gt; 'S'
        ) s
        LEFT JOIN ref_std_ms j1 ON j1.code = NVL(LTRIM(TRIM(s."ZGMKS1"), '0'), '0')
        LEFT JOIN ref_std_ms j2 ON j2.code = NVL(LTRIM(TRIM(s."ZGMKS2"), '0'), '0')
        LEFT JOIN ref_std_ms j3 ON j3.code = NVL(LTRIM(TRIM(s."ZGMKS3"), '0'), '0')
        LEFT JOIN k_ghcl j4 ON j4.code = TRIM(s."ZGGHCL")
        LEFT JOIN k_brn j5 ON j5.brn = s.n_zgdcb
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'SSCUSTP-501|Invalid Values|Market Sector 1 (ZGMKS1) not in SSSTDPP MS (market sector)',
        (t2, f2) AS 'SSCUSTP-502|Invalid Values|Market Sector 2 (ZGMKS2) not in SSSTDPP MS (market sector)',
        (t3, f3) AS 'SSCUSTP-503|Invalid Values|Market Sector 3 (ZGMKS3) not in SSSTDPP MS (market sector)',
        (t4, f4) AS 'SSCUSTP-504|Missing Links|GHO classification (ZGGHCL) not found in SSGHCLP',
        (t5, f5) AS 'SSCUSTP-505|Missing Links|Branch (ZGDCB) not found in SSBRCPP'
      ))
    UNION ALL
/* =============================================================================
   SSFNRTP - COF/VOF Rate File
   Πίνακας: DATACUT5."HUB_MT_SSFNRTP"   Shadow: UCMDFL = 'S' (εξαιρούνται)   Έλεγχοι: 2
   Έλεγχοι από τους κανόνες της στήλης Free column του DD v1.24.
   ============================================================================= */
    SELECT 'SSFNRTP - COF/VOF Rate File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- SSFNRTP-501: Currency (UCCYCD) not a valid ISO currency code (3 letters; SSCYIFP not in extract)
          COUNT(CASE WHEN TRIM(s."UCCYCD") IS NOT NULL THEN 1 END) AS t1,
          COUNT(CASE WHEN TRIM(s."UCCYCD") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."UCCYCD"), '^[A-Z]{3}$') THEN 1 END) AS f1,
          -- SSFNRTP-502: Product type (UCAPTY) not found in any PDCPP (DD/TD/LS/PL/DC)
          COUNT(CASE WHEN TRIM(s."UCAPTY") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."UCAPTY"), '^[0. ]*$') THEN 1 END) AS t2,
          COUNT(CASE WHEN TRIM(s."UCAPTY") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."UCAPTY"), '^[0. ]*$') AND j1.code IS NULL THEN 1 END) AS f2
        FROM (
              SELECT t."UCAPTY",
                     t."UCCYCD"
                FROM DATACUT5."HUB_MT_SSFNRTP" t
               WHERE NVL(t."UCMDFL",' ') &lt;&gt; 'S'
        ) s
        LEFT JOIN ref_apty j1 ON j1.code = TRIM(s."UCAPTY")
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'SSFNRTP-501|Format|Currency (UCCYCD) not a valid ISO currency code (3 letters; SSCYIFP not in extract)',
        (t2, f2) AS 'SSFNRTP-502|Missing Links|Product type (UCAPTY) not found in any PDCPP (DD/TD/LS/PL/DC)'
      ))
    UNION ALL
/* =============================================================================
   SSGHCGP - GHO Customer Group Mapping File
   Πίνακας: DATACUT5."HUB_MT_SSGHCGP"   Shadow: δεν υπάρχει mode flag   Έλεγχοι: 1
   Έλεγχοι από τους κανόνες της στήλης Free column του DD v1.24.
   ============================================================================= */
    SELECT 'SSGHCGP - GHO Customer Group Mapping File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- SSGHCGP-501: GHO classification (AAGHCL) not found in SSGHCLP
          COUNT(CASE WHEN TRIM(s."AAGHCL") IS NOT NULL THEN 1 END) AS t1,
          COUNT(CASE WHEN TRIM(s."AAGHCL") IS NOT NULL AND j1.code IS NULL THEN 1 END) AS f1
        FROM (
              SELECT t."AAGHCL"
                FROM DATACUT5."HUB_MT_SSGHCGP" t
        ) s
        LEFT JOIN k_ghcl j1 ON j1.code = TRIM(s."AAGHCL")
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'SSGHCGP-501|Missing Links|GHO classification (AAGHCL) not found in SSGHCLP'
      ))
    UNION ALL
/* =============================================================================
   SSGPRLP - Customer Group Relationships File
   Πίνακας: DATACUT5."HUB_MT_SSGPRLP"   Shadow: ZHMDFL = 'S' (εξαιρούνται)   Έλεγχοι: 1
   Έλεγχοι από τους κανόνες της στήλης Free column του DD v1.24.
   ============================================================================= */
    SELECT 'SSGPRLP - Customer Group Relationships File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- SSGPRLP-501: Customer (ZHCGB+ZHCGS) not found in SSCUSTP
          COUNT(CASE WHEN NVL(s.n_zhcgb, 0) &lt;&gt; 0 AND NVL(s.n_zhcgs, 0) &lt;&gt; 0 THEN 1 END) AS t1,
          COUNT(CASE WHEN NVL(s.n_zhcgb, 0) &lt;&gt; 0 AND NVL(s.n_zhcgs, 0) &lt;&gt; 0 AND j1.dcb IS NULL THEN 1 END) AS f1
        FROM (
              SELECT (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZHCGB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZHCGB")) END) AS n_zhcgb,
                     (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZHCGS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZHCGS")) END) AS n_zhcgs
                FROM DATACUT5."HUB_MT_SSGPRLP" t
               WHERE NVL(t."ZHMDFL",' ') &lt;&gt; 'S'
        ) s
        LEFT JOIN k_cus j1 ON j1.dcb = s.n_zhcgb AND j1.dcs = s.n_zhcgs
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'SSGPRLP-501|Missing Links|Customer (ZHCGB+ZHCGS) not found in SSCUSTP'
      ))
    UNION ALL
/* =============================================================================
   SSHOLDP - Holds File
   Πίνακας: DATACUT5."HUB_MT_SSHOLDP"   Shadow: X4MDFL = 'S' (εξαιρούνται)   Έλεγχοι: 1
   Έλεγχοι από τους κανόνες της στήλης Free column του DD v1.24.
   ============================================================================= */
    SELECT 'SSHOLDP - Holds File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- SSHOLDP-501: Account (X4ACB+X4ACS+X4ACX) not found in any account master (DD/LS/TD/PL/DC/IE/GL ACMSP)
          COUNT(CASE WHEN NVL(s.n_x4acs, 0) &lt;&gt; 0 THEN 1 END) AS t1,
          COUNT(CASE WHEN NVL(s.n_x4acs, 0) &lt;&gt; 0 AND j1.k1 IS NULL THEN 1 END) AS f1
        FROM (
              SELECT (CASE WHEN VALIDATE_CONVERSION(TRIM(t."X4ACB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."X4ACB")) END) AS n_x4acb,
                     (CASE WHEN VALIDATE_CONVERSION(TRIM(t."X4ACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."X4ACS")) END) AS n_x4acs,
                     (CASE WHEN VALIDATE_CONVERSION(TRIM(t."X4ACX") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."X4ACX")) END) AS n_x4acx
                FROM DATACUT5."HUB_MT_SSHOLDP" t
               WHERE NVL(t."X4MDFL",' ') &lt;&gt; 'S'
        ) s
        LEFT JOIN k_acc j1 ON j1.k1 = s.n_x4acb AND j1.k2 = s.n_x4acs AND j1.k3 = s.n_x4acx
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'SSHOLDP-501|Missing Links|Account (X4ACB+X4ACS+X4ACX) not found in any account master (DD/LS/TD/PL/DC/IE/GL ACMSP)'
      ))
    UNION ALL
/* =============================================================================
   SSICADP - Individual Customer Additional Information File
   Πίνακας: DATACUT5."HUB_MT_SSICADP"   Shadow: δεν υπάρχει mode flag   Έλεγχοι: 4
   Έλεγχοι από τους κανόνες της στήλης Free column του DD v1.24.
   ============================================================================= */
    SELECT 'SSICADP - Individual Customer Additional Information File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- SSICADP-501: Permanent Address Id (ZYPADS) not found in SSADDRP for the same customer (ZYDCB+ZYDCS)
          COUNT(CASE WHEN TRIM(s."ZYPADS") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."ZYPADS"), '^[0. ]*$') THEN 1 END) AS t1,
          COUNT(CASE WHEN TRIM(s."ZYPADS") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."ZYPADS"), '^[0. ]*$') AND j1.dcb IS NULL THEN 1 END) AS f1,
          -- SSICADP-502: POA Address ID (ZYPWID) not found in SSADDRP for the same customer (ZYDCB+ZYDCS)
          COUNT(CASE WHEN TRIM(s."ZYPWID") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."ZYPWID"), '^[0. ]*$') THEN 1 END) AS t2,
          COUNT(CASE WHEN TRIM(s."ZYPWID") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."ZYPWID"), '^[0. ]*$') AND j2.dcb IS NULL THEN 1 END) AS f2,
          -- SSICADP-503: In care Address ID (ZYIDIC) not found in SSADDRP for the same customer (ZYDCB+ZYDCS)
          COUNT(CASE WHEN TRIM(s."ZYIDIC") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."ZYIDIC"), '^[0. ]*$') THEN 1 END) AS t3,
          COUNT(CASE WHEN TRIM(s."ZYIDIC") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."ZYIDIC"), '^[0. ]*$') AND j3.dcb IS NULL THEN 1 END) AS f3,
          -- SSICADP-504: Previous Address ID (ZYPVID) not found in SSADDRP for the same customer (ZYDCB+ZYDCS)
          COUNT(CASE WHEN TRIM(s."ZYPVID") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."ZYPVID"), '^[0. ]*$') THEN 1 END) AS t4,
          COUNT(CASE WHEN TRIM(s."ZYPVID") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."ZYPVID"), '^[0. ]*$') AND j4.dcb IS NULL THEN 1 END) AS f4
        FROM (
              SELECT t."ZYIDIC",
                     t."ZYPADS",
                     t."ZYPVID",
                     t."ZYPWID",
                     (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZYDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZYDCB")) END) AS n_zydcb,
                     (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ZYDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ZYDCS")) END) AS n_zydcs
                FROM DATACUT5."HUB_MT_SSICADP" t
        ) s
        LEFT JOIN k_adr_id j1 ON j1.dcb = s.n_zydcb AND j1.dcs = s.n_zydcs AND j1.adid = TRIM(s."ZYPADS")
        LEFT JOIN k_adr_id j2 ON j2.dcb = s.n_zydcb AND j2.dcs = s.n_zydcs AND j2.adid = TRIM(s."ZYPWID")
        LEFT JOIN k_adr_id j3 ON j3.dcb = s.n_zydcb AND j3.dcs = s.n_zydcs AND j3.adid = TRIM(s."ZYIDIC")
        LEFT JOIN k_adr_id j4 ON j4.dcb = s.n_zydcb AND j4.dcs = s.n_zydcs AND j4.adid = TRIM(s."ZYPVID")
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'SSICADP-501|Missing Links|Permanent Address Id (ZYPADS) not found in SSADDRP for the same customer (ZYDCB+ZYDCS)',
        (t2, f2) AS 'SSICADP-502|Missing Links|POA Address ID (ZYPWID) not found in SSADDRP for the same customer (ZYDCB+ZYDCS)',
        (t3, f3) AS 'SSICADP-503|Missing Links|In care Address ID (ZYIDIC) not found in SSADDRP for the same customer (ZYDCB+ZYDCS)',
        (t4, f4) AS 'SSICADP-504|Missing Links|Previous Address ID (ZYPVID) not found in SSADDRP for the same customer (ZYDCB+ZYDCS)'
      ))
    UNION ALL
/* =============================================================================
   SSIFSEP - IFRS9 ETL Supplementary Data Extract File
   Πίνακας: DATACUT5."HUB_MT_SSIFSEP"   Shadow: δεν υπάρχει mode flag   Έλεγχοι: 6
   Έλεγχοι από τους κανόνες της στήλης Free column του DD v1.24.
   ============================================================================= */
    SELECT 'SSIFSEP - IFRS9 ETL Supplementary Data Extract File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- SSIFSEP-501: Account (SIACB+SIACS+SIACX) not found in any account master (DD/LS/TD/PL/DC/IE/GL ACMSP)
          COUNT(CASE WHEN NVL(s.n_siacs, 0) &lt;&gt; 0 THEN 1 END) AS t1,
          COUNT(CASE WHEN NVL(s.n_siacs, 0) &lt;&gt; 0 AND j1.k1 IS NULL THEN 1 END) AS f1,
          -- SSIFSEP-502: Market Sector (SIMKS1) not in SSSTDPP MS (market sector)
          COUNT(CASE WHEN TRIM(s."SIMKS1") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."SIMKS1"), '^[0. ]*$') THEN 1 END) AS t2,
          COUNT(CASE WHEN TRIM(s."SIMKS1") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."SIMKS1"), '^[0. ]*$') AND j2.code IS NULL THEN 1 END) AS f2,
          -- SSIFSEP-503: Country of nationality (SINATY) not in SSSTDPP CT (country code)
          COUNT(CASE WHEN TRIM(s."SINATY") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."SINATY"), '^[0. ]*$') THEN 1 END) AS t3,
          COUNT(CASE WHEN TRIM(s."SINATY") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."SINATY"), '^[0. ]*$') AND j3.code IS NULL THEN 1 END) AS f3,
          -- SSIFSEP-504: Country of Residence (SICTRS) not in SSSTDPP CT (country code)
          COUNT(CASE WHEN TRIM(s."SICTRS") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."SICTRS"), '^[0. ]*$') THEN 1 END) AS t4,
          COUNT(CASE WHEN TRIM(s."SICTRS") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."SICTRS"), '^[0. ]*$') AND j4.code IS NULL THEN 1 END) AS f4,
          -- SSIFSEP-505: Currency (SICYCD) not a valid ISO currency code (3 letters; SSCYIFP not in extract)
          COUNT(CASE WHEN TRIM(s."SICYCD") IS NOT NULL THEN 1 END) AS t5,
          COUNT(CASE WHEN TRIM(s."SICYCD") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."SICYCD"), '^[A-Z]{3}$') THEN 1 END) AS f5,
          -- SSIFSEP-506: GHO classification (SIGHCL) not found in SSGHCLP
          COUNT(CASE WHEN TRIM(s."SIGHCL") IS NOT NULL THEN 1 END) AS t6,
          COUNT(CASE WHEN TRIM(s."SIGHCL") IS NOT NULL AND j5.code IS NULL THEN 1 END) AS f6
        FROM (
              SELECT t."SICTRS",
                     t."SICYCD",
                     t."SIGHCL",
                     t."SIMKS1",
                     t."SINATY",
                     (CASE WHEN VALIDATE_CONVERSION(TRIM(t."SIACB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."SIACB")) END) AS n_siacb,
                     (CASE WHEN VALIDATE_CONVERSION(TRIM(t."SIACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."SIACS")) END) AS n_siacs,
                     (CASE WHEN VALIDATE_CONVERSION(TRIM(t."SIACX") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."SIACX")) END) AS n_siacx
                FROM DATACUT5."HUB_MT_SSIFSEP" t
        ) s
        LEFT JOIN k_acc j1 ON j1.k1 = s.n_siacb AND j1.k2 = s.n_siacs AND j1.k3 = s.n_siacx
        LEFT JOIN ref_std_ms j2 ON j2.code = NVL(LTRIM(TRIM(s."SIMKS1"), '0'), '0')
        LEFT JOIN ref_std_ct j3 ON j3.code = NVL(LTRIM(TRIM(s."SINATY"), '0'), '0')
        LEFT JOIN ref_std_ct j4 ON j4.code = NVL(LTRIM(TRIM(s."SICTRS"), '0'), '0')
        LEFT JOIN k_ghcl j5 ON j5.code = TRIM(s."SIGHCL")
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'SSIFSEP-501|Missing Links|Account (SIACB+SIACS+SIACX) not found in any account master (DD/LS/TD/PL/DC/IE/GL ACMSP)',
        (t2, f2) AS 'SSIFSEP-502|Invalid Values|Market Sector (SIMKS1) not in SSSTDPP MS (market sector)',
        (t3, f3) AS 'SSIFSEP-503|Invalid Values|Country of nationality (SINATY) not in SSSTDPP CT (country code)',
        (t4, f4) AS 'SSIFSEP-504|Invalid Values|Country of Residence (SICTRS) not in SSSTDPP CT (country code)',
        (t5, f5) AS 'SSIFSEP-505|Format|Currency (SICYCD) not a valid ISO currency code (3 letters; SSCYIFP not in extract)',
        (t6, f6) AS 'SSIFSEP-506|Missing Links|GHO classification (SIGHCL) not found in SSGHCLP'
      ))
    UNION ALL
/* =============================================================================
   SSINCIP - Individual Customer Information File           
   Πίνακας: DATACUT5."HUB_MT_SSINCIP"   Shadow: ZKMDFL = 'S' (εξαιρούνται)   Έλεγχοι: 2
   Έλεγχοι από τους κανόνες της στήλης Free column του DD v1.24.
   ============================================================================= */
    SELECT 'SSINCIP - Individual Customer Information File           ' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- SSINCIP-501: Occupation Code (ZKOCPT) not in SSSTDPP OC (occupation code)
          COUNT(CASE WHEN TRIM(s."ZKOCPT") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."ZKOCPT"), '^[0. ]*$') THEN 1 END) AS t1,
          COUNT(CASE WHEN TRIM(s."ZKOCPT") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."ZKOCPT"), '^[0. ]*$') AND j1.code IS NULL THEN 1 END) AS f1,
          -- SSINCIP-502: Race (ZKRACE) not in SSSTDPP CT (country code)
          COUNT(CASE WHEN TRIM(s."ZKRACE") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."ZKRACE"), '^[0. ]*$') THEN 1 END) AS t2,
          COUNT(CASE WHEN TRIM(s."ZKRACE") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."ZKRACE"), '^[0. ]*$') AND j2.code IS NULL THEN 1 END) AS f2
        FROM (
              SELECT t."ZKOCPT",
                     t."ZKRACE"
                FROM DATACUT5."HUB_MT_SSINCIP" t
               WHERE NVL(t."ZKMDFL",' ') &lt;&gt; 'S'
        ) s
        LEFT JOIN ref_std_oc j1 ON j1.code = NVL(LTRIM(TRIM(s."ZKOCPT"), '0'), '0')
        LEFT JOIN ref_std_ct j2 ON j2.code = NVL(LTRIM(TRIM(s."ZKRACE"), '0'), '0')
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'SSINCIP-501|Invalid Values|Occupation Code (ZKOCPT) not in SSSTDPP OC (occupation code)',
        (t2, f2) AS 'SSINCIP-502|Invalid Values|Race (ZKRACE) not in SSSTDPP CT (country code)'
      ))
    UNION ALL
/* =============================================================================
   SSINRTP - CR/DR Interest Base Rate File
   Πίνακας: DATACUT5."HUB_MT_SSINRTP"   Shadow: X5MDFL = 'S' (εξαιρούνται)   Έλεγχοι: 1
   Έλεγχοι από τους κανόνες της στήλης Free column του DD v1.24.
   ============================================================================= */
    SELECT 'SSINRTP - CR/DR Interest Base Rate File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- SSINRTP-501: Currency (X5CYCD) not a valid ISO currency code (3 letters; SSCYIFP not in extract)
          COUNT(CASE WHEN TRIM(s."X5CYCD") IS NOT NULL THEN 1 END) AS t1,
          COUNT(CASE WHEN TRIM(s."X5CYCD") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."X5CYCD"), '^[A-Z]{3}$') THEN 1 END) AS f1
        FROM (
              SELECT t."X5CYCD"
                FROM DATACUT5."HUB_MT_SSINRTP" t
               WHERE NVL(t."X5MDFL",' ') &lt;&gt; 'S'
        ) s
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'SSINRTP-501|Format|Currency (X5CYCD) not a valid ISO currency code (3 letters; SSCYIFP not in extract)'
      ))
    UNION ALL
/* =============================================================================
   SSLIACP - HUB-Interface A/C Information File
   Πίνακας: DATACUT5."HUB_MT_SSLIACP"   Shadow: ZKMDFL = 'S' (εξαιρούνται)   Έλεγχοι: 2
   Έλεγχοι από τους κανόνες της στήλης Free column του DD v1.24.
   ============================================================================= */
    SELECT 'SSLIACP - HUB-Interface A/C Information File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- SSLIACP-501: Currency (ZKCYCD) not a valid ISO currency code (3 letters; SSCYIFP not in extract)
          COUNT(CASE WHEN TRIM(s."ZKCYCD") IS NOT NULL THEN 1 END) AS t1,
          COUNT(CASE WHEN TRIM(s."ZKCYCD") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."ZKCYCD"), '^[A-Z]{3}$') THEN 1 END) AS f1,
          -- SSLIACP-502: Product type (ZKAPTY) not found in any PDCPP (DD/TD/LS/PL/DC)
          COUNT(CASE WHEN TRIM(s."ZKAPTY") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."ZKAPTY"), '^[0. ]*$') THEN 1 END) AS t2,
          COUNT(CASE WHEN TRIM(s."ZKAPTY") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."ZKAPTY"), '^[0. ]*$') AND j1.code IS NULL THEN 1 END) AS f2
        FROM (
              SELECT t."ZKAPTY",
                     t."ZKCYCD"
                FROM DATACUT5."HUB_MT_SSLIACP" t
               WHERE NVL(t."ZKMDFL",' ') &lt;&gt; 'S'
        ) s
        LEFT JOIN ref_apty j1 ON j1.code = TRIM(s."ZKAPTY")
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'SSLIACP-501|Format|Currency (ZKCYCD) not a valid ISO currency code (3 letters; SSCYIFP not in extract)',
        (t2, f2) AS 'SSLIACP-502|Missing Links|Product type (ZKAPTY) not found in any PDCPP (DD/TD/LS/PL/DC)'
      ))
    UNION ALL
/* =============================================================================
   SSNICIP - Non-individual Customer Information File
   Πίνακας: DATACUT5."HUB_MT_SSNICIP"   Shadow: XUMDFL = 'S' (εξαιρούνται)   Έλεγχοι: 13
   Έλεγχοι από τους κανόνες της στήλης Free column του DD v1.24.
   ============================================================================= */
    SELECT 'SSNICIP - Non-individual Customer Information File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- SSNICIP-501: COUNTRY (XUCTT1) not in SSSTDPP CT (country code)
          COUNT(CASE WHEN TRIM(s."XUCTT1") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."XUCTT1"), '^[0. ]*$') THEN 1 END) AS t1,
          COUNT(CASE WHEN TRIM(s."XUCTT1") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."XUCTT1"), '^[0. ]*$') AND j1.code IS NULL THEN 1 END) AS f1,
          -- SSNICIP-502: Country Traded with-2 (XUCTT2) not in SSSTDPP CT (country code)
          COUNT(CASE WHEN TRIM(s."XUCTT2") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."XUCTT2"), '^[0. ]*$') THEN 1 END) AS t2,
          COUNT(CASE WHEN TRIM(s."XUCTT2") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."XUCTT2"), '^[0. ]*$') AND j2.code IS NULL THEN 1 END) AS f2,
          -- SSNICIP-503: Country Traded with-3 (XUCTT3) not in SSSTDPP CT (country code)
          COUNT(CASE WHEN TRIM(s."XUCTT3") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."XUCTT3"), '^[0. ]*$') THEN 1 END) AS t3,
          COUNT(CASE WHEN TRIM(s."XUCTT3") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."XUCTT3"), '^[0. ]*$') AND j3.code IS NULL THEN 1 END) AS f3,
          -- SSNICIP-504: Country with Subsidiaries-1 (XUCTS1) not in SSSTDPP CT (country code)
          COUNT(CASE WHEN TRIM(s."XUCTS1") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."XUCTS1"), '^[0. ]*$') THEN 1 END) AS t4,
          COUNT(CASE WHEN TRIM(s."XUCTS1") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."XUCTS1"), '^[0. ]*$') AND j4.code IS NULL THEN 1 END) AS f4,
          -- SSNICIP-505: Country with Subsidiaries-2 (XUCTS2) not in SSSTDPP CT (country code)
          COUNT(CASE WHEN TRIM(s."XUCTS2") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."XUCTS2"), '^[0. ]*$') THEN 1 END) AS t5,
          COUNT(CASE WHEN TRIM(s."XUCTS2") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."XUCTS2"), '^[0. ]*$') AND j5.code IS NULL THEN 1 END) AS f5,
          -- SSNICIP-506: Country with Subsidiaries-3 (XUCTS3) not in SSSTDPP CT (country code)
          COUNT(CASE WHEN TRIM(s."XUCTS3") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."XUCTS3"), '^[0. ]*$') THEN 1 END) AS t6,
          COUNT(CASE WHEN TRIM(s."XUCTS3") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."XUCTS3"), '^[0. ]*$') AND j6.code IS NULL THEN 1 END) AS f6,
          -- SSNICIP-507: Currency 1 (XUCCY1) not a valid ISO currency code (3 letters; SSCYIFP not in extract)
          COUNT(CASE WHEN TRIM(s."XUCCY1") IS NOT NULL THEN 1 END) AS t7,
          COUNT(CASE WHEN TRIM(s."XUCCY1") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."XUCCY1"), '^[A-Z]{3}$') THEN 1 END) AS f7,
          -- SSNICIP-508: Currency 2 (XUCCY2) not a valid ISO currency code (3 letters; SSCYIFP not in extract)
          COUNT(CASE WHEN TRIM(s."XUCCY2") IS NOT NULL THEN 1 END) AS t8,
          COUNT(CASE WHEN TRIM(s."XUCCY2") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."XUCCY2"), '^[A-Z]{3}$') THEN 1 END) AS f8,
          -- SSNICIP-509: Currency 3 (XUCCY3) not a valid ISO currency code (3 letters; SSCYIFP not in extract)
          COUNT(CASE WHEN TRIM(s."XUCCY3") IS NOT NULL THEN 1 END) AS t9,
          COUNT(CASE WHEN TRIM(s."XUCCY3") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."XUCCY3"), '^[A-Z]{3}$') THEN 1 END) AS f9,
          -- SSNICIP-510: Permanent Address Id (XUPADS) not found in SSADDRP for the same customer (XUDCB+XUDCS)
          COUNT(CASE WHEN TRIM(s."XUPADS") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."XUPADS"), '^[0. ]*$') THEN 1 END) AS t10,
          COUNT(CASE WHEN TRIM(s."XUPADS") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."XUPADS"), '^[0. ]*$') AND j7.dcb IS NULL THEN 1 END) AS f10,
          -- SSNICIP-511: POA Address ID (XUPWID) not found in SSADDRP for the same customer (XUDCB+XUDCS)
          COUNT(CASE WHEN TRIM(s."XUPWID") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."XUPWID"), '^[0. ]*$') THEN 1 END) AS t11,
          COUNT(CASE WHEN TRIM(s."XUPWID") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."XUPWID"), '^[0. ]*$') AND j8.dcb IS NULL THEN 1 END) AS f11,
          -- SSNICIP-512: In care Address ID (XUIDIC) not found in SSADDRP for the same customer (XUDCB+XUDCS)
          COUNT(CASE WHEN TRIM(s."XUIDIC") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."XUIDIC"), '^[0. ]*$') THEN 1 END) AS t12,
          COUNT(CASE WHEN TRIM(s."XUIDIC") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."XUIDIC"), '^[0. ]*$') AND j9.dcb IS NULL THEN 1 END) AS f12,
          -- SSNICIP-513: Previous Address ID (XUPVID) not found in SSADDRP for the same customer (XUDCB+XUDCS)
          COUNT(CASE WHEN TRIM(s."XUPVID") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."XUPVID"), '^[0. ]*$') THEN 1 END) AS t13,
          COUNT(CASE WHEN TRIM(s."XUPVID") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."XUPVID"), '^[0. ]*$') AND j10.dcb IS NULL THEN 1 END) AS f13
        FROM (
              SELECT t."XUCCY1",
                     t."XUCCY2",
                     t."XUCCY3",
                     t."XUCTS1",
                     t."XUCTS2",
                     t."XUCTS3",
                     t."XUCTT1",
                     t."XUCTT2",
                     t."XUCTT3",
                     t."XUIDIC",
                     t."XUPADS",
                     t."XUPVID",
                     t."XUPWID",
                     (CASE WHEN VALIDATE_CONVERSION(TRIM(t."XUDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."XUDCB")) END) AS n_xudcb,
                     (CASE WHEN VALIDATE_CONVERSION(TRIM(t."XUDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."XUDCS")) END) AS n_xudcs
                FROM DATACUT5."HUB_MT_SSNICIP" t
               WHERE NVL(t."XUMDFL",' ') &lt;&gt; 'S'
        ) s
        LEFT JOIN ref_std_ct j1 ON j1.code = NVL(LTRIM(TRIM(s."XUCTT1"), '0'), '0')
        LEFT JOIN ref_std_ct j2 ON j2.code = NVL(LTRIM(TRIM(s."XUCTT2"), '0'), '0')
        LEFT JOIN ref_std_ct j3 ON j3.code = NVL(LTRIM(TRIM(s."XUCTT3"), '0'), '0')
        LEFT JOIN ref_std_ct j4 ON j4.code = NVL(LTRIM(TRIM(s."XUCTS1"), '0'), '0')
        LEFT JOIN ref_std_ct j5 ON j5.code = NVL(LTRIM(TRIM(s."XUCTS2"), '0'), '0')
        LEFT JOIN ref_std_ct j6 ON j6.code = NVL(LTRIM(TRIM(s."XUCTS3"), '0'), '0')
        LEFT JOIN k_adr_id j7 ON j7.dcb = s.n_xudcb AND j7.dcs = s.n_xudcs AND j7.adid = TRIM(s."XUPADS")
        LEFT JOIN k_adr_id j8 ON j8.dcb = s.n_xudcb AND j8.dcs = s.n_xudcs AND j8.adid = TRIM(s."XUPWID")
        LEFT JOIN k_adr_id j9 ON j9.dcb = s.n_xudcb AND j9.dcs = s.n_xudcs AND j9.adid = TRIM(s."XUIDIC")
        LEFT JOIN k_adr_id j10 ON j10.dcb = s.n_xudcb AND j10.dcs = s.n_xudcs AND j10.adid = TRIM(s."XUPVID")
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'SSNICIP-501|Invalid Values|COUNTRY (XUCTT1) not in SSSTDPP CT (country code)',
        (t2, f2) AS 'SSNICIP-502|Invalid Values|Country Traded with-2 (XUCTT2) not in SSSTDPP CT (country code)',
        (t3, f3) AS 'SSNICIP-503|Invalid Values|Country Traded with-3 (XUCTT3) not in SSSTDPP CT (country code)',
        (t4, f4) AS 'SSNICIP-504|Invalid Values|Country with Subsidiaries-1 (XUCTS1) not in SSSTDPP CT (country code)',
        (t5, f5) AS 'SSNICIP-505|Invalid Values|Country with Subsidiaries-2 (XUCTS2) not in SSSTDPP CT (country code)',
        (t6, f6) AS 'SSNICIP-506|Invalid Values|Country with Subsidiaries-3 (XUCTS3) not in SSSTDPP CT (country code)',
        (t7, f7) AS 'SSNICIP-507|Format|Currency 1 (XUCCY1) not a valid ISO currency code (3 letters; SSCYIFP not in extract)',
        (t8, f8) AS 'SSNICIP-508|Format|Currency 2 (XUCCY2) not a valid ISO currency code (3 letters; SSCYIFP not in extract)',
        (t9, f9) AS 'SSNICIP-509|Format|Currency 3 (XUCCY3) not a valid ISO currency code (3 letters; SSCYIFP not in extract)',
        (t10, f10) AS 'SSNICIP-510|Missing Links|Permanent Address Id (XUPADS) not found in SSADDRP for the same customer (XUDCB+XUDCS)',
        (t11, f11) AS 'SSNICIP-511|Missing Links|POA Address ID (XUPWID) not found in SSADDRP for the same customer (XUDCB+XUDCS)',
        (t12, f12) AS 'SSNICIP-512|Missing Links|In care Address ID (XUIDIC) not found in SSADDRP for the same customer (XUDCB+XUDCS)',
        (t13, f13) AS 'SSNICIP-513|Missing Links|Previous Address ID (XUPVID) not found in SSADDRP for the same customer (XUDCB+XUDCS)'
      ))
    UNION ALL
/* =============================================================================
   SSPRJIP - Personal Joint account Information File
   Πίνακας: DATACUT5."HUB_MT_SSPRJIP"   Shadow: X0MDFL = 'S' (εξαιρούνται)   Έλεγχοι: 1
   Έλεγχοι από τους κανόνες της στήλης Free column του DD v1.24.
   ============================================================================= */
    SELECT 'SSPRJIP - Personal Joint account Information File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- SSPRJIP-501: Customer (X0DCBH+X0DCSH) not found in SSCUSTP
          COUNT(CASE WHEN NVL(s.n_x0dcbh, 0) &lt;&gt; 0 AND NVL(s.n_x0dcsh, 0) &lt;&gt; 0 THEN 1 END) AS t1,
          COUNT(CASE WHEN NVL(s.n_x0dcbh, 0) &lt;&gt; 0 AND NVL(s.n_x0dcsh, 0) &lt;&gt; 0 AND j1.dcb IS NULL THEN 1 END) AS f1
        FROM (
              SELECT (CASE WHEN VALIDATE_CONVERSION(TRIM(t."X0DCBH") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."X0DCBH")) END) AS n_x0dcbh,
                     (CASE WHEN VALIDATE_CONVERSION(TRIM(t."X0DCSH") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."X0DCSH")) END) AS n_x0dcsh
                FROM DATACUT5."HUB_MT_SSPRJIP" t
               WHERE NVL(t."X0MDFL",' ') &lt;&gt; 'S'
        ) s
        LEFT JOIN k_cus j1 ON j1.dcb = s.n_x0dcbh AND j1.dcs = s.n_x0dcsh
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'SSPRJIP-501|Missing Links|Customer (X0DCBH+X0DCSH) not found in SSCUSTP'
      ))
    UNION ALL
/* =============================================================================
   SSSCRLP - Security Relationship File
   Πίνακας: DATACUT5."HUB_MT_SSSCRLP"   Shadow: VYMDFL = 'S' (εξαιρούνται)   Έλεγχοι: 1
   Έλεγχοι από τους κανόνες της στήλης Free column του DD v1.24.
   ============================================================================= */
    SELECT 'SSSCRLP - Security Relationship File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- SSSCRLP-501: Currency (VYCYCD) not a valid ISO currency code (3 letters; SSCYIFP not in extract)
          COUNT(CASE WHEN TRIM(s."VYCYCD") IS NOT NULL THEN 1 END) AS t1,
          COUNT(CASE WHEN TRIM(s."VYCYCD") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."VYCYCD"), '^[A-Z]{3}$') THEN 1 END) AS f1
        FROM (
              SELECT t."VYCYCD"
                FROM DATACUT5."HUB_MT_SSSCRLP" t
               WHERE NVL(t."VYMDFL",' ') &lt;&gt; 'S'
        ) s
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'SSSCRLP-501|Format|Currency (VYCYCD) not a valid ISO currency code (3 letters; SSCYIFP not in extract)'
      ))
    UNION ALL
/* =============================================================================
   SSSECHP - Security Held File
   Πίνακας: DATACUT5."HUB_MT_SSSECHP"   Shadow: Y2MDFL = 'S' (εξαιρούνται)   Έλεγχοι: 5
   Έλεγχοι από τους κανόνες της στήλης Free column του DD v1.24.
   ============================================================================= */
    SELECT 'SSSECHP - Security Held File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- SSSECHP-501: Customer (Y2GAB+Y2GAS) not found in SSCUSTP
          COUNT(CASE WHEN NVL(s.n_y2gab, 0) &lt;&gt; 0 AND NVL(s.n_y2gas, 0) &lt;&gt; 0 THEN 1 END) AS t1,
          COUNT(CASE WHEN NVL(s.n_y2gab, 0) &lt;&gt; 0 AND NVL(s.n_y2gas, 0) &lt;&gt; 0 AND j1.dcb IS NULL THEN 1 END) AS f1,
          -- SSSECHP-502: Customer (Y2GCB1+Y2GCS1) not found in SSCUSTP
          COUNT(CASE WHEN NVL(s.n_y2gcb1, 0) &lt;&gt; 0 AND NVL(s.n_y2gcs1, 0) &lt;&gt; 0 THEN 1 END) AS t2,
          COUNT(CASE WHEN NVL(s.n_y2gcb1, 0) &lt;&gt; 0 AND NVL(s.n_y2gcs1, 0) &lt;&gt; 0 AND j2.dcb IS NULL THEN 1 END) AS f2,
          -- SSSECHP-503: Customer (Y2GCB2+Y2GCS2) not found in SSCUSTP
          COUNT(CASE WHEN NVL(s.n_y2gcb2, 0) &lt;&gt; 0 AND NVL(s.n_y2gcs2, 0) &lt;&gt; 0 THEN 1 END) AS t3,
          COUNT(CASE WHEN NVL(s.n_y2gcb2, 0) &lt;&gt; 0 AND NVL(s.n_y2gcs2, 0) &lt;&gt; 0 AND j3.dcb IS NULL THEN 1 END) AS f3,
          -- SSSECHP-504: Customer (Y2GCB3+Y2GCS3) not found in SSCUSTP
          COUNT(CASE WHEN NVL(s.n_y2gcb3, 0) &lt;&gt; 0 AND NVL(s.n_y2gcs3, 0) &lt;&gt; 0 THEN 1 END) AS t4,
          COUNT(CASE WHEN NVL(s.n_y2gcb3, 0) &lt;&gt; 0 AND NVL(s.n_y2gcs3, 0) &lt;&gt; 0 AND j4.dcb IS NULL THEN 1 END) AS f4,
          -- SSSECHP-505: Currency (Y2CYCD) not a valid ISO currency code (3 letters; SSCYIFP not in extract)
          COUNT(CASE WHEN TRIM(s."Y2CYCD") IS NOT NULL THEN 1 END) AS t5,
          COUNT(CASE WHEN TRIM(s."Y2CYCD") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."Y2CYCD"), '^[A-Z]{3}$') THEN 1 END) AS f5
        FROM (
              SELECT t."Y2CYCD",
                     (CASE WHEN VALIDATE_CONVERSION(TRIM(t."Y2GAB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."Y2GAB")) END) AS n_y2gab,
                     (CASE WHEN VALIDATE_CONVERSION(TRIM(t."Y2GAS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."Y2GAS")) END) AS n_y2gas,
                     (CASE WHEN VALIDATE_CONVERSION(TRIM(t."Y2GCB1") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."Y2GCB1")) END) AS n_y2gcb1,
                     (CASE WHEN VALIDATE_CONVERSION(TRIM(t."Y2GCS1") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."Y2GCS1")) END) AS n_y2gcs1,
                     (CASE WHEN VALIDATE_CONVERSION(TRIM(t."Y2GCB2") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."Y2GCB2")) END) AS n_y2gcb2,
                     (CASE WHEN VALIDATE_CONVERSION(TRIM(t."Y2GCS2") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."Y2GCS2")) END) AS n_y2gcs2,
                     (CASE WHEN VALIDATE_CONVERSION(TRIM(t."Y2GCB3") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."Y2GCB3")) END) AS n_y2gcb3,
                     (CASE WHEN VALIDATE_CONVERSION(TRIM(t."Y2GCS3") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."Y2GCS3")) END) AS n_y2gcs3
                FROM DATACUT5."HUB_MT_SSSECHP" t
               WHERE NVL(t."Y2MDFL",' ') &lt;&gt; 'S'
        ) s
        LEFT JOIN k_cus j1 ON j1.dcb = s.n_y2gab AND j1.dcs = s.n_y2gas
        LEFT JOIN k_cus j2 ON j2.dcb = s.n_y2gcb1 AND j2.dcs = s.n_y2gcs1
        LEFT JOIN k_cus j3 ON j3.dcb = s.n_y2gcb2 AND j3.dcs = s.n_y2gcs2
        LEFT JOIN k_cus j4 ON j4.dcb = s.n_y2gcb3 AND j4.dcs = s.n_y2gcs3
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'SSSECHP-501|Missing Links|Customer (Y2GAB+Y2GAS) not found in SSCUSTP',
        (t2, f2) AS 'SSSECHP-502|Missing Links|Customer (Y2GCB1+Y2GCS1) not found in SSCUSTP',
        (t3, f3) AS 'SSSECHP-503|Missing Links|Customer (Y2GCB2+Y2GCS2) not found in SSCUSTP',
        (t4, f4) AS 'SSSECHP-504|Missing Links|Customer (Y2GCB3+Y2GCS3) not found in SSCUSTP',
        (t5, f5) AS 'SSSECHP-505|Format|Currency (Y2CYCD) not a valid ISO currency code (3 letters; SSCYIFP not in extract)'
      ))
    UNION ALL
/* =============================================================================
   SSSPINP - Special Instructions File
   Πίνακας: DATACUT5."HUB_MT_SSSPINP"   Shadow: YGMDFL = 'S' (εξαιρούνται)   Έλεγχοι: 1
   Έλεγχοι από τους κανόνες της στήλης Free column του DD v1.24.
   ============================================================================= */
    SELECT 'SSSPINP - Special Instructions File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- SSSPINP-501: Account (YGACB+YGACS+YGACX) not found in any account master (DD/LS/TD/PL/DC/IE/GL ACMSP)
          COUNT(CASE WHEN NVL(s.n_ygacs, 0) &lt;&gt; 0 THEN 1 END) AS t1,
          COUNT(CASE WHEN NVL(s.n_ygacs, 0) &lt;&gt; 0 AND j1.k1 IS NULL THEN 1 END) AS f1
        FROM (
              SELECT (CASE WHEN VALIDATE_CONVERSION(TRIM(t."YGACB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."YGACB")) END) AS n_ygacb,
                     (CASE WHEN VALIDATE_CONVERSION(TRIM(t."YGACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."YGACS")) END) AS n_ygacs,
                     (CASE WHEN VALIDATE_CONVERSION(TRIM(t."YGACX") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."YGACX")) END) AS n_ygacx
                FROM DATACUT5."HUB_MT_SSSPINP" t
               WHERE NVL(t."YGMDFL",' ') &lt;&gt; 'S'
        ) s
        LEFT JOIN k_acc j1 ON j1.k1 = s.n_ygacb AND j1.k2 = s.n_ygacs AND j1.k3 = s.n_ygacx
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'SSSPINP-501|Missing Links|Account (YGACB+YGACS+YGACX) not found in any account master (DD/LS/TD/PL/DC/IE/GL ACMSP)'
      ))
    UNION ALL
/* =============================================================================
   SSTXDPP - Customer Tax Document file
   Πίνακας: DATACUT5."HUB_MT_SSTXDPP"   Shadow: δεν υπάρχει mode flag   Έλεγχοι: 1
   Έλεγχοι από τους κανόνες της στήλης Free column του DD v1.24.
   ============================================================================= */
    SELECT 'SSTXDPP - Customer Tax Document file' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- SSTXDPP-501: Customer Code (TDCTCG) not in SSSTDPP B9 (customer code)
          COUNT(CASE WHEN TRIM(s."TDCTCG") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."TDCTCG"), '^[0. ]*$') THEN 1 END) AS t1,
          COUNT(CASE WHEN TRIM(s."TDCTCG") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."TDCTCG"), '^[0. ]*$') AND j1.code IS NULL THEN 1 END) AS f1
        FROM (
              SELECT t."TDCTCG"
                FROM DATACUT5."HUB_MT_SSTXDPP" t
        ) s
        LEFT JOIN ref_std_b9 j1 ON j1.code = NVL(LTRIM(TRIM(s."TDCTCG"), '0'), '0')
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'SSTXDPP-501|Invalid Values|Customer Code (TDCTCG) not in SSSTDPP B9 (customer code)'
      ))
    UNION ALL
/* =============================================================================
   SSWAINP - HUB Write-Off Account Information File
   Πίνακας: DATACUT5."HUB_MT_SSWAINP"   Shadow: VIMDFL = 'S' (εξαιρούνται)   Έλεγχοι: 3
   Έλεγχοι από τους κανόνες της στήλης Free column του DD v1.24.
   ============================================================================= */
    SELECT 'SSWAINP - HUB Write-Off Account Information File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- SSWAINP-501: Account (VIACB+VIACS+VIACX) not found in any account master (DD/LS/TD/PL/DC/IE/GL ACMSP)
          COUNT(CASE WHEN NVL(s.n_viacs, 0) &lt;&gt; 0 THEN 1 END) AS t1,
          COUNT(CASE WHEN NVL(s.n_viacs, 0) &lt;&gt; 0 AND j1.k1 IS NULL THEN 1 END) AS f1,
          -- SSWAINP-502: Currency (VICYCD) not a valid ISO currency code (3 letters; SSCYIFP not in extract)
          COUNT(CASE WHEN TRIM(s."VICYCD") IS NOT NULL THEN 1 END) AS t2,
          COUNT(CASE WHEN TRIM(s."VICYCD") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."VICYCD"), '^[A-Z]{3}$') THEN 1 END) AS f2,
          -- SSWAINP-503: Product type (VIAPTY) not found in any PDCPP (DD/TD/LS/PL/DC)
          COUNT(CASE WHEN TRIM(s."VIAPTY") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."VIAPTY"), '^[0. ]*$') THEN 1 END) AS t3,
          COUNT(CASE WHEN TRIM(s."VIAPTY") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."VIAPTY"), '^[0. ]*$') AND j2.code IS NULL THEN 1 END) AS f3
        FROM (
              SELECT t."VIAPTY",
                     t."VICYCD",
                     (CASE WHEN VALIDATE_CONVERSION(TRIM(t."VIACB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."VIACB")) END) AS n_viacb,
                     (CASE WHEN VALIDATE_CONVERSION(TRIM(t."VIACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."VIACS")) END) AS n_viacs,
                     (CASE WHEN VALIDATE_CONVERSION(TRIM(t."VIACX") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."VIACX")) END) AS n_viacx
                FROM DATACUT5."HUB_MT_SSWAINP" t
               WHERE NVL(t."VIMDFL",' ') &lt;&gt; 'S'
        ) s
        LEFT JOIN k_acc j1 ON j1.k1 = s.n_viacb AND j1.k2 = s.n_viacs AND j1.k3 = s.n_viacx
        LEFT JOIN ref_apty j2 ON j2.code = TRIM(s."VIAPTY")
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'SSWAINP-501|Missing Links|Account (VIACB+VIACS+VIACX) not found in any account master (DD/LS/TD/PL/DC/IE/GL ACMSP)',
        (t2, f2) AS 'SSWAINP-502|Format|Currency (VICYCD) not a valid ISO currency code (3 letters; SSCYIFP not in extract)',
        (t3, f3) AS 'SSWAINP-503|Missing Links|Product type (VIAPTY) not found in any PDCPP (DD/TD/LS/PL/DC)'
      ))
    UNION ALL
/* =============================================================================
   SX@OWNSP - Safe Deposit Box Ownership File
   Πίνακας: DATACUT5."HUB_MT_SX@OWNSP"   Shadow: SBMDFL = 'S' (εξαιρούνται)   Έλεγχοι: 1
   Έλεγχοι από τους κανόνες της στήλης Free column του DD v1.24.
   ============================================================================= */
    SELECT 'SX@OWNSP - Safe Deposit Box Ownership File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- SX_OWNSP-501: Customer (SBDCB+SBDCS) not found in SSCUSTP
          COUNT(CASE WHEN NVL(s.n_sbdcb, 0) &lt;&gt; 0 AND NVL(s.n_sbdcs, 0) &lt;&gt; 0 THEN 1 END) AS t1,
          COUNT(CASE WHEN NVL(s.n_sbdcb, 0) &lt;&gt; 0 AND NVL(s.n_sbdcs, 0) &lt;&gt; 0 AND j1.dcb IS NULL THEN 1 END) AS f1
        FROM (
              SELECT (CASE WHEN VALIDATE_CONVERSION(TRIM(t."SBDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."SBDCB")) END) AS n_sbdcb,
                     (CASE WHEN VALIDATE_CONVERSION(TRIM(t."SBDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."SBDCS")) END) AS n_sbdcs
                FROM DATACUT5."HUB_MT_SX@OWNSP" t
               WHERE NVL(t."SBMDFL",' ') &lt;&gt; 'S'
        ) s
        LEFT JOIN k_cus j1 ON j1.dcb = s.n_sbdcb AND j1.dcs = s.n_sbdcs
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'SX_OWNSP-501|Missing Links|Customer (SBDCB+SBDCS) not found in SSCUSTP'
      ))
    UNION ALL
/* =============================================================================
   SXOWNSP - Safe Deposit Box Ownership File
   Πίνακας: DATACUT5."HUB_MT_SXOWNSP"   Shadow: SBMDFL = 'S' (εξαιρούνται)   Έλεγχοι: 1
   Έλεγχοι από τους κανόνες της στήλης Free column του DD v1.24.
   ============================================================================= */
    SELECT 'SXOWNSP - Safe Deposit Box Ownership File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- SXOWNSP-501: Customer (SBDCB+SBDCS) not found in SSCUSTP
          COUNT(CASE WHEN NVL(s.n_sbdcb, 0) &lt;&gt; 0 AND NVL(s.n_sbdcs, 0) &lt;&gt; 0 THEN 1 END) AS t1,
          COUNT(CASE WHEN NVL(s.n_sbdcb, 0) &lt;&gt; 0 AND NVL(s.n_sbdcs, 0) &lt;&gt; 0 AND j1.dcb IS NULL THEN 1 END) AS f1
        FROM (
              SELECT (CASE WHEN VALIDATE_CONVERSION(TRIM(t."SBDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."SBDCB")) END) AS n_sbdcb,
                     (CASE WHEN VALIDATE_CONVERSION(TRIM(t."SBDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."SBDCS")) END) AS n_sbdcs
                FROM DATACUT5."HUB_MT_SXOWNSP" t
               WHERE NVL(t."SBMDFL",' ') &lt;&gt; 'S'
        ) s
        LEFT JOIN k_cus j1 ON j1.dcb = s.n_sbdcb AND j1.dcs = s.n_sbdcs
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'SXOWNSP-501|Missing Links|Customer (SBDCB+SBDCS) not found in SSCUSTP'
      ))
    UNION ALL
/* =============================================================================
   TDACADP - TD Account Additional Information File
   Πίνακας: DATACUT5."HUB_MT_TDACADP"   Shadow: TAMDFL = 'S' (εξαιρούνται)   Έλεγχοι: 1
   Έλεγχοι από τους κανόνες της στήλης Free column του DD v1.24.
   ============================================================================= */
    SELECT 'TDACADP - TD Account Additional Information File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- TDACADP-501: Account (TAACB+TAACS+TAACX) not found in any account master (DD/LS/TD/PL/DC/IE/GL ACMSP)
          COUNT(CASE WHEN NVL(s.n_taacs, 0) &lt;&gt; 0 THEN 1 END) AS t1,
          COUNT(CASE WHEN NVL(s.n_taacs, 0) &lt;&gt; 0 AND j1.k1 IS NULL THEN 1 END) AS f1
        FROM (
              SELECT (CASE WHEN VALIDATE_CONVERSION(TRIM(t."TAACB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."TAACB")) END) AS n_taacb,
                     (CASE WHEN VALIDATE_CONVERSION(TRIM(t."TAACS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."TAACS")) END) AS n_taacs,
                     (CASE WHEN VALIDATE_CONVERSION(TRIM(t."TAACX") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."TAACX")) END) AS n_taacx
                FROM DATACUT5."HUB_MT_TDACADP" t
               WHERE NVL(t."TAMDFL",' ') &lt;&gt; 'S'
        ) s
        LEFT JOIN k_acc j1 ON j1.k1 = s.n_taacb AND j1.k2 = s.n_taacs AND j1.k3 = s.n_taacx
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'TDACADP-501|Missing Links|Account (TAACB+TAACS+TAACX) not found in any account master (DD/LS/TD/PL/DC/IE/GL ACMSP)'
      ))
    UNION ALL
/* =============================================================================
   TDACMSP - Term Deposits Account Master File
   Πίνακας: DATACUT5."HUB_MT_TDACMSP"   Shadow: TDMDFL = 'S' (εξαιρούνται)   Έλεγχοι: 7
   Έλεγχοι από τους κανόνες της στήλης Free column του DD v1.24.
   ============================================================================= */
    SELECT 'TDACMSP - Term Deposits Account Master File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- TDACMSP-501: Market Sector 1 (TDMKS1) not in SSSTDPP MS (market sector)
          COUNT(CASE WHEN TRIM(s."TDMKS1") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."TDMKS1"), '^[0. ]*$') THEN 1 END) AS t1,
          COUNT(CASE WHEN TRIM(s."TDMKS1") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."TDMKS1"), '^[0. ]*$') AND j1.code IS NULL THEN 1 END) AS f1,
          -- TDACMSP-502: Market Sector 2 (TDMKS2) not in SSSTDPP MS (market sector)
          COUNT(CASE WHEN TRIM(s."TDMKS2") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."TDMKS2"), '^[0. ]*$') THEN 1 END) AS t2,
          COUNT(CASE WHEN TRIM(s."TDMKS2") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."TDMKS2"), '^[0. ]*$') AND j2.code IS NULL THEN 1 END) AS f2,
          -- TDACMSP-503: Market Sector 3 (TDMKS3) not in SSSTDPP MS (market sector)
          COUNT(CASE WHEN TRIM(s."TDMKS3") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."TDMKS3"), '^[0. ]*$') THEN 1 END) AS t3,
          COUNT(CASE WHEN TRIM(s."TDMKS3") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."TDMKS3"), '^[0. ]*$') AND j3.code IS NULL THEN 1 END) AS f3,
          -- TDACMSP-504: Currency (TDCYCD) not a valid ISO currency code (3 letters; SSCYIFP not in extract)
          COUNT(CASE WHEN TRIM(s."TDCYCD") IS NOT NULL THEN 1 END) AS t4,
          COUNT(CASE WHEN TRIM(s."TDCYCD") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."TDCYCD"), '^[A-Z]{3}$') THEN 1 END) AS f4,
          -- TDACMSP-505: GHO classification (TDGHCL) not found in SSGHCLP
          COUNT(CASE WHEN TRIM(s."TDGHCL") IS NOT NULL THEN 1 END) AS t5,
          COUNT(CASE WHEN TRIM(s."TDGHCL") IS NOT NULL AND j4.code IS NULL THEN 1 END) AS f5,
          -- TDACMSP-506: Branch (TDACB) not found in SSBRCPP
          COUNT(CASE WHEN NVL(s.n_tdacb, 0) &lt;&gt; 0 THEN 1 END) AS t6,
          COUNT(CASE WHEN NVL(s.n_tdacb, 0) &lt;&gt; 0 AND j5.brn IS NULL THEN 1 END) AS f6,
          -- TDACMSP-507: Product type (TDAPTY) not found in any PDCPP (DD/TD/LS/PL/DC)
          COUNT(CASE WHEN TRIM(s."TDAPTY") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."TDAPTY"), '^[0. ]*$') THEN 1 END) AS t7,
          COUNT(CASE WHEN TRIM(s."TDAPTY") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."TDAPTY"), '^[0. ]*$') AND j6.code IS NULL THEN 1 END) AS f7
        FROM (
              SELECT t."TDAPTY",
                     t."TDCYCD",
                     t."TDGHCL",
                     t."TDMKS1",
                     t."TDMKS2",
                     t."TDMKS3",
                     (CASE WHEN VALIDATE_CONVERSION(TRIM(t."TDACB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."TDACB")) END) AS n_tdacb
                FROM DATACUT5."HUB_MT_TDACMSP" t
               WHERE NVL(t."TDMDFL",' ') &lt;&gt; 'S'
        ) s
        LEFT JOIN ref_std_ms j1 ON j1.code = NVL(LTRIM(TRIM(s."TDMKS1"), '0'), '0')
        LEFT JOIN ref_std_ms j2 ON j2.code = NVL(LTRIM(TRIM(s."TDMKS2"), '0'), '0')
        LEFT JOIN ref_std_ms j3 ON j3.code = NVL(LTRIM(TRIM(s."TDMKS3"), '0'), '0')
        LEFT JOIN k_ghcl j4 ON j4.code = TRIM(s."TDGHCL")
        LEFT JOIN k_brn j5 ON j5.brn = s.n_tdacb
        LEFT JOIN ref_apty j6 ON j6.code = TRIM(s."TDAPTY")
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'TDACMSP-501|Invalid Values|Market Sector 1 (TDMKS1) not in SSSTDPP MS (market sector)',
        (t2, f2) AS 'TDACMSP-502|Invalid Values|Market Sector 2 (TDMKS2) not in SSSTDPP MS (market sector)',
        (t3, f3) AS 'TDACMSP-503|Invalid Values|Market Sector 3 (TDMKS3) not in SSSTDPP MS (market sector)',
        (t4, f4) AS 'TDACMSP-504|Format|Currency (TDCYCD) not a valid ISO currency code (3 letters; SSCYIFP not in extract)',
        (t5, f5) AS 'TDACMSP-505|Missing Links|GHO classification (TDGHCL) not found in SSGHCLP',
        (t6, f6) AS 'TDACMSP-506|Missing Links|Branch (TDACB) not found in SSBRCPP',
        (t7, f7) AS 'TDACMSP-507|Missing Links|Product type (TDAPTY) not found in any PDCPP (DD/TD/LS/PL/DC)'
      ))
    UNION ALL
/* =============================================================================
   TDSPCPP - Term Deposits Sub-Product Control - Prod Copy
   Πίνακας: DATACUT5."HUB_MT_TDSPCPP"   Shadow: TBMDFL = 'S' (εξαιρούνται)   Έλεγχοι: 2
   Έλεγχοι από τους κανόνες της στήλης Free column του DD v1.24.
   ============================================================================= */
    SELECT 'TDSPCPP - Term Deposits Sub-Product Control - Prod Copy' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- TDSPCPP-501: Currency (TBCYCD) not a valid ISO currency code (3 letters; SSCYIFP not in extract)
          COUNT(CASE WHEN TRIM(s."TBCYCD") IS NOT NULL THEN 1 END) AS t1,
          COUNT(CASE WHEN TRIM(s."TBCYCD") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."TBCYCD"), '^[A-Z]{3}$') THEN 1 END) AS f1,
          -- TDSPCPP-502: Product type (TBAPTY) not found in any PDCPP (DD/TD/LS/PL/DC)
          COUNT(CASE WHEN TRIM(s."TBAPTY") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."TBAPTY"), '^[0. ]*$') THEN 1 END) AS t2,
          COUNT(CASE WHEN TRIM(s."TBAPTY") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."TBAPTY"), '^[0. ]*$') AND j1.code IS NULL THEN 1 END) AS f2
        FROM (
              SELECT t."TBAPTY",
                     t."TBCYCD"
                FROM DATACUT5."HUB_MT_TDSPCPP" t
               WHERE NVL(t."TBMDFL",' ') &lt;&gt; 'S'
        ) s
        LEFT JOIN ref_apty j1 ON j1.code = TRIM(s."TBAPTY")
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'TDSPCPP-501|Format|Currency (TBCYCD) not a valid ISO currency code (3 letters; SSCYIFP not in extract)',
        (t2, f2) AS 'TDSPCPP-502|Missing Links|Product type (TBAPTY) not found in any PDCPP (DD/TD/LS/PL/DC)'
      ))
    UNION ALL
/* =============================================================================
   SSRCUSP - User Authority Check File.
   Πίνακας: DATACUT5."HUB_MT_SSRCUSP"   Shadow: δεν υπάρχει mode flag   Έλεγχοι: 2
   Έλεγχοι από τους κανόνες της στήλης Free column του DD v1.24.
   ============================================================================= */
    SELECT 'SSRCUSP - User Authority Check File.' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- SSRCUSP-501: Customer (JPDCB+JPDCS) not found in SSCUSTP
          COUNT(CASE WHEN NVL(s.n_jpdcb, 0) &lt;&gt; 0 AND NVL(s.n_jpdcs, 0) &lt;&gt; 0 THEN 1 END) AS t1,
          COUNT(CASE WHEN NVL(s.n_jpdcb, 0) &lt;&gt; 0 AND NVL(s.n_jpdcs, 0) &lt;&gt; 0 AND j1.dcb IS NULL THEN 1 END) AS f1,
          -- SSRCUSP-502: GHO classification (JPGHCL) not found in SSGHCLP
          COUNT(CASE WHEN TRIM(s."JPGHCL") IS NOT NULL THEN 1 END) AS t2,
          COUNT(CASE WHEN TRIM(s."JPGHCL") IS NOT NULL AND j2.code IS NULL THEN 1 END) AS f2
        FROM (
              SELECT t."JPGHCL",
                     (CASE WHEN VALIDATE_CONVERSION(TRIM(t."JPDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."JPDCB")) END) AS n_jpdcb,
                     (CASE WHEN VALIDATE_CONVERSION(TRIM(t."JPDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."JPDCS")) END) AS n_jpdcs
                FROM DATACUT5."HUB_MT_SSRCUSP" t
        ) s
        LEFT JOIN k_cus j1 ON j1.dcb = s.n_jpdcb AND j1.dcs = s.n_jpdcs
        LEFT JOIN k_ghcl j2 ON j2.code = TRIM(s."JPGHCL")
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'SSRCUSP-501|Missing Links|Customer (JPDCB+JPDCS) not found in SSCUSTP',
        (t2, f2) AS 'SSRCUSP-502|Missing Links|GHO classification (JPGHCL) not found in SSGHCLP'
      ))
    UNION ALL
/* =============================================================================
   DDTNJNP - Demand Deposits Transaction Journal
   Πίνακας: DATACUT5."HUB_MT_DDTNJNP"   Shadow: δεν υπάρχει mode flag   Έλεγχοι: 2
   Έλεγχοι από τους κανόνες της στήλης Free column του DD v1.24.
   ============================================================================= */
    SELECT 'DDTNJNP - Demand Deposits Transaction Journal' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- DDTNJNP-501: Currency (DPCYCD) not a valid ISO currency code (3 letters; SSCYIFP not in extract) [masked]
          COUNT(CASE WHEN TRIM(s."DPCYCD") IS NOT NULL THEN 1 END) AS t1,
          COUNT(CASE WHEN TRIM(s."DPCYCD") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."DPCYCD"), '^[A-Z]{3}$') THEN 1 END) AS f1,
          -- DDTNJNP-502: Product type (DPAPTY) not found in any PDCPP (DD/TD/LS/PL/DC)
          COUNT(CASE WHEN TRIM(s."DPAPTY") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."DPAPTY"), '^[0. ]*$') THEN 1 END) AS t2,
          COUNT(CASE WHEN TRIM(s."DPAPTY") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."DPAPTY"), '^[0. ]*$') AND j1.code IS NULL THEN 1 END) AS f2
        FROM (
              SELECT t."DPAPTY",
                     t."DPCYCD"
                FROM DATACUT5."HUB_MT_DDTNJNP" t
        ) s
        LEFT JOIN ref_apty j1 ON j1.code = TRIM(s."DPAPTY")
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'DDTNJNP-501|Format|Currency (DPCYCD) not a valid ISO currency code (3 letters; SSCYIFP not in extract) [masked]',
        (t2, f2) AS 'DDTNJNP-502|Missing Links|Product type (DPAPTY) not found in any PDCPP (DD/TD/LS/PL/DC)'
      ))
    UNION ALL
/* =============================================================================
   GLTNJNP - General Ledger Transaction Journal File
   Πίνακας: DATACUT5."HUB_MT_GLTNJNP"   Shadow: δεν υπάρχει mode flag   Έλεγχοι: 3
   Έλεγχοι από τους κανόνες της στήλης Free column του DD v1.24.
   ============================================================================= */
    SELECT 'GLTNJNP - General Ledger Transaction Journal File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- GLTNJNP-501: Currency (G4CYCD) not a valid ISO currency code (3 letters; SSCYIFP not in extract) [masked]
          COUNT(CASE WHEN TRIM(s."G4CYCD") IS NOT NULL THEN 1 END) AS t1,
          COUNT(CASE WHEN TRIM(s."G4CYCD") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."G4CYCD"), '^[A-Z]{3}$') THEN 1 END) AS f1,
          -- GLTNJNP-502: GHO classification (G4GHCL) not found in SSGHCLP
          COUNT(CASE WHEN TRIM(s."G4GHCL") IS NOT NULL THEN 1 END) AS t2,
          COUNT(CASE WHEN TRIM(s."G4GHCL") IS NOT NULL AND j1.code IS NULL THEN 1 END) AS f2,
          -- GLTNJNP-503: Product type (G4APTY) not found in any PDCPP (DD/TD/LS/PL/DC)
          COUNT(CASE WHEN TRIM(s."G4APTY") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."G4APTY"), '^[0. ]*$') THEN 1 END) AS t3,
          COUNT(CASE WHEN TRIM(s."G4APTY") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."G4APTY"), '^[0. ]*$') AND j2.code IS NULL THEN 1 END) AS f3
        FROM (
              SELECT t."G4APTY",
                     t."G4CYCD",
                     t."G4GHCL"
                FROM DATACUT5."HUB_MT_GLTNJNP" t
        ) s
        LEFT JOIN k_ghcl j1 ON j1.code = TRIM(s."G4GHCL")
        LEFT JOIN ref_apty j2 ON j2.code = TRIM(s."G4APTY")
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'GLTNJNP-501|Format|Currency (G4CYCD) not a valid ISO currency code (3 letters; SSCYIFP not in extract) [masked]',
        (t2, f2) AS 'GLTNJNP-502|Missing Links|GHO classification (G4GHCL) not found in SSGHCLP',
        (t3, f3) AS 'GLTNJNP-503|Missing Links|Product type (G4APTY) not found in any PDCPP (DD/TD/LS/PL/DC)'
      ))
    UNION ALL
/* =============================================================================
   LSTNJNP - LS TRANSACTION JOURNAL FILE
   Πίνακας: DATACUT5."HUB_MT_LSTNJNP"   Shadow: δεν υπάρχει mode flag   Έλεγχοι: 2
   Έλεγχοι από τους κανόνες της στήλης Free column του DD v1.24.
   ============================================================================= */
    SELECT 'LSTNJNP - LS TRANSACTION JOURNAL FILE' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- LSTNJNP-501: CURRENCY (ZYCYCD) not a valid ISO currency code (3 letters; SSCYIFP not in extract) [masked]
          COUNT(CASE WHEN TRIM(s."ZYCYCD") IS NOT NULL THEN 1 END) AS t1,
          COUNT(CASE WHEN TRIM(s."ZYCYCD") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."ZYCYCD"), '^[A-Z]{3}$') THEN 1 END) AS f1,
          -- LSTNJNP-502: Product type (ZYAPTY) not found in any PDCPP (DD/TD/LS/PL/DC)
          COUNT(CASE WHEN TRIM(s."ZYAPTY") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."ZYAPTY"), '^[0. ]*$') THEN 1 END) AS t2,
          COUNT(CASE WHEN TRIM(s."ZYAPTY") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."ZYAPTY"), '^[0. ]*$') AND j1.code IS NULL THEN 1 END) AS f2
        FROM (
              SELECT t."ZYAPTY",
                     t."ZYCYCD"
                FROM DATACUT5."HUB_MT_LSTNJNP" t
        ) s
        LEFT JOIN ref_apty j1 ON j1.code = TRIM(s."ZYAPTY")
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'LSTNJNP-501|Format|CURRENCY (ZYCYCD) not a valid ISO currency code (3 letters; SSCYIFP not in extract) [masked]',
        (t2, f2) AS 'LSTNJNP-502|Missing Links|Product type (ZYAPTY) not found in any PDCPP (DD/TD/LS/PL/DC)'
      ))
    UNION ALL
/* =============================================================================
   TDTRNJP - Term Deposits Transaction Journal
   Πίνακας: DATACUT5."HUB_MT_TDTRNJP"   Shadow: δεν υπάρχει mode flag   Έλεγχοι: 2
   Έλεγχοι από τους κανόνες της στήλης Free column του DD v1.24.
   ============================================================================= */
    SELECT 'TDTRNJP - Term Deposits Transaction Journal' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- TDTRNJP-501: Currency (THCYCD) not a valid ISO currency code (3 letters; SSCYIFP not in extract) [masked]
          COUNT(CASE WHEN TRIM(s."THCYCD") IS NOT NULL THEN 1 END) AS t1,
          COUNT(CASE WHEN TRIM(s."THCYCD") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."THCYCD"), '^[A-Z]{3}$') THEN 1 END) AS f1,
          -- TDTRNJP-502: Product type (THAPTY) not found in any PDCPP (DD/TD/LS/PL/DC)
          COUNT(CASE WHEN TRIM(s."THAPTY") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."THAPTY"), '^[0. ]*$') THEN 1 END) AS t2,
          COUNT(CASE WHEN TRIM(s."THAPTY") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."THAPTY"), '^[0. ]*$') AND j1.code IS NULL THEN 1 END) AS f2
        FROM (
              SELECT t."THAPTY",
                     t."THCYCD"
                FROM DATACUT5."HUB_MT_TDTRNJP" t
        ) s
        LEFT JOIN ref_apty j1 ON j1.code = TRIM(s."THAPTY")
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'TDTRNJP-501|Format|Currency (THCYCD) not a valid ISO currency code (3 letters; SSCYIFP not in extract) [masked]',
        (t2, f2) AS 'TDTRNJP-502|Missing Links|Product type (THAPTY) not found in any PDCPP (DD/TD/LS/PL/DC)'
      ))
  )
SELECT
    CAST('ME01' AS NVARCHAR2(20))                                AS DQ_AREA,
    CAST(REGEXP_SUBSTR(check_key, '[^|]+', 1, 2) AS NVARCHAR2(50))  AS DQ_CATEGORY,
    CAST(REGEXP_SUBSTR(check_key, '[^|]+', 1, 1) AS NVARCHAR2(30))  AS CHECK_ID,
    CAST(REGEXP_SUBSTR(check_key, '[^|]+', 1, 3) AS NVARCHAR2(500)) AS CHECK_NAME,
    TO_NCHAR(table_name)                                         AS TABLE_NAME,
    total                                                        AS TOTAL_RECORDS,
    failed                                                       AS FAILED_RECORDS,
    TO_NCHAR(CASE WHEN failed = 0 THEN 'PASS' ELSE 'FAIL' END)   AS DQ_STATUS,
    -- IS_MASKED: Y όταν τουλάχιστον ένα πεδίο του ελέγχου έχει «Masking Applied» = Yes στο DD v1.24.
    -- Δίπλα σε κάθε CHECK_ID: τα masked πεδία του. Όλοι οι υπόλοιποι έλεγχοι = N.
    CASE WHEN REGEXP_SUBSTR(check_key, '[^|]+', 1, 1) IN (
        'AFSIADP-501',   -- FRPPAS
        'AFSIADP-502',   -- FRCTCM
        'AFSIADP-503',   -- FRIBCT
