          COUNT(CASE WHEN TRIM(t."CUSTNO") IS NOT NULL AND j1.sno IS NOT NULL AND j3.sno IS NULL THEN 1 END) AS f10
        FROM DATACUT5."SETTRFSHBN" t
        CROSS JOIN params p
        LEFT JOIN k_sno j1 ON j1.sno = TRIM(t."SNO")
        LEFT JOIN k_cus j2 ON j2.dcb = (CASE WHEN REGEXP_LIKE(TRIM(t."CUSTNO"), '^0?[0-9]{3}-[0-9]{6}$') THEN TO_NUMBER(REGEXP_SUBSTR(TRIM(t."CUSTNO"), '^[0-9]+')) END) AND j2.dcs = (CASE WHEN REGEXP_LIKE(TRIM(t."CUSTNO"), '^0?[0-9]{3}-[0-9]{6}$') THEN TO_NUMBER(REGEXP_SUBSTR(TRIM(t."CUSTNO"), '[0-9]+$')) END)
