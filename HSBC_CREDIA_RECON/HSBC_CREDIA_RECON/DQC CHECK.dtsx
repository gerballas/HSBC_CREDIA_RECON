        (t5, f5) AS 'SETTRFSHBN-005|Invalid Values|Settlement Type not P/S/W (SETTLEMENTTYPE)',
        (t6, f6) AS 'SETTRFSHBN-006|Invalid Dates|Invalid date: Date when Deceased Customer File was created (SDATE)',
        (t7, f7) AS 'SETTRFSHBN-007|Invalid Dates|Invalid date: Date of Death (DOD)',
