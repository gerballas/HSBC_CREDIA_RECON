          -- SETFUNDTRF-008: Deceased file (SNO) not found in DECEASED
          COUNT(CASE WHEN TRIM(t."SNO") IS NOT NULL THEN 1 END) AS t8,
          COUNT(CASE WHEN TRIM(t."SNO") IS NOT NULL AND j1.sno IS NULL THEN 1 END) AS f8,
          -- SETFUNDTRF-009: Customer (CUSTNO) not found in SSCUSTP
          COUNT(CASE WHEN REGEXP_LIKE(TRIM(t."CUSTNO"), '^0?[0-9]{3}-[0-9]{6}$') THEN 1 END) AS t9,
          COUNT(CASE WHEN REGEXP_LIKE(TRIM(t."CUSTNO"), '^0?[0-9]{3}-[0-9]{6}$') AND j2.dcb IS NULL THEN 1 END) AS f9,
          -- SETFUNDTRF-010: HUB customer number (CUSTNO) differs from the deceased file in DECEASED (same SNO)
          COUNT(CASE WHEN TRIM(t."CUSTNO") IS NOT NULL AND j1.sno IS NOT NULL THEN 1 END) AS t10,
          COUNT(CASE WHEN TRIM(t."CUSTNO") IS NOT NULL AND j1.sno IS NOT NULL AND j3.sno IS NULL THEN 1 END) AS f10
        FROM DATACUT5."SETFUNDTRF" t
        CROSS JOIN params p
        LEFT JOIN k_sno j1 ON j1.sno = TRIM(t."SNO")
        LEFT JOIN k_cus j2 ON j2.dcb = (CASE WHEN REGEXP_LIKE(TRIM(t."CUSTNO"), '^0?[0-9]{3}-[0-9]{6}$') THEN TO_NUMBER(REGEXP_SUBSTR(TRIM(t."CUSTNO"), '^[0-9]+')) END) AND j2.dcs = (CASE WHEN REGEXP_LIKE(TRIM(t."CUSTNO"), '^0?[0-9]{3}-[0-9]{6}$') THEN TO_NUMBER(REGEXP_SUBSTR(TRIM(t."CUSTNO"), '[0-9]+$')) END)
        LEFT JOIN k_dcs j3 ON j3.sno = TRIM(t."SNO") AND j3.cn = TRIM(t."CUSTNO")
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'SETFUNDTRF-001|Missing Data|Missing Deceased Customer File Ref Number (SNO)',
        (t2, f2) AS 'SETFUNDTRF-002|Missing Data|Missing HUB Customer No (CUSTNO)',
        (t3, f3) AS 'SETFUNDTRF-003|Invalid Values|File reference number not in format 9999/YY (SNO)',
        (t4, f4) AS 'SETFUNDTRF-004|Invalid Values|HUB customer number not in format 999-999999 / 0999-999999 (CUSTNO)',
        (t5, f5) AS 'SETFUNDTRF-005|Invalid Values|Settlement Type not P/S/W (SETTLEMENTTYPE)',
        (t6, f6) AS 'SETFUNDTRF-006|Invalid Dates|Invalid date: Date when Deceased Customer File was created (SDATE)',
        (t7, f7) AS 'SETFUNDTRF-007|Invalid Dates|Invalid date: Date of Death (DOD)',
        (t8, f8) AS 'SETFUNDTRF-008|Missing Links|Deceased file (SNO) not found in DECEASED',
        (t9, f9) AS 'SETFUNDTRF-009|Missing Links|Customer (CUSTNO) not found in SSCUSTP',
        (t10, f10) AS 'SETFUNDTRF-010|Inconsistent Data|HUB customer number (CUSTNO) differs from the deceased file in DECEASED (same SNO)'
      ))
    UNION ALL
/* =============================================================================
   SETINSCLM - Settlement Details - Insurance claim details
   Πίνακας: DATACUT5."SETINSCLM"   Shadow: δεν υπάρχει mode flag   Έλεγχοι: 10
   ============================================================================= */
    SELECT 'SETINSCLM - Settlement Details - Insurance claim details' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- SETINSCLM-001: Missing Deceased Customer File Ref Number (SNO)
          COUNT(*) AS t1,
          COUNT(CASE WHEN TRIM(t."SNO") IS NULL THEN 1 END) AS f1,
          -- SETINSCLM-002: Missing HUB Customer No (CUSTNO)
          COUNT(*) AS t2,
          COUNT(CASE WHEN TRIM(t."CUSTNO") IS NULL THEN 1 END) AS f2,
          -- SETINSCLM-003: File reference number not in format 9999/YY (SNO)
          COUNT(CASE WHEN TRIM(t."SNO") IS NOT NULL THEN 1 END) AS t3,
          COUNT(CASE WHEN TRIM(t."SNO") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(t."SNO"), '^[0-9]{1,4}/[0-9]{2}$') THEN 1 END) AS f3,
          -- SETINSCLM-004: HUB customer number not in format 999-999999 / 0999-999999 (CUSTNO)
          COUNT(CASE WHEN TRIM(t."CUSTNO") IS NOT NULL THEN 1 END) AS t4,
          COUNT(CASE WHEN TRIM(t."CUSTNO") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(t."CUSTNO"), '^0?[0-9]{3}-[0-9]{6}$') THEN 1 END) AS f4,
          -- SETINSCLM-005: Settlement Type not P/S/W (SETTLEMENTTYPE)
          COUNT(*) AS t5,
          COUNT(CASE WHEN TRIM(t."SETTLEMENTTYPE") IS NOT NULL AND TRIM(t."SETTLEMENTTYPE") NOT IN ('P','S','W') THEN 1 END) AS f5,
          -- SETINSCLM-006: Invalid date: Date when Deceased Customer File was created (SDATE)
          COUNT(*) AS t6,
          COUNT(CASE WHEN TRIM(t."SDATE") IS NOT NULL AND NOT (REGEXP_LIKE(TRIM(t."SDATE"), '^[0-9]{1,2}[/.][0-9]{1,2}[/.][0-9]{4}$') AND NVL(COALESCE(TO_DATE(REPLACE(TRIM(t."SDATE"), '.', '/') DEFAULT NULL ON CONVERSION ERROR, 'DD/MM/YYYY'), TO_DATE(TRIM(t."SDATE") DEFAULT NULL ON CONVERSION ERROR, 'MM/DD/YYYY')), DATE '0001-01-01') &gt;= DATE '1900-01-01') THEN 1 END) AS f6,
          -- SETINSCLM-007: Invalid date: Date of Death (DOD)
          COUNT(*) AS t7,
          COUNT(CASE WHEN TRIM(t."DOD") IS NOT NULL AND NOT (REGEXP_LIKE(TRIM(t."DOD"), '^[0-9]{1,2}/[A-Za-z]{3}/[0-9]{4}$') AND NVL(TO_DATE(TRIM(t."DOD") DEFAULT NULL ON CONVERSION ERROR, 'DD/Mon/YYYY', 'NLS_DATE_LANGUAGE=ENGLISH'), DATE '0001-01-01') &gt;= DATE '1900-01-01') THEN 1 END) AS f7,
          -- SETINSCLM-008: Deceased file (SNO) not found in DECEASED
          COUNT(CASE WHEN TRIM(t."SNO") IS NOT NULL THEN 1 END) AS t8,
          COUNT(CASE WHEN TRIM(t."SNO") IS NOT NULL AND j1.sno IS NULL THEN 1 END) AS f8,
          -- SETINSCLM-009: Customer (CUSTNO) not found in SSCUSTP
          COUNT(CASE WHEN REGEXP_LIKE(TRIM(t."CUSTNO"), '^0?[0-9]{3}-[0-9]{6}$') THEN 1 END) AS t9,
          COUNT(CASE WHEN REGEXP_LIKE(TRIM(t."CUSTNO"), '^0?[0-9]{3}-[0-9]{6}$') AND j2.dcb IS NULL THEN 1 END) AS f9,
          -- SETINSCLM-010: HUB customer number (CUSTNO) differs from the deceased file in DECEASED (same SNO)
          COUNT(CASE WHEN TRIM(t."CUSTNO") IS NOT NULL AND j1.sno IS NOT NULL THEN 1 END) AS t10,
          COUNT(CASE WHEN TRIM(t."CUSTNO") IS NOT NULL AND j1.sno IS NOT NULL AND j3.sno IS NULL THEN 1 END) AS f10
        FROM DATACUT5."SETINSCLM" t
        CROSS JOIN params p
        LEFT JOIN k_sno j1 ON j1.sno = TRIM(t."SNO")
        LEFT JOIN k_cus j2 ON j2.dcb = (CASE WHEN REGEXP_LIKE(TRIM(t."CUSTNO"), '^0?[0-9]{3}-[0-9]{6}$') THEN TO_NUMBER(REGEXP_SUBSTR(TRIM(t."CUSTNO"), '^[0-9]+')) END) AND j2.dcs = (CASE WHEN REGEXP_LIKE(TRIM(t."CUSTNO"), '^0?[0-9]{3}-[0-9]{6}$') THEN TO_NUMBER(REGEXP_SUBSTR(TRIM(t."CUSTNO"), '[0-9]+$')) END)
        LEFT JOIN k_dcs j3 ON j3.sno = TRIM(t."SNO") AND j3.cn = TRIM(t."CUSTNO")
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'SETINSCLM-001|Missing Data|Missing Deceased Customer File Ref Number (SNO)',
        (t2, f2) AS 'SETINSCLM-002|Missing Data|Missing HUB Customer No (CUSTNO)',
        (t3, f3) AS 'SETINSCLM-003|Invalid Values|File reference number not in format 9999/YY (SNO)',
        (t4, f4) AS 'SETINSCLM-004|Invalid Values|HUB customer number not in format 999-999999 / 0999-999999 (CUSTNO)',
        (t5, f5) AS 'SETINSCLM-005|Invalid Values|Settlement Type not P/S/W (SETTLEMENTTYPE)',
        (t6, f6) AS 'SETINSCLM-006|Invalid Dates|Invalid date: Date when Deceased Customer File was created (SDATE)',
        (t7, f7) AS 'SETINSCLM-007|Invalid Dates|Invalid date: Date of Death (DOD)',
        (t8, f8) AS 'SETINSCLM-008|Missing Links|Deceased file (SNO) not found in DECEASED',
        (t9, f9) AS 'SETINSCLM-009|Missing Links|Customer (CUSTNO) not found in SSCUSTP',
        (t10, f10) AS 'SETINSCLM-010|Inconsistent Data|HUB customer number (CUSTNO) differs from the deceased file in DECEASED (same SNO)'
      ))
    UNION ALL
/* =============================================================================
   SETSECTRF - Settlement Details - Transfer of securities
   Πίνακας: DATACUT5."SETSECTRF"   Shadow: δεν υπάρχει mode flag   Έλεγχοι: 10
   ============================================================================= */
    SELECT 'SETSECTRF - Settlement Details - Transfer of securities' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- SETSECTRF-001: Missing Deceased Customer File Ref Number (SNO)
          COUNT(*) AS t1,
          COUNT(CASE WHEN TRIM(t."SNO") IS NULL THEN 1 END) AS f1,
          -- SETSECTRF-002: Missing HUB Customer No (CUSTNO)
          COUNT(*) AS t2,
          COUNT(CASE WHEN TRIM(t."CUSTNO") IS NULL THEN 1 END) AS f2,
          -- SETSECTRF-003: File reference number not in format 9999/YY (SNO)
          COUNT(CASE WHEN TRIM(t."SNO") IS NOT NULL THEN 1 END) AS t3,
          COUNT(CASE WHEN TRIM(t."SNO") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(t."SNO"), '^[0-9]{1,4}/[0-9]{2}$') THEN 1 END) AS f3,
          -- SETSECTRF-004: HUB customer number not in format 999-999999 / 0999-999999 (CUSTNO)
          COUNT(CASE WHEN TRIM(t."CUSTNO") IS NOT NULL THEN 1 END) AS t4,
          COUNT(CASE WHEN TRIM(t."CUSTNO") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(t."CUSTNO"), '^0?[0-9]{3}-[0-9]{6}$') THEN 1 END) AS f4,
          -- SETSECTRF-005: Settlement Type not P/S/W (SETTLEMENTTYPE)
          COUNT(*) AS t5,
          COUNT(CASE WHEN TRIM(t."SETTLEMENTTYPE") IS NOT NULL AND TRIM(t."SETTLEMENTTYPE") NOT IN ('P','S','W') THEN 1 END) AS f5,
          -- SETSECTRF-006: Invalid date: Date when Deceased Customer File was created (SDATE)
          COUNT(*) AS t6,
          COUNT(CASE WHEN TRIM(t."SDATE") IS NOT NULL AND NOT (REGEXP_LIKE(TRIM(t."SDATE"), '^[0-9]{1,2}[/.][0-9]{1,2}[/.][0-9]{4}$') AND NVL(COALESCE(TO_DATE(REPLACE(TRIM(t."SDATE"), '.', '/') DEFAULT NULL ON CONVERSION ERROR, 'DD/MM/YYYY'), TO_DATE(TRIM(t."SDATE") DEFAULT NULL ON CONVERSION ERROR, 'MM/DD/YYYY')), DATE '0001-01-01') &gt;= DATE '1900-01-01') THEN 1 END) AS f6,
          -- SETSECTRF-007: Invalid date: Date of Death (DOD)
          COUNT(*) AS t7,
          COUNT(CASE WHEN TRIM(t."DOD") IS NOT NULL AND NOT (REGEXP_LIKE(TRIM(t."DOD"), '^[0-9]{1,2}/[A-Za-z]{3}/[0-9]{4}$') AND NVL(TO_DATE(TRIM(t."DOD") DEFAULT NULL ON CONVERSION ERROR, 'DD/Mon/YYYY', 'NLS_DATE_LANGUAGE=ENGLISH'), DATE '0001-01-01') &gt;= DATE '1900-01-01') THEN 1 END) AS f7,
          -- SETSECTRF-008: Deceased file (SNO) not found in DECEASED
          COUNT(CASE WHEN TRIM(t."SNO") IS NOT NULL THEN 1 END) AS t8,
          COUNT(CASE WHEN TRIM(t."SNO") IS NOT NULL AND j1.sno IS NULL THEN 1 END) AS f8,
          -- SETSECTRF-009: Customer (CUSTNO) not found in SSCUSTP
          COUNT(CASE WHEN REGEXP_LIKE(TRIM(t."CUSTNO"), '^0?[0-9]{3}-[0-9]{6}$') THEN 1 END) AS t9,
          COUNT(CASE WHEN REGEXP_LIKE(TRIM(t."CUSTNO"), '^0?[0-9]{3}-[0-9]{6}$') AND j2.dcb IS NULL THEN 1 END) AS f9,
          -- SETSECTRF-010: HUB customer number (CUSTNO) differs from the deceased file in DECEASED (same SNO)
          COUNT(CASE WHEN TRIM(t."CUSTNO") IS NOT NULL AND j1.sno IS NOT NULL THEN 1 END) AS t10,
          COUNT(CASE WHEN TRIM(t."CUSTNO") IS NOT NULL AND j1.sno IS NOT NULL AND j3.sno IS NULL THEN 1 END) AS f10
        FROM DATACUT5."SETSECTRF" t
        CROSS JOIN params p
        LEFT JOIN k_sno j1 ON j1.sno = TRIM(t."SNO")
        LEFT JOIN k_cus j2 ON j2.dcb = (CASE WHEN REGEXP_LIKE(TRIM(t."CUSTNO"), '^0?[0-9]{3}-[0-9]{6}$') THEN TO_NUMBER(REGEXP_SUBSTR(TRIM(t."CUSTNO"), '^[0-9]+')) END) AND j2.dcs = (CASE WHEN REGEXP_LIKE(TRIM(t."CUSTNO"), '^0?[0-9]{3}-[0-9]{6}$') THEN TO_NUMBER(REGEXP_SUBSTR(TRIM(t."CUSTNO"), '[0-9]+$')) END)
        LEFT JOIN k_dcs j3 ON j3.sno = TRIM(t."SNO") AND j3.cn = TRIM(t."CUSTNO")
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'SETSECTRF-001|Missing Data|Missing Deceased Customer File Ref Number (SNO)',
        (t2, f2) AS 'SETSECTRF-002|Missing Data|Missing HUB Customer No (CUSTNO)',
        (t3, f3) AS 'SETSECTRF-003|Invalid Values|File reference number not in format 9999/YY (SNO)',
        (t4, f4) AS 'SETSECTRF-004|Invalid Values|HUB customer number not in format 999-999999 / 0999-999999 (CUSTNO)',
        (t5, f5) AS 'SETSECTRF-005|Invalid Values|Settlement Type not P/S/W (SETTLEMENTTYPE)',
        (t6, f6) AS 'SETSECTRF-006|Invalid Dates|Invalid date: Date when Deceased Customer File was created (SDATE)',
        (t7, f7) AS 'SETSECTRF-007|Invalid Dates|Invalid date: Date of Death (DOD)',
        (t8, f8) AS 'SETSECTRF-008|Missing Links|Deceased file (SNO) not found in DECEASED',
        (t9, f9) AS 'SETSECTRF-009|Missing Links|Customer (CUSTNO) not found in SSCUSTP',
        (t10, f10) AS 'SETSECTRF-010|Inconsistent Data|HUB customer number (CUSTNO) differs from the deceased file in DECEASED (same SNO)'
      ))
    UNION ALL
/* =============================================================================
   SETPARSAFE - Settlement Details - Retrieval of parcel/safe deposits
   Πίνακας: DATACUT5."SETPARSAFE"   Shadow: δεν υπάρχει mode flag   Έλεγχοι: 10
   ============================================================================= */
    SELECT 'SETPARSAFE - Settlement Details - Retrieval of parcel/safe deposits' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- SETPARSAFE-001: Missing Deceased Customer File Ref Number (SNO)
          COUNT(*) AS t1,
          COUNT(CASE WHEN TRIM(t."SNO") IS NULL THEN 1 END) AS f1,
          -- SETPARSAFE-002: Missing HUB Customer No (CUSTNO)
          COUNT(*) AS t2,
          COUNT(CASE WHEN TRIM(t."CUSTNO") IS NULL THEN 1 END) AS f2,
          -- SETPARSAFE-003: File reference number not in format 9999/YY (SNO)
          COUNT(CASE WHEN TRIM(t."SNO") IS NOT NULL THEN 1 END) AS t3,
          COUNT(CASE WHEN TRIM(t."SNO") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(t."SNO"), '^[0-9]{1,4}/[0-9]{2}$') THEN 1 END) AS f3,
          -- SETPARSAFE-004: HUB customer number not in format 999-999999 / 0999-999999 (CUSTNO)
          COUNT(CASE WHEN TRIM(t."CUSTNO") IS NOT NULL THEN 1 END) AS t4,
          COUNT(CASE WHEN TRIM(t."CUSTNO") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(t."CUSTNO"), '^0?[0-9]{3}-[0-9]{6}$') THEN 1 END) AS f4,
          -- SETPARSAFE-005: Settlement Type not P/S/W (SETTLEMENTTYPE)
          COUNT(*) AS t5,
          COUNT(CASE WHEN TRIM(t."SETTLEMENTTYPE") IS NOT NULL AND TRIM(t."SETTLEMENTTYPE") NOT IN ('P','S','W') THEN 1 END) AS f5,
          -- SETPARSAFE-006: Invalid date: Date when Deceased Customer File was created (SDATE)
          COUNT(*) AS t6,
          COUNT(CASE WHEN TRIM(t."SDATE") IS NOT NULL AND NOT (REGEXP_LIKE(TRIM(t."SDATE"), '^[0-9]{1,2}[/.][0-9]{1,2}[/.][0-9]{4}$') AND NVL(COALESCE(TO_DATE(REPLACE(TRIM(t."SDATE"), '.', '/') DEFAULT NULL ON CONVERSION ERROR, 'DD/MM/YYYY'), TO_DATE(TRIM(t."SDATE") DEFAULT NULL ON CONVERSION ERROR, 'MM/DD/YYYY')), DATE '0001-01-01') &gt;= DATE '1900-01-01') THEN 1 END) AS f6,
          -- SETPARSAFE-007: Invalid date: Date of Death (DOD)
          COUNT(*) AS t7,
          COUNT(CASE WHEN TRIM(t."DOD") IS NOT NULL AND NOT (REGEXP_LIKE(TRIM(t."DOD"), '^[0-9]{1,2}/[A-Za-z]{3}/[0-9]{4}$') AND NVL(TO_DATE(TRIM(t."DOD") DEFAULT NULL ON CONVERSION ERROR, 'DD/Mon/YYYY', 'NLS_DATE_LANGUAGE=ENGLISH'), DATE '0001-01-01') &gt;= DATE '1900-01-01') THEN 1 END) AS f7,
          -- SETPARSAFE-008: Deceased file (SNO) not found in DECEASED
          COUNT(CASE WHEN TRIM(t."SNO") IS NOT NULL THEN 1 END) AS t8,
          COUNT(CASE WHEN TRIM(t."SNO") IS NOT NULL AND j1.sno IS NULL THEN 1 END) AS f8,
          -- SETPARSAFE-009: Customer (CUSTNO) not found in SSCUSTP
          COUNT(CASE WHEN REGEXP_LIKE(TRIM(t."CUSTNO"), '^0?[0-9]{3}-[0-9]{6}$') THEN 1 END) AS t9,
          COUNT(CASE WHEN REGEXP_LIKE(TRIM(t."CUSTNO"), '^0?[0-9]{3}-[0-9]{6}$') AND j2.dcb IS NULL THEN 1 END) AS f9,
          -- SETPARSAFE-010: HUB customer number (CUSTNO) differs from the deceased file in DECEASED (same SNO)
          COUNT(CASE WHEN TRIM(t."CUSTNO") IS NOT NULL AND j1.sno IS NOT NULL THEN 1 END) AS t10,
          COUNT(CASE WHEN TRIM(t."CUSTNO") IS NOT NULL AND j1.sno IS NOT NULL AND j3.sno IS NULL THEN 1 END) AS f10
        FROM DATACUT5."SETPARSAFE" t
        CROSS JOIN params p
        LEFT JOIN k_sno j1 ON j1.sno = TRIM(t."SNO")
        LEFT JOIN k_cus j2 ON j2.dcb = (CASE WHEN REGEXP_LIKE(TRIM(t."CUSTNO"), '^0?[0-9]{3}-[0-9]{6}$') THEN TO_NUMBER(REGEXP_SUBSTR(TRIM(t."CUSTNO"), '^[0-9]+')) END) AND j2.dcs = (CASE WHEN REGEXP_LIKE(TRIM(t."CUSTNO"), '^0?[0-9]{3}-[0-9]{6}$') THEN TO_NUMBER(REGEXP_SUBSTR(TRIM(t."CUSTNO"), '[0-9]+$')) END)
        LEFT JOIN k_dcs j3 ON j3.sno = TRIM(t."SNO") AND j3.cn = TRIM(t."CUSTNO")
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'SETPARSAFE-001|Missing Data|Missing Deceased Customer File Ref Number (SNO)',
        (t2, f2) AS 'SETPARSAFE-002|Missing Data|Missing HUB Customer No (CUSTNO)',
        (t3, f3) AS 'SETPARSAFE-003|Invalid Values|File reference number not in format 9999/YY (SNO)',
        (t4, f4) AS 'SETPARSAFE-004|Invalid Values|HUB customer number not in format 999-999999 / 0999-999999 (CUSTNO)',
        (t5, f5) AS 'SETPARSAFE-005|Invalid Values|Settlement Type not P/S/W (SETTLEMENTTYPE)',
        (t6, f6) AS 'SETPARSAFE-006|Invalid Dates|Invalid date: Date when Deceased Customer File was created (SDATE)',
        (t7, f7) AS 'SETPARSAFE-007|Invalid Dates|Invalid date: Date of Death (DOD)',
        (t8, f8) AS 'SETPARSAFE-008|Missing Links|Deceased file (SNO) not found in DECEASED',
        (t9, f9) AS 'SETPARSAFE-009|Missing Links|Customer (CUSTNO) not found in SSCUSTP',
        (t10, f10) AS 'SETPARSAFE-010|Inconsistent Data|HUB customer number (CUSTNO) differs from the deceased file in DECEASED (same SNO)'
      ))
  )
SELECT
    CAST('ME13' AS NVARCHAR2(20))                                AS DQ_AREA,
    CAST(REGEXP_SUBSTR(check_key, '[^|]+', 1, 2) AS NVARCHAR2(50))  AS DQ_CATEGORY,
    CAST(REGEXP_SUBSTR(check_key, '[^|]+', 1, 1) AS NVARCHAR2(30))  AS CHECK_ID,
    CAST(REGEXP_SUBSTR(check_key, '[^|]+', 1, 3) AS NVARCHAR2(500)) AS CHECK_NAME,
    CAST(table_name AS NVARCHAR2(150))                           AS TABLE_NAME,
    total                                                        AS TOTAL_RECORDS,
    failed                                                       AS FAILED_RECORDS,
    TO_NCHAR(CASE WHEN failed = 0 THEN 'PASS' ELSE 'FAIL' END)   AS DQ_STATUS,
    -- IS_MASKED: Y όταν τουλάχιστον ένα πεδίο του ελέγχου έχει «Masking Approach» = Yes στο DD v3.0.
    -- Δίπλα σε κάθε CHECK_ID: τα masked πεδία του. Όλοι οι υπόλοιποι έλεγχοι = N.
    CASE WHEN REGEXP_SUBSTR(check_key, '[^|]+', 1, 1) IN (
        'CARDPRODS-002',  -- CUSTNO
        'CARDPRODS-004',  -- CUSTNO
        'CARDPRODS-006',  -- DOD
        'CARDPRODS-018',  -- CUSTNO
        'CARDPRODS-019',  -- CUSTNO
        'COMPSEC-002',    -- CUSTNO
        'COMPSEC-004',    -- CUSTNO
        'COMPSEC-006',    -- DOD
        'COMPSEC-041',    -- CUSTNO
        'COMPSEC-042',    -- CUSTNO
        'CUSTODY-002',    -- CUSTNO
        'CUSTODY-004',    -- CUSTNO
        'CUSTODY-006',    -- DOD
        'CUSTODY-040',    -- CUSTNO
        'CUSTODY-041',    -- CUSTNO
        'DECEASED-002',   -- CUSTNO
        'DECEASED-003',   -- FIRSTNAME,SURNAME
        'DECEASED-004',   -- IDNO
        'DECEASED-006',   -- DODDD,DODMM,DODYY
        'DECEASED-008',   -- CUSTNO
        'DECEASED-015',   -- DODDD,DODMM,DODYY
        'DECEASED-016',   -- DOBDD,DOBMM,DOBYY
        'DECEASED-021',   -- DODDD,DODMM,DODYY
        'DECEASED-022',   -- DOBDD,DOBMM,DOBYY
        'DECEASED-023',   -- DODDD,DODMM,DODYY,DOBDD,DOBMM,DOBYY
        'DECEASED-025',   -- CUSTNO
        'DECEASED-026',   -- DODDD,DODMM,DODYY,DOBDD,DOBMM,DOBYY
        'DECEASED-028',   -- DODDD,DODMM,DODYY,CUSTNO
        'FUNDMAN-002',    -- CUSTNO
        'FUNDMAN-004',    -- CUSTNO
        'FUNDMAN-006',    -- DOD
        'FUNDMAN-040',    -- CUSTNO
        'FUNDMAN-041',    -- CUSTNO
        'G355SETT-002',   -- CUSTNO
        'G355SETT-004',   -- CUSTNO
        'G355SETT-007',   -- DOD
        'G355SETT-018',   -- CUSTNO
        'G355SETT-019',   -- CUSTNO
        'HELDFUNDS-002',  -- CUSTNO
        'HELDFUNDS-004',  -- CUSTNO
        'HELDFUNDS-008',  -- DOD
        'HELDFUNDS-012',  -- CUSTNO
        'HELDFUNDS-013',  -- CUSTNO
        'LIFEASSURE-002', -- CUSTNO
        'LIFEASSURE-004', -- CUSTNO
        'LIFEASSURE-006', -- DOD
        'LIFEASSURE-010', -- CUSTNO
        'LIFEASSURE-011', -- CUSTNO
        'PRIVBILL-002',   -- CUSTNO
        'PRIVBILL-004',   -- CUSTNO
        'PRIVBILL-006',   -- DOD
        'PRIVBILL-010',   -- CUSTNO
        'PRIVBILL-011',   -- CUSTNO
        'SETARTHEIR-002', -- CUSTNO
        'SETARTHEIR-004', -- CUSTNO
        'SETARTHEIR-007', -- DOD
        'SETARTHEIR-009', -- CUSTNO
        'SETARTHEIR-010', -- CUSTNO
        'SETCLSDACC-002', -- CUSTNO
        'SETCLSDACC-004', -- CUSTNO
        'SETCLSDACC-007', -- DOD
        'SETCLSDACC-009', -- CUSTNO
        'SETCLSDACC-010', -- CUSTNO
        'SETDEDLEG-002',  -- CUSTNO
        'SETDEDLEG-004',  -- CUSTNO
        'SETDEDLEG-007',  -- DOD
