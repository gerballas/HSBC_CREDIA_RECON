                </component>
                <component
                  refId="Package\DQC_DC5\ME20_HIE_DQC\ME20_HIE_DQC"
                  componentClassID="Microsoft.SSISOracleSrc"
                  contactInfo="Oracle Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;1"
                  description="Oracle Source"
                  name="ME20_HIE_DQC"
                  usesDispositions="true"
                  version="1">
                  <properties>
                    <property
                      dataType="System.String"
                      description="The name of the table to be fetched."
                      expressionType="Notify"
                      name="TableName"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      expressionType="Notify"
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">/* =============================================================================
   ME20_HIE_DQC_DC5.sql  —  HUB Import Export System Malta (EIM 278395) Data Quality Checks
   DC5         : Οι έλεγχοι του DC4 (05_ME20_HIE_DQC_LOAD.sql) με schema DATACUT5 και νέο
                 output. Το DD είναι ίδιο με το DC4 (V1.8· άλλαξε μόνο ένα εισαγωγικό σε
                 μία περιγραφή), άρα δεν χρειάστηκαν νέοι έλεγχοι.
                 Εδώ είναι μόνο οι 59 έλεγχοι με PASS/FAIL. Οι 47 γραμμές πληροφορίας του
                 DC4 (row counts, κατανομές, shadow records, HIE-DT-007, HIE-RI-008) είναι
                 στο ME20_HIE_INFO_DC5.sql.
   -----------------------------------------------------------------------------
   Πηγή πεδίων : 20. 21.430 278395_ME20_HIE_MT_V1.0_DDAMO_V1.8_REDACTED.xlsx
                 (+ ME01 DD v1.24 για HUB_MT_DDACMSP / HUB_MT_SSCUSTP στους ελέγχους HIE-RI)
   Schema      : DATACUT5 (πίνακες HIE_*)
   Output      : DQ_AREA | DQ_CATEGORY | CHECK_ID | CHECK_NAME | TABLE_NAME |
                 TOTAL_RECORDS | FAILED_RECORDS | DQ_STATUS | IS_MASKED |
                 DC_Version | Run_Timestamp
                 - TOTAL_RECORDS = ο πληθυσμός του ελέγχου (π.χ. χωρίς shadow records,
                   ή μόνο όσες εγγραφές έχουν συμπληρωμένο το πεδίο), όχι πάντα όλος ο πίνακας.
                 - FAILED_RECORDS = οι εγγραφές που αποτυγχάνουν.
                 - DQ_STATUS: PASS όταν FAILED_RECORDS = 0, αλλιώς FAIL.
                 - IS_MASKED: Y όταν τουλάχιστον ένα πεδίο του ελέγχου έχει «Masking Approach»
                   = Yes στο DD V1.8 (στα HIE-RI και τα πεδία DFACS / ZGDCS του ME01), αλλιώς N.
                   Σε αυτούς τους ελέγχους το αποτέλεσμα μπορεί να επηρεάζεται από το masking.
                 - DC_Version = 'DC5', Run_Timestamp = SYSDATE (ώρα εκτέλεσης).
                 Οι στήλες κειμένου (εκτός IS_MASKED) είναι NVARCHAR2, ίδιοι τύποι και μήκη με
                 τα ME01 / ME04 / ME12 / ME13 / ME36 DC5.
   ΚΑΝΟΝΕΣ ΠΟΥ ΙΣΧΥΟΥΝ ΣΕ ΟΛΟ ΤΟ SCRIPT
   ------------------------------------
   1. Shadow records: NVL(&lt;xxMDFL&gt;,' ') &lt;&gt; 'S'. Κενό mode flag = «Unchanged record»
      (DD), άρα κανονική εγγραφή, είτε είναι NULL είτε κενό διάστημα.
   2. Invalid Mode Flag: μόνο τιμές που δεν είναι κενές και δεν είναι P / S.
   3. Κενό πεδίο κειμένου = TRIM(x) IS NULL (στην Oracle το '' είναι NULL).
   4. Ημερομηνίες: NUMBER σε μορφή YYYYMMDD (επιβεβαιώθηκε στο DC4 με ORA-01481),
      έγκυρο εύρος 19000101–20991231.
   5. Duplicates: FAILED_RECORDS = οι εγγραφές με κλειδί που υπάρχει πάνω από μία φορά
      (στο DC4 μετριόνταν τα κλειδιά, όχι οι εγγραφές).
   6. HIE-DT-004 / HIE-DT-011 συγκρίνουν με SYSDATE: το αποτέλεσμα εξαρτάται από την
      ημέρα που τρέχει το script.
   7. Αν κάποιος πίνακας ή στήλη δεν υπάρχει στο DATACUT5, το script σταματά με
      ORA-00942 / ORA-00904. Τότε σχολίασε τον έλεγχο (από UNION ALL έως UNION ALL).
   ============================================================================= */
SELECT
    CAST('ME20' AS NVARCHAR2(20))                                AS DQ_AREA,
    CAST(y.dq_category AS NVARCHAR2(50))                         AS DQ_CATEGORY,
    CAST(y.check_id AS NVARCHAR2(30))                            AS CHECK_ID,
    CAST(y.check_name AS NVARCHAR2(500))                         AS CHECK_NAME,
    TO_NCHAR(y.table_name)                                       AS TABLE_NAME,
    y.total_records                                              AS TOTAL_RECORDS,
    y.failed_records                                             AS FAILED_RECORDS,
    TO_NCHAR(CASE WHEN y.failed_records = 0 THEN 'PASS' ELSE 'FAIL' END) AS DQ_STATUS,
    y.is_masked                                                  AS IS_MASKED,
    TO_NCHAR('DC5')                                              AS DC_Version,
    SYSDATE                                                      AS Run_Timestamp
FROM (
    -- ========================================================================
    -- 1. MODE FLAG (HIE-MF-002..017)
    --    Πληθυσμός: όλες οι εγγραφές του πίνακα.
    -- ========================================================================
    SELECT 1 AS sort_no, x.* FROM (
-- HIE-MF-002 | Invalid Mode Flag — IPDCMSP
SELECT 'HIE-MF-002' AS check_id, 'Invalid Values' AS dq_category, 'Invalid Mode Flag: IPDCMSP (IHMDFL)' AS check_name,
       'IPDCMSP - IMP DC master record' AS table_name,
       COUNT(*) AS total_records,
       COUNT(CASE WHEN TRIM(IHMDFL) IS NOT NULL AND TRIM(IHMDFL) NOT IN ('P','S') THEN 1 END) AS failed_records,
       'N' AS is_masked
  FROM DATACUT5.HIE_IPDCMSP
UNION ALL
-- HIE-MF-005 | Invalid Mode Flag — IPACMSP
SELECT 'HIE-MF-005', 'Invalid Values', 'Invalid Mode Flag: IPACMSP (IGMDFL)',
       'IPACMSP - IMP Account Master File',
       COUNT(*), COUNT(CASE WHEN TRIM(IGMDFL) IS NOT NULL AND TRIM(IGMDFL) NOT IN ('P','S') THEN 1 END), 'N'
  FROM DATACUT5.HIE_IPACMSP
UNION ALL
-- HIE-MF-007 | Invalid Mode Flag — IPLNMSP
SELECT 'HIE-MF-007', 'Invalid Values', 'Invalid Mode Flag: IPLNMSP (ILMDFL)',
       'IPLNMSP - Imp/Exp Loan Master File',
       COUNT(*), COUNT(CASE WHEN TRIM(ILMDFL) IS NOT NULL AND TRIM(ILMDFL) NOT IN ('P','S') THEN 1 END), 'N'
  FROM DATACUT5.HIE_IPLNMSP
UNION ALL
-- HIE-MF-009 | Invalid Mode Flag — IPBLMSP
SELECT 'HIE-MF-009', 'Invalid Values', 'Invalid Mode Flag: IPBLMSP (IIMDFL)',
       'IPBLMSP - IMP Bill Master File',
       COUNT(*), COUNT(CASE WHEN TRIM(IIMDFL) IS NOT NULL AND TRIM(IIMDFL) NOT IN ('P','S') THEN 1 END), 'N'
  FROM DATACUT5.HIE_IPBLMSP
UNION ALL
-- HIE-MF-011 | Invalid Mode Flag — EPACMSP
SELECT 'HIE-MF-011', 'Invalid Values', 'Invalid Mode Flag: EPACMSP (BAMDFL)',
       'EPACMSP - EXP Account Master File',
       COUNT(*), COUNT(CASE WHEN TRIM(BAMDFL) IS NOT NULL AND TRIM(BAMDFL) NOT IN ('P','S') THEN 1 END), 'N'
  FROM DATACUT5.HIE_EPACMSP
UNION ALL
-- HIE-MF-013 | Invalid Mode Flag — EPDCMSP
SELECT 'HIE-MF-013', 'Invalid Values', 'Invalid Mode Flag: EPDCMSP (BCMDFL)',
       'EPDCMSP - EXP DC Master File',
       COUNT(*), COUNT(CASE WHEN TRIM(BCMDFL) IS NOT NULL AND TRIM(BCMDFL) NOT IN ('P','S') THEN 1 END), 'N'
  FROM DATACUT5.HIE_EPDCMSP
UNION ALL
-- HIE-MF-015 | Invalid Mode Flag — EPBLMSP
SELECT 'HIE-MF-015', 'Invalid Values', 'Invalid Mode Flag: EPBLMSP (BBMDFL)',
       'EPBLMSP - EXP Bill Master File',
       COUNT(*), COUNT(CASE WHEN TRIM(BBMDFL) IS NOT NULL AND TRIM(BBMDFL) NOT IN ('P','S') THEN 1 END), 'N'
  FROM DATACUT5.HIE_EPBLMSP
UNION ALL
-- HIE-MF-017 | Invalid Mode Flag — BAOMGHP
SELECT 'HIE-MF-017', 'Invalid Values', 'Invalid Mode Flag: BAOMGHP (BMMDFL)',
       'BAOMGHP - O/W Message Control History',
       COUNT(*), COUNT(CASE WHEN TRIM(BMMDFL) IS NOT NULL AND TRIM(BMMDFL) NOT IN ('P','S') THEN 1 END), 'N'
  FROM DATACUT5.HIE_BAOMGHP
    ) x
    UNION ALL
    -- ========================================================================
    -- 2. MANDATORY FIELDS — NULL / BLANK (HIE-NL-001..015)
    --    Πληθυσμός: όλες οι εγγραφές εκτός shadow.
    -- ========================================================================
    SELECT 2 AS sort_no, x.* FROM (
-- HIE-NL-001 | Missing DC Product Type (IHDCPT)
SELECT 'HIE-NL-001' AS check_id, 'Missing Data' AS dq_category, 'Missing DC Product Type: IPDCMSP (IHDCPT)' AS check_name,
       'IPDCMSP - IMP DC master record' AS table_name,
       COUNT(*) AS total_records, COUNT(CASE WHEN TRIM(IHDCPT) IS NULL THEN 1 END) AS failed_records, 'N' AS is_masked
  FROM DATACUT5.HIE_IPDCMSP WHERE NVL(IHMDFL,' ') &lt;&gt; 'S'
UNION ALL
-- HIE-NL-002 | Missing Expiry Date (IHEXDE)
SELECT 'HIE-NL-002', 'Missing Data', 'Missing Expiry Date: IPDCMSP (IHEXDE)',
       'IPDCMSP - IMP DC master record',
       COUNT(*), COUNT(CASE WHEN IHEXDE IS NULL THEN 1 END), 'N'
  FROM DATACUT5.HIE_IPDCMSP WHERE NVL(IHMDFL,' ') &lt;&gt; 'S'
UNION ALL
-- HIE-NL-003 | Missing Product Currency (IHPRCY) [masked]
SELECT 'HIE-NL-003', 'Missing Data', 'Missing Product Currency: IPDCMSP (IHPRCY)',
       'IPDCMSP - IMP DC master record',
       COUNT(*), COUNT(CASE WHEN TRIM(IHPRCY) IS NULL THEN 1 END), 'Y'
  FROM DATACUT5.HIE_IPDCMSP WHERE NVL(IHMDFL,' ') &lt;&gt; 'S'
UNION ALL
-- HIE-NL-004 | Missing A/C Short Name (IGACSN) [masked]
SELECT 'HIE-NL-004', 'Missing Data', 'Missing A/C Short Name: IPACMSP (IGACSN)',
       'IPACMSP - IMP Account Master File',
       COUNT(*), COUNT(CASE WHEN TRIM(IGACSN) IS NULL THEN 1 END), 'Y'
  FROM DATACUT5.HIE_IPACMSP WHERE NVL(IGMDFL,' ') &lt;&gt; 'S'
UNION ALL
-- HIE-NL-005 | Missing A/C Status (IGSTUS)
SELECT 'HIE-NL-005', 'Missing Data', 'Missing A/C Status: IPACMSP (IGSTUS)',
       'IPACMSP - IMP Account Master File',
       COUNT(*), COUNT(CASE WHEN TRIM(IGSTUS) IS NULL THEN 1 END), 'N'
  FROM DATACUT5.HIE_IPACMSP WHERE NVL(IGMDFL,' ') &lt;&gt; 'S'
UNION ALL
-- HIE-NL-006 | Missing Product Currency (ILPRCY) [masked]
SELECT 'HIE-NL-006', 'Missing Data', 'Missing Product Currency: IPLNMSP (ILPRCY)',
       'IPLNMSP - Imp/Exp Loan Master File',
       COUNT(*), COUNT(CASE WHEN TRIM(ILPRCY) IS NULL THEN 1 END), 'Y'
  FROM DATACUT5.HIE_IPLNMSP WHERE NVL(ILMDFL,' ') &lt;&gt; 'S'
UNION ALL
-- HIE-NL-007 | Missing / Zero Loan Amount (ILLNAA) [masked]
SELECT 'HIE-NL-007', 'Missing Data', 'Missing/Zero Loan Amount: IPLNMSP (ILLNAA)',
       'IPLNMSP - Imp/Exp Loan Master File',
       COUNT(*), COUNT(CASE WHEN ILLNAA IS NULL OR ILLNAA = 0 THEN 1 END), 'Y'
  FROM DATACUT5.HIE_IPLNMSP WHERE NVL(ILMDFL,' ') &lt;&gt; 'S'
UNION ALL
-- HIE-NL-008 | Missing Bill Number (IIBLNO) [masked]
SELECT 'HIE-NL-008', 'Missing Data', 'Missing Bill Number: IPBLMSP (IIBLNO)',
       'IPBLMSP - IMP Bill Master File',
       COUNT(*), COUNT(CASE WHEN TRIM(IIBLNO) IS NULL THEN 1 END), 'Y'
  FROM DATACUT5.HIE_IPBLMSP WHERE NVL(IIMDFL,' ') &lt;&gt; 'S'
UNION ALL
-- HIE-NL-009 | Missing Product Currency (IIPRCY) [masked]
SELECT 'HIE-NL-009', 'Missing Data', 'Missing Product Currency: IPBLMSP (IIPRCY)',
       'IPBLMSP - IMP Bill Master File',
       COUNT(*), COUNT(CASE WHEN TRIM(IIPRCY) IS NULL THEN 1 END), 'Y'
  FROM DATACUT5.HIE_IPBLMSP WHERE NVL(IIMDFL,' ') &lt;&gt; 'S'
UNION ALL
-- HIE-NL-010 | Missing Exports DC Number (BCDCNR) [masked]
SELECT 'HIE-NL-010', 'Missing Data', 'Missing Exports DC Number: EPDCMSP (BCDCNR)',
       'EPDCMSP - EXP DC Master File',
       COUNT(*), COUNT(CASE WHEN TRIM(BCDCNR) IS NULL THEN 1 END), 'Y'
  FROM DATACUT5.HIE_EPDCMSP WHERE NVL(BCMDFL,' ') &lt;&gt; 'S'
UNION ALL
-- HIE-NL-011 | Missing Product Currency (BCPRCY) [masked]
SELECT 'HIE-NL-011', 'Missing Data', 'Missing Product Currency: EPDCMSP (BCPRCY)',
       'EPDCMSP - EXP DC Master File',
       COUNT(*), COUNT(CASE WHEN TRIM(BCPRCY) IS NULL THEN 1 END), 'Y'
  FROM DATACUT5.HIE_EPDCMSP WHERE NVL(BCMDFL,' ') &lt;&gt; 'S'
UNION ALL
-- HIE-NL-012 | Missing A/C Short Name (BAACSN) [masked]
SELECT 'HIE-NL-012', 'Missing Data', 'Missing A/C Short Name: EPACMSP (BAACSN)',
       'EPACMSP - EXP Account Master File',
       COUNT(*), COUNT(CASE WHEN TRIM(BAACSN) IS NULL THEN 1 END), 'Y'
  FROM DATACUT5.HIE_EPACMSP WHERE NVL(BAMDFL,' ') &lt;&gt; 'S'
UNION ALL
-- HIE-NL-013 | Missing Bill Number (BBBLNO)
SELECT 'HIE-NL-013', 'Missing Data', 'Missing Bill Number: EPBLMSP (BBBLNO)',
       'EPBLMSP - EXP Bill Master File',
       COUNT(*), COUNT(CASE WHEN TRIM(BBBLNO) IS NULL THEN 1 END), 'N'
  FROM DATACUT5.HIE_EPBLMSP WHERE NVL(BBMDFL,' ') &lt;&gt; 'S'
UNION ALL
-- HIE-NL-014 | Missing / Zero Remittance Amount (BMRAMT) [masked]
SELECT 'HIE-NL-014', 'Missing Data', 'Missing/Zero Remittance Amount: BAOMGHP (BMRAMT)',
       'BAOMGHP - O/W Message Control History',
       COUNT(*), COUNT(CASE WHEN BMRAMT IS NULL OR BMRAMT = 0 THEN 1 END), 'Y'
  FROM DATACUT5.HIE_BAOMGHP WHERE NVL(BMMDFL,' ') &lt;&gt; 'S'
UNION ALL
-- HIE-NL-015 | Missing Remittance Currency (BMRCCY) [masked]
SELECT 'HIE-NL-015', 'Missing Data', 'Missing Remittance Currency: BAOMGHP (BMRCCY)',
       'BAOMGHP - O/W Message Control History',
       COUNT(*), COUNT(CASE WHEN TRIM(BMRCCY) IS NULL THEN 1 END), 'Y'
  FROM DATACUT5.HIE_BAOMGHP WHERE NVL(BMMDFL,' ') &lt;&gt; 'S'
    ) x
    UNION ALL
    -- ========================================================================
    -- 3. DATE FIELDS (HIE-DT-001..012, χωρίς το HIE-DT-007 που είναι στο INFO)
    --    Ημερομηνίες = NUMBER YYYYMMDD (βλ. κανόνα 4).
    -- ========================================================================
    SELECT 3 AS sort_no, x.* FROM (
-- HIE-DT-001 | Invalid / Zero DC Expiry Date (IHEXDE)
SELECT 'HIE-DT-001' AS check_id, 'Invalid Dates' AS dq_category, 'Invalid/Zero DC Expiry Date: IPDCMSP (IHEXDE)' AS check_name,
       'IPDCMSP - IMP DC master record' AS table_name,
       COUNT(*) AS total_records,
       COUNT(CASE WHEN IHEXDE IS NULL OR IHEXDE NOT BETWEEN 19000101 AND 20991231 THEN 1 END) AS failed_records,
       'N' AS is_masked
  FROM DATACUT5.HIE_IPDCMSP WHERE NVL(IHMDFL,' ') &lt;&gt; 'S'
UNION ALL
-- HIE-DT-002 | IMP DC Expiry Date Before Issue Date (πληθυσμός: και οι δύο ημερομηνίες συμπληρωμένες)
SELECT 'HIE-DT-002', 'Inconsistent Data', 'IMP DC Expiry Date Before Issue Date: IPDCMSP (IHEXDE &lt; IHDISS)',
       'IPDCMSP - IMP DC master record',
       COUNT(*), COUNT(CASE WHEN IHEXDE &lt; IHDISS THEN 1 END), 'N'
  FROM DATACUT5.HIE_IPDCMSP
 WHERE NVL(IHMDFL,' ') &lt;&gt; 'S' AND IHEXDE IS NOT NULL AND IHDISS IS NOT NULL
UNION ALL
-- HIE-DT-003 | Invalid / Zero Loan Due Date (ILDUDT)
SELECT 'HIE-DT-003', 'Invalid Dates', 'Invalid/Zero Loan Due Date: IPLNMSP (ILDUDT)',
       'IPLNMSP - Imp/Exp Loan Master File',
       COUNT(*), COUNT(CASE WHEN ILDUDT IS NULL OR TO_CHAR(ILDUDT) = '0' THEN 1 END), 'N'
  FROM DATACUT5.HIE_IPLNMSP WHERE NVL(ILMDFL,' ') &lt;&gt; 'S'
UNION ALL
-- HIE-DT-004 | Past Due Active Loan (πληθυσμός: ενεργά δάνεια με due date)
SELECT 'HIE-DT-004', 'Inconsistent Data', 'Past Due Active Loan (ILDUDT in Past): IPLNMSP',
       'IPLNMSP - Imp/Exp Loan Master File',
       COUNT(*), COUNT(CASE WHEN ILDUDT &lt; TO_NUMBER(TO_CHAR(SYSDATE,'YYYYMMDD')) THEN 1 END), 'N'
  FROM DATACUT5.HIE_IPLNMSP
 WHERE NVL(ILMDFL,' ') &lt;&gt; 'S' AND NVL(ILSTAT,'X') NOT IN ('D','F') AND ILDUDT IS NOT NULL
UNION ALL
-- HIE-DT-005 | Invalid / Zero Bill Due Date (IIDUDT)
SELECT 'HIE-DT-005', 'Invalid Dates', 'Invalid/Zero Bill Due Date: IPBLMSP (IIDUDT)',
       'IPBLMSP - IMP Bill Master File',
       COUNT(*), COUNT(CASE WHEN IIDUDT IS NULL OR TO_CHAR(IIDUDT) = '0' THEN 1 END), 'N'
  FROM DATACUT5.HIE_IPBLMSP WHERE NVL(IIMDFL,' ') &lt;&gt; 'S'
UNION ALL
-- HIE-DT-006 | Invalid IMP A/C Date Opened (IGDTAO)
SELECT 'HIE-DT-006', 'Invalid Dates', 'Invalid IMP A/C Date Opened: IPACMSP (IGDTAO)',
       'IPACMSP - IMP Account Master File',
       COUNT(*), COUNT(CASE WHEN IGDTAO IS NULL OR IGDTAO NOT BETWEEN 19000101 AND 20991231 THEN 1 END), 'N'
  FROM DATACUT5.HIE_IPACMSP WHERE NVL(IGMDFL,' ') &lt;&gt; 'S'
UNION ALL
-- HIE-DT-008 | Invalid / Zero EXP Bill Due Date (BBDUDT)
SELECT 'HIE-DT-008', 'Invalid Dates', 'Invalid/Zero EXP Bill Due Date: EPBLMSP (BBDUDT)',
       'EPBLMSP - EXP Bill Master File',
       COUNT(*), COUNT(CASE WHEN BBDUDT IS NULL OR TO_CHAR(BBDUDT) = '0' THEN 1 END), 'N'
  FROM DATACUT5.HIE_EPBLMSP WHERE NVL(BBMDFL,' ') &lt;&gt; 'S'
UNION ALL
-- HIE-DT-009 | Missing Transmission Date (BMXMDT)
SELECT 'HIE-DT-009', 'Missing Data', 'Missing Transmission Date: BAOMGHP (BMXMDT)',
       'BAOMGHP - O/W Message Control History',
       COUNT(*), COUNT(CASE WHEN BMXMDT IS NULL THEN 1 END), 'N'
  FROM DATACUT5.HIE_BAOMGHP WHERE NVL(BMMDFL,' ') &lt;&gt; 'S'
UNION ALL
-- HIE-DT-010 | Missing Value Date (BMVLDT)
SELECT 'HIE-DT-010', 'Missing Data', 'Missing Value Date: BAOMGHP (BMVLDT)',
       'BAOMGHP - O/W Message Control History',
       COUNT(*), COUNT(CASE WHEN BMVLDT IS NULL THEN 1 END), 'N'
  FROM DATACUT5.HIE_BAOMGHP WHERE NVL(BMMDFL,' ') &lt;&gt; 'S'
UNION ALL
-- HIE-DT-011 | Next Instalment Date in Past (πληθυσμός: δάνεια με ILNISD)
SELECT 'HIE-DT-011', 'Inconsistent Data', 'Next Instalment Date in Past: IPLNMSP (ILNISD)',
       'IPLNMSP - Imp/Exp Loan Master File',
       COUNT(*), COUNT(CASE WHEN ILNISD &lt; TO_NUMBER(TO_CHAR(SYSDATE,'YYYYMMDD')) THEN 1 END), 'N'
  FROM DATACUT5.HIE_IPLNMSP
 WHERE NVL(ILMDFL,' ') &lt;&gt; 'S' AND ILNISD IS NOT NULL
UNION ALL
-- HIE-DT-012 | Missing EXP A/C Date Opened (BADTAO)
SELECT 'HIE-DT-012', 'Missing Data', 'Invalid EXP A/C Date Opened: EPACMSP (BADTAO)',
       'EPACMSP - EXP Account Master File',
       COUNT(*), COUNT(CASE WHEN BADTAO IS NULL THEN 1 END), 'N'
  FROM DATACUT5.HIE_EPACMSP WHERE NVL(BAMDFL,' ') &lt;&gt; 'S'
    ) x
    UNION ALL
    -- ========================================================================
    -- 4. NUMERIC INTEGRITY (HIE-NI-001..010, χωρίς το HIE-NI-009 που είναι στο INFO)
    --    Ποσά σε minor units (cents).
    -- ========================================================================
    SELECT 4 AS sort_no, x.* FROM (
-- HIE-NI-001 | Negative DC Amount Outstanding (IHDCAO)
SELECT 'HIE-NI-001' AS check_id, 'Invalid Values' AS dq_category, 'Negative DC Amount Outstanding: IPDCMSP (IHDCAO)' AS check_name,
       'IPDCMSP - IMP DC master record' AS table_name,
       COUNT(*) AS total_records, COUNT(CASE WHEN IHDCAO &lt; 0 THEN 1 END) AS failed_records, 'N' AS is_masked
  FROM DATACUT5.HIE_IPDCMSP WHERE NVL(IHMDFL,' ') &lt;&gt; 'S'
UNION ALL
-- HIE-NI-002 | Negative LCY Ledger Balance (IHLLBL)
SELECT 'HIE-NI-002', 'Invalid Values', 'Negative LCY Ledger Balance: IPDCMSP (IHLLBL)',
       'IPDCMSP - IMP DC master record',
       COUNT(*), COUNT(CASE WHEN IHLLBL &lt; 0 THEN 1 END), 'N'
  FROM DATACUT5.HIE_IPDCMSP WHERE NVL(IHMDFL,' ') &lt;&gt; 'S'
UNION ALL
-- HIE-NI-003 | DC Amount Utilised &gt; DC Amount Applied (πληθυσμός: IHDCAA &gt; 0) [masked]
SELECT 'HIE-NI-003', 'Inconsistent Data', 'DC Amount Utilised Exceeds DC Amount Applied: IPDCMSP (IHDCAU &gt; IHDCAA)',
       'IPDCMSP - IMP DC master record',
       COUNT(*), COUNT(CASE WHEN IHDCAU &gt; IHDCAA THEN 1 END), 'Y'
  FROM DATACUT5.HIE_IPDCMSP WHERE NVL(IHMDFL,' ') &lt;&gt; 'S' AND IHDCAA &gt; 0
UNION ALL
-- HIE-NI-004 | Negative Bill Amount Outstanding (IIBLAO)
SELECT 'HIE-NI-004', 'Invalid Values', 'Negative Bill Amount Outstanding: IPBLMSP (IIBLAO)',
       'IPBLMSP - IMP Bill Master File',
       COUNT(*), COUNT(CASE WHEN IIBLAO &lt; 0 THEN 1 END), 'N'
  FROM DATACUT5.HIE_IPBLMSP WHERE NVL(IIMDFL,' ') &lt;&gt; 'S'
UNION ALL
-- HIE-NI-005 | IMP Bill O/S &gt; Bill Amount Applied (πληθυσμός: IIBLAA &gt; 0) [masked]
SELECT 'HIE-NI-005', 'Inconsistent Data', 'IMP Bill O/S Exceeds Bill Amount Applied: IPBLMSP (IIBLAO &gt; IIBLAA)',
       'IPBLMSP - IMP Bill Master File',
       COUNT(*), COUNT(CASE WHEN IIBLAO &gt; IIBLAA THEN 1 END), 'Y'
  FROM DATACUT5.HIE_IPBLMSP WHERE NVL(IIMDFL,' ') &lt;&gt; 'S' AND IIBLAA &gt; 0
UNION ALL
-- HIE-NI-006 | Negative Loan Amount Outstanding (ILLNAO)
-- ANALYSIS: HIE equivalent of OI-001. Flag as potential STOPPER if &gt;50%.
SELECT 'HIE-NI-006', 'Invalid Values', 'Negative Loan Amount Outstanding: IPLNMSP (ILLNAO)',
       'IPLNMSP - Imp/Exp Loan Master File',
       COUNT(*), COUNT(CASE WHEN ILLNAO &lt; 0 THEN 1 END), 'N'
  FROM DATACUT5.HIE_IPLNMSP WHERE NVL(ILMDFL,' ') &lt;&gt; 'S'
UNION ALL
-- HIE-NI-007 | Negative EXP DC Amount Outstanding (BCDCAO)
SELECT 'HIE-NI-007', 'Invalid Values', 'Negative EXP DC Amount Outstanding: EPDCMSP (BCDCAO)',
       'EPDCMSP - EXP DC Master File',
       COUNT(*), COUNT(CASE WHEN BCDCAO &lt; 0 THEN 1 END), 'N'
  FROM DATACUT5.HIE_EPDCMSP WHERE NVL(BCMDFL,' ') &lt;&gt; 'S'
UNION ALL
-- HIE-NI-008 | Negative EXP Bill Amount Outstanding (BBBLAO)
SELECT 'HIE-NI-008', 'Invalid Values', 'Negative EXP Bill Amount Outstanding: EPBLMSP (BBBLAO)',
       'EPBLMSP - EXP Bill Master File',
       COUNT(*), COUNT(CASE WHEN BBBLAO &lt; 0 THEN 1 END), 'N'
  FROM DATACUT5.HIE_EPBLMSP WHERE NVL(BBMDFL,' ') &lt;&gt; 'S'
UNION ALL
-- HIE-NI-010 | Remittance Amount Zero or Negative (BMRAMT) [masked]
SELECT 'HIE-NI-010', 'Invalid Values', 'OMNI Gateway Remittance Amount Zero or Negative: BAOMGHP (BMRAMT)',
       'BAOMGHP - O/W Message Control History',
       COUNT(*), COUNT(CASE WHEN BMRAMT IS NULL OR BMRAMT &lt;= 0 THEN 1 END), 'Y'
  FROM DATACUT5.HIE_BAOMGHP WHERE NVL(BMMDFL,' ') &lt;&gt; 'S'
    ) x
    UNION ALL
    -- ========================================================================
    -- 5. DC / LOAN / BILL DOMAIN CHECKS (HIE-DM-011..013)
    --    Οι κατανομές HIE-DM-001..010 / 014..016 είναι στο INFO.
    -- ========================================================================
    SELECT 5 AS sort_no, x.* FROM (
-- HIE-DM-011 | IMP DC Zero Outstanding but Active Status
SELECT 'HIE-DM-011' AS check_id, 'Inconsistent Data' AS dq_category,
       'IMP DC Zero Outstanding but Active Status: IPDCMSP (IHDCAO = 0, IHSTAT not D/F/C)' AS check_name,
       'IPDCMSP - IMP DC master record' AS table_name,
       COUNT(*) AS total_records,
       COUNT(CASE WHEN IHDCAO = 0 AND NVL(IHSTAT,'X') NOT IN ('D','F','C') THEN 1 END) AS failed_records,
       'N' AS is_masked
  FROM DATACUT5.HIE_IPDCMSP WHERE NVL(IHMDFL,' ') &lt;&gt; 'S'
UNION ALL
-- HIE-DM-012 | EXP DC Zero Outstanding but Active Status
SELECT 'HIE-DM-012', 'Inconsistent Data', 'EXP DC Zero Outstanding but Active Status: EPDCMSP (BCDCAO = 0, BCSTAT not D/F/C)',
       'EPDCMSP - EXP DC Master File',
       COUNT(*), COUNT(CASE WHEN BCDCAO = 0 AND NVL(BCSTAT,'X') NOT IN ('D','F','C') THEN 1 END), 'N'
  FROM DATACUT5.HIE_EPDCMSP WHERE NVL(BCMDFL,' ') &lt;&gt; 'S'
UNION ALL
-- HIE-DM-013 | IMP Loan Zero Outstanding but Active
SELECT 'HIE-DM-013', 'Inconsistent Data', 'IMP Loan Zero Outstanding but Active: IPLNMSP (ILLNAO = 0, ILSTAT not D/F)',
       'IPLNMSP - Imp/Exp Loan Master File',
       COUNT(*), COUNT(CASE WHEN ILLNAO = 0 AND NVL(ILSTAT,'X') NOT IN ('D','F') THEN 1 END), 'N'
  FROM DATACUT5.HIE_IPLNMSP WHERE NVL(ILMDFL,' ') &lt;&gt; 'S'
    ) x
    UNION ALL
    -- ========================================================================
    -- 6. REFERENTIAL INTEGRITY — HIE → HUB (HIE-RI-001..007)
    --    Πληθυσμός: εγγραφές εκτός shadow με συμπληρωμένο κλειδί.
    --    Masked: τα serial numbers (xxACS / xxDCS, DFACS, ZGDCS).
    -- ========================================================================
    SELECT 6 AS sort_no, x.* FROM (
-- HIE-RI-001 | IMP DC Account Not in HUB DD Account Master
SELECT 'HIE-RI-001' AS check_id, 'Missing Links' AS dq_category, 'IMP DC Account Not in HUB DD Account Master (DDACMSP)' AS check_name,
       'IPDCMSP - IMP DC master record' AS table_name,
       COUNT(*) AS total_records, COUNT(CASE WHEN r.miss = 1 THEN 1 END) AS failed_records, 'Y' AS is_masked
  FROM (SELECT CASE WHEN EXISTS (SELECT 1 FROM DATACUT5.HUB_MT_DDACMSP D
                                  WHERE D.DFACB = H.IHACB AND D.DFACS = H.IHACS AND D.DFACX = H.IHACX)
                    THEN 0 ELSE 1 END AS miss
          FROM DATACUT5.HIE_IPDCMSP H
         WHERE NVL(H.IHMDFL,' ') &lt;&gt; 'S' AND H.IHACB IS NOT NULL) r
UNION ALL
-- HIE-RI-002 | IMP Loan Account Not in HUB DD Account Master
SELECT 'HIE-RI-002', 'Missing Links', 'IMP Loan Account Not in HUB DD Account Master (DDACMSP)',
       'IPLNMSP - Imp/Exp Loan Master File',
       COUNT(*), COUNT(CASE WHEN r.miss = 1 THEN 1 END), 'Y'
  FROM (SELECT CASE WHEN EXISTS (SELECT 1 FROM DATACUT5.HUB_MT_DDACMSP D
                                  WHERE D.DFACB = L.ILACB AND D.DFACS = L.ILACS AND D.DFACX = L.ILACX)
                    THEN 0 ELSE 1 END AS miss
          FROM DATACUT5.HIE_IPLNMSP L
         WHERE NVL(L.ILMDFL,' ') &lt;&gt; 'S' AND L.ILACB IS NOT NULL) r
UNION ALL
-- HIE-RI-003 | IMP Bill Account Not in HUB DD Account Master
SELECT 'HIE-RI-003', 'Missing Links', 'IMP Bill Account Not in HUB DD Account Master (DDACMSP)',
       'IPBLMSP - IMP Bill Master File',
       COUNT(*), COUNT(CASE WHEN r.miss = 1 THEN 1 END), 'Y'
  FROM (SELECT CASE WHEN EXISTS (SELECT 1 FROM DATACUT5.HUB_MT_DDACMSP D
                                  WHERE D.DFACB = B.IIACB AND D.DFACS = B.IIACS AND D.DFACX = B.IIACX)
                    THEN 0 ELSE 1 END AS miss
          FROM DATACUT5.HIE_IPBLMSP B
         WHERE NVL(B.IIMDFL,' ') &lt;&gt; 'S' AND B.IIACB IS NOT NULL) r
UNION ALL
-- HIE-RI-004 | EXP DC Account Not in HUB DD Account Master
SELECT 'HIE-RI-004', 'Missing Links', 'EXP DC Account Not in HUB DD Account Master (DDACMSP)',
       'EPDCMSP - EXP DC Master File',
       COUNT(*), COUNT(CASE WHEN r.miss = 1 THEN 1 END), 'Y'
  FROM (SELECT CASE WHEN EXISTS (SELECT 1 FROM DATACUT5.HUB_MT_DDACMSP D
                                  WHERE D.DFACB = E.BCACB AND D.DFACS = E.BCACS AND D.DFACX = E.BCACX)
                    THEN 0 ELSE 1 END AS miss
          FROM DATACUT5.HIE_EPDCMSP E
         WHERE NVL(E.BCMDFL,' ') &lt;&gt; 'S' AND E.BCACB IS NOT NULL) r
UNION ALL
-- HIE-RI-005 | EXP Bill Account Not in HUB DD Account Master
SELECT 'HIE-RI-005', 'Missing Links', 'EXP Bill Account Not in HUB DD Account Master (DDACMSP)',
       'EPBLMSP - EXP Bill Master File',
       COUNT(*), COUNT(CASE WHEN r.miss = 1 THEN 1 END), 'Y'
  FROM (SELECT CASE WHEN EXISTS (SELECT 1 FROM DATACUT5.HUB_MT_DDACMSP D
                                  WHERE D.DFACB = B.BBACB AND D.DFACS = B.BBACS AND D.DFACX = B.BBACX)
                    THEN 0 ELSE 1 END AS miss
          FROM DATACUT5.HIE_EPBLMSP B
         WHERE NVL(B.BBMDFL,' ') &lt;&gt; 'S' AND B.BBACB IS NOT NULL) r
UNION ALL
-- HIE-RI-006 | IMP A/C Customer Not in HUB Customer Master
SELECT 'HIE-RI-006', 'Missing Links', 'IMP A/C Customer Not in HUB Customer Master (SSCUSTP)',
       'IPACMSP - IMP Account Master File',
       COUNT(*), COUNT(CASE WHEN r.miss = 1 THEN 1 END), 'Y'
  FROM (SELECT CASE WHEN EXISTS (SELECT 1 FROM DATACUT5.HUB_MT_SSCUSTP C
                                  WHERE C.ZGDCB = A.IGDCB AND C.ZGDCS = A.IGDCS)
                    THEN 0 ELSE 1 END AS miss
          FROM DATACUT5.HIE_IPACMSP A
         WHERE NVL(A.IGMDFL,' ') &lt;&gt; 'S' AND A.IGDCB IS NOT NULL) r
UNION ALL
-- HIE-RI-007 | EXP A/C Customer Not in HUB Customer Master
SELECT 'HIE-RI-007', 'Missing Links', 'EXP A/C Customer Not in HUB Customer Master (SSCUSTP)',
       'EPACMSP - EXP Account Master File',
       COUNT(*), COUNT(CASE WHEN r.miss = 1 THEN 1 END), 'Y'
  FROM (SELECT CASE WHEN EXISTS (SELECT 1 FROM DATACUT5.HUB_MT_SSCUSTP C
                                  WHERE C.ZGDCB = A.BADCB AND C.ZGDCS = A.BADCS)
                    THEN 0 ELSE 1 END AS miss
          FROM DATACUT5.HIE_EPACMSP A
         WHERE NVL(A.BAMDFL,' ') &lt;&gt; 'S' AND A.BADCB IS NOT NULL) r
    ) x
    UNION ALL
    -- ========================================================================
    -- 7. DUPLICATES (HIE-DU-001..006)
    --    FAILED_RECORDS = εγγραφές με κλειδί που υπάρχει &gt; 1 φορά (κανόνας 5).
    -- ========================================================================
    SELECT 7 AS sort_no, x.* FROM (
-- HIE-DU-001 | Duplicate IMP DC Records (IHDCPT + IHBRAB + IHDCNO) [masked: IHDCNO]
SELECT 'HIE-DU-001' AS check_id, 'Duplicates' AS dq_category, 'Duplicate IMP DC Records: IPDCMSP (IHDCPT+IHBRAB+IHDCNO)' AS check_name,
       'IPDCMSP - IMP DC master record' AS table_name,
       COUNT(*) AS total_records, COUNT(CASE WHEN d.dup_n &gt; 1 THEN 1 END) AS failed_records, 'Y' AS is_masked
  FROM (SELECT COUNT(*) OVER (PARTITION BY IHDCPT, IHBRAB, IHDCNO) AS dup_n
          FROM DATACUT5.HIE_IPDCMSP WHERE NVL(IHMDFL,' ') &lt;&gt; 'S') d
UNION ALL
-- HIE-DU-002 | Duplicate IMP A/C Records (IGACB + IGACS + IGACX) [masked: IGACS]
SELECT 'HIE-DU-002', 'Duplicates', 'Duplicate IMP A/C Records: IPACMSP (IGACB+IGACS+IGACX)',
       'IPACMSP - IMP Account Master File',
       COUNT(*), COUNT(CASE WHEN d.dup_n &gt; 1 THEN 1 END), 'Y'
  FROM (SELECT COUNT(*) OVER (PARTITION BY IGACB, IGACS, IGACX) AS dup_n
          FROM DATACUT5.HIE_IPACMSP WHERE NVL(IGMDFL,' ') &lt;&gt; 'S') d
UNION ALL
-- HIE-DU-003 | Duplicate IMP Loan Records (ILACB + ILACS + ILACX + ILAPTY) [masked: ILACS]
SELECT 'HIE-DU-003', 'Duplicates', 'Duplicate IMP Loan Records: IPLNMSP (ILACB+ILACS+ILACX+ILAPTY)',
       'IPLNMSP - Imp/Exp Loan Master File',
       COUNT(*), COUNT(CASE WHEN d.dup_n &gt; 1 THEN 1 END), 'Y'
  FROM (SELECT COUNT(*) OVER (PARTITION BY ILACB, ILACS, ILACX, ILAPTY) AS dup_n
          FROM DATACUT5.HIE_IPLNMSP WHERE NVL(ILMDFL,' ') &lt;&gt; 'S') d
UNION ALL
-- HIE-DU-004 | Duplicate IMP Bill Records (IIACB + IIACS + IIACX + IIBLNO) [masked: IIACS, IIBLNO]
SELECT 'HIE-DU-004', 'Duplicates', 'Duplicate IMP Bill Records: IPBLMSP (IIACB+IIACS+IIACX+IIBLNO)',
       'IPBLMSP - IMP Bill Master File',
       COUNT(*), COUNT(CASE WHEN d.dup_n &gt; 1 THEN 1 END), 'Y'
  FROM (SELECT COUNT(*) OVER (PARTITION BY IIACB, IIACS, IIACX, IIBLNO) AS dup_n
          FROM DATACUT5.HIE_IPBLMSP WHERE NVL(IIMDFL,' ') &lt;&gt; 'S') d
UNION ALL
-- HIE-DU-005 | Duplicate EXP DC Records (BCDCNR + BCDCSR) [masked: BCDCNR]
SELECT 'HIE-DU-005', 'Duplicates', 'Duplicate EXP DC Records: EPDCMSP (BCDCNR+BCDCSR)',
       'EPDCMSP - EXP DC Master File',
       COUNT(*), COUNT(CASE WHEN d.dup_n &gt; 1 THEN 1 END), 'Y'
  FROM (SELECT COUNT(*) OVER (PARTITION BY BCDCNR, BCDCSR) AS dup_n
          FROM DATACUT5.HIE_EPDCMSP WHERE NVL(BCMDFL,' ') &lt;&gt; 'S') d
UNION ALL
-- HIE-DU-006 | Duplicate EXP A/C Records (BAACB + BAACS + BAACX) [masked: BAACS]
SELECT 'HIE-DU-006', 'Duplicates', 'Duplicate EXP A/C Records: EPACMSP (BAACB+BAACS+BAACX)',
       'EPACMSP - EXP Account Master File',
       COUNT(*), COUNT(CASE WHEN d.dup_n &gt; 1 THEN 1 END), 'Y'
  FROM (SELECT COUNT(*) OVER (PARTITION BY BAACB, BAACS, BAACX) AS dup_n
          FROM DATACUT5.HIE_EPACMSP WHERE NVL(BAMDFL,' ') &lt;&gt; 'S') d
    ) x
) y
ORDER BY y.sort_no, y.check_id;</property>
