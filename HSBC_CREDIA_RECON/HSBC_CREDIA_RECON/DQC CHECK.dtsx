        (t70, f70) AS 'MMSWBTP-070|Missing Data|Missing Accrued Assignment Fee to NPD (EPAFEN) [TR-ND-170]',
        (t71, f71) AS 'MMSWBTP-071|Missing Data|Missing Termination Fee (EPTRMF) [TR-ND-171]',
        (t72, f72) AS 'MMSWBTP-072|Missing Data|Missing Accrued Termination Fee to LPD (EPTFEL) [TR-ND-172]',
        (t73, f73) AS 'MMSWBTP-073|Missing Data|Missing Accrued Termination Fee to NPD (EPTFEN) [TR-ND-173]',
        (t74, f74) AS 'MMSWBTP-074|Missing Data|Missing Accrued Interest for Next Month (EPINTJ) [TR-ND-174]',
        (t75, f75) AS 'MMSWBTP-075|Missing Data|Missing Accrued Margin for Next Month (EPACMJ) [TR-ND-175]',
        (t76, f76) AS 'MMSWBTP-076|Missing Data|Missing Carrying Cost for Next Month (EPCCRJ) [TR-ND-176]',
        (t77, f77) AS 'MMSWBTP-077|Missing Data|Missing Cost of Customer Margin Earned Next Month (EPCCMJ) [TR-ND-177]',
        (t78, f78) AS 'MMSWBTP-078|Missing Data|Missing Special Cash Accrual Mth End Adjustment (EPSCAJ) [TR-ND-178]',
        (t79, f79) AS 'MMSWBTP-079|Missing Data|Missing Special Cash Deferred P and L Adjustment (EPSCDJ) [TR-ND-179]',
        (t80, f80) AS 'MMSWBTP-080|Missing Data|Missing Assignment Fee Accrued for Next Month (EPAFEJ) [TR-ND-180]',
        (t81, f81) AS 'MMSWBTP-081|Missing Data|Missing Termination Fee Accrued for Next Month (EPTFEJ) [TR-ND-181]',
        (t82, f82) AS 'MMSWBTP-082|Missing Data|Missing Basic Deal Type (EPBDLT) [TR-ND-182]',
        (t83, f83) AS 'MMSWBTP-083|Missing Data|Missing Cumulative Principal as at LPD (EPPRCK) [TR-ND-183]',
        (t84, f84) AS 'MMSWBTP-084|Missing Data|Missing Cumulative Real Principal as at LPD (EPRPEK) [TR-ND-184]',
        (t85, f85) AS 'MMSWBTP-085|Missing Data|Missing Cumulative Corporate Margin accrued as at LPD (EPACMK) [TR-ND-185]',
        (t86, f86) AS 'MMSWBTP-086|Missing Data|Missing Cumulative Interest accrued as at LPD (EPINTK) [TR-ND-186]',
        (t87, f87) AS 'MMSWBTP-087|Missing Data|Missing Special Cash Accrual Cumulated (EPSCAK) [TR-ND-187]',
        (t88, f88) AS 'MMSWBTP-088|Missing Data|Missing Special Cash Deferred P and L Cumulative (EPSCDK) [TR-ND-188]',
        (t89, f89) AS 'MMSWBTP-089|Missing Data|Missing Backdated Coupon Accrued (EPBCPA) [TR-ND-189]',
        (t90, f90) AS 'MMSWBTP-090|Missing Data|Missing Backdated Corporate Margin Accrued (EPBCMA) [TR-ND-190]',
        (t91, f91) AS 'MMSWBTP-091|Missing Data|Missing Pay/Receive Indicator (Primary Position) (EPPRIP) [TR-ND-191]',
        (t92, f92) AS 'MMSWBTP-092|Missing Data|Missing Payment Periodicity (EPPMPT) [TR-ND-192]',
        (t93, f93) AS 'MMSWBTP-093|Missing Data|Missing Broken Period Calculation Basis (EPBKCB) [TR-ND-193]',
        (t94, f94) AS 'MMSWBTP-094|Missing Data|Missing Broken Period Fixed Rate (EPBKXT) [TR-ND-194]',
        (t95, f95) AS 'MMSWBTP-095|Missing Data|Missing Broken Period Floating Rate Type (EPBKOT) [TR-ND-195]',
        (t96, f96) AS 'MMSWBTP-096|Missing Data|Missing Broken Period Floating Rate Periodicity (EPBKOY) [TR-ND-196]',
        (t97, f97) AS 'MMSWBTP-097|Missing Data|Missing Broken Period Quoted Margin (EPBKQM) [TR-ND-197]',
        (t98, f98) AS 'MMSWBTP-098|Missing Data|Missing Broken Period Payment Periodicity (EPBKPY) [TR-ND-198]',
        (t99, f99) AS 'MMSWBTP-099|Missing Data|Missing Broken Period Interest Calc Method (EPBKIM) [TR-ND-199]',
        (t100, f100) AS 'MMSWBTP-100|Missing Data|Missing Total Mark to Market at LPD (EPMM01) [TR-ND-200]',
        (t101, f101) AS 'MMSWBTP-101|Missing Data|Missing Total Mark to Market at NPD (EPMM04) [TR-ND-201]',
        (t102, f102) AS 'MMSWBTP-102|Missing Data|Missing Replacement Cost - NPD (EPRPCN) [TR-ND-202]',
        (t103, f103) AS 'MMSWBTP-103|Missing Data|Missing Replacement Cost - LPD (EPRPCL) [TR-ND-203]',
        (t104, f104) AS 'MMSWBTP-104|Missing Data|Missing Agreement Id (EPAGID) [TR-ND-204]',
        (t105, f105) AS 'MMSWBTP-105|Missing Data|Missing Hedge Mark-to-Market LPD (EPMKHL) [TR-ND-205]',
        (t106, f106) AS 'MMSWBTP-106|Missing Data|Missing Hedge Mark-to-Market NPD (EPMKHN) [TR-ND-206]',
        (t107, f107) AS 'MMSWBTP-107|Missing Data|Missing Un-hedged Mark-to-Market LPD (EPMKUL) [TR-ND-207]',
        (t108, f108) AS 'MMSWBTP-108|Missing Data|Missing Un-hedged Mark-to-Market NPD (EPMKUN) [TR-ND-208]',
        (t109, f109) AS 'MMSWBTP-109|Invalid Dates|Invalid/Missing Value Date (EPVDAT) [TR-ND-209]',
        (t110, f110) AS 'MMSWBTP-110|Invalid Dates|Invalid/Missing Maturity Date (EPMDAT) [TR-ND-210]',
        (t111, f111) AS 'MMSWBTP-111|Invalid Dates|Invalid/Missing Hedging End Date (EPHEDT) [TR-ND-211]',
        (t112, f112) AS 'MMSWBTP-112|Invalid Dates|Invalid/Missing Capture Date (EPCDAT) [TR-ND-212]',
        (t113, f113) AS 'MMSWBTP-113|Invalid Dates|Invalid/Missing Termination Date (EPTRMD) [TR-ND-213]',
        (t114, f114) AS 'MMSWBTP-114|Invalid Dates|Invalid/Missing Current Interest Period Start Date (EPCPSD) [TR-ND-214]',
        (t115, f115) AS 'MMSWBTP-115|Invalid Dates|Invalid/Missing Interest Payment Period Start Date (EPIPSD) [TR-ND-215]',
        (t116, f116) AS 'MMSWBTP-116|Invalid Dates|Invalid/Missing Last Rate Resetting Date (EPLRDT) [TR-ND-216]',
        (t117, f117) AS 'MMSWBTP-117|Invalid Dates|Invalid/Missing Next Rate Resetting Date (EPNRDT) [TR-ND-217]',
        (t118, f118) AS 'MMSWBTP-118|Invalid Dates|Invalid/Missing Last coupon date to fix (EPLXDT) [TR-ND-218]',
        (t119, f119) AS 'MMSWBTP-119|Invalid Dates|Invalid/Missing Next Coupon Date To (EPNXDT) [TR-ND-219]',
        (t120, f120) AS 'MMSWBTP-120|Invalid Dates|Invalid/Missing Date of Creation/Amendment (EPDTCA) [TR-ND-220]',
        (t121, f121) AS 'MMSWBTP-121|Invalid Dates|Invalid/Missing Principal amortization date (EPPADT) [TR-ND-221]',
        (t122, f122) AS 'MMSWBTP-122|Invalid Dates|Invalid/Missing Principal Payment Date (EPPPDT) [TR-ND-222]',
        (t123, f123) AS 'MMSWBTP-123|Invalid Dates|Invalid/Missing Coupon Payment Date (EPCUDT) [TR-ND-223]',
        (t124, f124) AS 'MMSWBTP-124|Invalid Dates|Invalid/Missing Broken Period Start Date (EPBKSD) [TR-ND-224]',
        (t125, f125) AS 'MMSWBTP-125|Invalid Dates|Invalid/Missing Broken Period End Date (EPBKED) [TR-ND-225]',
        (t126, f126) AS 'MMSWBTP-126|Inconsistent Data|Maturity date before value date (EPMDAT &lt; EPVDAT) [TR-ND-226]'
      ))
    UNION ALL
/* ######################## DC5 νέοι έλεγχοι (DD v2.4), αυτούσιοι από το ME36_TREATS_DQC_DC5.sql ######################## */
/* =============================================================================
   MMNMBTP - Money Market MCNI Blotter
   Πίνακας: DATACUT5."TREATS_MMNMBTP"   Shadow: δεν υπάρχει mode flag   Έλεγχοι: 18
   Νέος πίνακας στο DD v2.4.
   Στο DD ο πίνακας λέγεται "TEUTTSFP_MMNMBTP"· στη βάση (όπως στο DC4) TREATS_MMNMBTP.
   ============================================================================= */
    SELECT 'MMNMBTP - Money Market MCNI Blotter' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- MMNMBTP-001: Missing dealing number (FXDLNO)
          COUNT(*) AS t1,
          COUNT(CASE WHEN TRIM(s."FXDLNO") IS NULL THEN 1 END) AS f1,
          -- MMNMBTP-002: Duplicate dealing number + security line (FXDLNO+FXSCLN)
          COUNT(CASE WHEN TRIM(s."FXDLNO") IS NOT NULL AND TRIM(s."FXSCLN") IS NOT NULL THEN 1 END) AS t2,
          COUNT(CASE WHEN TRIM(s."FXDLNO") IS NOT NULL AND TRIM(s."FXSCLN") IS NOT NULL AND s.dup_fxdlno_fxscln &gt; 1 THEN 1 END) AS f2,
          -- MMNMBTP-003: Deal (FXDLNO) not found in deal master TREATS_MPMNMCP
          COUNT(CASE WHEN TRIM(s."FXDLNO") IS NOT NULL THEN 1 END) AS t3,
          COUNT(CASE WHEN TRIM(s."FXDLNO") IS NOT NULL AND j1.dlno IS NULL THEN 1 END) AS f3,
          -- MMNMBTP-004: Security master (FXSMNO) not found in TREATS_ISNMMSP
          COUNT(CASE WHEN TRIM(s."FXSMNO") IS NOT NULL THEN 1 END) AS t4,
          COUNT(CASE WHEN TRIM(s."FXSMNO") IS NOT NULL AND j2.smno IS NULL THEN 1 END) AS f4,
          -- MMNMBTP-005: Security line (FXSCLN) not found in TREATS_MMNMLNP
          COUNT(CASE WHEN TRIM(s."FXSCLN") IS NOT NULL THEN 1 END) AS t5,
          COUNT(CASE WHEN TRIM(s."FXSCLN") IS NOT NULL AND j3.scln IS NULL THEN 1 END) AS f5,
          -- MMNMBTP-006: Invalid date: Value Date (FXVDAT)
          COUNT(*) AS t6,
          COUNT(CASE WHEN s.dv_fxvdat = -1 THEN 1 END) AS f6,
          -- MMNMBTP-007: Invalid date: Maturity Date (FXMDAT)
          COUNT(*) AS t7,
          COUNT(CASE WHEN s.dv_fxmdat = -1 THEN 1 END) AS f7,
          -- MMNMBTP-008: Invalid date: Hedging End Date (FXHEDT)
          COUNT(*) AS t8,
          COUNT(CASE WHEN s.dv_fxhedt = -1 THEN 1 END) AS f8,
          -- MMNMBTP-009: Invalid date: Capture Date (FXCDAT)
          COUNT(*) AS t9,
          COUNT(CASE WHEN s.dv_fxcdat = -1 THEN 1 END) AS f9,
          -- MMNMBTP-010: Invalid date: Date of Creation/Amendment (FXDTCA)
          COUNT(*) AS t10,
          COUNT(CASE WHEN s.dv_fxdtca = -1 THEN 1 END) AS f10,
          -- MMNMBTP-011: Invalid time: Time Of Creation/Amendment (FXTMCA)
          COUNT(*) AS t11,
          COUNT(CASE WHEN s.tm_fxtmca = 1 THEN 1 END) AS f11,
          -- MMNMBTP-012: Invalid date: Failed Date (FXFAID)
          COUNT(*) AS t12,
          COUNT(CASE WHEN s.dv_fxfaid = -1 THEN 1 END) AS f12,
          -- MMNMBTP-013: Invalid date: Failed nominal date (FXFNMD)
          COUNT(*) AS t13,
          COUNT(CASE WHEN s.dv_fxfnmd = -1 THEN 1 END) AS f13,
          -- MMNMBTP-014: Invalid date: Last Failed Updated Date (FXLFUD)
          COUNT(*) AS t14,
          COUNT(CASE WHEN s.dv_fxlfud = -1 THEN 1 END) AS f14,
          -- MMNMBTP-015: Maturity date before value date (FXMDAT &lt; FXVDAT)
          COUNT(CASE WHEN s.dv_fxvdat &gt; 0 AND s.dv_fxmdat &gt; 0 THEN 1 END) AS t15,
          COUNT(CASE WHEN s.dv_fxvdat &gt; 0 AND s.dv_fxmdat &gt; 0 AND s.dv_fxmdat &lt; s.dv_fxvdat THEN 1 END) AS f15,
          -- MMNMBTP-016: Product Currency (FXPDCY) not a valid ISO currency code (3 letters) [masked]
          COUNT(CASE WHEN TRIM(s."FXPDCY") IS NOT NULL THEN 1 END) AS t16,
          COUNT(CASE WHEN TRIM(s."FXPDCY") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."FXPDCY"), '^[A-Z]{3}$') THEN 1 END) AS f16,
          -- MMNMBTP-017: Value not in (E/S/κενό): Rate Type (DD: E=Effective, S=Simple) (FXRRTP)
          COUNT(CASE WHEN TRIM(s."FXRRTP") IS NOT NULL THEN 1 END) AS t17,
          COUNT(CASE WHEN TRIM(s."FXRRTP") IS NOT NULL AND TRIM(s."FXRRTP") NOT IN ('E', 'S') THEN 1 END) AS f17,
          -- MMNMBTP-018: Missing product currency (FXPDCY)
          COUNT(*) AS t18,
          COUNT(CASE WHEN TRIM(s."FXPDCY") IS NULL THEN 1 END) AS f18
        FROM (
          SELECT s0.*, COUNT(*) OVER (PARTITION BY TRIM(s0."FXDLNO"), TRIM(s0."FXSCLN")) AS dup_fxdlno_fxscln
            FROM (
              SELECT t."FXDLNO",
                     t."FXPDCY",
                     t."FXRRTP",
                     t."FXSCLN",
                     t."FXSMNO",
                     (CASE WHEN TRIM(t."FXVDAT") IS NULL OR REGEXP_LIKE(TRIM(t."FXVDAT"), '^[0 -]*$') THEN NULL
                       WHEN REGEXP_LIKE(TRIM(t."FXVDAT"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."FXVDAT") AS DATE, 'YYYYMMDD') = 1 AND TRIM(t."FXVDAT") &gt;= '19000101' THEN TO_NUMBER(TRIM(t."FXVDAT")) ELSE -1 END) AS dv_fxvdat,
                     (CASE WHEN TRIM(t."FXMDAT") IS NULL OR REGEXP_LIKE(TRIM(t."FXMDAT"), '^[0 -]*$') THEN NULL
                       WHEN REGEXP_LIKE(TRIM(t."FXMDAT"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."FXMDAT") AS DATE, 'YYYYMMDD') = 1 AND TRIM(t."FXMDAT") &gt;= '19000101' THEN TO_NUMBER(TRIM(t."FXMDAT")) ELSE -1 END) AS dv_fxmdat,
                     (CASE WHEN TRIM(t."FXHEDT") IS NULL OR REGEXP_LIKE(TRIM(t."FXHEDT"), '^[0 -]*$') THEN NULL
                       WHEN REGEXP_LIKE(TRIM(t."FXHEDT"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."FXHEDT") AS DATE, 'YYYYMMDD') = 1 AND TRIM(t."FXHEDT") &gt;= '19000101' THEN TO_NUMBER(TRIM(t."FXHEDT")) ELSE -1 END) AS dv_fxhedt,
                     (CASE WHEN TRIM(t."FXCDAT") IS NULL OR REGEXP_LIKE(TRIM(t."FXCDAT"), '^[0 -]*$') THEN NULL
                       WHEN REGEXP_LIKE(TRIM(t."FXCDAT"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."FXCDAT") AS DATE, 'YYYYMMDD') = 1 AND TRIM(t."FXCDAT") &gt;= '19000101' THEN TO_NUMBER(TRIM(t."FXCDAT")) ELSE -1 END) AS dv_fxcdat,
                     (CASE WHEN TRIM(t."FXDTCA") IS NULL OR REGEXP_LIKE(TRIM(t."FXDTCA"), '^[0 -]*$') THEN NULL
                       WHEN REGEXP_LIKE(TRIM(t."FXDTCA"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."FXDTCA") AS DATE, 'YYYYMMDD') = 1 AND TRIM(t."FXDTCA") &gt;= '19000101' THEN TO_NUMBER(TRIM(t."FXDTCA")) ELSE -1 END) AS dv_fxdtca,
                     (CASE WHEN TRIM(t."FXTMCA") IS NOT NULL AND NOT REGEXP_LIKE(LPAD(TRIM(t."FXTMCA"), 6, '0'), '^([01][0-9]|2[0-3])[0-5][0-9][0-5][0-9]$') THEN 1 ELSE 0 END) AS tm_fxtmca,
                     (CASE WHEN TRIM(t."FXFAID") IS NULL OR REGEXP_LIKE(TRIM(t."FXFAID"), '^[0 -]*$') THEN NULL
                       WHEN REGEXP_LIKE(TRIM(t."FXFAID"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."FXFAID") AS DATE, 'YYYYMMDD') = 1 AND TRIM(t."FXFAID") &gt;= '19000101' THEN TO_NUMBER(TRIM(t."FXFAID")) ELSE -1 END) AS dv_fxfaid,
                     (CASE WHEN TRIM(t."FXFNMD") IS NULL OR REGEXP_LIKE(TRIM(t."FXFNMD"), '^[0 -]*$') THEN NULL
                       WHEN REGEXP_LIKE(TRIM(t."FXFNMD"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."FXFNMD") AS DATE, 'YYYYMMDD') = 1 AND TRIM(t."FXFNMD") &gt;= '19000101' THEN TO_NUMBER(TRIM(t."FXFNMD")) ELSE -1 END) AS dv_fxfnmd,
                     (CASE WHEN TRIM(t."FXLFUD") IS NULL OR REGEXP_LIKE(TRIM(t."FXLFUD"), '^[0 -]*$') THEN NULL
                       WHEN REGEXP_LIKE(TRIM(t."FXLFUD"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."FXLFUD") AS DATE, 'YYYYMMDD') = 1 AND TRIM(t."FXLFUD") &gt;= '19000101' THEN TO_NUMBER(TRIM(t."FXLFUD")) ELSE -1 END) AS dv_fxlfud
                FROM DATACUT5."TREATS_MMNMBTP" t
            ) s0
        ) s
        LEFT JOIN k_mcni_deal j1 ON j1.dlno = TRIM(s."FXDLNO")
        LEFT JOIN k_sm j2 ON j2.smno = TRIM(s."FXSMNO")
        LEFT JOIN k_scln j3 ON j3.scln = TRIM(s."FXSCLN")
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'MMNMBTP-001|Missing Data|Missing dealing number (FXDLNO)',
        (t2, f2) AS 'MMNMBTP-002|Duplicates|Duplicate dealing number + security line (FXDLNO+FXSCLN)',
        (t3, f3) AS 'MMNMBTP-003|Missing Links|Deal (FXDLNO) not found in deal master TREATS_MPMNMCP',
        (t4, f4) AS 'MMNMBTP-004|Missing Links|Security master (FXSMNO) not found in TREATS_ISNMMSP',
        (t5, f5) AS 'MMNMBTP-005|Missing Links|Security line (FXSCLN) not found in TREATS_MMNMLNP',
        (t6, f6) AS 'MMNMBTP-006|Invalid Dates|Invalid date: Value Date (FXVDAT)',
        (t7, f7) AS 'MMNMBTP-007|Invalid Dates|Invalid date: Maturity Date (FXMDAT)',
        (t8, f8) AS 'MMNMBTP-008|Invalid Dates|Invalid date: Hedging End Date (FXHEDT)',
        (t9, f9) AS 'MMNMBTP-009|Invalid Dates|Invalid date: Capture Date (FXCDAT)',
        (t10, f10) AS 'MMNMBTP-010|Invalid Dates|Invalid date: Date of Creation/Amendment (FXDTCA)',
        (t11, f11) AS 'MMNMBTP-011|Invalid Values|Invalid time: Time Of Creation/Amendment (FXTMCA)',
        (t12, f12) AS 'MMNMBTP-012|Invalid Dates|Invalid date: Failed Date (FXFAID)',
        (t13, f13) AS 'MMNMBTP-013|Invalid Dates|Invalid date: Failed nominal date (FXFNMD)',
        (t14, f14) AS 'MMNMBTP-014|Invalid Dates|Invalid date: Last Failed Updated Date (FXLFUD)',
        (t15, f15) AS 'MMNMBTP-015|Inconsistent Data|Maturity date before value date (FXMDAT &lt; FXVDAT)',
        (t16, f16) AS 'MMNMBTP-016|Format|Product Currency (FXPDCY) not a valid ISO currency code (3 letters) [masked]',
        (t17, f17) AS 'MMNMBTP-017|Invalid Values|Value not in (E/S/κενό): Rate Type (DD: E=Effective, S=Simple) (FXRRTP)',
        (t18, f18) AS 'MMNMBTP-018|Missing Data|Missing product currency (FXPDCY)'
      ))
    UNION ALL
/* =============================================================================
   MMZCBTP - M-Mkt Type 2 (Zero Coupon) Non-nego Xact Blotter
   Πίνακας: DATACUT5."TREATS_MMZCBTP"   Shadow: δεν υπάρχει mode flag   Έλεγχοι: 13
   Νέος πίνακας στο DD v2.4.
   Στο DD ο πίνακας λέγεται "TEUTTSFP_MMZCBTP"· στη βάση (όπως στο DC4) TREATS_MMZCBTP.
   ============================================================================= */
    SELECT 'MMZCBTP - M-Mkt Type 2 (Zero Coupon) Non-nego Xact Blotter' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- MMZCBTP-001: Missing dealing number (FEDLNO)
          COUNT(*) AS t1,
          COUNT(CASE WHEN TRIM(s."FEDLNO") IS NULL THEN 1 END) AS f1,
          -- MMZCBTP-002: Duplicate dealing number (FEDLNO)
          COUNT(CASE WHEN TRIM(s."FEDLNO") IS NOT NULL THEN 1 END) AS t2,
          COUNT(CASE WHEN TRIM(s."FEDLNO") IS NOT NULL AND s.dup_fedlno &gt; 1 THEN 1 END) AS f2,
          -- MMZCBTP-003: Deal (FEDLNO) not found in deal master TREATS_MPMZCPP
          COUNT(CASE WHEN TRIM(s."FEDLNO") IS NOT NULL THEN 1 END) AS t3,
          COUNT(CASE WHEN TRIM(s."FEDLNO") IS NOT NULL AND j1.dlno IS NULL THEN 1 END) AS f3,
          -- MMZCBTP-004: Invalid date: Value Date (FEVDAT)
          COUNT(*) AS t4,
          COUNT(CASE WHEN s.dv_fevdat = -1 THEN 1 END) AS f4,
          -- MMZCBTP-005: Invalid date: Maturity Date (FEMDAT)
          COUNT(*) AS t5,
          COUNT(CASE WHEN s.dv_femdat = -1 THEN 1 END) AS f5,
          -- MMZCBTP-006: Invalid date: Ladder Value Date (FEMLVD)
          COUNT(*) AS t6,
          COUNT(CASE WHEN s.dv_femlvd = -1 THEN 1 END) AS f6,
          -- MMZCBTP-007: Invalid date: Capture Date (FECDAT)
          COUNT(*) AS t7,
          COUNT(CASE WHEN s.dv_fecdat = -1 THEN 1 END) AS f7,
          -- MMZCBTP-008: Invalid date: Date of Creation/Amendment (FEDTCA)
          COUNT(*) AS t8,
          COUNT(CASE WHEN s.dv_fedtca = -1 THEN 1 END) AS f8,
          -- MMZCBTP-009: Invalid time: Time Of Creation/Amendment (FETMCA)
          COUNT(*) AS t9,
          COUNT(CASE WHEN s.tm_fetmca = 1 THEN 1 END) AS f9,
          -- MMZCBTP-010: Maturity date before value date (FEMDAT &lt; FEVDAT)
          COUNT(CASE WHEN s.dv_fevdat &gt; 0 AND s.dv_femdat &gt; 0 THEN 1 END) AS t10,
          COUNT(CASE WHEN s.dv_fevdat &gt; 0 AND s.dv_femdat &gt; 0 AND s.dv_femdat &lt; s.dv_fevdat THEN 1 END) AS f10,
          -- MMZCBTP-011: Product Currency (FEPDCY) not a valid ISO currency code (3 letters)
          COUNT(CASE WHEN TRIM(s."FEPDCY") IS NOT NULL THEN 1 END) AS t11,
          COUNT(CASE WHEN TRIM(s."FEPDCY") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."FEPDCY"), '^[A-Z]{3}$') THEN 1 END) AS f11,
          -- MMZCBTP-012: Value not in (E/S/κενό): Rate Type (DD: E=Effective, S=Simple) (FERRTP)
          COUNT(CASE WHEN TRIM(s."FERRTP") IS NOT NULL THEN 1 END) AS t12,
          COUNT(CASE WHEN TRIM(s."FERRTP") IS NOT NULL AND TRIM(s."FERRTP") NOT IN ('E', 'S') THEN 1 END) AS f12,
          -- MMZCBTP-013: Missing product currency (FEPDCY)
          COUNT(*) AS t13,
          COUNT(CASE WHEN TRIM(s."FEPDCY") IS NULL THEN 1 END) AS f13
        FROM (
          SELECT s0.*, COUNT(*) OVER (PARTITION BY TRIM(s0."FEDLNO")) AS dup_fedlno
            FROM (
              SELECT t."FEDLNO",
                     t."FEPDCY",
                     t."FERRTP",
                     (CASE WHEN TRIM(t."FEVDAT") IS NULL OR REGEXP_LIKE(TRIM(t."FEVDAT"), '^[0 -]*$') THEN NULL
                       WHEN REGEXP_LIKE(TRIM(t."FEVDAT"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."FEVDAT") AS DATE, 'YYYYMMDD') = 1 AND TRIM(t."FEVDAT") &gt;= '19000101' THEN TO_NUMBER(TRIM(t."FEVDAT")) ELSE -1 END) AS dv_fevdat,
                     (CASE WHEN TRIM(t."FEMDAT") IS NULL OR REGEXP_LIKE(TRIM(t."FEMDAT"), '^[0 -]*$') THEN NULL
                       WHEN REGEXP_LIKE(TRIM(t."FEMDAT"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."FEMDAT") AS DATE, 'YYYYMMDD') = 1 AND TRIM(t."FEMDAT") &gt;= '19000101' THEN TO_NUMBER(TRIM(t."FEMDAT")) ELSE -1 END) AS dv_femdat,
                     (CASE WHEN TRIM(t."FEMLVD") IS NULL OR REGEXP_LIKE(TRIM(t."FEMLVD"), '^[0 -]*$') THEN NULL
                       WHEN REGEXP_LIKE(TRIM(t."FEMLVD"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."FEMLVD") AS DATE, 'YYYYMMDD') = 1 AND TRIM(t."FEMLVD") &gt;= '19000101' THEN TO_NUMBER(TRIM(t."FEMLVD")) ELSE -1 END) AS dv_femlvd,
                     (CASE WHEN TRIM(t."FECDAT") IS NULL OR REGEXP_LIKE(TRIM(t."FECDAT"), '^[0 -]*$') THEN NULL
                       WHEN REGEXP_LIKE(TRIM(t."FECDAT"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."FECDAT") AS DATE, 'YYYYMMDD') = 1 AND TRIM(t."FECDAT") &gt;= '19000101' THEN TO_NUMBER(TRIM(t."FECDAT")) ELSE -1 END) AS dv_fecdat,
                     (CASE WHEN TRIM(t."FEDTCA") IS NULL OR REGEXP_LIKE(TRIM(t."FEDTCA"), '^[0 -]*$') THEN NULL
                       WHEN REGEXP_LIKE(TRIM(t."FEDTCA"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."FEDTCA") AS DATE, 'YYYYMMDD') = 1 AND TRIM(t."FEDTCA") &gt;= '19000101' THEN TO_NUMBER(TRIM(t."FEDTCA")) ELSE -1 END) AS dv_fedtca,
                     (CASE WHEN TRIM(t."FETMCA") IS NOT NULL AND NOT REGEXP_LIKE(LPAD(TRIM(t."FETMCA"), 6, '0'), '^([01][0-9]|2[0-3])[0-5][0-9][0-5][0-9]$') THEN 1 ELSE 0 END) AS tm_fetmca
                FROM DATACUT5."TREATS_MMZCBTP" t
            ) s0
        ) s
        LEFT JOIN k_zc_deal j1 ON j1.dlno = TRIM(s."FEDLNO")
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'MMZCBTP-001|Missing Data|Missing dealing number (FEDLNO)',
        (t2, f2) AS 'MMZCBTP-002|Duplicates|Duplicate dealing number (FEDLNO)',
        (t3, f3) AS 'MMZCBTP-003|Missing Links|Deal (FEDLNO) not found in deal master TREATS_MPMZCPP',
        (t4, f4) AS 'MMZCBTP-004|Invalid Dates|Invalid date: Value Date (FEVDAT)',
        (t5, f5) AS 'MMZCBTP-005|Invalid Dates|Invalid date: Maturity Date (FEMDAT)',
        (t6, f6) AS 'MMZCBTP-006|Invalid Dates|Invalid date: Ladder Value Date (FEMLVD)',
        (t7, f7) AS 'MMZCBTP-007|Invalid Dates|Invalid date: Capture Date (FECDAT)',
        (t8, f8) AS 'MMZCBTP-008|Invalid Dates|Invalid date: Date of Creation/Amendment (FEDTCA)',
        (t9, f9) AS 'MMZCBTP-009|Invalid Values|Invalid time: Time Of Creation/Amendment (FETMCA)',
        (t10, f10) AS 'MMZCBTP-010|Inconsistent Data|Maturity date before value date (FEMDAT &lt; FEVDAT)',
        (t11, f11) AS 'MMZCBTP-011|Format|Product Currency (FEPDCY) not a valid ISO currency code (3 letters)',
        (t12, f12) AS 'MMZCBTP-012|Invalid Values|Value not in (E/S/κενό): Rate Type (DD: E=Effective, S=Simple) (FERRTP)',
        (t13, f13) AS 'MMZCBTP-013|Missing Data|Missing product currency (FEPDCY)'
      ))
    UNION ALL
/* =============================================================================
   EXBLOTP - Exchange Blotter File
   Πίνακας: DATACUT5."TREATS_EXBLOTP"   Shadow: δεν υπάρχει mode flag   Έλεγχοι: 8
   Υπάρχων πίνακας: τα BBCYPL, BBCEPL, BBPEPL άλλαξαν από Decimal(16,9) σε Integer(15) στο DD v2.4.
   Στο DD ο πίνακας λέγεται "TEUTTSFP_EXBLOTP"· στη βάση (όπως στο DC4) TREATS_EXBLOTP.
   ============================================================================= */
    SELECT 'EXBLOTP - Exchange Blotter File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- EXBLOTP-501: Not an integer value: Currenct Spot Revaluation in USD equivalent (BBCYPL)
          COUNT(CASE WHEN TRIM(s."BBCYPL") IS NOT NULL THEN 1 END) AS t1,
          COUNT(CASE WHEN TRIM(s."BBCYPL") IS NOT NULL AND (VALIDATE_CONVERSION(TRIM(s."BBCYPL") AS NUMBER) = 0 OR s.n_bbcypl &lt;&gt; TRUNC(s.n_bbcypl)) THEN 1 END) AS f1,
          -- EXBLOTP-502: Not an integer value: Current Spot Revaluation (BBCEPL)
          COUNT(CASE WHEN TRIM(s."BBCEPL") IS NOT NULL THEN 1 END) AS t2,
          COUNT(CASE WHEN TRIM(s."BBCEPL") IS NOT NULL AND (VALIDATE_CONVERSION(TRIM(s."BBCEPL") AS NUMBER) = 0 OR s.n_bbcepl &lt;&gt; TRUNC(s.n_bbcepl)) THEN 1 END) AS f2,
          -- EXBLOTP-503: Not an integer value: Previous Spot Revaluation (BBPEPL)
          COUNT(CASE WHEN TRIM(s."BBPEPL") IS NOT NULL THEN 1 END) AS t3,
          COUNT(CASE WHEN TRIM(s."BBPEPL") IS NOT NULL AND (VALIDATE_CONVERSION(TRIM(s."BBPEPL") AS NUMBER) = 0 OR s.n_bbpepl &lt;&gt; TRUNC(s.n_bbpepl)) THEN 1 END) AS f3,
          -- EXBLOTP-504: Value not in (Y/N): Cancel Flag (BBCNFG)
          COUNT(*) AS t4,
          COUNT(CASE WHEN NVL(TRIM(s."BBCNFG"), '#') NOT IN ('Y', 'N') THEN 1 END) AS f4,
          -- EXBLOTP-505: Value not in (Y/N): Accounting Flag (BBACFG)
          COUNT(*) AS t5,
          COUNT(CASE WHEN NVL(TRIM(s."BBACFG"), '#') NOT IN ('Y', 'N') THEN 1 END) AS f5,
          -- EXBLOTP-506: Value not in (E/I/R/A): Ext/Int/Retail/Arbitrage Indicator (BBEIRI)
          COUNT(*) AS t6,
          COUNT(CASE WHEN NVL(TRIM(s."BBEIRI"), '#') NOT IN ('E', 'I', 'R', 'A') THEN 1 END) AS f6,
          -- EXBLOTP-507: Value not in (D/M): Rate Sense (BBRSNS)
          COUNT(*) AS t7,
          COUNT(CASE WHEN NVL(TRIM(s."BBRSNS"), '#') NOT IN ('D', 'M') THEN 1 END) AS f7,
          -- EXBLOTP-508: Value not in (Y/N): Money Market Forward Flag (BBMMKF)
          COUNT(*) AS t8,
          COUNT(CASE WHEN NVL(TRIM(s."BBMMKF"), '#') NOT IN ('Y', 'N') THEN 1 END) AS f8
        FROM (
              SELECT t."BBACFG",
                     t."BBCEPL",
                     t."BBCNFG",
                     t."BBCYPL",
                     t."BBEIRI",
                     t."BBMMKF",
                     t."BBPEPL",
                     t."BBRSNS",
                     (CASE WHEN VALIDATE_CONVERSION(TRIM(t."BBCYPL") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."BBCYPL")) END) AS n_bbcypl,
                     (CASE WHEN VALIDATE_CONVERSION(TRIM(t."BBCEPL") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."BBCEPL")) END) AS n_bbcepl,
                     (CASE WHEN VALIDATE_CONVERSION(TRIM(t."BBPEPL") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."BBPEPL")) END) AS n_bbpepl
                FROM DATACUT5."TREATS_EXBLOTP" t
        ) s
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'EXBLOTP-501|Invalid Values|Not an integer value: Currenct Spot Revaluation in USD equivalent (BBCYPL)',
        (t2, f2) AS 'EXBLOTP-502|Invalid Values|Not an integer value: Current Spot Revaluation (BBCEPL)',
        (t3, f3) AS 'EXBLOTP-503|Invalid Values|Not an integer value: Previous Spot Revaluation (BBPEPL)',
        (t4, f4) AS 'EXBLOTP-504|Invalid Values|Value not in (Y/N): Cancel Flag (BBCNFG)',
        (t5, f5) AS 'EXBLOTP-505|Invalid Values|Value not in (Y/N): Accounting Flag (BBACFG)',
        (t6, f6) AS 'EXBLOTP-506|Invalid Values|Value not in (E/I/R/A): Ext/Int/Retail/Arbitrage Indicator (BBEIRI)',
        (t7, f7) AS 'EXBLOTP-507|Invalid Values|Value not in (D/M): Rate Sense (BBRSNS)',
        (t8, f8) AS 'EXBLOTP-508|Invalid Values|Value not in (Y/N): Money Market Forward Flag (BBMMKF)'
      ))
    UNION ALL
/* =============================================================================
   MPESPTP - Exchange Spot Deal File
   Πίνακας: DATACUT5."TREATS_MPESPTP"   Shadow: δεν υπάρχει mode flag   Έλεγχοι: 13
   Έλεγχοι τιμών από τη στήλη Free column του DD v2.4.
   ============================================================================= */
    SELECT 'MPESPTP - Exchange Spot Deal File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- MPESPTP-501: Value not in (E/I/R/A): EXT/INT/RET/ARB IND (TAEIRI)
          COUNT(*) AS t1,
          COUNT(CASE WHEN NVL(TRIM(s."TAEIRI"), '#') NOT IN ('E', 'I', 'R', 'A') THEN 1 END) AS f1,
          -- MPESPTP-502: Value not in (Y/N): FREE BKRG FLG (TABKFG)
          COUNT(*) AS t2,
          COUNT(CASE WHEN NVL(TRIM(s."TABKFG"), '#') NOT IN ('Y', 'N') THEN 1 END) AS f2,
          -- MPESPTP-503: Value not in (Y/N): SPWN IND (TASPIN)
          COUNT(*) AS t3,
          COUNT(CASE WHEN NVL(TRIM(s."TASPIN"), '#') NOT IN ('Y', 'N') THEN 1 END) AS f3,
          -- MPESPTP-504: Value not in (Y/N): SETL ATTN IND (TASAIN)
          COUNT(*) AS t4,
          COUNT(CASE WHEN NVL(TRIM(s."TASAIN"), '#') NOT IN ('Y', 'N') THEN 1 END) AS f4,
          -- MPESPTP-505: Value not in (Y/N): DL MEMO IND (TADMIN)
          COUNT(*) AS t5,
          COUNT(CASE WHEN NVL(TRIM(s."TADMIN"), '#') NOT IN ('Y', 'N') THEN 1 END) AS f5,
          -- MPESPTP-506: Value not in (D/M): RATE SENSE (TARSNS)
          COUNT(*) AS t6,
          COUNT(CASE WHEN NVL(TRIM(s."TARSNS"), '#') NOT IN ('D', 'M') THEN 1 END) AS f6,
          -- MPESPTP-507: Value not in (D/M/κενό): RATE SENSE (TARSN1)
          COUNT(CASE WHEN TRIM(s."TARSN1") IS NOT NULL THEN 1 END) AS t7,
          COUNT(CASE WHEN TRIM(s."TARSN1") IS NOT NULL AND TRIM(s."TARSN1") NOT IN ('D', 'M') THEN 1 END) AS f7,
          -- MPESPTP-508: Value not in (D/M/κενό): RATE SENSE (TARSN2)
          COUNT(CASE WHEN TRIM(s."TARSN2") IS NOT NULL THEN 1 END) AS t8,
          COUNT(CASE WHEN TRIM(s."TARSN2") IS NOT NULL AND TRIM(s."TARSN2") NOT IN ('D', 'M') THEN 1 END) AS f8,
          -- MPESPTP-509: Value not in (Y/N): CHG CLS IND (TACLCH)
          COUNT(*) AS t9,
          COUNT(CASE WHEN NVL(TRIM(s."TACLCH"), '#') NOT IN ('Y', 'N') THEN 1 END) AS f9,
          -- MPESPTP-510: Value not in (Y/N): CLS DEAL (TACLSD)
          COUNT(*) AS t10,
          COUNT(CASE WHEN NVL(TRIM(s."TACLSD"), '#') NOT IN ('Y', 'N') THEN 1 END) AS f10,
          -- MPESPTP-511: Value not in (0/1): FX RISK NETTING IND (TAFXKN)
          COUNT(*) AS t11,
          COUNT(CASE WHEN NVL(TRIM(s."TAFXKN"), '#') NOT IN ('0', '1') THEN 1 END) AS f11,
          -- MPESPTP-512: Value not in (Y/N): SKIP FLC (TASFLC)
          COUNT(*) AS t12,
          COUNT(CASE WHEN NVL(TRIM(s."TASFLC"), '#') NOT IN ('Y', 'N') THEN 1 END) AS f12,
          -- MPESPTP-513: Value not in (Y/N/κενό): SPLIT DEAL (TASPLT)
          COUNT(CASE WHEN TRIM(s."TASPLT") IS NOT NULL THEN 1 END) AS t13,
          COUNT(CASE WHEN TRIM(s."TASPLT") IS NOT NULL AND TRIM(s."TASPLT") NOT IN ('Y', 'N') THEN 1 END) AS f13
        FROM (
              SELECT t."TABKFG",
                     t."TACLCH",
                     t."TACLSD",
                     t."TADMIN",
                     t."TAEIRI",
                     t."TAFXKN",
                     t."TARSN1",
                     t."TARSN2",
                     t."TARSNS",
                     t."TASAIN",
                     t."TASFLC",
                     t."TASPIN",
                     t."TASPLT"
                FROM DATACUT5."TREATS_MPESPTP" t
        ) s
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'MPESPTP-501|Invalid Values|Value not in (E/I/R/A): EXT/INT/RET/ARB IND (TAEIRI)',
        (t2, f2) AS 'MPESPTP-502|Invalid Values|Value not in (Y/N): FREE BKRG FLG (TABKFG)',
        (t3, f3) AS 'MPESPTP-503|Invalid Values|Value not in (Y/N): SPWN IND (TASPIN)',
        (t4, f4) AS 'MPESPTP-504|Invalid Values|Value not in (Y/N): SETL ATTN IND (TASAIN)',
        (t5, f5) AS 'MPESPTP-505|Invalid Values|Value not in (Y/N): DL MEMO IND (TADMIN)',
        (t6, f6) AS 'MPESPTP-506|Invalid Values|Value not in (D/M): RATE SENSE (TARSNS)',
        (t7, f7) AS 'MPESPTP-507|Invalid Values|Value not in (D/M/κενό): RATE SENSE (TARSN1)',
        (t8, f8) AS 'MPESPTP-508|Invalid Values|Value not in (D/M/κενό): RATE SENSE (TARSN2)',
        (t9, f9) AS 'MPESPTP-509|Invalid Values|Value not in (Y/N): CHG CLS IND (TACLCH)',
        (t10, f10) AS 'MPESPTP-510|Invalid Values|Value not in (Y/N): CLS DEAL (TACLSD)',
        (t11, f11) AS 'MPESPTP-511|Invalid Values|Value not in (0/1): FX RISK NETTING IND (TAFXKN)',
        (t12, f12) AS 'MPESPTP-512|Invalid Values|Value not in (Y/N): SKIP FLC (TASFLC)',
        (t13, f13) AS 'MPESPTP-513|Invalid Values|Value not in (Y/N/κενό): SPLIT DEAL (TASPLT)'
      ))
    UNION ALL
/* =============================================================================
   MPEFWDP - Exchange Forward Deal File
   Πίνακας: DATACUT5."TREATS_MPEFWDP"   Shadow: δεν υπάρχει mode flag   Έλεγχοι: 13
   Έλεγχοι τιμών από τη στήλη Free column του DD v2.4.
   ============================================================================= */
    SELECT 'MPEFWDP - Exchange Forward Deal File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- MPEFWDP-501: Value not in (E/I/R/A): EXT/INT/RET/ARB IND (TCEIRI)
          COUNT(*) AS t1,
          COUNT(CASE WHEN NVL(TRIM(s."TCEIRI"), '#') NOT IN ('E', 'I', 'R', 'A') THEN 1 END) AS f1,
          -- MPEFWDP-502: Value not in (Y/N): FREE BKRG FLG (TCBKFG)
          COUNT(*) AS t2,
          COUNT(CASE WHEN NVL(TRIM(s."TCBKFG"), '#') NOT IN ('Y', 'N') THEN 1 END) AS f2,
          -- MPEFWDP-503: Value not in (Y/N): SPWN IND (TCSPIN)
          COUNT(*) AS t3,
          COUNT(CASE WHEN NVL(TRIM(s."TCSPIN"), '#') NOT IN ('Y', 'N') THEN 1 END) AS f3,
          -- MPEFWDP-504: Value not in (Y/N): SETL ATTN IND (TCSAIN)
          COUNT(*) AS t4,
          COUNT(CASE WHEN NVL(TRIM(s."TCSAIN"), '#') NOT IN ('Y', 'N') THEN 1 END) AS f4,
          -- MPEFWDP-505: Value not in (Y/N): DL MEMO IND (TCDMIN)
          COUNT(*) AS t5,
          COUNT(CASE WHEN NVL(TRIM(s."TCDMIN"), '#') NOT IN ('Y', 'N') THEN 1 END) AS f5,
          -- MPEFWDP-506: Value not in (D/M): RATE SENSE (TCRSNS)
          COUNT(*) AS t6,
          COUNT(CASE WHEN NVL(TRIM(s."TCRSNS"), '#') NOT IN ('D', 'M') THEN 1 END) AS f6,
          -- MPEFWDP-507: Value not in (D/M/κενό): RATE SENSE (TCRSN1)
          COUNT(CASE WHEN TRIM(s."TCRSN1") IS NOT NULL THEN 1 END) AS t7,
          COUNT(CASE WHEN TRIM(s."TCRSN1") IS NOT NULL AND TRIM(s."TCRSN1") NOT IN ('D', 'M') THEN 1 END) AS f7,
          -- MPEFWDP-508: Value not in (D/M/κενό): RATE SENSE (TCRSN2)
          COUNT(CASE WHEN TRIM(s."TCRSN2") IS NOT NULL THEN 1 END) AS t8,
          COUNT(CASE WHEN TRIM(s."TCRSN2") IS NOT NULL AND TRIM(s."TCRSN2") NOT IN ('D', 'M') THEN 1 END) AS f8,
          -- MPEFWDP-509: Value not in (Y/N): CHG CLS IND (TCCLCH)
          COUNT(*) AS t9,
          COUNT(CASE WHEN NVL(TRIM(s."TCCLCH"), '#') NOT IN ('Y', 'N') THEN 1 END) AS f9,
          -- MPEFWDP-510: Value not in (Y/N): CLS DEAL (TCCLSD)
          COUNT(*) AS t10,
          COUNT(CASE WHEN NVL(TRIM(s."TCCLSD"), '#') NOT IN ('Y', 'N') THEN 1 END) AS f10,
          -- MPEFWDP-511: Value not in (0/1): FX RISK NETTING IND (TCFXKN)
          COUNT(*) AS t11,
          COUNT(CASE WHEN NVL(TRIM(s."TCFXKN"), '#') NOT IN ('0', '1') THEN 1 END) AS f11,
          -- MPEFWDP-512: Value not in (Y/N): SKIP FLC (TCSFLC)
          COUNT(*) AS t12,
          COUNT(CASE WHEN NVL(TRIM(s."TCSFLC"), '#') NOT IN ('Y', 'N') THEN 1 END) AS f12,
          -- MPEFWDP-513: Value not in (Y/N/κενό): SPLIT DEAL (TCSPLT)
          COUNT(CASE WHEN TRIM(s."TCSPLT") IS NOT NULL THEN 1 END) AS t13,
          COUNT(CASE WHEN TRIM(s."TCSPLT") IS NOT NULL AND TRIM(s."TCSPLT") NOT IN ('Y', 'N') THEN 1 END) AS f13
        FROM (
              SELECT t."TCBKFG",
                     t."TCCLCH",
                     t."TCCLSD",
                     t."TCDMIN",
                     t."TCEIRI",
                     t."TCFXKN",
                     t."TCRSN1",
                     t."TCRSN2",
                     t."TCRSNS",
                     t."TCSAIN",
                     t."TCSFLC",
                     t."TCSPIN",
                     t."TCSPLT"
                FROM DATACUT5."TREATS_MPEFWDP" t
        ) s
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'MPEFWDP-501|Invalid Values|Value not in (E/I/R/A): EXT/INT/RET/ARB IND (TCEIRI)',
        (t2, f2) AS 'MPEFWDP-502|Invalid Values|Value not in (Y/N): FREE BKRG FLG (TCBKFG)',
        (t3, f3) AS 'MPEFWDP-503|Invalid Values|Value not in (Y/N): SPWN IND (TCSPIN)',
        (t4, f4) AS 'MPEFWDP-504|Invalid Values|Value not in (Y/N): SETL ATTN IND (TCSAIN)',
        (t5, f5) AS 'MPEFWDP-505|Invalid Values|Value not in (Y/N): DL MEMO IND (TCDMIN)',
        (t6, f6) AS 'MPEFWDP-506|Invalid Values|Value not in (D/M): RATE SENSE (TCRSNS)',
        (t7, f7) AS 'MPEFWDP-507|Invalid Values|Value not in (D/M/κενό): RATE SENSE (TCRSN1)',
        (t8, f8) AS 'MPEFWDP-508|Invalid Values|Value not in (D/M/κενό): RATE SENSE (TCRSN2)',
        (t9, f9) AS 'MPEFWDP-509|Invalid Values|Value not in (Y/N): CHG CLS IND (TCCLCH)',
        (t10, f10) AS 'MPEFWDP-510|Invalid Values|Value not in (Y/N): CLS DEAL (TCCLSD)',
        (t11, f11) AS 'MPEFWDP-511|Invalid Values|Value not in (0/1): FX RISK NETTING IND (TCFXKN)',
        (t12, f12) AS 'MPEFWDP-512|Invalid Values|Value not in (Y/N): SKIP FLC (TCSFLC)',
        (t13, f13) AS 'MPEFWDP-513|Invalid Values|Value not in (Y/N/κενό): SPLIT DEAL (TCSPLT)'
      ))
    UNION ALL
/* =============================================================================
   MPMZCPP - Money Market Non-negotiable Zero Coupon Deal Fl
   Πίνακας: DATACUT5."TREATS_MPMZCPP"   Shadow: δεν υπάρχει mode flag   Έλεγχοι: 7
   Έλεγχοι τιμών από τη στήλη Free column του DD v2.4.
   ============================================================================= */
    SELECT 'MPMZCPP - Money Market Non-negotiable Zero Coupon Deal Fl' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- MPMZCPP-501: Value not in (E/R/I/A): EXT/INT/RET/ARB IND (TGEIRI)
          COUNT(*) AS t1,
          COUNT(CASE WHEN NVL(TRIM(s."TGEIRI"), '#') NOT IN ('E', 'R', 'I', 'A') THEN 1 END) AS f1,
          -- MPMZCPP-502: Value not in (Y/N): FREE BKRG FLG (TGBKFG)
          COUNT(*) AS t2,
          COUNT(CASE WHEN NVL(TRIM(s."TGBKFG"), '#') NOT IN ('Y', 'N') THEN 1 END) AS f2,
          -- MPMZCPP-503: Value not in (B/E/H/I/J): INT CALC MTHD (TGINTC)
          COUNT(*) AS t3,
          COUNT(CASE WHEN NVL(TRIM(s."TGINTC"), '#') NOT IN ('B', 'E', 'H', 'I', 'J') THEN 1 END) AS f3,
          -- MPMZCPP-504: Value not in (Y/N): SETL ATTN IND (TGSAIN)
          COUNT(*) AS t4,
          COUNT(CASE WHEN NVL(TRIM(s."TGSAIN"), '#') NOT IN ('Y', 'N') THEN 1 END) AS f4,
          -- MPMZCPP-505: Value not in (Y/N): DL MEMO IND (TGDMIN)
          COUNT(*) AS t5,
          COUNT(CASE WHEN NVL(TRIM(s."TGDMIN"), '#') NOT IN ('Y', 'N') THEN 1 END) AS f5,
          -- MPMZCPP-506: Value not in (Y/N): SKIP FLC (TGSFLC)
          COUNT(*) AS t6,
          COUNT(CASE WHEN NVL(TRIM(s."TGSFLC"), '#') NOT IN ('Y', 'N') THEN 1 END) AS f6,
          -- MPMZCPP-507: Value not in (Y/N/κενό): SPLIT DEAL (TGSPLT)
          COUNT(CASE WHEN TRIM(s."TGSPLT") IS NOT NULL THEN 1 END) AS t7,
          COUNT(CASE WHEN TRIM(s."TGSPLT") IS NOT NULL AND TRIM(s."TGSPLT") NOT IN ('Y', 'N') THEN 1 END) AS f7
        FROM (
              SELECT t."TGBKFG",
                     t."TGDMIN",
                     t."TGEIRI",
                     t."TGINTC",
                     t."TGSAIN",
                     t."TGSFLC",
                     t."TGSPLT"
                FROM DATACUT5."TREATS_MPMZCPP" t
        ) s
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'MPMZCPP-501|Invalid Values|Value not in (E/R/I/A): EXT/INT/RET/ARB IND (TGEIRI)',
        (t2, f2) AS 'MPMZCPP-502|Invalid Values|Value not in (Y/N): FREE BKRG FLG (TGBKFG)',
        (t3, f3) AS 'MPMZCPP-503|Invalid Values|Value not in (B/E/H/I/J): INT CALC MTHD (TGINTC)',
        (t4, f4) AS 'MPMZCPP-504|Invalid Values|Value not in (Y/N): SETL ATTN IND (TGSAIN)',
        (t5, f5) AS 'MPMZCPP-505|Invalid Values|Value not in (Y/N): DL MEMO IND (TGDMIN)',
        (t6, f6) AS 'MPMZCPP-506|Invalid Values|Value not in (Y/N): SKIP FLC (TGSFLC)',
        (t7, f7) AS 'MPMZCPP-507|Invalid Values|Value not in (Y/N/κενό): SPLIT DEAL (TGSPLT)'
      ))
    UNION ALL
/* =============================================================================
   TTPDCTP - Product Control File
   Πίνακας: DATACUT5."TREATS_TTPDCTP"   Shadow: δεν υπάρχει mode flag   Έλεγχοι: 16
   Έλεγχοι τιμών από τη στήλη Free column του DD v2.4.
   ============================================================================= */
    SELECT 'TTPDCTP - Product Control File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- TTPDCTP-501: Value not in (N/F): FX IND (XGFXIN)
          COUNT(*) AS t1,
          COUNT(CASE WHEN NVL(TRIM(s."XGFXIN"), '#') NOT IN ('N', 'F') THEN 1 END) AS f1,
          -- TTPDCTP-502: Value not in (Y/N): COMP PRD IND (XGCPIN)
          COUNT(*) AS t2,
          COUNT(CASE WHEN NVL(TRIM(s."XGCPIN"), '#') NOT IN ('Y', 'N') THEN 1 END) AS f2,
          -- TTPDCTP-503: Value not in (Y/N): FUTR PRD IND (XGFPIN)
          COUNT(*) AS t3,
          COUNT(CASE WHEN NVL(TRIM(s."XGFPIN"), '#') NOT IN ('Y', 'N') THEN 1 END) AS f3,
          -- TTPDCTP-504: Value not in (N/R): ON/OFF BAL SHT IND (XGPNIN)
          COUNT(*) AS t4,
          COUNT(CASE WHEN NVL(TRIM(s."XGPNIN"), '#') NOT IN ('N', 'R') THEN 1 END) AS f4,
          -- TTPDCTP-505: Value not in (A/L/κενό): ASST/LIAB IND (XGALIN)
          COUNT(CASE WHEN TRIM(s."XGALIN") IS NOT NULL THEN 1 END) AS t5,
          COUNT(CASE WHEN TRIM(s."XGALIN") IS NOT NULL AND TRIM(s."XGALIN") NOT IN ('A', 'L') THEN 1 END) AS f5,
          -- TTPDCTP-506: Value not in (Y/N/κενό): NEGOTBL IND (XGNGIN)
          COUNT(CASE WHEN TRIM(s."XGNGIN") IS NOT NULL THEN 1 END) AS t6,
          COUNT(CASE WHEN TRIM(s."XGNGIN") IS NOT NULL AND TRIM(s."XGNGIN") NOT IN ('Y', 'N') THEN 1 END) AS f6,
          -- TTPDCTP-507: Value not in (D/R/V/κενό): FINAL PAYMNT IND (XGPYIN)
          COUNT(CASE WHEN TRIM(s."XGPYIN") IS NOT NULL THEN 1 END) AS t7,
          COUNT(CASE WHEN TRIM(s."XGPYIN") IS NOT NULL AND TRIM(s."XGPYIN") NOT IN ('D', 'R', 'V') THEN 1 END) AS f7,
          -- TTPDCTP-508: Value not in (B/E/H/I/J): INT CALC MTHD (XGINTC)
          COUNT(*) AS t8,
          COUNT(CASE WHEN NVL(TRIM(s."XGINTC"), '#') NOT IN ('B', 'E', 'H', 'I', 'J') THEN 1 END) AS f8,
          -- TTPDCTP-509: Value not in (Y/N/κενό): INT REINVST IND (XGIRNV)
          COUNT(CASE WHEN TRIM(s."XGIRNV") IS NOT NULL THEN 1 END) AS t9,
          COUNT(CASE WHEN TRIM(s."XGIRNV") IS NOT NULL AND TRIM(s."XGIRNV") NOT IN ('Y', 'N') THEN 1 END) AS f9,
          -- TTPDCTP-510: Value not in (Y/N/κενό): CONTINGENT LIABILITY (XGCLIN)
          COUNT(CASE WHEN TRIM(s."XGCLIN") IS NOT NULL THEN 1 END) AS t10,
          COUNT(CASE WHEN TRIM(s."XGCLIN") IS NOT NULL AND TRIM(s."XGCLIN") NOT IN ('Y', 'N') THEN 1 END) AS f10,
          -- TTPDCTP-511: Value not in (Y/N/κενό): HOUSE SECURITY (XGHSIN)
          COUNT(CASE WHEN TRIM(s."XGHSIN") IS NOT NULL THEN 1 END) AS t11,
          COUNT(CASE WHEN TRIM(s."XGHSIN") IS NOT NULL AND TRIM(s."XGHSIN") NOT IN ('Y', 'N') THEN 1 END) AS f11,
          -- TTPDCTP-512: Value not in (Y/N/κενό): FAC IND (XGFCIN)
          COUNT(CASE WHEN TRIM(s."XGFCIN") IS NOT NULL THEN 1 END) AS t12,
          COUNT(CASE WHEN TRIM(s."XGFCIN") IS NOT NULL AND TRIM(s."XGFCIN") NOT IN ('Y', 'N') THEN 1 END) AS f12,
          -- TTPDCTP-513: Value not in (Y/N/κενό): INDEX-LINK BOND IND (XGIDLB)
          COUNT(CASE WHEN TRIM(s."XGIDLB") IS NOT NULL THEN 1 END) AS t13,
          COUNT(CASE WHEN TRIM(s."XGIDLB") IS NOT NULL AND TRIM(s."XGIDLB") NOT IN ('Y', 'N') THEN 1 END) AS f13,
          -- TTPDCTP-514: Value not in (Y/N/κενό): FOS PRD FLG (XGFOPD)
          COUNT(CASE WHEN TRIM(s."XGFOPD") IS NOT NULL THEN 1 END) AS t14,
          COUNT(CASE WHEN TRIM(s."XGFOPD") IS NOT NULL AND TRIM(s."XGFOPD") NOT IN ('Y', 'N') THEN 1 END) AS f14,
          -- TTPDCTP-515: Value not in (Y/N/κενό): CLS FLAG (XGCLSF)
          COUNT(CASE WHEN TRIM(s."XGCLSF") IS NOT NULL THEN 1 END) AS t15,
          COUNT(CASE WHEN TRIM(s."XGCLSF") IS NOT NULL AND TRIM(s."XGCLSF") NOT IN ('Y', 'N') THEN 1 END) AS f15,
          -- TTPDCTP-516: Value not in (E/N/κενό): ET PRODUCT FLAG (XGETPD)
          COUNT(CASE WHEN TRIM(s."XGETPD") IS NOT NULL THEN 1 END) AS t16,
          COUNT(CASE WHEN TRIM(s."XGETPD") IS NOT NULL AND TRIM(s."XGETPD") NOT IN ('E', 'N') THEN 1 END) AS f16
        FROM (
              SELECT t."XGALIN",
                     t."XGCLIN",
                     t."XGCLSF",
                     t."XGCPIN",
                     t."XGETPD",
                     t."XGFCIN",
                     t."XGFOPD",
                     t."XGFPIN",
                     t."XGFXIN",
                     t."XGHSIN",
                     t."XGIDLB",
                     t."XGINTC",
                     t."XGIRNV",
                     t."XGNGIN",
                     t."XGPNIN",
                     t."XGPYIN"
                FROM DATACUT5."TREATS_TTPDCTP" t
        ) s
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'TTPDCTP-501|Invalid Values|Value not in (N/F): FX IND (XGFXIN)',
        (t2, f2) AS 'TTPDCTP-502|Invalid Values|Value not in (Y/N): COMP PRD IND (XGCPIN)',
        (t3, f3) AS 'TTPDCTP-503|Invalid Values|Value not in (Y/N): FUTR PRD IND (XGFPIN)',
        (t4, f4) AS 'TTPDCTP-504|Invalid Values|Value not in (N/R): ON/OFF BAL SHT IND (XGPNIN)',
        (t5, f5) AS 'TTPDCTP-505|Invalid Values|Value not in (A/L/κενό): ASST/LIAB IND (XGALIN)',
        (t6, f6) AS 'TTPDCTP-506|Invalid Values|Value not in (Y/N/κενό): NEGOTBL IND (XGNGIN)',
        (t7, f7) AS 'TTPDCTP-507|Invalid Values|Value not in (D/R/V/κενό): FINAL PAYMNT IND (XGPYIN)',
        (t8, f8) AS 'TTPDCTP-508|Invalid Values|Value not in (B/E/H/I/J): INT CALC MTHD (XGINTC)',
        (t9, f9) AS 'TTPDCTP-509|Invalid Values|Value not in (Y/N/κενό): INT REINVST IND (XGIRNV)',
        (t10, f10) AS 'TTPDCTP-510|Invalid Values|Value not in (Y/N/κενό): CONTINGENT LIABILITY (XGCLIN)',
        (t11, f11) AS 'TTPDCTP-511|Invalid Values|Value not in (Y/N/κενό): HOUSE SECURITY (XGHSIN)',
        (t12, f12) AS 'TTPDCTP-512|Invalid Values|Value not in (Y/N/κενό): FAC IND (XGFCIN)',
        (t13, f13) AS 'TTPDCTP-513|Invalid Values|Value not in (Y/N/κενό): INDEX-LINK BOND IND (XGIDLB)',
        (t14, f14) AS 'TTPDCTP-514|Invalid Values|Value not in (Y/N/κενό): FOS PRD FLG (XGFOPD)',
        (t15, f15) AS 'TTPDCTP-515|Invalid Values|Value not in (Y/N/κενό): CLS FLAG (XGCLSF)',
        (t16, f16) AS 'TTPDCTP-516|Invalid Values|Value not in (E/N/κενό): ET PRODUCT FLAG (XGETPD)'
      ))
    UNION ALL
/* =============================================================================
   MPMMCPP - MMK Non-negotiable Multi-Coupon Deal Master
   Πίνακας: DATACUT5."TREATS_MPMMCPP"   Shadow: δεν υπάρχει mode flag   Έλεγχοι: 6
   Έλεγχοι τιμών από τη στήλη Free column του DD v2.4.
   ============================================================================= */
    SELECT 'MPMMCPP - MMK Non-negotiable Multi-Coupon Deal Master' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- MPMMCPP-501: Value not in (E/I/R/A): EXT/INT/RET/ARB IND (T9EIRI)
          COUNT(*) AS t1,
          COUNT(CASE WHEN NVL(TRIM(s."T9EIRI"), '#') NOT IN ('E', 'I', 'R', 'A') THEN 1 END) AS f1,
          -- MPMMCPP-502: Value not in (Y/N): FREE BKRG FLG (T9BKFG)
          COUNT(*) AS t2,
          COUNT(CASE WHEN NVL(TRIM(s."T9BKFG"), '#') NOT IN ('Y', 'N') THEN 1 END) AS f2,
          -- MPMMCPP-503: Value not in (B/E/H/I/J): INT CALC MTHD (T9INTC)
          COUNT(*) AS t3,
          COUNT(CASE WHEN NVL(TRIM(s."T9INTC"), '#') NOT IN ('B', 'E', 'H', 'I', 'J') THEN 1 END) AS f3,
          -- MPMMCPP-504: Value not in (Y/N): DL MEMO IND (T9DMIN)
          COUNT(*) AS t4,
          COUNT(CASE WHEN NVL(TRIM(s."T9DMIN"), '#') NOT IN ('Y', 'N') THEN 1 END) AS f4,
          -- MPMMCPP-505: Value not in (Y/N): SETL ATTN IND (T9SAIN)
          COUNT(*) AS t5,
          COUNT(CASE WHEN NVL(TRIM(s."T9SAIN"), '#') NOT IN ('Y', 'N') THEN 1 END) AS f5,
          -- MPMMCPP-506: Value not in (Y/N): SKIP FLC (T9SFLC)
          COUNT(*) AS t6,
          COUNT(CASE WHEN NVL(TRIM(s."T9SFLC"), '#') NOT IN ('Y', 'N') THEN 1 END) AS f6
        FROM (
              SELECT t."T9BKFG",
                     t."T9DMIN",
                     t."T9EIRI",
                     t."T9INTC",
                     t."T9SAIN",
                     t."T9SFLC"
                FROM DATACUT5."TREATS_MPMMCPP" t
        ) s
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'MPMMCPP-501|Invalid Values|Value not in (E/I/R/A): EXT/INT/RET/ARB IND (T9EIRI)',
        (t2, f2) AS 'MPMMCPP-502|Invalid Values|Value not in (Y/N): FREE BKRG FLG (T9BKFG)',
        (t3, f3) AS 'MPMMCPP-503|Invalid Values|Value not in (B/E/H/I/J): INT CALC MTHD (T9INTC)',
        (t4, f4) AS 'MPMMCPP-504|Invalid Values|Value not in (Y/N): DL MEMO IND (T9DMIN)',
        (t5, f5) AS 'MPMMCPP-505|Invalid Values|Value not in (Y/N): SETL ATTN IND (T9SAIN)',
        (t6, f6) AS 'MPMMCPP-506|Invalid Values|Value not in (Y/N): SKIP FLC (T9SFLC)'
      ))
    UNION ALL
/* =============================================================================
   MPMSWPP - Money Market Swap Deal Master File
   Πίνακας: DATACUT5."TREATS_MPMSWPP"   Shadow: δεν υπάρχει mode flag   Έλεγχοι: 5
   Έλεγχοι τιμών από τη στήλη Free column του DD v2.4.
   ============================================================================= */
    SELECT 'MPMSWPP - Money Market Swap Deal Master File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- MPMSWPP-501: Value not in (E/I/R/A): Ext/Int/Retail/Arbitrage Indicator (T7EIRI)
          COUNT(*) AS t1,
          COUNT(CASE WHEN NVL(TRIM(s."T7EIRI"), '#') NOT IN ('E', 'I', 'R', 'A') THEN 1 END) AS f1,
          -- MPMSWPP-502: Value not in (Y/N): Free Brokerage Flag (T7BKFG)
          COUNT(*) AS t2,
          COUNT(CASE WHEN NVL(TRIM(s."T7BKFG"), '#') NOT IN ('Y', 'N') THEN 1 END) AS f2,
          -- MPMSWPP-503: Value not in (Y/N): Deal Memo Indicator (T7DMIN)
          COUNT(*) AS t3,
          COUNT(CASE WHEN NVL(TRIM(s."T7DMIN"), '#') NOT IN ('Y', 'N') THEN 1 END) AS f3,
          -- MPMSWPP-504: Value not in (Y/N): Settlement Attention Indicator (T7SAIN)
          COUNT(*) AS t4,
          COUNT(CASE WHEN NVL(TRIM(s."T7SAIN"), '#') NOT IN ('Y', 'N') THEN 1 END) AS f4,
          -- MPMSWPP-505: Value not in (Y/N): Skip First Level Check? (Y/N) (T7SFLC)
          COUNT(*) AS t5,
          COUNT(CASE WHEN NVL(TRIM(s."T7SFLC"), '#') NOT IN ('Y', 'N') THEN 1 END) AS f5
        FROM (
              SELECT t."T7BKFG",
                     t."T7DMIN",
                     t."T7EIRI",
                     t."T7SAIN",
                     t."T7SFLC"
                FROM DATACUT5."TREATS_MPMSWPP" t
        ) s
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'MPMSWPP-501|Invalid Values|Value not in (E/I/R/A): Ext/Int/Retail/Arbitrage Indicator (T7EIRI)',
        (t2, f2) AS 'MPMSWPP-502|Invalid Values|Value not in (Y/N): Free Brokerage Flag (T7BKFG)',
        (t3, f3) AS 'MPMSWPP-503|Invalid Values|Value not in (Y/N): Deal Memo Indicator (T7DMIN)',
        (t4, f4) AS 'MPMSWPP-504|Invalid Values|Value not in (Y/N): Settlement Attention Indicator (T7SAIN)',
        (t5, f5) AS 'MPMSWPP-505|Invalid Values|Value not in (Y/N): Skip First Level Check? (Y/N) (T7SFLC)'
      ))
    UNION ALL
/* =============================================================================
   TTCPADP - Counterparty Addresses File
   Πίνακας: DATACUT5."TREATS_TTCPADP"   Shadow: δεν υπάρχει mode flag   Έλεγχοι: 16
   Έλεγχοι τιμών από τη στήλη Free column του DD v2.4.
   Στο DD ο πίνακας λέγεται "TEUTTSFP  TTCPADP"· στη βάση (όπως στο DC4) TREATS_TTCPADP.
   ============================================================================= */
    SELECT 'TTCPADP - Counterparty Addresses File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- TTCPADP-501: Value not in (A/N): Counterparty Name And Address Line 1 Type (X6NAT1)
          COUNT(*) AS t1,
          COUNT(CASE WHEN NVL(TRIM(s."X6NAT1"), '#') NOT IN ('A', 'N') THEN 1 END) AS f1,
          -- TTCPADP-502: Value not in (A/N): Counterparty Name And Address Line 2 Type (X6NAT2)
          COUNT(*) AS t2,
          COUNT(CASE WHEN NVL(TRIM(s."X6NAT2"), '#') NOT IN ('A', 'N') THEN 1 END) AS f2,
          -- TTCPADP-503: Value not in (A/N): Counterparty Name And Address Line 3 Type (X6NAT3)
          COUNT(*) AS t3,
          COUNT(CASE WHEN NVL(TRIM(s."X6NAT3"), '#') NOT IN ('A', 'N') THEN 1 END) AS f3,
          -- TTCPADP-504: Value not in (A/N): Counterparty Name And Address Line 4 Type (X6NAT4)
          COUNT(*) AS t4,
          COUNT(CASE WHEN NVL(TRIM(s."X6NAT4"), '#') NOT IN ('A', 'N') THEN 1 END) AS f4,
          -- TTCPADP-505: Value not in (A/N): Counterparty Name And Address Line 5 Type (X6NAT5)
          COUNT(*) AS t5,
          COUNT(CASE WHEN NVL(TRIM(s."X6NAT5"), '#') NOT IN ('A', 'N') THEN 1 END) AS f5,
          -- TTCPADP-506: Value not in (A/N): Counterparty Name And Address Line 6 Type (X6NAT6)
          COUNT(*) AS t6,
          COUNT(CASE WHEN NVL(TRIM(s."X6NAT6"), '#') NOT IN ('A', 'N') THEN 1 END) AS f6,
          -- TTCPADP-507: Value not in (A/N/Y/1): Confirmation Sent Indicator (X6CFSI)
          COUNT(*) AS t7,
          COUNT(CASE WHEN NVL(TRIM(s."X6CFSI"), '#') NOT IN ('A', 'N', 'Y', '1') THEN 1 END) AS f7,
          -- TTCPADP-508: Value not in (Y/N): OVRRIDE. INDICATOR. (X6OVIN)
          COUNT(*) AS t8,
          COUNT(CASE WHEN NVL(TRIM(s."X6OVIN"), '#') NOT IN ('Y', 'N') THEN 1 END) AS f8,
          -- TTCPADP-509: Value not in (L): MAINT. BY (X6MTBY)
          COUNT(*) AS t9,
          COUNT(CASE WHEN NVL(TRIM(s."X6MTBY"), '#') NOT IN ('L') THEN 1 END) AS f9,
          -- TTCPADP-510: Value not in (R): Status code 1 (X6STS1)
          COUNT(*) AS t10,
          COUNT(CASE WHEN NVL(TRIM(s."X6STS1"), '#') NOT IN ('R') THEN 1 END) AS f10,
          -- TTCPADP-511: Value not in (R): Status code 2 (X6STS2)
          COUNT(*) AS t11,
          COUNT(CASE WHEN NVL(TRIM(s."X6STS2"), '#') NOT IN ('R') THEN 1 END) AS f11,
          -- TTCPADP-512: Value not in (R): Status code 3 (X6STS3)
          COUNT(*) AS t12,
          COUNT(CASE WHEN NVL(TRIM(s."X6STS3"), '#') NOT IN ('R') THEN 1 END) AS f12,
          -- TTCPADP-513: Value not in (R): Status code 4 (X6STS4)
          COUNT(*) AS t13,
          COUNT(CASE WHEN NVL(TRIM(s."X6STS4"), '#') NOT IN ('R') THEN 1 END) AS f13,
          -- TTCPADP-514: Value not in (R): Status code 5 (X6STS5)
          COUNT(*) AS t14,
          COUNT(CASE WHEN NVL(TRIM(s."X6STS5"), '#') NOT IN ('R') THEN 1 END) AS f14,
          -- TTCPADP-515: Value not in (Y/N): Suppress Letter Printout (X6SUPL)
          COUNT(*) AS t15,
          COUNT(CASE WHEN NVL(TRIM(s."X6SUPL"), '#') NOT IN ('Y', 'N') THEN 1 END) AS f15,
          -- TTCPADP-516: Value not in (Y/N): Suppress Tracer Flag (X6SUPT)
          COUNT(*) AS t16,
          COUNT(CASE WHEN NVL(TRIM(s."X6SUPT"), '#') NOT IN ('Y', 'N') THEN 1 END) AS f16
        FROM (
              SELECT t."X6CFSI",
                     t."X6MTBY",
                     t."X6NAT1",
                     t."X6NAT2",
                     t."X6NAT3",
                     t."X6NAT4",
                     t."X6NAT5",
                     t."X6NAT6",
                     t."X6OVIN",
                     t."X6STS1",
                     t."X6STS2",
                     t."X6STS3",
                     t."X6STS4",
                     t."X6STS5",
                     t."X6SUPL",
                     t."X6SUPT"
                FROM DATACUT5."TREATS_TTCPADP" t
        ) s
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'TTCPADP-501|Invalid Values|Value not in (A/N): Counterparty Name And Address Line 1 Type (X6NAT1)',
        (t2, f2) AS 'TTCPADP-502|Invalid Values|Value not in (A/N): Counterparty Name And Address Line 2 Type (X6NAT2)',
        (t3, f3) AS 'TTCPADP-503|Invalid Values|Value not in (A/N): Counterparty Name And Address Line 3 Type (X6NAT3)',
        (t4, f4) AS 'TTCPADP-504|Invalid Values|Value not in (A/N): Counterparty Name And Address Line 4 Type (X6NAT4)',
        (t5, f5) AS 'TTCPADP-505|Invalid Values|Value not in (A/N): Counterparty Name And Address Line 5 Type (X6NAT5)',
        (t6, f6) AS 'TTCPADP-506|Invalid Values|Value not in (A/N): Counterparty Name And Address Line 6 Type (X6NAT6)',
        (t7, f7) AS 'TTCPADP-507|Invalid Values|Value not in (A/N/Y/1): Confirmation Sent Indicator (X6CFSI)',
        (t8, f8) AS 'TTCPADP-508|Invalid Values|Value not in (Y/N): OVRRIDE. INDICATOR. (X6OVIN)',
        (t9, f9) AS 'TTCPADP-509|Invalid Values|Value not in (L): MAINT. BY (X6MTBY)',
        (t10, f10) AS 'TTCPADP-510|Invalid Values|Value not in (R): Status code 1 (X6STS1)',
        (t11, f11) AS 'TTCPADP-511|Invalid Values|Value not in (R): Status code 2 (X6STS2)',
        (t12, f12) AS 'TTCPADP-512|Invalid Values|Value not in (R): Status code 3 (X6STS3)',
        (t13, f13) AS 'TTCPADP-513|Invalid Values|Value not in (R): Status code 4 (X6STS4)',
        (t14, f14) AS 'TTCPADP-514|Invalid Values|Value not in (R): Status code 5 (X6STS5)',
        (t15, f15) AS 'TTCPADP-515|Invalid Values|Value not in (Y/N): Suppress Letter Printout (X6SUPL)',
        (t16, f16) AS 'TTCPADP-516|Invalid Values|Value not in (Y/N): Suppress Tracer Flag (X6SUPT)'
      ))
    UNION ALL
/* =============================================================================
   MPMNMCP - Money Market MCNI Deal Master File
   Πίνακας: DATACUT5."TREATS_MPMNMCP"   Shadow: δεν υπάρχει mode flag   Έλεγχοι: 12
   Έλεγχοι τιμών από τη στήλη Free column του DD v2.4.
   ============================================================================= */
    SELECT 'MPMNMCP - Money Market MCNI Deal Master File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- MPMNMCP-501: Value not in (E/I/R/A): EXT/INT/RET/ARB IND (TYEIRI)
          COUNT(*) AS t1,
          COUNT(CASE WHEN NVL(TRIM(s."TYEIRI"), '#') NOT IN ('E', 'I', 'R', 'A') THEN 1 END) AS f1,
          -- MPMNMCP-502: Value not in (Y/N/κενό): FREE BKRG FLG (TYBKFG)
          COUNT(CASE WHEN TRIM(s."TYBKFG") IS NOT NULL THEN 1 END) AS t2,
          COUNT(CASE WHEN TRIM(s."TYBKFG") IS NOT NULL AND TRIM(s."TYBKFG") NOT IN ('Y', 'N') THEN 1 END) AS f2,
          -- MPMNMCP-503: Value not in (A/B/C/D/E/F/H/I/J): INT CALC MTHD (TYINTC)
          COUNT(*) AS t3,
          COUNT(CASE WHEN NVL(TRIM(s."TYINTC"), '#') NOT IN ('A', 'B', 'C', 'D', 'E', 'F', 'H', 'I', 'J') THEN 1 END) AS f3,
          -- MPMNMCP-504: Value not in (H/T): HDG/TRD IND (TYHTIN)
          COUNT(*) AS t4,
          COUNT(CASE WHEN NVL(TRIM(s."TYHTIN"), '#') NOT IN ('H', 'T') THEN 1 END) AS f4,
          -- MPMNMCP-505: Value not in (Y/N/κενό): EX-DIVIDEND TRADING FLAG (TYEXTF)
          COUNT(CASE WHEN TRIM(s."TYEXTF") IS NOT NULL THEN 1 END) AS t5,
          COUNT(CASE WHEN TRIM(s."TYEXTF") IS NOT NULL AND TRIM(s."TYEXTF") NOT IN ('Y', 'N') THEN 1 END) AS f5,
          -- MPMNMCP-506: Value not in (Y/N/κενό): SETTLE RISK IND (TYSERK)
          COUNT(CASE WHEN TRIM(s."TYSERK") IS NOT NULL THEN 1 END) AS t6,
          COUNT(CASE WHEN TRIM(s."TYSERK") IS NOT NULL AND TRIM(s."TYSERK") NOT IN ('Y', 'N') THEN 1 END) AS f6,
          -- MPMNMCP-507: Value not in (Y/N/κενό): SETL ATTN IND (TYSAIN)
          COUNT(CASE WHEN TRIM(s."TYSAIN") IS NOT NULL THEN 1 END) AS t7,
          COUNT(CASE WHEN TRIM(s."TYSAIN") IS NOT NULL AND TRIM(s."TYSAIN") NOT IN ('Y', 'N') THEN 1 END) AS f7,
          -- MPMNMCP-508: Value not in (Y/N/κενό): AST SWP BND IND (TYASWB)
          COUNT(CASE WHEN TRIM(s."TYASWB") IS NOT NULL THEN 1 END) AS t8,
          COUNT(CASE WHEN TRIM(s."TYASWB") IS NOT NULL AND TRIM(s."TYASWB") NOT IN ('Y', 'N') THEN 1 END) AS f8,
          -- MPMNMCP-509: Value not in (Y/N/κενό): DL MEMO IND (TYDMIN)
          COUNT(CASE WHEN TRIM(s."TYDMIN") IS NOT NULL THEN 1 END) AS t9,
          COUNT(CASE WHEN TRIM(s."TYDMIN") IS NOT NULL AND TRIM(s."TYDMIN") NOT IN ('Y', 'N') THEN 1 END) AS f9,
          -- MPMNMCP-510: Value not in (Y/N/κενό): SKIP FLC (TYSFLC)
          COUNT(CASE WHEN TRIM(s."TYSFLC") IS NOT NULL THEN 1 END) AS t10,
          COUNT(CASE WHEN TRIM(s."TYSFLC") IS NOT NULL AND TRIM(s."TYSFLC") NOT IN ('Y', 'N') THEN 1 END) AS f10,
          -- MPMNMCP-511: Value not in (E/S): RATE TYP (TYRRTP)
          COUNT(*) AS t11,
          COUNT(CASE WHEN NVL(TRIM(s."TYRRTP"), '#') NOT IN ('E', 'S') THEN 1 END) AS f11,
          -- MPMNMCP-512: Value not in (Y/N/κενό): INVERT RATE (TYINVT)
          COUNT(CASE WHEN TRIM(s."TYINVT") IS NOT NULL THEN 1 END) AS t12,
          COUNT(CASE WHEN TRIM(s."TYINVT") IS NOT NULL AND TRIM(s."TYINVT") NOT IN ('Y', 'N') THEN 1 END) AS f12
        FROM (
              SELECT t."TYASWB",
                     t."TYBKFG",
                     t."TYDMIN",
                     t."TYEIRI",
                     t."TYEXTF",
                     t."TYHTIN",
                     t."TYINTC",
                     t."TYINVT",
                     t."TYRRTP",
                     t."TYSAIN",
                     t."TYSERK",
                     t."TYSFLC"
                FROM DATACUT5."TREATS_MPMNMCP" t
        ) s
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'MPMNMCP-501|Invalid Values|Value not in (E/I/R/A): EXT/INT/RET/ARB IND (TYEIRI)',
        (t2, f2) AS 'MPMNMCP-502|Invalid Values|Value not in (Y/N/κενό): FREE BKRG FLG (TYBKFG)',
        (t3, f3) AS 'MPMNMCP-503|Invalid Values|Value not in (A/B/C/D/E/F/H/I/J): INT CALC MTHD (TYINTC)',
        (t4, f4) AS 'MPMNMCP-504|Invalid Values|Value not in (H/T): HDG/TRD IND (TYHTIN)',
        (t5, f5) AS 'MPMNMCP-505|Invalid Values|Value not in (Y/N/κενό): EX-DIVIDEND TRADING FLAG (TYEXTF)',
        (t6, f6) AS 'MPMNMCP-506|Invalid Values|Value not in (Y/N/κενό): SETTLE RISK IND (TYSERK)',
        (t7, f7) AS 'MPMNMCP-507|Invalid Values|Value not in (Y/N/κενό): SETL ATTN IND (TYSAIN)',
        (t8, f8) AS 'MPMNMCP-508|Invalid Values|Value not in (Y/N/κενό): AST SWP BND IND (TYASWB)',
        (t9, f9) AS 'MPMNMCP-509|Invalid Values|Value not in (Y/N/κενό): DL MEMO IND (TYDMIN)',
        (t10, f10) AS 'MPMNMCP-510|Invalid Values|Value not in (Y/N/κενό): SKIP FLC (TYSFLC)',
        (t11, f11) AS 'MPMNMCP-511|Invalid Values|Value not in (E/S): RATE TYP (TYRRTP)',
        (t12, f12) AS 'MPMNMCP-512|Invalid Values|Value not in (Y/N/κενό): INVERT RATE (TYINVT)'
      ))
    UNION ALL
/* =============================================================================
   ISNMMSP - Inventory Stock MCNI Security Master File
   Πίνακας: DATACUT5."TREATS_ISNMMSP"   Shadow: δεν υπάρχει mode flag   Έλεγχοι: 17
   Έλεγχοι τιμών από τη στήλη Free column του DD v2.4.
   ============================================================================= */
    SELECT 'ISNMMSP - Inventory Stock MCNI Security Master File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- ISNMMSP-501: Value not in (A/I/M/Q/S): COUPON PERIODICITY (RDCPFQ)
          COUNT(*) AS t1,
          COUNT(CASE WHEN NVL(TRIM(s."RDCPFQ"), '#') NOT IN ('A', 'I', 'M', 'Q', 'S') THEN 1 END) AS f1,
          -- ISNMMSP-502: Value not in (A/B/C/D/E/F/H/I/J): INT CALC MTHD (RDINTC)
          COUNT(*) AS t2,
          COUNT(CASE WHEN NVL(TRIM(s."RDINTC"), '#') NOT IN ('A', 'B', 'C', 'D', 'E', 'F', 'H', 'I', 'J') THEN 1 END) AS f2,
          -- ISNMMSP-503: Value not in (Y/N/κενό): PARTLY PAID IND (RDPPIN)
          COUNT(CASE WHEN TRIM(s."RDPPIN") IS NOT NULL THEN 1 END) AS t3,
          COUNT(CASE WHEN TRIM(s."RDPPIN") IS NOT NULL AND TRIM(s."RDPPIN") NOT IN ('Y', 'N') THEN 1 END) AS f3,
          -- ISNMMSP-504: Value not in (Y/N/κενό): BRK PRD IND (RDBKIN)
          COUNT(CASE WHEN TRIM(s."RDBKIN") IS NOT NULL THEN 1 END) AS t4,
          COUNT(CASE WHEN TRIM(s."RDBKIN") IS NOT NULL AND TRIM(s."RDBKIN") NOT IN ('Y', 'N') THEN 1 END) AS f4,
          -- ISNMMSP-505: Value not in (D/A): DOR/ ACT IND (RDDAIN)
          COUNT(*) AS t5,
          COUNT(CASE WHEN NVL(TRIM(s."RDDAIN"), '#') NOT IN ('D', 'A') THEN 1 END) AS f5,
          -- ISNMMSP-506: Value not in (Y/N/κενό): EVEN COUP FLAG (RDECPN)
          COUNT(CASE WHEN TRIM(s."RDECPN") IS NOT NULL THEN 1 END) AS t6,
          COUNT(CASE WHEN TRIM(s."RDECPN") IS NOT NULL AND TRIM(s."RDECPN") NOT IN ('Y', 'N') THEN 1 END) AS f6,
          -- ISNMMSP-507: Value not in (C/S): YLD PRC CAL FLAG (RDYPCF)
          COUNT(*) AS t7,
          COUNT(CASE WHEN NVL(TRIM(s."RDYPCF"), '#') NOT IN ('C', 'S') THEN 1 END) AS f7,
          -- ISNMMSP-508: Value not in (Y/N/κενό): RE-INV COUPON (RDRICP)
          COUNT(CASE WHEN TRIM(s."RDRICP") IS NOT NULL THEN 1 END) AS t8,
          COUNT(CASE WHEN TRIM(s."RDRICP") IS NOT NULL AND TRIM(s."RDRICP") NOT IN ('Y', 'N') THEN 1 END) AS f8,
          -- ISNMMSP-509: Value not in (Y/N/κενό): CMP ACR (RDCMPA)
          COUNT(CASE WHEN TRIM(s."RDCMPA") IS NOT NULL THEN 1 END) AS t9,
          COUNT(CASE WHEN TRIM(s."RDCMPA") IS NOT NULL AND TRIM(s."RDCMPA") NOT IN ('Y', 'N') THEN 1 END) AS f9,
          -- ISNMMSP-510: Value not in (Y/N/κενό): ESTIMATED COUPON RATE (RDECPR)
          COUNT(CASE WHEN TRIM(s."RDECPR") IS NOT NULL THEN 1 END) AS t10,
          COUNT(CASE WHEN TRIM(s."RDECPR") IS NOT NULL AND TRIM(s."RDECPR") NOT IN ('Y', 'N') THEN 1 END) AS f10,
          -- ISNMMSP-511: Value not in (Y/N/κενό): DISCOUNTABILITY INDICATOR (RDDSCI)
          COUNT(CASE WHEN TRIM(s."RDDSCI") IS NOT NULL THEN 1 END) AS t11,
          COUNT(CASE WHEN TRIM(s."RDDSCI") IS NOT NULL AND TRIM(s."RDDSCI") NOT IN ('Y', 'N') THEN 1 END) AS f11,
          -- ISNMMSP-512: Value not in (A/M): PRICE CAP IND (RDPCAP)
          COUNT(*) AS t12,
          COUNT(CASE WHEN NVL(TRIM(s."RDPCAP"), '#') NOT IN ('A', 'M') THEN 1 END) AS f12,
          -- ISNMMSP-513: Value not in (Y/B/C/D/S/F/P): RVMD (RDRVMD)
          COUNT(*) AS t13,
          COUNT(CASE WHEN NVL(TRIM(s."RDRVMD"), '#') NOT IN ('Y', 'B', 'C', 'D', 'S', 'F', 'P') THEN 1 END) AS f13,
          -- ISNMMSP-514: Value not in (Y/N/κενό): COMPOUNDING COUPON (RDCMPC)
          COUNT(CASE WHEN TRIM(s."RDCMPC") IS NOT NULL THEN 1 END) AS t14,
          COUNT(CASE WHEN TRIM(s."RDCMPC") IS NOT NULL AND TRIM(s."RDCMPC") NOT IN ('Y', 'N') THEN 1 END) AS f14,
          -- ISNMMSP-515: Value not in (Y/N/κενό): REDEMPTION FLAG (RDREDM)
          COUNT(CASE WHEN TRIM(s."RDREDM") IS NOT NULL THEN 1 END) AS t15,
          COUNT(CASE WHEN TRIM(s."RDREDM") IS NOT NULL AND TRIM(s."RDREDM") NOT IN ('Y', 'N') THEN 1 END) AS f15,
          -- ISNMMSP-516: Value not in (Y/N/κενό): ELI IND (RDELII)
          COUNT(CASE WHEN TRIM(s."RDELII") IS NOT NULL THEN 1 END) AS t16,
          COUNT(CASE WHEN TRIM(s."RDELII") IS NOT NULL AND TRIM(s."RDELII") NOT IN ('Y', 'N') THEN 1 END) AS f16,
          -- ISNMMSP-517: Value not in (Y/N/κενό): EFF PRICE IND (RDEFPR)
          COUNT(CASE WHEN TRIM(s."RDEFPR") IS NOT NULL THEN 1 END) AS t17,
          COUNT(CASE WHEN TRIM(s."RDEFPR") IS NOT NULL AND TRIM(s."RDEFPR") NOT IN ('Y', 'N') THEN 1 END) AS f17
        FROM (
              SELECT t."RDBKIN",
                     t."RDCMPA",
                     t."RDCMPC",
                     t."RDCPFQ",
                     t."RDDAIN",
                     t."RDDSCI",
                     t."RDECPN",
                     t."RDECPR",
                     t."RDEFPR",
                     t."RDELII",
                     t."RDINTC",
                     t."RDPCAP",
                     t."RDPPIN",
                     t."RDREDM",
                     t."RDRICP",
                     t."RDRVMD",
                     t."RDYPCF"
                FROM DATACUT5."TREATS_ISNMMSP" t
        ) s
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'ISNMMSP-501|Invalid Values|Value not in (A/I/M/Q/S): COUPON PERIODICITY (RDCPFQ)',
        (t2, f2) AS 'ISNMMSP-502|Invalid Values|Value not in (A/B/C/D/E/F/H/I/J): INT CALC MTHD (RDINTC)',
        (t3, f3) AS 'ISNMMSP-503|Invalid Values|Value not in (Y/N/κενό): PARTLY PAID IND (RDPPIN)',
        (t4, f4) AS 'ISNMMSP-504|Invalid Values|Value not in (Y/N/κενό): BRK PRD IND (RDBKIN)',
        (t5, f5) AS 'ISNMMSP-505|Invalid Values|Value not in (D/A): DOR/ ACT IND (RDDAIN)',
        (t6, f6) AS 'ISNMMSP-506|Invalid Values|Value not in (Y/N/κενό): EVEN COUP FLAG (RDECPN)',
        (t7, f7) AS 'ISNMMSP-507|Invalid Values|Value not in (C/S): YLD PRC CAL FLAG (RDYPCF)',
        (t8, f8) AS 'ISNMMSP-508|Invalid Values|Value not in (Y/N/κενό): RE-INV COUPON (RDRICP)',
        (t9, f9) AS 'ISNMMSP-509|Invalid Values|Value not in (Y/N/κενό): CMP ACR (RDCMPA)',
        (t10, f10) AS 'ISNMMSP-510|Invalid Values|Value not in (Y/N/κενό): ESTIMATED COUPON RATE (RDECPR)',
        (t11, f11) AS 'ISNMMSP-511|Invalid Values|Value not in (Y/N/κενό): DISCOUNTABILITY INDICATOR (RDDSCI)',
        (t12, f12) AS 'ISNMMSP-512|Invalid Values|Value not in (A/M): PRICE CAP IND (RDPCAP)',
        (t13, f13) AS 'ISNMMSP-513|Invalid Values|Value not in (Y/B/C/D/S/F/P): RVMD (RDRVMD)',
        (t14, f14) AS 'ISNMMSP-514|Invalid Values|Value not in (Y/N/κενό): COMPOUNDING COUPON (RDCMPC)',
        (t15, f15) AS 'ISNMMSP-515|Invalid Values|Value not in (Y/N/κενό): REDEMPTION FLAG (RDREDM)',
        (t16, f16) AS 'ISNMMSP-516|Invalid Values|Value not in (Y/N/κενό): ELI IND (RDELII)',
        (t17, f17) AS 'ISNMMSP-517|Invalid Values|Value not in (Y/N/κενό): EFF PRICE IND (RDEFPR)'
      ))
    UNION ALL
/* =============================================================================
   MMNMLNP - Money Market MCNI Security Line File
   Πίνακας: DATACUT5."TREATS_MMNMLNP"   Shadow: δεν υπάρχει mode flag   Έλεγχοι: 6
   Έλεγχοι τιμών από τη στήλη Free column του DD v2.4.
   ============================================================================= */
    SELECT 'MMNMLNP - Money Market MCNI Security Line File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- MMNMLNP-501: Value not in (A/L/κενό): ASST/LIAB IND (FYALIN)
          COUNT(CASE WHEN TRIM(s."FYALIN") IS NOT NULL THEN 1 END) AS t1,
          COUNT(CASE WHEN TRIM(s."FYALIN") IS NOT NULL AND TRIM(s."FYALIN") NOT IN ('A', 'L') THEN 1 END) AS f1,
          -- MMNMLNP-502: Value not in (N/R): ON/OFF BAL SHT IND (FYPNIN)
          COUNT(*) AS t2,
          COUNT(CASE WHEN NVL(TRIM(s."FYPNIN"), '#') NOT IN ('N', 'R') THEN 1 END) AS f2,
          -- MMNMLNP-503: Value not in (H/T): HDG/TRD IND (FYHTIN)
          COUNT(*) AS t3,
          COUNT(CASE WHEN NVL(TRIM(s."FYHTIN"), '#') NOT IN ('H', 'T') THEN 1 END) AS f3,
          -- MMNMLNP-504: Value not in (D/A): DOR/ ACT IND (FYDAIN)
          COUNT(*) AS t4,
          COUNT(CASE WHEN NVL(TRIM(s."FYDAIN"), '#') NOT IN ('D', 'A') THEN 1 END) AS f4,
          -- MMNMLNP-505: Value not in (Y/N/κενό): CANCL FLG (FYCNFG)
          COUNT(CASE WHEN TRIM(s."FYCNFG") IS NOT NULL THEN 1 END) AS t5,
          COUNT(CASE WHEN TRIM(s."FYCNFG") IS NOT NULL AND TRIM(s."FYCNFG") NOT IN ('Y', 'N') THEN 1 END) AS f5,
          -- MMNMLNP-506: Value not in (A/B/C/D/E/F/H/I/J): INT CALC MTHD (FYINTC)
          COUNT(*) AS t6,
          COUNT(CASE WHEN NVL(TRIM(s."FYINTC"), '#') NOT IN ('A', 'B', 'C', 'D', 'E', 'F', 'H', 'I', 'J') THEN 1 END) AS f6
        FROM (
              SELECT t."FYALIN",
                     t."FYCNFG",
                     t."FYDAIN",
                     t."FYHTIN",
                     t."FYINTC",
                     t."FYPNIN"
                FROM DATACUT5."TREATS_MMNMLNP" t
        ) s
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'MMNMLNP-501|Invalid Values|Value not in (A/L/κενό): ASST/LIAB IND (FYALIN)',
        (t2, f2) AS 'MMNMLNP-502|Invalid Values|Value not in (N/R): ON/OFF BAL SHT IND (FYPNIN)',
        (t3, f3) AS 'MMNMLNP-503|Invalid Values|Value not in (H/T): HDG/TRD IND (FYHTIN)',
        (t4, f4) AS 'MMNMLNP-504|Invalid Values|Value not in (D/A): DOR/ ACT IND (FYDAIN)',
        (t5, f5) AS 'MMNMLNP-505|Invalid Values|Value not in (Y/N/κενό): CANCL FLG (FYCNFG)',
        (t6, f6) AS 'MMNMLNP-506|Invalid Values|Value not in (A/B/C/D/E/F/H/I/J): INT CALC MTHD (FYINTC)'
      ))
    UNION ALL
/* =============================================================================
   ISCPSCP - Inventory Stock MCNI Coupon Schedule File
   Πίνακας: DATACUT5."TREATS_ISCPSCP"   Shadow: δεν υπάρχει mode flag   Έλεγχοι: 1
   Έλεγχοι τιμών από τη στήλη Free column του DD v2.4.
   ============================================================================= */
    SELECT 'ISCPSCP - Inventory Stock MCNI Coupon Schedule File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- ISCPSCP-501: Value not in (Y/N): COMPOUNDING FLAG (RGCDFG)
          COUNT(*) AS t1,
          COUNT(CASE WHEN NVL(TRIM(s."RGCDFG"), '#') NOT IN ('Y', 'N') THEN 1 END) AS f1
        FROM (
              SELECT t."RGCDFG"
                FROM DATACUT5."TREATS_ISCPSCP" t
        ) s
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'ISCPSCP-501|Invalid Values|Value not in (Y/N): COMPOUNDING FLAG (RGCDFG)'
      ))
    UNION ALL
/* =============================================================================
   ISNMPCP - Inventory Stock MCNI Security Parcel File
   Πίνακας: DATACUT5."TREATS_ISNMPCP"   Shadow: δεν υπάρχει mode flag   Έλεγχοι: 1
   Έλεγχοι τιμών από τη στήλη Free column του DD v2.4.
   ============================================================================= */
    SELECT 'ISNMPCP - Inventory Stock MCNI Security Parcel File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- ISNMPCP-501: Value not in (B/C/H/L/O/P/S/T): Security Arrangement (RHSARG)
          COUNT(*) AS t1,
          COUNT(CASE WHEN NVL(TRIM(s."RHSARG"), '#') NOT IN ('B', 'C', 'H', 'L', 'O', 'P', 'S', 'T') THEN 1 END) AS f1
        FROM (
              SELECT t."RHSARG"
                FROM DATACUT5."TREATS_ISNMPCP" t
        ) s
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'ISNMPCP-501|Invalid Values|Value not in (B/C/H/L/O/P/S/T): Security Arrangement (RHSARG)'
      ))
    UNION ALL
/* =============================================================================
   DEDLDIP - Deal Delivery Instruction File
   Πίνακας: DATACUT5."TREATS_DEDLDIP"   Shadow: δεν υπάρχει mode flag   Έλεγχοι: 15
   Έλεγχοι τιμών από τη στήλη Free column του DD v2.4.
   ============================================================================= */
    SELECT 'DEDLDIP - Deal Delivery Instruction File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- DEDLDIP-501: Value not in (A/F): Our delivery type A=Against Payment (APODTY)
          COUNT(*) AS t1,
          COUNT(CASE WHEN NVL(TRIM(s."APODTY"), '#') NOT IN ('A', 'F') THEN 1 END) AS f1,
          -- DEDLDIP-502: Value not in (B/C/D/E/F): Our agen type E=Euroclear (APOATY)
          COUNT(*) AS t2,
          COUNT(CASE WHEN NVL(TRIM(s."APOATY"), '#') NOT IN ('B', 'C', 'D', 'E', 'F') THEN 1 END) AS f2,
          -- DEDLDIP-503: Value not in (Y/N): Our Settlement Risk (APOSRK)
          COUNT(*) AS t3,
          COUNT(CASE WHEN NVL(TRIM(s."APOSRK"), '#') NOT IN ('Y', 'N') THEN 1 END) AS f3,
          -- DEDLDIP-504: Value not in (G/H/P): Our delivery message attribute (APODMA)
          COUNT(*) AS t4,
          COUNT(CASE WHEN NVL(TRIM(s."APODMA"), '#') NOT IN ('G', 'H', 'P') THEN 1 END) AS f4,
          -- DEDLDIP-505: Value not in (1/2/3/4): Our preferred message type (APOPMT)
          COUNT(*) AS t5,
          COUNT(CASE WHEN NVL(TRIM(s."APOPMT"), '#') NOT IN ('1', '2', '3', '4') THEN 1 END) AS f5,
          -- DEDLDIP-506: Value not in (A/F): Their Delivery Type A=Against Payment (APTDTY)
          COUNT(*) AS t6,
          COUNT(CASE WHEN NVL(TRIM(s."APTDTY"), '#') NOT IN ('A', 'F') THEN 1 END) AS f6,
          -- DEDLDIP-507: Value not in (B/C/D/E/F): Their agent type E=Euroclear (APTATY)
          COUNT(*) AS t7,
          COUNT(CASE WHEN NVL(TRIM(s."APTATY"), '#') NOT IN ('B', 'C', 'D', 'E', 'F') THEN 1 END) AS f7,
          -- DEDLDIP-508: Value not in (Y/N): Their Settlement Risk (APTSRK)
          COUNT(*) AS t8,
          COUNT(CASE WHEN NVL(TRIM(s."APTSRK"), '#') NOT IN ('Y', 'N') THEN 1 END) AS f8,
          -- DEDLDIP-509: Value not in (G/H/P): Their delivery message attribute (APTDMA)
          COUNT(*) AS t9,
          COUNT(CASE WHEN NVL(TRIM(s."APTDMA"), '#') NOT IN ('G', 'H', 'P') THEN 1 END) AS f9,
          -- DEDLDIP-510: Value not in (1/2/3/4): Their preferred message type (APTPMT)
          COUNT(*) AS t10,
          COUNT(CASE WHEN NVL(TRIM(s."APTPMT"), '#') NOT IN ('1', '2', '3', '4') THEN 1 END) AS f10,
          -- DEDLDIP-511: Value not in (Y/N): Security Parcel Transfer (Y/N) (APSPTR)
          COUNT(*) AS t11,
          COUNT(CASE WHEN NVL(TRIM(s."APSPTR"), '#') NOT IN ('Y', 'N') THEN 1 END) AS f11,
          -- DEDLDIP-512: Value not in (Y/N): DAY NIGHT FLAG (APDALF)
          COUNT(*) AS t12,
          COUNT(CASE WHEN NVL(TRIM(s."APDALF"), '#') NOT IN ('Y', 'N') THEN 1 END) AS f12,
          -- DEDLDIP-513: Value not in (Y/N): DAY NIGHT FLAG 2 (APDLF2)
          COUNT(*) AS t13,
          COUNT(CASE WHEN NVL(TRIM(s."APDLF2"), '#') NOT IN ('Y', 'N') THEN 1 END) AS f13,
          -- DEDLDIP-514: Value not in (H/R): Hold/ Release (APHLRS)
          COUNT(*) AS t14,
          COUNT(CASE WHEN NVL(TRIM(s."APHLRS"), '#') NOT IN ('H', 'R') THEN 1 END) AS f14,
          -- DEDLDIP-515: Value not in (Y/N): Partial Settlement (APPRSE)
          COUNT(*) AS t15,
          COUNT(CASE WHEN NVL(TRIM(s."APPRSE"), '#') NOT IN ('Y', 'N') THEN 1 END) AS f15
        FROM (
              SELECT t."APDALF",
                     t."APDLF2",
                     t."APHLRS",
                     t."APOATY",
                     t."APODMA",
                     t."APODTY",
                     t."APOPMT",
                     t."APOSRK",
                     t."APPRSE",
                     t."APSPTR",
                     t."APTATY",
                     t."APTDMA",
                     t."APTDTY",
                     t."APTPMT",
                     t."APTSRK"
                FROM DATACUT5."TREATS_DEDLDIP" t
        ) s
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'DEDLDIP-501|Invalid Values|Value not in (A/F): Our delivery type A=Against Payment (APODTY)',
        (t2, f2) AS 'DEDLDIP-502|Invalid Values|Value not in (B/C/D/E/F): Our agen type E=Euroclear (APOATY)',
        (t3, f3) AS 'DEDLDIP-503|Invalid Values|Value not in (Y/N): Our Settlement Risk (APOSRK)',
        (t4, f4) AS 'DEDLDIP-504|Invalid Values|Value not in (G/H/P): Our delivery message attribute (APODMA)',
        (t5, f5) AS 'DEDLDIP-505|Invalid Values|Value not in (1/2/3/4): Our preferred message type (APOPMT)',
        (t6, f6) AS 'DEDLDIP-506|Invalid Values|Value not in (A/F): Their Delivery Type A=Against Payment (APTDTY)',
        (t7, f7) AS 'DEDLDIP-507|Invalid Values|Value not in (B/C/D/E/F): Their agent type E=Euroclear (APTATY)',
        (t8, f8) AS 'DEDLDIP-508|Invalid Values|Value not in (Y/N): Their Settlement Risk (APTSRK)',
        (t9, f9) AS 'DEDLDIP-509|Invalid Values|Value not in (G/H/P): Their delivery message attribute (APTDMA)',
        (t10, f10) AS 'DEDLDIP-510|Invalid Values|Value not in (1/2/3/4): Their preferred message type (APTPMT)',
        (t11, f11) AS 'DEDLDIP-511|Invalid Values|Value not in (Y/N): Security Parcel Transfer (Y/N) (APSPTR)',
        (t12, f12) AS 'DEDLDIP-512|Invalid Values|Value not in (Y/N): DAY NIGHT FLAG (APDALF)',
        (t13, f13) AS 'DEDLDIP-513|Invalid Values|Value not in (Y/N): DAY NIGHT FLAG 2 (APDLF2)',
        (t14, f14) AS 'DEDLDIP-514|Invalid Values|Value not in (H/R): Hold/ Release (APHLRS)',
        (t15, f15) AS 'DEDLDIP-515|Invalid Values|Value not in (Y/N): Partial Settlement (APPRSE)'
      ))
    UNION ALL
/* =============================================================================
   TTCPIPP - Counterparty Information File
   Πίνακας: DATACUT5."TREATS_TTCPIPP"   Shadow: δεν υπάρχει mode flag   Έλεγχοι: 25
   Έλεγχοι τιμών από τη στήλη Free column του DD v2.4.
   ============================================================================= */
    SELECT 'TTCPIPP - Counterparty Information File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- TTCPIPP-501: Value not in (A/N): CPRTY NAM ADDR LN 1 TY (XJNAT1)
          COUNT(*) AS t1,
          COUNT(CASE WHEN NVL(TRIM(s."XJNAT1"), '#') NOT IN ('A', 'N') THEN 1 END) AS f1,
          -- TTCPIPP-502: Value not in (A/N): CPRTY NAM ADDR LN 2 TY (XJNAT2)
          COUNT(*) AS t2,
          COUNT(CASE WHEN NVL(TRIM(s."XJNAT2"), '#') NOT IN ('A', 'N') THEN 1 END) AS f2,
          -- TTCPIPP-503: Value not in (A/N): CPRTY NAM ADDR LN 3 TY (XJNAT3)
          COUNT(*) AS t3,
          COUNT(CASE WHEN NVL(TRIM(s."XJNAT3"), '#') NOT IN ('A', 'N') THEN 1 END) AS f3,
          -- TTCPIPP-504: Value not in (A/N): CPRTY NAM ADDR LN 4 TY (XJNAT4)
          COUNT(*) AS t4,
          COUNT(CASE WHEN NVL(TRIM(s."XJNAT4"), '#') NOT IN ('A', 'N') THEN 1 END) AS f4,
          -- TTCPIPP-505: Value not in (A/N): CPRTY NAM ADDR LN 5 TY (XJNAT5)
          COUNT(*) AS t5,
          COUNT(CASE WHEN NVL(TRIM(s."XJNAT5"), '#') NOT IN ('A', 'N') THEN 1 END) AS f5,
          -- TTCPIPP-506: Value not in (A/N): CPRTY NAM ADDR LN 6 TY (XJNAT6)
          COUNT(*) AS t6,
          COUNT(CASE WHEN NVL(TRIM(s."XJNAT6"), '#') NOT IN ('A', 'N') THEN 1 END) AS f6,
          -- TTCPIPP-507: Value not in (E/R/A/I): CUSTOMER IND (XJCSID)
          COUNT(*) AS t7,
          COUNT(CASE WHEN NVL(TRIM(s."XJCSID"), '#') NOT IN ('E', 'R', 'A', 'I') THEN 1 END) AS f7,
          -- TTCPIPP-508: Value not in (Y/N): Confirmation Sent Indicator (XJCFSI)
          COUNT(*) AS t8,
          COUNT(CASE WHEN NVL(TRIM(s."XJCFSI"), '#') NOT IN ('Y', 'N') THEN 1 END) AS f8,
          -- TTCPIPP-509: Value not in (Y/N): LIQD NOTIC REQD (XJLIQI)
          COUNT(*) AS t9,
          COUNT(CASE WHEN NVL(TRIM(s."XJLIQI"), '#') NOT IN ('Y', 'N') THEN 1 END) AS f9,
          -- TTCPIPP-510: Value not in (A/E/F/S/1/3/8): LANG (XJLANG)
          COUNT(*) AS t10,
          COUNT(CASE WHEN NVL(TRIM(s."XJLANG"), '#') NOT IN ('A', 'E', 'F', 'S', '1', '3', '8') THEN 1 END) AS f10,
          -- TTCPIPP-511: Value not in (Y/N): CLIENT BASED PRODUCT C ODE (XJIDDI)
          COUNT(*) AS t11,
          COUNT(CASE WHEN NVL(TRIM(s."XJIDDI"), '#') NOT IN ('Y', 'N') THEN 1 END) AS f11,
          -- TTCPIPP-512: Value not in (Y/N): CREDIT XACT IND (XJCXTI)
          COUNT(*) AS t12,
          COUNT(CASE WHEN NVL(TRIM(s."XJCXTI"), '#') NOT IN ('Y', 'N') THEN 1 END) AS f12,
          -- TTCPIPP-513: Value not in (Y/N): SURE-TRADE IND (XJSTID)
          COUNT(*) AS t13,
          COUNT(CASE WHEN NVL(TRIM(s."XJSTID"), '#') NOT IN ('Y', 'N') THEN 1 END) AS f13,
          -- TTCPIPP-514: Value not in (B/C/G/H/I/L/M/N/O/P/X): AUTH BANK TYP (XJABTY)
          COUNT(*) AS t14,
          COUNT(CASE WHEN NVL(TRIM(s."XJABTY"), '#') NOT IN ('B', 'C', 'G', 'H', 'I', 'L', 'M', 'N', 'O', 'P', 'X') THEN 1 END) AS f14,
          -- TTCPIPP-515: Value not in (1/2/8/9): AUTH BANK TIER (XJABTR)
          COUNT(*) AS t15,
          COUNT(CASE WHEN NVL(TRIM(s."XJABTR"), '#') NOT IN ('1', '2', '8', '9') THEN 1 END) AS f15,
          -- TTCPIPP-516: Value not in (1/2): CUST /BANK TRFR (XJCUTR)
          COUNT(*) AS t16,
          COUNT(CASE WHEN NVL(TRIM(s."XJCUTR"), '#') NOT IN ('1', '2') THEN 1 END) AS f16,
          -- TTCPIPP-517: Value not in (Y/N): FOS REQ FLG (XJFORQ)
          COUNT(*) AS t17,
          COUNT(CASE WHEN NVL(TRIM(s."XJFORQ"), '#') NOT IN ('Y', 'N') THEN 1 END) AS f17,
          -- TTCPIPP-518: Value not in (Y): Documentation (XJDCMT)
          COUNT(*) AS t18,
          COUNT(CASE WHEN NVL(TRIM(s."XJDCMT"), '#') NOT IN ('Y') THEN 1 END) AS f18,
          -- TTCPIPP-519: Value not in (N): CONF TO TRAM (XJCTRM)
          COUNT(*) AS t19,
          COUNT(CASE WHEN NVL(TRIM(s."XJCTRM"), '#') NOT IN ('N') THEN 1 END) AS f19,
          -- TTCPIPP-520: Value not in (Y/N): ECHO CUSTOMER FLAG (XJECHO)
          COUNT(*) AS t20,
          COUNT(CASE WHEN NVL(TRIM(s."XJECHO"), '#') NOT IN ('Y', 'N') THEN 1 END) AS f20,
          -- TTCPIPP-521: Value not in (Y/N): CLS FLAG (XJCLSF)
          COUNT(*) AS t21,
          COUNT(CASE WHEN NVL(TRIM(s."XJCLSF"), '#') NOT IN ('Y', 'N') THEN 1 END) AS f21,
          -- TTCPIPP-522: Value not in (Y/N): ET CUSTOMER FLAG (XJETCP)
          COUNT(*) AS t22,
          COUNT(CASE WHEN NVL(TRIM(s."XJETCP"), '#') NOT IN ('Y', 'N') THEN 1 END) AS f22,
          -- TTCPIPP-523: Value not in (C/F): Counterparty Type (XJCTPT)
          COUNT(*) AS t23,
          COUNT(CASE WHEN NVL(TRIM(s."XJCTPT"), '#') NOT IN ('C', 'F') THEN 1 END) AS f23,
          -- TTCPIPP-524: Value not in (Y/N): Special Handling (XJSPHL)
          COUNT(*) AS t24,
          COUNT(CASE WHEN NVL(TRIM(s."XJSPHL"), '#') NOT IN ('Y', 'N') THEN 1 END) AS f24,
          -- TTCPIPP-525: Value not in (P/V/X): Processing Location (XJPLOC)
          COUNT(*) AS t25,
          COUNT(CASE WHEN NVL(TRIM(s."XJPLOC"), '#') NOT IN ('P', 'V', 'X') THEN 1 END) AS f25
        FROM (
              SELECT t."XJABTR",
                     t."XJABTY",
                     t."XJCFSI",
                     t."XJCLSF",
                     t."XJCSID",
                     t."XJCTPT",
                     t."XJCTRM",
                     t."XJCUTR",
                     t."XJCXTI",
                     t."XJDCMT",
                     t."XJECHO",
                     t."XJETCP",
                     t."XJFORQ",
                     t."XJIDDI",
                     t."XJLANG",
                     t."XJLIQI",
                     t."XJNAT1",
                     t."XJNAT2",
                     t."XJNAT3",
                     t."XJNAT4",
                     t."XJNAT5",
                     t."XJNAT6",
                     t."XJPLOC",
                     t."XJSPHL",
                     t."XJSTID"
                FROM DATACUT5."TREATS_TTCPIPP" t
        ) s
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'TTCPIPP-501|Invalid Values|Value not in (A/N): CPRTY NAM ADDR LN 1 TY (XJNAT1)',
        (t2, f2) AS 'TTCPIPP-502|Invalid Values|Value not in (A/N): CPRTY NAM ADDR LN 2 TY (XJNAT2)',
        (t3, f3) AS 'TTCPIPP-503|Invalid Values|Value not in (A/N): CPRTY NAM ADDR LN 3 TY (XJNAT3)',
        (t4, f4) AS 'TTCPIPP-504|Invalid Values|Value not in (A/N): CPRTY NAM ADDR LN 4 TY (XJNAT4)',
        (t5, f5) AS 'TTCPIPP-505|Invalid Values|Value not in (A/N): CPRTY NAM ADDR LN 5 TY (XJNAT5)',
        (t6, f6) AS 'TTCPIPP-506|Invalid Values|Value not in (A/N): CPRTY NAM ADDR LN 6 TY (XJNAT6)',
        (t7, f7) AS 'TTCPIPP-507|Invalid Values|Value not in (E/R/A/I): CUSTOMER IND (XJCSID)',
        (t8, f8) AS 'TTCPIPP-508|Invalid Values|Value not in (Y/N): Confirmation Sent Indicator (XJCFSI)',
        (t9, f9) AS 'TTCPIPP-509|Invalid Values|Value not in (Y/N): LIQD NOTIC REQD (XJLIQI)',
        (t10, f10) AS 'TTCPIPP-510|Invalid Values|Value not in (A/E/F/S/1/3/8): LANG (XJLANG)',
        (t11, f11) AS 'TTCPIPP-511|Invalid Values|Value not in (Y/N): CLIENT BASED PRODUCT C ODE (XJIDDI)',
        (t12, f12) AS 'TTCPIPP-512|Invalid Values|Value not in (Y/N): CREDIT XACT IND (XJCXTI)',
        (t13, f13) AS 'TTCPIPP-513|Invalid Values|Value not in (Y/N): SURE-TRADE IND (XJSTID)',
        (t14, f14) AS 'TTCPIPP-514|Invalid Values|Value not in (B/C/G/H/I/L/M/N/O/P/X): AUTH BANK TYP (XJABTY)',
        (t15, f15) AS 'TTCPIPP-515|Invalid Values|Value not in (1/2/8/9): AUTH BANK TIER (XJABTR)',
        (t16, f16) AS 'TTCPIPP-516|Invalid Values|Value not in (1/2): CUST /BANK TRFR (XJCUTR)',
        (t17, f17) AS 'TTCPIPP-517|Invalid Values|Value not in (Y/N): FOS REQ FLG (XJFORQ)',
        (t18, f18) AS 'TTCPIPP-518|Invalid Values|Value not in (Y): Documentation (XJDCMT)',
        (t19, f19) AS 'TTCPIPP-519|Invalid Values|Value not in (N): CONF TO TRAM (XJCTRM)',
        (t20, f20) AS 'TTCPIPP-520|Invalid Values|Value not in (Y/N): ECHO CUSTOMER FLAG (XJECHO)',
        (t21, f21) AS 'TTCPIPP-521|Invalid Values|Value not in (Y/N): CLS FLAG (XJCLSF)',
        (t22, f22) AS 'TTCPIPP-522|Invalid Values|Value not in (Y/N): ET CUSTOMER FLAG (XJETCP)',
        (t23, f23) AS 'TTCPIPP-523|Invalid Values|Value not in (C/F): Counterparty Type (XJCTPT)',
        (t24, f24) AS 'TTCPIPP-524|Invalid Values|Value not in (Y/N): Special Handling (XJSPHL)',
        (t25, f25) AS 'TTCPIPP-525|Invalid Values|Value not in (P/V/X): Processing Location (XJPLOC)'
      ))
    UNION ALL
/* =============================================================================
   ISNMESP - Inventory Stock MCNI Security Master Extend File
   Πίνακας: DATACUT5."TREATS_ISNMESP"   Shadow: δεν υπάρχει mode flag   Έλεγχοι: 4
   Έλεγχοι τιμών από τη στήλη Free column του DD v2.4.
   ============================================================================= */
    SELECT 'ISNMESP - Inventory Stock MCNI Security Master Extend File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- ISNMESP-501: Value not in (Y/N/κενό): DISALLOW A/I OVRI (RPDAIO)
          COUNT(CASE WHEN TRIM(s."RPDAIO") IS NOT NULL THEN 1 END) AS t1,
          COUNT(CASE WHEN TRIM(s."RPDAIO") IS NOT NULL AND TRIM(s."RPDAIO") NOT IN ('Y', 'N') THEN 1 END) AS f1,
          -- ISNMESP-502: Value not in (S/C): S/C FLAG (RPCPSP)
          COUNT(*) AS t2,
          COUNT(CASE WHEN NVL(TRIM(s."RPCPSP"), '#') NOT IN ('S', 'C') THEN 1 END) AS f2,
          -- ISNMESP-503: Value not in (Y/N/κενό): AUTO FIXING FLAG (RPAUFX)
          COUNT(CASE WHEN TRIM(s."RPAUFX") IS NOT NULL THEN 1 END) AS t3,
          COUNT(CASE WHEN TRIM(s."RPAUFX") IS NOT NULL AND TRIM(s."RPAUFX") NOT IN ('Y', 'N') THEN 1 END) AS f3,
          -- ISNMESP-504: Value not in (Y/N/κενό): OBERSERVATION SHIFT (RPOBSH)
          COUNT(CASE WHEN TRIM(s."RPOBSH") IS NOT NULL THEN 1 END) AS t4,
          COUNT(CASE WHEN TRIM(s."RPOBSH") IS NOT NULL AND TRIM(s."RPOBSH") NOT IN ('Y', 'N') THEN 1 END) AS f4
        FROM (
              SELECT t."RPAUFX",
                     t."RPCPSP",
                     t."RPDAIO",
                     t."RPOBSH"
                FROM DATACUT5."TREATS_ISNMESP" t
        ) s
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'ISNMESP-501|Invalid Values|Value not in (Y/N/κενό): DISALLOW A/I OVRI (RPDAIO)',
        (t2, f2) AS 'ISNMESP-502|Invalid Values|Value not in (S/C): S/C FLAG (RPCPSP)',
        (t3, f3) AS 'ISNMESP-503|Invalid Values|Value not in (Y/N/κενό): AUTO FIXING FLAG (RPAUFX)',
        (t4, f4) AS 'ISNMESP-504|Invalid Values|Value not in (Y/N/κενό): OBERSERVATION SHIFT (RPOBSH)'
      ))
    UNION ALL
/* =============================================================================
   CKOVLMP - Credit Overall Limits File
   Πίνακας: DATACUT5."TREATS_CKOVLMP"   Shadow: δεν υπάρχει mode flag   Έλεγχοι: 7
   Έλεγχοι τιμών από τη στήλη Free column του DD v2.4.
   ============================================================================= */
    SELECT 'CKOVLMP - Credit Overall Limits File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- CKOVLMP-501: Value not in (Y/N): No Limit indicator (CINLMT)
          COUNT(*) AS t1,
          COUNT(CASE WHEN NVL(TRIM(s."CINLMT"), '#') NOT IN ('Y', 'N') THEN 1 END) AS f1,
          -- CKOVLMP-502: Value not in (Y/N): Blocking Indicator (CIBLKG)
          COUNT(*) AS t2,
          COUNT(CASE WHEN NVL(TRIM(s."CIBLKG"), '#') NOT IN ('Y', 'N') THEN 1 END) AS f2,
          -- CKOVLMP-503: Value not in (A/B/C/D/E/Q/W/X/Y/Z): Limit Category (CILCAT)
          COUNT(*) AS t3,
          COUNT(CASE WHEN NVL(TRIM(s."CILCAT"), '#') NOT IN ('A', 'B', 'C', 'D', 'E', 'Q', 'W', 'X', 'Y', 'Z') THEN 1 END) AS f3,
          -- CKOVLMP-504: Value not in (0/1/2/3/4/5): FX Risk Netting Indicator (CIFXKN)
          COUNT(*) AS t4,
          COUNT(CASE WHEN NVL(TRIM(s."CIFXKN"), '#') NOT IN ('0', '1', '2', '3', '4', '5') THEN 1 END) AS f4,
          -- CKOVLMP-505: Value not in (Y/N): Case By Case (CBC) / Restricted (RST) Indicator (CICBRS)
          COUNT(*) AS t5,
          COUNT(CASE WHEN NVL(TRIM(s."CICBRS"), '#') NOT IN ('Y', 'N') THEN 1 END) AS f5,
          -- CKOVLMP-506: Value not in (Y/N): Special FFR flag for RPO (CIRPOF)
          COUNT(*) AS t6,
          COUNT(CASE WHEN NVL(TRIM(s."CIRPOF"), '#') NOT IN ('Y', 'N') THEN 1 END) AS f6,
          -- CKOVLMP-507: Value not in (Y/N): Special FFR flag for RRP (CIRRPF)
          COUNT(*) AS t7,
          COUNT(CASE WHEN NVL(TRIM(s."CIRRPF"), '#') NOT IN ('Y', 'N') THEN 1 END) AS f7
        FROM (
              SELECT t."CIBLKG",
                     t."CICBRS",
                     t."CIFXKN",
                     t."CILCAT",
                     t."CINLMT",
                     t."CIRPOF",
                     t."CIRRPF"
                FROM DATACUT5."TREATS_CKOVLMP" t
        ) s
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'CKOVLMP-501|Invalid Values|Value not in (Y/N): No Limit indicator (CINLMT)',
        (t2, f2) AS 'CKOVLMP-502|Invalid Values|Value not in (Y/N): Blocking Indicator (CIBLKG)',
        (t3, f3) AS 'CKOVLMP-503|Invalid Values|Value not in (A/B/C/D/E/Q/W/X/Y/Z): Limit Category (CILCAT)',
        (t4, f4) AS 'CKOVLMP-504|Invalid Values|Value not in (0/1/2/3/4/5): FX Risk Netting Indicator (CIFXKN)',
        (t5, f5) AS 'CKOVLMP-505|Invalid Values|Value not in (Y/N): Case By Case (CBC) / Restricted (RST) Indicator (CICBRS)',
        (t6, f6) AS 'CKOVLMP-506|Invalid Values|Value not in (Y/N): Special FFR flag for RPO (CIRPOF)',
        (t7, f7) AS 'CKOVLMP-507|Invalid Values|Value not in (Y/N): Special FFR flag for RRP (CIRRPF)'
      ))
    UNION ALL
/* =============================================================================
   CKSBLMP - Credit Sub-limits File
   Πίνακας: DATACUT5."TREATS_CKSBLMP"   Shadow: δεν υπάρχει mode flag   Έλεγχοι: 6
   Έλεγχοι τιμών από τη στήλη Free column του DD v2.4.
   ============================================================================= */
    SELECT 'CKSBLMP - Credit Sub-limits File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- CKSBLMP-501: Value not in (C/G/M): Cash/Gross/Margin Basis (CFBASI)
          COUNT(*) AS t1,
          COUNT(CASE WHEN NVL(TRIM(s."CFBASI"), '#') NOT IN ('C', 'G', 'M') THEN 1 END) AS f1,
          -- CKSBLMP-502: Value not in (R/U): Reserved/Unreserved Indicator (CFRESV)
          COUNT(*) AS t2,
          COUNT(CASE WHEN NVL(TRIM(s."CFRESV"), '#') NOT IN ('R', 'U') THEN 1 END) AS f2,
          -- CKSBLMP-503: Value not in (C/U): Committed/Uncommitted Indicator (CFCOMI)
          COUNT(*) AS t3,
          COUNT(CASE WHEN NVL(TRIM(s."CFCOMI"), '#') NOT IN ('C', 'U') THEN 1 END) AS f3,
          -- CKSBLMP-504: Value not in (Y/N): Overlimit Notifying Indicator (CFEXCP)
          COUNT(*) AS t4,
          COUNT(CASE WHEN NVL(TRIM(s."CFEXCP"), '#') NOT IN ('Y', 'N') THEN 1 END) AS f4,
          -- CKSBLMP-505: Value not in (A/B/C/D/E/Q/W/X/Y/Z): Limit Category (CFLCAT)
          COUNT(*) AS t5,
          COUNT(CASE WHEN NVL(TRIM(s."CFLCAT"), '#') NOT IN ('A', 'B', 'C', 'D', 'E', 'Q', 'W', 'X', 'Y', 'Z') THEN 1 END) AS f5,
          -- CKSBLMP-506: Value not in (Y/N/κενό): ET Required Flag (Y/N) (CFETRQ)
          COUNT(CASE WHEN TRIM(s."CFETRQ") IS NOT NULL THEN 1 END) AS t6,
          COUNT(CASE WHEN TRIM(s."CFETRQ") IS NOT NULL AND TRIM(s."CFETRQ") NOT IN ('Y', 'N') THEN 1 END) AS f6
        FROM (
              SELECT t."CFBASI",
                     t."CFCOMI",
                     t."CFETRQ",
                     t."CFEXCP",
                     t."CFLCAT",
                     t."CFRESV"
                FROM DATACUT5."TREATS_CKSBLMP" t
        ) s
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'CKSBLMP-501|Invalid Values|Value not in (C/G/M): Cash/Gross/Margin Basis (CFBASI)',
        (t2, f2) AS 'CKSBLMP-502|Invalid Values|Value not in (R/U): Reserved/Unreserved Indicator (CFRESV)',
        (t3, f3) AS 'CKSBLMP-503|Invalid Values|Value not in (C/U): Committed/Uncommitted Indicator (CFCOMI)',
        (t4, f4) AS 'CKSBLMP-504|Invalid Values|Value not in (Y/N): Overlimit Notifying Indicator (CFEXCP)',
        (t5, f5) AS 'CKSBLMP-505|Invalid Values|Value not in (A/B/C/D/E/Q/W/X/Y/Z): Limit Category (CFLCAT)',
        (t6, f6) AS 'CKSBLMP-506|Invalid Values|Value not in (Y/N/κενό): ET Required Flag (Y/N) (CFETRQ)'
      ))
    UNION ALL
/* =============================================================================
   MPRKSFP - Regulatory Key Store Master File
   Πίνακας: DATACUT5."TREATS_MPRKSFP"   Shadow: δεν υπάρχει mode flag   Έλεγχοι: 2
   Έλεγχοι τιμών από τη στήλη Free column του DD v2.4.
   ============================================================================= */
    SELECT 'MPRKSFP - Regulatory Key Store Master File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- MPRKSFP-501: Value not in (Y/N): Eligible (RMELIG)
          COUNT(*) AS t1,
          COUNT(CASE WHEN NVL(TRIM(s."RMELIG"), '#') NOT IN ('Y', 'N') THEN 1 END) AS f1,
          -- MPRKSFP-502: Value not in (Y/N): Prior Reg Key flag (RMPRRK)
          COUNT(*) AS t2,
          COUNT(CASE WHEN NVL(TRIM(s."RMPRRK"), '#') NOT IN ('Y', 'N') THEN 1 END) AS f2
        FROM (
              SELECT t."RMELIG",
                     t."RMPRRK"
                FROM DATACUT5."TREATS_MPRKSFP" t
        ) s
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'MPRKSFP-501|Invalid Values|Value not in (Y/N): Eligible (RMELIG)',
        (t2, f2) AS 'MPRKSFP-502|Invalid Values|Value not in (Y/N): Prior Reg Key flag (RMPRRK)'
      ))
    UNION ALL
/* =============================================================================
   FEFWBTP - Forward Blotter File
   Πίνακας: DATACUT5."TREATS_FEFWBTP"   Shadow: δεν υπάρχει mode flag   Έλεγχοι: 5
   Έλεγχοι τιμών από τη στήλη Free column του DD v2.4.
   Στο DD ο πίνακας λέγεται "TEUTTSFP_FEFWBTP"· στη βάση (όπως στο DC4) TREATS_FEFWBTP.
   ============================================================================= */
    SELECT 'FEFWBTP - Forward Blotter File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- FEFWBTP-501: Value not in (Y/N/κενό): Cancel Flag (EBCNFG)
          COUNT(CASE WHEN TRIM(s."EBCNFG") IS NOT NULL THEN 1 END) AS t1,
          COUNT(CASE WHEN TRIM(s."EBCNFG") IS NOT NULL AND TRIM(s."EBCNFG") NOT IN ('Y', 'N') THEN 1 END) AS f1,
          -- FEFWBTP-502: Value not in (Y/N): Accounting Flag (EBACFG)
          COUNT(*) AS t2,
          COUNT(CASE WHEN NVL(TRIM(s."EBACFG"), '#') NOT IN ('Y', 'N') THEN 1 END) AS f2,
          -- FEFWBTP-503: Value not in (E/I/R/A): Ext/Int/Retail/Arbitrage Indicator (EBEIRI)
          COUNT(*) AS t3,
          COUNT(CASE WHEN NVL(TRIM(s."EBEIRI"), '#') NOT IN ('E', 'I', 'R', 'A') THEN 1 END) AS f3,
          -- FEFWBTP-504: Value not in (D/M): Rate Sense (EBRSNS)
          COUNT(*) AS t4,
          COUNT(CASE WHEN NVL(TRIM(s."EBRSNS"), '#') NOT IN ('D', 'M') THEN 1 END) AS f4,
          -- FEFWBTP-505: Value not in (0): Customer Margin (EBCMGN)
          COUNT(*) AS t5,
          COUNT(CASE WHEN NVL(TRIM(s."EBCMGN"), '#') NOT IN ('0') THEN 1 END) AS f5
        FROM (
              SELECT t."EBACFG",
                     t."EBCMGN",
                     t."EBCNFG",
                     t."EBEIRI",
                     t."EBRSNS"
                FROM DATACUT5."TREATS_FEFWBTP" t
        ) s
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'FEFWBTP-501|Invalid Values|Value not in (Y/N/κενό): Cancel Flag (EBCNFG)',
        (t2, f2) AS 'FEFWBTP-502|Invalid Values|Value not in (Y/N): Accounting Flag (EBACFG)',
        (t3, f3) AS 'FEFWBTP-503|Invalid Values|Value not in (E/I/R/A): Ext/Int/Retail/Arbitrage Indicator (EBEIRI)',
        (t4, f4) AS 'FEFWBTP-504|Invalid Values|Value not in (D/M): Rate Sense (EBRSNS)',
        (t5, f5) AS 'FEFWBTP-505|Invalid Values|Value not in (0): Customer Margin (EBCMGN)'
      ))
    UNION ALL
/* =============================================================================
   MMSWBTP - Money Market SWAP/MCNNI Blotter
   Πίνακας: DATACUT5."TREATS_MMSWBTP"   Shadow: δεν υπάρχει mode flag   Έλεγχοι: 12
   Έλεγχοι τιμών από τη στήλη Free column του DD v2.4.
   Στο DD ο πίνακας λέγεται "TEUTTSFP_MMSWBTP"· στη βάση (όπως στο DC4) TREATS_MMSWBTP.
   ============================================================================= */
    SELECT 'MMSWBTP - Money Market SWAP/MCNNI Blotter' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- MMSWBTP-501: Value not in (E/I/R/A): Ext/Int/Retail/Arbitrage Indicator (EPEIRI)
          COUNT(*) AS t1,
          COUNT(CASE WHEN NVL(TRIM(s."EPEIRI"), '#') NOT IN ('E', 'I', 'R', 'A') THEN 1 END) AS f1,
          -- MMSWBTP-502: Value not in (A/L/κενό): Asset/Liability Indicator (EPALIN)
          COUNT(CASE WHEN TRIM(s."EPALIN") IS NOT NULL THEN 1 END) AS t2,
          COUNT(CASE WHEN TRIM(s."EPALIN") IS NOT NULL AND TRIM(s."EPALIN") NOT IN ('A', 'L') THEN 1 END) AS f2,
          -- MMSWBTP-503: Value not in (N/R): On/Off Balance Sheet Indicator (EPPNIN)
          COUNT(*) AS t3,
          COUNT(CASE WHEN NVL(TRIM(s."EPPNIN"), '#') NOT IN ('N', 'R') THEN 1 END) AS f3,
          -- MMSWBTP-504: Value not in (X/O): Fixed/Floating Indicator (EPXOIN)
          COUNT(*) AS t4,
          COUNT(CASE WHEN NVL(TRIM(s."EPXOIN"), '#') NOT IN ('X', 'O') THEN 1 END) AS f4,
          -- MMSWBTP-505: Value not in (Y/N): Accounting Flag (EPACFG)
          COUNT(*) AS t5,
          COUNT(CASE WHEN NVL(TRIM(s."EPACFG"), '#') NOT IN ('Y', 'N') THEN 1 END) AS f5,
          -- MMSWBTP-506: Value not in (Y/N/κενό): Cancel Flag (EPCNFG)
          COUNT(CASE WHEN TRIM(s."EPCNFG") IS NOT NULL THEN 1 END) AS t6,
          COUNT(CASE WHEN TRIM(s."EPCNFG") IS NOT NULL AND TRIM(s."EPCNFG") NOT IN ('Y', 'N') THEN 1 END) AS f6,
          -- MMSWBTP-507: Value not in (B/E/H/I/J): Interest Calculation method (EPINTC)
          COUNT(*) AS t7,
          COUNT(CASE WHEN NVL(TRIM(s."EPINTC"), '#') NOT IN ('B', 'E', 'H', 'I', 'J') THEN 1 END) AS f7,
          -- MMSWBTP-508: Value not in (Y/N): Projected Flag (Y/N) (EPPJFG)
          COUNT(*) AS t8,
          COUNT(CASE WHEN NVL(TRIM(s."EPPJFG"), '#') NOT IN ('Y', 'N') THEN 1 END) AS f8,
          -- MMSWBTP-509: Value not in (P/R): Pay/Receive Indicator (Primary Position) (EPPRIP)
          COUNT(*) AS t9,
          COUNT(CASE WHEN NVL(TRIM(s."EPPRIP"), '#') NOT IN ('P', 'R') THEN 1 END) AS f9,
          -- MMSWBTP-510: Value not in (M/Q/S/I): Payment Periodicity (EPPMPT)
          COUNT(*) AS t10,
          COUNT(CASE WHEN NVL(TRIM(s."EPPMPT"), '#') NOT IN ('M', 'Q', 'S', 'I') THEN 1 END) AS f10,
          -- MMSWBTP-511: Value not in (M/Q/S/I): Broken Period Floating Rate Periodicity (EPBKOY)
          COUNT(*) AS t11,
          COUNT(CASE WHEN NVL(TRIM(s."EPBKOY"), '#') NOT IN ('M', 'Q', 'S', 'I') THEN 1 END) AS f11,
          -- MMSWBTP-512: Value not in (M/Q/S/I): Broken Period Payment Periodicity (EPBKPY)
          COUNT(*) AS t12,
          COUNT(CASE WHEN NVL(TRIM(s."EPBKPY"), '#') NOT IN ('M', 'Q', 'S', 'I') THEN 1 END) AS f12
        FROM (
              SELECT t."EPACFG",
                     t."EPALIN",
                     t."EPBKOY",
                     t."EPBKPY",
                     t."EPCNFG",
                     t."EPEIRI",
                     t."EPINTC",
                     t."EPPJFG",
                     t."EPPMPT",
                     t."EPPNIN",
                     t."EPPRIP",
                     t."EPXOIN"
                FROM DATACUT5."TREATS_MMSWBTP" t
        ) s
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'MMSWBTP-501|Invalid Values|Value not in (E/I/R/A): Ext/Int/Retail/Arbitrage Indicator (EPEIRI)',
        (t2, f2) AS 'MMSWBTP-502|Invalid Values|Value not in (A/L/κενό): Asset/Liability Indicator (EPALIN)',
        (t3, f3) AS 'MMSWBTP-503|Invalid Values|Value not in (N/R): On/Off Balance Sheet Indicator (EPPNIN)',
        (t4, f4) AS 'MMSWBTP-504|Invalid Values|Value not in (X/O): Fixed/Floating Indicator (EPXOIN)',
        (t5, f5) AS 'MMSWBTP-505|Invalid Values|Value not in (Y/N): Accounting Flag (EPACFG)',
        (t6, f6) AS 'MMSWBTP-506|Invalid Values|Value not in (Y/N/κενό): Cancel Flag (EPCNFG)',
        (t7, f7) AS 'MMSWBTP-507|Invalid Values|Value not in (B/E/H/I/J): Interest Calculation method (EPINTC)',
        (t8, f8) AS 'MMSWBTP-508|Invalid Values|Value not in (Y/N): Projected Flag (Y/N) (EPPJFG)',
        (t9, f9) AS 'MMSWBTP-509|Invalid Values|Value not in (P/R): Pay/Receive Indicator (Primary Position) (EPPRIP)',
        (t10, f10) AS 'MMSWBTP-510|Invalid Values|Value not in (M/Q/S/I): Payment Periodicity (EPPMPT)',
        (t11, f11) AS 'MMSWBTP-511|Invalid Values|Value not in (M/Q/S/I): Broken Period Floating Rate Periodicity (EPBKOY)',
        (t12, f12) AS 'MMSWBTP-512|Invalid Values|Value not in (M/Q/S/I): Broken Period Payment Periodicity (EPBKPY)'
      ))
  )
SELECT
    CAST('ME36' AS NVARCHAR2(20))                                AS DQ_AREA,
    CAST(REGEXP_SUBSTR(check_key, '[^|]+', 1, 2) AS NVARCHAR2(50))  AS DQ_CATEGORY,
    CAST(REGEXP_SUBSTR(check_key, '[^|]+', 1, 1) AS NVARCHAR2(30))  AS CHECK_ID,
    CAST(REGEXP_SUBSTR(check_key, '[^|]+', 1, 3) AS NVARCHAR2(500)) AS CHECK_NAME,
    TO_NCHAR(table_name)                                         AS TABLE_NAME,
    total                                                        AS TOTAL_RECORDS,
    failed                                                       AS FAILED_RECORDS,
    TO_NCHAR(CASE WHEN failed = 0 THEN 'PASS' ELSE 'FAIL' END)   AS DQ_STATUS,
    -- IS_MASKED: Y όταν τουλάχιστον ένα πεδίο του ελέγχου έχει «Masking Applied» = Yes στο DD v2.4.
    -- Δίπλα σε κάθε CHECK_ID: τα masked πεδία του. Όλοι οι υπόλοιποι έλεγχοι = N.
    CASE WHEN REGEXP_SUBSTR(check_key, '[^|]+', 1, 1) IN (
        'DEDLDIP-001', -- APDLNO
        'EXBLOTP-004', -- BBDLNO
        'EXBLOTP-005', -- BBASDN
        'EXBLOTP-008', -- BBMEID
