          COUNT(CASE WHEN REGEXP_LIKE(TRIM(t."CUSTNO"), '^0?[0-9]{3}-[0-9]{6}$') AND j2.dcb IS NULL THEN 1 END) AS f9,
          -- SETTRFSHBN-010: HUB customer number (CUSTNO) differs from the deceased file in DECEASED (same SNO)
