                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">/* =============================================================================
   ME12_WARNINGS_DQC_DC5.sql  —  Warnings Database Malta (EIM 237014) Data Quality Checks
   Περιεχόμενο : Όλοι οι πίνακες δεδομένων του Warnings Database (13 πίνακες)
   DC5         : Οι έλεγχοι του DC4 (ME12_WARNINGS_DQC_V3.sql), αυτούσιοι, με schema
                 DATACUT5. Το DD είναι ίδιο με το DC4 (v1.4), άρα δεν χρειάστηκαν
                 νέοι έλεγχοι. Νέες στο DC5 είναι μόνο οι στήλες IS_MASKED,
                 DC_Version, Run_Timestamp και οι τύποι NVARCHAR2 του output.
   -----------------------------------------------------------------------------
   Πηγή πεδίων : 12. 21.1041 237014_ME12_Warnings_Malta_v1.0_DDAMO_ v1.4_REDACTED.xlsx
   Schema      : DATACUT5 (πίνακες χωρίς πρόθεμα: CAUTION, AUCTION, ...)
   Πλατφόρμα   : Oracle 12.2+ (χρησιμοποιεί VALIDATE_CONVERSION)
   Έλεγχοι     : 139 έλεγχοι σε 13 πίνακες. Η περιγραφή κάθε ελέγχου είναι
                 στο ME12_WARNINGS_DQC_DC5_Check_Catalogue.xlsx.
   Output      : DQ_AREA | DQ_CATEGORY | CHECK_ID | CHECK_NAME | TABLE_NAME |
                 TOTAL_RECORDS | FAILED_RECORDS | DQ_STATUS | IS_MASKED |
                 DC_Version | Run_Timestamp
                 DQ_STATUS: PASS όταν FAILED_RECORDS = 0, αλλιώς FAIL.
                 IS_MASKED: Y όταν τουλάχιστον ένα πεδίο του ελέγχου έχει
                 «Masking Approach» = Yes στο DD v1.4, αλλιώς N.
                 Οι στήλες κειμένου (εκτός IS_MASKED) είναι NVARCHAR2 για τη φόρτωση
                 μέσω SSIS στον ίδιο πίνακα με τα ME01 / ME04 (ίδιοι τύποι και μήκη).
                 (ίδιο σχήμα με τα ME01_HUB_DQC_DC5 / ME04_ATM_DQC_DC5_Unified)
   ΑΡΧΕΙΑ
   ------
   Ένα αρχείο: οι πίνακες του Warnings Database είναι μικροί.
   ΔΟΜΗ
   ----
   - Κοινές λίστες (WPARAM, BRANCHES) στην αρχή του WITH, με το hint MATERIALIZE:
     υπολογίζονται μία φορά για όλο το script.
   - Μία ενότητα ανά πίνακα. Κάθε πίνακας διαβάζεται ΜΙΑ φορά: όλοι οι έλεγχοί του
     υπολογίζονται ως στήλες σε ένα aggregate (t = πληθυσμός, f = αποτυχίες) και
     μετά γίνονται γραμμές με UNPIVOT. Πάνω από κάθε έλεγχο υπάρχει σχόλιο με το
     CHECK_ID και το όνομά του.
   ΚΑΝΟΝΕΣ ΠΟΥ ΙΣΧΥΟΥΝ ΣΕ ΟΛΟ ΤΟ SCRIPT
   ------------------------------------
   1. Shadow records: οι πίνακες του Warnings Database δεν έχουν mode flag στο DD,
      άρα δεν υπάρχει εξαίρεση shadow.
   2. TOTAL_RECORDS = ο πληθυσμός του ελέγχου (π.χ. μόνο οι συμπληρωμένες τιμές),
      όχι πάντα όλος ο πίνακας.
   3. Ημερομηνίες: το DD τις ορίζει Date/Time μήκους 25. Στη βάση είναι κείμενο
      'YYYY-MM-DD HH24:MI:SS' (βλ. ME12_VAL_WARNINGS.sql). Κενή = TRIM(x) IS NULL.
      Άκυρη = όχι μορφή 'YYYY-MM-DD' ή 'YYYY-MM-DD HH24:MI:SS', ή το ημερολογιακό
      μέρος δεν είναι πραγματική ημερομηνία, ή είναι πριν το 1900-01-01.
      Αν κάποιο πεδίο είναι τελικά DATE στη βάση, όλες οι τιμές του θα βγουν άκυρες.
      Τρέξε πρώτα το pre-check παρακάτω.
   4. Κωδικοί (active, flag κ.λπ.) συγκρίνονται ως κείμενο (TRIM(TO_CHAR(x))), ώστε
      να δουλεύουν είτε η στήλη είναι NUMBER είτε VARCHAR2. Μετράνε μόνο οι
      συμπληρωμένες τιμές.
   5. Αριθμητικά πεδία με τιμή που δεν είναι αριθμός μετρώνται ως κενά.
   6. Αν κάποιος πίνακας ή στήλη του DD δεν υπάρχει στο DATACUT5, το script σταματά
      με ORA-00942 / ORA-00904 και το μήνυμα λέει ποιο αντικείμενο λείπει. Τότε
      σχολίασε τις γραμμές t/f του ελέγχου και τη γραμμή του στο UNPIVOT
      (ή όλη την ενότητα του πίνακα).
   PRE-CHECK (τρέξε μία φορά πριν το script): τύποι πεδίων ημερομηνίας
   --------------------------------------------------------------------
   SELECT table_name, column_name, data_type
     FROM all_tab_columns
    WHERE owner = 'DATACUT5' AND column_name LIKE '%DATE%'
      AND table_name IN ('AUCTION','CAUTION','CLASSIFD','CLIENT','GARNISHEES','GUARDIANSHIP',
                         'INCAPACITATED','INTERDICTED','PROHIBITORY_INJUNCTIONS')
      AND data_type &lt;&gt; 'VARCHAR2'
   -- Αναμένεται να μη βγει καμία γραμμή.
   -- DC5: έτρεξε στις 04/11/2026, καμία γραμμή.
   ============================================================================= */
WITH
  -- Ημερομηνία αναφοράς για τους ελέγχους "στο μέλλον", ως κείμενο ISO. Για αναπαραγώγιμα αποτελέσματα βάλε την ημερομηνία του Data Cut.
  params AS (SELECT TO_CHAR(TRUNC(SYSDATE), 'YYYY-MM-DD') AS ref_iso FROM dual),
  -- Κοινές λίστες: υπολογίζονται ΜΙΑ φορά και τις χρησιμοποιούν όλοι οι έλεγχοι διασύνδεσης.
  -- παράμετροι WPARAM ανά ομάδα (groupid + ordinal)
  k_wp AS (
    SELECT /*+ MATERIALIZE */ DISTINCT TRIM(TO_CHAR("GROUPID")) AS g, TRIM(TO_CHAR("ORDINAL")) AS o FROM DATACUT5."WPARAM"
  ),
  -- παράμετροι WPARAM, όλες οι ομάδες (ordinal)
  k_wp_any AS (
    SELECT /*+ MATERIALIZE */ DISTINCT TRIM(TO_CHAR("ORDINAL")) AS o FROM DATACUT5."WPARAM"
  ),
  -- καταστήματα / τμήματα
  k_br AS (
    SELECT /*+ MATERIALIZE */ DISTINCT TRIM("CODE") AS code FROM DATACUT5."BRANCHES" WHERE TRIM("CODE") IS NOT NULL
  ),
  all_checks AS (
/* =============================================================================
   AUCTION - Auctions Table
   Πίνακας: DATACUT5."AUCTION"   Shadow: δεν υπάρχει mode flag   Έλεγχοι: 15
   ============================================================================= */
    SELECT 'AUCTION - Auctions Table' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- AUCTION-001: Missing Identification Number (IDNO)
          COUNT(*) AS t1,
          COUNT(CASE WHEN TRIM(TO_CHAR(t."IDNO")) IS NULL THEN 1 END) AS f1,
          -- AUCTION-002: Movable not 0/1 (MOVEABLE)
          COUNT(*) AS t2,
          COUNT(CASE WHEN TRIM(TO_CHAR(t."MOVEABLE")) IS NOT NULL AND TRIM(TO_CHAR(t."MOVEABLE")) NOT IN ('0','1') THEN 1 END) AS f2,
          -- AUCTION-003: Active not 0/1 (ACTIVE)
          COUNT(*) AS t3,
          COUNT(CASE WHEN TRIM(TO_CHAR(t."ACTIVE")) IS NOT NULL AND TRIM(TO_CHAR(t."ACTIVE")) NOT IN ('0','1') THEN 1 END) AS f3,
          -- AUCTION-004: Audit flag not D/U/I (FLAG)
          COUNT(*) AS t4,
          COUNT(CASE WHEN TRIM(TO_CHAR(t."FLAG")) IS NOT NULL AND TRIM(TO_CHAR(t."FLAG")) NOT IN ('D','U','I') THEN 1 END) AS f4,
          -- AUCTION-005: Negative Amount (Value) (AMOUNT)
          COUNT(*) AS t5,
          COUNT(CASE WHEN (CASE WHEN VALIDATE_CONVERSION(TRIM(TO_CHAR(t."AMOUNT")) AS NUMBER) = 1 THEN TO_NUMBER(TRIM(TO_CHAR(t."AMOUNT"))) END) &lt; 0 THEN 1 END) AS f5,
          -- AUCTION-006: Invalid date: Caution Date (CAUTION_DATE)
          COUNT(*) AS t6,
          COUNT(CASE WHEN TRIM(t."CAUTION_DATE") IS NOT NULL AND NOT (REGEXP_LIKE(TRIM(t."CAUTION_DATE"), '^[0-9]{4}-[0-9]{2}-[0-9]{2}( [0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]+)?)?$') AND VALIDATE_CONVERSION(SUBSTR(TRIM(t."CAUTION_DATE"), 1, 10) AS DATE, 'YYYY-MM-DD') = 1 AND SUBSTR(TRIM(t."CAUTION_DATE"), 1, 10) &gt;= '1900-01-01') THEN 1 END) AS f6,
          -- AUCTION-007: Invalid date: Entry Date (ENTRY_DATE)
          COUNT(*) AS t7,
          COUNT(CASE WHEN TRIM(t."ENTRY_DATE") IS NOT NULL AND NOT (REGEXP_LIKE(TRIM(t."ENTRY_DATE"), '^[0-9]{4}-[0-9]{2}-[0-9]{2}( [0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]+)?)?$') AND VALIDATE_CONVERSION(SUBSTR(TRIM(t."ENTRY_DATE"), 1, 10) AS DATE, 'YYYY-MM-DD') = 1 AND SUBSTR(TRIM(t."ENTRY_DATE"), 1, 10) &gt;= '1900-01-01') THEN 1 END) AS f7,
          -- AUCTION-008: Invalid date: Capture Date (CAPTURE_DATE)
          COUNT(*) AS t8,
          COUNT(CASE WHEN TRIM(t."CAPTURE_DATE") IS NOT NULL AND NOT (REGEXP_LIKE(TRIM(t."CAPTURE_DATE"), '^[0-9]{4}-[0-9]{2}-[0-9]{2}( [0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]+)?)?$') AND VALIDATE_CONVERSION(SUBSTR(TRIM(t."CAPTURE_DATE"), 1, 10) AS DATE, 'YYYY-MM-DD') = 1 AND SUBSTR(TRIM(t."CAPTURE_DATE"), 1, 10) &gt;= '1900-01-01') THEN 1 END) AS f8,
          -- AUCTION-009: Invalid date: Last Date (LAST_DATE)
          COUNT(*) AS t9,
          COUNT(CASE WHEN TRIM(t."LAST_DATE") IS NOT NULL AND NOT (REGEXP_LIKE(TRIM(t."LAST_DATE"), '^[0-9]{4}-[0-9]{2}-[0-9]{2}( [0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]+)?)?$') AND VALIDATE_CONVERSION(SUBSTR(TRIM(t."LAST_DATE"), 1, 10) AS DATE, 'YYYY-MM-DD') = 1 AND SUBSTR(TRIM(t."LAST_DATE"), 1, 10) &gt;= '1900-01-01') THEN 1 END) AS f9,
          -- AUCTION-010: Invalid date: Inactive Date (INA_DATE)
          COUNT(*) AS t10,
          COUNT(CASE WHEN TRIM(t."INA_DATE") IS NOT NULL AND NOT (REGEXP_LIKE(TRIM(t."INA_DATE"), '^[0-9]{4}-[0-9]{2}-[0-9]{2}( [0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]+)?)?$') AND VALIDATE_CONVERSION(SUBSTR(TRIM(t."INA_DATE"), 1, 10) AS DATE, 'YYYY-MM-DD') = 1 AND SUBSTR(TRIM(t."INA_DATE"), 1, 10) &gt;= '1900-01-01') THEN 1 END) AS f10,
          -- AUCTION-011: Invalid date: Date Marked Inactive (DATE_MARKED_INACTIVE)
          COUNT(*) AS t11,
          COUNT(CASE WHEN TRIM(t."DATE_MARKED_INACTIVE") IS NOT NULL AND NOT (REGEXP_LIKE(TRIM(t."DATE_MARKED_INACTIVE"), '^[0-9]{4}-[0-9]{2}-[0-9]{2}( [0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]+)?)?$') AND VALIDATE_CONVERSION(SUBSTR(TRIM(t."DATE_MARKED_INACTIVE"), 1, 10) AS DATE, 'YYYY-MM-DD') = 1 AND SUBSTR(TRIM(t."DATE_MARKED_INACTIVE"), 1, 10) &gt;= '1900-01-01') THEN 1 END) AS f11,
          -- AUCTION-012: Invalid date: Review Date (REVIEW_DATE)
          COUNT(*) AS t12,
          COUNT(CASE WHEN TRIM(t."REVIEW_DATE") IS NOT NULL AND NOT (REGEXP_LIKE(TRIM(t."REVIEW_DATE"), '^[0-9]{4}-[0-9]{2}-[0-9]{2}( [0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]+)?)?$') AND VALIDATE_CONVERSION(SUBSTR(TRIM(t."REVIEW_DATE"), 1, 10) AS DATE, 'YYYY-MM-DD') = 1 AND SUBSTR(TRIM(t."REVIEW_DATE"), 1, 10) &gt;= '1900-01-01') THEN 1 END) AS f12,
          -- AUCTION-013: Detail No (what type of Warning) (DETAIL_NO) not found in WPARAM
          COUNT(CASE WHEN TRIM(TO_CHAR(t."DETAIL_NO")) IS NOT NULL THEN 1 END) AS t13,
          COUNT(CASE WHEN TRIM(TO_CHAR(t."DETAIL_NO")) IS NOT NULL AND j1.o IS NULL THEN 1 END) AS f13,
          -- AUCTION-014: Branch (BRANCH) not found in BRANCHES
          COUNT(CASE WHEN TRIM(t."BRANCH") IS NOT NULL THEN 1 END) AS t14,
          COUNT(CASE WHEN TRIM(t."BRANCH") IS NOT NULL AND j2.code IS NULL THEN 1 END) AS f14,
          -- AUCTION-015: Active record (ACTIVE=1) with inactive date (INA_DATE/DATE_MARKED_INACTIVE)
          COUNT(CASE WHEN TRIM(TO_CHAR(t."ACTIVE")) = '1' THEN 1 END) AS t15,
          COUNT(CASE WHEN TRIM(TO_CHAR(t."ACTIVE")) = '1' AND (TRIM(t."INA_DATE") IS NOT NULL OR TRIM(t."DATE_MARKED_INACTIVE") IS NOT NULL) THEN 1 END) AS f15
        FROM DATACUT5."AUCTION" t
        CROSS JOIN params p
        LEFT JOIN k_wp_any j1 ON j1.o = TRIM(TO_CHAR(t."DETAIL_NO"))
        LEFT JOIN k_br j2 ON j2.code = TRIM(t."BRANCH")
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'AUCTION-001|Missing Data|Missing Identification Number (IDNO)',
        (t2, f2) AS 'AUCTION-002|Invalid Values|Movable not 0/1 (MOVEABLE)',
        (t3, f3) AS 'AUCTION-003|Invalid Values|Active not 0/1 (ACTIVE)',
        (t4, f4) AS 'AUCTION-004|Invalid Values|Audit flag not D/U/I (FLAG)',
        (t5, f5) AS 'AUCTION-005|Invalid Values|Negative Amount (Value) (AMOUNT)',
        (t6, f6) AS 'AUCTION-006|Invalid Dates|Invalid date: Caution Date (CAUTION_DATE)',
        (t7, f7) AS 'AUCTION-007|Invalid Dates|Invalid date: Entry Date (ENTRY_DATE)',
        (t8, f8) AS 'AUCTION-008|Invalid Dates|Invalid date: Capture Date (CAPTURE_DATE)',
        (t9, f9) AS 'AUCTION-009|Invalid Dates|Invalid date: Last Date (LAST_DATE)',
        (t10, f10) AS 'AUCTION-010|Invalid Dates|Invalid date: Inactive Date (INA_DATE)',
        (t11, f11) AS 'AUCTION-011|Invalid Dates|Invalid date: Date Marked Inactive (DATE_MARKED_INACTIVE)',
        (t12, f12) AS 'AUCTION-012|Invalid Dates|Invalid date: Review Date (REVIEW_DATE)',
        (t13, f13) AS 'AUCTION-013|Missing Links|Detail No (what type of Warning) (DETAIL_NO) not found in WPARAM',
        (t14, f14) AS 'AUCTION-014|Missing Links|Branch (BRANCH) not found in BRANCHES',
        (t15, f15) AS 'AUCTION-015|Inconsistent Data|Active record (ACTIVE=1) with inactive date (INA_DATE/DATE_MARKED_INACTIVE)'
      ))
    UNION ALL
/* =============================================================================
   CAUTION - Cautions Table
   Πίνακας: DATACUT5."CAUTION"   Shadow: δεν υπάρχει mode flag   Έλεγχοι: 29
   ============================================================================= */
    SELECT 'CAUTION - Cautions Table' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- CAUTION-001: Missing Identification Number (IDNO)
          COUNT(*) AS t1,
          COUNT(CASE WHEN TRIM(TO_CHAR(t."IDNO")) IS NULL THEN 1 END) AS f1,
          -- CAUTION-002: Missing Caution Number (CAUTION_NO)
          COUNT(*) AS t2,
          COUNT(CASE WHEN TRIM(TO_CHAR(t."CAUTION_NO")) IS NULL THEN 1 END) AS f2,
          -- CAUTION-003: Missing Free Form Narrative (DESCRIPTION)
          COUNT(*) AS t3,
          COUNT(CASE WHEN TRIM(TO_CHAR(t."DESCRIPTION")) IS NULL THEN 1 END) AS f3,
          -- CAUTION-004: Missing Detail No (what type of Warning) (DETAIL_NO)
          COUNT(*) AS t4,
          COUNT(CASE WHEN TRIM(TO_CHAR(t."DETAIL_NO")) IS NULL THEN 1 END) AS f4,
          -- CAUTION-005: Missing Branch Responsible (BRANCH)
          COUNT(*) AS t5,
          COUNT(CASE WHEN TRIM(TO_CHAR(t."BRANCH")) IS NULL THEN 1 END) AS f5,
          -- CAUTION-006: Active not 0/1/2 (ACTIVE)
          COUNT(*) AS t6,
          COUNT(CASE WHEN TRIM(TO_CHAR(t."ACTIVE")) IS NOT NULL AND TRIM(TO_CHAR(t."ACTIVE")) NOT IN ('0','1','2') THEN 1 END) AS f6,
          -- CAUTION-007: Audit flag not D/U/I (FLAG)
          COUNT(*) AS t7,
          COUNT(CASE WHEN TRIM(TO_CHAR(t."FLAG")) IS NOT NULL AND TRIM(TO_CHAR(t."FLAG")) NOT IN ('D','U','I') THEN 1 END) AS f7,
          -- CAUTION-008: Invalid date: Caution Date (CAUTION_DATE)
          COUNT(*) AS t8,
          COUNT(CASE WHEN TRIM(t."CAUTION_DATE") IS NOT NULL AND NOT (REGEXP_LIKE(TRIM(t."CAUTION_DATE"), '^[0-9]{4}-[0-9]{2}-[0-9]{2}( [0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]+)?)?$') AND VALIDATE_CONVERSION(SUBSTR(TRIM(t."CAUTION_DATE"), 1, 10) AS DATE, 'YYYY-MM-DD') = 1 AND SUBSTR(TRIM(t."CAUTION_DATE"), 1, 10) &gt;= '1900-01-01') THEN 1 END) AS f8,
          -- CAUTION-009: Invalid date: Record Entry Date (ENTRY_DATE)
          COUNT(*) AS t9,
          COUNT(CASE WHEN TRIM(t."ENTRY_DATE") IS NOT NULL AND NOT (REGEXP_LIKE(TRIM(t."ENTRY_DATE"), '^[0-9]{4}-[0-9]{2}-[0-9]{2}( [0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]+)?)?$') AND VALIDATE_CONVERSION(SUBSTR(TRIM(t."ENTRY_DATE"), 1, 10) AS DATE, 'YYYY-MM-DD') = 1 AND SUBSTR(TRIM(t."ENTRY_DATE"), 1, 10) &gt;= '1900-01-01') THEN 1 END) AS f9,
          -- CAUTION-010: Invalid date: Capture Date (CAPTURE_DATE)
          COUNT(*) AS t10,
          COUNT(CASE WHEN TRIM(t."CAPTURE_DATE") IS NOT NULL AND NOT (REGEXP_LIKE(TRIM(t."CAPTURE_DATE"), '^[0-9]{4}-[0-9]{2}-[0-9]{2}( [0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]+)?)?$') AND VALIDATE_CONVERSION(SUBSTR(TRIM(t."CAPTURE_DATE"), 1, 10) AS DATE, 'YYYY-MM-DD') = 1 AND SUBSTR(TRIM(t."CAPTURE_DATE"), 1, 10) &gt;= '1900-01-01') THEN 1 END) AS f10,
          -- CAUTION-011: Invalid date: Last Date (LAST_DATE)
          COUNT(*) AS t11,
          COUNT(CASE WHEN TRIM(t."LAST_DATE") IS NOT NULL AND NOT (REGEXP_LIKE(TRIM(t."LAST_DATE"), '^[0-9]{4}-[0-9]{2}-[0-9]{2}( [0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]+)?)?$') AND VALIDATE_CONVERSION(SUBSTR(TRIM(t."LAST_DATE"), 1, 10) AS DATE, 'YYYY-MM-DD') = 1 AND SUBSTR(TRIM(t."LAST_DATE"), 1, 10) &gt;= '1900-01-01') THEN 1 END) AS f11,
          -- CAUTION-012: Invalid date: Inactive Date (INA_DATE)
          COUNT(*) AS t12,
          COUNT(CASE WHEN TRIM(t."INA_DATE") IS NOT NULL AND NOT (REGEXP_LIKE(TRIM(t."INA_DATE"), '^[0-9]{4}-[0-9]{2}-[0-9]{2}( [0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]+)?)?$') AND VALIDATE_CONVERSION(SUBSTR(TRIM(t."INA_DATE"), 1, 10) AS DATE, 'YYYY-MM-DD') = 1 AND SUBSTR(TRIM(t."INA_DATE"), 1, 10) &gt;= '1900-01-01') THEN 1 END) AS f12,
          -- CAUTION-013: Invalid date: Date Marked Inactive (DATE_MARKED_INACTIVE)
          COUNT(*) AS t13,
          COUNT(CASE WHEN TRIM(t."DATE_MARKED_INACTIVE") IS NOT NULL AND NOT (REGEXP_LIKE(TRIM(t."DATE_MARKED_INACTIVE"), '^[0-9]{4}-[0-9]{2}-[0-9]{2}( [0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]+)?)?$') AND VALIDATE_CONVERSION(SUBSTR(TRIM(t."DATE_MARKED_INACTIVE"), 1, 10) AS DATE, 'YYYY-MM-DD') = 1 AND SUBSTR(TRIM(t."DATE_MARKED_INACTIVE"), 1, 10) &gt;= '1900-01-01') THEN 1 END) AS f13,
          -- CAUTION-014: Invalid date: Write Off Date (WRITE_OFF_DATE)
          COUNT(*) AS t14,
          COUNT(CASE WHEN TRIM(t."WRITE_OFF_DATE") IS NOT NULL AND NOT (REGEXP_LIKE(TRIM(t."WRITE_OFF_DATE"), '^[0-9]{4}-[0-9]{2}-[0-9]{2}( [0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]+)?)?$') AND VALIDATE_CONVERSION(SUBSTR(TRIM(t."WRITE_OFF_DATE"), 1, 10) AS DATE, 'YYYY-MM-DD') = 1 AND SUBSTR(TRIM(t."WRITE_OFF_DATE"), 1, 10) &gt;= '1900-01-01') THEN 1 END) AS f14,
          -- CAUTION-015: Invalid date: Expiry Date (EXPIRY_DATE)
          COUNT(*) AS t15,
          COUNT(CASE WHEN TRIM(t."EXPIRY_DATE") IS NOT NULL AND NOT (REGEXP_LIKE(TRIM(t."EXPIRY_DATE"), '^[0-9]{4}-[0-9]{2}-[0-9]{2}( [0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]+)?)?$') AND VALIDATE_CONVERSION(SUBSTR(TRIM(t."EXPIRY_DATE"), 1, 10) AS DATE, 'YYYY-MM-DD') = 1 AND SUBSTR(TRIM(t."EXPIRY_DATE"), 1, 10) &gt;= '1900-01-01') THEN 1 END) AS f15,
          -- CAUTION-016: Invalid date: Review Date (REVIEW_DATE)
          COUNT(*) AS t16,
          COUNT(CASE WHEN TRIM(t."REVIEW_DATE") IS NOT NULL AND NOT (REGEXP_LIKE(TRIM(t."REVIEW_DATE"), '^[0-9]{4}-[0-9]{2}-[0-9]{2}( [0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]+)?)?$') AND VALIDATE_CONVERSION(SUBSTR(TRIM(t."REVIEW_DATE"), 1, 10) AS DATE, 'YYYY-MM-DD') = 1 AND SUBSTR(TRIM(t."REVIEW_DATE"), 1, 10) &gt;= '1900-01-01') THEN 1 END) AS f16,
          -- CAUTION-017: Future date: Caution Date (CAUTION_DATE)
          COUNT(CASE WHEN (REGEXP_LIKE(TRIM(t."CAUTION_DATE"), '^[0-9]{4}-[0-9]{2}-[0-9]{2}( [0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]+)?)?$') AND VALIDATE_CONVERSION(SUBSTR(TRIM(t."CAUTION_DATE"), 1, 10) AS DATE, 'YYYY-MM-DD') = 1 AND SUBSTR(TRIM(t."CAUTION_DATE"), 1, 10) &gt;= '1900-01-01') THEN 1 END) AS t17,
          COUNT(CASE WHEN (REGEXP_LIKE(TRIM(t."CAUTION_DATE"), '^[0-9]{4}-[0-9]{2}-[0-9]{2}( [0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]+)?)?$') AND VALIDATE_CONVERSION(SUBSTR(TRIM(t."CAUTION_DATE"), 1, 10) AS DATE, 'YYYY-MM-DD') = 1 AND SUBSTR(TRIM(t."CAUTION_DATE"), 1, 10) &gt;= '1900-01-01') AND SUBSTR(TRIM(t."CAUTION_DATE"), 1, 10) &gt; p.ref_iso THEN 1 END) AS f17,
          -- CAUTION-018: Future date: Record Entry Date (ENTRY_DATE)
          COUNT(CASE WHEN (REGEXP_LIKE(TRIM(t."ENTRY_DATE"), '^[0-9]{4}-[0-9]{2}-[0-9]{2}( [0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]+)?)?$') AND VALIDATE_CONVERSION(SUBSTR(TRIM(t."ENTRY_DATE"), 1, 10) AS DATE, 'YYYY-MM-DD') = 1 AND SUBSTR(TRIM(t."ENTRY_DATE"), 1, 10) &gt;= '1900-01-01') THEN 1 END) AS t18,
          COUNT(CASE WHEN (REGEXP_LIKE(TRIM(t."ENTRY_DATE"), '^[0-9]{4}-[0-9]{2}-[0-9]{2}( [0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]+)?)?$') AND VALIDATE_CONVERSION(SUBSTR(TRIM(t."ENTRY_DATE"), 1, 10) AS DATE, 'YYYY-MM-DD') = 1 AND SUBSTR(TRIM(t."ENTRY_DATE"), 1, 10) &gt;= '1900-01-01') AND SUBSTR(TRIM(t."ENTRY_DATE"), 1, 10) &gt; p.ref_iso THEN 1 END) AS f18,
          -- CAUTION-019: Future date: Capture Date (CAPTURE_DATE)
          COUNT(CASE WHEN (REGEXP_LIKE(TRIM(t."CAPTURE_DATE"), '^[0-9]{4}-[0-9]{2}-[0-9]{2}( [0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]+)?)?$') AND VALIDATE_CONVERSION(SUBSTR(TRIM(t."CAPTURE_DATE"), 1, 10) AS DATE, 'YYYY-MM-DD') = 1 AND SUBSTR(TRIM(t."CAPTURE_DATE"), 1, 10) &gt;= '1900-01-01') THEN 1 END) AS t19,
          COUNT(CASE WHEN (REGEXP_LIKE(TRIM(t."CAPTURE_DATE"), '^[0-9]{4}-[0-9]{2}-[0-9]{2}( [0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]+)?)?$') AND VALIDATE_CONVERSION(SUBSTR(TRIM(t."CAPTURE_DATE"), 1, 10) AS DATE, 'YYYY-MM-DD') = 1 AND SUBSTR(TRIM(t."CAPTURE_DATE"), 1, 10) &gt;= '1900-01-01') AND SUBSTR(TRIM(t."CAPTURE_DATE"), 1, 10) &gt; p.ref_iso THEN 1 END) AS f19,
          -- CAUTION-020: Future date: Last Date (LAST_DATE)
          COUNT(CASE WHEN (REGEXP_LIKE(TRIM(t."LAST_DATE"), '^[0-9]{4}-[0-9]{2}-[0-9]{2}( [0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]+)?)?$') AND VALIDATE_CONVERSION(SUBSTR(TRIM(t."LAST_DATE"), 1, 10) AS DATE, 'YYYY-MM-DD') = 1 AND SUBSTR(TRIM(t."LAST_DATE"), 1, 10) &gt;= '1900-01-01') THEN 1 END) AS t20,
          COUNT(CASE WHEN (REGEXP_LIKE(TRIM(t."LAST_DATE"), '^[0-9]{4}-[0-9]{2}-[0-9]{2}( [0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]+)?)?$') AND VALIDATE_CONVERSION(SUBSTR(TRIM(t."LAST_DATE"), 1, 10) AS DATE, 'YYYY-MM-DD') = 1 AND SUBSTR(TRIM(t."LAST_DATE"), 1, 10) &gt;= '1900-01-01') AND SUBSTR(TRIM(t."LAST_DATE"), 1, 10) &gt; p.ref_iso THEN 1 END) AS f20,
          -- CAUTION-021: Future date: Inactive Date (INA_DATE)
          COUNT(CASE WHEN (REGEXP_LIKE(TRIM(t."INA_DATE"), '^[0-9]{4}-[0-9]{2}-[0-9]{2}( [0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]+)?)?$') AND VALIDATE_CONVERSION(SUBSTR(TRIM(t."INA_DATE"), 1, 10) AS DATE, 'YYYY-MM-DD') = 1 AND SUBSTR(TRIM(t."INA_DATE"), 1, 10) &gt;= '1900-01-01') THEN 1 END) AS t21,
          COUNT(CASE WHEN (REGEXP_LIKE(TRIM(t."INA_DATE"), '^[0-9]{4}-[0-9]{2}-[0-9]{2}( [0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]+)?)?$') AND VALIDATE_CONVERSION(SUBSTR(TRIM(t."INA_DATE"), 1, 10) AS DATE, 'YYYY-MM-DD') = 1 AND SUBSTR(TRIM(t."INA_DATE"), 1, 10) &gt;= '1900-01-01') AND SUBSTR(TRIM(t."INA_DATE"), 1, 10) &gt; p.ref_iso THEN 1 END) AS f21,
          -- CAUTION-022: Future date: Date Marked Inactive (DATE_MARKED_INACTIVE)
          COUNT(CASE WHEN (REGEXP_LIKE(TRIM(t."DATE_MARKED_INACTIVE"), '^[0-9]{4}-[0-9]{2}-[0-9]{2}( [0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]+)?)?$') AND VALIDATE_CONVERSION(SUBSTR(TRIM(t."DATE_MARKED_INACTIVE"), 1, 10) AS DATE, 'YYYY-MM-DD') = 1 AND SUBSTR(TRIM(t."DATE_MARKED_INACTIVE"), 1, 10) &gt;= '1900-01-01') THEN 1 END) AS t22,
          COUNT(CASE WHEN (REGEXP_LIKE(TRIM(t."DATE_MARKED_INACTIVE"), '^[0-9]{4}-[0-9]{2}-[0-9]{2}( [0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]+)?)?$') AND VALIDATE_CONVERSION(SUBSTR(TRIM(t."DATE_MARKED_INACTIVE"), 1, 10) AS DATE, 'YYYY-MM-DD') = 1 AND SUBSTR(TRIM(t."DATE_MARKED_INACTIVE"), 1, 10) &gt;= '1900-01-01') AND SUBSTR(TRIM(t."DATE_MARKED_INACTIVE"), 1, 10) &gt; p.ref_iso THEN 1 END) AS f22,
          -- CAUTION-023: Future date: Write Off Date (WRITE_OFF_DATE)
          COUNT(CASE WHEN (REGEXP_LIKE(TRIM(t."WRITE_OFF_DATE"), '^[0-9]{4}-[0-9]{2}-[0-9]{2}( [0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]+)?)?$') AND VALIDATE_CONVERSION(SUBSTR(TRIM(t."WRITE_OFF_DATE"), 1, 10) AS DATE, 'YYYY-MM-DD') = 1 AND SUBSTR(TRIM(t."WRITE_OFF_DATE"), 1, 10) &gt;= '1900-01-01') THEN 1 END) AS t23,
          COUNT(CASE WHEN (REGEXP_LIKE(TRIM(t."WRITE_OFF_DATE"), '^[0-9]{4}-[0-9]{2}-[0-9]{2}( [0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]+)?)?$') AND VALIDATE_CONVERSION(SUBSTR(TRIM(t."WRITE_OFF_DATE"), 1, 10) AS DATE, 'YYYY-MM-DD') = 1 AND SUBSTR(TRIM(t."WRITE_OFF_DATE"), 1, 10) &gt;= '1900-01-01') AND SUBSTR(TRIM(t."WRITE_OFF_DATE"), 1, 10) &gt; p.ref_iso THEN 1 END) AS f23,
          -- CAUTION-024: Detail No (what type of Warning) (DETAIL_NO) not found in WPARAM
          COUNT(CASE WHEN TRIM(TO_CHAR(t."DETAIL_NO")) IS NOT NULL THEN 1 END) AS t24,
          COUNT(CASE WHEN TRIM(TO_CHAR(t."DETAIL_NO")) IS NOT NULL AND j1.o IS NULL THEN 1 END) AS f24,
          -- CAUTION-025: Branch (BRANCH) not found in BRANCHES
          COUNT(CASE WHEN TRIM(t."BRANCH") IS NOT NULL THEN 1 END) AS t25,
          COUNT(CASE WHEN TRIM(t."BRANCH") IS NOT NULL AND j2.code IS NULL THEN 1 END) AS f25,
          -- CAUTION-026: Active record (ACTIVE=1) with inactive date (INA_DATE/DATE_MARKED_INACTIVE)
          COUNT(CASE WHEN TRIM(TO_CHAR(t."ACTIVE")) = '1' THEN 1 END) AS t26,
          COUNT(CASE WHEN TRIM(TO_CHAR(t."ACTIVE")) = '1' AND (TRIM(t."INA_DATE") IS NOT NULL OR TRIM(t."DATE_MARKED_INACTIVE") IS NOT NULL) THEN 1 END) AS f26,
          -- CAUTION-027: Inactive record (ACTIVE=0) without inactive date (INA_DATE/DATE_MARKED_INACTIVE)
          COUNT(CASE WHEN TRIM(TO_CHAR(t."ACTIVE")) = '0' THEN 1 END) AS t27,
          COUNT(CASE WHEN TRIM(TO_CHAR(t."ACTIVE")) = '0' AND TRIM(t."INA_DATE") IS NULL AND TRIM(t."DATE_MARKED_INACTIVE") IS NULL THEN 1 END) AS f27,
          -- CAUTION-028: Written-off record (ACTIVE=2) without write-off date (WRITE_OFF_DATE)
          COUNT(CASE WHEN TRIM(TO_CHAR(t."ACTIVE")) = '2' THEN 1 END) AS t28,
          COUNT(CASE WHEN TRIM(TO_CHAR(t."ACTIVE")) = '2' AND TRIM(t."WRITE_OFF_DATE") IS NULL THEN 1 END) AS f28,
          -- CAUTION-029: Expiry Date before Caution Date (EXPIRY_DATE &lt; CAUTION_DATE)
          COUNT(CASE WHEN (REGEXP_LIKE(TRIM(t."EXPIRY_DATE"), '^[0-9]{4}-[0-9]{2}-[0-9]{2}( [0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]+)?)?$') AND VALIDATE_CONVERSION(SUBSTR(TRIM(t."EXPIRY_DATE"), 1, 10) AS DATE, 'YYYY-MM-DD') = 1 AND SUBSTR(TRIM(t."EXPIRY_DATE"), 1, 10) &gt;= '1900-01-01') AND (REGEXP_LIKE(TRIM(t."CAUTION_DATE"), '^[0-9]{4}-[0-9]{2}-[0-9]{2}( [0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]+)?)?$') AND VALIDATE_CONVERSION(SUBSTR(TRIM(t."CAUTION_DATE"), 1, 10) AS DATE, 'YYYY-MM-DD') = 1 AND SUBSTR(TRIM(t."CAUTION_DATE"), 1, 10) &gt;= '1900-01-01') THEN 1 END) AS t29,
          COUNT(CASE WHEN (REGEXP_LIKE(TRIM(t."EXPIRY_DATE"), '^[0-9]{4}-[0-9]{2}-[0-9]{2}( [0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]+)?)?$') AND VALIDATE_CONVERSION(SUBSTR(TRIM(t."EXPIRY_DATE"), 1, 10) AS DATE, 'YYYY-MM-DD') = 1 AND SUBSTR(TRIM(t."EXPIRY_DATE"), 1, 10) &gt;= '1900-01-01') AND (REGEXP_LIKE(TRIM(t."CAUTION_DATE"), '^[0-9]{4}-[0-9]{2}-[0-9]{2}( [0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]+)?)?$') AND VALIDATE_CONVERSION(SUBSTR(TRIM(t."CAUTION_DATE"), 1, 10) AS DATE, 'YYYY-MM-DD') = 1 AND SUBSTR(TRIM(t."CAUTION_DATE"), 1, 10) &gt;= '1900-01-01') AND SUBSTR(TRIM(t."EXPIRY_DATE"), 1, 10) &lt; SUBSTR(TRIM(t."CAUTION_DATE"), 1, 10) THEN 1 END) AS f29
        FROM DATACUT5."CAUTION" t
        CROSS JOIN params p
        LEFT JOIN k_wp_any j1 ON j1.o = TRIM(TO_CHAR(t."DETAIL_NO"))
        LEFT JOIN k_br j2 ON j2.code = TRIM(t."BRANCH")
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'CAUTION-001|Missing Data|Missing Identification Number (IDNO)',
        (t2, f2) AS 'CAUTION-002|Missing Data|Missing Caution Number (CAUTION_NO)',
        (t3, f3) AS 'CAUTION-003|Missing Data|Missing Free Form Narrative (DESCRIPTION)',
        (t4, f4) AS 'CAUTION-004|Missing Data|Missing Detail No (what type of Warning) (DETAIL_NO)',
        (t5, f5) AS 'CAUTION-005|Missing Data|Missing Branch Responsible (BRANCH)',
        (t6, f6) AS 'CAUTION-006|Invalid Values|Active not 0/1/2 (ACTIVE)',
        (t7, f7) AS 'CAUTION-007|Invalid Values|Audit flag not D/U/I (FLAG)',
        (t8, f8) AS 'CAUTION-008|Invalid Dates|Invalid date: Caution Date (CAUTION_DATE)',
        (t9, f9) AS 'CAUTION-009|Invalid Dates|Invalid date: Record Entry Date (ENTRY_DATE)',
        (t10, f10) AS 'CAUTION-010|Invalid Dates|Invalid date: Capture Date (CAPTURE_DATE)',
        (t11, f11) AS 'CAUTION-011|Invalid Dates|Invalid date: Last Date (LAST_DATE)',
        (t12, f12) AS 'CAUTION-012|Invalid Dates|Invalid date: Inactive Date (INA_DATE)',
        (t13, f13) AS 'CAUTION-013|Invalid Dates|Invalid date: Date Marked Inactive (DATE_MARKED_INACTIVE)',
        (t14, f14) AS 'CAUTION-014|Invalid Dates|Invalid date: Write Off Date (WRITE_OFF_DATE)',
        (t15, f15) AS 'CAUTION-015|Invalid Dates|Invalid date: Expiry Date (EXPIRY_DATE)',
        (t16, f16) AS 'CAUTION-016|Invalid Dates|Invalid date: Review Date (REVIEW_DATE)',
        (t17, f17) AS 'CAUTION-017|Invalid Dates|Future date: Caution Date (CAUTION_DATE)',
        (t18, f18) AS 'CAUTION-018|Invalid Dates|Future date: Record Entry Date (ENTRY_DATE)',
        (t19, f19) AS 'CAUTION-019|Invalid Dates|Future date: Capture Date (CAPTURE_DATE)',
        (t20, f20) AS 'CAUTION-020|Invalid Dates|Future date: Last Date (LAST_DATE)',
        (t21, f21) AS 'CAUTION-021|Invalid Dates|Future date: Inactive Date (INA_DATE)',
        (t22, f22) AS 'CAUTION-022|Invalid Dates|Future date: Date Marked Inactive (DATE_MARKED_INACTIVE)',
        (t23, f23) AS 'CAUTION-023|Invalid Dates|Future date: Write Off Date (WRITE_OFF_DATE)',
        (t24, f24) AS 'CAUTION-024|Missing Links|Detail No (what type of Warning) (DETAIL_NO) not found in WPARAM',
        (t25, f25) AS 'CAUTION-025|Missing Links|Branch (BRANCH) not found in BRANCHES',
        (t26, f26) AS 'CAUTION-026|Inconsistent Data|Active record (ACTIVE=1) with inactive date (INA_DATE/DATE_MARKED_INACTIVE)',
        (t27, f27) AS 'CAUTION-027|Inconsistent Data|Inactive record (ACTIVE=0) without inactive date (INA_DATE/DATE_MARKED_INACTIVE)',
        (t28, f28) AS 'CAUTION-028|Inconsistent Data|Written-off record (ACTIVE=2) without write-off date (WRITE_OFF_DATE)',
        (t29, f29) AS 'CAUTION-029|Inconsistent Data|Expiry Date before Caution Date (EXPIRY_DATE &lt; CAUTION_DATE)'
      ))
    UNION ALL
/* =============================================================================
   CLASSIFD - Classified Debts Table
   Πίνακας: DATACUT5."CLASSIFD"   Shadow: δεν υπάρχει mode flag   Έλεγχοι: 17
   ============================================================================= */
    SELECT 'CLASSIFD - Classified Debts Table' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- CLASSIFD-001: Missing Identification Number (IDNO)
          COUNT(*) AS t1,
          COUNT(CASE WHEN TRIM(TO_CHAR(t."IDNO")) IS NULL THEN 1 END) AS f1,
          -- CLASSIFD-002: Active not 0/1/2 (ACTIVE)
          COUNT(*) AS t2,
          COUNT(CASE WHEN TRIM(TO_CHAR(t."ACTIVE")) IS NOT NULL AND TRIM(TO_CHAR(t."ACTIVE")) NOT IN ('0','1','2') THEN 1 END) AS f2,
          -- CLASSIFD-003: Audit flag not D/U/I (FLAG)
          COUNT(*) AS t3,
          COUNT(CASE WHEN TRIM(TO_CHAR(t."FLAG")) IS NOT NULL AND TRIM(TO_CHAR(t."FLAG")) NOT IN ('D','U','I') THEN 1 END) AS f3,
          -- CLASSIFD-004: Invalid date: Date Classified (CLASSIFIED_DATE)
          COUNT(*) AS t4,
          COUNT(CASE WHEN TRIM(t."CLASSIFIED_DATE") IS NOT NULL AND NOT (REGEXP_LIKE(TRIM(t."CLASSIFIED_DATE"), '^[0-9]{4}-[0-9]{2}-[0-9]{2}( [0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]+)?)?$') AND VALIDATE_CONVERSION(SUBSTR(TRIM(t."CLASSIFIED_DATE"), 1, 10) AS DATE, 'YYYY-MM-DD') = 1 AND SUBSTR(TRIM(t."CLASSIFIED_DATE"), 1, 10) &gt;= '1900-01-01') THEN 1 END) AS f4,
          -- CLASSIFD-005: Invalid date: Record Entry Date (ENTRY_DATE)
          COUNT(*) AS t5,
          COUNT(CASE WHEN TRIM(t."ENTRY_DATE") IS NOT NULL AND NOT (REGEXP_LIKE(TRIM(t."ENTRY_DATE"), '^[0-9]{4}-[0-9]{2}-[0-9]{2}( [0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]+)?)?$') AND VALIDATE_CONVERSION(SUBSTR(TRIM(t."ENTRY_DATE"), 1, 10) AS DATE, 'YYYY-MM-DD') = 1 AND SUBSTR(TRIM(t."ENTRY_DATE"), 1, 10) &gt;= '1900-01-01') THEN 1 END) AS f5,
          -- CLASSIFD-006: Invalid date: Capture Date (CAPTURE_DATE)
          COUNT(*) AS t6,
          COUNT(CASE WHEN TRIM(t."CAPTURE_DATE") IS NOT NULL AND NOT (REGEXP_LIKE(TRIM(t."CAPTURE_DATE"), '^[0-9]{4}-[0-9]{2}-[0-9]{2}( [0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]+)?)?$') AND VALIDATE_CONVERSION(SUBSTR(TRIM(t."CAPTURE_DATE"), 1, 10) AS DATE, 'YYYY-MM-DD') = 1 AND SUBSTR(TRIM(t."CAPTURE_DATE"), 1, 10) &gt;= '1900-01-01') THEN 1 END) AS f6,
          -- CLASSIFD-007: Invalid date: Last Date (LAST_DATE)
          COUNT(*) AS t7,
          COUNT(CASE WHEN TRIM(t."LAST_DATE") IS NOT NULL AND NOT (REGEXP_LIKE(TRIM(t."LAST_DATE"), '^[0-9]{4}-[0-9]{2}-[0-9]{2}( [0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]+)?)?$') AND VALIDATE_CONVERSION(SUBSTR(TRIM(t."LAST_DATE"), 1, 10) AS DATE, 'YYYY-MM-DD') = 1 AND SUBSTR(TRIM(t."LAST_DATE"), 1, 10) &gt;= '1900-01-01') THEN 1 END) AS f7,
          -- CLASSIFD-008: Invalid date: Inactive Date (INA_DATE)
          COUNT(*) AS t8,
          COUNT(CASE WHEN TRIM(t."INA_DATE") IS NOT NULL AND NOT (REGEXP_LIKE(TRIM(t."INA_DATE"), '^[0-9]{4}-[0-9]{2}-[0-9]{2}( [0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]+)?)?$') AND VALIDATE_CONVERSION(SUBSTR(TRIM(t."INA_DATE"), 1, 10) AS DATE, 'YYYY-MM-DD') = 1 AND SUBSTR(TRIM(t."INA_DATE"), 1, 10) &gt;= '1900-01-01') THEN 1 END) AS f8,
          -- CLASSIFD-009: Invalid date: Date Marked Inactive (DATE_MARKED_INACTIVE)
          COUNT(*) AS t9,
          COUNT(CASE WHEN TRIM(t."DATE_MARKED_INACTIVE") IS NOT NULL AND NOT (REGEXP_LIKE(TRIM(t."DATE_MARKED_INACTIVE"), '^[0-9]{4}-[0-9]{2}-[0-9]{2}( [0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]+)?)?$') AND VALIDATE_CONVERSION(SUBSTR(TRIM(t."DATE_MARKED_INACTIVE"), 1, 10) AS DATE, 'YYYY-MM-DD') = 1 AND SUBSTR(TRIM(t."DATE_MARKED_INACTIVE"), 1, 10) &gt;= '1900-01-01') THEN 1 END) AS f9,
          -- CLASSIFD-010: Invalid date: Write Off Date (WRITE_OFF_DATE)
          COUNT(*) AS t10,
          COUNT(CASE WHEN TRIM(t."WRITE_OFF_DATE") IS NOT NULL AND NOT (REGEXP_LIKE(TRIM(t."WRITE_OFF_DATE"), '^[0-9]{4}-[0-9]{2}-[0-9]{2}( [0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]+)?)?$') AND VALIDATE_CONVERSION(SUBSTR(TRIM(t."WRITE_OFF_DATE"), 1, 10) AS DATE, 'YYYY-MM-DD') = 1 AND SUBSTR(TRIM(t."WRITE_OFF_DATE"), 1, 10) &gt;= '1900-01-01') THEN 1 END) AS f10,
          -- CLASSIFD-011: Invalid date: JSS Call Date (JSS_CALL_DATE)
          COUNT(*) AS t11,
          COUNT(CASE WHEN TRIM(t."JSS_CALL_DATE") IS NOT NULL AND NOT (REGEXP_LIKE(TRIM(t."JSS_CALL_DATE"), '^[0-9]{4}-[0-9]{2}-[0-9]{2}( [0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]+)?)?$') AND VALIDATE_CONVERSION(SUBSTR(TRIM(t."JSS_CALL_DATE"), 1, 10) AS DATE, 'YYYY-MM-DD') = 1 AND SUBSTR(TRIM(t."JSS_CALL_DATE"), 1, 10) &gt;= '1900-01-01') THEN 1 END) AS f11,
          -- CLASSIFD-012: Invalid date: Review Date (REVIEW_DATE)
          COUNT(*) AS t12,
          COUNT(CASE WHEN TRIM(t."REVIEW_DATE") IS NOT NULL AND NOT (REGEXP_LIKE(TRIM(t."REVIEW_DATE"), '^[0-9]{4}-[0-9]{2}-[0-9]{2}( [0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]+)?)?$') AND VALIDATE_CONVERSION(SUBSTR(TRIM(t."REVIEW_DATE"), 1, 10) AS DATE, 'YYYY-MM-DD') = 1 AND SUBSTR(TRIM(t."REVIEW_DATE"), 1, 10) &gt;= '1900-01-01') THEN 1 END) AS f12,
          -- CLASSIFD-013: Description (classified debts description) (MARKER) not found in WPARAM group 3
          COUNT(CASE WHEN TRIM(TO_CHAR(t."MARKER")) IS NOT NULL THEN 1 END) AS t13,
          COUNT(CASE WHEN TRIM(TO_CHAR(t."MARKER")) IS NOT NULL AND j1.o IS NULL THEN 1 END) AS f13,
          -- CLASSIFD-014: Remarks (classified debts remarks) (REMARKS_NO) not found in WPARAM group 2
          COUNT(CASE WHEN TRIM(TO_CHAR(t."REMARKS_NO")) IS NOT NULL THEN 1 END) AS t14,
          COUNT(CASE WHEN TRIM(TO_CHAR(t."REMARKS_NO")) IS NOT NULL AND j2.o IS NULL THEN 1 END) AS f14,
          -- CLASSIFD-015: Branch (BRANCH) not found in BRANCHES
          COUNT(CASE WHEN TRIM(t."BRANCH") IS NOT NULL THEN 1 END) AS t15,
          COUNT(CASE WHEN TRIM(t."BRANCH") IS NOT NULL AND j3.code IS NULL THEN 1 END) AS f15,
          -- CLASSIFD-016: Active record (ACTIVE=1) with inactive date (INA_DATE/DATE_MARKED_INACTIVE)
          COUNT(CASE WHEN TRIM(TO_CHAR(t."ACTIVE")) = '1' THEN 1 END) AS t16,
          COUNT(CASE WHEN TRIM(TO_CHAR(t."ACTIVE")) = '1' AND (TRIM(t."INA_DATE") IS NOT NULL OR TRIM(t."DATE_MARKED_INACTIVE") IS NOT NULL) THEN 1 END) AS f16,
          -- CLASSIFD-017: Written-off record (ACTIVE=2) without write-off date (WRITE_OFF_DATE)
          COUNT(CASE WHEN TRIM(TO_CHAR(t."ACTIVE")) = '2' THEN 1 END) AS t17,
          COUNT(CASE WHEN TRIM(TO_CHAR(t."ACTIVE")) = '2' AND TRIM(t."WRITE_OFF_DATE") IS NULL THEN 1 END) AS f17
        FROM DATACUT5."CLASSIFD" t
        CROSS JOIN params p
        LEFT JOIN k_wp j1 ON j1.o = TRIM(TO_CHAR(t."MARKER")) AND j1.g = '3'
        LEFT JOIN k_wp j2 ON j2.o = TRIM(TO_CHAR(t."REMARKS_NO")) AND j2.g = '2'
        LEFT JOIN k_br j3 ON j3.code = TRIM(t."BRANCH")
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'CLASSIFD-001|Missing Data|Missing Identification Number (IDNO)',
        (t2, f2) AS 'CLASSIFD-002|Invalid Values|Active not 0/1/2 (ACTIVE)',
        (t3, f3) AS 'CLASSIFD-003|Invalid Values|Audit flag not D/U/I (FLAG)',
        (t4, f4) AS 'CLASSIFD-004|Invalid Dates|Invalid date: Date Classified (CLASSIFIED_DATE)',
        (t5, f5) AS 'CLASSIFD-005|Invalid Dates|Invalid date: Record Entry Date (ENTRY_DATE)',
        (t6, f6) AS 'CLASSIFD-006|Invalid Dates|Invalid date: Capture Date (CAPTURE_DATE)',
        (t7, f7) AS 'CLASSIFD-007|Invalid Dates|Invalid date: Last Date (LAST_DATE)',
        (t8, f8) AS 'CLASSIFD-008|Invalid Dates|Invalid date: Inactive Date (INA_DATE)',
        (t9, f9) AS 'CLASSIFD-009|Invalid Dates|Invalid date: Date Marked Inactive (DATE_MARKED_INACTIVE)',
        (t10, f10) AS 'CLASSIFD-010|Invalid Dates|Invalid date: Write Off Date (WRITE_OFF_DATE)',
        (t11, f11) AS 'CLASSIFD-011|Invalid Dates|Invalid date: JSS Call Date (JSS_CALL_DATE)',
        (t12, f12) AS 'CLASSIFD-012|Invalid Dates|Invalid date: Review Date (REVIEW_DATE)',
        (t13, f13) AS 'CLASSIFD-013|Missing Links|Description (classified debts description) (MARKER) not found in WPARAM group 3',
        (t14, f14) AS 'CLASSIFD-014|Missing Links|Remarks (classified debts remarks) (REMARKS_NO) not found in WPARAM group 2',
        (t15, f15) AS 'CLASSIFD-015|Missing Links|Branch (BRANCH) not found in BRANCHES',
        (t16, f16) AS 'CLASSIFD-016|Inconsistent Data|Active record (ACTIVE=1) with inactive date (INA_DATE/DATE_MARKED_INACTIVE)',
        (t17, f17) AS 'CLASSIFD-017|Inconsistent Data|Written-off record (ACTIVE=2) without write-off date (WRITE_OFF_DATE)'
      ))
    UNION ALL
/* =============================================================================
   CLIENT - Client / Personal Details table
   Πίνακας: DATACUT5."CLIENT"   Shadow: δεν υπάρχει mode flag   Έλεγχοι: 4
   ============================================================================= */
    SELECT 'CLIENT - Client / Personal Details table' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- CLIENT-001: Missing Identification Number (IDNO)
          COUNT(*) AS t1,
          COUNT(CASE WHEN TRIM(TO_CHAR(t."IDNO")) IS NULL THEN 1 END) AS f1,
          -- CLIENT-002: Audit flag not D/U/I (FLAG)
          COUNT(*) AS t2,
          COUNT(CASE WHEN TRIM(TO_CHAR(t."FLAG")) IS NOT NULL AND TRIM(TO_CHAR(t."FLAG")) NOT IN ('D','U','I') THEN 1 END) AS f2,
          -- CLIENT-003: Invalid date: Capture Date (CAPTURE_DATE)
          COUNT(*) AS t3,
          COUNT(CASE WHEN TRIM(t."CAPTURE_DATE") IS NOT NULL AND NOT (REGEXP_LIKE(TRIM(t."CAPTURE_DATE"), '^[0-9]{4}-[0-9]{2}-[0-9]{2}( [0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]+)?)?$') AND VALIDATE_CONVERSION(SUBSTR(TRIM(t."CAPTURE_DATE"), 1, 10) AS DATE, 'YYYY-MM-DD') = 1 AND SUBSTR(TRIM(t."CAPTURE_DATE"), 1, 10) &gt;= '1900-01-01') THEN 1 END) AS f3,
          -- CLIENT-004: Invalid date: Last Date (LAST_DATE)
          COUNT(*) AS t4,
          COUNT(CASE WHEN TRIM(t."LAST_DATE") IS NOT NULL AND NOT (REGEXP_LIKE(TRIM(t."LAST_DATE"), '^[0-9]{4}-[0-9]{2}-[0-9]{2}( [0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]+)?)?$') AND VALIDATE_CONVERSION(SUBSTR(TRIM(t."LAST_DATE"), 1, 10) AS DATE, 'YYYY-MM-DD') = 1 AND SUBSTR(TRIM(t."LAST_DATE"), 1, 10) &gt;= '1900-01-01') THEN 1 END) AS f4
        FROM DATACUT5."CLIENT" t
        CROSS JOIN params p
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'CLIENT-001|Missing Data|Missing Identification Number (IDNO)',
        (t2, f2) AS 'CLIENT-002|Invalid Values|Audit flag not D/U/I (FLAG)',
        (t3, f3) AS 'CLIENT-003|Invalid Dates|Invalid date: Capture Date (CAPTURE_DATE)',
        (t4, f4) AS 'CLIENT-004|Invalid Dates|Invalid date: Last Date (LAST_DATE)'
      ))
    UNION ALL
/* =============================================================================
   COMPANY_REGISTER - Companies Register table
   Πίνακας: DATACUT5."COMPANY_REGISTER"   Shadow: δεν υπάρχει mode flag   Έλεγχοι: 1
   ============================================================================= */
    SELECT 'COMPANY_REGISTER - Companies Register table' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- COMPANY_REGISTER-001: Invalid date: Date registered (REGDATE)
          COUNT(*) AS t1,
          COUNT(CASE WHEN TRIM(t."REGDATE") IS NOT NULL AND NOT (REGEXP_LIKE(TRIM(t."REGDATE"), '^[0-9]{4}-[0-9]{2}-[0-9]{2}( [0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]+)?)?$') AND VALIDATE_CONVERSION(SUBSTR(TRIM(t."REGDATE"), 1, 10) AS DATE, 'YYYY-MM-DD') = 1 AND SUBSTR(TRIM(t."REGDATE"), 1, 10) &gt;= '1900-01-01') THEN 1 END) AS f1
        FROM DATACUT5."COMPANY_REGISTER" t
        CROSS JOIN params p
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'COMPANY_REGISTER-001|Invalid Dates|Invalid date: Date registered (REGDATE)'
      ))
    UNION ALL
/* =============================================================================
   ELECTORAL_REGISTER - Electoral Register table
   Πίνακας: DATACUT5."ELECTORAL_REGISTER"   Shadow: δεν υπάρχει mode flag   Έλεγχοι: 2
   ============================================================================= */
    SELECT 'ELECTORAL_REGISTER - Electoral Register table' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- ELECTORAL_REGISTER-001: Missing Identification Number (IDNO)
          COUNT(*) AS t1,
          COUNT(CASE WHEN TRIM(TO_CHAR(t."IDNO")) IS NULL THEN 1 END) AS f1,
          -- ELECTORAL_REGISTER-002: Invalid date: Date of Birth (DOB)
          COUNT(*) AS t2,
          COUNT(CASE WHEN TRIM(t."DOB") IS NOT NULL AND NOT (REGEXP_LIKE(TRIM(t."DOB"), '^[0-9]{4}-[0-9]{2}-[0-9]{2}( [0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]+)?)?$') AND VALIDATE_CONVERSION(SUBSTR(TRIM(t."DOB"), 1, 10) AS DATE, 'YYYY-MM-DD') = 1 AND SUBSTR(TRIM(t."DOB"), 1, 10) &gt;= '1900-01-01') THEN 1 END) AS f2
        FROM DATACUT5."ELECTORAL_REGISTER" t
        CROSS JOIN params p
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'ELECTORAL_REGISTER-001|Missing Data|Missing Identification Number (IDNO)',
        (t2, f2) AS 'ELECTORAL_REGISTER-002|Invalid Dates|Invalid date: Date of Birth (DOB)'
      ))
    UNION ALL
/* =============================================================================
   GARNISHEES - Garnishees Table
   Πίνακας: DATACUT5."GARNISHEES"   Shadow: δεν υπάρχει mode flag   Έλεγχοι: 15
   ============================================================================= */
    SELECT 'GARNISHEES - Garnishees Table' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- GARNISHEES-001: Missing Identification Number (IDNO)
          COUNT(*) AS t1,
          COUNT(CASE WHEN TRIM(TO_CHAR(t."IDNO")) IS NULL THEN 1 END) AS f1,
          -- GARNISHEES-002: Garnishee Type not P/E (TYPE)
          COUNT(*) AS t2,
          COUNT(CASE WHEN TRIM(TO_CHAR(t."TYPE")) IS NOT NULL AND TRIM(TO_CHAR(t."TYPE")) NOT IN ('P','E') THEN 1 END) AS f2,
          -- GARNISHEES-003: Active not 0/1 (ACTIVE)
          COUNT(*) AS t3,
          COUNT(CASE WHEN TRIM(TO_CHAR(t."ACTIVE")) IS NOT NULL AND TRIM(TO_CHAR(t."ACTIVE")) NOT IN ('0','1') THEN 1 END) AS f3,
          -- GARNISHEES-004: Civil not 1/2/3/4 (CIVIL)
          COUNT(*) AS t4,
          COUNT(CASE WHEN TRIM(TO_CHAR(t."CIVIL")) IS NOT NULL AND TRIM(TO_CHAR(t."CIVIL")) NOT IN ('1','2','3','4') THEN 1 END) AS f4,
          -- GARNISHEES-005: Audit flag not D/U/I (FLAG)
          COUNT(*) AS t5,
          COUNT(CASE WHEN TRIM(TO_CHAR(t."FLAG")) IS NOT NULL AND TRIM(TO_CHAR(t."FLAG")) NOT IN ('D','U','I') THEN 1 END) AS f5,
          -- GARNISHEES-006: Negative Amount of Garnishee (AMOUNT)
          COUNT(*) AS t6,
          COUNT(CASE WHEN (CASE WHEN VALIDATE_CONVERSION(TRIM(TO_CHAR(t."AMOUNT")) AS NUMBER) = 1 THEN TO_NUMBER(TRIM(TO_CHAR(t."AMOUNT"))) END) &lt; 0 THEN 1 END) AS f6,
          -- GARNISHEES-007: Invalid date: Record Entry Date (ENTRY_DATE)
          COUNT(*) AS t7,
          COUNT(CASE WHEN TRIM(t."ENTRY_DATE") IS NOT NULL AND NOT (REGEXP_LIKE(TRIM(t."ENTRY_DATE"), '^[0-9]{4}-[0-9]{2}-[0-9]{2}( [0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]+)?)?$') AND VALIDATE_CONVERSION(SUBSTR(TRIM(t."ENTRY_DATE"), 1, 10) AS DATE, 'YYYY-MM-DD') = 1 AND SUBSTR(TRIM(t."ENTRY_DATE"), 1, 10) &gt;= '1900-01-01') THEN 1 END) AS f7,
          -- GARNISHEES-008: Invalid date: Garnishee Date (GARNISHEE_DATE)
          COUNT(*) AS t8,
          COUNT(CASE WHEN TRIM(t."GARNISHEE_DATE") IS NOT NULL AND NOT (REGEXP_LIKE(TRIM(t."GARNISHEE_DATE"), '^[0-9]{4}-[0-9]{2}-[0-9]{2}( [0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]+)?)?$') AND VALIDATE_CONVERSION(SUBSTR(TRIM(t."GARNISHEE_DATE"), 1, 10) AS DATE, 'YYYY-MM-DD') = 1 AND SUBSTR(TRIM(t."GARNISHEE_DATE"), 1, 10) &gt;= '1900-01-01') THEN 1 END) AS f8,
          -- GARNISHEES-009: Invalid date: Capture Date (CAPTURE_DATE)
          COUNT(*) AS t9,
          COUNT(CASE WHEN TRIM(t."CAPTURE_DATE") IS NOT NULL AND NOT (REGEXP_LIKE(TRIM(t."CAPTURE_DATE"), '^[0-9]{4}-[0-9]{2}-[0-9]{2}( [0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]+)?)?$') AND VALIDATE_CONVERSION(SUBSTR(TRIM(t."CAPTURE_DATE"), 1, 10) AS DATE, 'YYYY-MM-DD') = 1 AND SUBSTR(TRIM(t."CAPTURE_DATE"), 1, 10) &gt;= '1900-01-01') THEN 1 END) AS f9,
          -- GARNISHEES-010: Invalid date: Last Date (LAST_DATE)
          COUNT(*) AS t10,
          COUNT(CASE WHEN TRIM(t."LAST_DATE") IS NOT NULL AND NOT (REGEXP_LIKE(TRIM(t."LAST_DATE"), '^[0-9]{4}-[0-9]{2}-[0-9]{2}( [0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]+)?)?$') AND VALIDATE_CONVERSION(SUBSTR(TRIM(t."LAST_DATE"), 1, 10) AS DATE, 'YYYY-MM-DD') = 1 AND SUBSTR(TRIM(t."LAST_DATE"), 1, 10) &gt;= '1900-01-01') THEN 1 END) AS f10,
          -- GARNISHEES-011: Invalid date: Inactive Date (INACTIVE_DATE)
          COUNT(*) AS t11,
          COUNT(CASE WHEN TRIM(t."INACTIVE_DATE") IS NOT NULL AND NOT (REGEXP_LIKE(TRIM(t."INACTIVE_DATE"), '^[0-9]{4}-[0-9]{2}-[0-9]{2}( [0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]+)?)?$') AND VALIDATE_CONVERSION(SUBSTR(TRIM(t."INACTIVE_DATE"), 1, 10) AS DATE, 'YYYY-MM-DD') = 1 AND SUBSTR(TRIM(t."INACTIVE_DATE"), 1, 10) &gt;= '1900-01-01') THEN 1 END) AS f11,
          -- GARNISHEES-012: Invalid date: Date Marked Inactive (DATE_MARKED_INACTIVE)
          COUNT(*) AS t12,
          COUNT(CASE WHEN TRIM(t."DATE_MARKED_INACTIVE") IS NOT NULL AND NOT (REGEXP_LIKE(TRIM(t."DATE_MARKED_INACTIVE"), '^[0-9]{4}-[0-9]{2}-[0-9]{2}( [0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]+)?)?$') AND VALIDATE_CONVERSION(SUBSTR(TRIM(t."DATE_MARKED_INACTIVE"), 1, 10) AS DATE, 'YYYY-MM-DD') = 1 AND SUBSTR(TRIM(t."DATE_MARKED_INACTIVE"), 1, 10) &gt;= '1900-01-01') THEN 1 END) AS f12,
          -- GARNISHEES-013: Invalid date: Expiry Date (EXPIRY)
          COUNT(*) AS t13,
          COUNT(CASE WHEN TRIM(t."EXPIRY") IS NOT NULL AND NOT (REGEXP_LIKE(TRIM(t."EXPIRY"), '^[0-9]{4}-[0-9]{2}-[0-9]{2}( [0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]+)?)?$') AND VALIDATE_CONVERSION(SUBSTR(TRIM(t."EXPIRY"), 1, 10) AS DATE, 'YYYY-MM-DD') = 1 AND SUBSTR(TRIM(t."EXPIRY"), 1, 10) &gt;= '1900-01-01') THEN 1 END) AS f13,
          -- GARNISHEES-014: Garnishee Type (GARN_TYPE) not found in WPARAM
          COUNT(CASE WHEN TRIM(TO_CHAR(t."GARN_TYPE")) IS NOT NULL THEN 1 END) AS t14,
          COUNT(CASE WHEN TRIM(TO_CHAR(t."GARN_TYPE")) IS NOT NULL AND j1.o IS NULL THEN 1 END) AS f14,
          -- GARNISHEES-015: Active record (ACTIVE=1) with inactive date (INACTIVE_DATE/DATE_MARKED_INACTIVE)
          COUNT(CASE WHEN TRIM(TO_CHAR(t."ACTIVE")) = '1' THEN 1 END) AS t15,
          COUNT(CASE WHEN TRIM(TO_CHAR(t."ACTIVE")) = '1' AND (TRIM(t."INACTIVE_DATE") IS NOT NULL OR TRIM(t."DATE_MARKED_INACTIVE") IS NOT NULL) THEN 1 END) AS f15
        FROM DATACUT5."GARNISHEES" t
        CROSS JOIN params p
        LEFT JOIN k_wp_any j1 ON j1.o = TRIM(TO_CHAR(t."GARN_TYPE"))
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'GARNISHEES-001|Missing Data|Missing Identification Number (IDNO)',
        (t2, f2) AS 'GARNISHEES-002|Invalid Values|Garnishee Type not P/E (TYPE)',
        (t3, f3) AS 'GARNISHEES-003|Invalid Values|Active not 0/1 (ACTIVE)',
        (t4, f4) AS 'GARNISHEES-004|Invalid Values|Civil not 1/2/3/4 (CIVIL)',
        (t5, f5) AS 'GARNISHEES-005|Invalid Values|Audit flag not D/U/I (FLAG)',
        (t6, f6) AS 'GARNISHEES-006|Invalid Values|Negative Amount of Garnishee (AMOUNT)',
        (t7, f7) AS 'GARNISHEES-007|Invalid Dates|Invalid date: Record Entry Date (ENTRY_DATE)',
        (t8, f8) AS 'GARNISHEES-008|Invalid Dates|Invalid date: Garnishee Date (GARNISHEE_DATE)',
        (t9, f9) AS 'GARNISHEES-009|Invalid Dates|Invalid date: Capture Date (CAPTURE_DATE)',
        (t10, f10) AS 'GARNISHEES-010|Invalid Dates|Invalid date: Last Date (LAST_DATE)',
        (t11, f11) AS 'GARNISHEES-011|Invalid Dates|Invalid date: Inactive Date (INACTIVE_DATE)',
        (t12, f12) AS 'GARNISHEES-012|Invalid Dates|Invalid date: Date Marked Inactive (DATE_MARKED_INACTIVE)',
        (t13, f13) AS 'GARNISHEES-013|Invalid Dates|Invalid date: Expiry Date (EXPIRY)',
        (t14, f14) AS 'GARNISHEES-014|Missing Links|Garnishee Type (GARN_TYPE) not found in WPARAM',
        (t15, f15) AS 'GARNISHEES-015|Inconsistent Data|Active record (ACTIVE=1) with inactive date (INACTIVE_DATE/DATE_MARKED_INACTIVE)'
      ))
    UNION ALL
/* =============================================================================
   GUARDIANSHIP - Guardianship Table
   Πίνακας: DATACUT5."GUARDIANSHIP"   Shadow: δεν υπάρχει mode flag   Έλεγχοι: 13
   ============================================================================= */
    SELECT 'GUARDIANSHIP - Guardianship Table' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- GUARDIANSHIP-001: Missing Identification Number (IDNO)
          COUNT(*) AS t1,
          COUNT(CASE WHEN TRIM(TO_CHAR(t."IDNO")) IS NULL THEN 1 END) AS f1,
          -- GUARDIANSHIP-002: Active not 0/1 (ACTIVE)
          COUNT(*) AS t2,
          COUNT(CASE WHEN TRIM(TO_CHAR(t."ACTIVE")) IS NOT NULL AND TRIM(TO_CHAR(t."ACTIVE")) NOT IN ('0','1') THEN 1 END) AS f2,
          -- GUARDIANSHIP-003: Audit flag not D/U/I (FLAG)
          COUNT(*) AS t3,
          COUNT(CASE WHEN TRIM(TO_CHAR(t."FLAG")) IS NOT NULL AND TRIM(TO_CHAR(t."FLAG")) NOT IN ('D','U','I') THEN 1 END) AS f3,
          -- GUARDIANSHIP-004: Invalid date: Record Entry Date (ENTRY_DATE)
          COUNT(*) AS t4,
          COUNT(CASE WHEN TRIM(t."ENTRY_DATE") IS NOT NULL AND NOT (REGEXP_LIKE(TRIM(t."ENTRY_DATE"), '^[0-9]{4}-[0-9]{2}-[0-9]{2}( [0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]+)?)?$') AND VALIDATE_CONVERSION(SUBSTR(TRIM(t."ENTRY_DATE"), 1, 10) AS DATE, 'YYYY-MM-DD') = 1 AND SUBSTR(TRIM(t."ENTRY_DATE"), 1, 10) &gt;= '1900-01-01') THEN 1 END) AS f4,
          -- GUARDIANSHIP-005: Invalid date: Guardianship Order Date (GSHIP_ORDER_DATE)
          COUNT(*) AS t5,
          COUNT(CASE WHEN TRIM(t."GSHIP_ORDER_DATE") IS NOT NULL AND NOT (REGEXP_LIKE(TRIM(t."GSHIP_ORDER_DATE"), '^[0-9]{4}-[0-9]{2}-[0-9]{2}( [0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]+)?)?$') AND VALIDATE_CONVERSION(SUBSTR(TRIM(t."GSHIP_ORDER_DATE"), 1, 10) AS DATE, 'YYYY-MM-DD') = 1 AND SUBSTR(TRIM(t."GSHIP_ORDER_DATE"), 1, 10) &gt;= '1900-01-01') THEN 1 END) AS f5,
          -- GUARDIANSHIP-006: Invalid date: Capture Date (CAPTURE_DATE)
          COUNT(*) AS t6,
          COUNT(CASE WHEN TRIM(t."CAPTURE_DATE") IS NOT NULL AND NOT (REGEXP_LIKE(TRIM(t."CAPTURE_DATE"), '^[0-9]{4}-[0-9]{2}-[0-9]{2}( [0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]+)?)?$') AND VALIDATE_CONVERSION(SUBSTR(TRIM(t."CAPTURE_DATE"), 1, 10) AS DATE, 'YYYY-MM-DD') = 1 AND SUBSTR(TRIM(t."CAPTURE_DATE"), 1, 10) &gt;= '1900-01-01') THEN 1 END) AS f6,
          -- GUARDIANSHIP-007: Invalid date: Last Date (LAST_DATE)
          COUNT(*) AS t7,
          COUNT(CASE WHEN TRIM(t."LAST_DATE") IS NOT NULL AND NOT (REGEXP_LIKE(TRIM(t."LAST_DATE"), '^[0-9]{4}-[0-9]{2}-[0-9]{2}( [0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]+)?)?$') AND VALIDATE_CONVERSION(SUBSTR(TRIM(t."LAST_DATE"), 1, 10) AS DATE, 'YYYY-MM-DD') = 1 AND SUBSTR(TRIM(t."LAST_DATE"), 1, 10) &gt;= '1900-01-01') THEN 1 END) AS f7,
          -- GUARDIANSHIP-008: Invalid date: Inactive Date (INACTIVE_DATE)
          COUNT(*) AS t8,
          COUNT(CASE WHEN TRIM(t."INACTIVE_DATE") IS NOT NULL AND NOT (REGEXP_LIKE(TRIM(t."INACTIVE_DATE"), '^[0-9]{4}-[0-9]{2}-[0-9]{2}( [0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]+)?)?$') AND VALIDATE_CONVERSION(SUBSTR(TRIM(t."INACTIVE_DATE"), 1, 10) AS DATE, 'YYYY-MM-DD') = 1 AND SUBSTR(TRIM(t."INACTIVE_DATE"), 1, 10) &gt;= '1900-01-01') THEN 1 END) AS f8,
          -- GUARDIANSHIP-009: Invalid date: Date Marked Inactive (DATE_MARKED_INACTIVE)
          COUNT(*) AS t9,
          COUNT(CASE WHEN TRIM(t."DATE_MARKED_INACTIVE") IS NOT NULL AND NOT (REGEXP_LIKE(TRIM(t."DATE_MARKED_INACTIVE"), '^[0-9]{4}-[0-9]{2}-[0-9]{2}( [0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]+)?)?$') AND VALIDATE_CONVERSION(SUBSTR(TRIM(t."DATE_MARKED_INACTIVE"), 1, 10) AS DATE, 'YYYY-MM-DD') = 1 AND SUBSTR(TRIM(t."DATE_MARKED_INACTIVE"), 1, 10) &gt;= '1900-01-01') THEN 1 END) AS f9,
          -- GUARDIANSHIP-010: Invalid date: Expiry Date (EXPIRY)
          COUNT(*) AS t10,
          COUNT(CASE WHEN TRIM(t."EXPIRY") IS NOT NULL AND NOT (REGEXP_LIKE(TRIM(t."EXPIRY"), '^[0-9]{4}-[0-9]{2}-[0-9]{2}( [0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]+)?)?$') AND VALIDATE_CONVERSION(SUBSTR(TRIM(t."EXPIRY"), 1, 10) AS DATE, 'YYYY-MM-DD') = 1 AND SUBSTR(TRIM(t."EXPIRY"), 1, 10) &gt;= '1900-01-01') THEN 1 END) AS f10,
          -- GUARDIANSHIP-011: Invalid date: Review Date (REVIEW_DATE)
          COUNT(*) AS t11,
          COUNT(CASE WHEN TRIM(t."REVIEW_DATE") IS NOT NULL AND NOT (REGEXP_LIKE(TRIM(t."REVIEW_DATE"), '^[0-9]{4}-[0-9]{2}-[0-9]{2}( [0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]+)?)?$') AND VALIDATE_CONVERSION(SUBSTR(TRIM(t."REVIEW_DATE"), 1, 10) AS DATE, 'YYYY-MM-DD') = 1 AND SUBSTR(TRIM(t."REVIEW_DATE"), 1, 10) &gt;= '1900-01-01') THEN 1 END) AS f11,
          -- GUARDIANSHIP-012: Detail No (what type of Warning) (DETAIL_NO) not found in WPARAM
          COUNT(CASE WHEN TRIM(TO_CHAR(t."DETAIL_NO")) IS NOT NULL THEN 1 END) AS t12,
          COUNT(CASE WHEN TRIM(TO_CHAR(t."DETAIL_NO")) IS NOT NULL AND j1.o IS NULL THEN 1 END) AS f12,
          -- GUARDIANSHIP-013: Active record (ACTIVE=1) with inactive date (INACTIVE_DATE/DATE_MARKED_INACTIVE)
          COUNT(CASE WHEN TRIM(TO_CHAR(t."ACTIVE")) = '1' THEN 1 END) AS t13,
          COUNT(CASE WHEN TRIM(TO_CHAR(t."ACTIVE")) = '1' AND (TRIM(t."INACTIVE_DATE") IS NOT NULL OR TRIM(t."DATE_MARKED_INACTIVE") IS NOT NULL) THEN 1 END) AS f13
        FROM DATACUT5."GUARDIANSHIP" t
        CROSS JOIN params p
        LEFT JOIN k_wp_any j1 ON j1.o = TRIM(TO_CHAR(t."DETAIL_NO"))
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'GUARDIANSHIP-001|Missing Data|Missing Identification Number (IDNO)',
        (t2, f2) AS 'GUARDIANSHIP-002|Invalid Values|Active not 0/1 (ACTIVE)',
        (t3, f3) AS 'GUARDIANSHIP-003|Invalid Values|Audit flag not D/U/I (FLAG)',
        (t4, f4) AS 'GUARDIANSHIP-004|Invalid Dates|Invalid date: Record Entry Date (ENTRY_DATE)',
        (t5, f5) AS 'GUARDIANSHIP-005|Invalid Dates|Invalid date: Guardianship Order Date (GSHIP_ORDER_DATE)',
        (t6, f6) AS 'GUARDIANSHIP-006|Invalid Dates|Invalid date: Capture Date (CAPTURE_DATE)',
        (t7, f7) AS 'GUARDIANSHIP-007|Invalid Dates|Invalid date: Last Date (LAST_DATE)',
        (t8, f8) AS 'GUARDIANSHIP-008|Invalid Dates|Invalid date: Inactive Date (INACTIVE_DATE)',
        (t9, f9) AS 'GUARDIANSHIP-009|Invalid Dates|Invalid date: Date Marked Inactive (DATE_MARKED_INACTIVE)',
        (t10, f10) AS 'GUARDIANSHIP-010|Invalid Dates|Invalid date: Expiry Date (EXPIRY)',
        (t11, f11) AS 'GUARDIANSHIP-011|Invalid Dates|Invalid date: Review Date (REVIEW_DATE)',
        (t12, f12) AS 'GUARDIANSHIP-012|Missing Links|Detail No (what type of Warning) (DETAIL_NO) not found in WPARAM',
        (t13, f13) AS 'GUARDIANSHIP-013|Inconsistent Data|Active record (ACTIVE=1) with inactive date (INACTIVE_DATE/DATE_MARKED_INACTIVE)'
      ))
    UNION ALL
/* =============================================================================
   INCAPACITATED - Incapacitated Table
   Πίνακας: DATACUT5."INCAPACITATED"   Shadow: δεν υπάρχει mode flag   Έλεγχοι: 13
   ============================================================================= */
    SELECT 'INCAPACITATED - Incapacitated Table' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- INCAPACITATED-001: Missing Identification Number (IDNO)
          COUNT(*) AS t1,
          COUNT(CASE WHEN TRIM(TO_CHAR(t."IDNO")) IS NULL THEN 1 END) AS f1,
          -- INCAPACITATED-002: Active not 0/1 (ACTIVE)
          COUNT(*) AS t2,
          COUNT(CASE WHEN TRIM(TO_CHAR(t."ACTIVE")) IS NOT NULL AND TRIM(TO_CHAR(t."ACTIVE")) NOT IN ('0','1') THEN 1 END) AS f2,
          -- INCAPACITATED-003: Audit flag not D/U/I (FLAG)
          COUNT(*) AS t3,
          COUNT(CASE WHEN TRIM(TO_CHAR(t."FLAG")) IS NOT NULL AND TRIM(TO_CHAR(t."FLAG")) NOT IN ('D','U','I') THEN 1 END) AS f3,
          -- INCAPACITATED-004: Invalid date: Incapacitated Date (INCAPACITATED_DATE)
          COUNT(*) AS t4,
          COUNT(CASE WHEN TRIM(t."INCAPACITATED_DATE") IS NOT NULL AND NOT (REGEXP_LIKE(TRIM(t."INCAPACITATED_DATE"), '^[0-9]{4}-[0-9]{2}-[0-9]{2}( [0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]+)?)?$') AND VALIDATE_CONVERSION(SUBSTR(TRIM(t."INCAPACITATED_DATE"), 1, 10) AS DATE, 'YYYY-MM-DD') = 1 AND SUBSTR(TRIM(t."INCAPACITATED_DATE"), 1, 10) &gt;= '1900-01-01') THEN 1 END) AS f4,
          -- INCAPACITATED-005: Invalid date: Record Entry Date (ENTRY_DATE)
          COUNT(*) AS t5,
          COUNT(CASE WHEN TRIM(t."ENTRY_DATE") IS NOT NULL AND NOT (REGEXP_LIKE(TRIM(t."ENTRY_DATE"), '^[0-9]{4}-[0-9]{2}-[0-9]{2}( [0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]+)?)?$') AND VALIDATE_CONVERSION(SUBSTR(TRIM(t."ENTRY_DATE"), 1, 10) AS DATE, 'YYYY-MM-DD') = 1 AND SUBSTR(TRIM(t."ENTRY_DATE"), 1, 10) &gt;= '1900-01-01') THEN 1 END) AS f5,
          -- INCAPACITATED-006: Invalid date: Capture Date (CAPTURE_DATE)
          COUNT(*) AS t6,
          COUNT(CASE WHEN TRIM(t."CAPTURE_DATE") IS NOT NULL AND NOT (REGEXP_LIKE(TRIM(t."CAPTURE_DATE"), '^[0-9]{4}-[0-9]{2}-[0-9]{2}( [0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]+)?)?$') AND VALIDATE_CONVERSION(SUBSTR(TRIM(t."CAPTURE_DATE"), 1, 10) AS DATE, 'YYYY-MM-DD') = 1 AND SUBSTR(TRIM(t."CAPTURE_DATE"), 1, 10) &gt;= '1900-01-01') THEN 1 END) AS f6,
          -- INCAPACITATED-007: Invalid date: Last Date (LAST_DATE)
          COUNT(*) AS t7,
          COUNT(CASE WHEN TRIM(t."LAST_DATE") IS NOT NULL AND NOT (REGEXP_LIKE(TRIM(t."LAST_DATE"), '^[0-9]{4}-[0-9]{2}-[0-9]{2}( [0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]+)?)?$') AND VALIDATE_CONVERSION(SUBSTR(TRIM(t."LAST_DATE"), 1, 10) AS DATE, 'YYYY-MM-DD') = 1 AND SUBSTR(TRIM(t."LAST_DATE"), 1, 10) &gt;= '1900-01-01') THEN 1 END) AS f7,
          -- INCAPACITATED-008: Invalid date: Inactive Date (INA_DATE)
          COUNT(*) AS t8,
          COUNT(CASE WHEN TRIM(t."INA_DATE") IS NOT NULL AND NOT (REGEXP_LIKE(TRIM(t."INA_DATE"), '^[0-9]{4}-[0-9]{2}-[0-9]{2}( [0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]+)?)?$') AND VALIDATE_CONVERSION(SUBSTR(TRIM(t."INA_DATE"), 1, 10) AS DATE, 'YYYY-MM-DD') = 1 AND SUBSTR(TRIM(t."INA_DATE"), 1, 10) &gt;= '1900-01-01') THEN 1 END) AS f8,
          -- INCAPACITATED-009: Invalid date: Date Marked Inactive (DATE_MARKED_INACTIVE)
          COUNT(*) AS t9,
          COUNT(CASE WHEN TRIM(t."DATE_MARKED_INACTIVE") IS NOT NULL AND NOT (REGEXP_LIKE(TRIM(t."DATE_MARKED_INACTIVE"), '^[0-9]{4}-[0-9]{2}-[0-9]{2}( [0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]+)?)?$') AND VALIDATE_CONVERSION(SUBSTR(TRIM(t."DATE_MARKED_INACTIVE"), 1, 10) AS DATE, 'YYYY-MM-DD') = 1 AND SUBSTR(TRIM(t."DATE_MARKED_INACTIVE"), 1, 10) &gt;= '1900-01-01') THEN 1 END) AS f9,
          -- INCAPACITATED-010: Invalid date: Expiry Date (EXPIRY_DATE)
          COUNT(*) AS t10,
          COUNT(CASE WHEN TRIM(t."EXPIRY_DATE") IS NOT NULL AND NOT (REGEXP_LIKE(TRIM(t."EXPIRY_DATE"), '^[0-9]{4}-[0-9]{2}-[0-9]{2}( [0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]+)?)?$') AND VALIDATE_CONVERSION(SUBSTR(TRIM(t."EXPIRY_DATE"), 1, 10) AS DATE, 'YYYY-MM-DD') = 1 AND SUBSTR(TRIM(t."EXPIRY_DATE"), 1, 10) &gt;= '1900-01-01') THEN 1 END) AS f10,
          -- INCAPACITATED-011: Invalid date: Review Date (REVIEW_DATE)
          COUNT(*) AS t11,
          COUNT(CASE WHEN TRIM(t."REVIEW_DATE") IS NOT NULL AND NOT (REGEXP_LIKE(TRIM(t."REVIEW_DATE"), '^[0-9]{4}-[0-9]{2}-[0-9]{2}( [0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]+)?)?$') AND VALIDATE_CONVERSION(SUBSTR(TRIM(t."REVIEW_DATE"), 1, 10) AS DATE, 'YYYY-MM-DD') = 1 AND SUBSTR(TRIM(t."REVIEW_DATE"), 1, 10) &gt;= '1900-01-01') THEN 1 END) AS f11,
          -- INCAPACITATED-012: Detail No (what type of Warning) (DETAIL_NO) not found in WPARAM
          COUNT(CASE WHEN TRIM(TO_CHAR(t."DETAIL_NO")) IS NOT NULL THEN 1 END) AS t12,
          COUNT(CASE WHEN TRIM(TO_CHAR(t."DETAIL_NO")) IS NOT NULL AND j1.o IS NULL THEN 1 END) AS f12,
          -- INCAPACITATED-013: Active record (ACTIVE=1) with inactive date (INA_DATE/DATE_MARKED_INACTIVE)
          COUNT(CASE WHEN TRIM(TO_CHAR(t."ACTIVE")) = '1' THEN 1 END) AS t13,
          COUNT(CASE WHEN TRIM(TO_CHAR(t."ACTIVE")) = '1' AND (TRIM(t."INA_DATE") IS NOT NULL OR TRIM(t."DATE_MARKED_INACTIVE") IS NOT NULL) THEN 1 END) AS f13
        FROM DATACUT5."INCAPACITATED" t
        CROSS JOIN params p
        LEFT JOIN k_wp_any j1 ON j1.o = TRIM(TO_CHAR(t."DETAIL_NO"))
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'INCAPACITATED-001|Missing Data|Missing Identification Number (IDNO)',
        (t2, f2) AS 'INCAPACITATED-002|Invalid Values|Active not 0/1 (ACTIVE)',
        (t3, f3) AS 'INCAPACITATED-003|Invalid Values|Audit flag not D/U/I (FLAG)',
        (t4, f4) AS 'INCAPACITATED-004|Invalid Dates|Invalid date: Incapacitated Date (INCAPACITATED_DATE)',
        (t5, f5) AS 'INCAPACITATED-005|Invalid Dates|Invalid date: Record Entry Date (ENTRY_DATE)',
        (t6, f6) AS 'INCAPACITATED-006|Invalid Dates|Invalid date: Capture Date (CAPTURE_DATE)',
        (t7, f7) AS 'INCAPACITATED-007|Invalid Dates|Invalid date: Last Date (LAST_DATE)',
        (t8, f8) AS 'INCAPACITATED-008|Invalid Dates|Invalid date: Inactive Date (INA_DATE)',
        (t9, f9) AS 'INCAPACITATED-009|Invalid Dates|Invalid date: Date Marked Inactive (DATE_MARKED_INACTIVE)',
        (t10, f10) AS 'INCAPACITATED-010|Invalid Dates|Invalid date: Expiry Date (EXPIRY_DATE)',
        (t11, f11) AS 'INCAPACITATED-011|Invalid Dates|Invalid date: Review Date (REVIEW_DATE)',
        (t12, f12) AS 'INCAPACITATED-012|Missing Links|Detail No (what type of Warning) (DETAIL_NO) not found in WPARAM',
        (t13, f13) AS 'INCAPACITATED-013|Inconsistent Data|Active record (ACTIVE=1) with inactive date (INA_DATE/DATE_MARKED_INACTIVE)'
      ))
    UNION ALL
/* =============================================================================
   INTERDICTED - Interdicted people Table
   Πίνακας: DATACUT5."INTERDICTED"   Shadow: δεν υπάρχει mode flag   Έλεγχοι: 13
   ============================================================================= */
    SELECT 'INTERDICTED - Interdicted people Table' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- INTERDICTED-001: Missing Identification Number (IDNO)
          COUNT(*) AS t1,
          COUNT(CASE WHEN TRIM(TO_CHAR(t."IDNO")) IS NULL THEN 1 END) AS f1,
          -- INTERDICTED-002: Active not 0/1 (ACTIVE)
          COUNT(*) AS t2,
          COUNT(CASE WHEN TRIM(TO_CHAR(t."ACTIVE")) IS NOT NULL AND TRIM(TO_CHAR(t."ACTIVE")) NOT IN ('0','1') THEN 1 END) AS f2,
          -- INTERDICTED-003: Audit flag not D/U/I (FLAG)
          COUNT(*) AS t3,
          COUNT(CASE WHEN TRIM(TO_CHAR(t."FLAG")) IS NOT NULL AND TRIM(TO_CHAR(t."FLAG")) NOT IN ('D','U','I') THEN 1 END) AS f3,
          -- INTERDICTED-004: Invalid date: Interdiction Date (INTERDICTION_DATE)
          COUNT(*) AS t4,
          COUNT(CASE WHEN TRIM(t."INTERDICTION_DATE") IS NOT NULL AND NOT (REGEXP_LIKE(TRIM(t."INTERDICTION_DATE"), '^[0-9]{4}-[0-9]{2}-[0-9]{2}( [0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]+)?)?$') AND VALIDATE_CONVERSION(SUBSTR(TRIM(t."INTERDICTION_DATE"), 1, 10) AS DATE, 'YYYY-MM-DD') = 1 AND SUBSTR(TRIM(t."INTERDICTION_DATE"), 1, 10) &gt;= '1900-01-01') THEN 1 END) AS f4,
          -- INTERDICTED-005: Invalid date: Record Entry Date (ENTRY_DATE)
          COUNT(*) AS t5,
          COUNT(CASE WHEN TRIM(t."ENTRY_DATE") IS NOT NULL AND NOT (REGEXP_LIKE(TRIM(t."ENTRY_DATE"), '^[0-9]{4}-[0-9]{2}-[0-9]{2}( [0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]+)?)?$') AND VALIDATE_CONVERSION(SUBSTR(TRIM(t."ENTRY_DATE"), 1, 10) AS DATE, 'YYYY-MM-DD') = 1 AND SUBSTR(TRIM(t."ENTRY_DATE"), 1, 10) &gt;= '1900-01-01') THEN 1 END) AS f5,
          -- INTERDICTED-006: Invalid date: Capture Date (CAPTURE_DATE)
          COUNT(*) AS t6,
          COUNT(CASE WHEN TRIM(t."CAPTURE_DATE") IS NOT NULL AND NOT (REGEXP_LIKE(TRIM(t."CAPTURE_DATE"), '^[0-9]{4}-[0-9]{2}-[0-9]{2}( [0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]+)?)?$') AND VALIDATE_CONVERSION(SUBSTR(TRIM(t."CAPTURE_DATE"), 1, 10) AS DATE, 'YYYY-MM-DD') = 1 AND SUBSTR(TRIM(t."CAPTURE_DATE"), 1, 10) &gt;= '1900-01-01') THEN 1 END) AS f6,
          -- INTERDICTED-007: Invalid date: Last Date (LAST_DATE)
          COUNT(*) AS t7,
          COUNT(CASE WHEN TRIM(t."LAST_DATE") IS NOT NULL AND NOT (REGEXP_LIKE(TRIM(t."LAST_DATE"), '^[0-9]{4}-[0-9]{2}-[0-9]{2}( [0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]+)?)?$') AND VALIDATE_CONVERSION(SUBSTR(TRIM(t."LAST_DATE"), 1, 10) AS DATE, 'YYYY-MM-DD') = 1 AND SUBSTR(TRIM(t."LAST_DATE"), 1, 10) &gt;= '1900-01-01') THEN 1 END) AS f7,
          -- INTERDICTED-008: Invalid date: Inactive Date (INA_DATE)
          COUNT(*) AS t8,
          COUNT(CASE WHEN TRIM(t."INA_DATE") IS NOT NULL AND NOT (REGEXP_LIKE(TRIM(t."INA_DATE"), '^[0-9]{4}-[0-9]{2}-[0-9]{2}( [0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]+)?)?$') AND VALIDATE_CONVERSION(SUBSTR(TRIM(t."INA_DATE"), 1, 10) AS DATE, 'YYYY-MM-DD') = 1 AND SUBSTR(TRIM(t."INA_DATE"), 1, 10) &gt;= '1900-01-01') THEN 1 END) AS f8,
          -- INTERDICTED-009: Invalid date: Date Marked Inactive (DATE_MARKED_INACTIVE)
          COUNT(*) AS t9,
          COUNT(CASE WHEN TRIM(t."DATE_MARKED_INACTIVE") IS NOT NULL AND NOT (REGEXP_LIKE(TRIM(t."DATE_MARKED_INACTIVE"), '^[0-9]{4}-[0-9]{2}-[0-9]{2}( [0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]+)?)?$') AND VALIDATE_CONVERSION(SUBSTR(TRIM(t."DATE_MARKED_INACTIVE"), 1, 10) AS DATE, 'YYYY-MM-DD') = 1 AND SUBSTR(TRIM(t."DATE_MARKED_INACTIVE"), 1, 10) &gt;= '1900-01-01') THEN 1 END) AS f9,
          -- INTERDICTED-010: Invalid date: Expiry Date (EXPIRY_DATE)
          COUNT(*) AS t10,
          COUNT(CASE WHEN TRIM(t."EXPIRY_DATE") IS NOT NULL AND NOT (REGEXP_LIKE(TRIM(t."EXPIRY_DATE"), '^[0-9]{4}-[0-9]{2}-[0-9]{2}( [0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]+)?)?$') AND VALIDATE_CONVERSION(SUBSTR(TRIM(t."EXPIRY_DATE"), 1, 10) AS DATE, 'YYYY-MM-DD') = 1 AND SUBSTR(TRIM(t."EXPIRY_DATE"), 1, 10) &gt;= '1900-01-01') THEN 1 END) AS f10,
          -- INTERDICTED-011: Invalid date: Review Date (REVIEW_DATE)
          COUNT(*) AS t11,
          COUNT(CASE WHEN TRIM(t."REVIEW_DATE") IS NOT NULL AND NOT (REGEXP_LIKE(TRIM(t."REVIEW_DATE"), '^[0-9]{4}-[0-9]{2}-[0-9]{2}( [0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]+)?)?$') AND VALIDATE_CONVERSION(SUBSTR(TRIM(t."REVIEW_DATE"), 1, 10) AS DATE, 'YYYY-MM-DD') = 1 AND SUBSTR(TRIM(t."REVIEW_DATE"), 1, 10) &gt;= '1900-01-01') THEN 1 END) AS f11,
          -- INTERDICTED-012: Detail No (what type of Warning) (DETAIL_NO) not found in WPARAM
          COUNT(CASE WHEN TRIM(TO_CHAR(t."DETAIL_NO")) IS NOT NULL THEN 1 END) AS t12,
          COUNT(CASE WHEN TRIM(TO_CHAR(t."DETAIL_NO")) IS NOT NULL AND j1.o IS NULL THEN 1 END) AS f12,
          -- INTERDICTED-013: Active record (ACTIVE=1) with inactive date (INA_DATE/DATE_MARKED_INACTIVE)
          COUNT(CASE WHEN TRIM(TO_CHAR(t."ACTIVE")) = '1' THEN 1 END) AS t13,
          COUNT(CASE WHEN TRIM(TO_CHAR(t."ACTIVE")) = '1' AND (TRIM(t."INA_DATE") IS NOT NULL OR TRIM(t."DATE_MARKED_INACTIVE") IS NOT NULL) THEN 1 END) AS f13
        FROM DATACUT5."INTERDICTED" t
        CROSS JOIN params p
        LEFT JOIN k_wp_any j1 ON j1.o = TRIM(TO_CHAR(t."DETAIL_NO"))
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'INTERDICTED-001|Missing Data|Missing Identification Number (IDNO)',
        (t2, f2) AS 'INTERDICTED-002|Invalid Values|Active not 0/1 (ACTIVE)',
        (t3, f3) AS 'INTERDICTED-003|Invalid Values|Audit flag not D/U/I (FLAG)',
        (t4, f4) AS 'INTERDICTED-004|Invalid Dates|Invalid date: Interdiction Date (INTERDICTION_DATE)',
        (t5, f5) AS 'INTERDICTED-005|Invalid Dates|Invalid date: Record Entry Date (ENTRY_DATE)',
        (t6, f6) AS 'INTERDICTED-006|Invalid Dates|Invalid date: Capture Date (CAPTURE_DATE)',
        (t7, f7) AS 'INTERDICTED-007|Invalid Dates|Invalid date: Last Date (LAST_DATE)',
        (t8, f8) AS 'INTERDICTED-008|Invalid Dates|Invalid date: Inactive Date (INA_DATE)',
        (t9, f9) AS 'INTERDICTED-009|Invalid Dates|Invalid date: Date Marked Inactive (DATE_MARKED_INACTIVE)',
        (t10, f10) AS 'INTERDICTED-010|Invalid Dates|Invalid date: Expiry Date (EXPIRY_DATE)',
        (t11, f11) AS 'INTERDICTED-011|Invalid Dates|Invalid date: Review Date (REVIEW_DATE)',
        (t12, f12) AS 'INTERDICTED-012|Missing Links|Detail No (what type of Warning) (DETAIL_NO) not found in WPARAM',
        (t13, f13) AS 'INTERDICTED-013|Inconsistent Data|Active record (ACTIVE=1) with inactive date (INA_DATE/DATE_MARKED_INACTIVE)'
      ))
    UNION ALL
/* =============================================================================
   MSE_REGISTER - Malta Stock Exchange register table
   Πίνακας: DATACUT5."MSE_REGISTER"   Shadow: δεν υπάρχει mode flag   Έλεγχοι: 2
   ============================================================================= */
    SELECT 'MSE_REGISTER - Malta Stock Exchange register table' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- MSE_REGISTER-001: Missing Client Identification (ID)
          COUNT(*) AS t1,
          COUNT(CASE WHEN TRIM(TO_CHAR(t."ID")) IS NULL THEN 1 END) AS f1,
          -- MSE_REGISTER-002: Negative Number of HSBC Malta shares (BALANCE)
          COUNT(*) AS t2,
          COUNT(CASE WHEN (CASE WHEN VALIDATE_CONVERSION(TRIM(TO_CHAR(t."BALANCE")) AS NUMBER) = 1 THEN TO_NUMBER(TRIM(TO_CHAR(t."BALANCE"))) END) &lt; 0 THEN 1 END) AS f2
        FROM DATACUT5."MSE_REGISTER" t
        CROSS JOIN params p
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'MSE_REGISTER-001|Missing Data|Missing Client Identification (ID)',
        (t2, f2) AS 'MSE_REGISTER-002|Invalid Values|Negative Number of HSBC Malta shares (BALANCE)'
      ))
    UNION ALL
/* =============================================================================
   PROHIBITORY_INJUNCTIONS - Prohibitory Injunctions table
   Πίνακας: DATACUT5."PROHIBITORY_INJUNCTIONS"   Shadow: δεν υπάρχει mode flag   Έλεγχοι: 13
   ============================================================================= */
    SELECT 'PROHIBITORY_INJUNCTIONS - Prohibitory Injunctions table' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- PROHIBITORY_INJUNCTIONS-001: Missing Identification Number (IDNO)
          COUNT(*) AS t1,
          COUNT(CASE WHEN TRIM(TO_CHAR(t."IDNO")) IS NULL THEN 1 END) AS f1,
          -- PROHIBITORY_INJUNCTIONS-002: Active not 0/1 (ACTIVE)
          COUNT(*) AS t2,
          COUNT(CASE WHEN TRIM(TO_CHAR(t."ACTIVE")) IS NOT NULL AND TRIM(TO_CHAR(t."ACTIVE")) NOT IN ('0','1') THEN 1 END) AS f2,
          -- PROHIBITORY_INJUNCTIONS-003: Audit flag not D/U/I (FLAG)
          COUNT(*) AS t3,
          COUNT(CASE WHEN TRIM(TO_CHAR(t."FLAG")) IS NOT NULL AND TRIM(TO_CHAR(t."FLAG")) NOT IN ('D','U','I') THEN 1 END) AS f3,
          -- PROHIBITORY_INJUNCTIONS-004: Invalid date: Registration Date (REGISTRATION_DATE)
          COUNT(*) AS t4,
          COUNT(CASE WHEN TRIM(t."REGISTRATION_DATE") IS NOT NULL AND NOT (REGEXP_LIKE(TRIM(t."REGISTRATION_DATE"), '^[0-9]{4}-[0-9]{2}-[0-9]{2}( [0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]+)?)?$') AND VALIDATE_CONVERSION(SUBSTR(TRIM(t."REGISTRATION_DATE"), 1, 10) AS DATE, 'YYYY-MM-DD') = 1 AND SUBSTR(TRIM(t."REGISTRATION_DATE"), 1, 10) &gt;= '1900-01-01') THEN 1 END) AS f4,
          -- PROHIBITORY_INJUNCTIONS-005: Invalid date: Issue Date (ISSUE_DATE)
          COUNT(*) AS t5,
          COUNT(CASE WHEN TRIM(t."ISSUE_DATE") IS NOT NULL AND NOT (REGEXP_LIKE(TRIM(t."ISSUE_DATE"), '^[0-9]{4}-[0-9]{2}-[0-9]{2}( [0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]+)?)?$') AND VALIDATE_CONVERSION(SUBSTR(TRIM(t."ISSUE_DATE"), 1, 10) AS DATE, 'YYYY-MM-DD') = 1 AND SUBSTR(TRIM(t."ISSUE_DATE"), 1, 10) &gt;= '1900-01-01') THEN 1 END) AS f5,
          -- PROHIBITORY_INJUNCTIONS-006: Invalid date: Record Entry Date (ENTRY_DATE)
          COUNT(*) AS t6,
          COUNT(CASE WHEN TRIM(t."ENTRY_DATE") IS NOT NULL AND NOT (REGEXP_LIKE(TRIM(t."ENTRY_DATE"), '^[0-9]{4}-[0-9]{2}-[0-9]{2}( [0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]+)?)?$') AND VALIDATE_CONVERSION(SUBSTR(TRIM(t."ENTRY_DATE"), 1, 10) AS DATE, 'YYYY-MM-DD') = 1 AND SUBSTR(TRIM(t."ENTRY_DATE"), 1, 10) &gt;= '1900-01-01') THEN 1 END) AS f6,
          -- PROHIBITORY_INJUNCTIONS-007: Invalid date: Capture Date (CAPTURE_DATE)
          COUNT(*) AS t7,
          COUNT(CASE WHEN TRIM(t."CAPTURE_DATE") IS NOT NULL AND NOT (REGEXP_LIKE(TRIM(t."CAPTURE_DATE"), '^[0-9]{4}-[0-9]{2}-[0-9]{2}( [0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]+)?)?$') AND VALIDATE_CONVERSION(SUBSTR(TRIM(t."CAPTURE_DATE"), 1, 10) AS DATE, 'YYYY-MM-DD') = 1 AND SUBSTR(TRIM(t."CAPTURE_DATE"), 1, 10) &gt;= '1900-01-01') THEN 1 END) AS f7,
          -- PROHIBITORY_INJUNCTIONS-008: Invalid date: Last Date (LAST_DATE)
          COUNT(*) AS t8,
          COUNT(CASE WHEN TRIM(t."LAST_DATE") IS NOT NULL AND NOT (REGEXP_LIKE(TRIM(t."LAST_DATE"), '^[0-9]{4}-[0-9]{2}-[0-9]{2}( [0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]+)?)?$') AND VALIDATE_CONVERSION(SUBSTR(TRIM(t."LAST_DATE"), 1, 10) AS DATE, 'YYYY-MM-DD') = 1 AND SUBSTR(TRIM(t."LAST_DATE"), 1, 10) &gt;= '1900-01-01') THEN 1 END) AS f8,
          -- PROHIBITORY_INJUNCTIONS-009: Invalid date: Inactive Date (INA_DATE)
          COUNT(*) AS t9,
          COUNT(CASE WHEN TRIM(t."INA_DATE") IS NOT NULL AND NOT (REGEXP_LIKE(TRIM(t."INA_DATE"), '^[0-9]{4}-[0-9]{2}-[0-9]{2}( [0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]+)?)?$') AND VALIDATE_CONVERSION(SUBSTR(TRIM(t."INA_DATE"), 1, 10) AS DATE, 'YYYY-MM-DD') = 1 AND SUBSTR(TRIM(t."INA_DATE"), 1, 10) &gt;= '1900-01-01') THEN 1 END) AS f9,
          -- PROHIBITORY_INJUNCTIONS-010: Invalid date: Date Marked Inactive (DATE_MARKED_INACTIVE)
          COUNT(*) AS t10,
          COUNT(CASE WHEN TRIM(t."DATE_MARKED_INACTIVE") IS NOT NULL AND NOT (REGEXP_LIKE(TRIM(t."DATE_MARKED_INACTIVE"), '^[0-9]{4}-[0-9]{2}-[0-9]{2}( [0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]+)?)?$') AND VALIDATE_CONVERSION(SUBSTR(TRIM(t."DATE_MARKED_INACTIVE"), 1, 10) AS DATE, 'YYYY-MM-DD') = 1 AND SUBSTR(TRIM(t."DATE_MARKED_INACTIVE"), 1, 10) &gt;= '1900-01-01') THEN 1 END) AS f10,
          -- PROHIBITORY_INJUNCTIONS-011: Detail No (what type of Warning) (DETAIL_NO) not found in WPARAM
          COUNT(CASE WHEN TRIM(TO_CHAR(t."DETAIL_NO")) IS NOT NULL THEN 1 END) AS t11,
          COUNT(CASE WHEN TRIM(TO_CHAR(t."DETAIL_NO")) IS NOT NULL AND j1.o IS NULL THEN 1 END) AS f11,
          -- PROHIBITORY_INJUNCTIONS-012: Court (COURT) not found in WPARAM group 4
          COUNT(CASE WHEN TRIM(TO_CHAR(t."COURT")) IS NOT NULL THEN 1 END) AS t12,
          COUNT(CASE WHEN TRIM(TO_CHAR(t."COURT")) IS NOT NULL AND j2.o IS NULL THEN 1 END) AS f12,
          -- PROHIBITORY_INJUNCTIONS-013: Active record (ACTIVE=1) with inactive date (INA_DATE/DATE_MARKED_INACTIVE)
          COUNT(CASE WHEN TRIM(TO_CHAR(t."ACTIVE")) = '1' THEN 1 END) AS t13,
          COUNT(CASE WHEN TRIM(TO_CHAR(t."ACTIVE")) = '1' AND (TRIM(t."INA_DATE") IS NOT NULL OR TRIM(t."DATE_MARKED_INACTIVE") IS NOT NULL) THEN 1 END) AS f13
        FROM DATACUT5."PROHIBITORY_INJUNCTIONS" t
        CROSS JOIN params p
        LEFT JOIN k_wp_any j1 ON j1.o = TRIM(TO_CHAR(t."DETAIL_NO"))
        LEFT JOIN k_wp j2 ON j2.o = TRIM(TO_CHAR(t."COURT")) AND j2.g = '4'
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'PROHIBITORY_INJUNCTIONS-001|Missing Data|Missing Identification Number (IDNO)',
        (t2, f2) AS 'PROHIBITORY_INJUNCTIONS-002|Invalid Values|Active not 0/1 (ACTIVE)',
        (t3, f3) AS 'PROHIBITORY_INJUNCTIONS-003|Invalid Values|Audit flag not D/U/I (FLAG)',
        (t4, f4) AS 'PROHIBITORY_INJUNCTIONS-004|Invalid Dates|Invalid date: Registration Date (REGISTRATION_DATE)',
        (t5, f5) AS 'PROHIBITORY_INJUNCTIONS-005|Invalid Dates|Invalid date: Issue Date (ISSUE_DATE)',
        (t6, f6) AS 'PROHIBITORY_INJUNCTIONS-006|Invalid Dates|Invalid date: Record Entry Date (ENTRY_DATE)',
        (t7, f7) AS 'PROHIBITORY_INJUNCTIONS-007|Invalid Dates|Invalid date: Capture Date (CAPTURE_DATE)',
        (t8, f8) AS 'PROHIBITORY_INJUNCTIONS-008|Invalid Dates|Invalid date: Last Date (LAST_DATE)',
        (t9, f9) AS 'PROHIBITORY_INJUNCTIONS-009|Invalid Dates|Invalid date: Inactive Date (INA_DATE)',
        (t10, f10) AS 'PROHIBITORY_INJUNCTIONS-010|Invalid Dates|Invalid date: Date Marked Inactive (DATE_MARKED_INACTIVE)',
        (t11, f11) AS 'PROHIBITORY_INJUNCTIONS-011|Missing Links|Detail No (what type of Warning) (DETAIL_NO) not found in WPARAM',
        (t12, f12) AS 'PROHIBITORY_INJUNCTIONS-012|Missing Links|Court (COURT) not found in WPARAM group 4',
        (t13, f13) AS 'PROHIBITORY_INJUNCTIONS-013|Inconsistent Data|Active record (ACTIVE=1) with inactive date (INA_DATE/DATE_MARKED_INACTIVE)'
      ))
    UNION ALL
/* =============================================================================
   SULS - SubOrdinated Loan Stock table
   Πίνακας: DATACUT5."SULS"   Shadow: δεν υπάρχει mode flag   Έλεγχοι: 2
   ============================================================================= */
    SELECT 'SULS - SubOrdinated Loan Stock table' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- SULS-001: Missing Identification Number (IDNO)
          COUNT(*) AS t1,
          COUNT(CASE WHEN TRIM(TO_CHAR(t."IDNO")) IS NULL THEN 1 END) AS f1,
          -- SULS-002: Invalid date: Timestamp when file was loaded (TIMESTAMP)
          COUNT(*) AS t2,
          COUNT(CASE WHEN TRIM(t."TIMESTAMP") IS NOT NULL AND NOT (REGEXP_LIKE(TRIM(t."TIMESTAMP"), '^[0-9]{4}-[0-9]{2}-[0-9]{2}( [0-9]{2}:[0-9]{2}:[0-9]{2}(\.[0-9]+)?)?$') AND VALIDATE_CONVERSION(SUBSTR(TRIM(t."TIMESTAMP"), 1, 10) AS DATE, 'YYYY-MM-DD') = 1 AND SUBSTR(TRIM(t."TIMESTAMP"), 1, 10) &gt;= '1900-01-01') THEN 1 END) AS f2
        FROM DATACUT5."SULS" t
        CROSS JOIN params p
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'SULS-001|Missing Data|Missing Identification Number (IDNO)',
        (t2, f2) AS 'SULS-002|Invalid Dates|Invalid date: Timestamp when file was loaded (TIMESTAMP)'
      ))
  )
SELECT
    CAST('ME12' AS NVARCHAR2(20))                                AS DQ_AREA,
    CAST(REGEXP_SUBSTR(check_key, '[^|]+', 1, 2) AS NVARCHAR2(50))  AS DQ_CATEGORY,
    CAST(REGEXP_SUBSTR(check_key, '[^|]+', 1, 1) AS NVARCHAR2(30))  AS CHECK_ID,
    CAST(REGEXP_SUBSTR(check_key, '[^|]+', 1, 3) AS NVARCHAR2(500)) AS CHECK_NAME,
    TO_NCHAR(table_name)                                         AS TABLE_NAME,
    total                                                        AS TOTAL_RECORDS,
    failed                                                       AS FAILED_RECORDS,
    TO_NCHAR(CASE WHEN failed = 0 THEN 'PASS' ELSE 'FAIL' END)   AS DQ_STATUS,
    -- IS_MASKED: Y όταν τουλάχιστον ένα πεδίο του ελέγχου έχει «Masking Approach» = Yes στο DD v1.4.
    -- Δίπλα σε κάθε CHECK_ID: τα masked πεδία του. Όλοι οι υπόλοιποι έλεγχοι = N.
    CASE WHEN REGEXP_SUBSTR(check_key, '[^|]+', 1, 1) IN (
        'AUCTION-001',                 -- IDNO
        'CAUTION-001',                 -- IDNO
        'CAUTION-002',                 -- CAUTION_NO
        'CAUTION-003',                 -- DESCRIPTION
        'CLASSIFD-001',                -- IDNO
        'CLIENT-001',                  -- IDNO
        'ELECTORAL_REGISTER-001',      -- IDNO
        'ELECTORAL_REGISTER-002',      -- DOB
        'GARNISHEES-001',              -- IDNO
        'GUARDIANSHIP-001',            -- IDNO
        'INCAPACITATED-001',           -- IDNO
        'INTERDICTED-001',             -- IDNO
        'MSE_REGISTER-001',            -- ID
        'PROHIBITORY_INJUNCTIONS-001', -- IDNO
        'SULS-001'                     -- IDNO
    ) THEN 'Y' ELSE 'N' END                                    AS IS_MASKED,
    TO_NCHAR('DC5')                                              AS DC_Version,
    SYSDATE                                                      AS Run_Timestamp
  FROM all_checks
 ORDER BY table_name, CHECK_ID;</property>
