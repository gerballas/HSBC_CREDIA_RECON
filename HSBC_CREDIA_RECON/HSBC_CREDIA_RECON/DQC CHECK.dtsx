        SELECT
          -- ATCHRGP-501: Product type (AHAPTY) not found in DDPDCPP
          COUNT(CASE WHEN TRIM(s."AHAPTY") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."AHAPTY"), '^[0. ]*$') THEN 1 END) AS t1,
          COUNT(CASE WHEN TRIM(s."AHAPTY") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."AHAPTY"), '^[0. ]*$') AND j1.code IS NULL THEN 1 END) AS f1
        FROM (
              SELECT t."AHAPTY"
                FROM DATACUT5."ATM_MT_ATCHRGP" t
        ) s
        LEFT JOIN ref_apty_dd j1 ON j1.code = TRIM(s."AHAPTY")
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'ATCHRGP-501|Missing Links|Product type (AHAPTY) not found in DDPDCPP'
      ))
    UNION ALL
/* =============================================================================
   ATCYCLP - ATMP Cycle Fund Control File
   Πίνακας: DATACUT5."ATM_MT_ATCYCLP"   Shadow: δεν υπάρχει mode flag   Έλεγχοι: 1
   Έλεγχοι από τις αλλαγές του DD v1.14 και τους κανόνες της στήλης Free column.
   ============================================================================= */
    SELECT 'ATCYCLP - ATMP Cycle Fund Control File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- ATCYCLP-501: Product type (BTAPTY) not found in DDPDCPP
          COUNT(CASE WHEN TRIM(s."BTAPTY") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."BTAPTY"), '^[0. ]*$') THEN 1 END) AS t1,
          COUNT(CASE WHEN TRIM(s."BTAPTY") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."BTAPTY"), '^[0. ]*$') AND j1.code IS NULL THEN 1 END) AS f1
        FROM (
              SELECT t."BTAPTY"
                FROM DATACUT5."ATM_MT_ATCYCLP" t
        ) s
        LEFT JOIN ref_apty_dd j1 ON j1.code = TRIM(s."BTAPTY")
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'ATCYCLP-501|Missing Links|Product type (BTAPTY) not found in DDPDCPP'
      ))
    UNION ALL
/* =============================================================================
   ATFUNCP - Function ID vs Program ID File
   Πίνακας: DATACUT5."ATM_MT_ATFUNCP"   Shadow: δεν υπάρχει mode flag   Έλεγχοι: 1
   Έλεγχοι από τις αλλαγές του DD v1.14 και τους κανόνες της στήλης Free column.
   ============================================================================= */
    SELECT 'ATFUNCP - Function ID vs Program ID File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- ATFUNCP-501: Invalid date: Date Last Update in format DDMMYYYY (AWDLUP)
          COUNT(*) AS t1,
          COUNT(CASE WHEN s.dv_awdlup = -1 THEN 1 END) AS f1
        FROM (
              SELECT (CASE WHEN TRIM(t."AWDLUP") IS NULL OR REGEXP_LIKE(TRIM(t."AWDLUP"), '^[0 -]*$') THEN NULL
                       WHEN REGEXP_LIKE(LPAD(TRIM(t."AWDLUP"), 8, '0'), '^[0-9]{8}$') AND VALIDATE_CONVERSION(LPAD(TRIM(t."AWDLUP"), 8, '0') AS DATE, 'DDMMYYYY') = 1 AND SUBSTR(LPAD(TRIM(t."AWDLUP"), 8, '0'), 5, 4) &gt;= '1900' THEN 1 ELSE -1 END) AS dv_awdlup
                FROM DATACUT5."ATM_MT_ATFUNCP" t
        ) s
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'ATFUNCP-501|Invalid Dates|Invalid date: Date Last Update in format DDMMYYYY (AWDLUP)'
      ))
    UNION ALL
/* =============================================================================
   ATPCHGP - Preferential Transaction Charge Control File
   Πίνακας: DATACUT5."ATM_MT_ATPCHGP"   Shadow: δεν υπάρχει mode flag   Έλεγχοι: 1
   Έλεγχοι από τις αλλαγές του DD v1.14 και τους κανόνες της στήλης Free column.
   ============================================================================= */
    SELECT 'ATPCHGP - Preferential Transaction Charge Control File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- ATPCHGP-501: Product type (BIAPTY) not found in DDPDCPP
          COUNT(CASE WHEN TRIM(s."BIAPTY") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."BIAPTY"), '^[0. ]*$') THEN 1 END) AS t1,
          COUNT(CASE WHEN TRIM(s."BIAPTY") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."BIAPTY"), '^[0. ]*$') AND j1.code IS NULL THEN 1 END) AS f1
        FROM (
              SELECT t."BIAPTY"
                FROM DATACUT5."ATM_MT_ATPCHGP" t
        ) s
        LEFT JOIN ref_apty_dd j1 ON j1.code = TRIM(s."BIAPTY")
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'ATPCHGP-501|Missing Links|Product type (BIAPTY) not found in DDPDCPP'
      ))
    UNION ALL
/* =============================================================================
   ATPDCPP - ATMP Product Type Control File
   Πίνακας: DATACUT5."ATM_MT_ATPDCPP"   Shadow: δεν υπάρχει mode flag   Έλεγχοι: 1
   Έλεγχοι από τις αλλαγές του DD v1.14 και τους κανόνες της στήλης Free column.
   ============================================================================= */
    SELECT 'ATPDCPP - ATMP Product Type Control File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- ATPDCPP-501: Billing Account Currency (unmasked from DD v1.14) (DFBCCY) not a valid ISO 4217 currency code (3 letters or 3 digits)
          COUNT(CASE WHEN TRIM(s."DFBCCY") IS NOT NULL THEN 1 END) AS t1,
          COUNT(CASE WHEN TRIM(s."DFBCCY") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."DFBCCY"), '^([A-Z]{3}|[0-9]{3})$') THEN 1 END) AS f1
        FROM (
              SELECT t."DFBCCY"
                FROM DATACUT5."ATM_MT_ATPDCPP" t
        ) s
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'ATPDCPP-501|Format|Billing Account Currency (unmasked from DD v1.14) (DFBCCY) not a valid ISO 4217 currency code (3 letters or 3 digits)'
      ))
    UNION ALL
/* =============================================================================
   ATSDCPP - ATMP Standing Data Control File
   Πίνακας: DATACUT5."ATM_MT_ATSDCPP"   Shadow: δεν υπάρχει mode flag   Έλεγχοι: 1
   Έλεγχοι από τις αλλαγές του DD v1.14 και τους κανόνες της στήλης Free column.
   ============================================================================= */
    SELECT 'ATSDCPP - ATMP Standing Data Control File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- ATSDCPP-501: Invalid date: Date Last Update (in YYYYMMDD) (DIDLUP)
          COUNT(*) AS t1,
          COUNT(CASE WHEN s.dv_didlup = -1 THEN 1 END) AS f1
        FROM (
              SELECT (CASE WHEN TRIM(t."DIDLUP") IS NULL OR REGEXP_LIKE(TRIM(t."DIDLUP"), '^[0 -]*$') THEN NULL
                       WHEN REGEXP_LIKE(TRIM(t."DIDLUP"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."DIDLUP") AS DATE, 'YYYYMMDD') = 1 AND TRIM(t."DIDLUP") &gt;= '19000101' THEN TO_NUMBER(TRIM(t."DIDLUP")) ELSE -1 END) AS dv_didlup
                FROM DATACUT5."ATM_MT_ATSDCPP" t
        ) s
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'ATSDCPP-501|Invalid Dates|Invalid date: Date Last Update (in YYYYMMDD) (DIDLUP)'
      ))
    UNION ALL
/* =============================================================================
   ATSTDPP - ATMP Standing Data File
   Πίνακας: DATACUT5."ATM_MT_ATSTDPP"   Shadow: δεν υπάρχει mode flag   Έλεγχοι: 1
   Έλεγχοι από τις αλλαγές του DD v1.14 και τους κανόνες της στήλης Free column.
   ============================================================================= */
    SELECT 'ATSTDPP - ATMP Standing Data File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- ATSTDPP-501: Invalid date: Date Last Update (in YYYYMMDD) (DHDLUP)
          COUNT(*) AS t1,
          COUNT(CASE WHEN s.dv_dhdlup = -1 THEN 1 END) AS f1
        FROM (
              SELECT (CASE WHEN TRIM(t."DHDLUP") IS NULL OR REGEXP_LIKE(TRIM(t."DHDLUP"), '^[0 -]*$') THEN NULL
                       WHEN REGEXP_LIKE(TRIM(t."DHDLUP"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."DHDLUP") AS DATE, 'YYYYMMDD') = 1 AND TRIM(t."DHDLUP") &gt;= '19000101' THEN TO_NUMBER(TRIM(t."DHDLUP")) ELSE -1 END) AS dv_dhdlup
                FROM DATACUT5."ATM_MT_ATSTDPP" t
        ) s
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'ATSTDPP-501|Invalid Dates|Invalid date: Date Last Update (in YYYYMMDD) (DHDLUP)'
      ))
    UNION ALL
/* =============================================================================
   ATTNFFP - ATMP Transaction Log File
   Πίνακας: DATACUT5."ATM_MT_ATTNFFP"   Shadow: δεν υπάρχει mode flag   Έλεγχοι: 2
   Έλεγχοι από τις αλλαγές του DD v1.14 και τους κανόνες της στήλης Free column.
   ============================================================================= */
    SELECT 'ATTNFFP - ATMP Transaction Log File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- ATTNFFP-501: Phone banking number (EAPBN) not found in EBCUSTP
          COUNT(CASE WHEN NVL(s.n_eapbn, 0) &lt;&gt; 0 THEN 1 END) AS t1,
          COUNT(CASE WHEN NVL(s.n_eapbn, 0) &lt;&gt; 0 AND j1.pbn IS NULL THEN 1 END) AS f1,
          -- ATTNFFP-502: Currency of Notes for GCWD (unmasked from DD v1.14) (EAWDCY) not a valid ISO 4217 currency code (3 letters or 3 digits)
          COUNT(CASE WHEN TRIM(s."EAWDCY") IS NOT NULL THEN 1 END) AS t2,
          COUNT(CASE WHEN TRIM(s."EAWDCY") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."EAWDCY"), '^([A-Z]{3}|[0-9]{3})$') THEN 1 END) AS f2
        FROM (
              SELECT t."EAWDCY",
                     (CASE WHEN VALIDATE_CONVERSION(TRIM(t."EAPBN") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."EAPBN")) END) AS n_eapbn
                FROM DATACUT5."ATM_MT_ATTNFFP" t
        ) s
        LEFT JOIN k_pbn j1 ON j1.pbn = s.n_eapbn
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'ATTNFFP-501|Missing Links|Phone banking number (EAPBN) not found in EBCUSTP',
        (t2, f2) AS 'ATTNFFP-502|Format|Currency of Notes for GCWD (unmasked from DD v1.14) (EAWDCY) not a valid ISO 4217 currency code (3 letters or 3 digits)'
      ))
    UNION ALL
/* =============================================================================
   ATTNFJP - ATMP Transaction Journal File
   Πίνακας: DATACUT5."ATM_MT_ATTNFJP"   Shadow: δεν υπάρχει mode flag   Έλεγχοι: 2
   Έλεγχοι από τις αλλαγές του DD v1.14 και τους κανόνες της στήλης Free column.
   ============================================================================= */
    SELECT 'ATTNFJP - ATMP Transaction Journal File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- ATTNFJP-501: Phone banking number (EAPBN) not found in EBCUSTP
          COUNT(CASE WHEN NVL(s.n_eapbn, 0) &lt;&gt; 0 THEN 1 END) AS t1,
          COUNT(CASE WHEN NVL(s.n_eapbn, 0) &lt;&gt; 0 AND j1.pbn IS NULL THEN 1 END) AS f1,
          -- ATTNFJP-502: Currency of Notes for GCWD (unmasked from DD v1.14) (EAWDCY) not a valid ISO 4217 currency code (3 letters or 3 digits)
          COUNT(CASE WHEN TRIM(s."EAWDCY") IS NOT NULL THEN 1 END) AS t2,
          COUNT(CASE WHEN TRIM(s."EAWDCY") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."EAWDCY"), '^([A-Z]{3}|[0-9]{3})$') THEN 1 END) AS f2
        FROM (
              SELECT t."EAWDCY",
                     (CASE WHEN VALIDATE_CONVERSION(TRIM(t."EAPBN") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."EAPBN")) END) AS n_eapbn
                FROM DATACUT5."ATM_MT_ATTNFJP" t
        ) s
        LEFT JOIN k_pbn j1 ON j1.pbn = s.n_eapbn
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'ATTNFJP-501|Missing Links|Phone banking number (EAPBN) not found in EBCUSTP',
        (t2, f2) AS 'ATTNFJP-502|Format|Currency of Notes for GCWD (unmasked from DD v1.14) (EAWDCY) not a valid ISO 4217 currency code (3 letters or 3 digits)'
      ))
    UNION ALL
/* =============================================================================
   ATVNOCP - Visa Card Number Generation File
   Πίνακας: DATACUT5."ATM_MT_ATVNOCP"   Shadow: δεν υπάρχει mode flag   Έλεγχοι: 1
   Έλεγχοι από τις αλλαγές του DD v1.14 και τους κανόνες της στήλης Free column.
   ============================================================================= */
    SELECT 'ATVNOCP - Visa Card Number Generation File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- ATVNOCP-501: Invalid date: Date Last Update in format YYYYMMDD (FHDLUP)
          COUNT(*) AS t1,
          COUNT(CASE WHEN s.dv_fhdlup = -1 THEN 1 END) AS f1
        FROM (
              SELECT (CASE WHEN TRIM(t."FHDLUP") IS NULL OR REGEXP_LIKE(TRIM(t."FHDLUP"), '^[0 -]*$') THEN NULL
                       WHEN REGEXP_LIKE(TRIM(t."FHDLUP"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."FHDLUP") AS DATE, 'YYYYMMDD') = 1 AND TRIM(t."FHDLUP") &gt;= '19000101' THEN TO_NUMBER(TRIM(t."FHDLUP")) ELSE -1 END) AS dv_fhdlup
                FROM DATACUT5."ATM_MT_ATVNOCP" t
        ) s
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'ATVNOCP-501|Invalid Dates|Invalid date: Date Last Update in format YYYYMMDD (FHDLUP)'
      ))
  )
SELECT
    CAST('ME04' AS NVARCHAR2(20))                                AS DQ_AREA,
    CAST(REGEXP_SUBSTR(check_key, '[^|]+', 1, 2) AS NVARCHAR2(50))  AS DQ_CATEGORY,
    CAST(REGEXP_SUBSTR(check_key, '[^|]+', 1, 1) AS NVARCHAR2(30))  AS CHECK_ID,
    CAST(REGEXP_SUBSTR(check_key, '[^|]+', 1, 3) AS NVARCHAR2(500)) AS CHECK_NAME,
    TO_NCHAR(table_name)                                         AS TABLE_NAME,
    total                                                        AS TOTAL_RECORDS,
    failed                                                       AS FAILED_RECORDS,
    TO_NCHAR(CASE WHEN failed = 0 THEN 'PASS' ELSE 'FAIL' END)   AS DQ_STATUS,
    -- IS_MASKED: Y όταν τουλάχιστον ένα πεδίο του ελέγχου έχει «Masking Applied» = Yes στο DD v1.14.
    -- Δίπλα σε κάθε CHECK_ID: τα masked πεδία του. Όλοι οι υπόλοιποι έλεγχοι = N.
    CASE WHEN REGEXP_SUBSTR(check_key, '[^|]+', 1, 1) IN (
        'ATAULJP-001',  -- FACDNO
        'ATAULJP-002',  -- FACPDT
        'ATAULJP-003',  -- FAXDAT
        'ATAULJP-007',  -- FAPEX
        'ATAULJP-505',  -- FACTTC
        'ATCAHFP-002',  -- ACPAN
        'ATCAHFP-003',  -- ACCDNO
        'ATCAHFP-004',  -- ACCAHN
        'ATCAHFP-007',  -- ACDCS
        'ATCAHFP-011',  -- ACDCS
        'ATCAHFP-012',  -- ACCAHN
        'ATCAHFP-013',  -- ACCAHN
        'ATCAHFP-032',  -- ACPAN
        'ATCAHFP-033',  -- ACDCS
        'ATCAHFP-035',  -- ACIDNO
        'ATCAHFP-036',  -- ACSAN1
        'ATCAHFP-037',  -- ACSAN2
        'ATCAHFP-501',  -- ACPAN
        'ATCAHFP-502',  -- ACPPAN
        'ATTNFFP-001',  -- EACDNO
        'ATTNFFP-002',  -- EAXDAT
        'ATTNFFP-005',  -- EALISS
        'ATTNFFP-008',  -- EADCS
        'ATTNFFP-501',  -- EAPBN
        'ATTNFJP-001',  -- EACDNO
        'ATTNFJP-002',  -- EAXDAT
        'ATTNFJP-005',  -- EALISS
        'ATTNFJP-008',  -- EADCS
        'ATTNFJP-501',  -- EAPBN
        'AT_CAHEP-001', -- A@PAN
        'AT_CAHEP-003', -- A@DLTN
        'AT_CAHEP-004', -- A@CTCD+A@PAN
        'AT_CAHEP-005', -- A@PAN
        'AT_CBNP-503',  -- CHICNO
        'AT_CCDP-503',  -- CHICNO
        'AT_CPDP-503',  -- CHICNO
        'MVATSUP-001',  -- SPCRNO
        'MVATSUP-002',  -- SPCRNO
        'MVATSUP-003',  -- SPCRNO+ACCDNO (ATCAHFP)
        'MVATSUP-004',  -- SPIDNO
        'MVCLMPP-001',  -- TQCTCD
        'MVCLMPP-002',  -- TQCDNO
        'MVCLMPP-004'   -- TQXDAT
    ) THEN 'Y' ELSE 'N' END                                    AS IS_MASKED,
    TO_NCHAR('DC5')                                              AS DC_Version,
    SYSDATE                                                      AS Run_Timestamp
  FROM all_checks
 ORDER BY table_name, CHECK_ID;</property>
