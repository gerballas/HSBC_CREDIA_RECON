        (t9, f9) AS 'SETTRFSHBN-009|Missing Links|Customer (CUSTNO) not found in SSCUSTP',
        (t10, f10) AS 'SETTRFSHBN-010|Inconsistent Data|HUB customer number (CUSTNO) differs from the deceased file in DECEASED (same SNO)'
      ))
