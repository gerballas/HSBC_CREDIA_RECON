        (t2, f2) AS 'SETTRFSHBN-002|Missing Data|Missing HUB Customer No (CUSTNO)',
        (t3, f3) AS 'SETTRFSHBN-003|Invalid Values|File reference number not in format 9999/YY (SNO)',
