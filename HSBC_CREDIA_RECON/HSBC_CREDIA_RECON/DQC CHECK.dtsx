                <component
                  refId="Package\DQC_DC5\ME04_ATM_DQC\ME04_ATM_DQC"
                  componentClassID="Microsoft.SSISOracleSrc"
                  contactInfo="Oracle Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;1"
                  description="Oracle Source"
                  name="ME04_ATM_DQC"
                  usesDispositions="true"
                  version="1">
                  <properties>
                    <property
                      dataType="System.String"
                      description="The name of the table to be fetched."
                      expressionType="Notify"
                      name="TableName"></property>
                    <property
                      dataType="System.String"
                      description="The SQL command to be executed."
                      expressionType="Notify"
                      name="SqlCommand"
                      UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor, Microsoft.DataTransformationServices.Controls, Version=16.0.0.0, Culture=neutral, PublicKeyToken=89845dcd8080cc91">/* =============================================================================
   ME04_ATM_DQC_DC5_Unified.sql  —  HUB ATM (EIM 240314) DC5: όλοι οι έλεγχοι
   Περιεχόμενο : Ενιαίο script για το ME04 στο DC5 (110 έλεγχοι σε 23 πίνακες):
                   - 76 έλεγχοι του DC4 (ME04_ATM_DQC_V3.sql), αυτούσιοι, με schema DATACUT5
                   - 34 νέοι έλεγχοι του DC5 (ME04_ATM_DQC_DC5.sql), αυτούσιοι
                 Αντικαθιστά το να τρέχουν χωριστά τα δύο παραπάνω scripts.
   -----------------------------------------------------------------------------
   Πηγή πεδίων : 04. 21.1282 240314_ME04 _HUB_ATM_v1.0_DDAMO_ v1.14_REDACTED.xlsx
                 (+ ME01 DD v1.24 για HUB_MT_SSCUSTP, HUB_MT_DDPDCPP, HUB_MT_EBCUSTP)
                 Όλα τα πεδία των ελέγχων του DC4 υπάρχουν και στο DD v1.14.
   Schema      : DATACUT5 (ATM_MT_* και HUB_MT_* πίνακες)
   Πλατφόρμα   : Oracle 12.2+ (χρησιμοποιεί VALIDATE_CONVERSION)
   Κατάλογος   : DC4 έλεγχοι -&gt; ME04_ATM_DQC_V3_Check_Catalogue.docx (φάκελος DC4)
                 DC5 έλεγχοι -&gt; ME04_ATM_DQC_DC5_Check_Catalogue.txt
   Output      : DQ_AREA | DQ_CATEGORY | CHECK_ID | CHECK_NAME | TABLE_NAME |
                 TOTAL_RECORDS | FAILED_RECORDS | DQ_STATUS | IS_MASKED |
                 DC_Version | Run_Timestamp
                 DQ_STATUS: PASS όταν FAILED_RECORDS = 0, αλλιώς FAIL.
                 IS_MASKED: Y όταν τουλάχιστον ένα πεδίο του ελέγχου έχει
                 «Masking Applied» = Yes στο DD v1.14, αλλιώς N.
                 Οι στήλες κειμένου (εκτός IS_MASKED) είναι NVARCHAR2 για τη φόρτωση
                 μέσω SSIS στον ίδιο πίνακα με το ME01 (ίδιοι τύποι και μήκη).
   ΣΗΜ.        : Οι πίνακες ATCAHFP, ATAULJP, ATTNFFP, ATTNFJP έχουν ενότητα και στο
                 κομμάτι του DC4 και στο κομμάτι του DC5, άρα διαβάζονται δύο φορές
                 (ίδια λογική με το ME01_HUB_DQC_DC5.sql). Οι κανόνες, οι συμβάσεις
                 ημερομηνιών και οι οδηγίες για ORA-00942 / ORA-00904 είναι αυτές
                 των δύο αρχικών scripts.
   ============================================================================= */
WITH
  -- Ημερομηνία αναφοράς για τους ελέγχους "στο μέλλον". Για αναπαραγώγιμα αποτελέσματα βάλε την ημερομηνία του Data Cut.
  params AS (SELECT TO_NUMBER(TO_CHAR(TRUNC(SYSDATE), 'YYYYMMDD')) AS ref_num FROM dual),
  -- Κοινές λίστες: υπολογίζονται ΜΙΑ φορά και τις χρησιμοποιούν όλοι οι έλεγχοι διασύνδεσης.
  -- πελάτες SSCUSTP (ME01)
  k_cus AS (
    SELECT /*+ MATERIALIZE */ DISTINCT (CASE WHEN VALIDATE_CONVERSION(TRIM("ZGDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM("ZGDCB")) END) AS dcb, (CASE WHEN VALIDATE_CONVERSION(TRIM("ZGDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM("ZGDCS")) END) AS dcs FROM DATACUT5."HUB_MT_SSCUSTP" WHERE NVL("ZGMDFL",' ') &lt;&gt; 'S'
  ),
  -- ATM product types από το ATPDCPP (ATMP Product Type Control File)
  ref_pdty AS (
    SELECT /*+ MATERIALIZE */ DISTINCT TRIM("DFPDTY") AS code FROM DATACUT5."ATM_MT_ATPDCPP" WHERE TRIM("DFPDTY") IS NOT NULL
  ),
  -- κάρτες ATCAHFP: αριθμός κάρτας (ACCDNO)
  k_card AS (
    SELECT /*+ MATERIALIZE */ DISTINCT (CASE WHEN VALIDATE_CONVERSION(TRIM("ACCDNO") AS NUMBER) = 1 THEN TO_NUMBER(TRIM("ACCDNO")) END) AS cdno FROM DATACUT5."ATM_MT_ATCAHFP"
  ),
  -- κάρτες ATCAHFP: PAN + issue number (ACPAN + ACCINO)
  k_cahfp AS (
    SELECT /*+ MATERIALIZE */ DISTINCT (CASE WHEN VALIDATE_CONVERSION(TRIM("ACPAN") AS NUMBER) = 1 THEN TO_NUMBER(TRIM("ACPAN")) END) AS pan, (CASE WHEN VALIDATE_CONVERSION(TRIM("ACCINO") AS NUMBER) = 1 THEN TO_NUMBER(TRIM("ACCINO")) END) AS cino FROM DATACUT5."ATM_MT_ATCAHFP"
  ),
  -- Επιπλέον κοινές λίστες των ελέγχων DC5 (DD v1.14)
  -- τύποι προϊόντων DDPDCPP
  ref_apty_dd AS (
    SELECT /*+ MATERIALIZE */ DISTINCT TRIM("DAAPTY") AS code FROM DATACUT5."HUB_MT_DDPDCPP" WHERE NVL("DAMDFL",' ') &lt;&gt; 'S'
  ),
  -- phone banking numbers EBCUSTP
  k_pbn AS (
    SELECT /*+ MATERIALIZE */ DISTINCT (CASE WHEN VALIDATE_CONVERSION(TRIM("PCPBN") AS NUMBER) = 1 THEN TO_NUMBER(TRIM("PCPBN")) END) AS pbn FROM DATACUT5."HUB_MT_EBCUSTP" WHERE NVL("PCMDFL",' ') &lt;&gt; 'S'
  ),
  all_checks AS (
/* ######################## DC4 V3 ελέγχοι (DD v1.13, πεδία επιβεβαιωμένα στο v1.14) ######################## */
/* =============================================================================
   AT@CAHEP - ATMP Card holder extension file
   Πίνακας: DATACUT5."ATM_MT_AT@CAHEP"   Shadow: δεν υπάρχει mode flag   Έλεγχοι: 5
   ============================================================================= */
    SELECT 'AT@CAHEP - ATMP Card holder extension file' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- AT_CAHEP-001: Missing primary account number / PAN (A@PAN)
          COUNT(*) AS t1,
          COUNT(CASE WHEN NVL(s.n_pan, 0) = 0 THEN 1 END) AS f1,
          -- AT_CAHEP-002: Invalid time: Time Last Transaction (A@TLTN)
          COUNT(*) AS t2,
          COUNT(CASE WHEN s.tm_tltn = 1 THEN 1 END) AS f2,
          -- AT_CAHEP-003: Invalid date: Date Last Transaction (A@DLTN)
          COUNT(*) AS t3,
          COUNT(CASE WHEN s.dv_dltn = -1 THEN 1 END) AS f3,
          -- AT_CAHEP-004: Duplicate card key (A@CTCD+A@GMAB+A@PAN+A@CINO)
          COUNT(CASE WHEN NVL(s.n_pan, 0) &lt;&gt; 0 THEN 1 END) AS t4,
          COUNT(CASE WHEN NVL(s.n_pan, 0) &lt;&gt; 0 AND s.dup_n &gt; 1 THEN 1 END) AS f4,
          -- AT_CAHEP-005: Card (A@PAN+A@CINO) not found in ATCAHFP
          COUNT(CASE WHEN NVL(s.n_pan, 0) &lt;&gt; 0 THEN 1 END) AS t5,
          COUNT(CASE WHEN NVL(s.n_pan, 0) &lt;&gt; 0 AND j1.pan IS NULL THEN 1 END) AS f5
        FROM (
          SELECT s0.*, COUNT(*) OVER (PARTITION BY TRIM(s0."A@CTCD"), TRIM(s0."A@GMAB"), s0.n_pan, s0.n_cino) AS dup_n
            FROM (
              SELECT t.*,
                     (CASE WHEN VALIDATE_CONVERSION(TRIM(t."A@PAN") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."A@PAN")) END) AS n_pan,
                     (CASE WHEN VALIDATE_CONVERSION(TRIM(t."A@CINO") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."A@CINO")) END) AS n_cino,
                     (CASE WHEN TRIM(t."A@TLTN") IS NOT NULL AND NOT REGEXP_LIKE(LPAD(TRIM(t."A@TLTN"), 6, '0'), '^([01][0-9]|2[0-3])[0-5][0-9][0-5][0-9]$') THEN 1 ELSE 0 END) AS tm_tltn,
                     (CASE WHEN TRIM(t."A@DLTN") IS NULL OR REGEXP_LIKE(TRIM(t."A@DLTN"), '^[0 -]*$') THEN NULL
                           WHEN REGEXP_LIKE(TRIM(t."A@DLTN"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."A@DLTN") AS DATE, 'YYYYMMDD') = 1 AND TRIM(t."A@DLTN") &gt;= '19000101' THEN TO_NUMBER(TRIM(t."A@DLTN")) ELSE -1 END) AS dv_dltn
                FROM DATACUT5."ATM_MT_AT@CAHEP" t
            ) s0
        ) s
        LEFT JOIN k_cahfp j1 ON j1.pan = s.n_pan AND j1.cino = s.n_cino
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'AT_CAHEP-001|Missing Data|Missing primary account number / PAN (A@PAN)',
        (t2, f2) AS 'AT_CAHEP-002|Invalid Values|Invalid time: Time Last Transaction (A@TLTN)',
        (t3, f3) AS 'AT_CAHEP-003|Invalid Dates|Invalid date: Date Last Transaction (A@DLTN)',
        (t4, f4) AS 'AT_CAHEP-004|Duplicates|Duplicate card key (A@CTCD+A@GMAB+A@PAN+A@CINO)',
        (t5, f5) AS 'AT_CAHEP-005|Missing Links|Card (A@PAN+A@CINO) not found in ATCAHFP'
      ))
    UNION ALL
/* =============================================================================
   ATCAHFP - ATM Cardholder File
   Πίνακας: DATACUT5."ATM_MT_ATCAHFP"   Shadow: δεν υπάρχει mode flag   Έλεγχοι: 38
   Ο κύριος πίνακας καρτών: εκτός από τους γενικούς κανόνες έχει και ειδικούς
   κανόνες πεδίο-πεδίο (όπως το SSCUSTP στο ME01).
   ΣΗΜ.: η ημερομηνία τελευταίας συναλλαγής είναι γραμμένη στο DD ως 'a'
   (τυπογραφικό). Χρησιμοποιείται η στήλη ACDLTN, όπως στο 62000_Cards.sql.
   ============================================================================= */
    SELECT 'ATCAHFP - ATM Cardholder File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- ATCAHFP-001: Missing country code or group member (ACCTCD/ACGMAB)
          COUNT(*) AS t1,
          COUNT(CASE WHEN TRIM(s."ACCTCD") IS NULL OR TRIM(s."ACGMAB") IS NULL THEN 1 END) AS f1,
          -- ATCAHFP-002: Missing primary account number / PAN (ACPAN)
          COUNT(*) AS t2,
          COUNT(CASE WHEN NVL(s.n_pan, 0) = 0 THEN 1 END) AS f2,
          -- ATCAHFP-003: Missing card number (ACCDNO)
          COUNT(*) AS t3,
          COUNT(CASE WHEN NVL(s.n_cdno, 0) = 0 THEN 1 END) AS f3,
          -- ATCAHFP-004: Missing cardholder name (ACCAHN)
          COUNT(*) AS t4,
          COUNT(CASE WHEN TRIM(s."ACCAHN") IS NULL THEN 1 END) AS f4,
          -- ATCAHFP-005: Missing ATM product type (ACPDTY)
          COUNT(*) AS t5,
          COUNT(CASE WHEN TRIM(s."ACPDTY") IS NULL THEN 1 END) AS f5,
          -- ATCAHFP-006: Missing card status (ACCDST)
          COUNT(*) AS t6,
          COUNT(CASE WHEN TRIM(s."ACCDST") IS NULL THEN 1 END) AS f6,
          -- ATCAHFP-007: Missing customer key (ACDCB/ACDCS)
          COUNT(*) AS t7,
          COUNT(CASE WHEN NVL(s.n_dcb, 0) = 0 OR NVL(s.n_dcs, 0) = 0 THEN 1 END) AS f7,
          -- ATCAHFP-008: Missing card expiry date (ACCDEX)
          COUNT(*) AS t8,
          COUNT(CASE WHEN s.ym_dex IS NULL THEN 1 END) AS f8,
          -- ATCAHFP-009: Missing first issue date (ACFISS)
          COUNT(*) AS t9,
          COUNT(CASE WHEN s.dv_fiss IS NULL THEN 1 END) AS f9,
          -- ATCAHFP-010: Missing current issue date (ACLISS)
          COUNT(*) AS t10,
          COUNT(CASE WHEN s.dv_liss IS NULL THEN 1 END) AS f10,
          -- ATCAHFP-011: Customer branch not 1-999 or serial not &gt; 0 (ACDCB/ACDCS)
          COUNT(CASE WHEN NVL(s.n_dcb, 0) &lt;&gt; 0 AND NVL(s.n_dcs, 0) &lt;&gt; 0 THEN 1 END) AS t11,
          COUNT(CASE WHEN NVL(s.n_dcb, 0) &lt;&gt; 0 AND NVL(s.n_dcs, 0) &lt;&gt; 0
                      AND (s.n_dcb NOT BETWEEN 1 AND 999 OR s.n_dcs &lt; 0) THEN 1 END) AS f11,
          -- ATCAHFP-012: Cardholder name contains no letters (ACCAHN)
          COUNT(CASE WHEN TRIM(s."ACCAHN") IS NOT NULL THEN 1 END) AS t12,
          COUNT(CASE WHEN TRIM(s."ACCAHN") IS NOT NULL AND NOT REGEXP_LIKE(s."ACCAHN", '[[:alpha:]]') THEN 1 END) AS f12,
          -- ATCAHFP-013: Cardholder name with leading space, double spaces or control characters (ACCAHN)
          COUNT(CASE WHEN TRIM(s."ACCAHN") IS NOT NULL THEN 1 END) AS t13,
          COUNT(CASE WHEN TRIM(s."ACCAHN") IS NOT NULL AND REGEXP_LIKE(RTRIM(s."ACCAHN"), '^ |  |[[:cntrl:]]') THEN 1 END) AS f13,
          -- ATCAHFP-014: PAN type not 1/2/3 (ACPANT)
          COUNT(*) AS t14,
          COUNT(CASE WHEN TRIM(s."ACPANT") IS NOT NULL AND TRIM(s."ACPANT") NOT IN ('1','2','3') THEN 1 END) AS f14,
          -- ATCAHFP-015: PIN despatch code not M/C (ACPDCD)
          COUNT(*) AS t15,
          COUNT(CASE WHEN TRIM(s."ACPDCD") IS NOT NULL AND TRIM(s."ACPDCD") NOT IN ('M','C') THEN 1 END) AS f15,
          -- ATCAHFP-016: PIN retry count above 4 (ACPTRC)
          COUNT(*) AS t16,
          COUNT(CASE WHEN s.n_ptrc &gt; 4 OR s.n_ptrc &lt; 0 THEN 1 END) AS f16,
          -- ATCAHFP-017: Invalid time: Time Loaded HOT (ACHTIM)
          COUNT(*) AS t17,
          COUNT(CASE WHEN s.tm_htim = 1 THEN 1 END) AS f17,
          -- ATCAHFP-018: Invalid time: Time Last Transaction (ACTLTN)
          COUNT(*) AS t18,
          COUNT(CASE WHEN s.tm_tltn = 1 THEN 1 END) AS f18,
          -- ATCAHFP-019: Invalid time: Time Last Maintenance (ACTLMT)
          COUNT(*) AS t19,
          COUNT(CASE WHEN s.tm_tlmt = 1 THEN 1 END) AS f19,
          -- ATCAHFP-020: Invalid card expiry date, not YYMM (ACCDEX)
          COUNT(*) AS t20,
          COUNT(CASE WHEN s.ym_dex = -1 THEN 1 END) AS f20,
          -- ATCAHFP-021: Invalid new card expiry date, not YYMM (ACCEXN)
          COUNT(*) AS t21,
          COUNT(CASE WHEN s.ym_exn = -1 THEN 1 END) AS f21,
          -- ATCAHFP-022: Invalid date: First Issue Date (ACFISS)
          COUNT(*) AS t22,
          COUNT(CASE WHEN s.dv_fiss = -1 THEN 1 END) AS f22,
          -- ATCAHFP-023: Invalid date: Current Issue Date (ACLISS)
          COUNT(*) AS t23,
          COUNT(CASE WHEN s.dv_liss = -1 THEN 1 END) AS f23,
          -- ATCAHFP-024: Invalid date: Date Last Transaction (ACDLTN)
          COUNT(*) AS t24,
          COUNT(CASE WHEN s.dv_dltn = -1 THEN 1 END) AS f24,
          -- ATCAHFP-025: Invalid date: Date Last Maintenance (ACDLMT)
          COUNT(*) AS t25,
          COUNT(CASE WHEN s.dv_dlmt = -1 THEN 1 END) AS f25,
          -- ATCAHFP-026: Invalid date: Date Loaded HOT (ACHDAT)
          COUNT(*) AS t26,
          COUNT(CASE WHEN s.dv_hdat = -1 THEN 1 END) AS f26,
          -- ATCAHFP-027: Future date: First Issue Date (ACFISS)
          COUNT(CASE WHEN s.dv_fiss &gt; 0 THEN 1 END) AS t27,
          COUNT(CASE WHEN s.dv_fiss &gt; p.ref_num THEN 1 END) AS f27,
          -- ATCAHFP-028: Future date: Current Issue Date (ACLISS)
          COUNT(CASE WHEN s.dv_liss &gt; 0 THEN 1 END) AS t28,
          COUNT(CASE WHEN s.dv_liss &gt; p.ref_num THEN 1 END) AS f28,
          -- ATCAHFP-029: Future date: Date Last Transaction (ACDLTN)
          COUNT(CASE WHEN s.dv_dltn &gt; 0 THEN 1 END) AS t29,
          COUNT(CASE WHEN s.dv_dltn &gt; p.ref_num THEN 1 END) AS f29,
          -- ATCAHFP-030: Future date: Date Last Maintenance (ACDLMT)
          COUNT(CASE WHEN s.dv_dlmt &gt; 0 THEN 1 END) AS t30,
          COUNT(CASE WHEN s.dv_dlmt &gt; p.ref_num THEN 1 END) AS f30,
          -- ATCAHFP-031: Future date: Date Loaded HOT (ACHDAT)
          COUNT(CASE WHEN s.dv_hdat &gt; 0 THEN 1 END) AS t31,
          COUNT(CASE WHEN s.dv_hdat &gt; p.ref_num THEN 1 END) AS f31,
          -- ATCAHFP-032: Duplicate card key (ACCTCD+ACGMAB+ACPAN+ACCINO)
          COUNT(CASE WHEN NVL(s.n_pan, 0) &lt;&gt; 0 THEN 1 END) AS t32,
          COUNT(CASE WHEN NVL(s.n_pan, 0) &lt;&gt; 0 AND s.dup_n &gt; 1 THEN 1 END) AS f32,
          -- ATCAHFP-033: Customer (ACDCB+ACDCS) not found in SSCUSTP
          COUNT(CASE WHEN NVL(s.n_dcb, 0) &lt;&gt; 0 AND NVL(s.n_dcs, 0) &lt;&gt; 0 THEN 1 END) AS t33,
          COUNT(CASE WHEN NVL(s.n_dcb, 0) &lt;&gt; 0 AND NVL(s.n_dcs, 0) &lt;&gt; 0 AND j1.dcb IS NULL THEN 1 END) AS f33,
          -- ATCAHFP-034: ATM product type not found in ATPDCPP (ACPDTY)
          COUNT(CASE WHEN TRIM(s."ACPDTY") IS NOT NULL THEN 1 END) AS t34,
          COUNT(CASE WHEN TRIM(s."ACPDTY") IS NOT NULL AND j2.code IS NULL THEN 1 END) AS f34,
          -- ATCAHFP-035: Identity type and number not populated together (ACIDTY/ACIDNO)
          COUNT(*) AS t35,
          COUNT(CASE WHEN (TRIM(s."ACIDTY") IS NULL AND TRIM(s."ACIDNO") IS NOT NULL)
                       OR (TRIM(s."ACIDTY") IS NOT NULL AND TRIM(s."ACIDNO") IS NULL) THEN 1 END) AS f35,
          -- ATCAHFP-036: Secondary account 1 without country code or group member (ACSAN1/ACSCC1/ACSGM1)
          COUNT(CASE WHEN NVL(s.n_san1, 0) &lt;&gt; 0 THEN 1 END) AS t36,
          COUNT(CASE WHEN NVL(s.n_san1, 0) &lt;&gt; 0 AND (TRIM(s."ACSCC1") IS NULL OR TRIM(s."ACSGM1") IS NULL) THEN 1 END) AS f36,
          -- ATCAHFP-037: Secondary account 2 without country code or group member (ACSAN2/ACSCC2/ACSGM2)
          COUNT(CASE WHEN NVL(s.n_san2, 0) &lt;&gt; 0 THEN 1 END) AS t37,
          COUNT(CASE WHEN NVL(s.n_san2, 0) &lt;&gt; 0 AND (TRIM(s."ACSCC2") IS NULL OR TRIM(s."ACSGM2") IS NULL) THEN 1 END) AS f37,
          -- ATCAHFP-038: Current issue date before first issue date (ACLISS &lt; ACFISS)
          COUNT(CASE WHEN s.dv_fiss &gt; 0 AND s.dv_liss &gt; 0 THEN 1 END) AS t38,
          COUNT(CASE WHEN s.dv_fiss &gt; 0 AND s.dv_liss &gt; 0 AND s.dv_liss &lt; s.dv_fiss THEN 1 END) AS f38
        FROM (
          SELECT s0.*, COUNT(*) OVER (PARTITION BY TRIM(s0."ACCTCD"), TRIM(s0."ACGMAB"), s0.n_pan, s0.n_cino) AS dup_n
            FROM (
              SELECT t.*,
                     (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ACPAN") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ACPAN")) END) AS n_pan,
                     (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ACCINO") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ACCINO")) END) AS n_cino,
                     (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ACCDNO") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ACCDNO")) END) AS n_cdno,
                     (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ACDCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ACDCB")) END) AS n_dcb,
                     (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ACDCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ACDCS")) END) AS n_dcs,
                     (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ACSAN1") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ACSAN1")) END) AS n_san1,
                     (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ACSAN2") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ACSAN2")) END) AS n_san2,
                     (CASE WHEN VALIDATE_CONVERSION(TRIM(t."ACPTRC") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."ACPTRC")) END) AS n_ptrc,
                     (CASE WHEN TRIM(t."ACHTIM") IS NOT NULL AND NOT REGEXP_LIKE(LPAD(TRIM(t."ACHTIM"), 6, '0'), '^([01][0-9]|2[0-3])[0-5][0-9][0-5][0-9]$') THEN 1 ELSE 0 END) AS tm_htim,
                     (CASE WHEN TRIM(t."ACTLTN") IS NOT NULL AND NOT REGEXP_LIKE(LPAD(TRIM(t."ACTLTN"), 6, '0'), '^([01][0-9]|2[0-3])[0-5][0-9][0-5][0-9]$') THEN 1 ELSE 0 END) AS tm_tltn,
                     (CASE WHEN TRIM(t."ACTLMT") IS NOT NULL AND NOT REGEXP_LIKE(LPAD(TRIM(t."ACTLMT"), 6, '0'), '^([01][0-9]|2[0-3])[0-5][0-9][0-5][0-9]$') THEN 1 ELSE 0 END) AS tm_tlmt,
                     (CASE WHEN TRIM(t."ACCDEX") IS NULL OR REGEXP_LIKE(TRIM(t."ACCDEX"), '^[0 -]*$') THEN NULL
                           WHEN REGEXP_LIKE(LPAD(TRIM(t."ACCDEX"), 4, '0'), '^[0-9]{2}(0[1-9]|1[0-2])$') THEN 1 ELSE -1 END) AS ym_dex,
                     (CASE WHEN TRIM(t."ACCEXN") IS NULL OR REGEXP_LIKE(TRIM(t."ACCEXN"), '^[0 -]*$') THEN NULL
                           WHEN REGEXP_LIKE(LPAD(TRIM(t."ACCEXN"), 4, '0'), '^[0-9]{2}(0[1-9]|1[0-2])$') THEN 1 ELSE -1 END) AS ym_exn,
                     (CASE WHEN TRIM(t."ACFISS") IS NULL OR REGEXP_LIKE(TRIM(t."ACFISS"), '^[0 -]*$') THEN NULL
                           WHEN REGEXP_LIKE(TRIM(t."ACFISS"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."ACFISS") AS DATE, 'YYYYMMDD') = 1 AND TRIM(t."ACFISS") &gt;= '19000101' THEN TO_NUMBER(TRIM(t."ACFISS")) ELSE -1 END) AS dv_fiss,
                     (CASE WHEN TRIM(t."ACLISS") IS NULL OR REGEXP_LIKE(TRIM(t."ACLISS"), '^[0 -]*$') THEN NULL
                           WHEN REGEXP_LIKE(TRIM(t."ACLISS"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."ACLISS") AS DATE, 'YYYYMMDD') = 1 AND TRIM(t."ACLISS") &gt;= '19000101' THEN TO_NUMBER(TRIM(t."ACLISS")) ELSE -1 END) AS dv_liss,
                     (CASE WHEN TRIM(t."ACDLTN") IS NULL OR REGEXP_LIKE(TRIM(t."ACDLTN"), '^[0 -]*$') THEN NULL
                           WHEN REGEXP_LIKE(TRIM(t."ACDLTN"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."ACDLTN") AS DATE, 'YYYYMMDD') = 1 AND TRIM(t."ACDLTN") &gt;= '19000101' THEN TO_NUMBER(TRIM(t."ACDLTN")) ELSE -1 END) AS dv_dltn,
                     (CASE WHEN TRIM(t."ACDLMT") IS NULL OR REGEXP_LIKE(TRIM(t."ACDLMT"), '^[0 -]*$') THEN NULL
                           WHEN REGEXP_LIKE(TRIM(t."ACDLMT"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."ACDLMT") AS DATE, 'YYYYMMDD') = 1 AND TRIM(t."ACDLMT") &gt;= '19000101' THEN TO_NUMBER(TRIM(t."ACDLMT")) ELSE -1 END) AS dv_dlmt,
                     (CASE WHEN TRIM(t."ACHDAT") IS NULL OR REGEXP_LIKE(TRIM(t."ACHDAT"), '^[0 -]*$') THEN NULL
                           WHEN REGEXP_LIKE(TRIM(t."ACHDAT"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."ACHDAT") AS DATE, 'YYYYMMDD') = 1 AND TRIM(t."ACHDAT") &gt;= '19000101' THEN TO_NUMBER(TRIM(t."ACHDAT")) ELSE -1 END) AS dv_hdat
                FROM DATACUT5."ATM_MT_ATCAHFP" t
            ) s0
        ) s
        CROSS JOIN params p
        LEFT JOIN k_cus    j1 ON j1.dcb = s.n_dcb AND j1.dcs = s.n_dcs
        LEFT JOIN ref_pdty j2 ON j2.code = TRIM(s."ACPDTY")
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1)   AS 'ATCAHFP-001|Missing Data|Missing country code or group member (ACCTCD/ACGMAB)',
        (t2, f2)   AS 'ATCAHFP-002|Missing Data|Missing primary account number / PAN (ACPAN)',
        (t3, f3)   AS 'ATCAHFP-003|Missing Data|Missing card number (ACCDNO)',
        (t4, f4)   AS 'ATCAHFP-004|Missing Data|Missing cardholder name (ACCAHN)',
        (t5, f5)   AS 'ATCAHFP-005|Missing Data|Missing ATM product type (ACPDTY)',
        (t6, f6)   AS 'ATCAHFP-006|Missing Data|Missing card status (ACCDST)',
        (t7, f7)   AS 'ATCAHFP-007|Missing Data|Missing customer key (ACDCB/ACDCS)',
        (t8, f8)   AS 'ATCAHFP-008|Missing Data|Missing card expiry date (ACCDEX)',
        (t9, f9)   AS 'ATCAHFP-009|Missing Data|Missing first issue date (ACFISS)',
        (t10, f10) AS 'ATCAHFP-010|Missing Data|Missing current issue date (ACLISS)',
        (t11, f11) AS 'ATCAHFP-011|Invalid Values|Customer branch not 1-999 or serial not &gt; 0 (ACDCB/ACDCS)',
        (t12, f12) AS 'ATCAHFP-012|Invalid Values|Cardholder name contains no letters (ACCAHN)',
        (t13, f13) AS 'ATCAHFP-013|Invalid Values|Cardholder name with leading space, double spaces or control characters (ACCAHN)',
        (t14, f14) AS 'ATCAHFP-014|Invalid Values|PAN type not 1/2/3 (ACPANT)',
        (t15, f15) AS 'ATCAHFP-015|Invalid Values|PIN despatch code not M/C (ACPDCD)',
        (t16, f16) AS 'ATCAHFP-016|Invalid Values|PIN retry count above 4 (ACPTRC)',
        (t17, f17) AS 'ATCAHFP-017|Invalid Values|Invalid time: Time Loaded HOT (ACHTIM)',
        (t18, f18) AS 'ATCAHFP-018|Invalid Values|Invalid time: Time Last Transaction (ACTLTN)',
        (t19, f19) AS 'ATCAHFP-019|Invalid Values|Invalid time: Time Last Maintenance (ACTLMT)',
        (t20, f20) AS 'ATCAHFP-020|Invalid Dates|Invalid card expiry date, not YYMM (ACCDEX)',
        (t21, f21) AS 'ATCAHFP-021|Invalid Dates|Invalid new card expiry date, not YYMM (ACCEXN)',
        (t22, f22) AS 'ATCAHFP-022|Invalid Dates|Invalid date: First Issue Date (ACFISS)',
        (t23, f23) AS 'ATCAHFP-023|Invalid Dates|Invalid date: Current Issue Date (ACLISS)',
        (t24, f24) AS 'ATCAHFP-024|Invalid Dates|Invalid date: Date Last Transaction (ACDLTN)',
        (t25, f25) AS 'ATCAHFP-025|Invalid Dates|Invalid date: Date Last Maintenance (ACDLMT)',
        (t26, f26) AS 'ATCAHFP-026|Invalid Dates|Invalid date: Date Loaded HOT (ACHDAT)',
        (t27, f27) AS 'ATCAHFP-027|Invalid Dates|Future date: First Issue Date (ACFISS)',
        (t28, f28) AS 'ATCAHFP-028|Invalid Dates|Future date: Current Issue Date (ACLISS)',
        (t29, f29) AS 'ATCAHFP-029|Invalid Dates|Future date: Date Last Transaction (ACDLTN)',
        (t30, f30) AS 'ATCAHFP-030|Invalid Dates|Future date: Date Last Maintenance (ACDLMT)',
        (t31, f31) AS 'ATCAHFP-031|Invalid Dates|Future date: Date Loaded HOT (ACHDAT)',
        (t32, f32) AS 'ATCAHFP-032|Duplicates|Duplicate card key (ACCTCD+ACGMAB+ACPAN+ACCINO)',
        (t33, f33) AS 'ATCAHFP-033|Missing Links|Customer (ACDCB+ACDCS) not found in SSCUSTP',
        (t34, f34) AS 'ATCAHFP-034|Missing Links|ATM product type (ACPDTY) not found in ATPDCPP',
        (t35, f35) AS 'ATCAHFP-035|Inconsistent Data|Identity type and number not populated together (ACIDTY/ACIDNO)',
        (t36, f36) AS 'ATCAHFP-036|Inconsistent Data|Secondary account 1 without country code or group member (ACSAN1/ACSCC1/ACSGM1)',
        (t37, f37) AS 'ATCAHFP-037|Inconsistent Data|Secondary account 2 without country code or group member (ACSAN2/ACSCC2/ACSGM2)',
        (t38, f38) AS 'ATCAHFP-038|Inconsistent Data|Current issue date before first issue date (ACLISS &lt; ACFISS)'
      ))
    UNION ALL
/* =============================================================================
   MVATSUP - Supplementary card details
   Πίνακας: DATACUT5."ATM_MT_MVATSUP"   Shadow: δεν υπάρχει mode flag   Έλεγχοι: 4
   Η σύνδεση SPCRNO = ATCAHFP.ACCDNO είναι αυτή που χρησιμοποιεί το 62000_Cards.sql.
   ============================================================================= */
    SELECT 'MVATSUP - Supplementary card details' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- MVATSUP-001: Missing card number (SPCRNO)
          COUNT(*) AS t1,
          COUNT(CASE WHEN NVL(s.n_crno, 0) = 0 THEN 1 END) AS f1,
          -- MVATSUP-002: Duplicate card number (SPCRNO)
          COUNT(CASE WHEN NVL(s.n_crno, 0) &lt;&gt; 0 THEN 1 END) AS t2,
          COUNT(CASE WHEN NVL(s.n_crno, 0) &lt;&gt; 0 AND s.dup_n &gt; 1 THEN 1 END) AS f2,
          -- MVATSUP-003: Card (SPCRNO) not found in ATCAHFP (ACCDNO)
          COUNT(CASE WHEN NVL(s.n_crno, 0) &lt;&gt; 0 THEN 1 END) AS t3,
          COUNT(CASE WHEN NVL(s.n_crno, 0) &lt;&gt; 0 AND j1.cdno IS NULL THEN 1 END) AS f3,
          -- MVATSUP-004: Identity type and number not populated together (SPIDTY/SPIDNO)
          COUNT(*) AS t4,
          COUNT(CASE WHEN (TRIM(s."SPIDTY") IS NULL AND TRIM(s."SPIDNO") IS NOT NULL)
                       OR (TRIM(s."SPIDTY") IS NOT NULL AND TRIM(s."SPIDNO") IS NULL) THEN 1 END) AS f4
        FROM (
          SELECT s0.*, COUNT(*) OVER (PARTITION BY s0.n_crno) AS dup_n
            FROM (
              SELECT t.*,
                     (CASE WHEN VALIDATE_CONVERSION(TRIM(t."SPCRNO") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."SPCRNO")) END) AS n_crno
                FROM DATACUT5."ATM_MT_MVATSUP" t
            ) s0
        ) s
        LEFT JOIN k_card j1 ON j1.cdno = s.n_crno
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'MVATSUP-001|Missing Data|Missing card number (SPCRNO)',
        (t2, f2) AS 'MVATSUP-002|Duplicates|Duplicate card number (SPCRNO)',
        (t3, f3) AS 'MVATSUP-003|Missing Links|Card (SPCRNO) not found in ATCAHFP (ACCDNO)',
        (t4, f4) AS 'MVATSUP-004|Inconsistent Data|Identity type and number not populated together (SPIDTY/SPIDNO)'
      ))
    UNION ALL
/* =============================================================================
   MVCLMPP - Daily OD Limit File
   Πίνακας: DATACUT5."ATM_MT_MVCLMPP"   Shadow: δεν υπάρχει mode flag   Έλεγχοι: 4
   ============================================================================= */
    SELECT 'MVCLMPP - Daily OD Limit File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- MVCLMPP-001: Missing country code or group member (TQCTCD/TQGMAB)
          COUNT(*) AS t1,
          COUNT(CASE WHEN TRIM(s."TQCTCD") IS NULL OR TRIM(s."TQGMAB") IS NULL THEN 1 END) AS f1,
          -- MVCLMPP-002: Missing card number (TQCDNO)
          COUNT(*) AS t2,
          COUNT(CASE WHEN NVL(s.n_cdno, 0) = 0 THEN 1 END) AS f2,
          -- MVCLMPP-003: Negative limit amount (TQLMAM)
          COUNT(*) AS t3,
          COUNT(CASE WHEN s.n_lmam &lt; 0 THEN 1 END) AS f3,
          -- MVCLMPP-004: Invalid date: Transaction Date (TQXDAT)
          COUNT(*) AS t4,
          COUNT(CASE WHEN s.dv_xdat = -1 THEN 1 END) AS f4
        FROM (
          SELECT t.*,
                 (CASE WHEN VALIDATE_CONVERSION(TRIM(t."TQCDNO") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."TQCDNO")) END) AS n_cdno,
                 (CASE WHEN VALIDATE_CONVERSION(TRIM(t."TQLMAM") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."TQLMAM")) END) AS n_lmam,
                 (CASE WHEN TRIM(t."TQXDAT") IS NULL OR REGEXP_LIKE(TRIM(t."TQXDAT"), '^[0 -]*$') THEN NULL
                       WHEN REGEXP_LIKE(TRIM(t."TQXDAT"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."TQXDAT") AS DATE, 'YYYYMMDD') = 1 AND TRIM(t."TQXDAT") &gt;= '19000101' THEN TO_NUMBER(TRIM(t."TQXDAT")) ELSE -1 END) AS dv_xdat
            FROM DATACUT5."ATM_MT_MVCLMPP" t
        ) s
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'MVCLMPP-001|Missing Data|Missing country code or group member (TQCTCD/TQGMAB)',
        (t2, f2) AS 'MVCLMPP-002|Missing Data|Missing card number (TQCDNO)',
        (t3, f3) AS 'MVCLMPP-003|Invalid Values|Negative limit amount (TQLMAM)',
        (t4, f4) AS 'MVCLMPP-004|Invalid Dates|Invalid date: Transaction Date (TQXDAT)'
      ))
    UNION ALL
/* =============================================================================
   ATAULJP - Authorisation Log Journal
   Πίνακας: DATACUT5."ATM_MT_ATAULJP"   Shadow: δεν υπάρχει mode flag   Έλεγχοι: 9
   Transaction journal: ελέγχονται μόνο κλειδιά, συνδέσεις και ημερομηνίες.
   ============================================================================= */
    SELECT 'ATAULJP - Authorisation Log Journal' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- ATAULJP-001: Missing card number (FACDNO)
          COUNT(*) AS t1,
          COUNT(CASE WHEN NVL(s.n_FACDNO, 0) = 0 THEN 1 END) AS f1,
          -- ATAULJP-002: Invalid date: Capture Date (FACPDT)
          COUNT(*) AS t2,
          COUNT(CASE WHEN s.dv_FACPDT = -1 THEN 1 END) AS f2,
          -- ATAULJP-003: Invalid date: Transaction Date (FAXDAT)
          COUNT(*) AS t3,
          COUNT(CASE WHEN s.dv_FAXDAT = -1 THEN 1 END) AS f3,
          -- ATAULJP-004: Invalid date: Date Last Maintenance (FADLMT)
          COUNT(*) AS t4,
          COUNT(CASE WHEN s.dv_FADLMT = -1 THEN 1 END) AS f4,
          -- ATAULJP-005: Invalid date: Maestro Settlement Date (FAESTD)
          COUNT(*) AS t5,
          COUNT(CASE WHEN s.dv_FAESTD = -1 THEN 1 END) AS f5,
          -- ATAULJP-006: Invalid date: Match Date (FAMDAT)
          COUNT(*) AS t6,
          COUNT(CASE WHEN s.dv_FAMDAT = -1 THEN 1 END) AS f6,
          -- ATAULJP-007: Invalid date: Add Hold Expiry Date (FAPEX)
          COUNT(*) AS t7,
          COUNT(CASE WHEN s.dv_FAPEX = -1 THEN 1 END) AS f7,
          -- ATAULJP-008: Invalid date, not YYMMDD: Cryptogram Transaction Date (FACTDT)
          COUNT(*) AS t8,
          COUNT(CASE WHEN s.dv_FACTDT = -1 THEN 1 END) AS f8,
          -- ATAULJP-009: Invalid date, not YYMM: Card Expiry Date (FACDEX)
          COUNT(*) AS t9,
          COUNT(CASE WHEN s.dv_FACDEX = -1 THEN 1 END) AS f9
        FROM (
          SELECT t.*,
                 (CASE WHEN VALIDATE_CONVERSION(TRIM(t."FACDNO") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."FACDNO")) END) AS n_FACDNO,
                 (CASE WHEN TRIM(t."FACPDT") IS NULL OR REGEXP_LIKE(TRIM(t."FACPDT"), '^[0 -]*$') THEN NULL
                       WHEN REGEXP_LIKE(TRIM(t."FACPDT"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."FACPDT") AS DATE, 'YYYYMMDD') = 1 AND TRIM(t."FACPDT") &gt;= '19000101' THEN TO_NUMBER(TRIM(t."FACPDT")) ELSE -1 END) AS dv_FACPDT,
                 (CASE WHEN TRIM(t."FAXDAT") IS NULL OR REGEXP_LIKE(TRIM(t."FAXDAT"), '^[0 -]*$') THEN NULL
                       WHEN REGEXP_LIKE(TRIM(t."FAXDAT"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."FAXDAT") AS DATE, 'YYYYMMDD') = 1 AND TRIM(t."FAXDAT") &gt;= '19000101' THEN TO_NUMBER(TRIM(t."FAXDAT")) ELSE -1 END) AS dv_FAXDAT,
                 (CASE WHEN TRIM(t."FADLMT") IS NULL OR REGEXP_LIKE(TRIM(t."FADLMT"), '^[0 -]*$') THEN NULL
                       WHEN REGEXP_LIKE(TRIM(t."FADLMT"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."FADLMT") AS DATE, 'YYYYMMDD') = 1 AND TRIM(t."FADLMT") &gt;= '19000101' THEN TO_NUMBER(TRIM(t."FADLMT")) ELSE -1 END) AS dv_FADLMT,
                 (CASE WHEN TRIM(t."FAESTD") IS NULL OR REGEXP_LIKE(TRIM(t."FAESTD"), '^[0 -]*$') THEN NULL
                       WHEN REGEXP_LIKE(TRIM(t."FAESTD"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."FAESTD") AS DATE, 'YYYYMMDD') = 1 AND TRIM(t."FAESTD") &gt;= '19000101' THEN TO_NUMBER(TRIM(t."FAESTD")) ELSE -1 END) AS dv_FAESTD,
                 (CASE WHEN TRIM(t."FAMDAT") IS NULL OR REGEXP_LIKE(TRIM(t."FAMDAT"), '^[0 -]*$') THEN NULL
                       WHEN REGEXP_LIKE(TRIM(t."FAMDAT"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."FAMDAT") AS DATE, 'YYYYMMDD') = 1 AND TRIM(t."FAMDAT") &gt;= '19000101' THEN TO_NUMBER(TRIM(t."FAMDAT")) ELSE -1 END) AS dv_FAMDAT,
                 (CASE WHEN TRIM(t."FAPEX") IS NULL OR REGEXP_LIKE(TRIM(t."FAPEX"), '^[0 -]*$') THEN NULL
                       WHEN REGEXP_LIKE(TRIM(t."FAPEX"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."FAPEX") AS DATE, 'YYYYMMDD') = 1 AND TRIM(t."FAPEX") &gt;= '19000101' THEN TO_NUMBER(TRIM(t."FAPEX")) ELSE -1 END) AS dv_FAPEX,
                 (CASE WHEN TRIM(t."FACTDT") IS NULL OR REGEXP_LIKE(TRIM(t."FACTDT"), '^[0 -]*$') THEN NULL
                       WHEN REGEXP_LIKE(LPAD(TRIM(t."FACTDT"), 6, '0'), '^[0-9]{6}$') AND VALIDATE_CONVERSION(LPAD(TRIM(t."FACTDT"), 6, '0') AS DATE, 'YYMMDD') = 1 THEN 1 ELSE -1 END) AS dv_FACTDT,
                 (CASE WHEN TRIM(t."FACDEX") IS NULL OR REGEXP_LIKE(TRIM(t."FACDEX"), '^[0 -]*$') THEN NULL
                       WHEN REGEXP_LIKE(LPAD(TRIM(t."FACDEX"), 4, '0'), '^[0-9]{2}(0[1-9]|1[0-2])$') THEN 1 ELSE -1 END) AS dv_FACDEX
            FROM DATACUT5."ATM_MT_ATAULJP" t
        ) s
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'ATAULJP-001|Missing Data|Missing card number (FACDNO)',
        (t2, f2) AS 'ATAULJP-002|Invalid Dates|Invalid date: Capture Date (FACPDT)',
        (t3, f3) AS 'ATAULJP-003|Invalid Dates|Invalid date: Transaction Date (FAXDAT)',
        (t4, f4) AS 'ATAULJP-004|Invalid Dates|Invalid date: Date Last Maintenance (FADLMT)',
        (t5, f5) AS 'ATAULJP-005|Invalid Dates|Invalid date: Maestro Settlement Date (FAESTD)',
        (t6, f6) AS 'ATAULJP-006|Invalid Dates|Invalid date: Match Date (FAMDAT)',
        (t7, f7) AS 'ATAULJP-007|Invalid Dates|Invalid date: Add Hold Expiry Date (FAPEX)',
        (t8, f8) AS 'ATAULJP-008|Invalid Dates|Invalid date, not YYMMDD: Cryptogram Transaction Date (FACTDT)',
        (t9, f9) AS 'ATAULJP-009|Invalid Dates|Invalid date, not YYMM: Card Expiry Date (FACDEX)'
      ))
    UNION ALL
/* =============================================================================
   ATTNFFP - ATMP Transaction Log File
   Πίνακας: DATACUT5."ATM_MT_ATTNFFP"   Shadow: δεν υπάρχει mode flag   Έλεγχοι: 8
   Transaction journal: ελέγχονται μόνο κλειδιά, συνδέσεις και ημερομηνίες.
   ============================================================================= */
    SELECT 'ATTNFFP - ATMP Transaction Log File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- ATTNFFP-001: Missing card number (EACDNO)
          COUNT(*) AS t1,
          COUNT(CASE WHEN NVL(s.n_EACDNO, 0) = 0 THEN 1 END) AS f1,
          -- ATTNFFP-002: Invalid date: Transaction Date (EAXDAT)
          COUNT(*) AS t2,
          COUNT(CASE WHEN s.dv_EAXDAT = -1 THEN 1 END) AS f2,
          -- ATTNFFP-003: Invalid date: Business Date (EAXBDT)
          COUNT(*) AS t3,
          COUNT(CASE WHEN s.dv_EAXBDT = -1 THEN 1 END) AS f3,
          -- ATTNFFP-004: Invalid date: GATS Settlement Date (EASTLD)
          COUNT(*) AS t4,
          COUNT(CASE WHEN s.dv_EASTLD = -1 THEN 1 END) AS f4,
          -- ATTNFFP-005: Invalid date: Current Issue Date (EALISS)
          COUNT(*) AS t5,
          COUNT(CASE WHEN s.dv_EALISS = -1 THEN 1 END) AS f5,
          -- ATTNFFP-006: Invalid date, not YYMMDD: Cryptogram Transaction Date (EACTDT)
          COUNT(*) AS t6,
          COUNT(CASE WHEN s.dv_EACTDT = -1 THEN 1 END) AS f6,
          -- ATTNFFP-007: Invalid date, not YYMM: Card Expiry Date (EACDEX)
          COUNT(*) AS t7,
          COUNT(CASE WHEN s.dv_EACDEX = -1 THEN 1 END) AS f7,
          -- ATTNFFP-008: Customer (EADCB+EADCS) not found in SSCUSTP
          COUNT(CASE WHEN NVL(s.n_EADCB, 0) &lt;&gt; 0 AND NVL(s.n_EADCS, 0) &lt;&gt; 0 THEN 1 END) AS t8,
          COUNT(CASE WHEN NVL(s.n_EADCB, 0) &lt;&gt; 0 AND NVL(s.n_EADCS, 0) &lt;&gt; 0 AND j1.dcb IS NULL THEN 1 END) AS f8
        FROM (
          SELECT t.*,
                 (CASE WHEN VALIDATE_CONVERSION(TRIM(t."EACDNO") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."EACDNO")) END) AS n_EACDNO,
                 (CASE WHEN TRIM(t."EAXDAT") IS NULL OR REGEXP_LIKE(TRIM(t."EAXDAT"), '^[0 -]*$') THEN NULL
                       WHEN REGEXP_LIKE(TRIM(t."EAXDAT"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."EAXDAT") AS DATE, 'YYYYMMDD') = 1 AND TRIM(t."EAXDAT") &gt;= '19000101' THEN TO_NUMBER(TRIM(t."EAXDAT")) ELSE -1 END) AS dv_EAXDAT,
                 (CASE WHEN TRIM(t."EAXBDT") IS NULL OR REGEXP_LIKE(TRIM(t."EAXBDT"), '^[0 -]*$') THEN NULL
                       WHEN REGEXP_LIKE(TRIM(t."EAXBDT"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."EAXBDT") AS DATE, 'YYYYMMDD') = 1 AND TRIM(t."EAXBDT") &gt;= '19000101' THEN TO_NUMBER(TRIM(t."EAXBDT")) ELSE -1 END) AS dv_EAXBDT,
                 (CASE WHEN TRIM(t."EASTLD") IS NULL OR REGEXP_LIKE(TRIM(t."EASTLD"), '^[0 -]*$') THEN NULL
                       WHEN REGEXP_LIKE(TRIM(t."EASTLD"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."EASTLD") AS DATE, 'YYYYMMDD') = 1 AND TRIM(t."EASTLD") &gt;= '19000101' THEN TO_NUMBER(TRIM(t."EASTLD")) ELSE -1 END) AS dv_EASTLD,
                 (CASE WHEN TRIM(t."EALISS") IS NULL OR REGEXP_LIKE(TRIM(t."EALISS"), '^[0 -]*$') THEN NULL
                       WHEN REGEXP_LIKE(TRIM(t."EALISS"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."EALISS") AS DATE, 'YYYYMMDD') = 1 AND TRIM(t."EALISS") &gt;= '19000101' THEN TO_NUMBER(TRIM(t."EALISS")) ELSE -1 END) AS dv_EALISS,
                 (CASE WHEN TRIM(t."EACTDT") IS NULL OR REGEXP_LIKE(TRIM(t."EACTDT"), '^[0 -]*$') THEN NULL
                       WHEN REGEXP_LIKE(LPAD(TRIM(t."EACTDT"), 6, '0'), '^[0-9]{6}$') AND VALIDATE_CONVERSION(LPAD(TRIM(t."EACTDT"), 6, '0') AS DATE, 'YYMMDD') = 1 THEN 1 ELSE -1 END) AS dv_EACTDT,
                 (CASE WHEN TRIM(t."EACDEX") IS NULL OR REGEXP_LIKE(TRIM(t."EACDEX"), '^[0 -]*$') THEN NULL
                       WHEN REGEXP_LIKE(LPAD(TRIM(t."EACDEX"), 4, '0'), '^[0-9]{2}(0[1-9]|1[0-2])$') THEN 1 ELSE -1 END) AS dv_EACDEX,
                 (CASE WHEN VALIDATE_CONVERSION(TRIM(t."EADCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."EADCB")) END) AS n_EADCB,
                 (CASE WHEN VALIDATE_CONVERSION(TRIM(t."EADCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."EADCS")) END) AS n_EADCS
            FROM DATACUT5."ATM_MT_ATTNFFP" t
        ) s
        LEFT JOIN k_cus j1 ON j1.dcb = s.n_EADCB AND j1.dcs = s.n_EADCS
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'ATTNFFP-001|Missing Data|Missing card number (EACDNO)',
        (t2, f2) AS 'ATTNFFP-002|Invalid Dates|Invalid date: Transaction Date (EAXDAT)',
        (t3, f3) AS 'ATTNFFP-003|Invalid Dates|Invalid date: Business Date (EAXBDT)',
        (t4, f4) AS 'ATTNFFP-004|Invalid Dates|Invalid date: GATS Settlement Date (EASTLD)',
        (t5, f5) AS 'ATTNFFP-005|Invalid Dates|Invalid date: Current Issue Date (EALISS)',
        (t6, f6) AS 'ATTNFFP-006|Invalid Dates|Invalid date, not YYMMDD: Cryptogram Transaction Date (EACTDT)',
        (t7, f7) AS 'ATTNFFP-007|Invalid Dates|Invalid date, not YYMM: Card Expiry Date (EACDEX)',
        (t8, f8) AS 'ATTNFFP-008|Missing Links|Customer (EADCB+EADCS) not found in SSCUSTP'
      ))
    UNION ALL
/* =============================================================================
   ATTNFJP - ATMP Transaction Journal File
   Πίνακας: DATACUT5."ATM_MT_ATTNFJP"   Shadow: δεν υπάρχει mode flag   Έλεγχοι: 8
   Transaction journal: ελέγχονται μόνο κλειδιά, συνδέσεις και ημερομηνίες.
   ============================================================================= */
    SELECT 'ATTNFJP - ATMP Transaction Journal File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- ATTNFJP-001: Missing card number (EACDNO)
          COUNT(*) AS t1,
          COUNT(CASE WHEN NVL(s.n_EACDNO, 0) = 0 THEN 1 END) AS f1,
          -- ATTNFJP-002: Invalid date: Transaction Date (EAXDAT)
          COUNT(*) AS t2,
          COUNT(CASE WHEN s.dv_EAXDAT = -1 THEN 1 END) AS f2,
          -- ATTNFJP-003: Invalid date: Business Date (EAXBDT)
          COUNT(*) AS t3,
          COUNT(CASE WHEN s.dv_EAXBDT = -1 THEN 1 END) AS f3,
          -- ATTNFJP-004: Invalid date: GATS Settlement Date (EASTLD)
          COUNT(*) AS t4,
          COUNT(CASE WHEN s.dv_EASTLD = -1 THEN 1 END) AS f4,
          -- ATTNFJP-005: Invalid date: Current Issue Date (EALISS)
          COUNT(*) AS t5,
          COUNT(CASE WHEN s.dv_EALISS = -1 THEN 1 END) AS f5,
          -- ATTNFJP-006: Invalid date, not YYMMDD: Cryptogram Transaction Date (EACTDT)
          COUNT(*) AS t6,
          COUNT(CASE WHEN s.dv_EACTDT = -1 THEN 1 END) AS f6,
          -- ATTNFJP-007: Invalid date, not YYMM: Card Expiry Date (EACDEX)
          COUNT(*) AS t7,
          COUNT(CASE WHEN s.dv_EACDEX = -1 THEN 1 END) AS f7,
          -- ATTNFJP-008: Customer (EADCB+EADCS) not found in SSCUSTP
          COUNT(CASE WHEN NVL(s.n_EADCB, 0) &lt;&gt; 0 AND NVL(s.n_EADCS, 0) &lt;&gt; 0 THEN 1 END) AS t8,
          COUNT(CASE WHEN NVL(s.n_EADCB, 0) &lt;&gt; 0 AND NVL(s.n_EADCS, 0) &lt;&gt; 0 AND j1.dcb IS NULL THEN 1 END) AS f8
        FROM (
          SELECT t.*,
                 (CASE WHEN VALIDATE_CONVERSION(TRIM(t."EACDNO") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."EACDNO")) END) AS n_EACDNO,
                 (CASE WHEN TRIM(t."EAXDAT") IS NULL OR REGEXP_LIKE(TRIM(t."EAXDAT"), '^[0 -]*$') THEN NULL
                       WHEN REGEXP_LIKE(TRIM(t."EAXDAT"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."EAXDAT") AS DATE, 'YYYYMMDD') = 1 AND TRIM(t."EAXDAT") &gt;= '19000101' THEN TO_NUMBER(TRIM(t."EAXDAT")) ELSE -1 END) AS dv_EAXDAT,
                 (CASE WHEN TRIM(t."EAXBDT") IS NULL OR REGEXP_LIKE(TRIM(t."EAXBDT"), '^[0 -]*$') THEN NULL
                       WHEN REGEXP_LIKE(TRIM(t."EAXBDT"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."EAXBDT") AS DATE, 'YYYYMMDD') = 1 AND TRIM(t."EAXBDT") &gt;= '19000101' THEN TO_NUMBER(TRIM(t."EAXBDT")) ELSE -1 END) AS dv_EAXBDT,
                 (CASE WHEN TRIM(t."EASTLD") IS NULL OR REGEXP_LIKE(TRIM(t."EASTLD"), '^[0 -]*$') THEN NULL
                       WHEN REGEXP_LIKE(TRIM(t."EASTLD"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."EASTLD") AS DATE, 'YYYYMMDD') = 1 AND TRIM(t."EASTLD") &gt;= '19000101' THEN TO_NUMBER(TRIM(t."EASTLD")) ELSE -1 END) AS dv_EASTLD,
                 (CASE WHEN TRIM(t."EALISS") IS NULL OR REGEXP_LIKE(TRIM(t."EALISS"), '^[0 -]*$') THEN NULL
                       WHEN REGEXP_LIKE(TRIM(t."EALISS"), '^[0-9]{8}$') AND VALIDATE_CONVERSION(TRIM(t."EALISS") AS DATE, 'YYYYMMDD') = 1 AND TRIM(t."EALISS") &gt;= '19000101' THEN TO_NUMBER(TRIM(t."EALISS")) ELSE -1 END) AS dv_EALISS,
                 (CASE WHEN TRIM(t."EACTDT") IS NULL OR REGEXP_LIKE(TRIM(t."EACTDT"), '^[0 -]*$') THEN NULL
                       WHEN REGEXP_LIKE(LPAD(TRIM(t."EACTDT"), 6, '0'), '^[0-9]{6}$') AND VALIDATE_CONVERSION(LPAD(TRIM(t."EACTDT"), 6, '0') AS DATE, 'YYMMDD') = 1 THEN 1 ELSE -1 END) AS dv_EACTDT,
                 (CASE WHEN TRIM(t."EACDEX") IS NULL OR REGEXP_LIKE(TRIM(t."EACDEX"), '^[0 -]*$') THEN NULL
                       WHEN REGEXP_LIKE(LPAD(TRIM(t."EACDEX"), 4, '0'), '^[0-9]{2}(0[1-9]|1[0-2])$') THEN 1 ELSE -1 END) AS dv_EACDEX,
                 (CASE WHEN VALIDATE_CONVERSION(TRIM(t."EADCB") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."EADCB")) END) AS n_EADCB,
                 (CASE WHEN VALIDATE_CONVERSION(TRIM(t."EADCS") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."EADCS")) END) AS n_EADCS
            FROM DATACUT5."ATM_MT_ATTNFJP" t
        ) s
        LEFT JOIN k_cus j1 ON j1.dcb = s.n_EADCB AND j1.dcs = s.n_EADCS
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'ATTNFJP-001|Missing Data|Missing card number (EACDNO)',
        (t2, f2) AS 'ATTNFJP-002|Invalid Dates|Invalid date: Transaction Date (EAXDAT)',
        (t3, f3) AS 'ATTNFJP-003|Invalid Dates|Invalid date: Business Date (EAXBDT)',
        (t4, f4) AS 'ATTNFJP-004|Invalid Dates|Invalid date: GATS Settlement Date (EASTLD)',
        (t5, f5) AS 'ATTNFJP-005|Invalid Dates|Invalid date: Current Issue Date (EALISS)',
        (t6, f6) AS 'ATTNFJP-006|Invalid Dates|Invalid date, not YYMMDD: Cryptogram Transaction Date (EACTDT)',
        (t7, f7) AS 'ATTNFJP-007|Invalid Dates|Invalid date, not YYMM: Card Expiry Date (EACDEX)',
        (t8, f8) AS 'ATTNFJP-008|Missing Links|Customer (EADCB+EADCS) not found in SSCUSTP'
      ))
    UNION ALL
/* ######################## DC5 νέοι έλεγχοι (DD v1.14) ######################## */
/* =============================================================================
   AT@CBNP - Chip Controls per BIN File
   Πίνακας: DATACUT5."ATM_MT_AT@CBNP"   Shadow: δεν υπάρχει mode flag   Έλεγχοι: 3
   Έλεγχοι από τις αλλαγές του DD v1.14 και τους κανόνες της στήλης Free column.
   ============================================================================= */
    SELECT 'AT@CBNP - Chip Controls per BIN File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- AT_CBNP-501: Not an integer value: Application Currency Code (String -&gt; Integer in DD v1.14) (CHACCD)
          COUNT(CASE WHEN TRIM(s."CHACCD") IS NOT NULL THEN 1 END) AS t1,
          COUNT(CASE WHEN TRIM(s."CHACCD") IS NOT NULL AND (VALIDATE_CONVERSION(TRIM(s."CHACCD") AS NUMBER) = 0 OR s.n_chaccd &lt;&gt; TRUNC(s.n_chaccd)) THEN 1 END) AS f1,
          -- AT_CBNP-502: Application Currency Code (CHACCD) not a numeric ISO 4217 code (1-999)
          COUNT(CASE WHEN TRIM(s."CHACCD") IS NOT NULL THEN 1 END) AS t2,
          COUNT(CASE WHEN TRIM(s."CHACCD") IS NOT NULL AND NOT (s.n_chaccd BETWEEN 1 AND 999) THEN 1 END) AS f2,
          -- AT_CBNP-503: Issuer Country Number (CHICNO) not a valid ISO 3166 numeric country code (3 digits) [masked]
          COUNT(CASE WHEN TRIM(s."CHICNO") IS NOT NULL THEN 1 END) AS t3,
          COUNT(CASE WHEN TRIM(s."CHICNO") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."CHICNO"), '^[0-9]{3}$') THEN 1 END) AS f3
        FROM (
              SELECT t."CHACCD",
                     t."CHICNO",
                     (CASE WHEN VALIDATE_CONVERSION(TRIM(t."CHACCD") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."CHACCD")) END) AS n_chaccd
                FROM DATACUT5."ATM_MT_AT@CBNP" t
        ) s
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'AT_CBNP-501|Invalid Values|Not an integer value: Application Currency Code (String -&gt; Integer in DD v1.14) (CHACCD)',
        (t2, f2) AS 'AT_CBNP-502|Invalid Values|Application Currency Code (CHACCD) not a numeric ISO 4217 code (1-999)',
        (t3, f3) AS 'AT_CBNP-503|Format|Issuer Country Number (CHICNO) not a valid ISO 3166 numeric country code (3 digits) [masked]'
      ))
    UNION ALL
/* =============================================================================
   AT@CCDP - Chip Controls per Card File
   Πίνακας: DATACUT5."ATM_MT_AT@CCDP"   Shadow: δεν υπάρχει mode flag   Έλεγχοι: 3
   Έλεγχοι από τις αλλαγές του DD v1.14 και τους κανόνες της στήλης Free column.
   ============================================================================= */
    SELECT 'AT@CCDP - Chip Controls per Card File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- AT_CCDP-501: Not an integer value: Application Currency Code (String -&gt; Integer in DD v1.14) (CHACCD)
          COUNT(CASE WHEN TRIM(s."CHACCD") IS NOT NULL THEN 1 END) AS t1,
          COUNT(CASE WHEN TRIM(s."CHACCD") IS NOT NULL AND (VALIDATE_CONVERSION(TRIM(s."CHACCD") AS NUMBER) = 0 OR s.n_chaccd &lt;&gt; TRUNC(s.n_chaccd)) THEN 1 END) AS f1,
          -- AT_CCDP-502: Application Currency Code (CHACCD) not a numeric ISO 4217 code (1-999)
          COUNT(CASE WHEN TRIM(s."CHACCD") IS NOT NULL THEN 1 END) AS t2,
          COUNT(CASE WHEN TRIM(s."CHACCD") IS NOT NULL AND NOT (s.n_chaccd BETWEEN 1 AND 999) THEN 1 END) AS f2,
          -- AT_CCDP-503: Issuer Country Number (CHICNO) not a valid ISO 3166 numeric country code (3 digits) [masked]
          COUNT(CASE WHEN TRIM(s."CHICNO") IS NOT NULL THEN 1 END) AS t3,
          COUNT(CASE WHEN TRIM(s."CHICNO") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."CHICNO"), '^[0-9]{3}$') THEN 1 END) AS f3
        FROM (
              SELECT t."CHACCD",
                     t."CHICNO",
                     (CASE WHEN VALIDATE_CONVERSION(TRIM(t."CHACCD") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."CHACCD")) END) AS n_chaccd
                FROM DATACUT5."ATM_MT_AT@CCDP" t
        ) s
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'AT_CCDP-501|Invalid Values|Not an integer value: Application Currency Code (String -&gt; Integer in DD v1.14) (CHACCD)',
        (t2, f2) AS 'AT_CCDP-502|Invalid Values|Application Currency Code (CHACCD) not a numeric ISO 4217 code (1-999)',
        (t3, f3) AS 'AT_CCDP-503|Format|Issuer Country Number (CHICNO) not a valid ISO 3166 numeric country code (3 digits) [masked]'
      ))
    UNION ALL
/* =============================================================================
   AT@CPDP - Chip Controls per Product File
   Πίνακας: DATACUT5."ATM_MT_AT@CPDP"   Shadow: δεν υπάρχει mode flag   Έλεγχοι: 3
   Έλεγχοι από τις αλλαγές του DD v1.14 και τους κανόνες της στήλης Free column.
   ============================================================================= */
    SELECT 'AT@CPDP - Chip Controls per Product File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- AT_CPDP-501: Not an integer value: Application Currency Code (String -&gt; Integer in DD v1.14) (CHACCD)
          COUNT(CASE WHEN TRIM(s."CHACCD") IS NOT NULL THEN 1 END) AS t1,
          COUNT(CASE WHEN TRIM(s."CHACCD") IS NOT NULL AND (VALIDATE_CONVERSION(TRIM(s."CHACCD") AS NUMBER) = 0 OR s.n_chaccd &lt;&gt; TRUNC(s.n_chaccd)) THEN 1 END) AS f1,
          -- AT_CPDP-502: Application Currency Code (CHACCD) not a numeric ISO 4217 code (1-999)
          COUNT(CASE WHEN TRIM(s."CHACCD") IS NOT NULL THEN 1 END) AS t2,
          COUNT(CASE WHEN TRIM(s."CHACCD") IS NOT NULL AND NOT (s.n_chaccd BETWEEN 1 AND 999) THEN 1 END) AS f2,
          -- AT_CPDP-503: Issuer Country Number (CHICNO) not a valid ISO 3166 numeric country code (3 digits) [masked]
          COUNT(CASE WHEN TRIM(s."CHICNO") IS NOT NULL THEN 1 END) AS t3,
          COUNT(CASE WHEN TRIM(s."CHICNO") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."CHICNO"), '^[0-9]{3}$') THEN 1 END) AS f3
        FROM (
              SELECT t."CHACCD",
                     t."CHICNO",
                     (CASE WHEN VALIDATE_CONVERSION(TRIM(t."CHACCD") AS NUMBER) = 1 THEN TO_NUMBER(TRIM(t."CHACCD")) END) AS n_chaccd
                FROM DATACUT5."ATM_MT_AT@CPDP" t
        ) s
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'AT_CPDP-501|Invalid Values|Not an integer value: Application Currency Code (String -&gt; Integer in DD v1.14) (CHACCD)',
        (t2, f2) AS 'AT_CPDP-502|Invalid Values|Application Currency Code (CHACCD) not a numeric ISO 4217 code (1-999)',
        (t3, f3) AS 'AT_CPDP-503|Format|Issuer Country Number (CHICNO) not a valid ISO 3166 numeric country code (3 digits) [masked]'
      ))
    UNION ALL
/* =============================================================================
   AT@SPCP - Sepa Charges Discount files
   Πίνακας: DATACUT5."ATM_MT_AT@SPCP"   Shadow: δεν υπάρχει mode flag   Έλεγχοι: 1
   Έλεγχοι από τις αλλαγές του DD v1.14 και τους κανόνες της στήλης Free column.
   ============================================================================= */
    SELECT 'AT@SPCP - Sepa Charges Discount files' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- AT_SPCP-501: Currency Code (unmasked from DD v1.14) (SPCYCD) not a valid ISO 4217 currency code (3 letters or 3 digits)
          COUNT(CASE WHEN TRIM(s."SPCYCD") IS NOT NULL THEN 1 END) AS t1,
          COUNT(CASE WHEN TRIM(s."SPCYCD") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."SPCYCD"), '^([A-Z]{3}|[0-9]{3})$') THEN 1 END) AS f1
        FROM (
              SELECT t."SPCYCD"
                FROM DATACUT5."ATM_MT_AT@SPCP" t
        ) s
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'AT_SPCP-501|Format|Currency Code (unmasked from DD v1.14) (SPCYCD) not a valid ISO 4217 currency code (3 letters or 3 digits)'
      ))
    UNION ALL
/* =============================================================================
   AT@TRCP - Sepa Transaction Charges files
   Πίνακας: DATACUT5."ATM_MT_AT@TRCP"   Shadow: δεν υπάρχει mode flag   Έλεγχοι: 1
   Έλεγχοι από τις αλλαγές του DD v1.14 και τους κανόνες της στήλης Free column.
   ============================================================================= */
    SELECT 'AT@TRCP - Sepa Transaction Charges files' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- AT_TRCP-501: Currency (unmasked from DD v1.14) (TRCYCD) not a valid ISO 4217 currency code (3 letters or 3 digits)
          COUNT(CASE WHEN TRIM(s."TRCYCD") IS NOT NULL THEN 1 END) AS t1,
          COUNT(CASE WHEN TRIM(s."TRCYCD") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."TRCYCD"), '^([A-Z]{3}|[0-9]{3})$') THEN 1 END) AS f1
        FROM (
              SELECT t."TRCYCD"
                FROM DATACUT5."ATM_MT_AT@TRCP" t
        ) s
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'AT_TRCP-501|Format|Currency (unmasked from DD v1.14) (TRCYCD) not a valid ISO 4217 currency code (3 letters or 3 digits)'
      ))
    UNION ALL
/* =============================================================================
   ATAACTP - ATM Account Type Mapping Table
   Πίνακας: DATACUT5."ATM_MT_ATAACTP"   Shadow: δεν υπάρχει mode flag   Έλεγχοι: 1
   Έλεγχοι από τις αλλαγές του DD v1.14 και τους κανόνες της στήλης Free column.
   ============================================================================= */
    SELECT 'ATAACTP - ATM Account Type Mapping Table' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- ATAACTP-501: Product type (DGAPTY) not found in DDPDCPP
          COUNT(CASE WHEN TRIM(s."DGAPTY") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."DGAPTY"), '^[0. ]*$') THEN 1 END) AS t1,
          COUNT(CASE WHEN TRIM(s."DGAPTY") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."DGAPTY"), '^[0. ]*$') AND j1.code IS NULL THEN 1 END) AS f1
        FROM (
              SELECT t."DGAPTY"
                FROM DATACUT5."ATM_MT_ATAACTP" t
        ) s
        LEFT JOIN ref_apty_dd j1 ON j1.code = TRIM(s."DGAPTY")
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'ATAACTP-501|Missing Links|Product type (DGAPTY) not found in DDPDCPP'
      ))
    UNION ALL
/* =============================================================================
   ATAPTYP - ATM/HUB Product Type Control File
   Πίνακας: DATACUT5."ATM_MT_ATAPTYP"   Shadow: δεν υπάρχει mode flag   Έλεγχοι: 2
   Έλεγχοι από τις αλλαγές του DD v1.14 και τους κανόνες της στήλης Free column.
   ============================================================================= */
    SELECT 'ATAPTYP - ATM/HUB Product Type Control File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- ATAPTYP-501: Product type (BUAPTY) not found in DDPDCPP
          COUNT(CASE WHEN TRIM(s."BUAPTY") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."BUAPTY"), '^[0. ]*$') THEN 1 END) AS t1,
          COUNT(CASE WHEN TRIM(s."BUAPTY") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."BUAPTY"), '^[0. ]*$') AND j1.code IS NULL THEN 1 END) AS f1,
          -- ATAPTYP-502: Account Currency (unmasked from DD v1.14) (BUCYCD) not a valid ISO 4217 currency code (3 letters or 3 digits)
          COUNT(CASE WHEN TRIM(s."BUCYCD") IS NOT NULL THEN 1 END) AS t2,
          COUNT(CASE WHEN TRIM(s."BUCYCD") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."BUCYCD"), '^([A-Z]{3}|[0-9]{3})$') THEN 1 END) AS f2
        FROM (
              SELECT t."BUAPTY",
                     t."BUCYCD"
                FROM DATACUT5."ATM_MT_ATAPTYP" t
        ) s
        LEFT JOIN ref_apty_dd j1 ON j1.code = TRIM(s."BUAPTY")
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'ATAPTYP-501|Missing Links|Product type (BUAPTY) not found in DDPDCPP',
        (t2, f2) AS 'ATAPTYP-502|Format|Account Currency (unmasked from DD v1.14) (BUCYCD) not a valid ISO 4217 currency code (3 letters or 3 digits)'
      ))
    UNION ALL
/* =============================================================================
   ATAULJP - Authorisation Log Journal
   Πίνακας: DATACUT5."ATM_MT_ATAULJP"   Shadow: δεν υπάρχει mode flag   Έλεγχοι: 5
   Έλεγχοι από τις αλλαγές του DD v1.14 και τους κανόνες της στήλης Free column.
   ============================================================================= */
    SELECT 'ATAULJP - Authorisation Log Journal' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- ATAULJP-501: Transaction Currency (unmasked from DD v1.14) (FAXCCY) not a valid ISO 4217 currency code (3 letters or 3 digits)
          COUNT(CASE WHEN TRIM(s."FAXCCY") IS NOT NULL THEN 1 END) AS t1,
          COUNT(CASE WHEN TRIM(s."FAXCCY") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."FAXCCY"), '^([A-Z]{3}|[0-9]{3})$') THEN 1 END) AS f1,
          -- ATAULJP-502: Billing Account Currency (unmasked from DD v1.14) (FABCCY) not a valid ISO 4217 currency code (3 letters or 3 digits)
          COUNT(CASE WHEN TRIM(s."FABCCY") IS NOT NULL THEN 1 END) AS t2,
          COUNT(CASE WHEN TRIM(s."FABCCY") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."FABCCY"), '^([A-Z]{3}|[0-9]{3})$') THEN 1 END) AS f2,
          -- ATAULJP-503: Available balance currency (unmasked from DD v1.14) (FAACCY) not a valid ISO 4217 currency code (3 letters or 3 digits)
          COUNT(CASE WHEN TRIM(s."FAACCY") IS NOT NULL THEN 1 END) AS t3,
          COUNT(CASE WHEN TRIM(s."FAACCY") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."FAACCY"), '^([A-Z]{3}|[0-9]{3})$') THEN 1 END) AS f3,
          -- ATAULJP-504: Transaction Currency (unmasked from DD v1.14) (FATCCY) not a valid ISO 4217 currency code (3 letters or 3 digits)
          COUNT(CASE WHEN TRIM(s."FATCCY") IS NOT NULL THEN 1 END) AS t4,
          COUNT(CASE WHEN TRIM(s."FATCCY") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."FATCCY"), '^([A-Z]{3}|[0-9]{3})$') THEN 1 END) AS f4,
          -- ATAULJP-505: Cryptogram Terminal Country Code (FACTTC) not a valid ISO 3166 numeric country code (3 digits) [masked]
          COUNT(CASE WHEN TRIM(s."FACTTC") IS NOT NULL THEN 1 END) AS t5,
          COUNT(CASE WHEN TRIM(s."FACTTC") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."FACTTC"), '^[0-9]{3}$') THEN 1 END) AS f5
        FROM (
              SELECT t."FAACCY",
                     t."FABCCY",
                     t."FACTTC",
                     t."FATCCY",
                     t."FAXCCY"
                FROM DATACUT5."ATM_MT_ATAULJP" t
        ) s
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'ATAULJP-501|Format|Transaction Currency (unmasked from DD v1.14) (FAXCCY) not a valid ISO 4217 currency code (3 letters or 3 digits)',
        (t2, f2) AS 'ATAULJP-502|Format|Billing Account Currency (unmasked from DD v1.14) (FABCCY) not a valid ISO 4217 currency code (3 letters or 3 digits)',
        (t3, f3) AS 'ATAULJP-503|Format|Available balance currency (unmasked from DD v1.14) (FAACCY) not a valid ISO 4217 currency code (3 letters or 3 digits)',
        (t4, f4) AS 'ATAULJP-504|Format|Transaction Currency (unmasked from DD v1.14) (FATCCY) not a valid ISO 4217 currency code (3 letters or 3 digits)',
        (t5, f5) AS 'ATAULJP-505|Format|Cryptogram Terminal Country Code (FACTTC) not a valid ISO 3166 numeric country code (3 digits) [masked]'
      ))
    UNION ALL
/* =============================================================================
   ATCAHFP - ATM Cardholder File
   Πίνακας: DATACUT5."ATM_MT_ATCAHFP"   Shadow: δεν υπάρχει mode flag   Έλεγχοι: 2
   Έλεγχοι από τις αλλαγές του DD v1.14 και τους κανόνες της στήλης Free column.
   ============================================================================= */
    SELECT 'ATCAHFP - ATM Cardholder File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- ATCAHFP-501: Primary Account Number: FFFFFFBBBNNNNNCSSS for HUB (ACPAN) not a valid PAN in format FFFFFFBBBNNNNNCSSS (18 digits) [masked]
          COUNT(CASE WHEN TRIM(s."ACPAN") IS NOT NULL THEN 1 END) AS t1,
          COUNT(CASE WHEN TRIM(s."ACPAN") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."ACPAN"), '^[0-9]{18}$') THEN 1 END) AS f1,
          -- ATCAHFP-502: Previous Card Number (ACPPAN) not a valid PAN in format FFFFFFBBBNNNNNCSSS (18 digits) [masked]
          COUNT(CASE WHEN TRIM(s."ACPPAN") IS NOT NULL THEN 1 END) AS t2,
          COUNT(CASE WHEN TRIM(s."ACPPAN") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."ACPPAN"), '^[0-9]{18}$') THEN 1 END) AS f2
        FROM (
              SELECT t."ACPAN",
                     t."ACPPAN"
                FROM DATACUT5."ATM_MT_ATCAHFP" t
        ) s
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'ATCAHFP-501|Format|Primary Account Number: FFFFFFBBBNNNNNCSSS for HUB (ACPAN) not a valid PAN in format FFFFFFBBBNNNNNCSSS (18 digits) [masked]',
        (t2, f2) AS 'ATCAHFP-502|Format|Previous Card Number (ACPPAN) not a valid PAN in format FFFFFFBBBNNNNNCSSS (18 digits) [masked]'
      ))
    UNION ALL
/* =============================================================================
   ATCFEEP - ATM Card Fee File
   Πίνακας: DATACUT5."ATM_MT_ATCFEEP"   Shadow: δεν υπάρχει mode flag   Έλεγχοι: 1
   Έλεγχοι από τις αλλαγές του DD v1.14 και τους κανόνες της στήλης Free column.
   ============================================================================= */
    SELECT 'ATCFEEP - ATM Card Fee File' AS table_name, check_key, total, failed
      FROM (
        SELECT
          -- ATCFEEP-501: Product type (DPAPTY) not found in DDPDCPP
          COUNT(CASE WHEN TRIM(s."DPAPTY") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."DPAPTY"), '^[0. ]*$') THEN 1 END) AS t1,
          COUNT(CASE WHEN TRIM(s."DPAPTY") IS NOT NULL AND NOT REGEXP_LIKE(TRIM(s."DPAPTY"), '^[0. ]*$') AND j1.code IS NULL THEN 1 END) AS f1
        FROM (
              SELECT t."DPAPTY"
                FROM DATACUT5."ATM_MT_ATCFEEP" t
        ) s
        LEFT JOIN ref_apty_dd j1 ON j1.code = TRIM(s."DPAPTY")
      )
      UNPIVOT ((total, failed) FOR check_key IN (
        (t1, f1) AS 'ATCFEEP-501|Missing Links|Product type (DPAPTY) not found in DDPDCPP'
      ))
    UNION ALL
/* =============================================================================
   ATCHRGP - ATM Transaction Charge Control File
   Πίνακας: DATACUT5."ATM_MT_ATCHRGP"   Shadow: δεν υπάρχει mode flag   Έλεγχοι: 1
   Έλεγχοι από τις αλλαγές του DD v1.14 και τους κανόνες της στήλης Free column.
