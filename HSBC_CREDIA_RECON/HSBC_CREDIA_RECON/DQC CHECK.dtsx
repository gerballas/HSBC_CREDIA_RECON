        'SSTXDPP-003',   -- TDTXDC
        'SSTXDPP-004',   -- TDADCE
        'SSTXDPP-009',   -- TDDCS
        'SSWAINP-001',   -- VIDCS
        'SSWAINP-002',   -- VIACS
        'SSWAINP-005',   -- VIDCS
        'SSWAINP-501',   -- VIACS
        'SX_OWNSP-501',  -- SBDCS
        'SXOWNSP-501',   -- SBDCS
        'TDACADP-501',   -- TAACS
        'TDACMSP-001',   -- TDDCS
        'TDACMSP-002',   -- TDACS
        'TDACMSP-007',   -- TDCTRS
        'TDACMSP-008',   -- TDNATY
        'TDACMSP-020',   -- TDACS
        'TDACMSP-021',   -- TDDCS
        'TDACMSP-501',   -- TDMKS1
        'TDACMSP-502',   -- TDMKS2
        'TDACMSP-503',   -- TDMKS3
        'TDACMSP-B01',   -- TDRLBL
        'TDACMSP-B02',   -- TDRLBL
        'TDTRNJP-003',   -- THACS
        'TDTRNJP-501'    -- THCYCD
    ) THEN 'Y' ELSE 'N' END                                    AS IS_MASKED,
    TO_NCHAR('DC5')                                              AS DC_Version,
    SYSDATE                                                      AS Run_Timestamp
  FROM all_checks
 ORDER BY table_name, CHECK_ID;</property>
